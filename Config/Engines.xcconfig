// Réglages de liaison des moteurs. Fichier VIDE par défaut (mode
// "interface seule", le projet compile tel quel).
// Scripts/build_engines.sh y ajoute, pour chaque moteur construit :
//   OTHER_SWIFT_FLAGS = $(inherited) -DHENGE_LINKED
//   GCC_PREPROCESSOR_DEFINITIONS = $(inherited) HENGE_LINKED=1
//   HEADER_SEARCH_PATHS / LIBRARY_SEARCH_PATHS vers Vendor/...
// Ne pas éditer à la main : régénérer via le script.

// Chemins des en-têtes natifs copiés par integrate.sh (toujours valides,
// les dossiers existent même vides ; les imports restent gardés par *_LINKED).
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/TriOS/Modules/Henge/Native $(SRCROOT)/TriOS/Modules/Kernarium/Native $(SRCROOT)/TriOS/Modules/LinuxRunner/Native
