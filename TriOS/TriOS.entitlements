<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements utiles en sideload. Tous ne sont pas accordés par un
     certificat gratuit : si la signature échoue, retire
     com.apple.developer.kernel.increased-memory-limit et
     com.apple.developer.kernel.extended-virtual-addressing, l'app
     reste compilable et lançable, avec des limites mémoire plus basses
     (voir Docs/BUILD.md). -->
<plist version="1.0">
<dict>
    <key>com.apple.developer.kernel.increased-memory-limit</key><true/>
    <key>com.apple.developer.kernel.extended-virtual-addressing</key><true/>
    <key>get-task-allow</key><true/>
</dict>
</plist>
