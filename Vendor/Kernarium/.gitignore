# Project build products
/.build/
/.build
# Swift package build and index directories, such as AndariumCore's
.build/

# Local root filesystem image
*.erofs
*.img
.rootfs-provision-*/

# Official Linux checkout is maintained as its own repository; the outer tree
# tracks its reproducible patch series under kernel/patches/ instead.
/linux/

# Compiler and debugger output outside the build directory
*.dSYM/
compile_commands.json

# macOS filesystem metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor and IDE state
/.claude/
.idea/
.vscode/
xcuserdata/
*.xcuserstate
*.swp
*.swo
*~
__pycache__/
*.pyc
/tests/unit/arm64/corpus/a64_instruction_corpus.pack
/tests/unit/x86_64/corpus/x86_64_v3.pack
/tests/unit/x86_64/masked_flags/xeon-flags.bin
/tmp/
*.pdf
/external/*

# Per-developer CMake configuration; checked-in workflows live in
# CMakePresets.json.
CMakeUserPresets.json

# The signer's Apple Developer team for Kernarium and Andarium. The tracked
# example documents the one setting.
/GuestHost/Config/Signing.local.xcconfig

# Per-line kernel source locations. The tracked examples document the required
# format; real paths are host-specific and must name case-sensitive
# filesystems. Keep the former singleton path ignored because it is
# developer-owned migration input and must not be deleted or committed.
/kernel/source-location.conf
/kernel/mainline-6.18/source-location.conf
