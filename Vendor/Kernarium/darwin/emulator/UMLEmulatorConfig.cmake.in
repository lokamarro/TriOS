set(UMLEmulator_APPLE_PLATFORM "@UML_APPLE_PLATFORM@")
set(UMLEmulator_GUEST_SLICE "@UML_MAINLINE_KERNEL_SLICE@")

get_filename_component(_uml_emulator_prefix
    "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(_uml_emulator_archive
    "${_uml_emulator_prefix}/lib/libuml_emulator.a")
set(_uml_emulator_headers "${_uml_emulator_prefix}/include")
if(NOT EXISTS "${_uml_emulator_archive}" OR
   NOT EXISTS "${_uml_emulator_headers}/uml/emulator.h" OR
   NOT EXISTS "${_uml_emulator_headers}/uml/abi_identity.h")
    set(UMLEmulator_FOUND FALSE)
    set(UMLEmulator_NOT_FOUND_MESSAGE
        "The UMLEmulator install tree is incomplete at ${_uml_emulator_prefix}")
    unset(_uml_emulator_archive)
    unset(_uml_emulator_headers)
    unset(_uml_emulator_prefix)
    return()
endif()

if(NOT TARGET UML::Emulator)
    add_library(UML::Emulator STATIC IMPORTED)
    set_target_properties(UML::Emulator PROPERTIES
        IMPORTED_LOCATION "${_uml_emulator_archive}"
        INTERFACE_INCLUDE_DIRECTORIES "${_uml_emulator_headers}"
        # The installed headers are C, but the archive implementation uses the
        # Apple C++ runtime, Foundation and libcompression (the guest RAM
        # hibernation image). These link-only dependencies also make C and
        # Objective-C targets complete without changing their source
        # language.
        INTERFACE_LINK_LIBRARIES
            "$<$<LINK_LANGUAGE:C,OBJC>:c++>;-framework Foundation;compression")
endif()

unset(_uml_emulator_archive)
unset(_uml_emulator_headers)
unset(_uml_emulator_prefix)
