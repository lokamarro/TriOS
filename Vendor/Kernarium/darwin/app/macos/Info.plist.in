<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>@UML_MACOS_APP_BUNDLE_IDENTIFIER@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@UML_MACOS_APP_NAME@</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Programs in the guest system can record from this Mac's microphone when you start it with --audio-input=host.</string>
</dict>
</plist>
