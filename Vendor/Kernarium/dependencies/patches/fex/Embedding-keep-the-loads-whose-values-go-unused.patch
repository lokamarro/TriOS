From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 5 Oct 2026 18:25:45 +0900
Subject: [PATCH] Embedding: keep the loads whose values go unused

The dead-flag pass also removes dead code, and a load is free of side
effects to it. A compare or test against memory whose flags nobody
reads therefore loses its load, and with it the fault the load takes:
a guard-page probe such as a safepoint poll runs on past an unmapped
page. An embedding host owns guest memory, so for it every guest load
stays, whether or not its value is read.
---
 FEXCore/Source/Interface/IR/PassManager.cpp   |  2 +-
 FEXCore/Source/Interface/IR/Passes.h          |  2 +-
 .../RedundantFlagCalculationElimination.cpp   | 23 +++++++++++++++++--
 3 files changed, 23 insertions(+), 4 deletions(-)

diff --git a/FEXCore/Source/Interface/IR/PassManager.cpp b/FEXCore/Source/Interface/IR/PassManager.cpp
index aaedcc4142dcf8d4f6c8f7d9c8e22b9fece16f8a..7d18ebf66a42455d525ef358ac10bb208e367381 100644
--- a/FEXCore/Source/Interface/IR/PassManager.cpp
+++ b/FEXCore/Source/Interface/IR/PassManager.cpp
@@ -74,7 +74,7 @@ void PassManager::AddDefaultPasses(Context::ContextImpl* ctx) {
   // still be well-formed regardless of the modifications made to it.
   if (!DisablePasses()) {
     InsertPass(CreateX87StackOptimizationPass(ctx->HostFeatures, ctx->Config.Is64BitMode ? IR::OpSize::i64Bit : IR::OpSize::i32Bit, ctx->Embedded));
-    InsertPass(CreateDeadFlagCalculationEliminination());
+    InsertPass(CreateDeadFlagCalculationEliminination(ctx->Embedded));
   }
 
   // Its analysis needs the arguments that register allocation replaces.
diff --git a/FEXCore/Source/Interface/IR/Passes.h b/FEXCore/Source/Interface/IR/Passes.h
index f0d98842499c517ed6a38ff5d23d79cbed6312df..51a9b26490bd1768e047e23131626557ff21a204 100644
--- a/FEXCore/Source/Interface/IR/Passes.h
+++ b/FEXCore/Source/Interface/IR/Passes.h
@@ -11,7 +11,7 @@ struct HostFeatures;
 namespace FEXCore::IR {
 class Pass;
 
-fextl::unique_ptr<Pass> CreateDeadFlagCalculationEliminination();
+fextl::unique_ptr<Pass> CreateDeadFlagCalculationEliminination(bool Embedded = false);
 fextl::unique_ptr<Pass> CreateEmbedderReadsForWritePass();
 fextl::unique_ptr<Pass> CreateRegisterAllocationPass(const CPUIDEmu* CPUID, bool Embedded);
 fextl::unique_ptr<Pass> CreateX87StackOptimizationPass(const HostFeatures&, OpSize GPROpSize, bool Embedded = false);
diff --git a/FEXCore/Source/Interface/IR/Passes/RedundantFlagCalculationElimination.cpp b/FEXCore/Source/Interface/IR/Passes/RedundantFlagCalculationElimination.cpp
index dc44f1606b4e086e29f89f952b275899017aa1e4..873ad68233d1201bb5c0e4437feea6f17120edfb 100644
--- a/FEXCore/Source/Interface/IR/Passes/RedundantFlagCalculationElimination.cpp
+++ b/FEXCore/Source/Interface/IR/Passes/RedundantFlagCalculationElimination.cpp
@@ -150,9 +150,14 @@ struct ControlFlowGraph {
 
 class DeadFlagCalculationEliminination final : public FEXCore::IR::Pass {
 public:
+  explicit DeadFlagCalculationEliminination(bool Embedded)
+    : Embedded {Embedded} {}
   void Run(IREmitter* IREmit) override;
 
 private:
+  // An embedding host owns guest memory: a load whose value goes unused still
+  // translates its address, and the fault it takes is the guest's.
+  const bool Embedded;
   FlagInfo Classify(IROp_Header* Node);
   unsigned FlagsForCondClassType(CondClass Cond);
   bool EliminateDeadCode(IREmitter* IREmit, Ref CodeNode, IROp_Header* IROp);
@@ -451,6 +456,20 @@ bool DeadFlagCalculationEliminination::EliminateDeadCode(IREmitter* IREmit, Ref
     return false;
   }
 
+  if (Embedded) {
+    switch (IROp->Op) {
+    case OP_LOADMEM:
+    case OP_LOADMEMTSO:
+    case OP_LOADMEMX87SVEOPTPREDICATE:
+    case OP_VLOADVECTORMASKED:
+    case OP_VLOADVECTORGATHERMASKED:
+    case OP_VLOADVECTORGATHERMASKEDQPS:
+    case OP_VLOADVECTORELEMENT:
+    case OP_VBROADCASTFROMMEM: return false;
+    default: break;
+    }
+  }
+
   IREmit->Remove(CodeNode);
   return true;
 }
@@ -748,8 +767,8 @@ void DeadFlagCalculationEliminination::Run(IREmitter* IREmit) {
   }
 }
 
-fextl::unique_ptr<Pass> CreateDeadFlagCalculationEliminination() {
-  return fextl::make_unique<DeadFlagCalculationEliminination>();
+fextl::unique_ptr<Pass> CreateDeadFlagCalculationEliminination(bool Embedded) {
+  return fextl::make_unique<DeadFlagCalculationEliminination>(Embedded);
 }
 
 } // namespace FEXCore::IR
