From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 5 Oct 2026 00:07:40 +0900
Subject: [PATCH] Embedding: RDRAND and RDSEED read the host's random source

FEXCore implements RDRAND and RDSEED only with FEAT_RNG, which no Apple
core reports, and raised #UD for both otherwise, though the embedding
host's CPUID advertises them. Embedded, both call the host through
Pointers.EmbedderRandomHelper, preserving the caller-saved and PF and
AF registers as the TLB-miss stub does, and a result is always valid:
CF set, and OF, SF, ZF, AF and PF clear.
---
 FEXCore/Source/Interface/Core/JIT/MiscOps.cpp  | 18 ++++++++++++++++++
 .../Source/Interface/Core/OpcodeDispatcher.cpp | 10 ++++++++++
 FEXCore/include/FEXCore/Core/CoreState.h       |  2 ++
 3 files changed, 30 insertions(+)

diff --git a/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp b/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp
index b43ff26c1b32b98475135fe30260bf4664d86e05..94124b20f7b3ca2ffe2f86b5f8d2407db9075b85 100644
--- a/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp
@@ -324,6 +324,24 @@ DEF_OP(ProcessorID) {
 DEF_OP(RDRAND) {
   auto Op = IROp->C<IR::IROp_RDRAND>();
 
+  if (Embedded()) {
+    // RDRAND and RDSEED alike take a value from the host's random source.
+    // The call lands inside an op, where the register allocator may hold
+    // any 64-bit value in the PF and AF registers; the state spill keeps
+    // only their low halves.
+    stp<ARMEmitter::IndexType::PRE>(REG_PF.X(), REG_AF.X(), ARMEmitter::Reg::rsp, -16);
+    PushDynamicRegs(TMP4);
+    SpillStaticRegs(TMP4);
+    ldr(TMP4, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.EmbedderRandomHelper));
+    blr(TMP4);
+    mov(ARMEmitter::Size::i64Bit, TMP1, ARMEmitter::Reg::r0);
+    FillStaticRegs();
+    PopDynamicRegs();
+    ldp<ARMEmitter::IndexType::POST>(REG_PF.X(), REG_AF.X(), ARMEmitter::Reg::rsp, 16);
+    mov(ARMEmitter::Size::i64Bit, GetReg(Node), TMP1);
+    return;
+  }
+
   if (CTX->HostFeatures.SupportsRAND) {
     mrs(GetReg(Node), Op->GetReseeded ? ARMEmitter::SystemRegister::RNDRRS : ARMEmitter::SystemRegister::RNDR);
     return;
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
index 727221fcd01bf5d8987c0e7065b13b48482f6115..4bb41525f5283c91c6531f9ac31634cd2edcc1b7 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -5265,6 +5265,16 @@ void OpDispatchBuilder::CRC32(OpcodeArgs) {
 }
 
 void OpDispatchBuilder::RDRANDOp(OpcodeArgs, bool Reseed) {
+  if (CTX->Embedded) {
+    // An embedding host answers from its random source, which never fails:
+    // CF set, and OF, SF, ZF, AF and PF clear.
+    StoreResultGPR(Op, _RDRAND(Reseed));
+    ZeroPF_AF();
+    ZeroNZCV();
+    SetCFInverted(Constant(0));
+    return;
+  }
+
   if (!CTX->HostFeatures.SupportsRAND && !CTX->SoftwareRNGEnabled()) {
     UnimplementedOp(Op);
     return;
diff --git a/FEXCore/include/FEXCore/Core/CoreState.h b/FEXCore/include/FEXCore/Core/CoreState.h
index ba14e41aaec27aa97d91f0c456272c237f091466..f7ec970550dcfa2128a435a9c694b62e4391b1d1 100644
--- a/FEXCore/include/FEXCore/Core/CoreState.h
+++ b/FEXCore/include/FEXCore/Core/CoreState.h
@@ -433,6 +433,8 @@ struct JITPointers {
   uint64_t EmbedderTLBMissHelper {};
   // uint64_t (*)(CpuStateFrame*, const EmbedderStringOp*): 0 on success, else the state is spilled and the fault recorded.
   uint64_t EmbedderStringHelper {};
+  // uint64_t (*)(): a value from the host's random source for RDRAND and RDSEED.
+  uint64_t EmbedderRandomHelper {};
 
   FallbackABIInfo FallbackHandlerPointers[FallbackHandlerIndex::OPINDEX_MAX];
   uint64_t NamedVectorConstantPointers[FEXCore::IR::NamedVectorConstant::NAMED_VECTOR_CONST_POOL_MAX];
