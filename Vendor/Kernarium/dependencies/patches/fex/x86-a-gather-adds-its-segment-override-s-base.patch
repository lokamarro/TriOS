From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 5 Oct 2026 01:17:21 +0900
Subject: [PATCH] x86: a gather adds its segment override's base

The VSIB address of a gather was its base register and displacement
alone, so an FS or GS override was ignored and a TLS-relative gather
read the wrong memory. Both VSIB loaders now add the override's base,
which the backend adds to each element's scaled index.
---
 FEXCore/Source/Interface/Core/OpcodeDispatcher/AVX_128.cpp | 5 +++++
 FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp  | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/AVX_128.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/AVX_128.cpp
index 0079f632f103901977e51752b0acc8c910b81931..b73a6c4c233ef3828a5684ca934420480d2ac160 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/AVX_128.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/AVX_128.cpp
@@ -83,6 +83,11 @@ OpDispatchBuilder::AVX128_LoadVSIB(const X86Tables::DecodedOp& Op, const X86Tabl
     A.Displacement = static_cast<int32_t>(Operand.Data.SIB.Offset);
   }
 
+  // A segment override adds its base to every element's address.
+  if (Ref Segment = GetSegment(Flags)) {
+    A.BaseAddr = A.BaseAddr ? Add(OpSize::i64Bit, A.BaseAddr, Segment) : Segment;
+  }
+
   return A;
 }
 
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
index 37de3a08704917452c640f747affc1065d824c4d..44a4b53756ee9736923f12c0b84e563e693e04fe 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
@@ -5865,6 +5865,11 @@ OpDispatchBuilder::RefVSIB OpDispatchBuilder::LoadVSIB(const X86Tables::DecodedO
     A.Displacement = static_cast<int32_t>(Operand.Data.SIB.Offset);
   }
 
+  // A segment override adds its base to every element's address.
+  if (Ref Segment = GetSegment(Flags)) {
+    A.BaseAddr = A.BaseAddr ? Add(OpSize::i64Bit, A.BaseAddr, Segment) : Segment;
+  }
+
   return A;
 }
 
