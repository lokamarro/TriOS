From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 6 Oct 2026 09:34:54 +0900
Subject: [PATCH] Embedding: FNSAVE and FNSTENV tag registers as x86 does

FNSAVE and FNSTENV store x86's full tag word, which tags a register
that holds a value as a zero, as special -- a NaN, an infinity, a
denormal or pseudo-denormal, or an unnormal -- or as valid. FEXCore
keeps only whether each register is empty, and stored every full one
as valid. When FEXCore is embedded, the two now classify each full
register from its 80-bit value, branch-free, as an Intel host does at
the store: an MMX instruction leaves the registers it does not write
tagged by their contents, and one it writes, whose exponent is all
ones, special.

X87MMXInteraction expects FEX's tag word, and upstream lists it among
the native host's known failures.
---
 .../Interface/Core/OpcodeDispatcher/X87.cpp   | 25 ++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
index 7952bf8f8ca595acd55b3bdfa197718283f79fed..762280e820b311846888525902e1c620f3449ee6 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
@@ -328,7 +328,30 @@ Ref OpDispatchBuilder::GetX87FTW_Helper() {
   // The above sequence sets valid to 11 and empty to 00, so invert to finalize.
   static_assert(static_cast<uint8_t>(FPState::X87Tag::Valid) == 0b00);
   static_assert(static_cast<uint8_t>(FPState::X87Tag::Empty) == 0b11);
-  return _Xor(OpSize::i32Bit, X, Constant(0xffff));
+  X = _Xor(OpSize::i32Bit, X, Constant(0xffff));
+  if (!CTX->Embedded) {
+    return X;
+  }
+  // x86 classifies each full register from its 80-bit value: 01 for a
+  // zero, 10 for a special value -- a NaN, an infinity, a denormal or
+  // pseudo-denormal, or an unnormal -- and 00 for the rest. An empty
+  // register's 11 absorbs its class. Branch-free, without NZCV.
+  for (uint32_t Reg = 0; Reg < 8; ++Reg) {
+    const auto Slot = MMBaseOffset() + Reg * 16;
+    Ref Significand = _LoadContextGPR(OpSize::i64Bit, Slot);
+    Ref Exponent = _And(OpSize::i32Bit, _LoadContextGPR(OpSize::i16Bit, Slot + 8), Constant(0x7fff));
+    // Exponent 0, exponent 0x7fff, a zero significand and its integer bit.
+    Ref ExponentZero = _Lshr(OpSize::i32Bit, _Sub(OpSize::i32Bit, Exponent, Constant(1)), Constant(31));
+    Ref ExponentMax = _Lshr(OpSize::i32Bit, _Sub(OpSize::i32Bit, Constant(0x7ffe), Exponent), Constant(31));
+    Ref SignificandNonzero = _Lshr(OpSize::i64Bit, _Or(OpSize::i64Bit, Significand, _Neg(OpSize::i64Bit, Significand)), Constant(63));
+    Ref Integer = _Lshr(OpSize::i64Bit, Significand, Constant(63));
+    Ref Zero = _Andn(OpSize::i32Bit, ExponentZero, SignificandNonzero);
+    Ref Special = _Or(OpSize::i32Bit, ExponentMax, _And(OpSize::i32Bit, ExponentZero, SignificandNonzero));
+    Special = _Or(OpSize::i32Bit, Special, _Andn(OpSize::i32Bit, _Xor(OpSize::i32Bit, ExponentZero, Constant(1)), Integer));
+    Ref Tag = _Orlshl(OpSize::i32Bit, Zero, Special, 1);
+    X = _Orlshl(OpSize::i32Bit, X, Tag, Reg * 2);
+  }
+  return X;
 }
 
 void OpDispatchBuilder::X87FNSTENV(OpcodeArgs) {
