+void OpDispatchBuilder::EmbedderSegmentOp(OpcodeArgs) {
+  if (!CTX->Embedded) {
+    UnimplementedOp(Op);
+    return;
+  }
+  // The host runs the instruction from the state at its start.
+  CalculateDeferredFlags();
+  FlushRegisterCache();
+  BreakOp(Op, FEXCore::IR::BreakDefinition {
+                .ErrorRegister = 0,
+                .Signal = Core::EMBEDDER_SIGNAL_SEGMENT,
+                .TrapNumber = 0,
+                .si_code = 0,
+              });
+}
+
+uint32_t OpDispatchBuilder::EmbedderDefaultSegment(const X86Tables::DecodedOperand& Operand) const {
+  if (!CTX->Embedded || !CTX->EmbedderSegmented || Is64BitMode) {
+    return X86Tables::DecodeFlags::FLAG_NO_PREFIX;
+  }
+  uint8_t Base = X86State::REG_INVALID;
+  if (Operand.IsGPRDirect()) {
+    Base = Operand.Data.GPR.GPR;
+  } else if (Operand.IsGPRIndirect()) {
+    Base = Operand.Data.GPRIndirect.GPR;
+  } else if (Operand.IsSIB()) {
+    Base = Operand.Data.SIB.Base;
+  }
+  return Base == X86State::REG_RSP || Base == X86State::REG_RBP ? X86Tables::DecodeFlags::FLAG_SS_PREFIX :
+                                                                 X86Tables::DecodeFlags::FLAG_NO_PREFIX;
+}
+
+void OpDispatchBuilder::EmbedderSegmentCheck(OpcodeArgs) {
+  const uint32_t Prefix = Op->Flags & X86Tables::DecodeFlags::FLAG_SEGMENTS;
+  const bool CS = Prefix == X86Tables::DecodeFlags::FLAG_CS_PREFIX;
+  const bool GS = Prefix == X86Tables::DecodeFlags::FLAG_GS_PREFIX;
+  if (!CTX->Embedded || Is64BitMode || !Op->TableInfo || (!CS && !GS && Prefix != X86Tables::DecodeFlags::FLAG_FS_PREFIX)) {
+    return;
+  }
+  const auto Fn = Op->TableInfo->OpcodeDispatcher.OpDispatch;
+  // LEA and the hint NOPs reach no memory.
+  if (Fn == &OpDispatchBuilder::LEAOp || Fn == &OpDispatchBuilder::NOPOp) {
+    return;
+  }
+  const auto IsMemory = [&](const X86Tables::DecodedOperand& Operand) {
+    return Operand.IsGPRDirect() || Operand.IsGPRIndirect() || Operand.IsRIPRelative() || Operand.IsSIB() ||
+           (Operand.IsLiteral() && (Op->TableInfo->Flags & X86Tables::InstFlags::FLAGS_MEM_OFFSET) != 0);
+  };
+  const X86Tables::DecodedOperand* Memory {};
+  for (const auto* Operand : {&Op->Dest, &Op->Src[0], &Op->Src[1], &Op->Src[2]}) {
+    if (IsMemory(*Operand)) {
+      Memory = Operand;
+      break;
+    }
+  }
+  // What the check of one offset cannot cover: a string instruction's or
+  // XLAT's implicit operand, a masked store's, a gather's elements, and the
+  // images of more than the check's slack.
+  const bool Implicit = Fn == &OpDispatchBuilder::MOVSOp || Fn == &OpDispatchBuilder::CMPSOp || Fn == &OpDispatchBuilder::STOSOp ||
+                        Fn == &OpDispatchBuilder::LODSOp || Fn == &OpDispatchBuilder::SCASOp || Fn == &OpDispatchBuilder::XLATOp ||
+                        Fn == &OpDispatchBuilder::MASKMOVOp || Fn == &OpDispatchBuilder::AVX128_MASKMOV ||
+                        (Op->TableInfo->Flags & X86Tables::InstFlags::FLAGS_VEX_VSIB) != 0;
+  const bool Large = Memory && (Fn == &OpDispatchBuilder::FXSaveOp || Fn == &OpDispatchBuilder::FXRStoreOp ||
+                                Fn == &OpDispatchBuilder::XSaveOp || Fn == &OpDispatchBuilder::LoadFenceOrXRSTOR ||
+                                Fn == &OpDispatchBuilder::MemFenceOrXSAVEOPT || Fn == &OpDispatchBuilder::X87FNSAVE ||
+                                Fn == &OpDispatchBuilder::X87FRSTOR);
+  bool Guard {};
+  if (CS) {
+    // CS is the flat code segment, which every read passes and every write
+    // faults: only an operand the instruction may write needs the host.
+    Guard = Memory == &Op->Dest || Implicit || Large;
+  } else {
+    Guard = Implicit || Large;
+  }
+  const auto GPRSize = GetGPROpSize();
+  if (Guard) {
+    CalculateDeferredFlags();
+    Ref Bypass = _LoadContextGPR(OpSize::i32Bit, offsetof(FEXCore::Core::CpuStateFrame, Embedder.SegmentBypass));
+    auto CondJump_ = CondJump(Bypass, CondClass::EQ);
+    auto FaultBlock = CreateNewCodeBlockAfter(GetCurrentBlock());
+    SetTrueJumpTarget(CondJump_, FaultBlock);
+    SetCurrentCodeBlock(FaultBlock);
+    StartNewBlock();
+    _StoreContextGPR(GPRSize, GetRelocatedPC(Op, -Op->InstSize), offsetof(FEXCore::Core::CPUState, rip));
+    Break({
+      .ErrorRegister = 0,
+      .Signal = Core::EMBEDDER_SIGNAL_SEGMENT_CHECK,
+      .TrapNumber = 0,
+      .si_code = 0,
+    });
+    auto NextBlock = CreateNewCodeBlockAfter(FaultBlock);
+    SetFalseJumpTarget(CondJump_, NextBlock);
+    SetCurrentCodeBlock(NextBlock);
+    StartNewBlock();
+    return;
+  }
+  if (CS || !Memory) {
+    return;
+  }
+  // The offset, before the segment's base, at the address size.
+  Ref Offset {};
+  if (Memory->IsLiteral()) {
+    Offset = Constant(Memory->Literal() & ((Op->Flags & X86Tables::DecodeFlags::FLAG_ADDRESS_SIZE) ? 0xFFFFULL : 0xFFFF'FFFFULL));
+  } else {
+    Offset = LoadSourceGPR_WithOpSize(Op, *Memory, OpSize::i32Bit, Op->Flags, {.LoadData = false});
+    Offset = _Bfe(OpSize::i64Bit, 32, 0, Offset);
+  }
+  Ref Low = _LoadContextGPR(OpSize::i64Bit, GS ? offsetof(FEXCore::Core::CpuStateFrame, Embedder.SegmentChecks[1].Low) :
+                                                  offsetof(FEXCore::Core::CpuStateFrame, Embedder.SegmentChecks[0].Low));
+  Ref Span = _LoadContextGPR(OpSize::i64Bit, GS ? offsetof(FEXCore::Core::CpuStateFrame, Embedder.SegmentChecks[1].Span) :
+                                                   offsetof(FEXCore::Core::CpuStateFrame, Embedder.SegmentChecks[0].Span));
+  Ref Relative = _Sub(OpSize::i64Bit, Offset, Low);
+  CalculateDeferredFlags();
+  auto CondJump_ = CondJump(Relative, Span, InvalidNode, InvalidNode, CondClass::UGT, OpSize::i64Bit);
+  auto FaultBlock = CreateNewCodeBlockAfter(GetCurrentBlock());
+  SetTrueJumpTarget(CondJump_, FaultBlock);
+  SetCurrentCodeBlock(FaultBlock);
+  StartNewBlock();
+  _StoreContextGPR(GPRSize, GetRelocatedPC(Op, -Op->InstSize), offsetof(FEXCore::Core::CPUState, rip));
+  Break({
+    .ErrorRegister = 0,
+    .Signal = Core::EMBEDDER_SIGNAL_SEGMENT_CHECK,
+    .TrapNumber = 0,
+    .si_code = 0,
+  });
+  auto NextBlock = CreateNewCodeBlockAfter(FaultBlock);
+  SetFalseJumpTarget(CondJump_, NextBlock);
+  SetCurrentCodeBlock(NextBlock);
+  StartNewBlock();
+}
