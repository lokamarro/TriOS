@@ -3061,6 +3115,30 @@ void OpDispatchBuilder::EnterOp(OpcodeArgs) {
   const uint16_t AllocSpace = Value & 0xFFFF;
   const uint8_t Level = (Value >> 16) & 0x1F;
 
+  if (CTX->Embedded) {
+    // Every store addresses the stack from the old RSP, and RSP and RBP
+    // take nodes defined after the last of them: an access that faults
+    // leaves both as the instruction found them. A 16-bit frame writes BP
+    // alone.
+    const auto Bytes = IR::OpSizeToSize(OperandSize);
+    Ref OldSP = LoadGPRRegister(X86State::REG_RSP);
+    Ref OldBP = LoadGPRRegister(X86State::REG_RBP);
+    const auto StoreSlot = [&](uint64_t Slot, Ref Src) {
+      _StoreMem(RegClass::GPR, OperandSize, Src, Sub(GPRSize, OldSP, Slot * Bytes), Invalid(), OpSize::i8Bit, MemOffsetType::SXTX, 1);
+    };
+    StoreSlot(1, OldBP);
+    uint64_t Slots = 1;
+    if (Level > 0) {
+      for (uint8_t i = 1; i < Level; ++i) {
+        StoreSlot(++Slots, _LoadMemGPR(OperandSize, Sub(GPRSize, OldBP, i * Bytes), OperandSize));
+      }
+      StoreSlot(++Slots, Sub(GPRSize, OldSP, Bytes));
+    }
+    StoreGPRRegister(X86State::REG_RSP, Sub(GPRSize, OldSP, Slots * Bytes + AllocSpace));
+    StoreGPRRegister(X86State::REG_RBP, Sub(GPRSize, OldSP, Bytes), OperandSize == OpSize::i16Bit ? OpSize::i16Bit : GPRSize);
+    return;
+  }
