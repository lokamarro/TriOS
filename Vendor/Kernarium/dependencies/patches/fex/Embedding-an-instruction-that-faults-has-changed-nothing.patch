+// SPDX-License-Identifier: MIT
+/*
+$info$
+tags: ir|opts
+desc: Finds the loads an embedded backend translates for writing
+$end_info$
+*/
+
+#include "Interface/IR/IR.h"
+#include "Interface/IR/IREmitter.h"
+#include "Interface/IR/Passes.h"
+#include "Interface/IR/Passes/EmbedderReadsForWritePass.h"
+
+#include <FEXCore/IR/IR.h>
+#include <FEXCore/Utils/Profiler.h>
+#include <FEXCore/fextl/vector.h>
+
+#include <cstddef>
+
+namespace FEXCore::IR {
+namespace {
+  // LoadMem and LoadMemTSO, and StoreMem and StoreMemTSO, share a layout.
+  static_assert(offsetof(IROp_LoadMem, Addr) == offsetof(IROp_LoadMemTSO, Addr));
+  static_assert(offsetof(IROp_LoadMem, Offset) == offsetof(IROp_LoadMemTSO, Offset));
+  static_assert(offsetof(IROp_LoadMem, OffsetType) == offsetof(IROp_LoadMemTSO, OffsetType));
+  static_assert(offsetof(IROp_LoadMem, OffsetScale) == offsetof(IROp_LoadMemTSO, OffsetScale));
+  static_assert(offsetof(IROp_StoreMem, Addr) == offsetof(IROp_StoreMemTSO, Addr));
+  static_assert(offsetof(IROp_StoreMem, Offset) == offsetof(IROp_StoreMemTSO, Offset));
+  static_assert(offsetof(IROp_StoreMem, OffsetType) == offsetof(IROp_StoreMemTSO, OffsetType));
+  static_assert(offsetof(IROp_StoreMem, OffsetScale) == offsetof(IROp_StoreMemTSO, OffsetScale));
+
+  class ReadsForWrite final : public EmbedderReadsForWritePass {
+  public:
+    void Run(IREmitter* IREmit) override;
+
+  private:
+    // Runs before register allocation, while every argument names the node
+    // that computes it.
+    bool SameValue(const IRListView& IR, OrderedNodeWrapper A, OrderedNodeWrapper B, unsigned Depth) const;
+    fextl::vector<Ref> Loads;
+  };
+
+  bool ReadsForWrite::SameValue(const IRListView& IR, OrderedNodeWrapper A, OrderedNodeWrapper B, unsigned Depth) const {
+    if (A.IsInvalid() || B.IsInvalid()) {
+      return A.IsInvalid() && B.IsInvalid();
+    }
+    if (A.ID() == B.ID()) {
+      return true;
+    }
+    if (A.IsImmediate() || B.IsImmediate()) {
+      return false;
+    }
+    // The dispatcher forms an operand's address afresh for its load and its
+    // store, so the two may be equal values in distinct nodes. Only the pure
+    // operations an address is built from are compared.
+    const auto* OA = IR.GetOp<IROp_Header>(A);
+    const auto* OB = IR.GetOp<IROp_Header>(B);
+    if (OA->Op != OB->Op || OA->Size != OB->Size) {
+      return false;
+    }
+    switch (OA->Op) {
+    case OP_CONSTANT: return OA->C<IROp_Constant>()->Constant == OB->C<IROp_Constant>()->Constant;
+    case OP_INLINECONSTANT: return OA->C<IROp_InlineConstant>()->Constant == OB->C<IROp_InlineConstant>()->Constant;
+    case OP_ENTRYPOINTOFFSET: return OA->C<IROp_EntrypointOffset>()->Offset == OB->C<IROp_EntrypointOffset>()->Offset;
+    case OP_INLINEENTRYPOINTOFFSET: return OA->C<IROp_InlineEntrypointOffset>()->Offset == OB->C<IROp_InlineEntrypointOffset>()->Offset;
+    case OP_LOADCONTEXT: {
+      // A segment base, which no instruction that also stores memory changes.
+      const auto* CA = OA->C<IROp_LoadContext>();
+      const auto* CB = OB->C<IROp_LoadContext>();
+      return CA->Class == CB->Class && CA->Offset == CB->Offset;
+    }
+    case OP_ADD:
+    case OP_SUB:
+    case OP_LSHL:
+      return Depth != 0 && SameValue(IR, OA->Args[0], OB->Args[0], Depth - 1) && SameValue(IR, OA->Args[1], OB->Args[1], Depth - 1);
+    case OP_ADDSHIFT: {
+      const auto* SA = OA->C<IROp_AddShift>();
+      const auto* SB = OB->C<IROp_AddShift>();
+      return Depth != 0 && SA->Shift == SB->Shift && SA->ShiftAmount == SB->ShiftAmount && SameValue(IR, SA->Src1, SB->Src1, Depth - 1) &&
+             SameValue(IR, SA->Src2, SB->Src2, Depth - 1);
+    }
+    default: return false;
+    }
+  }
+
+  void ReadsForWrite::Run(IREmitter* IREmit) {
+    FEXCORE_PROFILE_SCOPED("PassManager::EmbedderReadsForWrite");
+
+    const auto IR = IREmit->ViewIR();
+    Marked.assign(IR.GetSSACount(), false);
+    for (auto [BlockNode, BlockHeader] : IR.GetBlocks()) {
+      Loads.clear();
+      for (auto [CodeNode, IROp] : IR.GetCode(BlockNode)) {
+        // The loads and stores of one instruction.
+        if (IROp->Op == OP_GUESTOPCODE) {
+          Loads.clear();
+          continue;
+        }
+        if (IROp->Op == OP_LOADMEM || IROp->Op == OP_LOADMEMTSO) {
+          Loads.push_back(CodeNode);
+          continue;
+        }
+        if (IROp->Op != OP_STOREMEM && IROp->Op != OP_STOREMEMTSO) {
+          continue;
+        }
+        const auto* Store = IROp->C<IROp_StoreMem>();
+        for (auto Load : Loads) {
+          const auto* LoadHeader = IR.GetOp<IROp_Header>(Load);
+          const auto* Op = LoadHeader->C<IROp_LoadMem>();
+          if (LoadHeader->Size == IROp->Size && Op->OffsetType == Store->OffsetType && Op->OffsetScale == Store->OffsetScale &&
+              SameValue(IR, Op->Addr, Store->Addr, 3) && SameValue(IR, Op->Offset, Store->Offset, 3)) {
+            Marked[IR.GetID(Load).Value] = true;
+          }
+        }
+      }
+    }
+  }
+} // namespace
+
+fextl::unique_ptr<Pass> CreateEmbedderReadsForWritePass() {
+  return fextl::make_unique<ReadsForWrite>();
+}
+
+} // namespace FEXCore::IR
