   return TMP1;
 }
 
+DEF_OP(EmbedderProbe) {
+  const auto Op = IROp->C<IR::IROp_EmbedderProbe>();
+  const auto Addr = GetReg(Op->Addr);
+  LOGMAN_THROW_A_FMT(Embedded() && Op->Size > 0 && Op->Size <= 4096, "Unexpected probe of {} bytes", Op->Size);
+  // The first byte, then the start of the page the last byte is on, which
+  // is the first byte's page when the operand does not cross one: a fault
+  // names the first byte of the operand that is not readable.
+  (void)EmbedderTranslate(Addr, 1, 0);
+  add(ARMEmitter::Size::i64Bit, TMP4, Addr, Op->Size - 1);
+  and_(ARMEmitter::Size::i64Bit, TMP4, TMP4, ~uint64_t {0xFFF});
+  (void)EmbedderTranslate(TMP4, 1, 0);
+}
