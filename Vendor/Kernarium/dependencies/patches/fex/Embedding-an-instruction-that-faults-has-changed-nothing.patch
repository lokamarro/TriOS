+namespace FEXCore::IR {
+
+// Embedded only, the last pass before register allocation: finds the loads
+// of each guest instruction that read what a store of the same instruction
+// then writes. The backend translates them for writing, so a fault of the
+// read-modify-write, a copy-on-write page among them, comes before the
+// instruction has changed a register or a flag.
+class EmbedderReadsForWritePass : public Pass {
+public:
+  // Node IDs survive register allocation, which adds nodes but neither
+  // moves nor renumbers a load.
+  bool ReadsForWrite(uint32_t ID) const {
+    return ID < Marked.size() && Marked[ID];
+  }
+
+protected:
+  fextl::vector<bool> Marked;
+};
+
+} // namespace FEXCore::IR
