 }
 
+// 1 when Value is zero and 0 when it is not, and the reverse, without
+// touching the host's condition flags.
+Ref OpDispatchBuilder::Zero01(Ref Value) {
+  return _Lshr(OpSize::i64Bit, _CountLeadingZeroes(OpSize::i64Bit, Value), Constant(6));
+}
+
+Ref OpDispatchBuilder::NonZero01(Ref Value) {
+  return _Lshr(OpSize::i64Bit, _Or(OpSize::i64Bit, Value, _Neg(OpSize::i64Bit, Value)), Constant(63));
+}
