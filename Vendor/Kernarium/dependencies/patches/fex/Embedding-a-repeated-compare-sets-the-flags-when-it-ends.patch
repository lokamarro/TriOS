-        Ref Dest_RDI = AppendSegmentOffset(Src_RDI, 0, X86Tables::DecodeFlags::FLAG_ES_PREFIX, true);
+      Ref Src_RSI = LoadGPRRegister(X86State::REG_RSI, AddrSize);
+      Ref Src_RDI = LoadGPRRegister(X86State::REG_RDI, AddrSize);
 
