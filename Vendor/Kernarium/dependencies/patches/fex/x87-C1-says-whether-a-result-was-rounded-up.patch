   if (State.exceptionFlags & softfloat_flag_inexact) {
     Raised |= 1U << 5;
   }
+  // C1 says whether the result was rounded up, away from zero. An invalid
+  // operation, and an unmasked denormal operand or division by zero,
+  // which leave no result, clear it, and so does a store that an unmasked
+  // overflow or underflow keeps from memory.
+  const uint16_t Unmasked = Raised & ~FCW & 0x3fU;
+  const bool NoResult = (Raised & 1U) != 0 || ((Unmasked | Frame->Embedder.X87Raised) & 0x07U) != 0;
+  const bool NoStore = Store && (Unmasked & 0x18U) != 0;
+  Frame->State.flags[FEXCore::X86State::X87FLAG_C1_LOC] =
+    !NoResult && !NoStore && (State.exceptionFlags & softfloat_flag_roundedUp) != 0;
   if (Raised == 0) {
     return;
   }
@@ -72,10 +81,9 @@ FEXCORE_PRESERVE_ALL_ATTR static void HandleX87Exception(const softfloat_state&
   // raised, x86 computes no result and raises none of a result's
   // exceptions. A store beside an unmasked overflow or underflow stores
   // nothing, and raises no precision.
-  const uint16_t Unmasked = Raised & ~FCW & 0x3fU;
   if (((Unmasked | Frame->Embedder.X87Raised) & 0x07U) != 0) {
     Raised &= 0x07U;
-  } else if (Store && (Unmasked & 0x18U) != 0) {
+  } else if (NoStore) {
     Raised &= ~(1U << 5);
   }
   for (unsigned Bit = 0; Bit < 6; ++Bit) {
@@ -316,7 +324,11 @@ struct OpHandlers<IR::OP_F80SINCOS> {
     FEXCORE_PROFILE_INSTANT_INCREMENT(Frame->Thread, AccumulatedFloatFallbackCount, 1);
     ScopedSoftFloatState State {FCW, Frame, true};
     State.Operands(Src1);
-    return FEXCore::MakeVectorRegPair(X80SoftFloat::FSIN(&State.State, Src1), X80SoftFloat::FCOS(&State.State, Src1));
+    const auto Sine = X80SoftFloat::FSIN(&State.State, Src1);
+    // C1 reports the rounding of the cosine, the value x86 pushes.
+    State.State.exceptionFlags &= ~softfloat_flag_roundedUp;
+    const auto Cosine = X80SoftFloat::FCOS(&State.State, Src1);
+    return FEXCore::MakeVectorRegPair(Sine, Cosine);
   }
 };
 
