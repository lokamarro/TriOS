From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 6 Oct 2026 13:28:47 +0900
Subject: [PATCH] TSO: let a host order stack-pointer accesses too

With TSO emulation on, FEXCore leaves an access whose address it forms
from RSP plain, on the assumption that only the thread itself uses its
stack. A local variable whose address another thread holds breaks that:
its owner reaches it through RSP, the other thread through a pointer,
and message passing through such a variable sees the data store after
the flag store. A host that must keep x86's memory model can now set
StackTSOEnabled, and with TSO on those accesses are ordered as any
other. Pushes and pops stay plain: they reach only the thread's own
slots at the top of its stack.
---
 FEXCore/Source/Interface/Config/Config.json.in   |  9 +++++++++
 FEXCore/Source/Interface/Context/Context.h       | 10 ++++++++++
 FEXCore/Source/Interface/Core/OpcodeDispatcher.h |  7 +++++--
 3 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/FEXCore/Source/Interface/Config/Config.json.in b/FEXCore/Source/Interface/Config/Config.json.in
index 938377f32409d90b36765566917b7312aef5e74c..5a25261e941d2d07969402cc267931a0105b4f0f 100644
--- a/FEXCore/Source/Interface/Config/Config.json.in
+++ b/FEXCore/Source/Interface/Config/Config.json.in
@@ -591,6 +591,15 @@
           "When TSO emulation is enabled, controls if vector loadstores should also be atomic."
         ]
       },
+      "StackTSOEnabled": {
+        "Type": "bool",
+        "Default": "false",
+        "AffectsCodeGen": "true",
+        "Desc": [
+          "When TSO emulation is enabled, controls if loadstores addressed through the stack pointer should also be atomic.",
+          "Pushes and pops stay non-atomic: they touch only the thread's own stack."
+        ]
+      },
       "MemcpySetTSOEnabled": {
         "Type": "bool",
         "Default": "false",
diff --git a/FEXCore/Source/Interface/Context/Context.h b/FEXCore/Source/Interface/Context/Context.h
index b12c41017663c752b7881707405c7ba5121d03b0..4ee4a22605e3bd17211b13b2d0d789e22dea918c 100644
--- a/FEXCore/Source/Interface/Context/Context.h
+++ b/FEXCore/Source/Interface/Context/Context.h
@@ -370,6 +370,7 @@ public:
     FEX_CONFIG_OPT(Is64BitMode, IS64BIT_MODE);
     FEX_CONFIG_OPT(TSOEnabled, TSOENABLED);
     FEX_CONFIG_OPT(VectorTSOEnabled, VECTORTSOENABLED);
+    FEX_CONFIG_OPT(StackTSOEnabled, STACKTSOENABLED);
     FEX_CONFIG_OPT(MemcpySetTSOEnabled, MEMCPYSETTSOENABLED);
     FEX_CONFIG_OPT(SMCChecks, SMCCHECKS);
     FEX_CONFIG_OPT(MaxInstPerBlock, MAXINST);
@@ -467,6 +468,12 @@ public:
     return VectorAtomicTSOEmulationEnabled;
   }
 
+  // If atomic-based TSO emulation is enabled for accesses addressed through
+  // the stack pointer.
+  bool IsStackAtomicTSOEnabled() const {
+    return StackAtomicTSOEmulationEnabled;
+  }
+
   // If atomic-based TSO emulation is enabled for memcpy operations.
   bool IsMemcpyAtomicTSOEnabled() const {
     return MemcpyAtomicTSOEmulationEnabled;
@@ -497,10 +504,12 @@ protected:
       // If the hardware supports TSO then we don't need to emulate it through atomics.
       AtomicTSOEmulationEnabled = false;
       VectorAtomicTSOEmulationEnabled = false;
+      StackAtomicTSOEmulationEnabled = false;
       MemcpyAtomicTSOEmulationEnabled = false;
     } else {
       AtomicTSOEmulationEnabled = Config.TSOEnabled;
       VectorAtomicTSOEmulationEnabled = Config.TSOEnabled && Config.VectorTSOEnabled;
+      StackAtomicTSOEmulationEnabled = Config.TSOEnabled && Config.StackTSOEnabled;
       MemcpyAtomicTSOEmulationEnabled = Config.TSOEnabled && Config.MemcpySetTSOEnabled;
     }
   }
@@ -518,6 +527,7 @@ private:
   bool SupportsHardwareTSO = false;
   bool AtomicTSOEmulationEnabled = true;
   bool VectorAtomicTSOEmulationEnabled = false;
+  bool StackAtomicTSOEmulationEnabled = false;
   bool MemcpyAtomicTSOEmulationEnabled = false;
 
   bool ExitOnHLT = false;
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
index a76b20a3c5215eddba5268fe0dc859dbd0510dce..74fee37ab14bd968dc77d2cccab6d54c9266d6d7 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
@@ -1634,9 +1634,12 @@ private:
     return !(Load && (Operand.IsLiteral() || Operand.IsLiteralRelocation() || Operand.IsLiteralPatchable())) && !Operand.IsGPR();
   }
 
+  // An access through the stack pointer is assumed to reach only the
+  // thread's own stack unless the host asks for those to keep TSO too: a
+  // local whose address another thread holds is reached through RSP.
   [[nodiscard]]
-  static bool IsNonTSOReg(MemoryAccessType Access, uint8_t Reg) {
-    return Access == MemoryAccessType::DEFAULT && Reg == X86State::REG_RSP;
+  bool IsNonTSOReg(MemoryAccessType Access, uint8_t Reg) const {
+    return Access == MemoryAccessType::DEFAULT && Reg == X86State::REG_RSP && !CTX->IsStackAtomicTSOEnabled();
   }
 
   AddressMode DecodeAddress(const X86Tables::DecodedOp& Op, const X86Tables::DecodedOperand& Operand, MemoryAccessType AccessType, bool IsLoad);
