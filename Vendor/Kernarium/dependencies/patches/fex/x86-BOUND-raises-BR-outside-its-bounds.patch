From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 5 Oct 2026 12:50:25 +0900
Subject: [PATCH] x86: BOUND raises #BR outside its bounds

Outside 64-bit mode 0x62 with a memory operand is BOUND, which FEXCore
decoded only as an EVEX prefix and so refused. It now reads the pair
of bounds in one access and compares the signed index with both,
raising #BR, a fault that leaves RIP naming the instruction, when the
index lies outside them. A register operand is still undefined, and
64-bit mode still decodes the byte as EVEX.
---
 .../Interface/Core/OpcodeDispatcher.cpp       | 36 +++++++++++++++++++
 .../Source/Interface/Core/OpcodeDispatcher.h  |  1 +
 .../Interface/Core/X86Tables/BaseTables.cpp   |  8 ++++-
 3 files changed, 44 insertions(+), 1 deletion(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
index 1277c674bbabfef573dcd5ddc47254e8f2448a22..bc90217605c6ac37a30f05a8730330e9939aecee 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -1145,6 +1145,42 @@ void OpDispatchBuilder::ARPLOp(OpcodeArgs) {
   StoreResultGPR_WithOpSize(Op, Op->Dest, FinalDest, Size);
 }
 
+void OpDispatchBuilder::BOUNDOp(OpcodeArgs) {
+  // BOUND r, m: the signed index in the register lies within the pair of
+  // bounds at the memory operand, lower then upper, or the instruction
+  // raises #BR, a fault. The pair is read in one access, so either half
+  // faulting is a fault of the instruction.
+  const auto Size = OpSizeFromDst(Op);
+  const auto Bits = IR::OpSizeAsBits(Size);
+  Ref Index = _Sbfe(OpSize::i64Bit, Bits, 0, LoadSourceGPR(Op, Op->Dest, Op->Flags, {.AllowUpperGarbage = true}));
+  Ref Pair = _LoadMemGPRAutoTSO(Size == OpSize::i16Bit ? OpSize::i32Bit : OpSize::i64Bit, MakeSegmentAddress(Op, Op->Src[0]), OpSize::i8Bit);
+  Ref Lower = _Sbfe(OpSize::i64Bit, Bits, 0, Pair);
+  Ref Upper = _Sbfe(OpSize::i64Bit, Bits, Bits, Pair);
+  // Bit 63 is set when the index is below the lower bound or above the
+  // upper one; neither difference of sign-extended values overflows.
+  Ref Outside = _Or(OpSize::i64Bit, _Sub(OpSize::i64Bit, Index, Lower), _Sub(OpSize::i64Bit, Upper, Index));
+
+  CalculateDeferredFlags();
+  auto CondJump_ = CondJumpBit(Outside, 63, false);
+  auto FalseBlock = CreateNewCodeBlockAfter(GetCurrentBlock());
+  SetFalseJumpTarget(CondJump_, FalseBlock);
+  SetCurrentCodeBlock(FalseBlock);
+  StartNewBlock();
+
+  _StoreContextGPR(GetGPROpSize(), GetRelocatedPC(Op, -Op->InstSize), offsetof(FEXCore::Core::CPUState, rip));
+  Break({
+    .ErrorRegister = 0,
+    .Signal = Core::FAULT_SIGSEGV,
+    .TrapNumber = X86State::X86_TRAPNO_BR,
+    .si_code = 0x80,
+  });
+
+  auto JumpTarget = CreateNewCodeBlockAfter(FalseBlock);
+  SetTrueJumpTarget(CondJump_, JumpTarget);
+  SetCurrentCodeBlock(JumpTarget);
+  StartNewBlock();
+}
+
 void OpDispatchBuilder::MOVSXDOp(OpcodeArgs) {
   // This instruction is a bit special
   // if SrcSize == 2
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
index 37b159f31dabe734528636c6aad61464a9fcad2b..1e4a22f1cbab383f80d3a644cea90a0a0717b15f 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
@@ -403,6 +403,7 @@ public:
   void RETFARIndirectOp(OpcodeArgs);
   void TESTOp(OpcodeArgs, uint32_t SrcIndex, bool DestRAX);
   void ARPLOp(OpcodeArgs);
+  void BOUNDOp(OpcodeArgs);
   void MOVSXDOp(OpcodeArgs);
   void MOVSXOp(OpcodeArgs);
   void MOVZXOp(OpcodeArgs);
diff --git a/FEXCore/Source/Interface/Core/X86Tables/BaseTables.cpp b/FEXCore/Source/Interface/Core/X86Tables/BaseTables.cpp
index 265b575d53868d8f2429dc642abfa017dff19f13..e7bc3a7a737bd68c5ac011739f5159b7ebbca697 100644
--- a/FEXCore/Source/Interface/Core/X86Tables/BaseTables.cpp
+++ b/FEXCore/Source/Interface/Core/X86Tables/BaseTables.cpp
@@ -31,6 +31,7 @@ enum Primary_LUT {
   ENTRY_48,
   ENTRY_60,
   ENTRY_61,
+  ENTRY_62,
   ENTRY_63,
   ENTRY_9A,
   ENTRY_A0,
@@ -122,6 +123,11 @@ constexpr std::array<X86InstInfo[2], ENTRY_MAX> Primary_ArchSelect_LUT = {{
     {"POPA",   TYPE_INST, FLAGS_DEBUG_MEM_ACCESS, 0, { .OpDispatch = &IR::OpDispatchBuilder::POPAOp } },
     {"", TYPE_INVALID, FLAGS_NONE, 0, { .OpDispatch = nullptr } },
   },
+  // ENTRY_62
+  {
+    {"BOUND",  TYPE_INST, FLAGS_MODRM | FLAGS_SF_MOD_MEM_ONLY | FLAGS_DEBUG_MEM_ACCESS, 0, { .OpDispatch = &IR::OpDispatchBuilder::BOUNDOp } },
+    {"",       TYPE_GROUP_EVEX, FLAGS_NONE, 0, { .OpDispatch = nullptr } },
+  },
   // ENTRY_63
   {
     {"ARPL",   TYPE_INST, GenFlagsSameSize(SIZE_16BIT) | FLAGS_MODRM | FLAGS_SF_MOD_DST, 0, { .OpDispatch = &IR::OpDispatchBuilder::ARPLOp } },
@@ -277,7 +283,7 @@ const std::array<X86InstInfo, MAX_PRIMARY_TABLE_SIZE> BaseOps = []() consteval {
 
     {0x60, 1, X86InstInfo{"", TYPE_ARCH_DISPATCHER, FLAGS_NONE, 0, { .Indirect = Primary_ArchSelect_LUT[ENTRY_60] }}},
     {0x61, 1, X86InstInfo{"", TYPE_ARCH_DISPATCHER, FLAGS_NONE, 0, { .Indirect = Primary_ArchSelect_LUT[ENTRY_61] }}},
-    {0x62, 1, X86InstInfo{"",       TYPE_GROUP_EVEX, FLAGS_NONE,                                                                           0}},
+    {0x62, 1, X86InstInfo{"", TYPE_ARCH_DISPATCHER, FLAGS_NONE, 0, { .Indirect = Primary_ArchSelect_LUT[ENTRY_62] }}},
     {0x63, 1, X86InstInfo{"", TYPE_ARCH_DISPATCHER, FLAGS_NONE, 0, { .Indirect = Primary_ArchSelect_LUT[ENTRY_63] }}},
 
     {0x68, 1, X86InstInfo{"PUSH",   TYPE_INST, GenFlagsSameSize(SIZE_64BITDEF) | FLAGS_DEBUG_MEM_ACCESS | FLAGS_DISPLACE_SIZE_DIV_2 | FLAGS_SRC_SEXT, 4}},
