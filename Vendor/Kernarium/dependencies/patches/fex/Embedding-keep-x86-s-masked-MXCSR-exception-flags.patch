+// Embedded: while a dispatch runs, the host's FPSR holds the guest's MXCSR
+// exception flags (EmbedderReadFPFlags), so host code the dispatch calls,
+// such as the compiler, leaves FPSR as it found it.
+class EmbedderFPSRGuard final {
+public:
+  explicit EmbedderFPSRGuard(bool Embedded) {
+#if defined(ARCHITECTURE_arm64)
+    Active = Embedded;
+    if (Active) {
+      __asm__ volatile("mrs %0, fpsr" : "=r"(Value)::"memory");
+    }
+#else
+    (void)Embedded;
+#endif
+  }
+  ~EmbedderFPSRGuard() {
+#if defined(ARCHITECTURE_arm64)
+    if (!Active) {
+      return;
+    }
+    uint64_t Now;
+    __asm__ volatile("mrs %0, fpsr" : "=r"(Now)::"memory");
+    if (Now != Value) {
+      __asm__ volatile("msr fpsr, %0" ::"r"(Value) : "memory");
+    }
+#endif
+  }
+  EmbedderFPSRGuard(const EmbedderFPSRGuard&) = delete;
+  EmbedderFPSRGuard& operator=(const EmbedderFPSRGuard&) = delete;
+
+private:
+  uint64_t Value {};
+  bool Active {};
+};
