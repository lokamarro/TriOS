+// The floating-point compares of the tests below look at the lanes of the
+// first Bytes bytes alone: the others, a scalar operation's upper lanes or a
+// memory source's padding, may hold signalling NaNs, for which even a quiet
+// compare raises the host's invalid operation flag. A scalar compare clears
+// the rest of Mask.
+
+// Mask = all ones in the lanes of the first Bytes bytes of Value that are
+// not NaNs. No NZCV writes.
+void Arm64JITCore::EmbedderFPOrdered(ARMEmitter::VRegister Mask, ARMEmitter::VRegister Value, uint32_t ElementBytes, uint32_t Bytes) {
+  if (Bytes == ElementBytes) {
+    fcmeq(ScalarSize(ElementBytes), Mask, Value, Value);
+  } else if (Bytes == 8) {
+    fcmeq(LaneSize(ElementBytes), Mask.D(), Value.D(), Value.D());
+  } else {
+    fcmeq(LaneSize(ElementBytes), Mask.Q(), Value.Q(), Value.Q());
+  }
+}
+
+// Mask = all ones in the lanes of the first Bytes bytes of Value that are
+// zeros. No NZCV writes.
+void Arm64JITCore::EmbedderFPZero(ARMEmitter::VRegister Mask, ARMEmitter::VRegister Value, uint32_t ElementBytes, uint32_t Bytes) {
+  if (Bytes == ElementBytes) {
+    fcmeq(ScalarSize(ElementBytes), Mask, Value);
+  } else if (Bytes == 8) {
+    fcmeq(LaneSize(ElementBytes), Mask.D(), Value.D());
+  } else {
+    fcmeq(LaneSize(ElementBytes), Mask.Q(), Value.Q());
+  }
+}
