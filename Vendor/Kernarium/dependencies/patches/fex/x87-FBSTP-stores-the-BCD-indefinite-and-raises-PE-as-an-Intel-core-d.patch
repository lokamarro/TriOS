From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 10 Oct 2026 07:42:52 +0900
Subject: [PATCH] x87: FBSTP stores the BCD indefinite and raises PE as an
 Intel core does

FBSTP rounded the operand to an integer and stored its low 18 digits,
whatever it was. On an Intel core a value that does not round to 18
decimal digits, a NaN, an infinity and an unsupported encoding store
the packed BCD indefinite (FFFF C000 0000 0000 0000 in the ten bytes)
and raise invalid operation alone, and a value that rounds inexactly
stores its digits and raises precision.

The handler now returns the indefinite for those operands, with the
precision and rounded-up flags cleared and invalid operation set, and
converts the rounded value as unsigned so that the 10^18 bound is a
comparison, not a wrapped signed result.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../Core/Interpreter/Fallbacks/F80Fallbacks.h    | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/FEXCore/Source/Interface/Core/Interpreter/Fallbacks/F80Fallbacks.h b/FEXCore/Source/Interface/Core/Interpreter/Fallbacks/F80Fallbacks.h
index ef5128b23e43660abcad722d4009cdc286e9de21..35faf93789f7b0683258acb000b2f2a37e76c271 100644
--- a/FEXCore/Source/Interface/Core/Interpreter/Fallbacks/F80Fallbacks.h
+++ b/FEXCore/Source/Interface/Core/Interpreter/Fallbacks/F80Fallbacks.h
@@ -606,12 +606,26 @@ struct OpHandlers<IR::OP_F80BCDSTORE> {
     ScopedSoftFloatState State {FCW, Frame};
     bool Negative = Src1.Top.Sign;
 
+    // A value that does not round to 18 decimal digits, a NaN, an infinity and
+    // an unsupported encoding store the packed BCD indefinite and raise
+    // invalid operation alone.
+    const auto Indefinite = [&State]() {
+      State.State.exceptionFlags = (State.State.exceptionFlags & ~(softfloat_flag_inexact | softfloat_flag_roundedUp)) | softfloat_flag_invalid;
+      return X80SoftFloat(1, 0x7FFF, 0xC000'0000'0000'0000ULL);
+    };
+    if (Src1.Top.Exponent == 0x7FFF || (Src1.Top.Exponent != 0 && (Src1.Significand >> 63) == 0)) {
+      return Indefinite();
+    }
+
     Src1 = X80SoftFloat::FRNDINT(&State.State, Src1);
 
     // Clear the Sign bit
     Src1.Top.Sign = 0;
 
-    uint64_t Tmp = Src1.ToI64(&State.State);
+    uint64_t Tmp = Src1.ToUI64(&State.State);
+    if ((State.State.exceptionFlags & softfloat_flag_invalid) != 0 || Tmp >= 1'000'000'000'000'000'000ULL) {
+      return Indefinite();
+    }
     X80SoftFloat Rv;
     uint8_t* BCD = reinterpret_cast<uint8_t*>(&Rv);
 
