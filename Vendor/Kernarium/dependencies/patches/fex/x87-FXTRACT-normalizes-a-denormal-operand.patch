From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 6 Oct 2026 23:12:37 +0900
Subject: [PATCH] x87: FXTRACT normalizes a denormal operand

FXTRACT took a denormal's exponent field and significand as they
were, giving 2^-16383 and an unnormal significand for 1 * 2^-16445.
x86 extracts those of the normalized value, -16445 and 1.0, and a
pseudo-denormal's as if its exponent were 1.
---
 FEXCore/Source/Common/SoftFloat.h | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/FEXCore/Source/Common/SoftFloat.h b/FEXCore/Source/Common/SoftFloat.h
index 4c09a5ca5a29b89301c70858848cf8b7de10a07e..2a0c23ec7386999d230d1b95a9b0a09cc656c71a 100644
--- a/FEXCore/Source/Common/SoftFloat.h
+++ b/FEXCore/Source/Common/SoftFloat.h
@@ -220,6 +220,10 @@ struct FEX_PACKED X80SoftFloat {
       return lhs;
     }
     X80SoftFloat Tmp = lhs;
+    if (lhs.Top.Exponent == 0) {
+      // A denormal's significand normalized; a pseudo-denormal's already is.
+      Tmp.Significand <<= std::countl_zero(lhs.Significand);
+    }
     Tmp.Top.Exponent = 0x3FFF;
     Tmp.Top.Sign = lhs.Top.Sign;
     return Tmp;
@@ -257,6 +261,11 @@ struct FEX_PACKED X80SoftFloat {
     }
 
     int32_t TrueExp = lhs.Top.Exponent - ExponentBias;
+    if (lhs.Top.Exponent == 0) {
+      // A denormal is its significand times 2^-16445, and a pseudo-denormal
+      // has the value it would with exponent 1.
+      TrueExp = 1 - static_cast<int32_t>(ExponentBias) - std::countl_zero(lhs.Significand);
+    }
     return i32_to_extF80(TrueExp);
 #endif
   }
