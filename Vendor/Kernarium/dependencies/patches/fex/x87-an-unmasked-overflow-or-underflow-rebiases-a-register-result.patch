--- a/External/SoftFloat-3e/include/SoftFloat-3e/softfloat.h
+++ b/External/SoftFloat-3e/include/SoftFloat-3e/softfloat.h
@@ -236,6 +236,8 @@ extFloat80_t extF80_sub( struct softfloat_state *, extFloat80_t, extFloat80_t );
 FEXCORE_PRESERVE_ALL_ATTR
 extFloat80_t extF80_mul( struct softfloat_state *, extFloat80_t, extFloat80_t );
 FEXCORE_PRESERVE_ALL_ATTR
+extFloat80_t extF80_scale( struct softfloat_state *, extFloat80_t, int_fast32_t );
+FEXCORE_PRESERVE_ALL_ATTR
 extFloat80_t extF80_div( struct softfloat_state *, extFloat80_t, extFloat80_t );
