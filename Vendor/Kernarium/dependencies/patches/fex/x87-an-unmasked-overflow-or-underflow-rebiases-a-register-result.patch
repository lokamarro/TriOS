 .../SoftFloat-3e/src/s_roundPackToExtF80.c    | 62 +++++++++++++++++++
 FEXCore/Source/Common/SoftFloat.h             | 36 ++++++-----
 .../Core/Interpreter/Fallbacks/F80Fallbacks.h |  9 +++
 7 files changed, 161 insertions(+), 16 deletions(-)
