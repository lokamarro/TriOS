   Site->GuestRIP = Op->NextRIP;
+  // NextRIP 0: a branch stored its target.
+  Site->RIPInState = Op->NextRIP == 0;
   Site->ExitReason = Core::EMBEDDER_EXIT_MODE;
   Site->Unretired = EmbedderUnretired(true);
   // The mode of the MXCSR the instruction stored: DAZ, FTZ, and the checks
@@ -551,8 +553,12 @@ DEF_OP(EmbedderFPModeCheck) {
   neg(i32, TMP3, TMP3);
   lsr(i32, TMP3, TMP3, 31);
   orr(i32, TMP2, TMP2, TMP3, ARMEmitter::ShiftType::LSL, 4);
+  // ALIGNMENT, RFLAGS.AC.
+  ldrb(TMP3.W(), STATE, offsetof(FEXCore::Core::CpuStateFrame, State.flags) + FEXCore::X86State::RFLAG_AC_LOC);
+  orr(i32, TMP2, TMP2, TMP3, ARMEmitter::ShiftType::LSL, 5);
   const auto Expected = CTX->EmbedderFPMode & (Core::EMBEDDER_FP_MODE_DAZ | Core::EMBEDDER_FP_MODE_FTZ | Core::EMBEDDER_FP_MODE_CHECK_SPECIAL |
-                                               Core::EMBEDDER_FP_MODE_CHECK_ALL | Core::EMBEDDER_FP_MODE_X87);
+                                               Core::EMBEDDER_FP_MODE_CHECK_ALL | Core::EMBEDDER_FP_MODE_X87 |
+                                               Core::EMBEDDER_FP_MODE_ALIGNMENT);
   if (Expected != 0) {
     eor(ARMEmitter::Size::i32Bit, TMP2, TMP2, Expected);
   }
