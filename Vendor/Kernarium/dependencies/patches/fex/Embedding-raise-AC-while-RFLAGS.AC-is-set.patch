   LOGMAN_THROW_A_FMT(Address != TMP1 && Address != TMP2 && Address != TMP3, "Translation temporaries would clobber the address");
   LOGMAN_THROW_A_FMT(Size > 0 && Size <= 64, "Unexpected access size {}", Size);
 
+  // x86 checks a gather's elements and a wider operand's parts by the
+  // instruction's own rules.
+  if ((Flags & (Core::EMBEDDER_ACCESS_GATHER | Core::EMBEDDER_ACCESS_COMMIT | Core::EMBEDDER_ACCESS_PART)) == 0) {
+    EmbedderAlignmentCheck(Address, Size);
+  }
+  Flags &= ~Core::EMBEDDER_ACCESS_PART;
+
   auto Site = fextl::make_unique<EmbedderColdSite>();
   Site->Address = Address;
   Site->Info = Size | Flags | (static_cast<uint64_t>(EmbedderUnretired(false)) << Core::EMBEDDER_ACCESS_UNRETIRED_SHIFT);
@@ -84,6 +91,30 @@ ARMEmitter::Register Arm64JITCore::EmbedderTranslate(ARMEmitter::Register Addres
   return TMP1;
 }
 
+void Arm64JITCore::EmbedderAlignmentCheck(ARMEmitter::Register Address, uint32_t Alignment) {
+  if ((CTX->EmbedderFPMode & Core::EMBEDDER_FP_MODE_ALIGNMENT) == 0 || EmbedderAlignmentExemptRIP == EmbedderCurrentRIP ||
+      (Alignment != 2 && Alignment != 4 && Alignment != 8)) {
+    return;
+  }
+  LOGMAN_THROW_A_FMT(Address != TMP2, "The alignment check would clobber the address");
+  auto Site = fextl::make_unique<EmbedderBudgetSite>();
+  Site->GuestRIP = EmbedderCurrentRIP;
+  Site->ExitReason = Core::EMBEDDER_EXIT_ALIGNMENT_FAULT;
+  Site->Unretired = EmbedderUnretired(false);
+  and_(ARMEmitter::Size::i64Bit, TMP2, Address, Alignment - 1);
+  cbnz_OrRestart(ARMEmitter::Size::i64Bit, TMP2, &Site->Entry);
+  EmbedderBudgetSites.push_back(std::move(Site));
+}
+
+DEF_OP(EmbedderAlignmentCheck) {
+  const auto Op = IROp->C<IR::IROp_EmbedderAlignmentCheck>();
+  LOGMAN_THROW_A_FMT(Embedded(), "EmbedderAlignmentCheck outside embedding");
+  EmbedderAlignmentCheck(GetReg(Op->Addr), Op->Alignment);
+  if (Op->Exempt) {
+    EmbedderAlignmentExemptRIP = EmbedderCurrentRIP;
+  }
+}
+
 DEF_OP(EmbedderProbe) {
   const auto Op = IROp->C<IR::IROp_EmbedderProbe>();
   const auto Addr = GetReg(Op->Addr);
