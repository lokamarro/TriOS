From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 10 Oct 2026 07:43:00 +0900
Subject: [PATCH] Embedding: FPTAN pushes the NaN of an operand that has no
 tangent

The embedded FPTAN pushed 1.0 after every tangent. For an operand
without one (a NaN, an infinity, an unsupported encoding, or an
operand the tangent finds invalid) an Intel core pushes the same NaN as
the tangent instead, so both registers hold it and ST(0) is no longer
the constant 1.0.

A new F80PTAN fallback op returns the tangent and the register to
push as a pair, as F80SINCOS does for FSINCOS: the second is 1.0
unless the tangent is a NaN, in which case it is that NaN. The x87 pass
emits it for the embedded translation, with the stack-overflow check
unchanged on both results.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../Core/Interpreter/Fallbacks/F80Fallbacks.h      | 14 ++++++++++++++
 .../Interpreter/Fallbacks/InterpreterFallbacks.cpp |  3 +++
 FEXCore/Source/Interface/IR/IR.json                |  5 +++++
 .../IR/Passes/x87StackOptimizationPass.cpp         | 12 +++++++-----
 FEXCore/include/FEXCore/Core/CoreState.h           |  1 +
 5 files changed, 30 insertions(+), 5 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/Interpreter/Fallbacks/F80Fallbacks.h b/FEXCore/Source/Interface/Core/Interpreter/Fallbacks/F80Fallbacks.h
index 35faf93789f7b0683258acb000b2f2a37e76c271..7d7dd98b9d212b97196e19669372308e0b63f078 100644
--- a/FEXCore/Source/Interface/Core/Interpreter/Fallbacks/F80Fallbacks.h
+++ b/FEXCore/Source/Interface/Core/Interpreter/Fallbacks/F80Fallbacks.h
@@ -371,6 +371,20 @@ struct OpHandlers<IR::OP_F80SINCOS> {
   }
 };
 
+template<>
+struct OpHandlers<IR::OP_F80PTAN> {
+  FEXCORE_PRESERVE_ALL_ATTR static VectorRegPairType handle(uint16_t FCW, VectorRegType Src1, FEXCore::Core::CpuStateFrame* Frame) {
+    FEXCORE_PROFILE_INSTANT_INCREMENT(Frame->Thread, AccumulatedFloatFallbackCount, 1);
+    ScopedSoftFloatState State {FCW, Frame, true};
+    State.Operands(Src1);
+    const auto Tangent = X80SoftFloat::FTAN(&State.State, Src1);
+    // The register FPTAN pushes holds 1.0, or the NaN an operand without a
+    // tangent returns.
+    const bool IsNaN = Tangent.Top.Exponent == 0x7FFF && (Tangent.Significand & 0x7FFF'FFFF'FFFF'FFFFULL) != 0;
+    return FEXCore::MakeVectorRegPair(Tangent, IsNaN ? Tangent : X80SoftFloat(0, 0x3FFF, 0x8000'0000'0000'0000ULL));
+  }
+};
+
 template<>
 struct OpHandlers<IR::OP_F80XTRACT_EXP> {
   FEXCORE_PRESERVE_ALL_ATTR static VectorRegType handle(uint16_t FCW, VectorRegType Src1, FEXCore::Core::CpuStateFrame* Frame) {
