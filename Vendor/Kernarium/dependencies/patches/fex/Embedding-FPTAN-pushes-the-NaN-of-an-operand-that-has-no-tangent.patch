   Info[Core::OPINDEX_F80SINCOS] = {ABIHandlers[FABI_F80x2_I16_F80_PTR],
                                    reinterpret_cast<uint64_t>(&FEXCore::CPU::OpHandlers<IR::OP_F80SINCOS>::handle)};
+  Info[Core::OPINDEX_F80PTAN] = {ABIHandlers[FABI_F80x2_I16_F80_PTR],
