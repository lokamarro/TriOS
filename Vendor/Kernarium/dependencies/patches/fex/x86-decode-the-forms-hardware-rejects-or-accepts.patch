@@ -1548,6 +1558,12 @@ uint32_t OpDispatchBuilder::GetConstantShift(X86Tables::DecodedOp Op, bool Is1Bi
 }
 
 void OpDispatchBuilder::XGetBVOp(OpcodeArgs) {
+  // XGETBV and XSETBV take no 66, F2 or F3 prefix.
+  if (Op->Flags & (X86Tables::DecodeFlags::FLAG_OPERAND_SIZE | X86Tables::DecodeFlags::FLAG_REP_PREFIX |
+                   X86Tables::DecodeFlags::FLAG_REPNE_PREFIX)) {
+    UnimplementedOp(Op);
+    return;
+  }
