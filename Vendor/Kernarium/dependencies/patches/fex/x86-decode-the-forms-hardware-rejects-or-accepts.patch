@@ -5302,8 +5318,8 @@ void OpDispatchBuilder::LoadFenceOrXRSTOR(OpcodeArgs) {
 }
 
 void OpDispatchBuilder::MemFenceOrXSAVEOPT(OpcodeArgs) {
-  if (Op->ModRM == 0xF0) {
-    // 0xF0 is MFENCE
+  if (!DestIsMem(Op)) {
+    // MFENCE
     _Fence(FenceType::LoadStore);
   } else {
     XSaveOp(Op);
@@ -5311,8 +5327,8 @@ void OpDispatchBuilder::MemFenceOrXSAVEOPT(OpcodeArgs) {
 }
 
 void OpDispatchBuilder::StoreFenceOrCLFlush(OpcodeArgs) {
-  if (Op->ModRM == 0xF8) {
-    // 0xF8 is SFENCE
+  if (!DestIsMem(Op)) {
+    // SFENCE
     _Fence(FenceType::Store);
   } else {
     // This is a CLFlush
@@ -5476,6 +5492,40 @@ void OpDispatchBuilder::UnimplementedOp(OpcodeArgs) {
               });
 }
 
+void OpDispatchBuilder::XSetBVOp(OpcodeArgs) {
+  if (Op->Flags & (X86Tables::DecodeFlags::FLAG_OPERAND_SIZE | X86Tables::DecodeFlags::FLAG_REP_PREFIX |
+                   X86Tables::DecodeFlags::FLAG_REPNE_PREFIX)) {
+    UnimplementedOp(Op);
+  } else {
+    PermissionRestrictedOp(Op);
+  }
+}
+
+// SWAPGS and SYSRET raise #GP outside ring 0 in 64-bit mode and are
+// undefined in compatibility mode.
+void OpDispatchBuilder::SWAPGSOp(OpcodeArgs) {
+  if (Is64BitMode) {
+    PermissionRestrictedOp(Op);
+  } else {
+    UnimplementedOp(Op);
+  }
+}
+
+void OpDispatchBuilder::SYSRETOp(OpcodeArgs) {
+  SWAPGSOp(Op);
+}
+
+// MOV to or from CR1, CR5, CR6, CR7 or CR9 to CR15 is undefined, which x86
+// checks before the privilege a move with CR0, CR2, CR3, CR4 or CR8 needs.
+void OpDispatchBuilder::MOVControlRegisterOp(OpcodeArgs) {
+  const uint8_t Register = ((Op->ModRM >> 3) & 7) | ((Op->Flags & X86Tables::DecodeFlags::FLAG_REX_XGPR_R) ? 8 : 0);
+  if (Register == 0 || Register == 2 || Register == 3 || Register == 4 || Register == 8) {
+    PermissionRestrictedOp(Op);
+  } else {
+    UnimplementedOp(Op);
+  }
+}
