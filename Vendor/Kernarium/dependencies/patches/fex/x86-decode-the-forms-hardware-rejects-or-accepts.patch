+// A register form of each is the fence, whatever its rm field.
 void OpDispatchBuilder::LoadFenceOrXRSTOR(OpcodeArgs) {
-  // 0xE8 signifies LFENCE
-  if (Op->ModRM == 0xE8) {
+  if (!DestIsMem(Op)) {
