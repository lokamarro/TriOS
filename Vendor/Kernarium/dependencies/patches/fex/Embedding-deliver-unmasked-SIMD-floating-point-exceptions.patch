@@ -59,33 +81,97 @@ enum class FPTest {
 // tiny result, and under DAZ alone it flushes one x86 keeps. A DPPS or DPPD
 // rounds in steps the result does not show, so it goes to the helper in
 // those two modes.
+//
+// While MXCSR unmasks a denormal operand, underflow or precision, which no
+// value shows, every check goes to the helper, which settles the
+// instruction's exceptions. While it unmasks only invalid operation,
+// division by zero or overflow, a check also takes the values that could
+// raise one, as the gadget engine's tests do: a result whose exponent is
+// all ones or one below, a NaN input to a comparison, minimum, maximum,
+// widening or rounding, a conversion's source near or out of range, and
+// every DPPS and DPPD.
 FPTest TestFor(Core::EmbedderFPKind Kind, uint32_t Mode, bool* Filtered) {
   const bool DAZ = (Mode & Core::EMBEDDER_FP_MODE_DAZ) != 0;
   const bool FTZ = (Mode & Core::EMBEDDER_FP_MODE_FTZ) != 0;
+  const bool Special = (Mode & Core::EMBEDDER_FP_MODE_CHECK_SPECIAL) != 0;
   *Filtered = false;
+  if ((Mode & Core::EMBEDDER_FP_MODE_CHECK_ALL) != 0) {
+    return FPTest::Always;
+  }
+  const auto Values = [Special](FPTest Test) {
+    if (!Special) {
+      return Test;
+    }
+    switch (Test) {
+    case FPTest::NaN: return FPTest::Special;
+    case FPTest::NaNOrZero: return FPTest::SpecialOrZero;
+    case FPTest::NaNOrTiny: return FPTest::SpecialOrTiny;
+    default: return Test;
+    }
+  };
   switch (Kind) {
+  case Core::EMBEDDER_FP_CMP:
+  case Core::EMBEDDER_FP_COMIS:
+  case Core::EMBEDDER_FP_WIDEN:
+  case Core::EMBEDDER_FP_ROUND:
+  case Core::EMBEDDER_FP_HALF_WIDEN: return FPTest::NaNInput;
+  case Core::EMBEDDER_FP_TO_INT:
+  case Core::EMBEDDER_FP_HALF_NARROW: return FPTest::InputAbove;
+  // Checked only while MXCSR unmasks precision.
+  case Core::EMBEDDER_FP_FROM_INT: return FPTest::Always;
   case Core::EMBEDDER_FP_MIN:
-  case Core::EMBEDDER_FP_MAX: return FPTest::Denormal;
-  case Core::EMBEDDER_FP_SQRT: return FPTest::NaN;
-  case Core::EMBEDDER_FP_DPP: return DAZ != FTZ ? FPTest::Always : FPTest::NaN;
+  case Core::EMBEDDER_FP_MAX:
+    if (Special) {
+      return DAZ ? FPTest::NaNInputOrDenormal : FPTest::NaNInput;
+    }
+    return FPTest::Denormal;
+  case Core::EMBEDDER_FP_SQRT: return Values(FPTest::NaN);
+  // Under the special checks, a DPPS or DPPD can raise invalid operation or
+  // overflow only from a source that is a NaN, an infinity or large enough
+  // for a product near the largest finite value: InputAbove.
+  case Core::EMBEDDER_FP_DPP:
+    if (Special) {
+      return DAZ != FTZ ? FPTest::Always : FPTest::InputAbove;
+    }
+    return DAZ != FTZ ? FPTest::Always : FPTest::NaN;
   case Core::EMBEDDER_FP_MUL:
   case Core::EMBEDDER_FP_DIV:
   case Core::EMBEDDER_FP_FMA:
   case Core::EMBEDDER_FP_NARROW:
     if (DAZ && FTZ) {
       *Filtered = true;
-      return FPTest::NaNOrZero;
+      return Values(FPTest::NaNOrZero);
     }
     [[fallthrough]];
   default:
     if (FTZ && !DAZ) {
-      return FPTest::NaNOrTiny;
+      return Values(FPTest::NaNOrTiny);
     }
     if (DAZ && !FTZ) {
-      return FPTest::NaNOrZero;
+      return Values(FPTest::NaNOrZero);
     }
-    return FPTest::NaN;
+    return Values(FPTest::NaN);
+  }
+}
+
+// An InputAbove test's bound on a source shifted left by one: the exponent
+// from which the conversion may leave its range. A single reaches 2^31 or
+// 2^63 only from there; a double just below 2^31 may round to it, so its
+// 32-bit bound is 2^30. A half overflows only from 65504.
+uint64_t InputBound(Core::EmbedderFPKind Kind, uint32_t ElementBytes, uint32_t Flags) {
+  if (Kind == Core::EMBEDDER_FP_HALF_NARROW) {
+    return uint64_t {127 + 15} << 24;
+  }
+  // A product of two sources below 2^62, or 2^510 for doubles, and a sum of
+  // four, stays below the largest finite value.
+  if (Kind == Core::EMBEDDER_FP_DPP) {
+    return ElementBytes == 8 ? uint64_t {1023 + 510} << 53 : uint64_t {127 + 62} << 24;
   }
+  const bool Int64 = (Flags & Core::EMBEDDER_FP_TO_INT64) != 0;
+  if (ElementBytes == 8) {
+    return uint64_t {Int64 ? 1023U + 63U : 1023U + 30U} << 53;
+  }
+  return uint64_t {Int64 ? 127U + 63U : 127U + 31U} << 24;
 }
 
 ARMEmitter::SubRegSize LaneSize(uint32_t ElementBytes) {
@@ -94,6 +180,110 @@ ARMEmitter::SubRegSize LaneSize(uint32_t ElementBytes) {
 
 } // namespace
 
+// Mask = all ones in the lanes of Value whose exponent is all ones or one
+// below. No NZCV writes.
+void Arm64JITCore::EmbedderFPSpecial(ARMEmitter::VRegister Mask, ARMEmitter::VRegister Value, uint32_t ElementBytes) {
+  const auto Lane = LaneSize(ElementBytes);
+  // The exponent's upper bits, which are all ones exactly then, as the sign
+  // they replicate.
+  shl(Lane, Mask.Q(), Value.Q(), 1);
+  sshr(Lane, Mask.Q(), Mask.Q(), ElementBytes == 8 ? 64 - 10 : 32 - 7);
+  mvn(ARMEmitter::SubRegSize::i8Bit, Mask.Q(), Mask.Q());
+  cmeq(Lane, Mask.Q(), Mask.Q());
+}
+
+// Branches to Target when any of the Bytes bytes of Value's lanes of
+// ElementBytes has an exponent of all ones or one below, whose upper bits,
+// all ones exactly then, a signed extraction turns into -1. No NZCV writes.
+void Arm64JITCore::EmbedderFPBranchIfSpecial(ARMEmitter::VRegister Value, uint32_t ElementBytes, uint32_t Bytes,
+                                             ARMEmitter::ForwardLabel* Target) {
+  const auto Lane = LaneSize(ElementBytes);
+  if (Bytes == ElementBytes) {
+    const auto Size = ElementBytes == 8 ? ARMEmitter::Size::i64Bit : ARMEmitter::Size::i32Bit;
+    if (ElementBytes == 8) {
+      fmov(Size, TMP1, Value.D());
+      sbfx(Size, TMP1, TMP1, 53, 10);
+    } else {
+      fmov(Size, TMP1.W(), Value.S());
+      sbfx(Size, TMP1, TMP1, 24, 7);
+    }
+    add(Size, TMP1, TMP1, 1);
+    cbz_OrRestart(Size, TMP1, Target);
+    return;
+  }
+  shl(Lane, VTMP1.Q(), Value.Q(), 1);
+  sshr(Lane, VTMP1.Q(), VTMP1.Q(), ElementBytes == 8 ? 64 - 10 : 32 - 7);
+  if (ElementBytes == 8) {
+    mvn(ARMEmitter::SubRegSize::i8Bit, VTMP1.Q(), VTMP1.Q());
+    cmeq(Lane, VTMP1.Q(), VTMP1.Q());
+    EmbedderFPBranchIfAny(VTMP1, Bytes, Target);
+    return;
+  }
+  // A single's lanes hold -1 there and at most -2 unsigned elsewhere.
+  if (Bytes > 8) {
+    umaxv(ARMEmitter::SubRegSize::i32Bit, VTMP1.Q(), VTMP1.Q());
+    fmov(ARMEmitter::Size::i32Bit, TMP1.W(), VTMP1.S());
+    add(ARMEmitter::Size::i32Bit, TMP1, TMP1, 1);
+    cbz_OrRestart(ARMEmitter::Size::i32Bit, TMP1, Target);
+  } else {
+    mvn(ARMEmitter::SubRegSize::i8Bit, VTMP1.Q(), VTMP1.Q());
+    cmeq(Lane, VTMP1.Q(), VTMP1.Q());
+    EmbedderFPBranchIfAny(VTMP1, Bytes, Target);
+  }
+}
+
+// Branches to Target when any of the first Bytes bytes of Mask, all ones or
+// zero in each lane, is clear. No NZCV writes.
+void Arm64JITCore::EmbedderFPBranchIfAnyClear(ARMEmitter::VRegister Mask, uint32_t Bytes, ARMEmitter::ForwardLabel* Target) {
+  if (Bytes > 8) {
+    uminv(ARMEmitter::SubRegSize::i32Bit, Mask.Q(), Mask.Q());
+    fmov(ARMEmitter::Size::i32Bit, TMP1.W(), Mask.S());
+    cbz_OrRestart(ARMEmitter::Size::i32Bit, TMP1, Target);
+  } else if (Bytes == 8) {
+    fmov(ARMEmitter::Size::i64Bit, TMP1, Mask.D());
+    mvn(ARMEmitter::Size::i64Bit, TMP1, TMP1);
+    cbnz_OrRestart(ARMEmitter::Size::i64Bit, TMP1, Target);
+  } else {
+    fmov(ARMEmitter::Size::i32Bit, TMP1.W(), Mask.S());
+    mvn(ARMEmitter::Size::i32Bit, TMP1, TMP1);
+    cbnz_OrRestart(ARMEmitter::Size::i32Bit, TMP1, Target);
+  }
+}
+
+// The tests on an exception-only kind's sources. No NZCV writes.
+void Arm64JITCore::EmbedderFPInputTest(const EmbedderFPSite& Site, uint32_t Kind, uint32_t ElementBytes, uint32_t Bytes,
+                                       uint32_t Flags, bool Above, ARMEmitter::ForwardLabel* Target) {
+  const auto Lane = LaneSize(ElementBytes);
+  if (Kind == Core::EMBEDDER_FP_CMP || Kind == Core::EMBEDDER_FP_COMIS || Kind == Core::EMBEDDER_FP_MIN || Kind == Core::EMBEDDER_FP_MAX) {
+    // All ones in the lanes where neither operand is a NaN.
+    fcmeq(Lane, VTMP1.Q(), Site.Sources[0].Q(), Site.Sources[0].Q());
+    fcmeq(Lane, VTMP2.Q(), Site.Sources[1].Q(), Site.Sources[1].Q());
+    and_(VTMP1.Q(), VTMP1.Q(), VTMP2.Q());
+    EmbedderFPBranchIfAnyClear(VTMP1, Bytes, Target);
+    return;
+  }
+  for (uint32_t Part = 0; Part < 2 && Part * 16 < Bytes; ++Part) {
+    const auto Source = Site.Sources[Part];
+    const auto PartBytes = std::min(Bytes - Part * 16, 16U);
+    if (Above) {
+      shl(Lane, VTMP1.Q(), Source.Q(), 1);
+      LoadConstant(ARMEmitter::Size::i64Bit, TMP1, InputBound(static_cast<Core::EmbedderFPKind>(Kind), ElementBytes, Flags));
+      dup(Lane, VTMP2.Q(), TMP1);
+      cmhs(Lane, VTMP1.Q(), VTMP1.Q(), VTMP2.Q());
+      EmbedderFPBranchIfAny(VTMP1, PartBytes, Target);
+    } else if (ElementBytes == 2) {
+      // A half's magnitude, shifted left by one, above an infinity's.
+      shl(ARMEmitter::SubRegSize::i16Bit, VTMP1.Q(), Source.Q(), 1);
+      movi(ARMEmitter::SubRegSize::i16Bit, VTMP2.Q(), 0xF8, 8);
+      cmhi(ARMEmitter::SubRegSize::i16Bit, VTMP1.Q(), VTMP1.Q(), VTMP2.Q());
+      EmbedderFPBranchIfAny(VTMP1, PartBytes, Target);
+    } else {
+      fcmeq(Lane, VTMP1.Q(), Source.Q(), Source.Q());
+      EmbedderFPBranchIfAnyClear(VTMP1, PartBytes, Target);
+    }
+  }
+}
+
