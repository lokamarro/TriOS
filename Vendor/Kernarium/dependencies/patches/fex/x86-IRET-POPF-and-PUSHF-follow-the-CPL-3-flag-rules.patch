From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 4 Oct 2026 22:38:54 +0900
Subject: [PATCH] x86: IRET, POPF and PUSHF follow the CPL 3 flag rules

At CPL 3 POPF loads every status and control flag but IF, IOPL, RF,
VM, VIF and VIP, and a 16-bit POPF only those in the low half; IRET
loads the same flags plus RF. The others keep their values whatever
the popped image holds. PUSHF stores RF and VM as zero.
SetPackedRFLAG takes the mask of the flags it writes.
---
 .../Interface/Core/OpcodeDispatcher.cpp       | 20 +++++++++----------
 .../Source/Interface/Core/OpcodeDispatcher.h  |  9 ++++++++-
 .../Interface/Core/OpcodeDispatcher/Flags.cpp |  6 +++++-
 3 files changed, 23 insertions(+), 12 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
index 23c3ee633c185950797b74e67bf18fa01e2e2911..cec1bb54a6080874b1491e01bad5cdca83f9adb8 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -176,8 +176,9 @@ void OpDispatchBuilder::IRETOp(OpcodeArgs) {
   _StoreContextGPR(OpSize::i16Bit, NewSegmentCS, offsetof(FEXCore::Core::CPUState, cs_idx));
   UpdatePrefixFromSegment(NewSegmentCS, FEXCore::X86Tables::DecodeFlags::FLAG_CS_PREFIX);
 
-  // eflags (lower 16 used)
-  SetPackedRFLAG(false, Pop(GPRSize, SP));
+  // At CPL 3 IRET loads what POPF loads, plus RF: IF, IOPL, VM, VIF and
+  // VIP keep their values.
+  SetPackedRFLAG(false, Pop(GPRSize, SP), UserLoadableFlags | (1U << X86State::RFLAG_RF_LOC));
 
   if (Is64BitMode) {
     // RSP and SS only happen in 64-bit mode or if this is a CPL mode jump!
@@ -3786,20 +3787,19 @@ void OpDispatchBuilder::BSWAPOp(OpcodeArgs) {
 void OpDispatchBuilder::PUSHFOp(OpcodeArgs) {
   const auto Size = OpSizeFromSrc(Op);
 
-  Push(Size, GetPackedRFLAG());
+  // PUSHF stores RF and VM as zero, whatever RFLAGS holds.
+  Push(Size, GetPackedRFLAG(~((1U << X86State::RFLAG_RF_LOC) | (1U << X86State::RFLAG_VM_LOC))));
 }
 
 void OpDispatchBuilder::POPFOp(OpcodeArgs) {
   const auto Size = OpSizeFromSrc(Op);
   Ref Src = Pop(Size);
 
-  // Add back our flag constants
-  // Bit 1 is always 1
-  // Bit 9 is always 1 because we always have interrupts enabled
-
-  Src = _Or(OpSize::i64Bit, Src, Constant(0x202));
-
-  SetPackedRFLAG(false, Src);
+  // At CPL 3 with IOPL 0, POPF leaves IF, IOPL, VM, VIF and VIP alone and
+  // clears RF, which no instruction after this one sees; a 16-bit POPF
+  // loads only the low half.
+  const uint32_t Loaded = Size == OpSize::i16Bit ? (UserLoadableFlags & 0xffffU) : UserLoadableFlags;
+  SetPackedRFLAG(false, Src, Loaded);
 
   auto NewRIP = GetRelocatedPC(Op);
   ExitFunction(NewRIP, BranchHint::CheckTF);
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
index 67db0c3073103299404a25bca2800c6ce1126a73..bc93b3c63a260e9e39c6addebbf07a4ed1535b8c 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
@@ -1135,7 +1135,14 @@ public:
   void InvalidOp(OpcodeArgs);
   void NoExecOp(OpcodeArgs);
 
-  void SetPackedRFLAG(bool Lower8, Ref Src);
+  // The flags POPF may load at CPL 3 with IOPL 0: every status and
+  // control flag but IF, IOPL, RF, VM, VIF and VIP.
+  static constexpr uint32_t UserLoadableFlags =
+    (1U << X86State::RFLAG_CF_RAW_LOC) | (1U << X86State::RFLAG_PF_RAW_LOC) | (1U << X86State::RFLAG_AF_RAW_LOC) |
+    (1U << X86State::RFLAG_ZF_RAW_LOC) | (1U << X86State::RFLAG_SF_RAW_LOC) | (1U << X86State::RFLAG_TF_RAW_LOC) |
+    (1U << X86State::RFLAG_DF_RAW_LOC) | (1U << X86State::RFLAG_OF_RAW_LOC) | (1U << X86State::RFLAG_NT_LOC) |
+    (1U << X86State::RFLAG_AC_LOC) | (1U << X86State::RFLAG_ID_LOC);
+  void SetPackedRFLAG(bool Lower8, Ref Src, uint32_t FlagsMask = ~0U);
   Ref GetPackedRFLAG(uint32_t FlagsMask = ~0U);
 
   void SetMultiblock(bool _Multiblock) {
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/Flags.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/Flags.cpp
index 858e7a4aea2527137a2812f6f41a50bab001d1c9..27f9b667da8c1a582a7e0614ed02cc629e76a4cb 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/Flags.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/Flags.cpp
@@ -32,7 +32,8 @@ void OpDispatchBuilder::ZeroPF_AF() {
   SetAF(0);
 }
 
-void OpDispatchBuilder::SetPackedRFLAG(bool Lower8, Ref Src) {
+void OpDispatchBuilder::SetPackedRFLAG(bool Lower8, Ref Src, uint32_t FlagsMask) {
+  LOGMAN_THROW_A_FMT(FlagsMask & (1 << FEXCore::X86State::RFLAG_CF_RAW_LOC), "CF always handled");
   size_t NumFlags = FlagOffsets.size();
   if (Lower8) {
     // Calculate flags early.
@@ -46,6 +47,9 @@ void OpDispatchBuilder::SetPackedRFLAG(bool Lower8, Ref Src) {
 
   for (size_t i = 0; i < NumFlags; ++i) {
     const auto FlagOffset = FlagOffsets[i];
+    if (!((1U << FlagOffset) & FlagsMask)) {
+      continue;
+    }
 
     if (FlagOffset == FEXCore::X86State::RFLAG_AF_RAW_LOC) {
       // AF is in bit 4 architecturally, and we need to store it to bit 4 of our
