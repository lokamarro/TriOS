+DEF_OP(EmbedderX87Wait) {
+  const auto Op = IROp->C<IR::IROp_EmbedderX87Wait>();
+  LOGMAN_THROW_A_FMT(Embedded(), "EmbedderX87Wait outside embedding");
+  EmbedderX87NextRIP = Op->NextRIP;
+  // #MF while an unmasked exception is pending, before the instruction does
+  // anything. No NZCV writes: guest flags are live.
+  auto Site = fextl::make_unique<EmbedderBudgetSite>();
+  Site->GuestRIP = EmbedderCurrentRIP;
+  Site->ExitReason = Core::EMBEDDER_EXIT_X87_FAULT;
+  Site->Unretired = EmbedderUnretired(false);
+  ldrb(TMP1.W(), STATE, offsetof(FEXCore::Core::CPUState, flags) + FEXCore::X86State::X87FLAG_ES_LOC);
+  cbnz_OrRestart(ARMEmitter::Size::i32Bit, TMP1, &Site->Entry);
+  str(ARMEmitter::WReg::zr, STATE, offsetof(FEXCore::Core::CpuStateFrame, Embedder.X87Raised));
+  EmbedderBudgetSites.push_back(std::move(Site));
+}
+
+DEF_OP(EmbedderX87Commit) {
+  const auto Op = IROp->C<IR::IROp_EmbedderX87Commit>();
+  LOGMAN_THROW_A_FMT(Embedded() && EmbedderX87NextRIP != 0, "EmbedderX87Commit without EmbedderX87Wait");
+  // The instruction retires with the status word its exception set, and
+  // nothing else. No NZCV writes.
+  auto Site = fextl::make_unique<EmbedderBudgetSite>();
+  Site->GuestRIP = EmbedderX87NextRIP;
+  Site->ExitReason = Core::EMBEDDER_EXIT_X87_EXCEPTION;
+  Site->Unretired = EmbedderUnretired(true);
+  ldr(TMP1.W(), STATE, offsetof(FEXCore::Core::CpuStateFrame, Embedder.X87Raised));
+  and_(ARMEmitter::Size::i32Bit, TMP1, TMP1, Op->Mask);
+  cbnz_OrRestart(ARMEmitter::Size::i32Bit, TMP1, &Site->Entry);
+  EmbedderBudgetSites.push_back(std::move(Site));
+}
