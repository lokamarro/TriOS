+// Whether x86 raises #MF before the instruction while an unmasked x87
+// exception is pending: FWAIT, EMMS, FEMMS, an instruction with an MMX
+// register operand, and every x87 instruction but FNINIT, FNCLEX, FNSTSW,
+// FNSTCW, FNSTENV, FNSAVE and the FNENI, FNDISI and FNSETPM no-ops.
+bool ContextImpl::WaitsForX87(const FEXCore::X86Tables::X86InstInfo* TableInfo, const FEXCore::X86Tables::DecodedInst* DecodedInfo) {
+  using namespace FEXCore::X86Tables;
+  if (TableInfo >= X87F80Ops.data() && TableInfo < X87F80Ops.data() + X87F80Ops.size()) {
+    // OP is the escape less D8, then the ModRM byte.
+    const uint8_t ModRM = DecodedInfo->ModRM;
+    const bool Register = (ModRM >> 6) == 3;
+    const uint8_t Reg = (ModRM >> 3) & 7;
+    switch (0xD8 + (DecodedInfo->OP >> 8)) {
+    case 0xD9: return Register || (Reg != 6 && Reg != 7);
+    case 0xDB: return !(ModRM >= 0xE0 && ModRM <= 0xE4);
+    case 0xDD: return Register || (Reg != 6 && Reg != 7);
+    case 0xDF: return ModRM != 0xE0;
+    default: return true;
+    }
+  }
+  if (TableInfo == &BaseOps[0x9B] || TableInfo == &SecondBaseOps[0x77] || TableInfo == &SecondBaseOps[0x0E]) {
+    return true;
+  }
+  const auto MMX = [](const DecodedOperand& Operand) {
+    return Operand.IsGPR() && Operand.Data.GPR.GPR >= FEXCore::X86State::REG_MM_0 && Operand.Data.GPR.GPR <= FEXCore::X86State::REG_MM_7;
+  };
+  return MMX(DecodedInfo->Dest) || MMX(DecodedInfo->Src[0]) || MMX(DecodedInfo->Src[1]) || MMX(DecodedInfo->Src[2]);
+}
