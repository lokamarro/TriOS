-FEXCORE_PRESERVE_ALL_ATTR static void HandleX87Exception(const softfloat_state& State, uint16_t FCW, FEXCore::Core::CpuStateFrame* Frame) {
+// pending. Store is a conversion to the format of a memory destination.
+FEXCORE_PRESERVE_ALL_ATTR static void HandleX87Exception(const softfloat_state& State, uint16_t FCW, FEXCore::Core::CpuStateFrame* Frame,
+                                                         bool Store) {
   uint16_t Raised = 0;
   if (State.exceptionFlags & softfloat_flag_invalid) {
     Raised |= 1U << 0;
@@ -66,6 +67,17 @@ FEXCORE_PRESERVE_ALL_ATTR static void HandleX87Exception(const softfloat_state&
   if (Raised == 0) {
     return;
   }
+  // After an unmasked invalid operation, denormal operand or division by
+  // zero, this operation's or one an earlier operation of its instruction
+  // raised, x86 computes no result and raises none of a result's
+  // exceptions. A store beside an unmasked overflow or underflow stores
+  // nothing, and raises no precision.
+  const uint16_t Unmasked = Raised & ~FCW & 0x3fU;
+  if (((Unmasked | Frame->Embedder.X87Raised) & 0x07U) != 0) {
+    Raised &= 0x07U;
+  } else if (Store && (Unmasked & 0x18U) != 0) {
+    Raised &= ~(1U << 5);
+  }
   for (unsigned Bit = 0; Bit < 6; ++Bit) {
     if (Raised & (1U << Bit)) {
       Frame->State.flags[FEXCore::X86State::X87FLAG_IE_LOC + Bit] = 1;
@@ -74,6 +86,8 @@ FEXCORE_PRESERVE_ALL_ATTR static void HandleX87Exception(const softfloat_state&
   if (Raised & ~FCW & 0x3fU) {
     Frame->State.flags[FEXCore::X86State::X87FLAG_ES_LOC] = 1;
     Frame->State.flags[FEXCore::X86State::X87FLAG_B_LOC] = 1;
+    // For an embedding host's commit checks.
+    Frame->Embedder.X87Raised |= Raised & ~FCW & 0x3fU;
   }
 }
 
