From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 4 Oct 2026 22:52:34 +0900
Subject: [PATCH] x86: size IRET by its operand size in 64-bit mode

IRET keeps a 32-bit default operand size in 64-bit mode: IRETQ needs
REX.W, and 0x66 selects 16 bits. FEXCore popped a 64-bit frame for
every IRET there and refused the 16-bit form. Each slot is now popped
at the instruction's operand size and zero-extended, and a 16-bit
image loads only the low half of the flags.
---
 .../Source/Interface/Core/OpcodeDispatcher.cpp | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
index cec1bb54a6080874b1491e01bad5cdca83f9adb8..ceb293cdf6eb01c967be78bed28f5e25ea9bfaec 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -158,14 +158,14 @@ RSP
 SS
 */
 void OpDispatchBuilder::IRETOp(OpcodeArgs) {
-  // Operand Size override unsupported!
-  if ((Op->Flags & X86Tables::DecodeFlags::FLAG_OPERAND_SIZE) != 0) {
-    LogMan::Msg::EFmt("IRET only implemented for 64bit and 32bit sizes");
-    DecodeFailure = true;
-    return;
-  }
-
-  const auto GPRSize = GetGPROpSize();
+  // IRET keeps a 32-bit default operand size in 64-bit mode too: IRETQ
+  // needs REX.W, and 0x66 selects 16 bits. A narrower RIP, CS, RFLAGS,
+  // RSP or SS is zero-extended by its load.
+  const auto GPRSize = (Op->Flags & X86Tables::DecodeFlags::FLAG_REX_WIDENING) ? OpSize::i64Bit :
+                       (Op->Flags & X86Tables::DecodeFlags::FLAG_OPERAND_SIZE) ? OpSize::i16Bit :
+                                                                                 OpSize::i32Bit;
+  // A 16-bit image holds only the low half of the flags.
+  const uint32_t Loaded = (UserLoadableFlags | (1U << X86State::RFLAG_RF_LOC)) & (GPRSize == OpSize::i16Bit ? 0xffffU : ~0U);
 
   Ref SP = _RMWHandle(LoadGPRRegister(X86State::REG_RSP));
 
@@ -178,7 +178,7 @@ void OpDispatchBuilder::IRETOp(OpcodeArgs) {
 
   // At CPL 3 IRET loads what POPF loads, plus RF: IF, IOPL, VM, VIF and
   // VIP keep their values.
-  SetPackedRFLAG(false, Pop(GPRSize, SP), UserLoadableFlags | (1U << X86State::RFLAG_RF_LOC));
+  SetPackedRFLAG(false, Pop(GPRSize, SP), Loaded);
 
   if (Is64BitMode) {
     // RSP and SS only happen in 64-bit mode or if this is a CPL mode jump!
