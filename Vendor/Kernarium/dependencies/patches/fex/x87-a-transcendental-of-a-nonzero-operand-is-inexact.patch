From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 6 Oct 2026 23:12:37 +0900
Subject: [PATCH] x87: a transcendental of a nonzero operand is inexact

FSIN, FCOS, FPTAN and FSINCOS of a finite nonzero operand, and FPATAN
with a nonzero result, compute a value no 80-bit number holds, though
for a tiny operand the 128-bit approximation rounds to the operand
itself or to 1 and so raised nothing. x86 raises precision for every
such result, and underflow with it for a denormal one; the Xeon 8581C
gives sin(2^-70) = 2^-70 and cos(2^-70) = 1 with PE, and sin of a
denormal with UE and PE. The helpers now raise them.
---
 FEXCore/Source/Common/SoftFloat.h | 36 +++++++++++++++++++++++++++----
 1 file changed, 32 insertions(+), 4 deletions(-)

diff --git a/FEXCore/Source/Common/SoftFloat.h b/FEXCore/Source/Common/SoftFloat.h
index 039cd1f73669b42157fdd7cf8f630a59ea3328f0..4c09a5ca5a29b89301c70858848cf8b7de10a07e 100644
--- a/FEXCore/Source/Common/SoftFloat.h
+++ b/FEXCore/Source/Common/SoftFloat.h
@@ -415,7 +415,8 @@ struct FEX_PACKED X80SoftFloat {
     BIGFLOAT Src1_d = lhs.ToFMax(state);
     BIGFLOAT Src2_d = rhs.ToFMax(state);
     BIGFLOAT Tmp = FEXCore::cephes_128bit::atan2l(Src1_d, Src2_d);
-    return X80SoftFloat(state, Tmp);
+    // Only a zero arctangent is exact.
+    return InexactResult(state, Tmp, true, true);
 #endif
   }
 
@@ -447,7 +448,7 @@ struct FEX_PACKED X80SoftFloat {
 
     BIGFLOAT Src_d = lhs.ToFMax(state);
     Src_d = FEXCore::cephes_128bit::tanl(Src_d);
-    return X80SoftFloat(state, Src_d);
+    return InexactResult(state, Src_d, FiniteNonzero(lhs));
 #endif
   }
 
@@ -478,7 +479,7 @@ struct FEX_PACKED X80SoftFloat {
 
     BIGFLOAT Src_d = lhs.ToFMax(state);
     Src_d = FEXCore::cephes_128bit::sinl(Src_d);
-    return X80SoftFloat(state, Src_d);
+    return InexactResult(state, Src_d, FiniteNonzero(lhs));
 #endif
   }
 
@@ -504,7 +505,7 @@ struct FEX_PACKED X80SoftFloat {
 
     BIGFLOAT Src_d = lhs.ToFMax(state);
     Src_d = FEXCore::cephes_128bit::cosl(Src_d);
-    return X80SoftFloat(state, Src_d);
+    return InexactResult(state, Src_d, FiniteNonzero(lhs));
 #endif
   }
 
@@ -665,6 +666,33 @@ private:
 
   // Helper function to check for infinity and set invalid operation flag.
   // Returns true if infinity is dealt with, false otherwise.
+  // A transcendental result that is not exact, though its 128-bit value may
+  // round to the operand itself or to 1, as for a tiny operand: x86 raises
+  // precision for it, and underflow for a denormal one. Inexact says the
+  // true value is not exact; with ZeroExact, any but a zero result is not.
+  FEXCORE_PRESERVE_ALL_ATTR static X80SoftFloat
+  InexactResult(softfloat_state* state, BIGFLOAT Value, bool Inexact, bool ZeroExact = false) {
+    const auto Before = state->exceptionFlags;
+    state->exceptionFlags &= ~softfloat_flag_inexact;
+    X80SoftFloat Result(state, Value);
+    if (ZeroExact) {
+      Inexact = FiniteNonzero(Result);
+    }
+    if (Inexact && (state->exceptionFlags & softfloat_flag_inexact) == 0) {
+      state->exceptionFlags |= softfloat_flag_inexact;
+      if (Result.Top.Exponent == 0 && Result.Significand != 0) {
+        state->exceptionFlags |= softfloat_flag_underflow;
+      }
+    }
+    state->exceptionFlags |= Before;
+    return Result;
+  }
+
+  // Finite and nonzero: a sine, cosine or tangent of it is inexact.
+  FEXCORE_PRESERVE_ALL_ATTR static bool FiniteNonzero(const X80SoftFloat& Value) {
+    return Value.Top.Exponent != 0x7FFF && (Value.Top.Exponent != 0 || Value.Significand != 0);
+  }
+
   FEXCORE_PRESERVE_ALL_ATTR static bool HandleInfinityOp(softfloat_state* state, const X80SoftFloat& arg, X80SoftFloat& result) {
     if (arg.Top.Exponent == 0x7FFF && arg.Significand == 0x8000000000000000ULL) {
       state->exceptionFlags |= softfloat_flag_invalid;
