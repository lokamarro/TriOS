From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 10 Oct 2026 01:15:40 +0900
Subject: [PATCH] Embedding: FSTP ST(0), FCHS and FABS of an empty register

An empty ST(0) read is a stack underflow, and an Intel core answers it
with the QNaN indefinite in every case this change covers:

- FST ST(0) and FSTP ST(0) store nothing, so the translation read no
  register at all: an empty one popped without raising invalid
  operation or the stack-fault flag, and an unmasked exception was
  never reported. They now read ST(0), whose underflow sets both and
  raises #MF when invalid operation is unmasked.
- FCHS and FABS applied their sign operation to the indefinite the
  underflow returned, so the result was +indefinite. The stack
  optimization pass now keeps the indefinite as it is when the register
  was empty, as an invalid operation's response is not a number to
  change.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../Interface/Core/OpcodeDispatcher/X87.cpp      |  8 +++++++-
 .../IR/Passes/x87StackOptimizationPass.cpp       | 16 ++++++++++++++++
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
index 3a8b6ee32f68c8b1b2fb956adde02f131092dd5b..7f719b367702cabfe4652f7f16df3a2f8059543f 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
@@ -151,7 +151,13 @@ void OpDispatchBuilder::FST(OpcodeArgs, IR::OpSize Width) {
 void OpDispatchBuilder::FSTToStack(OpcodeArgs) {
   SetRFLAG<FEXCore::X86State::X87FLAG_C1_LOC>(Constant(0));
   const uint8_t Offset = Op->OP & 7;
-  _StoreStackToStack(Offset);
+  if (Offset == 0 && CTX->Embedded) {
+    // FST ST(0) and FSTP ST(0) store nothing, but read ST(0): an empty
+    // register is a stack underflow.
+    _ReadStackValue(0);
+  } else {
+    _StoreStackToStack(Offset);
+  }
 
   if (Op->TableInfo->Flags & X86Tables::InstFlags::FLAGS_POP) {
     _PopStackDestroy();
diff --git a/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp b/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp
index 93a0cc48533db709792bb475847710a59970ac25..491f1d090e6ebf5d59abf4238d12e16af692730d 100644
--- a/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp
+++ b/FEXCore/Source/Interface/IR/Passes/x87StackOptimizationPass.cpp
@@ -296,6 +296,10 @@ private:
   // results are the QNaN indefinite of a stack overflow. Returns the
   // operand to compute with, a zero that raises nothing when Full is 1.
   Ref TwoResultOperand(Ref Operand, Ref Full);
+  // Embedded, FCHS and FABS of an empty ST(0) leave the QNaN indefinite its
+  // stack underflow returns as it is: Value is that response, or ST(0),
+  // and Result what the sign operation made of it.
+  Ref KeepIndefinite(Ref Value, Ref Result);
   Ref X87FlagOr(uint32_t Flag, Ref Bit);
   // Update Top value in slow path for a pop
   void UpdateTopForPop_Slow(bool InvalidateTag = true);
@@ -594,6 +598,16 @@ inline Ref X87StackOptimization::X87StackFault(Ref Value, Ref Fault, bool Overfl
   return IREmit->_VBSL(OpSize::i128Bit, Mask, Indefinite, Value);
 }
 
+inline Ref X87StackOptimization::KeepIndefinite(Ref Value, Ref Result) {
+  if (!Embedded || ReducedPrecisionMode || !SlowPath || TopValidCache[0] == StackSlot::VALID) {
+    return Result;
+  }
+  // The register is empty exactly when its tag is not valid.
+  Ref Empty = IREmit->_Xor(OpSize::i32Bit, GetX87ValidTag_Slow(0), GetConstant(1));
+  Ref Mask = IREmit->_VDupFromGPR(OpSize::i128Bit, OpSize::i64Bit, IREmit->_Sub(OpSize::i64Bit, GetConstant(0), Empty));
+  return IREmit->_VBSL(OpSize::i128Bit, Mask, Value, Result);
+}
+
 inline Ref X87StackOptimization::TwoResultOperand(Ref Operand, Ref Full) {
   Ref Zero = IREmit->_VCastFromGPR(OpSize::i128Bit, OpSize::i64Bit, GetConstant(0));
   Ref Mask = IREmit->_VDupFromGPR(OpSize::i128Bit, OpSize::i64Bit, IREmit->_Sub(OpSize::i64Bit, GetConstant(0), Full));
@@ -1253,6 +1267,7 @@ void X87StackOptimization::Run(IREmitter* Emit) {
           Ref HelperNode = IREmit->_LoadNamedVectorConstant(OpSize::i128Bit, IR::NamedVectorConstant::NAMED_VECTOR_F80_SIGN_MASK);
           ResultNode = IREmit->_VXor(OpSize::i128Bit, Value, HelperNode);
         }
+        ResultNode = KeepIndefinite(Value, ResultNode);
         StoreStackValue(ResultNode);
         break;
       }
@@ -1268,6 +1283,7 @@ void X87StackOptimization::Run(IREmitter* Emit) {
           Ref HelperNode = IREmit->_LoadNamedVectorConstant(OpSize::i128Bit, IR::NamedVectorConstant::NAMED_VECTOR_F80_SIGN_MASK);
           ResultNode = IREmit->_VAndn(OpSize::i128Bit, Value, HelperNode);
         }
+        ResultNode = KeepIndefinite(Value, ResultNode);
         StoreStackValue(ResultNode);
         break;
       }
