From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 6 Oct 2026 23:12:37 +0900
Subject: [PATCH] Embedding: trigonometry leaves an operand of 2^63 or more

x86 does not reduce an FSIN, FCOS, FPTAN or FSINCOS operand of
magnitude 2^63 or more: it leaves it in ST0, pushes nothing, clears
C1 and sets C2, raising nothing, so software can reduce it and retry.
FEXCore computed the function of the huge value. Embedded, the
dispatcher reads ST0's exponent and the tag of the register and
branches round the operation for a full register with such an
operand; a NaN, an infinity or an empty register takes the
operation's own path.
---
 .../Interface/Core/OpcodeDispatcher/X87.cpp   | 33 +++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
index 128d0a55e24f0511b81fba8cccf96265c1f09608..b390921783d25292e80ef454861e104037c769d3 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
@@ -814,6 +814,39 @@ void OpDispatchBuilder::X87UpdatePending(Ref FSW, Ref FCW) {
 }
 
 void OpDispatchBuilder::X87OpHelper(OpcodeArgs, FEXCore::IR::IROps IROp, bool ZeroC2) {
+  if (ZeroC2 && CTX->Embedded) {
+    // FSIN, FCOS, FPTAN and FSINCOS leave an operand of 2^63 or more as it
+    // is, push nothing, clear C1 and set C2, as x86 does; a NaN or an
+    // infinity, and an empty register, take the operation's own path.
+    Ref St0 = _ReadStackValue(0, true);
+    Ref Exponent = _And(OpSize::i32Bit, _VExtractToGPR(OpSize::i128Bit, OpSize::i64Bit, St0, 1), Constant(0x7FFF));
+    Ref Huge = Select01(OpSize::i32Bit, CondClass::ULT, _Sub(OpSize::i32Bit, Exponent, Constant(0x3FFF + 63)),
+                        Constant(0x7FFF - (0x3FFF + 63)));
+    // StackValidTag is 1 for a full register.
+    Ref Unreduced = _And(OpSize::i32Bit, Huge, _StackValidTag(0));
+    CalculateDeferredFlags();
+    auto CondJump_ = CondJump(Unreduced, CondClass::NEQ);
+    auto UnreducedBlock = CreateNewCodeBlockAfter(GetCurrentBlock());
+    SetTrueJumpTarget(CondJump_, UnreducedBlock);
+    SetCurrentCodeBlock(UnreducedBlock);
+    StartNewBlock();
+    SetRFLAG<FEXCore::X86State::X87FLAG_C1_LOC>(Constant(0));
+    SetRFLAG<FEXCore::X86State::X87FLAG_C2_LOC>(Constant(1));
+    auto UnreducedJump = Jump();
+    auto ReducedBlock = CreateNewCodeBlockAfter(UnreducedBlock);
+    auto ExitBlock = CreateNewCodeBlockAfter(ReducedBlock);
+    SetJumpTarget(UnreducedJump, ExitBlock);
+    SetFalseJumpTarget(CondJump_, ReducedBlock);
+    SetCurrentCodeBlock(ReducedBlock);
+    StartNewBlock();
+    DeriveOp(Result, IROp, _F80SCALEStack());
+    SetRFLAG<FEXCore::X86State::X87FLAG_C2_LOC>(Constant(0));
+    auto ReducedJump = Jump();
+    SetJumpTarget(ReducedJump, ExitBlock);
+    SetCurrentCodeBlock(ExitBlock);
+    StartNewBlock();
+    return;
+  }
   DeriveOp(Result, IROp, _F80SCALEStack());
   if (ZeroC2) {
     SetRFLAG<FEXCore::X86State::X87FLAG_C2_LOC>(Constant(0));
