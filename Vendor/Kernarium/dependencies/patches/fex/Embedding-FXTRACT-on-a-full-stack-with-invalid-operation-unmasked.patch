From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 9 Oct 2026 23:34:49 +0900
Subject: [PATCH] Embedding: FXTRACT on a full stack with invalid operation
 unmasked

x86 checks the register FXTRACT's significand goes to before it
computes anything. With the stack full and invalid operation unmasked
it raises the stack overflow and changes nothing else: no result is
pushed and the stack is as it was, with FSW 0x82c1 (IE, SF, C1, ES and
B) as on an Intel core. The embedded translation computed both results
and pushed the QNaN indefinite twice whether or not the exception was
masked.

A full stack now exits through a block that sets the status flags and
changes no register, with the exception unmasked. The masked case
still pushes the indefinite pair.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../Interface/Core/OpcodeDispatcher/X87.cpp   | 39 +++++++++++++++++--
 1 file changed, 36 insertions(+), 3 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
index abc3e4ddf518078153deda6117e8b9a264b754f2..3a8b6ee32f68c8b1b2fb956adde02f131092dd5b 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
@@ -1129,13 +1129,40 @@ void OpDispatchBuilder::X87FXAM(OpcodeArgs) {
 }
 
 void OpDispatchBuilder::X87FXTRACT(OpcodeArgs) {
+  Ref ExitBlock {};
+  if (CTX->Embedded) {
+    // x86 checks the register the significand goes to first. On a full stack
+    // with invalid operation unmasked it raises the stack overflow and
+    // changes nothing else: no result, no push, the stack as it was.
+    Ref Fault = _Andn(OpSize::i32Bit, _StackValidTag(7), _LoadContextGPR(OpSize::i16Bit, offsetof(FEXCore::Core::CPUState, FCW)));
+    auto FaultJump = CondJump(Fault, CondClass::NEQ);
+    auto FaultBlock = CreateNewCodeBlockAfter(GetCurrentBlock());
+    auto ComputeBlock = CreateNewCodeBlockAfter(FaultBlock);
+    ExitBlock = CreateNewCodeBlockAfter(ComputeBlock);
+    SetTrueJumpTarget(FaultJump, FaultBlock);
+    SetFalseJumpTarget(FaultJump, ComputeBlock);
+
+    SetCurrentCodeBlock(FaultBlock);
+    StartNewBlock();
+    SetRFLAG<FEXCore::X86State::X87FLAG_IE_LOC>(Constant(1));
+    SetRFLAG<FEXCore::X86State::X87FLAG_SF_LOC>(Constant(1));
+    SetRFLAG<FEXCore::X86State::X87FLAG_C1_LOC>(Constant(1));
+    SetRFLAG<FEXCore::X86State::X87FLAG_ES_LOC>(Constant(1));
+    SetRFLAG<FEXCore::X86State::X87FLAG_B_LOC>(Constant(1));
+    auto FaultExit = Jump();
+    SetJumpTarget(FaultExit, ExitBlock);
+
+    SetCurrentCodeBlock(ComputeBlock);
+    StartNewBlock();
+  }
+
   Ref Top = _ReadStackValue(0);
   Ref Full {};
   Ref Mask {};
   if (CTX->Embedded) {
-    // x86 checks the register the significand goes to first: on a full
-    // stack it computes nothing, and both results are the QNaN indefinite
-    // of the stack overflow the second push raises. 1.0 raises nothing.
+    // Masked, a full stack computes nothing either, and both results are the
+    // QNaN indefinite of the stack overflow the second push raises. 1.0
+    // raises nothing.
     Full = _StackValidTag(7);
     Mask = _VDupFromGPR(OpSize::i128Bit, OpSize::i64Bit, _Sub(OpSize::i64Bit, Constant(0), Full));
     Top = _VBSL(OpSize::i128Bit, Mask, LoadAndCacheNamedVectorConstant(OpSize::i128Bit, NamedVectorConstant::NAMED_VECTOR_X87_ONE), Top);
@@ -1151,6 +1178,12 @@ void OpDispatchBuilder::X87FXTRACT(OpcodeArgs) {
   }
   _PushStack(Exp, Invalid(), OpSize::iInvalid);
   _PushStack(Sig, Invalid(), OpSize::iInvalid);
+  if (ExitBlock) {
+    auto ComputeExit = Jump();
+    SetJumpTarget(ComputeExit, ExitBlock);
+    SetCurrentCodeBlock(ExitBlock);
+    StartNewBlock();
+  }
 }
 
 } // namespace FEXCore::IR
