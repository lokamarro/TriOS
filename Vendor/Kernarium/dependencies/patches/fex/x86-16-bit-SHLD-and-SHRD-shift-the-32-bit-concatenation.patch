From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 4 Oct 2026 23:02:26 +0900
Subject: [PATCH] x86: 16-bit SHLD and SHRD shift the 32-bit concatenation

A 16-bit double shift's masked count reaches 31. FEXCore filled the
result with zeros for counts above 16 and left CF clear for an
immediate SHLD count above 16 (it sets CF for a count of 16 itself).
Both forms of both instructions now shift the 32-bit concatenation of
the destination and the source, so the bits shifted in past the
source's width are the source's own and CF is the last bit shifted
out.
---
 .../Interface/Core/OpcodeDispatcher.cpp       | 70 ++++++++++++-------
 1 file changed, 44 insertions(+), 26 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
index ceb293cdf6eb01c967be78bed28f5e25ea9bfaec..727221fcd01bf5d8987c0e7065b13b48482f6115 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -1508,14 +1508,23 @@ void OpDispatchBuilder::SHLDOp(OpcodeArgs) {
     Shift = _And(OpSize::i64Bit, Shift, _InlineConstant(0x1F));
   }
 
-  // a64 masks the bottom bits, so if we're using a native 32/64-bit shift, we
-  // can negate to do the subtract (it's congruent), which saves a constant.
-  auto ShiftRight = Size >= 32 ? _Neg(OpSize::i64Bit, Shift) : Sub(OpSize::i64Bit, Constant(Size), Shift);
+  Ref Res {};
+  if (Size == 16) {
+    // A 16-bit SHLD shifts the 32-bit concatenation of Dest and Src, so a
+    // count above 16 shifts Src's own bits into the result, and bit 16 of
+    // the result is the last bit shifted out, which the flags take as CF.
+    auto Concat = _Orlshl(OpSize::i64Bit, Src, Dest, 16);
+    Res = _Lshr(OpSize::i64Bit, _Lshl(OpSize::i64Bit, Concat, Shift), Constant(16));
+  } else {
+    // a64 masks the bottom bits, so if we're using a native 32/64-bit shift, we
+    // can negate to do the subtract (it's congruent), which saves a constant.
+    auto ShiftRight = _Neg(OpSize::i64Bit, Shift);
 
-  auto Tmp1 = _Lshl(OpSize::i64Bit, Dest, Shift);
-  auto Tmp2 = _Lshr(Size == 64 ? OpSize::i64Bit : OpSize::i32Bit, Src, ShiftRight);
+    auto Tmp1 = _Lshl(OpSize::i64Bit, Dest, Shift);
+    auto Tmp2 = _Lshr(Size == 64 ? OpSize::i64Bit : OpSize::i32Bit, Src, ShiftRight);
 
-  Ref Res = _Or(OpSize::i64Bit, Tmp1, Tmp2);
+    Res = _Or(OpSize::i64Bit, Tmp1, Tmp2);
+  }
 
   // If shift count was zero then output doesn't change
   // Needs to be checked for the 32bit operand case
@@ -1541,19 +1550,20 @@ void OpDispatchBuilder::SHLDImmediateOp(OpcodeArgs) {
   if (Shift != 0) {
     Ref Res {};
     if (Size < 32) {
-      Ref ShiftLeft = Constant(Shift);
-      auto ShiftRight = Size - Shift;
-
-      auto Tmp1 = _Lshl(OpSize::i64Bit, Dest, ShiftLeft);
-      Ref Tmp2 = ShiftRight ? _Lshr(OpSize::i32Bit, Src, Constant(ShiftRight)) : Src;
-
-      Res = _Or(OpSize::i64Bit, Tmp1, Tmp2);
+      // A 16-bit SHLD shifts the 32-bit concatenation of Dest and Src, so a
+      // count of 16 or more shifts Src's own bits into the result and CF.
+      auto Concat = _Orlshl(OpSize::i64Bit, Src, Dest, 16);
+      Res = _Lshr(OpSize::i64Bit, _Lshl(OpSize::i64Bit, Concat, Constant(Shift)), Constant(16));
     } else {
       // 32-bit and 64-bit SHLD behaves like an EXTR where the lower bits are filled from the source.
       Res = _Extr(OpSizeFromSrc(Op), Dest, Src, Size - Shift);
     }
 
     CalculateFlags_ShiftLeftImmediate(OpSizeFromSrc(Op), Res, Dest, Shift, true);
+    if (Size < 32 && Shift > Size) {
+      // Bit 16 of the result is the last bit shifted out.
+      SetCFDirect(Res, Size, true);
+    }
     CalculateDeferredFlags();
     StoreResultGPR(Op, Res);
   } else if (Shift == 0 && Size == 32) {
@@ -1581,19 +1591,29 @@ void OpDispatchBuilder::SHRDOp(OpcodeArgs) {
     Shift = _And(OpSize::i64Bit, Shift, _InlineConstant(0x1F));
   }
 
-  auto ShiftLeft = Sub(OpSize::i64Bit, Constant(Size), Shift);
+  Ref Res {};
+  Ref Shifted = Dest;
+  if (Size == 16) {
+    // A 16-bit SHRD shifts the 32-bit concatenation of Src and Dest, so a
+    // count above 16 shifts Src's own bits into the result, and the flags
+    // take CF from the concatenation.
+    Shifted = _Orlshl(OpSize::i64Bit, Dest, Src, 16);
+    Res = _Lshr(OpSize::i64Bit, Shifted, Shift);
+  } else {
+    auto ShiftLeft = Sub(OpSize::i64Bit, Constant(Size), Shift);
 
-  auto Tmp1 = _Lshr(Size == 64 ? OpSize::i64Bit : OpSize::i32Bit, Dest, Shift);
-  auto Tmp2 = _Lshl(OpSize::i64Bit, Src, ShiftLeft);
+    auto Tmp1 = _Lshr(Size == 64 ? OpSize::i64Bit : OpSize::i32Bit, Dest, Shift);
+    auto Tmp2 = _Lshl(OpSize::i64Bit, Src, ShiftLeft);
 
-  Ref Res = _Or(OpSize::i64Bit, Tmp1, Tmp2);
+    Res = _Or(OpSize::i64Bit, Tmp1, Tmp2);
+  }
 
   // If shift count was zero then output doesn't change
   // Needs to be checked for the 32bit operand case
   // where shift = 0 and the source register still gets Zext
   Res = _Select(OpSize::i64Bit, OpSize::i64Bit, CondClass::EQ, Shift, Constant(0), Dest, Res);
 
-  HandleShift(Op, Res, Dest, ShiftType::LSR, Shift);
+  HandleShift(Op, Res, Shifted, ShiftType::LSR, Shift);
 }
 
 void OpDispatchBuilder::SHRDImmediateOp(OpcodeArgs) {
@@ -1605,21 +1625,19 @@ void OpDispatchBuilder::SHRDImmediateOp(OpcodeArgs) {
 
   if (Shift != 0) {
     Ref Res {};
+    Ref Shifted = Dest;
     if (Size < 32) {
-      Ref ShiftRight = Constant(Shift);
-      auto ShiftLeft = Constant(Size - Shift);
-
-      auto Tmp1 = _Lshr(OpSize::i32Bit, Dest, ShiftRight);
-      auto Tmp2 = _Lshl(OpSize::i64Bit, Src, ShiftLeft);
-
-      Res = _Or(OpSize::i64Bit, Tmp1, Tmp2);
+      // A 16-bit SHRD shifts the 32-bit concatenation of Src and Dest, so a
+      // count above 16 shifts Src's own bits into the result and CF.
+      Shifted = _Orlshl(OpSize::i64Bit, Dest, Src, 16);
+      Res = _Lshr(OpSize::i64Bit, Shifted, Constant(Shift));
     } else {
       // 32-bit and 64-bit SHRD behaves like an EXTR where the upper bits are filled from the source.
       Res = _Extr(OpSizeFromSrc(Op), Src, Dest, Shift);
     }
 
     StoreResultGPR(Op, Res);
-    CalculateFlags_ShiftRightDoubleImmediate(OpSizeFromSrc(Op), Res, Dest, Shift);
+    CalculateFlags_ShiftRightDoubleImmediate(OpSizeFromSrc(Op), Res, Shifted, Shift);
   } else if (Shift == 0 && Size == 32) {
     // Ensure Zext still occurs
     StoreResultGPR(Op, Dest);
