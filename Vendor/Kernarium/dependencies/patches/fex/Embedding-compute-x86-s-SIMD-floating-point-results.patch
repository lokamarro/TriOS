+// An EmbedderFPCheck op's Core::EmbedderFPDescriptor.
+struct FPDescriptor {
+  uint32_t Raw;
+
+  Core::EmbedderFPKind Kind() const {
+    return static_cast<Core::EmbedderFPKind>(Raw & 0xFF);
+  }
+  uint32_t ElementBytes() const {
+    return 2U << ((Raw >> Core::EMBEDDER_FP_ELEMENT_SHIFT) & 3);
+  }
+  uint32_t Lanes() const {
+    return (Raw >> Core::EMBEDDER_FP_LANES_SHIFT) & 0xF;
+  }
+  // A conversion's result lanes are singles.
+  uint32_t ResultElementBytes() const {
+    return Kind() == Core::EMBEDDER_FP_NARROW ? 4 : ElementBytes();
+  }
+  // Of the result the operation computes.
+  uint32_t Bytes() const {
+    return ResultElementBytes() * Lanes();
+  }
+};
+
+// The in-line test of a check: the lanes of the host's result that go to the
+// host's helper.
+enum class FPTest {
+  NaN,
+  NaNOrZero,
+  // A nonzero magnitude up to the smallest normal.
+  NaNOrTiny,
+  // A denormal: MIN and MAX return an input FPCR.FZ did not flush.
+  Denormal,
+  Always,
+};
+
+// The test for Kind under FP mode Mode. FPCR.FZ is MXCSR.DAZ, which flushes
+// inputs as x86 does but also flushes a result tiny before rounding. Without
+// DAZ or FTZ the host differs from x86 only in its NaNs. Under both, a sum
+// tiny enough to flush is exact, so only a product, quotient, FMA or
+// narrowing can differ, where it rounds up to the smallest normal: the
+// in-line test takes every zero, and Filtered asks for the precise test of
+// a zero from nonzero inputs out of line. Under FTZ alone the host keeps a
+// tiny result, and under DAZ alone it flushes one x86 keeps. A DPPS or DPPD
+// rounds in steps the result does not show, so it goes to the helper in
+// those two modes.
+FPTest TestFor(Core::EmbedderFPKind Kind, uint32_t Mode, bool* Filtered) {
+  const bool DAZ = (Mode & Core::EMBEDDER_FP_MODE_DAZ) != 0;
+  const bool FTZ = (Mode & Core::EMBEDDER_FP_MODE_FTZ) != 0;
+  *Filtered = false;
+  switch (Kind) {
+  case Core::EMBEDDER_FP_MIN:
+  case Core::EMBEDDER_FP_MAX: return FPTest::Denormal;
+  case Core::EMBEDDER_FP_SQRT: return FPTest::NaN;
+  case Core::EMBEDDER_FP_DPP: return DAZ != FTZ ? FPTest::Always : FPTest::NaN;
+  case Core::EMBEDDER_FP_MUL:
+  case Core::EMBEDDER_FP_DIV:
+  case Core::EMBEDDER_FP_FMA:
+  case Core::EMBEDDER_FP_NARROW:
+    if (DAZ && FTZ) {
+      *Filtered = true;
+      return FPTest::NaNOrZero;
+    }
+    [[fallthrough]];
+  default:
+    if (FTZ && !DAZ) {
+      return FPTest::NaNOrTiny;
+    }
+    if (DAZ && !FTZ) {
+      return FPTest::NaNOrZero;
+    }
+    return FPTest::NaN;
+  }
+}
+
+ARMEmitter::SubRegSize LaneSize(uint32_t ElementBytes) {
+  return ElementBytes == 8 ? ARMEmitter::SubRegSize::i64Bit : ARMEmitter::SubRegSize::i32Bit;
+}
+
+} // namespace
+
+// Mask = all ones in the lanes of Value whose magnitude, shifted left by one,
+// is from 1 to Threshold. Uses VTMP2. No NZCV writes.
+void Arm64JITCore::EmbedderFPMagnitudeBelow(ARMEmitter::VRegister Mask, ARMEmitter::VRegister Value, uint32_t ElementBytes,
+                                            uint64_t Threshold) {
+  const auto Lane = LaneSize(ElementBytes);
+  shl(Lane, Mask.Q(), Value.Q(), 1);
+  movi(ARMEmitter::SubRegSize::i64Bit, VTMP2.Q(), ~uint64_t {0});
+  // Zero wraps to the largest magnitude.
+  add(Lane, Mask.Q(), Mask.Q(), VTMP2.Q());
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Threshold);
+  dup(Lane, VTMP2.Q(), TMP1);
+  cmhi(Lane, Mask.Q(), VTMP2.Q(), Mask.Q());
+}
+
+// VTMP1 = all ones in the result lanes of Site that are NaNs, or zeros from
+// inputs that are not, for the precise test under DAZ and FTZ. Uses VTMP2.
+void Arm64JITCore::EmbedderFPZeroFromNonzero(const EmbedderFPSite& Site, uint32_t Kind, uint32_t ElementBytes) {
+  const auto Lane = LaneSize(ElementBytes);
+  // VTMP1: a lane with an input that is zero.
+  switch (Kind) {
+  case Core::EMBEDDER_FP_NARROW:
+    fcmeq(ARMEmitter::SubRegSize::i64Bit, VTMP1.Q(), Site.Sources[0].Q());
+    xtn(ARMEmitter::SubRegSize::i32Bit, VTMP1, VTMP1);
+    fcmeq(ARMEmitter::SubRegSize::i64Bit, VTMP2.Q(), Site.Sources[1].Q());
+    xtn2(ARMEmitter::SubRegSize::i32Bit, VTMP1, VTMP2);
+    break;
+  case Core::EMBEDDER_FP_DIV: fcmeq(Lane, VTMP1.Q(), Site.Sources[0].Q()); break;
+  default:
+    fcmeq(Lane, VTMP1.Q(), Site.Sources[0].Q());
+    fcmeq(Lane, VTMP2.Q(), Site.Sources[1].Q());
+    orr(VTMP1.Q(), VTMP1.Q(), VTMP2.Q());
+    break;
+  }
+  fcmeq(Lane, VTMP2.Q(), Site.Result.Q());
+  bic(VTMP1.Q(), VTMP2.Q(), VTMP1.Q());
+  fcmeq(Lane, VTMP2.Q(), Site.Result.Q(), Site.Result.Q());
+  orn(VTMP1.Q(), VTMP1.Q(), VTMP2.Q());
+}
+
+// Branches to Target when any of the first Bytes bytes of Mask, all ones or
+// zero in each lane, is set. No NZCV writes: guest flags may be live.
+void Arm64JITCore::EmbedderFPBranchIfAny(ARMEmitter::VRegister Mask, uint32_t Bytes, ARMEmitter::ForwardLabel* Target) {
+  if (Bytes > 8) {
+    umaxv(ARMEmitter::SubRegSize::i32Bit, Mask.Q(), Mask.Q());
+    fmov(ARMEmitter::Size::i32Bit, TMP1.W(), Mask.S());
+    cbnz_OrRestart(ARMEmitter::Size::i32Bit, TMP1, Target);
+  } else if (Bytes == 8) {
+    fmov(ARMEmitter::Size::i64Bit, TMP1, Mask.D());
+    cbnz_OrRestart(ARMEmitter::Size::i64Bit, TMP1, Target);
+  } else {
+    fmov(ARMEmitter::Size::i32Bit, TMP1.W(), Mask.S());
+    cbnz_OrRestart(ARMEmitter::Size::i32Bit, TMP1, Target);
+  }
+}
+
+// Branches to Target when any of the Bytes bytes of Value's lanes of
+// ElementBytes is a NaN: a scalar's one lane, or a whole vector. No NZCV
+// writes: guest flags may be live.
+void Arm64JITCore::EmbedderFPBranchIfNaN(ARMEmitter::VRegister Value, uint32_t ElementBytes, uint32_t Bytes,
+                                         ARMEmitter::ForwardLabel* Target) {
+  if (Bytes == 16) {
+    // All ones in the lanes that are not NaNs.
+    fcmeq(ElementBytes == 8 ? ARMEmitter::SubRegSize::i64Bit : ARMEmitter::SubRegSize::i32Bit, VTMP1.Q(), Value.Q(), Value.Q());
+    uminv(ARMEmitter::SubRegSize::i32Bit, VTMP1.Q(), VTMP1.Q());
+    fmov(ARMEmitter::Size::i32Bit, TMP1.W(), VTMP1.S());
+    cbz_OrRestart(ARMEmitter::Size::i32Bit, TMP1, Target);
+  } else if (ElementBytes == 8) {
+    fcmeq(ARMEmitter::ScalarRegSize::i64Bit, VTMP1, Value, Value);
+    fmov(ARMEmitter::Size::i64Bit, TMP1, VTMP1.D());
+    cbz_OrRestart(ARMEmitter::Size::i64Bit, TMP1, Target);
+  } else {
+    fcmeq(ARMEmitter::ScalarRegSize::i32Bit, VTMP1, Value, Value);
+    fmov(ARMEmitter::Size::i32Bit, TMP1.W(), VTMP1.S());
+    cbz_OrRestart(ARMEmitter::Size::i32Bit, TMP1, Target);
+  }
+}
+
+// RCPPS, RCPSS, RSQRTPS and RSQRTSS. x86 takes a denormal input as zero,
+// returns a zero for a reciprocal of 2^126 or more and the indefinite NaN for
+// the reciprocal square root of a negative number, and ignores MXCSR; the
+// host's correctly rounded quotient lies within x86's error everywhere else.
+// Lanes needing more than that quotient go to the host first, so the host
+// raises nothing for them: an exponent of zero, and for RCP one of 0xFD and
+// above, for RSQRT a negative sign.
+void Arm64JITCore::EmbedderFPEstimate(bool Reciprocal, uint32_t Bytes, ARMEmitter::VRegister Dst, ARMEmitter::VRegister Source,
+                                      ARMEmitter::VRegister Result, ARMEmitter::ForwardLabel* Cold) {
+  using ARMEmitter::SubRegSize;
+  const bool Scalar = Bytes == 4;
+  shl(SubRegSize::i32Bit, VTMP1.Q(), Source.Q(), 1);
+  if (Reciprocal) {
+    movi(SubRegSize::i32Bit, VTMP2.Q(), 0x03, 24);
+    add(SubRegSize::i32Bit, VTMP1.Q(), VTMP1.Q(), VTMP2.Q());
+    movi(SubRegSize::i32Bit, VTMP2.Q(), 0x04, 24);
+    cmhi(SubRegSize::i32Bit, VTMP1.Q(), VTMP2.Q(), VTMP1.Q());
+  } else {
+    movi(SubRegSize::i32Bit, VTMP2.Q(), 0x01, 24);
+    cmhi(SubRegSize::i32Bit, VTMP1.Q(), VTMP2.Q(), VTMP1.Q());
+    cmlt(SubRegSize::i32Bit, VTMP2.Q(), Source.Q());
+    orr(VTMP1.Q(), VTMP1.Q(), VTMP2.Q());
+  }
+  EmbedderFPBranchIfAny(VTMP1, Bytes, Cold);
+
+  if (Scalar) {
+    if (Reciprocal) {
+      fmov(ARMEmitter::ScalarRegSize::i32Bit, VTMP1, 1.0f);
+      fdiv(VTMP1.S(), VTMP1.S(), Source.S());
+    } else {
+      fsqrt(VTMP2.S(), Source.S());
+      fmov(ARMEmitter::ScalarRegSize::i32Bit, VTMP1, 1.0f);
+      fdiv(VTMP1.S(), VTMP1.S(), VTMP2.S());
+    }
+    if (Dst != Result) {
+      mov(Dst.Q(), Result.Q());
+    }
+    ins(SubRegSize::i32Bit, Dst, 0, VTMP1, 0);
+    return;
+  }
+  if (Reciprocal) {
+    fmov(SubRegSize::i32Bit, VTMP1.Q(), 1.0f);
+    fdiv(SubRegSize::i32Bit, Dst.Q(), VTMP1.Q(), Source.Q());
+  } else {
+    fsqrt(SubRegSize::i32Bit, VTMP2.Q(), Source.Q());
+    fmov(SubRegSize::i32Bit, VTMP1.Q(), 1.0f);
+    fdiv(SubRegSize::i32Bit, Dst.Q(), VTMP1.Q(), VTMP2.Q());
+  }
+}
+
+DEF_OP(EmbedderFPCheck) {
+  const auto Op = IROp->C<IR::IROp_EmbedderFPCheck>();
+  const FPDescriptor Desc {Op->Descriptor};
+  LOGMAN_THROW_A_FMT(Embedded() && Desc.Bytes() <= 16, "Unexpected EmbedderFPCheck {:#x}", Desc.Raw);
+
+  auto Site = fextl::make_unique<EmbedderFPSite>();
+  Site->Sources[0] = GetVReg(Op->Source1);
+  Site->Sources[1] = GetVReg(Op->Source2);
+  Site->Sources[2] = GetVReg(Op->Source3);
+  Site->Result = GetVReg(Op->Result);
+  Site->Dst = GetVReg(Node);
+  Site->Descriptor = Desc.Raw | (static_cast<uint64_t>(EmbedderUnretired(false)) << Core::EMBEDDER_FP_UNRETIRED_SHIFT);
+  Site->GuestRIP = EmbedderCurrentRIP;
+
+  switch (Desc.Kind()) {
+  case Core::EMBEDDER_FP_RCP:
+  case Core::EMBEDDER_FP_RSQRT:
+    EmbedderFPEstimate(Desc.Kind() == Core::EMBEDDER_FP_RCP, Desc.Bytes(), Site->Dst, Site->Sources[0], Site->Result, &Site->Entry);
+    break;
+  default: {
+    // A NaN differs in which source's the host propagates, in a subtracted
+    // NaN's sign and in the default NaN's sign; TestFor says what else.
+    const auto Lane = LaneSize(Desc.ResultElementBytes());
+    const auto Result = Site->Result;
+    const auto Test = TestFor(Desc.Kind(), CTX->EmbedderFPMode, &Site->Filtered);
+    auto* Target = Site->Filtered ? &Site->Filter : &Site->Entry;
+    switch (Test) {
+    case FPTest::NaN: EmbedderFPBranchIfNaN(Result, Desc.ResultElementBytes(), Desc.Bytes(), Target); break;
+    case FPTest::NaNOrZero:
+      fcmeq(Lane, VTMP1.Q(), Result.Q());
+      fcmeq(Lane, VTMP2.Q(), Result.Q(), Result.Q());
+      orn(VTMP1.Q(), VTMP1.Q(), VTMP2.Q());
+      EmbedderFPBranchIfAny(VTMP1, Desc.Bytes(), Target);
+      break;
+    case FPTest::NaNOrTiny:
+      EmbedderFPMagnitudeBelow(VTMP1, Result, Desc.ResultElementBytes(),
+                               Desc.ResultElementBytes() == 8 ? 0x0020'0000'0000'0000ULL : 0x0100'0000ULL);
+      fcmeq(Lane, VTMP2.Q(), Result.Q(), Result.Q());
+      orn(VTMP1.Q(), VTMP1.Q(), VTMP2.Q());
+      EmbedderFPBranchIfAny(VTMP1, Desc.Bytes(), Target);
+      break;
+    case FPTest::Denormal:
+      EmbedderFPMagnitudeBelow(VTMP1, Result, Desc.ResultElementBytes(),
+                               Desc.ResultElementBytes() == 8 ? 0x001F'FFFF'FFFF'FFFFULL : 0x00FF'FFFFULL);
+      EmbedderFPBranchIfAny(VTMP1, Desc.Bytes(), Target);
+      break;
+    case FPTest::Always: b_OrRestart(Target); break;
+    }
+    if (Site->Dst != Result) {
+      mov(Site->Dst.Q(), Result.Q());
+    }
+    break;
+  }
+  }
+  (void)Bind(&Site->Done);
+  EmbedderFPSites.push_back(std::move(Site));
+}
+
+DEF_OP(EmbedderFPModeCheck) {
+  const auto Op = IROp->C<IR::IROp_EmbedderFPModeCheck>();
+  LOGMAN_THROW_A_FMT(Embedded(), "EmbedderFPModeCheck outside embedding");
+  auto Site = fextl::make_unique<EmbedderBudgetSite>();
+  Site->GuestRIP = Op->NextRIP;
+  Site->ExitReason = Core::EMBEDDER_EXIT_MODE;
+  Site->Unretired = EmbedderUnretired(true);
+  // The mode of the MXCSR the instruction stored: DAZ, then FTZ. No NZCV
+  // writes: guest flags are live.
+  ldr(TMP1.W(), STATE, offsetof(FEXCore::Core::CpuStateFrame, State.mxcsr));
+  ubfx(ARMEmitter::Size::i32Bit, TMP2, TMP1, 6, 1);
+  lsr(ARMEmitter::Size::i32Bit, TMP1, TMP1, 15);
+  bfi(ARMEmitter::Size::i32Bit, TMP2, TMP1, 1, 1);
+  const auto Expected = CTX->EmbedderFPMode & (Core::EMBEDDER_FP_MODE_DAZ | Core::EMBEDDER_FP_MODE_FTZ);
+  if (Expected != 0) {
+    eor(ARMEmitter::Size::i32Bit, TMP2, TMP2, Expected);
+  }
+  cbnz_OrRestart(ARMEmitter::Size::i32Bit, TMP2, &Site->Entry);
+  EmbedderBudgetSites.push_back(std::move(Site));
+}
+
+void Arm64JITCore::EmitEmbedderFPSites() {
+  const auto Scratch = offsetof(FEXCore::Core::CpuStateFrame, Embedder.FPScratch);
+  for (auto& Site : EmbedderFPSites) {
+    // A block too large for a short branch to reach its cold code is
+    // compiled again with far branches. No NZCV writes: guest flags may be
+    // live, and the shared path keeps them.
+    if (Site->Filtered) {
+      const FPDescriptor Desc {static_cast<uint32_t>(Site->Descriptor)};
+      BindOrRestart(&Site->Filter);
+      EmbedderFPZeroFromNonzero(*Site, Desc.Kind(), Desc.ResultElementBytes());
+      EmbedderFPBranchIfAny(VTMP1, Desc.Bytes(), &Site->Entry);
+      if (Site->Dst != Site->Result) {
+        mov(Site->Dst.Q(), Site->Result.Q());
+      }
+      b_OrRestart(&Site->Done);
+    }
+    BindOrRestart(&Site->Entry);
+    for (uint32_t Index = 0; Index < 3; ++Index) {
+      str(Site->Sources[Index].Q(), STATE, Scratch + Index * 16);
+    }
+    str(Site->Result.Q(), STATE, Scratch + Core::EMBEDDER_FP_SCRATCH_RESULT);
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Site->Descriptor);
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP2, Site->GuestRIP);
+    ARMEmitter::ForwardLabel Resume;
+    adr_OrRestart(TMP3, &Resume);
+    ldr(TMP4, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.EmbedderFPCheck));
+    br(TMP4);
+    (void)Bind(&Resume);
+    ldr(Site->Dst.Q(), STATE, Scratch + Core::EMBEDDER_FP_SCRATCH_RESULT);
+    b_OrRestart(&Site->Done);
+  }
+  EmbedderFPSites.clear();
+}
