From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 9 Oct 2026 23:19:00 +0900
Subject: [PATCH] Embedding: POPA loads its registers in x86's order

POPA and POPAD load EDI, ESI and EBP, skip the stack pointer's slot,
and load EBX, EDX, ECX and EAX, the stack pointer changing last. A
fault part way through leaves the registers it loaded: x86 does not read
the frame in full before it writes. Embedded, POPA probed the whole
frame first, which kept a fault from changing anything. As the stack
pointer stays where it was, the host resolves the fault and runs the
instruction again from the same frame, so the probe goes.
---
 .../Interface/Core/OpcodeDispatcher.cpp       | 27 +++++++++++--------
 1 file changed, 16 insertions(+), 11 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
index 07731b85653551d1771f0b91ca25d58fe0c6fc28..dba99bf0aa7d1d3ce78759ed33cbb3553d2a1f3a 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp
@@ -506,22 +506,27 @@ void OpDispatchBuilder::POPAOp(OpcodeArgs) {
 
   Ref SP = _RMWHandle(LoadGPRRegister(X86State::REG_RSP));
   EmbedderAlignmentCheck(SP, IR::OpSizeToSize(Size), false);
-  if (CTX->Embedded) {
-    // The whole frame is read before any register is loaded from it.
-    _EmbedderProbe(SP, 8 * IR::OpSizeToSize(Size));
-  }
 
-  StoreGPRRegister(X86State::REG_RDI, Pop(Size, SP), Size);
-  StoreGPRRegister(X86State::REG_RSI, Pop(Size, SP), Size);
-  StoreGPRRegister(X86State::REG_RBP, Pop(Size, SP), Size);
+  // A fault part way through leaves the registers it loaded, as it does on
+  // x86, and the stack pointer where it was, so the instruction runs again
+  // from the same frame. Each register is written before the next load.
+  const auto Load = [this, Size, &SP](X86State::X86Reg Reg) {
+    StoreGPRRegister(Reg, Pop(Size, SP), Size);
+    if (CTX->Embedded) {
+      FlushRegisterCache();
+    }
+  };
+  Load(X86State::REG_RDI);
+  Load(X86State::REG_RSI);
+  Load(X86State::REG_RBP);
 
   // Skip loading RSP because it'll be correct at the end
   SP = _RMWHandle(Add(OpSize::i64Bit, SP, IR::OpSizeToSize(Size)));
 
-  StoreGPRRegister(X86State::REG_RBX, Pop(Size, SP), Size);
-  StoreGPRRegister(X86State::REG_RDX, Pop(Size, SP), Size);
-  StoreGPRRegister(X86State::REG_RCX, Pop(Size, SP), Size);
-  StoreGPRRegister(X86State::REG_RAX, Pop(Size, SP), Size);
+  Load(X86State::REG_RBX);
+  Load(X86State::REG_RDX);
+  Load(X86State::REG_RCX);
+  Load(X86State::REG_RAX);
 
   // Store the new stack pointer
   StoreGPRRegister(X86State::REG_RSP, SP);
