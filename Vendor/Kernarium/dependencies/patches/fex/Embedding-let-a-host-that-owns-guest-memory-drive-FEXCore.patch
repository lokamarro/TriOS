+// An embedding host raises #DE for a quotient that does not fit 64 bits. The
+// embedded divide reads that from a remainder equal to the divisor, which no
+// division leaves.
+static struct DivRem LUDIVChecked(uint64_t SrcHigh, uint64_t SrcLow, uint64_t Divisor) {
+  if (SrcHigh >= Divisor) {
+    return {.Quotient = 0, .Remainder = Divisor};
+  }
+  return LUDIV(SrcHigh, SrcLow, Divisor);
+}
+
+static struct DivRem LDIVChecked(uint64_t SrcHigh, uint64_t SrcLow, int64_t Divisor) {
+  const auto Source = static_cast<__int128_t>((static_cast<__uint128_t>(SrcHigh) << 64) | SrcLow);
+  constexpr auto Minimum = -(static_cast<__int128_t>(1) << 63);
+  constexpr auto Maximum = (static_cast<__int128_t>(1) << 63) - 1;
+  const auto Overflow = DivRem {.Quotient = 0, .Remainder = static_cast<uint64_t>(Divisor)};
+  if (Divisor == -1) {
+    // Negating the minimum 128-bit dividend would overflow __int128 itself.
+    if (Source < -Maximum || Source > -Minimum) {
+      return Overflow;
+    }
+    return {.Quotient = static_cast<uint64_t>(-Source), .Remainder = 0};
+  }
+  const __int128_t Quotient = Source / Divisor;
+  if (Quotient < Minimum || Quotient > Maximum) {
+    return Overflow;
+  }
+  return {
+    .Quotient = static_cast<uint64_t>(Quotient),
+    .Remainder = static_cast<uint64_t>(Source % Divisor),
+  };
+}
