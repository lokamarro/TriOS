diff --git a/CodeEmitter/CodeEmitter/Buffer.h b/CodeEmitter/CodeEmitter/Buffer.h
index 602eeb67472509e0287343f6958a1bcf09b490e1..6688c9efdb1b0a2bce0a4000bedd3cceb720263e 100644
--- a/CodeEmitter/CodeEmitter/Buffer.h
