+#ifdef __APPLE__
+/* Darwin forbids writable-and-executable mappings for a hardened process and
+ * gives JIT memory per-thread write protection instead. An embedding host owns
+ * that memory: it installs these hooks before it creates a context, and
+ * FEXCore never maps, unmaps or write-enables executable memory itself. There
+ * are no defaults: without the hooks an executable allocation is fatal. */
+struct ExecutableMemoryHooks {
+  void* (*Allocate)(size_t Size);
+  void (*Free)(void* Ptr, size_t Size);
+  /* Opens (true) or closes (false) the calling thread's write window on every
+   * executable allocation. Calls do not nest; FEXCore counts them. */
+  void (*SetWritable)(bool Writable);
+};
+/* Every member must be set. */
+FEX_DEFAULT_VISIBILITY void SetExecutableMemoryHooks(const ExecutableMemoryHooks& Hooks);
+FEX_DEFAULT_VISIBILITY const ExecutableMemoryHooks& GetExecutableMemoryHooks();
+FEX_DEFAULT_VISIBILITY void BeginExecutableWrite();
+FEX_DEFAULT_VISIBILITY void EndExecutableWrite();
+#endif
+
+/* Brackets every write to executable memory. On Darwin it opens the thread's
+ * JIT write window for its lifetime; elsewhere it costs nothing. */
+class ScopedExecutableWrite final {
+public:
+  ScopedExecutableWrite() {
+#ifdef __APPLE__
+    BeginExecutableWrite();
+#endif
+  }
+  ~ScopedExecutableWrite() {
+#ifdef __APPLE__
+    EndExecutableWrite();
+#endif
+  }
+  ScopedExecutableWrite(const ScopedExecutableWrite&) = delete;
+  ScopedExecutableWrite& operator=(const ScopedExecutableWrite&) = delete;
+};
+
 inline void* VirtualAlloc(size_t Size, bool Execute = false, bool Commit = true) {
+#ifdef __APPLE__
+  if (Execute) {
+    const ExecutableMemoryHooks& Hooks = GetExecutableMemoryHooks();
+    if (!Hooks.Allocate) {
+      ERROR_AND_DIE_FMT("FEXCore needs executable memory, but its embedder installed no hooks");
+    }
+    void* Ptr = Hooks.Allocate(Size);
+    return Ptr ? Ptr : MAP_FAILED;
+  }
+#endif
   return FEXCore::Allocator::mmap(nullptr, Size, PROT_READ | PROT_WRITE | (Execute ? PROT_EXEC : 0), MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
 }
 
 inline void* VirtualAlloc(void* Base, size_t Size, bool Execute = false, bool Commit = true) {
+#ifdef __APPLE__
+  if (Execute) {
+    // The embedder's allocator places executable memory, never FEXCore.
+    return Base == nullptr ? VirtualAlloc(Size, true, Commit) : MAP_FAILED;
+  }
+#endif
   return FEXCore::Allocator::mmap(Base, Size, PROT_READ | PROT_WRITE | (Execute ? PROT_EXEC : 0), MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
 }
 
