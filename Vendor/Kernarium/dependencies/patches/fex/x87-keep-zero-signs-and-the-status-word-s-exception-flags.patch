index a157b098daa4b19d69d30457ba384e2c0e31e7b0..a09e351bb899bfb3aaad584d567d9547460217e8 100644
--- a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
@@ -825,6 +825,29 @@ void Dispatcher::EmitI16ToExtF80() {
   (void)Bind(&Done);
 }
 
+// Raises x87 exception Bit, 0 for invalid operation or 1 for a denormal
+// operand: sets its flag, and ES and B when the control word unmasks it.
+// Uses TMP1 only.
+void Dispatcher::EmitX87Exception(uint32_t Bit) {
+  ARMEmitter::ForwardLabel Masked;
+  mov(ARMEmitter::Size::i32Bit, TMP1, 1);
+  strb(TMP1.W(), STATE, offsetof(FEXCore::Core::CPUState, flags) + FEXCore::X86State::X87FLAG_IE_LOC + Bit);
+  ldrh(TMP1.W(), STATE, offsetof(FEXCore::Core::CPUState, FCW));
+  (void)tbnz(TMP1, Bit, &Masked);
+  mov(ARMEmitter::Size::i32Bit, TMP1, 1);
+  strb(TMP1.W(), STATE, offsetof(FEXCore::Core::CPUState, flags) + FEXCore::X86State::X87FLAG_ES_LOC);
+  strb(TMP1.W(), STATE, offsetof(FEXCore::Core::CPUState, flags) + FEXCore::X86State::X87FLAG_B_LOC);
+  (void)Bind(&Masked);
+}
+
+// A signaling NaN converted to the 80-bit format raises invalid operation.
+void Dispatcher::EmitX87InvalidForSignalingNaN(ARMEmitter::Register Fraction, uint32_t QuietBit) {
+  ARMEmitter::ForwardLabel Quiet;
+  (void)tbnz(Fraction, QuietBit, &Quiet);
+  EmitX87Exception(0);
+  (void)Bind(&Quiet);
+}
+
 void Dispatcher::EmitF32ToExtF80() {
   ARMEmitter::ForwardLabel InfNaN;
   ARMEmitter::ForwardLabel ZeroDenormal;
