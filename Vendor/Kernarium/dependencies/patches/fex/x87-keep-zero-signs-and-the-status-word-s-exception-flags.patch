-FEXCORE_PRESERVE_ALL_ATTR static void HandleX87Exception(const softfloat_state& State, FEXCore::Core::CpuStateFrame* Frame) {
-  // Check for Invalid Operation exception (bit 0 of X87 status word)
+// The x87 denormal-operand exception, which SoftFloat has no flag for, in a
+// bit of softfloat_state::exceptionFlags SoftFloat does not use.
+constexpr uint_fast8_t X87DenormalFlag = 0x20;
+
+// Accumulates the exceptions an operation raised into the status word's
+// sticky flags, and sets ES and B while one the control word unmasks is
+// pending.
+FEXCORE_PRESERVE_ALL_ATTR static void HandleX87Exception(const softfloat_state& State, uint16_t FCW, FEXCore::Core::CpuStateFrame* Frame) {
+  uint16_t Raised = 0;
   if (State.exceptionFlags & softfloat_flag_invalid) {
-    Frame->State.flags[FEXCore::X86State::X87FLAG_IE_LOC] = 1;
+    Raised |= 1U << 0;
+  } else if (State.exceptionFlags & X87DenormalFlag) {
+    // An invalid operation takes precedence over a denormal operand.
+    Raised |= 1U << 1;
+  }
+  if (State.exceptionFlags & softfloat_flag_infinite) {
+    Raised |= 1U << 2;
+  }
+  if (State.exceptionFlags & softfloat_flag_overflow) {
+    Raised |= 1U << 3;
+  }
+  if (State.exceptionFlags & softfloat_flag_underflow) {
+    Raised |= 1U << 4;
+  }
+  if (State.exceptionFlags & softfloat_flag_inexact) {
+    Raised |= 1U << 5;
+  }
+  if (Raised == 0) {
+    return;
+  }
+  for (unsigned Bit = 0; Bit < 6; ++Bit) {
+    if (Raised & (1U << Bit)) {
+      Frame->State.flags[FEXCore::X86State::X87FLAG_IE_LOC + Bit] = 1;
+    }
+  }
+  if (Raised & ~FCW & 0x3fU) {
+    Frame->State.flags[FEXCore::X86State::X87FLAG_ES_LOC] = 1;
+    Frame->State.flags[FEXCore::X86State::X87FLAG_B_LOC] = 1;
   }
 }
 
