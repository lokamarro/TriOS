@@ -205,9 +205,14 @@ struct FEX_PACKED X80SoftFloat {
 
     if (Q_zero) {
       return lhs;
-    } else {
-      return extF80_sub(state, lhs, extF80_mul(state, Q, rhs));
     }
+    X80SoftFloat Remainder = extF80_sub(state, lhs, extF80_mul(state, Q, rhs));
+    // An exact remainder of zero takes the dividend's sign; the
+    // subtraction alone would give +0.
+    if (Remainder.Top.Exponent == 0 && Remainder.Significand == 0) {
+      Remainder.Top.Sign = lhs.Top.Sign;
+    }
