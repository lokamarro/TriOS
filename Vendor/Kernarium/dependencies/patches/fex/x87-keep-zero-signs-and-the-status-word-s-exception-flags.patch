-    return extF80_roundToInt(state, lhs, state->roundingMode, false);
+    return extF80_roundToInt(state, lhs, state->roundingMode, true);
   }
 
   FEXCORE_PRESERVE_ALL_ATTR static X80SoftFloat FRNDINT(softfloat_state* state, const X80SoftFloat& lhs, uint_fast8_t RoundMode) {
@@ -308,13 +314,28 @@ struct FEX_PACKED X80SoftFloat {
 
   FEXCORE_PRESERVE_ALL_ATTR static void
   FCMP(softfloat_state* state, const X80SoftFloat& lhs, const X80SoftFloat& rhs, bool* eq, bool* lt, bool* nan) {
+    // A quiet compare: a NaN makes the operands unordered and raises
+    // invalid only when it signals. A signaling compare (FCOM, FCOMI,
+    // FICOM, FTST) raises invalid for any NaN itself.
+    const auto IsNaN = [](const X80SoftFloat& Value) {
+      return Value.Top.Exponent == 0x7FFF && (Value.Significand & 0x7FFF'FFFF'FFFF'FFFFULL) != 0;
+    };
+    const auto IsSignaling = [&](const X80SoftFloat& Value) {
+      return IsNaN(Value) && (Value.Significand & 0x4000'0000'0000'0000ULL) == 0;
+    };
+    if (IsNaN(lhs) || IsNaN(rhs)) {
+      if (IsSignaling(lhs) || IsSignaling(rhs)) {
+        state->exceptionFlags |= softfloat_flag_invalid;
+      }
+      *eq = false;
+      *lt = false;
+      *nan = true;
+      return;
+    }
+
     *eq = extF80_eq(state, lhs, rhs);
     *lt = extF80_lt(state, lhs, rhs);
-
-    // Use IEEE 754 semantics: unordered if neither <, =, nor > is true
-    // This is more reliable than custom NaN detection
-    bool gt = !(*eq) && !(*lt) && extF80_le(state, rhs, lhs);
-    *nan = !(*eq) && !(*lt) && !gt;
+    *nan = false;
   }
 
   FEXCORE_PRESERVE_ALL_ATTR static X80SoftFloat FSCALE(softfloat_state* state, const X80SoftFloat& lhs, const X80SoftFloat& rhs) {
@@ -393,6 +414,27 @@ struct FEX_PACKED X80SoftFloat {
 
     return Result;
 #else
+    // log2 of zero is an infinity, of which a finite nonzero factor raises
+    // division by zero; a zero factor of it and a logarithm of a negative
+    // number are invalid.
+    const auto IsNaN = [](const X80SoftFloat& Value) {
+      return Value.Top.Exponent == 0x7FFF && (Value.Significand & 0x7FFF'FFFF'FFFF'FFFFULL) != 0;
+    };
+    if (!IsNaN(lhs) && !IsNaN(rhs)) {
+      const bool XZero = lhs.Top.Exponent == 0 && lhs.Significand == 0;
+      const bool YZero = rhs.Top.Exponent == 0 && rhs.Significand == 0;
+      const bool YInfinite = rhs.Top.Exponent == 0x7FFF;
+      if ((XZero && YZero) || (lhs.Top.Sign && !XZero)) {
+        softfloat_raiseFlags(state, softfloat_flag_invalid);
+        return X80SoftFloat(1, 0x7FFF, 0xC000'0000'0000'0000ULL);
+      }
+      if (XZero) {
+        if (!YInfinite) {
+          softfloat_raiseFlags(state, softfloat_flag_infinite);
+        }
+        return X80SoftFloat(rhs.Top.Sign ^ 1, 0x7FFF, 0x8000'0000'0000'0000ULL);
+      }
+    }
     auto Src1_d = lhs.ToFMax(state);
     auto Src2_d = rhs.ToFMax(state);
 
@@ -444,6 +486,11 @@ struct FEX_PACKED X80SoftFloat {
     if (HandleInfinityOp(state, lhs, result)) {
       return result;
     }
+    // A zero operand comes back unchanged, sign included; the 128-bit
+    // routine does not keep a negative zero's sign.
+    if (lhs.Top.Exponent == 0 && lhs.Significand == 0) {
+      return lhs;
+    }
 
     BIGFLOAT Src_d = lhs.ToFMax(state);
     Src_d = FEXCore::cephes_128bit::tanl(Src_d);
@@ -470,6 +517,11 @@ struct FEX_PACKED X80SoftFloat {
     if (HandleInfinityOp(state, lhs, result)) {
       return result;
     }
+    // A zero operand comes back unchanged, sign included; the 128-bit
+    // routine does not keep a negative zero's sign.
+    if (lhs.Top.Exponent == 0 && lhs.Significand == 0) {
+      return lhs;
+    }
 
     BIGFLOAT Src_d = lhs.ToFMax(state);
     Src_d = FEXCore::cephes_128bit::sinl(Src_d);
@@ -549,10 +601,13 @@ struct FEX_PACKED X80SoftFloat {
 #endif
   }
 
+  // x86 raises precision for a conversion to an integer that rounds.
   int16_t ToI16(softfloat_state* state) const {
-    auto rv = extF80_to_i32(state, *this, state->roundingMode, false);
+    auto rv = extF80_to_i32(state, *this, state->roundingMode, true);
     if (rv > INT16_MAX || rv < INT16_MIN) {
-      ///< Indefinite value for 16-bit conversions.
+      ///< Indefinite value for 16-bit conversions, which raises only
+      ///< invalid, as a 32-bit overflow does.
+      state->exceptionFlags = (state->exceptionFlags & ~softfloat_flag_inexact) | softfloat_flag_invalid;
       return INT16_MIN;
     } else {
       return rv;
@@ -560,11 +615,11 @@ struct FEX_PACKED X80SoftFloat {
   }
 
   int32_t ToI32(softfloat_state* state) const {
-    return extF80_to_i32(state, *this, state->roundingMode, false);
+    return extF80_to_i32(state, *this, state->roundingMode, true);
   }
 
   int64_t ToI64(softfloat_state* state) const {
-    return extF80_to_i64(state, *this, state->roundingMode, false);
+    return extF80_to_i64(state, *this, state->roundingMode, true);
   }
 
   uint64_t ToUI64(softfloat_state* state) const {
