From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 13 Sep 2026 08:14:02 +0900
Subject: [PATCH] vrend: read a texture offset at the type its register has

A TGSI texture offset that lives in an input register was always spelled
with floatBitsToInt(). That is right for a float register, which carries
the offset as the bits of an integer, but a vertex attribute of a pure
integer format is declared at its real integer type, and the cast then
reinterprets the integer's own float encoding instead of reading it.

The result is not a wild offset but a silent zero: every offset an
implementation accepts is small, a small integer converts to a float
whose low mantissa bits are all zero, and the hardware keeps only those
low bits of the offset field. So textureGatherOffset with a per-vertex
offset gathered the unoffset texels and looked, from the guest, exactly
like an implementation that ignores the offset argument.

Spell each offset component for the register it comes from: an integer
input as itself, an unsigned one narrowed to int, and a float one through
the bit cast as before. The neighbouring three-dimensional case in the
temporary-register branch also never closed its ivec3, so close it.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/vrend/vrend_shader.c | 63 +++++++++++++++++++++++++++++-----------
 1 file changed, 46 insertions(+), 17 deletions(-)

diff --git a/src/vrend/vrend_shader.c b/src/vrend/vrend_shader.c
index 3f9b14eae5a6d9cb58fe37f9e0a8d0c4982382a9..2fbdbd125aebbe22e820e60415d81df5c43e4fb8 100644
--- a/src/vrend/vrend_shader.c
+++ b/src/vrend/vrend_shader.c
@@ -3075,6 +3075,33 @@ get_temp(const struct dump_ctx *ctx,
    }
 }
 
+/* One component of a texture offset, spelled for the register it is read from.
+ * TGSI carries an offset as the bits of an integer, so a float-typed register
+ * needs the bit cast to recover it. An input declared at its real integer type
+ * already holds the number the offset wants, and casting there reinterprets
+ * that integer's own float encoding instead: every offset an implementation
+ * accepts encodes as a float whose low bits are zero, so a narrow hardware
+ * offset field reads each one back as zero and the offset silently disappears.
+ */
+static void append_offset_component(struct vrend_strbuf *offset_buf,
+                                    const struct vrend_shader_io *input,
+                                    int swizzle)
+{
+   const char swiz = get_swiz_char(swizzle);
+
+   switch (input->type) {
+   case VEC_INT:
+      strbuf_appendf(offset_buf, "%s.%c", input->glsl_name, swiz);
+      break;
+   case VEC_UINT:
+      strbuf_appendf(offset_buf, "int(%s.%c)", input->glsl_name, swiz);
+      break;
+   default:
+      strbuf_appendf(offset_buf, "floatBitsToInt(%s.%c)", input->glsl_name, swiz);
+      break;
+   }
+}
+
 static bool fill_offset_buffer(const struct dump_ctx *ctx,
                                const struct tgsi_full_instruction *inst,
                                struct vrend_strbuf *offset_buf,
@@ -3138,7 +3165,7 @@ static bool fill_offset_buffer(const struct dump_ctx *ctx,
                   get_swiz_char(inst->TexOffsets[0].SwizzleY));
             break;
       case TGSI_TEXTURE_3D:
-         strbuf_appendf(offset_buf, ", ivec3(floatBitsToInt(%s.%c), floatBitsToInt(%s.%c), floatBitsToInt(%s.%c)",
+         strbuf_appendf(offset_buf, ", ivec3(floatBitsToInt(%s.%c), floatBitsToInt(%s.%c), floatBitsToInt(%s.%c))",
                   temp_buf,
                   get_swiz_char(inst->TexOffsets[0].SwizzleX),
                   temp_buf,
@@ -3153,16 +3180,18 @@ static bool fill_offset_buffer(const struct dump_ctx *ctx,
       }
    } else if (inst->TexOffsets[0].File == TGSI_FILE_INPUT) {
       for (uint32_t j = 0; j < ctx->num_inputs; j++) {
-         if (ctx->inputs[j].first != inst->TexOffsets[0].Index)
+         const struct vrend_shader_io *input = &ctx->inputs[j];
+
+         if (input->first != inst->TexOffsets[0].Index)
             continue;
          switch (inst->Texture.Texture) {
          case TGSI_TEXTURE_1D:
          case TGSI_TEXTURE_1D_ARRAY:
          case TGSI_TEXTURE_SHADOW1D:
          case TGSI_TEXTURE_SHADOW1D_ARRAY:
-            strbuf_appendf(offset_buf, ", int(floatBitsToInt(%s.%c))",
-                     ctx->inputs[j].glsl_name,
-                     get_swiz_char(inst->TexOffsets[0].SwizzleX));
+            strbuf_append(offset_buf, ", int(");
+            append_offset_component(offset_buf, input, inst->TexOffsets[0].SwizzleX);
+            strbuf_append(offset_buf, ")");
             break;
          case TGSI_TEXTURE_RECT:
          case TGSI_TEXTURE_SHADOWRECT:
@@ -3170,20 +3199,20 @@ static bool fill_offset_buffer(const struct dump_ctx *ctx,
          case TGSI_TEXTURE_2D_ARRAY:
          case TGSI_TEXTURE_SHADOW2D:
          case TGSI_TEXTURE_SHADOW2D_ARRAY:
-            strbuf_appendf(offset_buf, ", ivec2(floatBitsToInt(%s.%c), floatBitsToInt(%s.%c))",
-                     ctx->inputs[j].glsl_name,
-                     get_swiz_char(inst->TexOffsets[0].SwizzleX),
-                     ctx->inputs[j].glsl_name,
-                     get_swiz_char(inst->TexOffsets[0].SwizzleY));
+            strbuf_append(offset_buf, ", ivec2(");
+            append_offset_component(offset_buf, input, inst->TexOffsets[0].SwizzleX);
+            strbuf_append(offset_buf, ", ");
+            append_offset_component(offset_buf, input, inst->TexOffsets[0].SwizzleY);
+            strbuf_append(offset_buf, ")");
             break;
          case TGSI_TEXTURE_3D:
-            strbuf_appendf(offset_buf, ", ivec3(floatBitsToInt(%s.%c), floatBitsToInt(%s.%c), floatBitsToInt(%s.%c)",
-                     ctx->inputs[j].glsl_name,
-                     get_swiz_char(inst->TexOffsets[0].SwizzleX),
-                     ctx->inputs[j].glsl_name,
-                     get_swiz_char(inst->TexOffsets[0].SwizzleY),
-                     ctx->inputs[j].glsl_name,
-                     get_swiz_char(inst->TexOffsets[0].SwizzleZ));
+            strbuf_append(offset_buf, ", ivec3(");
+            append_offset_component(offset_buf, input, inst->TexOffsets[0].SwizzleX);
+            strbuf_append(offset_buf, ", ");
+            append_offset_component(offset_buf, input, inst->TexOffsets[0].SwizzleY);
+            strbuf_append(offset_buf, ", ");
+            append_offset_component(offset_buf, input, inst->TexOffsets[0].SwizzleZ);
+            strbuf_append(offset_buf, ")");
             break;
          default:
             virgl_error("Unhandled texture: %x\n", inst->Texture.Texture);
