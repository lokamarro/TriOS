From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 9 Nov 2026 11:12:45 +0900
Subject: [PATCH] venus: report the bytes of the driver's resident heaps

The host counts the GPU memory of its process from Metal's allocation
counter and the graphics ledger. Each holds memory the other does not,
the IOSurfaces of presentation and decoding in the counter and the
driver's command storage in the ledger, and the larger of the two
misses the smaller of those. The heaps KosmicKrisp made resident are
in both.

virgl_renderer_get_resident_heap_memory() reports them, through
vkr_renderer_get_resident_heap_memory() and the driver's
kk_resident_heap_bytes(), so the host can add the two figures and
subtract the heaps once. A renderer built without Venus has no Vulkan
devices and reports zero.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/venus/vkr_renderer.c |  6 ++++++
 src/venus/vkr_renderer.h |  7 +++++++
 src/virglrenderer.c      | 11 +++++++++++
 src/virglrenderer.h      | 12 ++++++++++++
 4 files changed, 36 insertions(+)

diff --git a/src/venus/vkr_renderer.c b/src/venus/vkr_renderer.c
index a8486d004a551eeb953ab3902a75e283d877d5e8..3ec1c9aed167e09239121bb7d7057e55ef9b66ae 100644
--- a/src/venus/vkr_renderer.c
+++ b/src/venus/vkr_renderer.c
@@ -141,6 +141,12 @@ vkr_renderer_get_imported_host_memory(void)
    return kk_imported_host_memory_bytes();
 }
 
+uint64_t
+vkr_renderer_get_resident_heap_memory(void)
+{
+   return kk_resident_heap_bytes();
+}
+
 uint64_t
 vkr_renderer_release_cached_memory(void)
 {
diff --git a/src/venus/vkr_renderer.h b/src/venus/vkr_renderer.h
index da6106e3dc0098750896116d68e7208982c46b9a..580ec15ee195e4cd67de10e97029cf148295194f 100644
--- a/src/venus/vkr_renderer.h
+++ b/src/venus/vkr_renderer.h
@@ -87,6 +87,13 @@ vkr_renderer_get_device_memory_headroom(void);
 uint64_t
 vkr_renderer_get_imported_host_memory(void);
 
+/* The bytes of the heaps the process's Vulkan devices made resident when they
+ * made them, which the host's device-memory counter and its graphics ledger
+ * both include.
+ */
+uint64_t
+vkr_renderer_get_resident_heap_memory(void);
+
 /* How long the process's Vulkan devices must have kept storage for reuse
  * before a reclaim frees it: a device that is still recording takes it again
  * within a frame or two. */
diff --git a/src/virglrenderer.c b/src/virglrenderer.c
index 083774c3ffc08a6f511d0d83be0727b8076efac6..7275c9767adb8ad34b8725e858fede04cbad3e5c 100644
--- a/src/virglrenderer.c
+++ b/src/virglrenderer.c
@@ -1787,6 +1787,17 @@ virgl_renderer_get_imported_host_memory(void)
 #endif
 }
 
+uint64_t
+virgl_renderer_get_resident_heap_memory(void)
+{
+   TRACE_FUNC();
+#ifdef ENABLE_VENUS
+   return vkr_renderer_get_resident_heap_memory();
+#else
+   return 0;
+#endif
+}
+
 int
 virgl_renderer_export_fence(uint64_t client_fence_id, int *fd)
 {
diff --git a/src/virglrenderer.h b/src/virglrenderer.h
index 9335e0ce538787484b4fc3257d6f0030ee5d8c17..3ad1aa3a124dd81f25f7ddee93407cdf1a6d86d3 100644
--- a/src/virglrenderer.h
+++ b/src/virglrenderer.h
@@ -662,6 +662,18 @@ virgl_renderer_set_device_memory_pool(
 VIRGL_EXPORT uint64_t
 virgl_renderer_get_imported_host_memory(void);
 
+/*
+ * The bytes of the heaps the host's Vulkan devices made resident when they
+ * made them and still hold. The host's device-memory counter and its graphics
+ * ledger both include them, and each includes memory the other does not (the
+ * counter the IOSurfaces of presentation and decoding, the ledger the
+ * driver's command storage), so a host that wants all of it counted adds the
+ * two and subtracts this figure once. Zero where the renderer has no Vulkan
+ * devices.
+ */
+VIRGL_EXPORT uint64_t
+virgl_renderer_get_resident_heap_memory(void);
+
 /* vtest semi-private APIs: */
 VIRGL_EXPORT int virgl_renderer_attach_fence(int ctx_id, int fence_fd);
 VIRGL_EXPORT int virgl_renderer_get_fence_fd(uint64_t fence_id);
