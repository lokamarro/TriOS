 #include "vkr_context.h"
@@ -19,6 +19,14 @@ vkr_dispatch_vkCreateAccelerationStructureKHR(
    vkr_acceleration_structure_create_and_add(dispatch->data, args);
 }
 
+static void
+vkr_dispatch_vkCreateAccelerationStructure2KHR(
+   struct vn_dispatch_context *dispatch,
+   struct vn_command_vkCreateAccelerationStructure2KHR *args)
+{
+   vkr_acceleration_structure2_create_and_add(dispatch->data, args);
+}
+
 static void
 vkr_dispatch_vkDestroyAccelerationStructureKHR(
    struct vn_dispatch_context *dispatch,
@@ -73,6 +81,8 @@ vkr_context_init_acceleration_structure_dispatch(struct vkr_context *ctx)
 
    dispatch->dispatch_vkCreateAccelerationStructureKHR =
       vkr_dispatch_vkCreateAccelerationStructureKHR;
+   dispatch->dispatch_vkCreateAccelerationStructure2KHR =
+      vkr_dispatch_vkCreateAccelerationStructure2KHR;
    dispatch->dispatch_vkDestroyAccelerationStructureKHR =
       vkr_dispatch_vkDestroyAccelerationStructureKHR;
    dispatch->dispatch_vkGetAccelerationStructureBuildSizesKHR =
