From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 15 Sep 2026 09:03:51 +0900
Subject: [PATCH] vrend: resolve an indirect atomic counter against its buffer

A dynamically indexed atomic counter reaches vrend as a TGSI HW_ATOMIC
source whose register index carries only the constant part of the
address, with ADDR supplying the rest.  nir_to_tgsi folds the constant
into the base, so `acs[counter_id - 1]` arrives as
`HWATOMIC[0][ADDR[2].x-1]`: a base of -1 that no declared range holds.

The source translation looked the declaration up by testing the base
against every declared range, found none, and left the source string
untouched, so the instruction reused the string built for the previous
one.  A geometry shader incrementing such a counter emitted
`atomicCounterIncrement(floatBitsToInt(vec4(temp6)))`, which the host
GLSL compiler rejects; the program never became usable and no counter
was ever incremented.

Select the declaration by its buffer, range check only a direct access,
and report a source that resolves to no declaration instead of emitting
the previous one.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/vrend/vrend_shader.c | 49 +++++++++++++++++++++++++++-------------
 1 file changed, 33 insertions(+), 16 deletions(-)

diff --git a/src/vrend/vrend_shader.c b/src/vrend/vrend_shader.c
index 0ad8c523f7cb71156e520b5e0dbdf6526ce1baf5..bfc8d2b53aed9bec15b82ac96b21c8e72114e6eb 100644
--- a/src/vrend/vrend_shader.c
+++ b/src/vrend/vrend_shader.c
@@ -5424,26 +5424,43 @@ get_source_info(struct dump_ctx *ctx,
             return false;
       } break;
       case TGSI_FILE_HW_ATOMIC: {
+         /* A dynamically indexed atomic counter keeps only the variable part
+          * of its address in ADDR; the constant part is folded into the
+          * register index, which therefore lands outside the declared range
+          * whenever that constant is negative (acs[i - 1] gives index -1).
+          * Only a direct access can be range checked, so an indirect one
+          * selects its declaration by buffer when no range holds the base. */
+         const int reg_index = src->Register.Index;
+         int match = -1;
          for (uint32_t j = 0; j < ctx->num_abo; j++) {
-            if (src->Dimension.Index == ctx->abo_idx[j] &&
-                src->Register.Index >= ctx->abo_offsets[j] &&
-                src->Register.Index < ctx->abo_offsets[j] + ctx->abo_sizes[j]) {
-               int abo_idx = ctx->abo_idx[j];
-               int abo_offset = ctx->abo_offsets[j] * 4;
-               if (ctx->abo_sizes[j] > 1) {
-                  int offset = src->Register.Index - ctx->abo_offsets[j];
-                  if (src->Register.Indirect) {
-                     if (src->Indirect.File != TGSI_FILE_ADDRESS)
-                        return false;
-                     strbuf_fmt(src_buf, "ac%d_%d[addr%d + %d]", abo_idx, abo_offset, src->Indirect.Index, offset);
-                  } else
-                     strbuf_fmt(src_buf, "ac%d_%d[%d]", abo_idx, abo_offset, offset);
-               } else
-                  strbuf_fmt(src_buf, "ac%d_%d", abo_idx, abo_offset);
+            if (src->Dimension.Index != ctx->abo_idx[j])
+               continue;
+            if (reg_index >= ctx->abo_offsets[j] &&
+                reg_index < ctx->abo_offsets[j] + ctx->abo_sizes[j]) {
+               match = (int)j;
                break;
             }
+            if (src->Register.Indirect && match < 0)
+               match = (int)j;
          }
-         sinfo->sreg_index = src->Register.Index;
+         /* Leaving the source string unwritten would emit the previous
+          * instruction's source in its place, so report the failure. */
+         if (match < 0)
+            return false;
+
+         const int abo_idx = ctx->abo_idx[match];
+         const int abo_offset = ctx->abo_offsets[match] * 4;
+         if (ctx->abo_sizes[match] > 1) {
+            const int offset = reg_index - ctx->abo_offsets[match];
+            if (src->Register.Indirect) {
+               if (src->Indirect.File != TGSI_FILE_ADDRESS)
+                  return false;
+               strbuf_fmt(src_buf, "ac%d_%d[addr%d + (%d)]", abo_idx, abo_offset, src->Indirect.Index, offset);
+            } else
+               strbuf_fmt(src_buf, "ac%d_%d[%d]", abo_idx, abo_offset, offset);
+         } else
+            strbuf_fmt(src_buf, "ac%d_%d", abo_idx, abo_offset);
+         sinfo->sreg_index = reg_index;
       } break;
       default:
          return false;
