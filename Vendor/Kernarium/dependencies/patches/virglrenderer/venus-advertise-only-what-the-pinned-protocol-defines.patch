From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 14 Sep 2026 00:41:11 +0900
Subject: [PATCH] venus: advertise only what the pinned protocol defines

The renderer's extension table and command dispatch are written against the
venus-protocol revision the renderer was developed on. This project pins one
protocol revision for the host and the guest together, because the guest Mesa
driver is sealed against the generated codecs, and that pin is older than the
renderer's own subproject.

Five entries in the advertised extension table name protocol entities the
pinned revision does not define, so the renderer does not compile against it.
None of them is reachable: a guest sealed against the same revision cannot
request an extension its own generated codec does not know.

Drop those entries. Raising the pin is a guest-visible change and belongs to a
protocol epoch, not to a host build fix.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/venus/vkr_common.c | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/src/venus/vkr_common.c b/src/venus/vkr_common.c
index 4548cb1bb524f8c1d8d525be548c28378c77c634..16c26c7083d41616d00669372cd44c52ea520f39 100644
--- a/src/venus/vkr_common.c
+++ b/src/venus/vkr_common.c
@@ -135,7 +135,6 @@ static const struct vn_info_extension_table vkr_extension_table = {
    .KHR_robustness2 = true,
    .KHR_shader_bfloat16 = true,
    .KHR_shader_clock = true,
-   .KHR_shader_constant_data = true,
    .KHR_shader_fma = true,
    .KHR_shader_maximal_reconvergence = true,
    .KHR_shader_quad_control = true,
@@ -196,7 +195,6 @@ static const struct vn_info_extension_table vkr_extension_table = {
    .EXT_provoking_vertex = true,
    .EXT_queue_family_foreign = true,
    .EXT_rasterization_order_attachment_access = true,
-   .EXT_rgba10x6_formats = true,
    .EXT_robustness2 = true,
    .EXT_sample_locations = true,
    .EXT_shader_atomic_float = true,
@@ -204,18 +202,15 @@ static const struct vn_info_extension_table vkr_extension_table = {
    .EXT_shader_float8 = true,
    .EXT_shader_image_atomic_int64 = true,
    .EXT_shader_replicated_composites = true,
-   .EXT_shader_split_barrier = true,
    .EXT_shader_stencil_export = true,
    .EXT_shader_subgroup_ballot = true,
    .EXT_shader_subgroup_vote = true,
-   .EXT_shader_tile_image = true,
    .EXT_shader_uniform_buffer_unsized_array = true,
    .EXT_transform_feedback = true,
    .EXT_vertex_attribute_divisor = true,
    .EXT_vertex_attribute_robustness = true,
    .EXT_vertex_input_dynamic_state = true,
    .EXT_ycbcr_image_arrays = true,
-   .EXT_zero_initialize_device_memory = true,
    /* vendor extensions */
    .ARM_rasterization_order_attachment_access = true,
    .GOOGLE_decorate_string = true,
