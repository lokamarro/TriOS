From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 8 Nov 2026 22:16:21 +0900
Subject: [PATCH] vrend: offer ETC1, ETC2, EAC and ASTC on a desktop GL host

vrend offered the ETC2, EAC and ASTC formats only to the guest of an
OpenGL ES host. A guest on a desktop GL host still has to expose them:
OpenGL ES 3.0 requires ETC2 and EAC, and Mesa exposes ASTC and ETC1 by
decoding them. So Mesa decoded every such texture an application
uploaded and stored it as RGBA8: eight times the bytes of an ETC2 RGB
texture and sixteen times those of an ASTC 8x8 one, in the guest and
on the host. The host behind Zink on KosmicKrisp samples all of these
formats, as Apple GPUs do natively.

A desktop host now offers ETC2 and EAC when it has
GL_ARB_ES3_compatibility and ASTC when it has
GL_KHR_texture_compression_astc_ldr, and stores ETC1 as the ETC2
format that decodes it the same way, on both kinds of host.

The ASTC table also registered each sRGB ASTC format under the number
of its linear twin, so a linear ASTC texture was sampled as sRGB and
the sRGB ones were never offered. Each now has its own number.

Copies between two formats of one of these classes, such as an ASTC
image and its sRGB form, and between ASTC and a 128-bit uncompressed
format went to glCopyImageSubData only on an OpenGL ES host. A desktop
host refused the second and sent the first to a fallback that refuses
two formats, so neither copied anything. Both now hold on either kind
of host: a desktop host offers the formats only with the extensions
under which its Mesa copies them as well.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/vrend/vrend_formats.c | 69 ++++++++++++++++++++++++---------------
 1 file changed, 43 insertions(+), 26 deletions(-)

diff --git a/src/vrend/vrend_formats.c b/src/vrend/vrend_formats.c
index 0f5e6c2eb0767d655ec6b76326646a282eaf5688..e947bb6403de88d1fe1bb22bfd0081010e63dd7c 100644
--- a/src/vrend/vrend_formats.c
+++ b/src/vrend/vrend_formats.c
@@ -267,6 +267,12 @@ static struct vrend_format_table dxtn_srgb_formats[] = {
   { VIRGL_FORMAT_DXT5_SRGBA, GL_COMPRESSED_SRGB_ALPHA_S3TC_DXT5_EXT, GL_RGBA, GL_UNSIGNED_BYTE, NO_SWIZZLE, view_class_dxt5_rgba },
 };
 
+/* ETC2 decodes every ETC1 block as ETC1 does, so an ETC1 texture is stored as
+ * the ETC2 format it is a subset of. */
+static struct vrend_format_table etc1_formats[] = {
+  {VIRGL_FORMAT_ETC1_RGB8, GL_COMPRESSED_RGB8_ETC2, GL_RGB, GL_UNSIGNED_BYTE, NO_SWIZZLE, view_class_etc2_rgb },
+};
+
 static struct vrend_format_table etc2_formats[] = {
   {VIRGL_FORMAT_ETC2_RGB8, GL_COMPRESSED_RGB8_ETC2, GL_RGB, GL_UNSIGNED_BYTE, NO_SWIZZLE, view_class_etc2_rgb },
   {VIRGL_FORMAT_ETC2_SRGB8, GL_COMPRESSED_SRGB8_ETC2, GL_RGB, GL_BYTE, NO_SWIZZLE, view_class_etc2_rgb },
@@ -282,7 +288,7 @@ static struct vrend_format_table etc2_formats[] = {
 
 #define ASTC_FORMAT(size) \
   {VIRGL_FORMAT_ASTC_ ## size, GL_COMPRESSED_RGBA_ASTC_ ## size, GL_RGBA, GL_UNSIGNED_BYTE, NO_SWIZZLE, view_class_astc_## size ##_rgba}, \
-  {VIRGL_FORMAT_ASTC_ ## size, GL_COMPRESSED_SRGB8_ALPHA8_ASTC_ ## size, GL_RGBA, GL_BYTE, NO_SWIZZLE, view_class_astc_## size ##_rgba}
+  {VIRGL_FORMAT_ASTC_ ## size ## _SRGB, GL_COMPRESSED_SRGB8_ALPHA8_ASTC_ ## size, GL_RGBA, GL_BYTE, NO_SWIZZLE, view_class_astc_## size ##_rgba}
 
 static struct vrend_format_table astc_formats[] = {
    ASTC_FORMAT(4x4),
@@ -654,6 +660,16 @@ void vrend_build_format_list_gl(void)
   add_formats(gl_base_rgba_formats);
   add_formats(gl_bgra_formats);
   add_formats(gl_bit10_formats);
+
+  /* A guest that is not offered a compressed format it must expose, such as
+   * ETC2 in OpenGL ES 3.0, decodes the texture and stores four to sixteen
+   * times its bytes. A desktop host that samples them offers them too. */
+  if (epoxy_has_gl_extension("GL_ARB_ES3_compatibility")) {
+     add_compressed_formats(etc1_formats);
+     add_compressed_formats(etc2_formats);
+  }
+  if (epoxy_has_gl_extension("GL_KHR_texture_compression_astc_ldr"))
+     add_compressed_formats(astc_formats);
 }
 
 void vrend_build_format_list_gles(void)
@@ -678,6 +694,7 @@ void vrend_build_format_list_gles(void)
      add_compressed_formats(astc_formats);
 
   if (epoxy_gl_version() >= 30) {
+     add_compressed_formats(etc1_formats);
      add_compressed_formats(etc2_formats);
   }
 
@@ -875,7 +892,7 @@ static int format_uncompressed_compressed_copy_compatible(enum virgl_formats src
       case VIRGL_FORMAT_ASTC_10x10_SRGB:
       case VIRGL_FORMAT_ASTC_12x10_SRGB:
       case VIRGL_FORMAT_ASTC_12x12_SRGB:
-         return epoxy_is_desktop_gl() ? -1 : 1;
+         return 1;
       default:
          return -1;
       }
@@ -913,30 +930,30 @@ static int format_uncompressed_compressed_copy_compatible(enum virgl_formats src
 
 static bool format_compressed_compressed_copy_compatible(enum virgl_formats src, enum virgl_formats dst)
 {
-   const bool is_desktop_gl = epoxy_is_desktop_gl();
-
-   if(!is_desktop_gl) {
-      if((src == VIRGL_FORMAT_ASTC_4x4 && dst == VIRGL_FORMAT_ASTC_4x4_SRGB) ||
-        (src == VIRGL_FORMAT_ASTC_5x4 && dst == VIRGL_FORMAT_ASTC_5x4_SRGB) ||
-        (src == VIRGL_FORMAT_ASTC_5x5 && dst == VIRGL_FORMAT_ASTC_5x5_SRGB) ||
-        (src == VIRGL_FORMAT_ASTC_6x5 && dst == VIRGL_FORMAT_ASTC_6x5_SRGB) ||
-        (src == VIRGL_FORMAT_ASTC_6x6 && dst == VIRGL_FORMAT_ASTC_6x6_SRGB) ||
-        (src == VIRGL_FORMAT_ASTC_8x5 && dst == VIRGL_FORMAT_ASTC_8x5_SRGB) ||
-        (src == VIRGL_FORMAT_ASTC_8x6 && dst == VIRGL_FORMAT_ASTC_8x6_SRGB) ||
-        (src == VIRGL_FORMAT_ASTC_8x8 && dst == VIRGL_FORMAT_ASTC_8x8_SRGB) ||
-        (src == VIRGL_FORMAT_ASTC_10x5 && dst == VIRGL_FORMAT_ASTC_10x5_SRGB) ||
-        (src == VIRGL_FORMAT_ASTC_10x6 && dst == VIRGL_FORMAT_ASTC_10x6_SRGB) ||
-        (src == VIRGL_FORMAT_ASTC_10x8 && dst == VIRGL_FORMAT_ASTC_10x8_SRGB) ||
-        (src == VIRGL_FORMAT_ASTC_10x10 && dst == VIRGL_FORMAT_ASTC_10x10_SRGB) ||
-        (src == VIRGL_FORMAT_ASTC_12x10 && dst == VIRGL_FORMAT_ASTC_12x10_SRGB) ||
-        (src == VIRGL_FORMAT_ASTC_12x12 && dst == VIRGL_FORMAT_ASTC_12x12_SRGB) ||
-        (src == VIRGL_FORMAT_ETC2_R11_UNORM && dst == VIRGL_FORMAT_ETC2_R11_SNORM) ||
-        (src == VIRGL_FORMAT_ETC2_RG11_UNORM && dst == VIRGL_FORMAT_ETC2_RG11_SNORM) ||
-        (src == VIRGL_FORMAT_ETC2_RGBA8 && dst == VIRGL_FORMAT_ETC2_SRGBA8) ||
-        (src == VIRGL_FORMAT_ETC2_RGB8A1 && dst == VIRGL_FORMAT_ETC2_SRGB8A1) ||
-        (src == VIRGL_FORMAT_ETC2_RGB8 && dst == VIRGL_FORMAT_ETC2_SRGB8))
-         return true;
-   }
+   /* The ETC2, EAC and ASTC classes are OpenGL ES ones. A desktop host
+    * offers those formats only where its context copies them as OpenGL ES
+    * does, so they hold on every host that has the formats.
+    */
+   if((src == VIRGL_FORMAT_ASTC_4x4 && dst == VIRGL_FORMAT_ASTC_4x4_SRGB) ||
+     (src == VIRGL_FORMAT_ASTC_5x4 && dst == VIRGL_FORMAT_ASTC_5x4_SRGB) ||
+     (src == VIRGL_FORMAT_ASTC_5x5 && dst == VIRGL_FORMAT_ASTC_5x5_SRGB) ||
+     (src == VIRGL_FORMAT_ASTC_6x5 && dst == VIRGL_FORMAT_ASTC_6x5_SRGB) ||
+     (src == VIRGL_FORMAT_ASTC_6x6 && dst == VIRGL_FORMAT_ASTC_6x6_SRGB) ||
+     (src == VIRGL_FORMAT_ASTC_8x5 && dst == VIRGL_FORMAT_ASTC_8x5_SRGB) ||
+     (src == VIRGL_FORMAT_ASTC_8x6 && dst == VIRGL_FORMAT_ASTC_8x6_SRGB) ||
+     (src == VIRGL_FORMAT_ASTC_8x8 && dst == VIRGL_FORMAT_ASTC_8x8_SRGB) ||
+     (src == VIRGL_FORMAT_ASTC_10x5 && dst == VIRGL_FORMAT_ASTC_10x5_SRGB) ||
+     (src == VIRGL_FORMAT_ASTC_10x6 && dst == VIRGL_FORMAT_ASTC_10x6_SRGB) ||
+     (src == VIRGL_FORMAT_ASTC_10x8 && dst == VIRGL_FORMAT_ASTC_10x8_SRGB) ||
+     (src == VIRGL_FORMAT_ASTC_10x10 && dst == VIRGL_FORMAT_ASTC_10x10_SRGB) ||
+     (src == VIRGL_FORMAT_ASTC_12x10 && dst == VIRGL_FORMAT_ASTC_12x10_SRGB) ||
+     (src == VIRGL_FORMAT_ASTC_12x12 && dst == VIRGL_FORMAT_ASTC_12x12_SRGB) ||
+     (src == VIRGL_FORMAT_ETC2_R11_UNORM && dst == VIRGL_FORMAT_ETC2_R11_SNORM) ||
+     (src == VIRGL_FORMAT_ETC2_RG11_UNORM && dst == VIRGL_FORMAT_ETC2_RG11_SNORM) ||
+     (src == VIRGL_FORMAT_ETC2_RGBA8 && dst == VIRGL_FORMAT_ETC2_SRGBA8) ||
+     (src == VIRGL_FORMAT_ETC2_RGB8A1 && dst == VIRGL_FORMAT_ETC2_SRGB8A1) ||
+     (src == VIRGL_FORMAT_ETC2_RGB8 && dst == VIRGL_FORMAT_ETC2_SRGB8))
+      return true;
 
    if ((src == VIRGL_FORMAT_RGTC1_UNORM && dst == VIRGL_FORMAT_RGTC1_SNORM) ||
        (src == VIRGL_FORMAT_RGTC2_UNORM && dst == VIRGL_FORMAT_RGTC2_SNORM) ||
