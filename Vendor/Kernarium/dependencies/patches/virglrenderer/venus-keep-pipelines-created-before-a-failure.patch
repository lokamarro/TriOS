From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 28 Aug 2026 17:25:46 +0900
Subject: [PATCH] venus: keep pipelines created before a failure

vkCreate*Pipelines is not all-or-nothing. When any pipeline fails the
driver still returns valid handles for the ones it did create, sets only
the failed entries to VK_NULL_HANDLE, and reports the first error as the
command result. MoltenVK behaves exactly this way.

The generated create_array helper instead treated any error as fatal to
the whole batch: it zeroed every returned handle and destroyed the object
array, so vkr_pipeline_add_array never ran. The driver pipelines that were
successfully created leaked, and the client was told they did not exist
even though its own object ids remained bound to them.

Give pipeline objects their own create_array that keeps the array and
reports the driver result through args->ret. add_array already drops the
VK_NULL_HANDLE entries and registers the rest. Pool objects keep the
all-or-nothing helper, which matches their allocation semantics.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/venus/vkr_device_object.py | 31 ++++++++++++++++++++++++++++++-
 src/venus/vkr_pipeline.c       |  6 +++---
 2 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/src/venus/vkr_device_object.py b/src/venus/vkr_device_object.py
index 07d14cd14fdd1fcd2e000304664bfc3b88405be3..2844d37d6d5524d5b12c540b704633cd6e54b9a2 100644
--- a/src/venus/vkr_device_object.py
+++ b/src/venus/vkr_device_object.py
@@ -205,7 +205,36 @@ vkr_{create_func_name}_create_array(
 '''
 
 POOL_OBJECT_CREATE_ARRAY_TEMPL = COMMON_OBJECT_CREATE_ARRAY_TEMPL
-PIPELINE_OBJECT_CREATE_ARRAY_TEMPL = COMMON_OBJECT_CREATE_ARRAY_TEMPL
+
+PIPELINE_OBJECT_CREATE_ARRAY_TEMPL = '''
+/* create an array of vkr_{vkr_type}s
+ *
+ * Unlike pool allocation, vkCreate*Pipelines is not all-or-nothing.  When any
+ * pipeline fails, the driver still returns valid handles for the ones it did
+ * create and sets only the failed entries to VK_NULL_HANDLE, while reporting
+ * the first error as the command result.  Keep the object array in that case
+ * so vkr_{vkr_type}_add_array can track the pipelines that exist and drop only
+ * the failed entries.  Discarding the whole array would leak those driver
+ * pipelines and leave the client holding object ids the renderer never
+ * registered.
+ *
+ * Returns false only when no object array could be initialized at all; the
+ * driver result is reported through args->ret.
+ */
+static inline bool
+vkr_{create_func_name}_create_array(
+   struct vkr_context *ctx,
+   struct vn_command_{create_cmd} *args,
+   struct object_array *arr)
+{{
+   if (vkr_{create_func_name}_init_array(ctx, args, arr) != VK_SUCCESS)
+      return false;
+
+   vkr_{create_func_name}_create_driver_handles(ctx, args, arr);
+
+   return true;
+}}
+'''
 
 SIMPLE_OBJECT_CREATE_AND_ADD_TEMPL = '''
 /* create a vkr_{vkr_type} and add it to the vkr_device */
diff --git a/src/venus/vkr_pipeline.c b/src/venus/vkr_pipeline.c
index 76709b9b0adb6f6170b6a7dcd606671ded709bcb..d0d6f8364bf6c109bc31e5d01940853ce42669cc 100644
--- a/src/venus/vkr_pipeline.c
+++ b/src/venus/vkr_pipeline.c
@@ -114,7 +114,7 @@ vkr_dispatch_vkCreateGraphicsPipelines(struct vn_dispatch_context *dispatch,
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct object_array arr;
 
-   if (vkr_graphics_pipeline_create_array(ctx, args, &arr) < VK_SUCCESS)
+   if (!vkr_graphics_pipeline_create_array(ctx, args, &arr))
       return;
 
    vkr_pipeline_add_array(ctx, dev, &arr, args->pPipelines);
@@ -129,7 +129,7 @@ vkr_dispatch_vkCreateComputePipelines(struct vn_dispatch_context *dispatch,
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct object_array arr;
 
-   if (vkr_compute_pipeline_create_array(ctx, args, &arr) < VK_SUCCESS)
+   if (!vkr_compute_pipeline_create_array(ctx, args, &arr))
       return;
 
    vkr_pipeline_add_array(ctx, dev, &arr, args->pPipelines);
@@ -152,7 +152,7 @@ vkr_dispatch_vkCreateRayTracingPipelinesKHR(
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct object_array arr;
 
-   if (vkr_ray_tracing_pipeline_create_array(ctx, args, &arr) < VK_SUCCESS)
+   if (!vkr_ray_tracing_pipeline_create_array(ctx, args, &arr))
       return;
 
    vkr_pipeline_add_array(ctx, dev, &arr, args->pPipelines);
