@@ -7606,12 +7649,215 @@ static void vrend_pipe_resource_detach_iov(struct pipe_resource *pres,
    res->num_iovs = 0;
 }
 
-static enum virgl_resource_fd_type vrend_pipe_resource_export_fd(UNUSED struct pipe_resource *pres,
-                                                                 UNUSED int *fd,
+/* Exported resources GL has drawn into since their segment was last written.
+ * Only a resource that another context imports ever joins this list. */
+static struct list_head vrend_shm_export_dirty_list;
+static bool vrend_shm_export_dirty_list_ready;
+
+static void vrend_shm_export_dirty_list_init(void)
+{
+   if (!vrend_shm_export_dirty_list_ready) {
+      list_inithead(&vrend_shm_export_dirty_list);
+      vrend_shm_export_dirty_list_ready = true;
+   }
+}
+
+#ifdef ENABLE_METAL
+/* GL_AMD_pinned_memory is the one GL entry point that takes pages the caller
+ * allocated. Pinning a shared segment turns a refresh into a GPU-side copy of
+ * those very pages: no staging buffer and no CPU pass over the frame. Returns
+ * 0 when the host cannot pin, which leaves the ordinary client-memory path. */
+static GLuint vrend_shm_pin_pbo(void *map, uint64_t size)
+{
+   if (!has_feature(feat_amd_pinned_memory) || !map || !size)
+      return 0;
+
+   GLuint pbo = 0;
+   glGenBuffers(1, &pbo);
+   if (vrend_pin_host_pages(pbo, map, size))
+      return pbo;
+
+   glDeleteBuffers(1, &pbo);
+   return 0;
+}
+#endif /* ENABLE_METAL */
+
+/* Copy what GL drew into the segment the importing context reads. A pinned
+ * segment is written by the GPU, queued behind the drawing, and the fence the
+ * renderer creates next covers the copy. `now` has the pixels in the segment
+ * on return instead, for a reader that waits on no later fence. */
+static void vrend_resource_write_shm_export(struct vrend_resource *res, bool now)
+{
+   if (!res->shm_import_borrowed || !res->shm_import_map)
+      return;
+
+   const struct vrend_format_table *entry = &tex_conv_table[res->shm_import_format];
+   const uint32_t blocksize = util_format_get_blocksize(res->shm_import_format);
+   const uint32_t stride = res->shm_import_stride;
+   const uint64_t needed = (uint64_t)res->shm_import_offset +
+                           (uint64_t)stride * res->base.height0;
+
+   if (!blocksize || !stride || needed > res->shm_import_size)
+      return;
+
+   if (vrend_state.use_gles) {
+      /* glGetTexImage is desktop GL only, and the only host that exports a
+       * texture this way runs desktop GL over Metal. */
+      virgl_warn("%s: no GLES path to read a texture back into its segment\n",
+                 __func__);
+      return;
+   }
+
+   glBindTexture(res->target, res->gl_id);
+   glPixelStorei(GL_PACK_ALIGNMENT, 1);
+   if (stride % blocksize == 0)
+      glPixelStorei(GL_PACK_ROW_LENGTH, stride / blocksize);
+   if (res->shm_import_pbo && !now) {
+      glBindBuffer(GL_PIXEL_PACK_BUFFER, res->shm_import_pbo);
+      glGetTexImage(res->target, 0, entry->glformat, entry->gltype,
+                    (void *)(uintptr_t)res->shm_import_offset);
+      glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+   } else {
+      glGetTexImage(res->target, 0, entry->glformat, entry->gltype,
+                    (char *)res->shm_import_map + res->shm_import_offset);
+   }
+   glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+   glPixelStorei(GL_PACK_ALIGNMENT, 4);
+   glBindTexture(res->target, 0);
+}
+
+/* GL is about to write an exported resource. From here until the segment is
+ * next written, GL holds the newer pixels: a GL read must not refresh the
+ * texture from the segment, and the next fence owes the importer a copy. The
+ * importer may have written the segment since that copy, so a write that
+ * keeps any pixel first takes the segment's. A frame can span many command
+ * buffers that never bind the framebuffer again, so every write marks it. */
+static void vrend_resource_gl_write(struct vrend_resource *res, bool whole)
+{
+   if (likely(!res || !res->shm_import_borrowed) || res->shm_export_dirty)
+      return;
+
+   if (!whole)
+      vrend_resource_sync_shm_import(res);
+   vrend_shm_export_dirty_list_init();
+   res->shm_export_dirty = true;
+   list_addtail(&res->shm_export_head, &vrend_shm_export_dirty_list);
+}
+
+static void vrend_resource_flush_shm_export(struct vrend_resource *res, bool now)
+{
+   vrend_resource_write_shm_export(res, now);
+   res->shm_export_dirty = false;
+   list_del(&res->shm_export_head);
+}
+
+/* Write every exported resource GL has written back to the segment its
+ * importer reads, ahead of a fence: the guest fences its work before it
+ * passes a buffer on, so the fence that follows a write is the earliest point
+ * another consumer can look at the pixels. The copy runs in the current GL
+ * context; one that wrote earlier was flushed when it stopped being current. */
+static void vrend_resource_flush_shm_exports(void)
+{
+   if (!vrend_shm_export_dirty_list_ready)
+      return;
+
+   list_for_each_entry_safe(struct vrend_resource, res,
+                            &vrend_shm_export_dirty_list, shm_export_head)
+      vrend_resource_flush_shm_export(res, false);
+}
+
+#ifdef ENABLE_METAL
+/* The row pitch of a texture's segment. The importing driver is told the pitch
+ * the guest chose when it asked for the buffer, and Metal reads a texture over
+ * a buffer only at a pitch that is a multiple of 16 bytes, so the guest pads a
+ * row to the first whole number of pixels that meets it and the segment is laid
+ * out by the same rule: memory both sides agreed on, with a texture as wide as
+ * the guest samples it. */
+static uint32_t vrend_shm_export_stride(uint32_t width, uint32_t blocksize)
+{
+   uint32_t pixels = 1;
+
+   while ((pixels * blocksize) % 16)
+      pixels++;
+
+   return align(width, pixels) * blocksize;
+}
+
+/* Give a texture a shared-memory segment so another context can import it.
+ * An Apple host has no dma-buf, and this GL stack can build no texture over
+ * foreign storage, so sharing is a segment both sides map: the importer reads
+ * and writes the pages, and this texture is refreshed from them before each
+ * GL read, exactly as an imported blob is. The conversion happens only when a
+ * resource is actually handed to another context, so a buffer that stays
+ * inside GL keeps ordinary texture storage. */
+static bool vrend_resource_export_shm(struct vrend_resource *gr)
+{
+   if (gr->host_shm)
+      return has_bit(gr->storage_bits, VREND_STORAGE_HOST_SHM);
+
+   if (!has_bit(gr->storage_bits, VREND_STORAGE_GL_TEXTURE) ||
+       gr->target != GL_TEXTURE_2D || gr->base.last_level ||
+       gr->base.array_size > 1 || gr->base.depth0 > 1 || gr->base.nr_samples > 1)
+      return false;
+
+   const uint32_t format = gr->base.format;
+   if (format >= VIRGL_FORMAT_MAX || util_format_is_compressed(format))
+      return false;
+
+   const struct vrend_format_table *entry = &tex_conv_table[format];
+   const uint32_t blocksize = util_format_get_blocksize(format);
+   if (!entry->internalformat || !blocksize)
+      return false;
+
+   const uint32_t stride = vrend_shm_export_stride(gr->base.width0, blocksize);
+   const uint64_t size = (uint64_t)stride * gr->base.height0;
+   if (!size)
+      return false;
+
+   struct virgl_host_shm *shm = virgl_host_shm_alloc(size, 0);
+   if (!shm) {
+      virgl_error("%s: cannot share a %" PRIu64 " byte segment\n", __func__, size);
+      return false;
+   }
+
+   vrend_renderer_force_ctx_0();
+
+   gr->host_shm = shm;
+   gr->storage_bits |= VREND_STORAGE_HOST_SHM;
+   gr->shm_import_map = shm->ptr;
+   gr->shm_import_size = shm->size;
+   gr->shm_import_stride = stride;
+   gr->shm_import_offset = 0;
+   gr->shm_import_format = format;
+   gr->shm_import_borrowed = true;
+   gr->shm_import_pbo = vrend_shm_pin_pbo(shm->ptr, shm->size);
+
+   /* The importer's first read must see what this texture already holds,
+    * and it may read before any later fence. */
+   vrend_resource_write_shm_export(gr, true);
+
+   virgl_info("%s: sharing a %ux%u texture through a %" PRIu64
+              " byte segment, stride %u%s\n", __func__, gr->base.width0,
+              gr->base.height0, (uint64_t)shm->size, stride,
+              gr->shm_import_pbo ? ", pinned" : "");
+   return true;
+}
+#endif /* ENABLE_METAL */
+
+static enum virgl_resource_fd_type vrend_pipe_resource_export_fd(struct pipe_resource *pres,
+                                                                 int *fd,
                                                                  UNUSED void *data)
 {
    struct vrend_resource *shm_res = (struct vrend_resource *)pres;
+#ifdef ENABLE_METAL
+   /* A texture has no shared storage until someone asks to import it. */
+   if (!has_bit(shm_res->storage_bits, VREND_STORAGE_HOST_SHM))
+      (void)vrend_resource_export_shm(shm_res);
+#endif
    if (has_bit(shm_res->storage_bits, VREND_STORAGE_HOST_SHM)) {
+      /* Hand out what GL has drawn so far, not the last snapshot. */
+      if (shm_res->shm_export_dirty)
+         vrend_resource_flush_shm_export(shm_res, true);
       *fd = os_dupfd_cloexec(shm_res->host_shm->fd);
       return *fd >= 0 ? VIRGL_RESOURCE_FD_SHM : VIRGL_RESOURCE_FD_INVALID;
    }
@@ -9309,28 +9555,10 @@ static int vrend_resource_import_shm(struct vrend_resource *gr,
                  offset);
    }
 
-   /* GL_AMD_pinned_memory is the one GL entry point that takes pages the
-    * caller allocated. Pinning the exporter's segment turns the refresh into
-    * a GPU-side copy: no staging buffer, no CPU pass over the frame. */
-   if (has_feature(feat_amd_pinned_memory)) {
-      GLuint pbo = 0;
-      glGenBuffers(1, &pbo);
-      while (glGetError() != GL_NO_ERROR)
-         ;
-      glBindBufferARB(GL_EXTERNAL_VIRTUAL_MEMORY_BUFFER_AMD, pbo);
