-         glDeleteBuffers(1, &pbo);
-      }
-   }
+   /* Pinning the exporter's segment turns the refresh into a GPU-side copy of
+    * its own pages; an unpinnable segment falls back to a client-memory
+    * upload. This is the same pinning the export direction uses. */
+   gr->shm_import_pbo = vrend_shm_pin_pbo(map, res->map_size);
 
    gr->shm_import_map = map;
    gr->shm_import_size = res->map_size;
@@ -9347,6 +9575,10 @@ void vrend_resource_sync_shm_import(struct vrend_resource *res)
    if (likely(!res || !res->shm_import_map || res->shm_import_image))
       return;
 
+   /* GL wrote an exported texture after its segment: the texture is newer. */
+   if (res->shm_export_dirty)
+      return;
+
    const struct vrend_format_table *entry = &tex_conv_table[res->shm_import_format];
    const uint32_t blocksize = util_format_get_blocksize(res->shm_import_format);
    const uint32_t width = res->base.width0;
@@ -9383,7 +9615,11 @@ void vrend_renderer_resource_destroy(struct vrend_resource *res)
    if (res->shm_import_image)
       virgl_egl_host_pointer_image_destroy(egl, res->shm_import_image);
 #endif
-   if (res->shm_import_map)
+   if (res->shm_export_dirty)
+      list_del(&res->shm_export_head);
