+   if (res->shm_import_map && !res->shm_import_borrowed)
       munmap(res->shm_import_map, res->shm_import_size);
 
    if (has_bit(res->storage_bits, VREND_STORAGE_GL_TEXTURE)) {
@@ -9784,6 +10020,11 @@ static int vrend_renderer_transfer_write_iov(struct vrend_context *ctx,
 {
    void *data;
 
+   vrend_resource_gl_write(res, vrend_write_is_whole(res, info->level,
+                                                     info->box->x, info->box->y,
+                                                     info->box->width,
+                                                     info->box->height));
+
    if ((is_only_bit(res->storage_bits, VREND_STORAGE_GUEST_MEMORY) ||
        has_bit(res->storage_bits, VREND_STORAGE_HOST_SYSTEM_MEMORY)) && res->iov) {
       return virgl_copy_iovec(iov, num_iovs, info->offset,
@@ -10453,6 +10694,9 @@ static int vrend_renderer_transfer_send_iov(struct vrend_context *ctx,
                                             const struct iovec *iov, int num_iovs,
                                             const struct vrend_transfer_info *info)
 {
+   /* a readback is one more GL read of an imported or exported texture */
+   vrend_resource_sync_shm_import(res);
+
    if ((is_only_bit(res->storage_bits, VREND_STORAGE_GUEST_MEMORY) ||
        has_bit(res->storage_bits, VREND_STORAGE_HOST_SYSTEM_MEMORY)) && res->iov) {
       return virgl_copy_iovec(res->iov, res->num_iovs, info->box->x,
@@ -11212,6 +11456,12 @@ void vrend_renderer_resource_copy_region(struct vrend_context *ctx,
       return;
    }
 
+   vrend_resource_sync_shm_import(src_res);
+   vrend_resource_gl_write(dst_res, vrend_write_is_whole(dst_res, dst_level,
+                                                         dstx, dsty,
+                                                         src_box->width,
+                                                         src_box->height));
+
    VREND_DEBUG(dbg_copy_resource, ctx, "COPY_REGION: From %s ms:%d [%d, %d, %d]+[%d, %d, %d] lvl:%d "
                                    "To %s ms:%d [%d, %d, %d]\n",
