@@ -6045,6 +6080,14 @@ int vrend_draw_vbo(struct vrend_context *ctx,
    if (ctx->sub->blend_state_dirty)
       vrend_patch_blend_state(sub_ctx);
 
+   /* A draw writes every attachment of the framebuffer it renders to. */
+   for (uint32_t i = 0; i < sub_ctx->nr_cbufs; i++) {
+      if (sub_ctx->surf[i])
+         vrend_resource_gl_write(sub_ctx->surf[i]->texture, false);
+   }
