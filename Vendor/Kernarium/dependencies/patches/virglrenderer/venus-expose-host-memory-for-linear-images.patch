From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 3 Sep 2026 18:00:57 +0900
Subject: [PATCH] venus: expose host memory for linear images

---
 src/venus/vkr_image.c | 14 +++++++++++---
 src/venus/vkr_image.h |  1 +
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/src/venus/vkr_image.c b/src/venus/vkr_image.c
index 9148f317ff15817e8250883c23278c719a25698e..bb0e867cbc7b4ffd1a262555a4c4d3b1ad9b7f5a 100644
--- a/src/venus/vkr_image.c
+++ b/src/venus/vkr_image.c
@@ -12,6 +12,7 @@ static void
 vkr_dispatch_vkCreateImage(struct vn_dispatch_context *dispatch,
                            struct vn_command_vkCreateImage *args)
 {
+   const VkImageTiling tiling = args->pCreateInfo->tiling;
    /* XXX If VkExternalMemoryImageCreateInfo is chained by the app, all is
     * good.  If it is not chained, we might still bind an external memory to
     * the image, because vkr_dispatch_vkAllocateMemory makes any HOST_VISIBLE
@@ -37,6 +38,7 @@ vkr_dispatch_vkCreateImage(struct vn_dispatch_context *dispatch,
    if (image) {
       image->format = format;
       image->array_layers = array_layers;
+      image->tiling = tiling;
    }
 }
 
@@ -54,12 +56,14 @@ vkr_dispatch_vkGetImageMemoryRequirements(
 {
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
+   struct vkr_image *image = vkr_image_from_handle(args->image);
 
    vn_replace_vkGetImageMemoryRequirements_args_handle(args);
    vk->GetImageMemoryRequirements(args->device, args->image, args->pMemoryRequirements);
    args->pMemoryRequirements->memoryTypeBits =
       vkr_physical_device_get_guest_memory_type_bits(
-         dev->physical_device, args->pMemoryRequirements->memoryTypeBits, false);
+         dev->physical_device, args->pMemoryRequirements->memoryTypeBits,
+         image->tiling == VK_IMAGE_TILING_LINEAR);
 }
 
 static void
@@ -69,13 +73,15 @@ vkr_dispatch_vkGetImageMemoryRequirements2(
 {
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
+   struct vkr_image *image = vkr_image_from_handle(args->pInfo->image);
 
    vn_replace_vkGetImageMemoryRequirements2_args_handle(args);
    vk->GetImageMemoryRequirements2(args->device, args->pInfo, args->pMemoryRequirements);
    args->pMemoryRequirements->memoryRequirements.memoryTypeBits =
       vkr_physical_device_get_guest_memory_type_bits(
          dev->physical_device,
-         args->pMemoryRequirements->memoryRequirements.memoryTypeBits, false);
+         args->pMemoryRequirements->memoryRequirements.memoryTypeBits,
+         image->tiling == VK_IMAGE_TILING_LINEAR);
 }
 
 static void
@@ -238,6 +244,8 @@ vkr_dispatch_vkGetDeviceImageMemoryRequirements(
 {
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
+   const bool linear =
+      args->pInfo->pCreateInfo->tiling == VK_IMAGE_TILING_LINEAR;
 
    vn_replace_vkGetDeviceImageMemoryRequirements_args_handle(args);
    vk->GetDeviceImageMemoryRequirements(args->device, args->pInfo,
@@ -245,7 +253,7 @@ vkr_dispatch_vkGetDeviceImageMemoryRequirements(
    args->pMemoryRequirements->memoryRequirements.memoryTypeBits =
       vkr_physical_device_get_guest_memory_type_bits(
          dev->physical_device,
-         args->pMemoryRequirements->memoryRequirements.memoryTypeBits, false);
+         args->pMemoryRequirements->memoryRequirements.memoryTypeBits, linear);
 }
 
 static void
diff --git a/src/venus/vkr_image.h b/src/venus/vkr_image.h
index 34af4248b8ff51ad6f6b32f0a512fd135f81217e..f098dc3ccbf5093c370d3d843f0fcd880745bbd9 100644
--- a/src/venus/vkr_image.h
+++ b/src/venus/vkr_image.h
@@ -13,6 +13,7 @@ struct vkr_image {
    /* What a host image copy needs to know how far its region reaches. */
    VkFormat format;
    uint32_t array_layers;
+   VkImageTiling tiling;
 };
 VKR_DEFINE_OBJECT_CAST(image, VK_OBJECT_TYPE_IMAGE, VkImage)
 
