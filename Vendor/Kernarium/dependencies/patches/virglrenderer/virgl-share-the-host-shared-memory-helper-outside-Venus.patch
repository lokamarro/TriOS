From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 12 Sep 2026 12:28:07 +0900
Subject: [PATCH] virgl: share the host shared-memory helper outside Venus

The anonymous-file allocator that gives a host-visible Venus allocation a
descriptor the guest can map is not specific to Vulkan: any renderer that
wants to hand the guest real host pages needs the same page-aligned shared
mapping. Move it beside the other cross-renderer helpers and name it for
virgl rather than for the Venus renderer. Pure move and rename.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/meson.build                               |  2 +-
 src/venus/vkr_device_memory.c                 | 12 +++++-----
 src/venus/vkr_device_memory.h                 |  4 ++--
 src/venus/vkr_host_memory.h                   | 24 -------------------
 .../vkr_host_memory.c => virgl_host_memory.c} | 12 +++++-----
 src/virgl_host_memory.h                       | 24 +++++++++++++++++++
 6 files changed, 39 insertions(+), 39 deletions(-)
 delete mode 100644 src/venus/vkr_host_memory.h
 rename src/{venus/vkr_host_memory.c => virgl_host_memory.c} (81%)
 create mode 100644 src/virgl_host_memory.h

diff --git a/src/meson.build b/src/meson.build
index cbde781ba79ab59c889e919d66e59486d021d13c..0cafd3bbb5a447764ac4931ad2a15a46834bc0a7 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -32,6 +32,7 @@ endif
 virgl_sources = [
    'virgl_context.c',
    'virgl_fence.c',
+   'virgl_host_memory.c',
    'virgl_iov.c',
    'virgl_resource.c',
    'virgl_util.c',
@@ -81,7 +82,6 @@ venus_sources = [
    'venus/vkr_descriptor_set.c',
    'venus/vkr_device.c',
    'venus/vkr_device_memory.c',
-   'venus/vkr_host_memory.c',
    'venus/vkr_host_copy.c',
    'venus/vkr_image.c',
    'venus/vkr_instance.c',
diff --git a/src/venus/vkr_device_memory.c b/src/venus/vkr_device_memory.c
index d0945d02dbedbe405aa532f2104cb87b792c6252..918e9b4efb813b6773a407e7b579640b8cb3a2d6 100644
--- a/src/venus/vkr_device_memory.c
+++ b/src/venus/vkr_device_memory.c
@@ -11,7 +11,7 @@
 #include <vn_protocol_renderer_transport.h>
 
 #include "vkr_device_memory_gen.h"
-#include "vkr_host_memory.h"
+#include "virgl_host_memory.h"
 #include "vkr_physical_device.h"
 
 static bool
@@ -396,7 +396,7 @@ vkr_dispatch_vkAllocateMemory(struct vn_dispatch_context *dispatch,
    uint32_t valid_fd_types = 0;
    int udmabuf_fd = -1;
    void *gbm_bo = NULL;
-   struct vkr_host_shm *host_shm = NULL;
+   struct virgl_host_shm *host_shm = NULL;
    VkExportMemoryAllocateInfo local_export_info;
    /* VK_EXT_external_memory_host is renderer-internal.  It gives a unified-memory
     * host a real Vulkan import of the same anonymous file that virtio-gpu maps into
@@ -419,7 +419,7 @@ vkr_dispatch_vkAllocateMemory(struct vn_dispatch_context *dispatch,
          export_info = NULL;
       }
 
-      host_shm = vkr_host_shm_alloc(
+      host_shm = virgl_host_shm_alloc(
          alloc_info->allocationSize,
          physical_dev->min_imported_host_pointer_alignment);
       if (!host_shm) {
@@ -437,7 +437,7 @@ vkr_dispatch_vkAllocateMemory(struct vn_dispatch_context *dispatch,
           !(host_props.memoryTypeBits & (1u << host_mem_type_index))) {
          if (args->ret == VK_SUCCESS)
             args->ret = VK_ERROR_INVALID_EXTERNAL_HANDLE;
-         vkr_host_shm_free(host_shm);
+         virgl_host_shm_free(host_shm);
          return;
       }
 
@@ -542,7 +542,7 @@ vkr_dispatch_vkAllocateMemory(struct vn_dispatch_context *dispatch,
          close(local_import_info.fd);
       if (gbm_bo)
          vkr_gbm_bo_destroy(gbm_bo);
-      vkr_host_shm_free(host_shm);
+      virgl_host_shm_free(host_shm);
       vkr_shm_mapping_release(host_mapping);
       return;
    }
@@ -697,7 +697,7 @@ vkr_device_memory_release(struct vkr_device_memory *mem)
    virgl_resource_native_release(mem->native_resource_id);
    if (mem->metal_heap_fd >= 0)
       close(mem->metal_heap_fd);
-   vkr_host_shm_free(mem->host_shm);
+   virgl_host_shm_free(mem->host_shm);
    vkr_shm_mapping_release(mem->host_mapping);
    if (mem->gbm_bo)
       vkr_gbm_bo_destroy(mem->gbm_bo);
diff --git a/src/venus/vkr_device_memory.h b/src/venus/vkr_device_memory.h
index c695c7de3ee0297e82318076af207abf6c3f7c2d..76d61e4620ee2d046a197e207fa3cdd6bff114a0 100644
--- a/src/venus/vkr_device_memory.h
+++ b/src/venus/vkr_device_memory.h
@@ -9,7 +9,7 @@
 #include "vkr_common.h"
 
 struct gbm_bo;
-struct vkr_host_shm;
+struct virgl_host_shm;
 
 struct vkr_device_memory {
    struct vkr_object base;
@@ -28,7 +28,7 @@ struct vkr_device_memory {
    int udmabuf_fd;
 
    /* Anonymous shared memory imported through VK_EXT_external_memory_host. */
-   struct vkr_host_shm *host_shm;
+   struct virgl_host_shm *host_shm;
 
    /* A shared-memory resource's mapping this memory imports as host memory,
     * held so the range outlives the resource. */
diff --git a/src/venus/vkr_host_memory.h b/src/venus/vkr_host_memory.h
deleted file mode 100644
index 55c2f5c81299a342f8c6a07ddc23d6c43736e00f..0000000000000000000000000000000000000000
--- a/src/venus/vkr_host_memory.h
+++ /dev/null
@@ -1,24 +0,0 @@
-/*
- * Copyright 2026 The linux-um-darwin Authors
- * SPDX-License-Identifier: MIT
- */
-
-#ifndef VKR_HOST_MEMORY_H
-#define VKR_HOST_MEMORY_H
-
-#include <stddef.h>
-#include <stdint.h>
-
-struct vkr_host_shm {
-   int fd;
-   void *ptr;
-   size_t size;
-};
-
-struct vkr_host_shm *
-vkr_host_shm_alloc(uint64_t size, uint64_t alignment);
-
-void
-vkr_host_shm_free(struct vkr_host_shm *shm);
-
-#endif /* VKR_HOST_MEMORY_H */
diff --git a/src/venus/vkr_host_memory.c b/src/virgl_host_memory.c
similarity index 81%
rename from src/venus/vkr_host_memory.c
rename to src/virgl_host_memory.c
index 0e3649422f9fe0e7f4fb7054d685d22ec76da565..394da841f7e68e8e8fdb5e208b24f9471afa166f 100644
--- a/src/venus/vkr_host_memory.c
+++ b/src/virgl_host_memory.c
@@ -3,7 +3,7 @@
  * SPDX-License-Identifier: MIT
  */
 
-#include "vkr_host_memory.h"
+#include "virgl_host_memory.h"
 
 #include <stdint.h>
 #include <stdlib.h>
@@ -12,8 +12,8 @@
 
 #include "util/anon_file.h"
 
-struct vkr_host_shm *
-vkr_host_shm_alloc(uint64_t size, uint64_t alignment)
+struct virgl_host_shm *
+virgl_host_shm_alloc(uint64_t size, uint64_t alignment)
 {
    const uint64_t page_size = (uint64_t)getpagesize();
    if (alignment < page_size)
@@ -26,7 +26,7 @@ vkr_host_shm_alloc(uint64_t size, uint64_t alignment)
    if (!aligned_size || aligned_size > SIZE_MAX || aligned_size > INT64_MAX)
       return NULL;
 
-   int fd = os_create_anonymous_file((off_t)aligned_size, "vkr-host-mem");
+   int fd = os_create_anonymous_file((off_t)aligned_size, "virgl-host-mem");
    if (fd < 0)
       return NULL;
 
@@ -42,7 +42,7 @@ vkr_host_shm_alloc(uint64_t size, uint64_t alignment)
       return NULL;
    }
 
-   struct vkr_host_shm *shm = calloc(1, sizeof(*shm));
+   struct virgl_host_shm *shm = calloc(1, sizeof(*shm));
    if (!shm) {
       munmap(ptr, (size_t)aligned_size);
       close(fd);
@@ -56,7 +56,7 @@ vkr_host_shm_alloc(uint64_t size, uint64_t alignment)
 }
 
 void
-vkr_host_shm_free(struct vkr_host_shm *shm)
+virgl_host_shm_free(struct virgl_host_shm *shm)
 {
    if (!shm)
       return;
diff --git a/src/virgl_host_memory.h b/src/virgl_host_memory.h
new file mode 100644
index 0000000000000000000000000000000000000000..f487a20da13bf921eb6bc876c168b0b73cc39e4b
--- /dev/null
+++ b/src/virgl_host_memory.h
@@ -0,0 +1,24 @@
+/*
+ * Copyright 2026 The linux-um-darwin Authors
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VIRGL_HOST_MEMORY_H
+#define VIRGL_HOST_MEMORY_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+struct virgl_host_shm {
+   int fd;
+   void *ptr;
+   size_t size;
+};
+
+struct virgl_host_shm *
+virgl_host_shm_alloc(uint64_t size, uint64_t alignment);
+
+void
+virgl_host_shm_free(struct virgl_host_shm *shm);
+
+#endif /* VIRGL_HOST_MEMORY_H */
