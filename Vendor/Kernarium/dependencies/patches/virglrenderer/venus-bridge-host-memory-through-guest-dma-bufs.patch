diff --git a/src/venus/vkr_context.h b/src/venus/vkr_context.h
index 3867f138fdfd6cedca49c7de4ceca01d76546d43..7607063f95d93c16820d8f222f17659948722409 100644
--- a/src/venus/vkr_context.h
+++ b/src/venus/vkr_context.h
@@ -15,6 +15,24 @@
 
 #include "vkr_cs.h"
 
+/*
+ * The mapping of a shared-memory resource. The resource holds one reference,
+ * and so does each device memory that imports the mapping as host memory:
+ * VK_EXT_external_memory_host requires the range to stay mapped for as long
+ * as the memory lives, and the guest destroys the resource whenever it likes.
+ */
+struct vkr_shm_mapping {
+   void *data;
+   size_t size;
+   atomic_uint refcount;
+};
+
+struct vkr_shm_mapping *
+vkr_shm_mapping_retain(struct vkr_shm_mapping *mapping);
+
+void
+vkr_shm_mapping_release(struct vkr_shm_mapping *mapping);
+
 /*
  * When vkr_context_create_resource or vkr_context_import_resource is called, a
  * vkr_resource is created, and is valid until vkr_context_destroy_resource.
@@ -32,6 +50,14 @@ struct vkr_resource {
    } u;
 
    size_t size;
+
+   /* Retains a same-process native allocation in the fd identity registry. */
+   uint64_t native_resource_id;
+   enum virgl_resource_native_handle_type native_handle_type;
+   void *native_handle;
+
+   /* The reference that keeps u.data mapped, valid when fd_type is shm. */
+   struct vkr_shm_mapping *shm_mapping;
 };
 
 enum vkr_context_validate_level {
