diff --git a/src/venus/vkr_context.c b/src/venus/vkr_context.c
index cc82c42de8af9c4844d71ef23b88809a054fade9..14302e1c0d44a6f2972b7f8d297a27cb1c33bcaf 100644
--- a/src/venus/vkr_context.c
+++ b/src/venus/vkr_context.c
@@ -185,14 +185,33 @@ vkr_context_submit_cmd(struct vkr_context *ctx, const void *buffer, size_t size)
    return true;
 }
 
+struct vkr_shm_mapping *
+vkr_shm_mapping_retain(struct vkr_shm_mapping *mapping)
+{
+   atomic_fetch_add_explicit(&mapping->refcount, 1, memory_order_relaxed);
+   return mapping;
+}
+
+void
+vkr_shm_mapping_release(struct vkr_shm_mapping *mapping)
+{
+   if (!mapping ||
+       atomic_fetch_sub_explicit(&mapping->refcount, 1, memory_order_acq_rel) != 1)
+      return;
+
+   munmap(mapping->data, mapping->size);
+   free(mapping);
+}
+
 static inline void
 vkr_context_free_resource(struct hash_entry *entry)
 {
    struct vkr_resource *res = entry->data;
    if (res->fd_type == VIRGL_RESOURCE_FD_SHM)
-      munmap(res->u.data, res->size);
+      vkr_shm_mapping_release(res->shm_mapping);
    else if (res->u.fd >= 0)
       close(res->u.fd);
+   virgl_resource_native_release(res->native_resource_id);
    free(res);
 }
 
@@ -226,26 +245,49 @@ vkr_context_import_resource_internal(struct vkr_context *ctx,
                                      uint64_t blob_size,
                                      enum virgl_resource_fd_type fd_type,
                                      int fd,
-                                     void *mmap_ptr)
+                                     void *mmap_ptr,
+                                     uint64_t native_resource_id,
+                                     enum virgl_resource_native_handle_type native_handle_type,
+                                     void *native_handle)
 {
    assert(!vkr_context_get_resource(ctx, res_id));
 
    struct vkr_resource *res = malloc(sizeof(*res));
-   if (!res)
+   if (!res) {
+      virgl_resource_native_release(native_resource_id);
       return false;
+   }
 
    res->res_id = res_id;
    res->fd_type = fd_type;
    res->size = blob_size;
+   res->native_resource_id = native_resource_id;
+   res->native_handle_type = native_handle_type;
+   res->native_handle = native_handle;
+   res->shm_mapping = NULL;
 
    /* fd and mmap_ptr cannot be valid at the same time, but allowed to be -1 and NULL */
    assert(fd < 0 || !mmap_ptr);
-   if (mmap_ptr)
+   if (mmap_ptr) {
+      /* The mapping belongs to the resource only once it is added; until
+       * then a failure leaves it to the caller. */
+      res->shm_mapping = malloc(sizeof(*res->shm_mapping));
+      if (!res->shm_mapping) {
+         virgl_resource_native_release(native_resource_id);
+         free(res);
+         return false;
+      }
+      res->shm_mapping->data = mmap_ptr;
+      res->shm_mapping->size = blob_size;
+      atomic_init(&res->shm_mapping->refcount, 1);
       res->u.data = mmap_ptr;
-   else
+   } else {
       res->u.fd = fd;
+   }
 
    if (!vkr_context_add_resource(ctx, res)) {
+      virgl_resource_native_release(native_resource_id);
+      free(res->shm_mapping);
       free(res);
       return false;
    }
@@ -257,21 +299,30 @@ static bool
 vkr_context_import_resource_from_shm(struct vkr_context *ctx,
                                      uint32_t res_id,
                                      uint64_t blob_size,
-                                     int fd)
+                                     int fd,
+                                     uint64_t native_resource_id,
+                                     enum virgl_resource_native_handle_type native_handle_type,
+                                     void *native_handle)
 {
    assert(!vkr_context_get_resource(ctx, res_id));
 
+   /* The caller retains ownership of fd.  The mapping has its own lifetime
+    * and remains valid after the render-server request descriptor is closed.
+    */
    void *mmap_ptr = mmap(NULL, blob_size, PROT_WRITE | PROT_READ, MAP_SHARED, fd, 0);
-   if (mmap_ptr == MAP_FAILED)
+   if (mmap_ptr == MAP_FAILED) {
+      virgl_resource_native_release(native_resource_id);
       return false;
+   }
 
    if (!vkr_context_import_resource_internal(ctx, res_id, blob_size,
-                                             VIRGL_RESOURCE_FD_SHM, -1, mmap_ptr)) {
+                                             VIRGL_RESOURCE_FD_SHM, -1, mmap_ptr,
+                                             native_resource_id,
+                                             native_handle_type, native_handle)) {
       munmap(mmap_ptr, blob_size);
       return false;
    }
 
-   close(fd);
    return true;
 }
 
@@ -300,7 +351,9 @@ vkr_context_create_resource_from_shm(struct vkr_context *ctx,
    }
 
    if (!vkr_context_import_resource_internal(ctx, res_id, alloc_size,
-                                             VIRGL_RESOURCE_FD_SHM, -1, mmap_ptr)) {
+                                             VIRGL_RESOURCE_FD_SHM, -1, mmap_ptr,
+                                             0, VIRGL_RESOURCE_NATIVE_HANDLE_NONE,
+                                             NULL)) {
       munmap(mmap_ptr, alloc_size);
       close(fd);
       return false;
@@ -333,6 +386,29 @@ vkr_context_create_resource_from_device_memory(struct vkr_context *ctx,
    if (!vkr_device_memory_export_blob(mem, blob_size, blob_flags, &blob))
       return false;
 
+   /* SHM resources are consumed as host pointers, so retain a mapping in the
+    * context instead of retaining an fd in the union.  This also covers
+    * ordinary mappable allocations, which need a context resource even when
+    * the Vulkan memory was not explicitly exportable.
+    */
+   if (blob.type == VIRGL_RESOURCE_FD_SHM) {
+      enum virgl_resource_native_handle_type native_handle_type =
+         VIRGL_RESOURCE_NATIVE_HANDLE_NONE;
+      void *native_handle = NULL;
+      uint64_t native_resource_id = virgl_resource_native_acquire(
+         blob.u.fd, &native_handle_type, &native_handle);
+      if (!vkr_context_import_resource_from_shm(ctx, res_id, blob_size,
+                                                blob.u.fd, native_resource_id,
+                                                native_handle_type,
+                                                native_handle)) {
+         close(blob.u.fd);
+         return false;
+      }
+
+      *out_blob = blob;
+      return true;
+   }
+
    /* If memory might get exported, store a dup'ed fd in vkr_resource for:
     * - vkAllocateMemory for dma_buf import
     * - vkGetMemoryFdPropertiesKHR for dma_buf fd properties query
@@ -346,8 +422,9 @@ vkr_context_create_resource_from_device_memory(struct vkr_context *ctx,
       }
    }
 
-   if (!vkr_context_import_resource_internal(ctx, res_id, blob_size, blob.type, res_fd,
-                                             NULL)) {
+   if (!vkr_context_import_resource_internal(
+          ctx, res_id, blob_size, blob.type, res_fd, NULL, 0,
+          VIRGL_RESOURCE_NATIVE_HANDLE_NONE, NULL)) {
       if (res_fd >= 0)
          close(res_fd);
       close(blob.u.fd);
@@ -384,10 +461,27 @@ vkr_context_import_resource(struct vkr_context *ctx,
                             int fd,
                             uint64_t size)
 {
-   if (fd_type == VIRGL_RESOURCE_FD_SHM)
-      return vkr_context_import_resource_from_shm(ctx, res_id, size, fd);
+   if (fd_type == VIRGL_RESOURCE_FD_SHM) {
+      enum virgl_resource_native_handle_type native_handle_type =
+         VIRGL_RESOURCE_NATIVE_HANDLE_NONE;
+      void *native_handle = NULL;
+      uint64_t native_resource_id = virgl_resource_native_acquire(
+         fd, &native_handle_type, &native_handle);
+      if (!vkr_context_import_resource_from_shm(
+             ctx, res_id, size, fd, native_resource_id, native_handle_type,
+             native_handle))
+         return false;
+
+      /* The mapping outlives the descriptor, and a successful import is the
+       * end of the request's ownership of it.
+       */
+      close(fd);
+      return true;
+   }
 
-   return vkr_context_import_resource_internal(ctx, res_id, size, fd_type, fd, NULL);
+   return vkr_context_import_resource_internal(
+      ctx, res_id, size, fd_type, fd, NULL, 0,
+      VIRGL_RESOURCE_NATIVE_HANDLE_NONE, NULL);
 }
 
