+   uint64_t id;
+   dev_t device;
+   ino_t inode;
+   enum virgl_resource_native_handle_type type;
+   void *handle;
+   uint32_t refcount;
+   struct list_head head;
+};
+
+static once_flag native_resource_once = ONCE_FLAG_INIT;
+static mtx_t native_resource_mutex;
+static struct list_head native_resources;
+static uint64_t next_native_resource_id = 1;
+static bool native_resource_ready;
+
+static void
+virgl_resource_native_init_once(void)
+{
+   list_inithead(&native_resources);
+   native_resource_ready = mtx_init(&native_resource_mutex, mtx_plain) == thrd_success;
+}
+
+static bool
+virgl_resource_native_fd_identity(int fd, dev_t *device, ino_t *inode)
+{
+   struct stat stat_buffer;
+   if (fd < 0 || fstat(fd, &stat_buffer))
+      return false;
+
+   *device = stat_buffer.st_dev;
+   *inode = stat_buffer.st_ino;
+   return true;
+}
+
+uint64_t
+virgl_resource_native_publish(int fd,
+                              enum virgl_resource_native_handle_type type,
+                              void *handle)
+{
+#if defined(ENABLE_METAL) && defined(ENABLE_SAME_PROCESS_RENDER_SERVER)
+   dev_t device;
+   ino_t inode;
+   if (type != VIRGL_RESOURCE_NATIVE_HANDLE_METAL_HEAP || !handle ||
+       !virgl_resource_native_fd_identity(fd, &device, &inode))
+      return 0;
+
+   call_once(&native_resource_once, virgl_resource_native_init_once);
+   if (!native_resource_ready)
+      return 0;
+
+   struct virgl_native_resource *resource = calloc(1, sizeof(*resource));
+   if (!resource)
+      return 0;
+
+   mtx_lock(&native_resource_mutex);
+   list_for_each_entry (struct virgl_native_resource, existing,
+                        &native_resources, head) {
+      if (existing->device == device && existing->inode == inode) {
+         mtx_unlock(&native_resource_mutex);
+         free(resource);
+         return 0;
+      }
+   }
+
+   if (!next_native_resource_id)
+      next_native_resource_id++;
+   resource->id = next_native_resource_id++;
+   resource->device = device;
+   resource->inode = inode;
+   resource->type = type;
+   resource->handle = virgl_metal_retain_object(handle);
+   resource->refcount = 1;
+   list_addtail(&resource->head, &native_resources);
+   mtx_unlock(&native_resource_mutex);
+
+   return resource->id;
+#else
+   (void)fd;
+   (void)type;
+   (void)handle;
+   return 0;
+#endif
+}
+
+uint64_t
+virgl_resource_native_acquire(int fd,
+                              enum virgl_resource_native_handle_type *out_type,
+                              void **out_handle)
+{
