+++ b/src/venus/vkr_device.c
@@ -95,6 +95,18 @@ vkr_device_init_renderer_procs(struct vkr_device *dev)
          return false;
    }
 
+   if (physical_dev->EXT_external_memory_metal) {
+      dev->GetMemoryMetalHandlePropertiesEXT =
+         (PFN_vkGetMemoryMetalHandlePropertiesEXT)vk->GetDeviceProcAddr(
+            handle, "vkGetMemoryMetalHandlePropertiesEXT");
+      dev->GetMemoryMetalHandleEXT =
+         (PFN_vkGetMemoryMetalHandleEXT)vk->GetDeviceProcAddr(
+            handle, "vkGetMemoryMetalHandleEXT");
+      if (!dev->GetMemoryMetalHandlePropertiesEXT ||
+          !dev->GetMemoryMetalHandleEXT)
+         return false;
+   }
+
    return true;
 }
 
