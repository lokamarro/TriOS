From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 8 Nov 2026 14:43:42 +0900
Subject: [PATCH] venus: tell the host about a guest allocation it refused

A Venus guest learns that the host had no memory for its
vkAllocateMemory from the failed call, or from the failed ring when
its driver allocates asynchronously, but the host that granted the
memory had no way to count the refusals its guests were answered
with.

The device memory pool gains an optional refused callback. The
renderer calls it for each vkAllocateMemory it answers with
VK_ERROR_OUT_OF_DEVICE_MEMORY, after the driver's pool has freed what
it could and decided again, from the ring thread that decided it.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/venus/vkr_device_memory.c | 5 +++++
 src/venus/vkr_renderer.c      | 9 +++++++++
 src/venus/vkr_renderer.h      | 8 ++++++++
 src/virglrenderer.c           | 1 +
 src/virglrenderer.h           | 6 ++++++
 5 files changed, 29 insertions(+)

diff --git a/src/venus/vkr_device_memory.c b/src/venus/vkr_device_memory.c
index 62e9470c76338eb9e84ebb0946f1c9ac38f56176..2e77f9820349807e0d771b9500cda41338bc91f3 100644
--- a/src/venus/vkr_device_memory.c
+++ b/src/venus/vkr_device_memory.c
@@ -594,6 +594,11 @@ vkr_dispatch_vkAllocateMemory(struct vn_dispatch_context *dispatch,
 
    if (reserved)
       vkr_renderer_device_memory_release(reserved);
+
+   /* The pool has freed what it could by now: this refusal reaches the guest.
+    */
+   if (args->ret == VK_ERROR_OUT_OF_DEVICE_MEMORY)
+      vkr_renderer_device_memory_refused();
 }
 
 static void
diff --git a/src/venus/vkr_renderer.c b/src/venus/vkr_renderer.c
index f6f35a5a3cc676998c79e4545d2d639ec9f93c80..43a53314cb5a356fb32ca7db0160e7d3d2fd27d7 100644
--- a/src/venus/vkr_renderer.c
+++ b/src/venus/vkr_renderer.c
@@ -95,6 +95,15 @@ vkr_renderer_set_device_memory_pool(
    }
 }
 
+void
+vkr_renderer_device_memory_refused(void)
+{
+   const struct vkr_renderer_device_memory_pool *pool =
+      &vkr_state.device_memory_pool;
+   if (pool->limit && pool->refused)
+      pool->refused(pool->data);
+}
+
 uint64_t
 vkr_renderer_get_device_memory_limit(void)
 {
diff --git a/src/venus/vkr_renderer.h b/src/venus/vkr_renderer.h
index ea4b20863f5b82c4693338f130442f27ded1a1e5..fec7b631a2ff2d4c6c334c7f27b1321c295e059b 100644
--- a/src/venus/vkr_renderer.h
+++ b/src/venus/vkr_renderer.h
@@ -30,8 +30,16 @@ struct vkr_renderer_device_memory_pool {
    uint64_t (*usage)(void *data);
    bool (*reserve)(void *data, uint64_t size);
    void (*release)(void *data, uint64_t size);
+   /* optional */
+   void (*refused)(void *data);
 };
 
+/* A guest's vkAllocateMemory has been answered with
+ * VK_ERROR_OUT_OF_DEVICE_MEMORY.
+ */
+void
+vkr_renderer_device_memory_refused(void);
+
 /* A context's ring has failed, from the ring's thread, with no lock of the
  * context held. The context rejects every command from then on, and its
  * fences are not going to be retired by the work they follow.
diff --git a/src/virglrenderer.c b/src/virglrenderer.c
index b98aaf7a98bd46580f61c6a863e02811537ecb4d..d8d39d622bc4402bff8ba87cf379e3b6c666e6b0 100644
--- a/src/virglrenderer.c
+++ b/src/virglrenderer.c
@@ -1754,6 +1754,7 @@ virgl_renderer_set_device_memory_pool(
       .usage = pool->usage,
       .reserve = pool->reserve,
       .release = pool->release,
+      .refused = pool->refused,
    };
    vkr_renderer_set_device_memory_pool(&vkr_pool);
 #else
diff --git a/src/virglrenderer.h b/src/virglrenderer.h
index b40b64d76733f5b85ca507db5ec0da886b2e4035..2485d88aa2738ee898d2af798a2a37830df7402d 100644
--- a/src/virglrenderer.h
+++ b/src/virglrenderer.h
@@ -601,6 +601,11 @@ virgl_renderer_set_host_visible_aperture_size(uint64_t size);
  * exists, when `usage` counts it, or has failed. Consumers that reserve before
  * they allocate never together take the host past the limit. The callbacks
  * may be called from any thread, and must not call back into the renderer.
+ *
+ * `refused`, if set, is called once for each vkAllocateMemory of a Venus
+ * guest that failed with VK_ERROR_OUT_OF_DEVICE_MEMORY, after the pool had
+ * freed what it could and decided again, so the host can count the refusals
+ * its guest was answered with.
  */
 struct virgl_renderer_device_memory_pool {
    uint64_t limit;
@@ -608,6 +613,7 @@ struct virgl_renderer_device_memory_pool {
    uint64_t (*usage)(void *data);
    bool (*reserve)(void *data, uint64_t size);
    void (*release)(void *data, uint64_t size);
+   void (*refused)(void *data);
 };
 
 /*
