+/* The block a host image copy moves for one aspect of an image's format.  A
+ * depth or stencil aspect copies as the Depth/Stencil Aspect Copy Table says
+ * and a plane as its compatible format, in the plane's own texels.  Anything
+ * else these tables cannot state exactly, such as a combined aspect, is sized
+ * at 32 bytes a texel, more than any format holds.
+ */
+static struct vkr_texel_block
+vkr_host_copy_block(VkFormat format, VkImageAspectFlags aspect)
+{
+   const struct vkr_texel_block unknown = { 1, 1, 1, 32 };
+   bool depth_stencil = true;
+   uint32_t depth_size = 0;
+
+   switch (format) {
+   case VK_FORMAT_S8_UINT:
+      break;
+   case VK_FORMAT_D16_UNORM:
+   case VK_FORMAT_D16_UNORM_S8_UINT:
+      depth_size = 2;
+      break;
+   case VK_FORMAT_X8_D24_UNORM_PACK32:
+   case VK_FORMAT_D24_UNORM_S8_UINT:
+   case VK_FORMAT_D32_SFLOAT:
+   case VK_FORMAT_D32_SFLOAT_S8_UINT:
+      depth_size = 4;
+      break;
+   default:
+      depth_stencil = false;
+      break;
+   }
+
+   if (depth_stencil) {
+      if (aspect == VK_IMAGE_ASPECT_STENCIL_BIT && format != VK_FORMAT_D16_UNORM &&
+          format != VK_FORMAT_X8_D24_UNORM_PACK32 && format != VK_FORMAT_D32_SFLOAT)
+         return (struct vkr_texel_block){ 1, 1, 1, 1 };
+      if (aspect == VK_IMAGE_ASPECT_DEPTH_BIT && depth_size)
+         return (struct vkr_texel_block){ 1, 1, 1, depth_size };
+      return unknown;
+   }
