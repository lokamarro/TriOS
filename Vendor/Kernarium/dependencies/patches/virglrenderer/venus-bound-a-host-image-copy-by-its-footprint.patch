+   uint32_t plane;
+   switch (aspect) {
+   case VK_IMAGE_ASPECT_PLANE_0_BIT:
+      plane = 0;
+      break;
+   case VK_IMAGE_ASPECT_PLANE_1_BIT:
+      plane = 1;
+      break;
+   case VK_IMAGE_ASPECT_PLANE_2_BIT:
+      plane = 2;
+      break;
+   case VK_IMAGE_ASPECT_COLOR_BIT: {
+      struct vkr_texel_block block;
+      return vkr_format_texel_block(format, &block) ? block : unknown;
+   }
+   default:
+      return unknown;
+   }
