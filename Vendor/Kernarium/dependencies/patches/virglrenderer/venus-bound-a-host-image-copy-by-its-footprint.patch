+   const uint32_t available = image->array_layers - subresource->baseArrayLayer;
+   if (subresource->layerCount == VK_REMAINING_ARRAY_LAYERS) {
+      *count = available;
+      return true;
+   }
+   if (subresource->layerCount > available)
+      return false;
+   *count = subresource->layerCount;
+   return true;
