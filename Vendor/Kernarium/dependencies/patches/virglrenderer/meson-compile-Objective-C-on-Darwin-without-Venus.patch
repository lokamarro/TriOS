From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 3 Nov 2026 15:24:19 +0900
Subject: [PATCH] meson: compile Objective-C on Darwin without Venus

An Apple host names a foreign resource with a Metal object, and the
renderer's Objective-C helper, virgl_metal.m, is built on every Darwin host
that has the Metal framework. The Objective-C language and its project
arguments were enabled only for a Venus build, so a Darwin build without
Venus failed to configure: "No host machine compiler for
src/virgl_metal.m". Enable them for every Darwin host. A Venus build is
unchanged.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 meson.build | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/meson.build b/meson.build
index a3a7e0a8727916b2cb34e195584c193ea2a5573a..eadee665f738b0f76fc4cecd50917327ae8a9a5d 100644
--- a/meson.build
+++ b/meson.build
@@ -379,7 +379,7 @@ if with_render_server_worker == 'auto'
    with_render_server_worker = with_render_server
 endif
 render_server_install_dir = get_option('prefix') / get_option('libexecdir')
-if with_venus and with_host_darwin
+if with_host_darwin
    add_languages('objc', required: true)
    objcc = meson.get_compiler('objc')
    add_project_arguments(objcc.get_supported_arguments(warnings), language : 'objc')
@@ -544,7 +544,7 @@ configure_file(input : 'config.h.meson',
 
 add_project_arguments('-imacros', meson.current_build_dir() / 'config.h', language : 'c')
 add_project_arguments('-DHAVE_CONFIG_H=1', language : 'c')
-if with_venus and with_host_darwin
+if with_host_darwin
    add_project_arguments('-imacros', meson.current_build_dir() / 'config.h', language : 'objc')
    add_project_arguments('-DHAVE_CONFIG_H=1', language : 'objc')
 endif
