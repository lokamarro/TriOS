From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 13 Sep 2026 02:23:35 +0900
Subject: [PATCH] vrend: keep an integer result integer at an integer
 destination

A shader value lives in a float register, so vrend bit casts an integer
result into one before storing it, and a destination declared at an
integer type is stored through a constructor that converts rather than
reinterprets. The two together turn the bit pattern into its magnitude:
a textureGather on an integer sampler wrote
uvec4(uintBitsToFloat(textureGather(...))) into a pure-integer colour
attachment, and the attachment received the rounded value of a bit
pattern instead of the texels.

Where the destination is already an integer the result belongs there
unchanged, so the cast into a float register has to go and a float
result needs the cast out of one instead. Decide that once, in
get_destination_info(), for every instruction whose own type already
matches the destination, and apply the same rule in the emitters that
choose their own conversion: textures, image and buffer loads, image,
buffer and counter atomics, and the four bit-encoding builtins that
spell the cast themselves.

The texel fetch path needs the same care in the other direction. It
stages the sampler's result in a local so that an emulated swizzle can
be applied to it, and that local was spelled vec4 whatever the sampler
returned, which no longer compiles once an integer sampler reaches an
integer destination without a cast. The staging variable now takes the
sampler's own type, the swizzle constants follow it, and the store to
the destination carries the one conversion the destination needs.

The test that started this compared the destination against the scalar
INT alone, so every vector integer destination looked like a float one;
an atomic counter read into a pure-integer colour output went further
and emitted a float assignment to a uint variable, which failed to
compile and left the whole context in error.

A texture lookup carried the same mistake the other way round. A float
sampler left the conversion at none, so a TEX whose destination is a
pure-integer colour output emitted uvec4((texture(samp, coord))), and
the constructor rounded the sample instead of storing its bits: a
colour below one arrived as zero and a shadow comparison's 1.0 arrived
as the integer 1, which the reader sees as 1.4e-45. The lookups that
passed through a temporary were already correct, because the store out
of the float register spelled the cast. The sampler's return type now
decides the cast on its own and the integer destination adjusts it,
which covers texture, textureGather and the shadow and GLES texel
fetch forms alike.

The float arithmetic carried the mistake the third way round. Most
emitters store their result through dstconv(dtypeprefix(...)), which the
rule above already adjusts, but a handful spell their own conversion and
never consult dtypeprefix: LRP and the SQRT, DST, CMP and UCMP forms
name no conversion at all, and the DP2/DP3/DP4/DPH dot products, LIT,
EXP, LOG, SCS, RCP, RSQ, MAD, POW, XPD, I2F, U2F and the LOD query name
only the destination's constructor. A float result written straight to a
pure-integer colour attachment therefore arrived converted where it was
constructed and did not compile at all where it was not: an ES fragment
shader executor bit casts its float outputs into uvec attachments, so
out0 = mix(in0, in1, in2) on a vec2 emitted a vec2 assignment to a uvec2
variable, which failed to compile and dropped the draw, and
out0 = dot(in0, in1) emitted uvec4(dot(...)), so a dot product of 1.98
reached the reader as the integer 1, that is 1.4e-45. These emitters now
take the destination's own conversion too, which is nothing at all at a
float or double destination and the bit cast at an integer one. The
texture size and sample queries take it from the same place instead of
assuming a float register.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/vrend/vrend_shader.c | 248 ++++++++++++++++++++++++++++-----------
 1 file changed, 178 insertions(+), 70 deletions(-)

diff --git a/src/vrend/vrend_shader.c b/src/vrend/vrend_shader.c
index e6ff41abf9b8c66e91719ee3cae9daa39726193f..3f9b14eae5a6d9cb58fe37f9e0a8d0c4982382a9 100644
--- a/src/vrend/vrend_shader.c
+++ b/src/vrend/vrend_shader.c
@@ -481,6 +481,93 @@ static inline bool prefer_generic_io_block(const struct dump_ctx *ctx, enum io_t
    }
 }
 
+static inline bool type_qualifier_is_integer(enum vrend_type_qualifier key)
+{
+   switch (key) {
+   case INT:
+   case IVEC2:
+   case IVEC3:
+   case IVEC4:
+   case UINT:
+   case UVEC2:
+   case UVEC3:
+   case UVEC4:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static inline bool type_qualifier_is_signed_integer(enum vrend_type_qualifier key)
+{
+   switch (key) {
+   case INT:
+   case IVEC2:
+   case IVEC3:
+   case IVEC4:
+      return true;
+   default:
+      return false;
+   }
+}
+
+/* A destination register that is declared at an integer type stores the
+ * result itself, because the store is a constructor and not a
+ * reinterpretation: a value bit cast to float first would arrive converted.
+ * Drop the cast into a float register where the result is already an
+ * integer, and add the cast out of one where it is not. */
+static enum vrend_type_qualifier
+integer_dest_prefix(enum vrend_type_qualifier dtypeprefix, bool want_signed)
+{
+   switch (dtypeprefix) {
+   case UINT_BITS_TO_FLOAT:
+   case INT_BITS_TO_FLOAT:
+      return TYPE_CONVERSION_NONE;
+   case TYPE_CONVERSION_NONE:
+      return want_signed ? FLOAT_BITS_TO_INT : FLOAT_BITS_TO_UINT;
+   default:
+      return dtypeprefix;
+   }
+}
+
+/* The same question for an emitter that spells its own bit cast around an
+ * expression of a known type: the cast is what a float register needs, and an
+ * integer destination takes the expression as it stands. */
+static enum vrend_type_qualifier
+inner_conv_for_dest(const struct dest_info *dinfo,
+                    enum vrend_type_qualifier bits_to_float)
+{
+   return type_qualifier_is_integer(dinfo->dstconv) ? TYPE_CONVERSION_NONE
+                                                    : bits_to_float;
+}
+
+/* The conversion a texture, image, buffer or atomic-counter result needs on
+ * its way to this instruction's destination. A float register takes the bit
+ * cast the result's own type asks for; a destination declared at an integer
+ * type takes an integer result unchanged, and a float result through its own
+ * cast. */
+static enum vrend_type_qualifier
+result_conv_for_dest(const struct dest_info *dinfo,
+                     enum vrend_type_qualifier bits_to_float)
+{
+   if (!type_qualifier_is_integer(dinfo->dstconv))
+      return bits_to_float;
+   if (bits_to_float == TYPE_CONVERSION_NONE)
+      return type_qualifier_is_signed_integer(dinfo->dstconv) ? FLOAT_BITS_TO_INT
+                                                              : FLOAT_BITS_TO_UINT;
+   return dinfo->dstconv;
+}
+
+/* The conversion a float-valued expression needs on its way to this
+ * instruction's destination. A float register takes the expression as it
+ * stands; a destination declared at an integer type stores its bit pattern,
+ * because the destination is a constructor and would convert the value. */
+static enum vrend_type_qualifier
+float_conv_for_dest(const struct dest_info *dinfo)
+{
+   return result_conv_for_dest(dinfo, TYPE_CONVERSION_NONE);
+}
+
 static inline const char *get_string(enum vrend_type_qualifier key)
 {
    if (key >= ARRAY_SIZE(conversion_table)) {
@@ -2549,7 +2636,7 @@ static void emit_fog_fixup_write(const struct dump_ctx *ctx,
 #define emit_op1(op) emit_buff(&ctx->glsl_strbufs, "%s = %s(%s(%s(%s))%s);\n", dsts[0], get_string(dinfo.dstconv), get_string(dinfo.dtypeprefix), op, srcs[0], writemask)
 #define emit_compare(op) emit_buff(&ctx->glsl_strbufs, "%s = %s(%s((%s(%s(%s), %s(%s))))%s);\n", dsts[0], get_string(dinfo.dstconv), get_string(dinfo.dtypeprefix), op, get_string(sinfo.svec4), srcs[0], get_string(sinfo.svec4), srcs[1], writemask)
 
-#define emit_ucompare(op) emit_buff(&ctx->glsl_strbufs, "%s = %s(uintBitsToFloat(%s(%s(%s(%s), %s(%s))%s) * %s(0xffffffff)));\n", dsts[0], get_string(dinfo.dstconv), get_string(dinfo.udstconv), op, get_string(sinfo.svec4), srcs[0], get_string(sinfo.svec4), srcs[1], writemask, get_string(dinfo.udstconv))
+#define emit_ucompare(op) emit_buff(&ctx->glsl_strbufs, "%s = %s(%s(%s(%s(%s(%s), %s(%s))%s) * %s(0xffffffff)));\n", dsts[0], get_string(dinfo.dstconv), get_string(inner_conv_for_dest(&dinfo, UINT_BITS_TO_FLOAT)), get_string(dinfo.udstconv), op, get_string(sinfo.svec4), srcs[0], get_string(sinfo.svec4), srcs[1], writemask, get_string(dinfo.udstconv))
 
