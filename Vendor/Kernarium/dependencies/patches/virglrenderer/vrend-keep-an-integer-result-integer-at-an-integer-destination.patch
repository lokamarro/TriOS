@@ -3184,21 +3276,28 @@ static void translate_tex(struct dump_ctx *ctx,
 
    is_shad = samplertype_is_shadow(inst->Texture.Texture);
 
+   /* An integer sampler returns integers, and the destination only needs the
+    * bit cast to float when it is itself a float register. Casting the bits
+    * to float and then constructing an integer destination from that float
+    * is a numeric conversion, which loses the value. A float sampler reaching
+    * an integer destination needs the cast in the other direction for the
+    * same reason: the destination constructor would round the sample where it
+    * has to store the sample's bit pattern. */
    switch (ctx->samplers[sinfo->sreg_index].tgsi_sampler_return) {
    case TGSI_RETURN_TYPE_SINT:
-      /* if dstconv isn't an int */
-      if (dinfo->dstconv != INT)
-         dtypeprefix = INT_BITS_TO_FLOAT;
+      dtypeprefix = INT_BITS_TO_FLOAT;
       break;
    case TGSI_RETURN_TYPE_UINT:
-      /* if dstconv isn't an int */
-      if (dinfo->dstconv != INT)
-         dtypeprefix = UINT_BITS_TO_FLOAT;
+      dtypeprefix = UINT_BITS_TO_FLOAT;
       break;
    default:
       break;
    }
 
+   if (type_qualifier_is_integer(dinfo->dstconv))
+      dtypeprefix = integer_dest_prefix(
+         dtypeprefix, type_qualifier_is_signed_integer(dinfo->dstconv));
+
    switch (inst->Texture.Texture) {
    case TGSI_TEXTURE_1D:
    case TGSI_TEXTURE_BUFFER:
@@ -3509,20 +3608,35 @@ static void translate_tex(struct dump_ctx *ctx,
          /* To inject the swizzle for texturebufffers with emulated formats do
           *
           * {
