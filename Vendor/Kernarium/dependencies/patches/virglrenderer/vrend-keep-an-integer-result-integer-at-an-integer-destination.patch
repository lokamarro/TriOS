-          *    val = vec4(0/1/swizzle_x, ...);
-          *    dest.writemask = val.writemask;
+          *    <sampler type> val = texelFetch( )
+          *    val = <sampler type>(0/1/swizzle_x, ...);
+          *    dest.writemask = <destination conversion>(val).writemask;
           * }
           *
+          * The staging variable holds what the sampler returns, so that an
+          * integer sampler needs no cast to reach an integer destination and
+          * the swizzle constants stay at the type they are compared against.
           */
-         emit_buff(&ctx->glsl_strbufs, "{\n  vec4 val = %s(texelFetch%s(%s, %s(%s%s)%s%s));\n",
-                   get_string(dtypeprefix),
+         enum vrend_type_qualifier val_type = VEC4;
+         switch (ctx->samplers[sinfo->sreg_index].tgsi_sampler_return) {
+         case TGSI_RETURN_TYPE_SINT: val_type = IVEC4; break;
+         case TGSI_RETURN_TYPE_UINT: val_type = UVEC4; break;
+         default: break;
+         }
+         const char *const one = val_type == VEC4 ? "1.0" : "1";
+         const char *const zero = val_type == VEC4 ? "0.0" : "0";
+         const enum vrend_type_qualifier val_to_float =
+            val_type == IVEC4 ? INT_BITS_TO_FLOAT :
+            val_type == UVEC4 ? UINT_BITS_TO_FLOAT : TYPE_CONVERSION_NONE;
+
+         emit_buff(&ctx->glsl_strbufs, "{\n  %s val = texelFetch%s(%s, %s(%s%s)%s%s);\n",
+                   get_string(val_type),
                    tex_ext, srcs[sampler_index], get_string(txfi),
                    srcs[0], src_swizzle, bias, offset);
 
          if (vrend_shader_sampler_views_mask_get(ctx->key->sampler_views_lower_swizzle_mask, sinfo->sreg_index)) {
             int16_t  packed_swizzles = ctx->key->tex_swizzle[sinfo->sreg_index];
-            emit_buff(&ctx->glsl_strbufs,  "   val = vec4(");
+            emit_buff(&ctx->glsl_strbufs,  "   val = %s(", get_string(val_type));
 
             for (int i = 0; i < 4; ++i) {
                if (i > 0)
@@ -3530,20 +3644,8 @@ static void translate_tex(struct dump_ctx *ctx,
 
                int swz = (packed_swizzles >> (i * 3)) & 7;
                switch (swz) {
