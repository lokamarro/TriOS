From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 12 Sep 2026 23:35:56 +0900
Subject: [PATCH] vrend: type integer attachments and attributes on a core
 profile

A core profile has no fixed-function conversion between a float shader
value and a pure-integer vertex attribute or colour attachment, so a
shader that declares them as floats transfers undefined data.  vrend
already knows how to declare both at their real type, but only enables
it for two GL_VENDOR strings, so a Mesa host reads every pure-integer
attachment back as zero.

Enable it for a desktop core profile, and record SHADER_REQ_INTS where
the integer type is decided: an integer input or output is read and
written with a bit cast, and the bit-encoding builtins are not part of
every GLSL version vrend emits.  The fragment layer and viewport index
inputs are cast the same way and get the same requirement.
---
 src/vrend/vrend_renderer.c |  8 ++++++++
 src/vrend/vrend_shader.c   | 22 ++++++++++++++--------
 2 files changed, 22 insertions(+), 8 deletions(-)

diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 15aa830d39dcff2d6c71e7cdb22509e4ae5602a2..1916c2fc77038d0f31675de0cf39bb8223d9b3e4 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -7611,6 +7611,14 @@ static bool use_integer(void) {
    if (getenv("VIRGL_USE_INTEGER"))
       return true;
 
+   /* A core profile has no fixed-function path between a float shader value
+    * and a pure-integer vertex attribute or colour attachment, so the shader
+    * has to declare both at their real type or the transfer is undefined.
+    * A compatibility profile still converts, and the GLES path has its own
+    * rules, so restrict this to a desktop core profile. */
+   if (vrend_state.use_core_profile && !vrend_state.use_gles)
+      return true;
+
    const char * a = (const char *) glGetString(GL_VENDOR);
    if (!a)
        return false;
diff --git a/src/vrend/vrend_shader.c b/src/vrend/vrend_shader.c
index a834d298c568b189ee4ca18c1556bacce5171b47..e6ff41abf9b8c66e91719ee3cae9daa39726193f 100644
--- a/src/vrend/vrend_shader.c
+++ b/src/vrend/vrend_shader.c
@@ -1218,15 +1218,21 @@ static bool logiop_require_inout(const struct vrend_shader_key *key)
    }
 }
 
-static enum vec_type get_type(uint32_t signed_int_mask,
+/* An integer input or output is read and written with a bit cast, so the
+ * shader needs the bit-encoding builtins whatever GLSL version it ends up
+ * being emitted at. */
+static enum vec_type get_type(struct dump_ctx *ctx,
+                              uint32_t signed_int_mask,
                               uint32_t unsigned_int_mask,
                               int bit)
 {
-   if (signed_int_mask & (1 << bit))
+   if (signed_int_mask & (1 << bit)) {
+      ctx->shader_req_bits |= SHADER_REQ_INTS;
       return VEC_INT;
-   else if (unsigned_int_mask & (1 << bit))
+   } else if (unsigned_int_mask & (1 << bit)) {
+      ctx->shader_req_bits |= SHADER_REQ_INTS;
       return VEC_UINT;
-   else
+   } else
       return VEC_FLOAT;
 }
 
@@ -1339,7 +1345,7 @@ iter_declaration(struct tgsi_iterate_context *iter,
 
       if (iter->processor.Processor == TGSI_PROCESSOR_VERTEX) {
          ctx->attrib_input_mask |= (1 << decl->Range.First);
-         ctx->inputs[i].type = get_type(ctx->key->vs.attrib_signed_int_bitmask,
+         ctx->inputs[i].type = get_type(ctx, ctx->key->vs.attrib_signed_int_bitmask,
                                         ctx->key->vs.attrib_unsigned_int_bitmask,
                                         decl->Range.First);
       }
@@ -1471,7 +1477,7 @@ iter_declaration(struct tgsi_iterate_context *iter,
             ctx->inputs[i].type = VEC_INT;
             ctx->inputs[i].override_no_wm = true;
             name_prefix = "gl_ViewportIndex";
-            ctx->shader_req_bits |= SHADER_REQ_LAYER;
+            ctx->shader_req_bits |= SHADER_REQ_LAYER | SHADER_REQ_INTS;
             if (ctx->cfg->use_gles)
                ctx->shader_req_bits |= SHADER_REQ_VIEWPORT_IDX;
          }
@@ -1484,7 +1490,7 @@ iter_declaration(struct tgsi_iterate_context *iter,
             ctx->inputs[i].is_int = true;
             ctx->inputs[i].type = VEC_INT;
             ctx->inputs[i].override_no_wm = true;
-            ctx->shader_req_bits |= SHADER_REQ_LAYER;
+            ctx->shader_req_bits |= SHADER_REQ_LAYER | SHADER_REQ_INTS;
          }
          break;
       case TGSI_SEMANTIC_PSIZE:
@@ -1745,7 +1751,7 @@ iter_declaration(struct tgsi_iterate_context *iter,
          break;
       case TGSI_SEMANTIC_COLOR:
          if (iter->processor.Processor == TGSI_PROCESSOR_FRAGMENT) {
-            ctx->outputs[i].type = get_type(ctx->key->fs.cbufs_signed_int_bitmask,
+            ctx->outputs[i].type = get_type(ctx, ctx->key->fs.cbufs_signed_int_bitmask,
                                             ctx->key->fs.cbufs_unsigned_int_bitmask,
                                             ctx->outputs[i].sid);
             name_prefix = ctx->key->fs.logicop_enabled ? "fsout_tmp" : "fsout";
