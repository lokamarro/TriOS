From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 8 Nov 2026 12:37:18 +0900
Subject: [PATCH] venus: reach the driver's cache, import and freed-memory
 counts

KosmicKrisp now exports process-wide functions that release the
command storage its devices cache for reuse, report the host memory
they hold by import, report the device memory they have freed, and
wait for the pool to show room for the request a thread was refused.
The renderer links the driver library, so it is the one place the host
can reach them from.

vkr_renderer_release_cached_memory(),
vkr_renderer_get_imported_host_memory(),
vkr_renderer_get_freed_memory() and
vkr_renderer_wait_for_pool_headroom() wrap them for the rest of the
renderer. virgl_renderer_get_imported_host_memory() is the public form
of the second: the host subtracts it from Metal's allocation counter to
get the memory it made for the GPU, since Metal counts a no-copy import
at its full size. A renderer built without Venus has no Vulkan devices
and reports zero.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/venus/vkr_renderer.c | 24 ++++++++++++++++++++++++
 src/venus/vkr_renderer.h | 26 ++++++++++++++++++++++++++
 src/virglrenderer.c      | 11 +++++++++++
 src/virglrenderer.h      | 12 ++++++++++++
 4 files changed, 73 insertions(+)

diff --git a/src/venus/vkr_renderer.c b/src/venus/vkr_renderer.c
index 99dd8e298fbfa954910fd50229b634f76c04e2f9..f6f35a5a3cc676998c79e4545d2d639ec9f93c80 100644
--- a/src/venus/vkr_renderer.c
+++ b/src/venus/vkr_renderer.c
@@ -117,6 +117,30 @@ vkr_renderer_get_device_memory_headroom(void)
    return usage < limit ? limit - usage : 0;
 }
 
+uint64_t
+vkr_renderer_get_imported_host_memory(void)
+{
+   return kk_imported_host_memory_bytes();
+}
+
+uint64_t
+vkr_renderer_release_cached_memory(void)
+{
+   return kk_release_cached_memory();
+}
+
+uint64_t
+vkr_renderer_get_freed_memory(void)
+{
+   return kk_freed_memory_bytes();
+}
+
+bool
+vkr_renderer_wait_for_pool_headroom(uint32_t timeout_ms)
+{
+   return kk_wait_for_pool_headroom(timeout_ms);
+}
+
 bool
 vkr_renderer_device_memory_reserve(uint64_t size)
 {
diff --git a/src/venus/vkr_renderer.h b/src/venus/vkr_renderer.h
index f5867d07dc0233e71e33758b360de6bb4b4e8981..ea4b20863f5b82c4693338f130442f27ded1a1e5 100644
--- a/src/venus/vkr_renderer.h
+++ b/src/venus/vkr_renderer.h
@@ -67,6 +67,32 @@ vkr_renderer_get_device_memory_usage(void);
 uint64_t
 vkr_renderer_get_device_memory_headroom(void);
 
+/* The bytes of host memory the process's Vulkan devices hold by import, which
+ * the host's device-memory counter includes and the pool does not charge.
+ */
+uint64_t
+vkr_renderer_get_imported_host_memory(void);
+
+/* Frees what the process's Vulkan devices keep for reuse and no recording
+ * holds, and returns how many bytes that gave back. Takes no lock of a device.
+ */
+uint64_t
+vkr_renderer_release_cached_memory(void);
+
+/* The bytes of device memory the process's Vulkan devices have freed so far:
+ * heaps they made, never an import.
+ */
+uint64_t
+vkr_renderer_get_freed_memory(void);
+
+/* Waits until the pool has the room for the request it last refused the
+ * calling thread, or for timeout_ms. Memory freed counts in the host's
+ * allocation counter before it leaves the ledger the pool also counts.
+ * Returns true when the room is there or the thread was refused nothing.
+ */
+bool
+vkr_renderer_wait_for_pool_headroom(uint32_t timeout_ms);
+
 bool
 vkr_renderer_device_memory_reserve(uint64_t size);
 
diff --git a/src/virglrenderer.c b/src/virglrenderer.c
index 8f7cc928f1656969b6c6f6b50574678d9dc5e23d..0f5e0e951f2e242b1c614ee994a20f5f8360a551 100644
--- a/src/virglrenderer.c
+++ b/src/virglrenderer.c
@@ -1726,6 +1726,17 @@ virgl_renderer_set_device_memory_pool(
 #endif
 }
 
+uint64_t
+virgl_renderer_get_imported_host_memory(void)
+{
+   TRACE_FUNC();
+#ifdef ENABLE_VENUS
+   return vkr_renderer_get_imported_host_memory();
+#else
+   return 0;
+#endif
+}
+
 int
 virgl_renderer_export_fence(uint64_t client_fence_id, int *fd)
 {
diff --git a/src/virglrenderer.h b/src/virglrenderer.h
index 7ba357cacc684d0e1374542c56fe3454fe372eef..b40b64d76733f5b85ca507db5ec0da886b2e4035 100644
--- a/src/virglrenderer.h
+++ b/src/virglrenderer.h
@@ -628,6 +628,18 @@ VIRGL_EXPORT void
 virgl_renderer_set_device_memory_pool(
    const struct virgl_renderer_device_memory_pool *pool);
 
+/*
+ * The bytes of host memory the host's Vulkan devices hold by import: memory
+ * the renderer or the host's OpenGL driver lends them by address, such as the
+ * shared-memory segments a host-visible allocation or a pinned buffer maps for
+ * the guest. The host's device-memory counter includes an import at its full
+ * size, whatever backs it, while the pool charges the memory that is made for
+ * the GPU; a host that wants only that subtracts this figure from its counter.
+ * Zero where the renderer has no Vulkan devices.
+ */
+VIRGL_EXPORT uint64_t
+virgl_renderer_get_imported_host_memory(void);
+
 /* vtest semi-private APIs: */
 VIRGL_EXPORT int virgl_renderer_attach_fence(int ctx_id, int fence_fd);
 VIRGL_EXPORT int virgl_renderer_get_fence_fd(uint64_t fence_id);
