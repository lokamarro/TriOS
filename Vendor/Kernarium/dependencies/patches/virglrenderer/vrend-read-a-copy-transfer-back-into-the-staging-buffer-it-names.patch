From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 25 Oct 2026 07:20:14 +0900
Subject: [PATCH] vrend: read a copy transfer back into the staging buffer it
 names

Prototype (GPU-VIS): a READ_FROM_HOST copy transfer validated the
guest storage of the resource it reads instead of the staging buffer it
writes, so a guest could not read back a blob texture.
---
 src/vrend/vrend_decode.c | 24 ++++++++++++++++--------
 1 file changed, 16 insertions(+), 8 deletions(-)

diff --git a/src/vrend/vrend_decode.c b/src/vrend/vrend_decode.c
index a68f7d4e10b8bcc2b2ccc1d43451cbb85e3ba608..75b4a818376aadee69e98a799e1d1d1ba63b0c30 100644
--- a/src/vrend/vrend_decode.c
+++ b/src/vrend/vrend_decode.c
@@ -1510,16 +1510,23 @@ static int vrend_decode_transfer3d(struct vrend_context *ctx, const uint32_t *bu
                                       transfer_mode);
 }
 
-static int check_copy_transfer3d_handles(struct vrend_context *ctx, uint32_t src_handle,  uint32_t dst_handle,
-                                         struct vrend_resource *src_res, struct vrend_resource *dst_res)
-{
-   if (!src_res || !src_res->iov) {
-      vrend_report_context_error(ctx, VIRGL_ERROR_CTX_ILLEGAL_RESOURCE, src_handle);
+/* A copy transfer moves data between a resource and the guest storage of a
+ * staging buffer, in either direction. Only the staging buffer has to have
+ * guest storage: the resource it is copied to or from may be a blob, whose
+ * storage is the renderer's own.
+ */
+static int check_copy_transfer3d_handles(struct vrend_context *ctx,
+                                         uint32_t staging_handle, uint32_t res_handle,
+                                         struct vrend_resource *staging_res,
+                                         struct vrend_resource *res)
+{
+   if (!staging_res || !staging_res->iov) {
+      vrend_report_context_error(ctx, VIRGL_ERROR_CTX_ILLEGAL_RESOURCE, staging_handle);
       return EINVAL;
    }
 
-   if (!dst_res) {
-      vrend_report_context_error(ctx, VIRGL_ERROR_CTX_ILLEGAL_RESOURCE, dst_handle);
+   if (!res) {
+      vrend_report_context_error(ctx, VIRGL_ERROR_CTX_ILLEGAL_RESOURCE, res_handle);
       return EINVAL;
    }
    return 0;
@@ -1557,7 +1564,8 @@ static int vrend_decode_copy_transfer3d(struct vrend_context *ctx, const uint32_
       src_res = vrend_renderer_ctx_res_lookup(ctx, src_handle);
       dst_res = vrend_renderer_ctx_res_lookup(ctx, dst_handle);
 
-      int ret = check_copy_transfer3d_handles(ctx, src_handle, dst_handle, src_res, dst_res);
+      /* The staging buffer is the destination here. */
+      int ret = check_copy_transfer3d_handles(ctx, dst_handle, src_handle, dst_res, src_res);
       if (ret)
          return ret;
 
