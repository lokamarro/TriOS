From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 12 Sep 2026 12:41:23 +0900
Subject: [PATCH] vrend: back coherent buffers with shared host pages

A guest that asks for GL_ARB_buffer_storage needs host storage it can map
coherently. vrend allocated such buffers with glBufferStorage, whose pages
belong to the GL driver and cannot be exported to the guest, so the blob
export produced no file descriptor and the guest fell back to a version
without buffer storage.

Allocate the storage as shared host memory instead and pin it as the
buffer's storage through GL_AMD_pinned_memory, which a Zink host provider
implements over Vulkan external host memory. The same pages then back the
GPU's view and the guest's mapping, the blob exports as a shared-memory
descriptor the way a Venus blob does, and the host map short-circuits to
the existing mapping. A driver keeps the buffer alive past glDeleteBuffers
and may still have the pages in the GPU's address space, so the pages are
released behind a fence rather than at destroy time. Hosts without pinned
memory keep the previous storage paths.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/vrend/vrend_renderer.c | 171 ++++++++++++++++++++++++++++++++++++-
 src/vrend/vrend_renderer.h |   5 ++
 2 files changed, 174 insertions(+), 2 deletions(-)

diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 74129d804475167b34cbd98f7da5aa772b38b99c..85917e0d826f4cef991ff8ec0c2c74cf17da7fcb 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -41,6 +41,7 @@
 #include "util/ralloc.h"
 
 #include "util/u_thread.h"
+#include "util/os_file.h"
 #include "util/u_format.h"
 #include "tgsi/tgsi_dump.h"
 #include "tgsi/tgsi_parse.h"
@@ -55,6 +56,7 @@
 #include "vrend_blitter.h"
 #include "vrend_venus_interop.h"
 
+#include "virgl_host_memory.h"
 #include "virgl_util.h"
 
 #include "virgl_hw.h"
@@ -132,6 +134,7 @@ struct global_error_state {
 
 enum features_id
 {
+   feat_amd_pinned_memory,
    feat_arb_or_gles_ext_texture_buffer,
    feat_arb_robustness,
    feat_arb_buffer_storage,
@@ -245,6 +248,7 @@ static const  struct {
    const char *gl_ext[FEAT_MAX_EXTS];
    const char *log_name;
 } feature_list[] = {
+   FEAT(amd_pinned_memory, UNAVAIL, UNAVAIL, "GL_AMD_pinned_memory"),
    FEAT(arb_or_gles_ext_texture_buffer, 31, UNAVAIL, "GL_ARB_texture_buffer_object", "GL_EXT_texture_buffer", NULL),
    FEAT(arb_robustness, UNAVAIL, UNAVAIL,  "GL_ARB_robustness" ),
    FEAT(arb_buffer_storage, 44, UNAVAIL, "GL_ARB_buffer_storage", "GL_EXT_buffer_storage"),
@@ -443,6 +447,27 @@ static inline void clear_feature(enum features_id feature_id)
    vrend_state.features[slot] &= ~mask;
 }
 
+/* Pin host pages the caller allocated as a buffer object's storage through
+ * GL_AMD_pinned_memory; the caller checks feat_amd_pinned_memory. Returns
+ * false, having logged the GL error, when the driver refuses the pages. The
+ * buffer is unbound either way.
+ */
+static bool vrend_pin_host_pages(GLuint buffer, void *ptr, uint64_t size)
+{
+   while (glGetError() != GL_NO_ERROR)
+      ;
+   glBindBufferARB(GL_EXTERNAL_VIRTUAL_MEMORY_BUFFER_AMD, buffer);
+   glBufferData(GL_EXTERNAL_VIRTUAL_MEMORY_BUFFER_AMD, size, ptr, GL_DYNAMIC_DRAW);
+   const GLenum error = glGetError();
+   glBindBufferARB(GL_EXTERNAL_VIRTUAL_MEMORY_BUFFER_AMD, 0);
+   if (error == GL_NO_ERROR)
+      return true;
+
+   virgl_warn("Pinning %" PRIu64 " bytes of host memory failed with GL error %d\n",
+              size, error);
+   return false;
+}
+
 
 struct vrend_linked_shader_program {
    struct list_head head;
@@ -7501,6 +7526,12 @@ static enum virgl_resource_fd_type vrend_pipe_resource_export_fd(UNUSED struct p
                                                                  UNUSED int *fd,
                                                                  UNUSED void *data)
 {
+   struct vrend_resource *shm_res = (struct vrend_resource *)pres;
+   if (has_bit(shm_res->storage_bits, VREND_STORAGE_HOST_SHM)) {
+      *fd = os_dupfd_cloexec(shm_res->host_shm->fd);
+      return *fd >= 0 ? VIRGL_RESOURCE_FD_SHM : VIRGL_RESOURCE_FD_INVALID;
+   }
+
 #if defined(HAVE_EPOXY_EGL_H) && defined(ENABLE_GBM_ALLOCATION)
    struct vrend_resource *res = (struct vrend_resource *)pres;
 
@@ -7785,6 +7816,90 @@ fail:
    return EINVAL;
 }
 
+/* Pinned pages outlive the GL buffer they were pinned into: the driver keeps
+ * the buffer alive until every command that reads it has retired, and a
+ * driver that imported the pages into the GPU's address space faults if they
+ * are unmapped before then. Hold each retired allocation behind a fence.
+ */
+struct vrend_retired_shm {
+   struct list_head head;
+   struct virgl_host_shm *shm;
+   GLsync fence;
+};
+
+static struct list_head vrend_retired_shm_list;
+static bool vrend_retired_shm_ready;
+static unsigned vrend_retired_shm_count;
+static size_t vrend_retired_shm_bytes;
+
+/* A retired allocation stays resident on the host until its fence signals, so
+ * the wait list is a memory budget as much as a count. Both bounds are small
+ * enough that a guest churning coherent buffers cannot inflate the process.
+ */
+#define VREND_RETIRED_SHM_MAX_COUNT 64
+#define VREND_RETIRED_SHM_MAX_BYTES (64u * 1024u * 1024u)
+
+/* Release every retired allocation whose fence has signalled. With `force`,
+ * release all of them; the caller has already waited for the GPU to idle.
+ */
+static void vrend_drain_retired_shm(bool force)
+{
+   if (!vrend_retired_shm_ready)
+      return;
+
+   list_for_each_entry_safe(struct vrend_retired_shm, entry,
+                            &vrend_retired_shm_list, head) {
+      if (!force) {
+         /* Without the flush bit a fence that no later command flushed never
+          * signals, and the pages it guards are never handed back.
+          */
+         const GLenum status =
+            glClientWaitSync(entry->fence, GL_SYNC_FLUSH_COMMANDS_BIT, 0);
+         if (status != GL_ALREADY_SIGNALED && status != GL_CONDITION_SATISFIED)
+            continue;
+      }
+      list_del(&entry->head);
+      glDeleteSync(entry->fence);
+      vrend_retired_shm_bytes -= entry->shm->size;
+      virgl_host_shm_free(entry->shm);
+      free(entry);
+      vrend_retired_shm_count--;
+   }
+}
+
+static void vrend_retire_host_shm(struct virgl_host_shm *shm)
+{
+   if (!vrend_retired_shm_ready) {
+      list_inithead(&vrend_retired_shm_list);
+      vrend_retired_shm_ready = true;
+   }
+   vrend_drain_retired_shm(false);
+
+   struct vrend_retired_shm *entry = malloc(sizeof(*entry));
+   GLsync fence = entry ? glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0) : NULL;
+   if (!fence) {
+      free(entry);
+      glFinish();
+      virgl_host_shm_free(shm);
+      return;
+   }
+
+   entry->shm = shm;
+   entry->fence = fence;
+   list_addtail(&entry->head, &vrend_retired_shm_list);
+   vrend_retired_shm_count++;
+   vrend_retired_shm_bytes += shm->size;
+
+   /* A guest that churns coherent buffers must not accumulate host mappings
+    * faster than the fences retire them.
+    */
+   if (vrend_retired_shm_count > VREND_RETIRED_SHM_MAX_COUNT ||
+       vrend_retired_shm_bytes > VREND_RETIRED_SHM_MAX_BYTES) {
+      glFinish();
+      vrend_drain_retired_shm(true);
+   }
+}
+
 void
 vrend_renderer_fini(void)
 {
@@ -7806,6 +7921,11 @@ vrend_renderer_fini(void)
 
    vrend_destroy_context(vrend_state.ctx0);
 
+   if (vrend_retired_shm_ready) {
+      glFinish();
+      vrend_drain_retired_shm(true);
+   }
+
    vrend_state.current_ctx = NULL;
    vrend_state.current_hw_ctx = NULL;
 
@@ -8295,6 +8415,37 @@ static int check_resource_valid(const struct vrend_renderer_resource_create_args
    return 0;
 }
 
+/* Pin shared host pages as a buffer's storage so the guest can map the very
+ * memory the GPU reads. GL_AMD_pinned_memory is the only GL entry point that
+ * takes host pages the caller allocated; a driver that implements it over
+ * Vulkan external host memory (Zink does) keeps the mapping coherent on a
+ * unified-memory host. Returns false when the host cannot pin memory, leaving
+ * the ordinary storage paths to allocate the buffer.
+ */
+static bool vrend_create_pinned_buffer_storage(struct vrend_resource *gr,
+                                               uint32_t width)
+{
+   if (!has_feature(feat_amd_pinned_memory) || vrend_state.use_external_blob)
+      return false;
+
+   vrend_drain_retired_shm(false);
+
+   struct virgl_host_shm *shm = virgl_host_shm_alloc(width, 0);
+   if (!shm)
+      return false;
+
+   if (!vrend_pin_host_pages(gr->gl_id, shm->ptr, shm->size)) {
+      virgl_host_shm_free(shm);
+      return false;
+   }
+
+   gr->host_shm = shm;
+   gr->storage_bits |= VREND_STORAGE_HOST_SHM;
+   /* The pages are ordinary cached host memory on both sides of the map. */
+   gr->map_info = VIRGL_RENDERER_MAP_CACHE_CACHED;
+   return true;
+}
+
 static void vrend_create_buffer(struct vrend_resource *gr, uint32_t width, uint32_t flags)
 {
 
@@ -8317,7 +8468,9 @@ static void vrend_create_buffer(struct vrend_resource *gr, uint32_t width, uint3
    glBindBufferARB(gr->target, gr->gl_id);
 
    if (buffer_storage_flags) {
-      if (has_feature(feat_arb_buffer_storage) && !vrend_state.use_external_blob) {
+      if (vrend_create_pinned_buffer_storage(gr, width)) {
+         /* storage is the shared host mapping the guest will see */
+      } else if (has_feature(feat_arb_buffer_storage) && !vrend_state.use_external_blob) {
          glBufferStorage(gr->target, width, NULL, buffer_storage_flags);
          gr->map_info = vrend_state.inferred_gl_caching_type;
       }
@@ -8355,7 +8508,9 @@ static void vrend_create_buffer(struct vrend_resource *gr, uint32_t width, uint3
          return;
       }
 
-      gr->storage_bits |= VREND_STORAGE_GL_IMMUTABLE;
+      /* Pinned host pages are ordinary mutable buffer storage. */
+      if (!has_bit(gr->storage_bits, VREND_STORAGE_HOST_SHM))
+         gr->storage_bits |= VREND_STORAGE_GL_IMMUTABLE;
       gr->buffer_storage_flags = buffer_storage_flags;
       gr->size = width;
    } else
@@ -8941,6 +9096,9 @@ void vrend_renderer_resource_destroy(struct vrend_resource *res)
       glDeleteMemoryObjectsEXT(1, &res->memobj);
    }
 
+   if (res->host_shm)
+      vrend_retire_host_shm(res->host_shm);
+
 #ifdef ENABLE_GBM
    if (res->egl_image) {
       virgl_egl_image_destroy(egl, res->egl_image);
@@ -13563,6 +13721,12 @@ uint32_t vrend_renderer_resource_get_map_info(struct pipe_resource *pres)
 int vrend_renderer_resource_map(struct pipe_resource *pres, void **map, uint64_t *out_size)
 {
    struct vrend_resource *res = (struct vrend_resource *)pres;
+   if (has_bit(res->storage_bits, VREND_STORAGE_HOST_SHM)) {
+      *map = res->host_shm->ptr;
+      *out_size = res->host_shm->size;
+      return 0;
+   }
+
    if (!has_bits(res->storage_bits, VREND_STORAGE_GL_BUFFER | VREND_STORAGE_GL_IMMUTABLE))
       return -EINVAL;
 
@@ -13579,6 +13743,9 @@ int vrend_renderer_resource_map(struct pipe_resource *pres, void **map, uint64_t
 int vrend_renderer_resource_unmap(struct pipe_resource *pres)
 {
    struct vrend_resource *res = (struct vrend_resource *)pres;
+   if (has_bit(res->storage_bits, VREND_STORAGE_HOST_SHM))
+      return 0;
+
    if (!has_bits(res->storage_bits, VREND_STORAGE_GL_BUFFER | VREND_STORAGE_GL_IMMUTABLE))
       return -EINVAL;
 
diff --git a/src/vrend/vrend_renderer.h b/src/vrend/vrend_renderer.h
index 8b59c2f7cdd5954fbaaf8e703213e93a6f4a7495..ba4a0a054d84657f67aa351318e3bfe0055d1e71 100644
--- a/src/vrend/vrend_renderer.h
+++ b/src/vrend/vrend_renderer.h
@@ -61,6 +61,7 @@ struct virgl_gl_ctx_param {
 };
 
 struct virgl_context;
+struct virgl_host_shm;
 struct virgl_resource;
 struct vrend_context;
 
@@ -78,6 +79,8 @@ struct vrend_context;
 #define VREND_STORAGE_GL_IMMUTABLE       BIT(6)
 #define VREND_STORAGE_GL_MEMOBJ          BIT(7)
 #define VREND_STORAGE_D3D_TEXTURE        BIT(8)
+/* Host pages shared with the guest, pinned as this buffer's storage. */
+#define VREND_STORAGE_HOST_SHM           BIT(9)
 
 struct vrend_resource {
    struct pipe_resource base;
@@ -112,6 +115,8 @@ struct vrend_resource {
    uint64_t size;
    GLbitfield buffer_storage_flags;
    GLuint memobj;
+   /* Shared host pages pinned as this buffer's storage, or NULL. */
+   struct virgl_host_shm *host_shm;
 
    uint32_t blob_id;
    struct list_head head;
