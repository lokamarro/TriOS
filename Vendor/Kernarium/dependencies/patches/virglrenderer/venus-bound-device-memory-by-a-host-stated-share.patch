 vkr_renderer_init(uint32_t flags, const struct vkr_renderer_callbacks *cbs);
 
diff --git a/src/virglrenderer.c b/src/virglrenderer.c
index ca3112d47446e92822fe248dac57e3741aac4a42..f6b570dbcccfaba5bc963e4b43c94aeaedae6e43 100644
--- a/src/virglrenderer.c
+++ b/src/virglrenderer.c
@@ -1672,6 +1672,29 @@ virgl_renderer_set_host_visible_aperture_size(uint64_t size)
 #endif
 }
 
+void
+virgl_renderer_set_device_memory_pool(
+   const struct virgl_renderer_device_memory_pool *pool)
+{
+   TRACE_FUNC();
+#ifdef ENABLE_VENUS
+   if (!pool || !pool->limit) {
+      vkr_renderer_set_device_memory_pool(NULL);
+      return;
+   }
+   const struct vkr_renderer_device_memory_pool vkr_pool = {
+      .limit = pool->limit,
+      .data = pool->data,
+      .usage = pool->usage,
+      .reserve = pool->reserve,
+      .release = pool->release,
+   };
+   vkr_renderer_set_device_memory_pool(&vkr_pool);
+#else
+   (void)pool;
+#endif
+}
