diff --git a/src/venus/vkr_device.c b/src/venus/vkr_device.c
index 9343e4d77c5433eff6aeca41c135622bed6ac74f..c4f4abd5ef8fbdb387c0157711b2b2b7f3afe134 100644
--- a/src/venus/vkr_device.c
+++ b/src/venus/vkr_device.c
@@ -5,6 +5,8 @@
 
 #include "vkr_device.h"
 
+#include <kosmickrisp/kk_device_memory_pool.h>
+
 #include <vn_protocol_renderer_device.h>
 
 #include "vkr_command_buffer.h"
@@ -118,6 +120,24 @@ vkr_device_init_renderer_procs(struct vkr_device *dev)
    return true;
 }
 
+static VkBool32 VKAPI_PTR
+vkr_device_memory_pool_reserve(UNUSED void *data, VkDeviceSize size)
+{
+   return vkr_renderer_device_memory_reserve(size);
+}
+
+static void VKAPI_PTR
+vkr_device_memory_pool_release(UNUSED void *data, VkDeviceSize size)
+{
+   vkr_renderer_device_memory_release(size);
+}
+
+static VkDeviceSize VKAPI_PTR
+vkr_device_memory_pool_headroom(UNUSED void *data)
+{
+   return vkr_renderer_get_device_memory_headroom();
+}
+
 static void
 vkr_dispatch_vkCreateDevice(struct vn_dispatch_context *dispatch,
                             struct vn_command_vkCreateDevice *args)
@@ -217,8 +237,26 @@ vkr_dispatch_vkCreateDevice(struct vn_dispatch_context *dispatch,
    }
 
    vn_replace_vkCreateDevice_args_handle(args);
+
+   /* The driver charges the memory it allocates for itself, which no guest
+    * allocation accounts for, to the pool the guest's allocations are
+    * charged to. The guest cannot name this structure: the protocol decoder
+    * rejects a chain member it does not know.
+    */
+   VkDeviceCreateInfo *create_info = (VkDeviceCreateInfo *)args->pCreateInfo;
+   const void *guest_next = create_info->pNext;
+   VkDeviceMemoryPoolCreateInfoKK pool_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_MEMORY_POOL_CREATE_INFO_KK,
+      .pNext = guest_next,
+      .pfnReserve = vkr_device_memory_pool_reserve,
+      .pfnRelease = vkr_device_memory_pool_release,
+      .pfnHeadroom = vkr_device_memory_pool_headroom,
+   };
+   if (vkr_renderer_get_device_memory_limit())
+      create_info->pNext = &pool_info;
    args->ret = vk->CreateDevice(args->physicalDevice, args->pCreateInfo, NULL,
                                 &dev->base.handle.device);
+   create_info->pNext = guest_next;
    if (args->ret != VK_SUCCESS) {
       free(exts);
       free(dev);
diff --git a/src/venus/vkr_device_memory.c b/src/venus/vkr_device_memory.c
index 770b47170b9facfc2f623c2579a113422585fe0e..4b6f407f9aee49907648c125b0c354d0a174a6dd 100644
--- a/src/venus/vkr_device_memory.c
+++ b/src/venus/vkr_device_memory.c
@@ -239,10 +239,9 @@ vkr_gbm_get_fd_info_from_allocation_info(UNUSED struct vkr_physical_device *phys
 #endif /* ENABLE_GBM_ALLOCATION */
 
 static void
-vkr_dispatch_vkAllocateMemory(struct vn_dispatch_context *dispatch,
-                              struct vn_command_vkAllocateMemory *args)
+vkr_device_memory_allocate(struct vn_dispatch_context *dispatch,
+                           struct vn_command_vkAllocateMemory *args)
 {
-   TRACE_FUNC();
    struct vkr_context *ctx = dispatch->data;
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vkr_physical_device *physical_dev = dev->physical_device;
@@ -561,6 +560,33 @@ vkr_dispatch_vkAllocateMemory(struct vn_dispatch_context *dispatch,
    mem->memory_type_index = host_mem_type_index;
 }
 
+/* A new allocation has to fit the device memory the host granted the guest,
+ * so it is reserved from the host's pool while the driver makes it, and the
+ * reservation is released once the driver has made it, when the pool's usage
+ * counts it, or has failed. Allocations the renderer admits concurrently, and
+ * those the driver makes for itself, therefore never pass the limit together.
+ * An import names memory that already exists, so it is not charged twice.
+ */
+static void
+vkr_dispatch_vkAllocateMemory(struct vn_dispatch_context *dispatch,
+                              struct vn_command_vkAllocateMemory *args)
+{
+   TRACE_FUNC();
+   const VkMemoryAllocateInfo *alloc_info = args->pAllocateInfo;
+   const bool charged = !vkr_find_struct(
+      alloc_info->pNext, VK_STRUCTURE_TYPE_IMPORT_MEMORY_RESOURCE_INFO_MESA);
+   const VkDeviceSize size = alloc_info->allocationSize;
+   if (charged && !vkr_renderer_device_memory_reserve(size)) {
+      args->ret = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+      return;
+   }
+
+   vkr_device_memory_allocate(dispatch, args);
+
+   if (charged)
+      vkr_renderer_device_memory_release(size);
+}
+
 static void
 vkr_dispatch_vkFreeMemory(struct vn_dispatch_context *dispatch,
                           struct vn_command_vkFreeMemory *args)
diff --git a/src/venus/vkr_physical_device.c b/src/venus/vkr_physical_device.c
index f449011fc7037b8dcc12394128f7b5b8ddf5f19a..6e955e3075f42379d30538ed712cd7b3d1934fcc 100644
--- a/src/venus/vkr_physical_device.c
+++ b/src/venus/vkr_physical_device.c
@@ -256,6 +256,20 @@ vkr_physical_device_init_memory_properties(struct vkr_physical_device *physical_
       }
    }
 
+   /* The host grants the guest's GPU a share of memory rather than the whole
+    * device. A guest sizes its allocations from the heaps it is shown, so no
+    * heap may promise more than that share.
+    */
+   const uint64_t device_memory_limit = vkr_renderer_get_device_memory_limit();
+   if (device_memory_limit) {
+      VkPhysicalDeviceMemoryProperties *props = &physical_dev->memory_properties;
+      for (uint32_t i = 0; i < props->memoryHeapCount; i++) {
+         if (props->memoryHeaps[i].size > device_memory_limit)
+            props->memoryHeaps[i].size = device_memory_limit;
+      }
+      physical_dev->bounded_device_memory = true;
+   }
+
    /* XXX When a VkMemoryType has VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT, we
     * assume any VkDeviceMemory with the memory type can be made external and
     * be exportable.  That is incorrect but is what we have to live with with
@@ -847,13 +861,16 @@ vkr_dispatch_vkGetPhysicalDeviceQueueFamilyProperties2(
 
 /* A budget the host reported is indexed by its own heaps. Where the guest sees
  * an extra heap that names the blob aperture, that heap's budget and usage are
- * the host heap's, bounded by the aperture the guest was promised.
+ * the host heap's, bounded by the aperture the guest was promised. Where the
+ * host bounds the guest's device memory, a heap's budget is also no more than
+ * its usage plus what the bound has left.
  */
 static void
 vkr_physical_device_map_memory_budget(
    const struct vkr_physical_device *physical_dev, void *pnext)
 {
-   if (!physical_dev->bounded_host_visible_heap)
+   if (!physical_dev->bounded_host_visible_heap &&
+       !physical_dev->bounded_device_memory)
       return;
 
    VkPhysicalDeviceMemoryBudgetPropertiesEXT *budget = vkr_find_struct(
@@ -868,12 +885,22 @@ vkr_physical_device_map_memory_budget(
    memcpy(heap_budget, budget->heapBudget, sizeof(heap_budget));
    memcpy(heap_usage, budget->heapUsage, sizeof(heap_usage));
 
+   VkDeviceSize remaining = UINT64_MAX;
+   if (physical_dev->bounded_device_memory) {
+      const uint64_t limit = vkr_renderer_get_device_memory_limit();
+      const uint64_t usage = vkr_renderer_get_device_memory_usage();
+      remaining = usage < limit ? limit - usage : 0;
+   }
+
    for (uint32_t i = 0; i < props->memoryHeapCount; i++) {
       const uint32_t host_index = physical_dev->memory_heap_guest_to_host[i];
       const VkDeviceSize size = props->memoryHeaps[i].size;
-      budget->heapBudget[i] =
-         MIN2(heap_budget[host_index], size);
-      budget->heapUsage[i] = MIN2(heap_usage[host_index], size);
+      const VkDeviceSize usage = MIN2(heap_usage[host_index], size);
+      VkDeviceSize heap_budget_left = MIN2(heap_budget[host_index], size);
+      if (remaining != UINT64_MAX && usage + remaining < heap_budget_left)
+         heap_budget_left = usage + remaining;
+      budget->heapBudget[i] = heap_budget_left;
+      budget->heapUsage[i] = usage;
    }
    for (uint32_t i = props->memoryHeapCount; i < VK_MAX_MEMORY_HEAPS; i++) {
       budget->heapBudget[i] = 0;
diff --git a/src/venus/vkr_physical_device.h b/src/venus/vkr_physical_device.h
index 0b101fb6fae1859e44108b9c8f3ccadfdd549160..a9c919d094a8c7f14b218a78222816dec10123ec 100644
--- a/src/venus/vkr_physical_device.h
+++ b/src/venus/vkr_physical_device.h
@@ -41,6 +41,8 @@ struct vkr_physical_device {
    bool separate_external_host_memory;
    /* set when the host-visible type was given its own aperture-sized heap */
    bool bounded_host_visible_heap;
+   /* set when the host bounds the device memory the guest may allocate */
+   bool bounded_device_memory;
    VkPhysicalDeviceIDProperties id_properties;
    bool is_dma_buf_fd_export_supported;
    bool is_opaque_fd_export_supported;
diff --git a/src/venus/vkr_renderer.c b/src/venus/vkr_renderer.c
index 47ef6c053c8c70e1e1a04ed2f1e246e6ad48f48f..e6ca2dc0026df3ace1f0a1ff9cf3c2d7d80aeab1 100644
--- a/src/venus/vkr_renderer.c
+++ b/src/venus/vkr_renderer.c
@@ -21,6 +21,11 @@ struct vkr_renderer_state {
     * guest at once, or zero when it has no such bound
     */
    uint64_t host_visible_aperture_size;
+
+   /* the pool the host charges the guest's device memory to, whose limit is
+    * zero when it sets no bound
+    */
+   struct vkr_renderer_device_memory_pool device_memory_pool;
 };
 
 struct vkr_renderer_state vkr_state;
@@ -40,6 +45,59 @@ vkr_renderer_get_host_visible_aperture_size(void)
    return vkr_state.host_visible_aperture_size;
 }
 
+/* Set before vkr_renderer_init, like the aperture: the share of memory the
+ * host grants the guest's GPU is a property of the host.
+ */
+void
+vkr_renderer_set_device_memory_pool(
+   const struct vkr_renderer_device_memory_pool *pool)
+{
+   if (pool && pool->limit && pool->usage && pool->reserve && pool->release)
+      vkr_state.device_memory_pool = *pool;
+   else
+      memset(&vkr_state.device_memory_pool, 0,
+             sizeof(vkr_state.device_memory_pool));
+}
+
+uint64_t
+vkr_renderer_get_device_memory_limit(void)
+{
+   return vkr_state.device_memory_pool.limit;
+}
+
+uint64_t
+vkr_renderer_get_device_memory_usage(void)
+{
+   const struct vkr_renderer_device_memory_pool *pool =
+      &vkr_state.device_memory_pool;
+   return pool->limit ? pool->usage(pool->data) : 0;
+}
+
+uint64_t
+vkr_renderer_get_device_memory_headroom(void)
+{
+   const uint64_t limit = vkr_state.device_memory_pool.limit;
+   const uint64_t usage = vkr_renderer_get_device_memory_usage();
+   return usage < limit ? limit - usage : 0;
+}
+
+bool
+vkr_renderer_device_memory_reserve(uint64_t size)
+{
+   const struct vkr_renderer_device_memory_pool *pool =
+      &vkr_state.device_memory_pool;
+   return !pool->limit || pool->reserve(pool->data, size);
+}
+
+void
+vkr_renderer_device_memory_release(uint64_t size)
+{
+   const struct vkr_renderer_device_memory_pool *pool =
+      &vkr_state.device_memory_pool;
+   if (pool->limit)
+      pool->release(pool->data, size);
+}
+
 size_t
 vkr_get_capset(void *capset, uint32_t flags)
