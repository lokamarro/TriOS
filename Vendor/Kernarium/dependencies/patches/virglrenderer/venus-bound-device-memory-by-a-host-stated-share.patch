 int
 virgl_renderer_export_fence(uint64_t client_fence_id, int *fd)
 {
diff --git a/src/virglrenderer.h b/src/virglrenderer.h
index 1b14cb00936cade3c1541248722de5c0a0356424..88372ec8bc0b688810895001081f6d9d20bd5ff4 100644
--- a/src/virglrenderer.h
+++ b/src/virglrenderer.h
@@ -580,6 +580,40 @@ virgl_renderer_release_handle_for_scanout(enum virgl_renderer_native_handle_type
 VIRGL_EXPORT void
 virgl_renderer_set_host_visible_aperture_size(uint64_t size);
 
+/*
+ * The host's account of the device memory a Venus guest may allocate: a limit
+ * in bytes and the callbacks of the pool every consumer of that memory
+ * charges. `usage` reports how many bytes are allocated or reserved now,
+ * across every consumer. `reserve` charges `size` bytes to the pool before
+ * they are allocated, or returns false and charges nothing when the pool
+ * cannot hold them, and `release` returns a reservation once its allocation
+ * exists, when `usage` counts it, or has failed. Consumers that reserve before
+ * they allocate never together take the host past the limit. The callbacks
+ * may be called from any thread, and must not call back into the renderer.
+ */
+struct virgl_renderer_device_memory_pool {
+   uint64_t limit;
+   void *data;
+   uint64_t (*usage)(void *data);
+   bool (*reserve)(void *data, uint64_t size);
+   void (*release)(void *data, uint64_t size);
+};
+
+/*
+ * Bound the device memory a Venus guest may allocate by `pool`, or pass NULL
+ * or a zero limit for no bound. Every memory heap the guest is shown is at
+ * most the limit, memory budgets leave the guest only what the pool has left,
+ * and a new allocation the pool cannot reserve fails with
+ * VK_ERROR_OUT_OF_DEVICE_MEMORY. An import names memory that already exists
+ * and is not charged. Every device the renderer creates for a guest charges
+ * the memory it allocates for itself to the same pool. The structure is
+ * copied, and `data` must outlive the renderer. Call this before
+ * `virgl_renderer_init`.
+ */
+VIRGL_EXPORT void
+virgl_renderer_set_device_memory_pool(
+   const struct virgl_renderer_device_memory_pool *pool);
+
 /* vtest semi-private APIs: */
 VIRGL_EXPORT int virgl_renderer_attach_fence(int ctx_id, int fence_fd);
 VIRGL_EXPORT int virgl_renderer_get_fence_fd(uint64_t fence_id);
