index a356ebfc6dc9ce5cd01b8eb790026b12da5fc1e3..a64db1f52ab3af3c4092310aab1dc65187e1d83a 100644
--- a/src/venus/vkr_pipeline.h
+++ b/src/venus/vkr_pipeline.h
@@ -28,6 +28,13 @@ struct vkr_pipeline {
 };
 VKR_DEFINE_OBJECT_CAST(pipeline, VK_OBJECT_TYPE_PIPELINE, VkPipeline)
 
+struct vkr_pipeline_binary {
+   struct vkr_object base;
+};
+VKR_DEFINE_OBJECT_CAST(pipeline_binary,
+                       VK_OBJECT_TYPE_PIPELINE_BINARY_KHR,
+                       VkPipelineBinaryKHR)
+
 void
 vkr_context_init_shader_module_dispatch(struct vkr_context *ctx);
 
@@ -40,4 +47,7 @@ vkr_context_init_pipeline_cache_dispatch(struct vkr_context *ctx);
 void
 vkr_context_init_pipeline_dispatch(struct vkr_context *ctx);
 
+void
+vkr_context_init_pipeline_binary_dispatch(struct vkr_context *ctx);
+
 #endif /* VKR_PIPELINE_H */
