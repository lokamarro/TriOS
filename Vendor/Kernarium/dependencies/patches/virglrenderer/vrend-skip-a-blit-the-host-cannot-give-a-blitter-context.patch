From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 27 Sep 2026 14:49:46 +0900
Subject: [PATCH] vrend: skip a blit the host cannot give a blitter context

The blitter creates the one GL context it shares across guest contexts
on the first blit that needs it, and aborted the process when the host
could not create it. A host whose GL stack has run out of contexts now
costs that blit, with an error: the blitter stays uninitialised, so the
next blit asks for the context again, and its program table is created
only once the context exists.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/vrend/vrend_blitter.c | 17 +++++++++++------
 1 file changed, 11 insertions(+), 6 deletions(-)

diff --git a/src/vrend/vrend_blitter.c b/src/vrend/vrend_blitter.c
index eed56e4d61c7655ae54d0610019d08d9c95ba486..2afbdd6b042adcfaaee9dda67e7140cf85a8fa3a 100644
--- a/src/vrend/vrend_blitter.c
+++ b/src/vrend/vrend_blitter.c
@@ -453,17 +453,19 @@ static GLuint blit_get_frag_tex_col(struct vrend_blitter_ctx *blit_ctx,
    return prog_id;
 }
 
-static void vrend_renderer_init_blit_ctx(struct vrend_blitter_ctx *blit_ctx)
+/* The blitter shares one host GL context across every guest context and
+ * creates it on the first blit that needs it. A host that cannot create it
+ * costs that blit, not the process: the next blit asks again.
+ */
+static bool vrend_renderer_init_blit_ctx(struct vrend_blitter_ctx *blit_ctx)
 {
    struct virgl_gl_ctx_param ctx_params;
    int i;
    if (blit_ctx->initialised) {
       vrend_sync_make_current(blit_ctx->gl_context);
-      return;
+      return true;
    }
 
-   vrend_blit_ctx.blit_programs = _mesa_hash_table_u64_create(NULL);
-
    blit_ctx->use_gles = epoxy_is_desktop_gl() == 0;
    ctx_params.shared = true;
    ctx_params.compat_ctx = false;
@@ -478,9 +480,10 @@ static void vrend_renderer_init_blit_ctx(struct vrend_blitter_ctx *blit_ctx)
 
    if (!blit_ctx->gl_context) {
       virgl_error("virglrenderer: Unable to create blit context\n");
-      abort();
+      return false;
    }
 
+   blit_ctx->blit_programs = _mesa_hash_table_u64_create(NULL);
    vrend_sync_make_current(blit_ctx->gl_context);
    glGenVertexArrays(1, &blit_ctx->vaoid);
    glGenFramebuffers(1, &blit_ctx->fb_id);
@@ -501,6 +504,7 @@ static void vrend_renderer_init_blit_ctx(struct vrend_blitter_ctx *blit_ctx)
       glEnable(GL_FRAMEBUFFER_SRGB);
 
    blit_ctx->initialised = true;
+   return true;
 }
 
 static void blitter_set_rectangle(struct vrend_blitter_ctx *blit_ctx,
@@ -805,7 +809,8 @@ void vrend_renderer_blit_gl(ASSERTED struct vrend_context *ctx,
          util_format_has_depth(dst_desc) &&
          (info->b.mask & PIPE_MASK_Z);
 
-   vrend_renderer_init_blit_ctx(blit_ctx);
+   if (!vrend_renderer_init_blit_ctx(blit_ctx))
+      return;
    blitter_set_points(blit_ctx, &info->b, src_res, dst_res, &src0, &src1);
 
    GLuint prog_id;
