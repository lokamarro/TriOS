    return grctx;
 }
 
+/* The layout of the picture a packed YUV resource holds, from the arguments
+ * that create it. The image is as wide as a luma row and as tall as the luma
+ * rows and the chroma rows together, which is what fixes the picture's
+ * height; the width in pixels comes with the flags because a luma row may be
+ * padded. Anything that does not describe one picture is refused. */
+static int vrend_packed_yuv_describe(const struct vrend_renderer_resource_create_args *args,
+                                     struct vrend_packed_yuv *yuv,
+                                     char errmsg[256])
+{
+   const uint32_t layouts = VIRGL_RESOURCE_FLAG_YUV_BIPLANAR |
+                            VIRGL_RESOURCE_FLAG_YUV_TRIPLANAR;
+   const uint32_t layout = args->flags & layouts;
+   const uint32_t width = args->flags >> VIRGL_RESOURCE_YUV_WIDTH_SHIFT;
+   const uint32_t stride = args->width;
+   const uint32_t rows = args->height;
+   const uint32_t height = (2 * rows) / 3;
+   const uint32_t chroma_rows = (height + 1) / 2;
+   const uint32_t chroma_width = (width + 1) / 2;
+
+   if (layout == layouts) {
+      snprintf(errmsg, 256, "A packed YUV image has one layout, not both");
+      return -1;
+   }
+
+   if (args->target != PIPE_TEXTURE_2D || args->format != VIRGL_FORMAT_R8_UNORM ||
+       args->depth > 1 || args->array_size > 1 || args->last_level > 0 ||
+       args->nr_samples > 1) {
+      snprintf(errmsg, 256, "A packed YUV image is a single 2D R8 texture");
+      return -1;
+   }
+
+   if (args->flags & 0xffffu & ~layouts) {
+      snprintf(errmsg, 256, "Resource flags 0x%x do not go with a packed YUV image",
+               args->flags);
+      return -1;
+   }
+
+   if (!width || width > stride || !height || height + chroma_rows != rows) {
+      snprintf(errmsg, 256, "A packed YUV image of %ux%u does not hold a %u pixel wide picture",
+               stride, rows, width);
+      return -1;
+   }
+
+   if (layout == VIRGL_RESOURCE_FLAG_YUV_BIPLANAR ? stride < 2 * chroma_width
+                                                  : (stride % 2 || stride / 2 < chroma_width)) {
+      snprintf(errmsg, 256, "A %u byte luma row cannot hold the chroma rows of a %u pixel wide picture",
+               stride, width);
+      return -1;
+   }
+
+   if (yuv) {
+      yuv->biplanar = layout == VIRGL_RESOURCE_FLAG_YUV_BIPLANAR;
+      yuv->width = width;
+      yuv->height = height;
