@@ -2398,6 +2406,9 @@ int vrend_create_surface(struct vrend_context *ctx,
    struct vrend_surface *surf;
    uint32_t ret_handle;
 
+   if (!vrend_packed_yuv_need_image(ctx, res, "a surface"))
+      return ENOMEM;
+
    surf = CALLOC_STRUCT(vrend_surface);
    if (!surf)
       return ENOMEM;
@@ -2820,10 +2831,35 @@ int vrend_create_sampler_view(struct vrend_context *ctx,
        * layers that do not exist would fail the view and the command buffer
        * with it.
        */
-      if (view->u.tex.first_layer > view->u.tex.last_layer &&
+      const bool plane_number = view->u.tex.first_layer > view->u.tex.last_layer;
+
+      if (plane_number &&
           !(val0 < ARRAY_SIZE(res->aux_plane_egl_image) &&
             res->aux_plane_egl_image[val0]))
          view->u.tex.first_layer = view->u.tex.last_layer = 0;
+
+      /* A picture packed into one R8 image is sampled through the texture
