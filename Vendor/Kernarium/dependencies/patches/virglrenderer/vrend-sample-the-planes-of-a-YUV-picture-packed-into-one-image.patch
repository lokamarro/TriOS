          uint16_t first_layer = layers_or_offset & 0xffff;
          uint16_t last_layer = (layers_or_offset >> 16) & 0xffff;
@@ -5020,6 +5061,9 @@ int vrend_clear_texture(struct vrend_context* ctx,
 {
