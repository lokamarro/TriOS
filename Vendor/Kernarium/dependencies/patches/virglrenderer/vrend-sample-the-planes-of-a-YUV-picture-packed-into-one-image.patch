@@ -3956,6 +3992,11 @@ int vrend_set_single_image_view(struct vrend_context *ctx,
          return EINVAL;
       }
 
+      if (!vrend_packed_yuv_need_image(ctx, res, "a shader image")) {
+         vrend_report_context_error(ctx, VIRGL_ERROR_CTX_ILLEGAL_RESOURCE, handle);
+         return ENOMEM;
