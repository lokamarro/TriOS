 src/virgl_hw.h             |  19 ++
 src/vrend/vrend_blitter.c  | 195 ++++++++++++++
 src/vrend/vrend_blitter.h  |  22 ++
 src/vrend/vrend_renderer.c | 534 ++++++++++++++++++++++++++++++++++++-
 src/vrend/vrend_renderer.h |  26 ++
 5 files changed, 786 insertions(+), 10 deletions(-)

diff --git a/src/virgl_hw.h b/src/virgl_hw.h
index 0ee3f60bd1870db6d95076fc84bcba235368af05..025ee81b9acbf0bebc91d4fe6012dd99dfff6cc8 100644
--- a/src/virgl_hw.h
+++ b/src/virgl_hw.h
@@ -630,6 +630,11 @@ enum virgl_formats {
 #define VIRGL_CAP_V2_MIRROR_CLAMP         (1u << 17)
 #define VIRGL_CAP_V2_RESOURCE_LAYOUT      (1u << 18)
 #define VIRGL_CAP_V2_QUERY_FORMAT_MODIFIER (1u << 19)
+/* The renderer samples the planes of a picture kept in one R8 image: it
+ * accepts VIRGL_RESOURCE_FLAG_YUV_BIPLANAR and VIRGL_RESOURCE_FLAG_YUV_TRIPLANAR
+ * when a resource is created.
+ */
+#define VIRGL_CAP_V2_PACKED_YUV           (1u << 20)
 
 /* virgl bind flags - these are compatible with mesa 10.5 gallium.
  * but are fixed, no other should be passed to virgl either.
@@ -876,5 +881,19 @@ enum virgl_statistics_query_index {
 #define VIRGL_RESOURCE_Y_0_TOP (1 << 0)
 #define VIRGL_RESOURCE_FLAG_MAP_PERSISTENT (1 << 1)
 #define VIRGL_RESOURCE_FLAG_MAP_COHERENT   (1 << 2)
+/* The resource is an R8 image that holds a YUV 4:2:0 picture the way a guest
+ * allocator without host support lays it out, and the host also keeps one
+ * texture per plane for sampling. The image is as wide as one luma row
+ * (stride bytes) and as tall as the luma and chroma rows together. BIPLANAR
+ * is the luma rows followed by the interleaved chroma rows (NV12, NV21).
+ * TRIPLANAR is the luma rows followed by two planes of ceil(height / 2) rows
+ * of stride / 2 bytes each (YV12), the V plane first. The bits above
+ * VIRGL_RESOURCE_YUV_WIDTH_SHIFT carry the picture's width in pixels, which
+ * the luma stride may exceed. Only for VIRGL_CAP_V2_PACKED_YUV; the other
+ * flag bits stay clear.
+ */
+#define VIRGL_RESOURCE_FLAG_YUV_BIPLANAR   (1 << 8)
+#define VIRGL_RESOURCE_FLAG_YUV_TRIPLANAR  (1 << 9)
+#define VIRGL_RESOURCE_YUV_WIDTH_SHIFT     16
 
 #endif
diff --git a/src/vrend/vrend_blitter.c b/src/vrend/vrend_blitter.c
index 2afbdd6b042adcfaaee9dda67e7140cf85a8fa3a..31da986c13dcb16ec269738ddf6aa95cf3e26400 100644
--- a/src/vrend/vrend_blitter.c
+++ b/src/vrend/vrend_blitter.c
@@ -70,6 +70,15 @@ struct vrend_blitter_ctx {
    GLuint vs;
    GLuint fb_id;
 
+   /* The programs that read the planes of a packed YUV image out of it, made
+    * on first use, and the sampler that reads the image by exact texel. */
+   GLuint yuv_vs;
+   GLuint yuv_programs[VREND_YUV_EXTRACT_COUNT];
+   GLint yuv_geom_locations[VREND_YUV_EXTRACT_COUNT];
+   GLint yuv_position_locations[VREND_YUV_EXTRACT_COUNT];
+   GLuint yuv_sampler;
+   bool yuv_has_samplers;
+
    unsigned dst_width;
    unsigned dst_height;
 
@@ -911,6 +920,184 @@ void vrend_renderer_blit_gl(ASSERTED struct vrend_context *ctx,
    glBindTexture(src_res->target, 0);
 }
 
+/* The rows of the plane textures of a packed YUV image are drawn from the
+ * image by a fragment shader that fetches the bytes of one texel each. The
+ * fragment's position is the texel it writes, so no coordinates are passed.
+ * The sources are integers wide enough for a byte address in a 16K image. */
+#define YUV_FS_DECLARATIONS                      \
+   "uniform sampler2D samp;\n"                   \
+   "uniform ivec4 geom;\n"                       \
+   "out vec4 FragColor;\n"                       \
+   "#define fetch(x, y) texelFetch(samp, ivec2(x, y), 0).r\n"
+
+#define YUV_FS_LUMA                                                         \
+   "void main() {\n"                                                        \
+   "   ivec2 p = ivec2(gl_FragCoord.xy);\n"                                 \
+   "   FragColor = vec4(fetch(p.x, p.y), 0.0, 0.0, 1.0);\n"                 \
+   "}\n"
+
+#define YUV_FS_PAIRS                                                        \
+   "void main() {\n"                                                        \
+   "   ivec2 p = ivec2(gl_FragCoord.xy);\n"                                 \
+   "   int y = geom.y + p.y;\n"                                             \
+   "   FragColor = vec4(fetch(2 * p.x, y), fetch(2 * p.x + 1, y), 0.0, 1.0);\n" \
+   "}\n"
+
+#define YUV_FS_PLANAR                                                       \
+   "void main() {\n"                                                        \
+   "   ivec2 p = ivec2(gl_FragCoord.xy);\n"                                 \
+   "   int a = geom.z + p.y * geom.w + p.x;\n"                              \
+   "   FragColor = vec4(fetch(a % geom.x, a / geom.x), 0.0, 0.0, 1.0);\n"   \
+   "}\n"
+
+#define YUV_VS_BODY                                                         \
+   "in vec4 arg0;\n"                                                        \
+   "void main() {\n"                                                        \
+   "   gl_Position = arg0;\n"                                               \
+   "}\n"
+
+#define YUV_FS_HEADER_GL HEADER_GL YUV_FS_DECLARATIONS
+#define YUV_FS_HEADER_GLES                                                  \
+   "#version 310 es\n"                                                      \
+   "// Blitter\n"                                                           \
+   "precision highp float;\n"                                               \
+   "precision highp int;\n"                                                 \
+   "precision highp sampler2D;\n"                                           \
+   YUV_FS_DECLARATIONS
+
+static bool blit_yuv_prepare(struct vrend_blitter_ctx *blit_ctx,
+                             enum vrend_yuv_extract mode)
+{
+   static const char *const bodies[VREND_YUV_EXTRACT_COUNT] = {
+      [VREND_YUV_EXTRACT_LUMA] = YUV_FS_LUMA,
+      [VREND_YUV_EXTRACT_PAIRS] = YUV_FS_PAIRS,
+      [VREND_YUV_EXTRACT_PLANAR] = YUV_FS_PLANAR,
+   };
+   char source[2048];
+   GLuint fs;
+   GLuint prog;
+
+   if (!blit_ctx->yuv_programs[VREND_YUV_EXTRACT_LUMA] &&
+       !blit_ctx->yuv_programs[VREND_YUV_EXTRACT_PAIRS] &&
+       !blit_ctx->yuv_programs[VREND_YUV_EXTRACT_PLANAR]) {
+      blit_ctx->yuv_has_samplers =
+         epoxy_gl_version() >= (blit_ctx->use_gles ? 30 : 33) ||
+         (!blit_ctx->use_gles && epoxy_has_gl_extension("GL_ARB_sampler_objects"));
+   }
+
+   if (!blit_ctx->yuv_sampler && blit_ctx->yuv_has_samplers) {
+      glGenSamplers(1, &blit_ctx->yuv_sampler);
+      glSamplerParameteri(blit_ctx->yuv_sampler, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+      glSamplerParameteri(blit_ctx->yuv_sampler, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+      glSamplerParameteri(blit_ctx->yuv_sampler, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+      glSamplerParameteri(blit_ctx->yuv_sampler, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+   }
+
+   if (blit_ctx->yuv_programs[mode])
+      return true;
+
+   if (!blit_ctx->yuv_vs) {
+      blit_ctx->yuv_vs = blit_shader_build_and_check(GL_VERTEX_SHADER,
+         blit_ctx->use_gles ? HEADER_GLES YUV_VS_BODY : HEADER_GL YUV_VS_BODY);
+      if (!blit_ctx->yuv_vs)
+         return false;
+   }
+
+   snprintf(source, sizeof(source), "%s%s",
+            blit_ctx->use_gles ? YUV_FS_HEADER_GLES : YUV_FS_HEADER_GL,
+            bodies[mode]);
+   fs = blit_shader_build_and_check(GL_FRAGMENT_SHADER, source);
+   if (!fs)
+      return false;
+
+   prog = glCreateProgram();
+   glAttachShader(prog, blit_ctx->yuv_vs);
+   glAttachShader(prog, fs);
+   if (!blit_shader_link_and_check(prog)) {
+      glDeleteShader(fs);
+      return false;
+   }
+   glDeleteShader(fs);
+
+   blit_ctx->yuv_programs[mode] = prog;
+   blit_ctx->yuv_geom_locations[mode] = glGetUniformLocation(prog, "geom");
+   blit_ctx->yuv_position_locations[mode] = glGetAttribLocation(prog, "arg0");
+   return true;
+}
+
+bool vrend_blitter_extract_yuv_plane(struct vrend_resource *src,
+                                     struct vrend_resource *dst,
+                                     enum vrend_yuv_extract mode,
+                                     const int32_t geom[4],
+                                     uint32_t first_row,
+                                     uint32_t end_row)
+{
+   struct vrend_blitter_ctx *blit_ctx = &vrend_blit_ctx;
+   GLuint prog;
+   GLint position;
+
+   if (first_row >= end_row)
+      return false;
+
+   if (!vrend_renderer_init_blit_ctx(blit_ctx))
+      return false;
+
+   if (!blit_yuv_prepare(blit_ctx, mode)) {
+      /* The caller still owes the switch back to its own context. */
+      return true;
+   }
+
+   prog = blit_ctx->yuv_programs[mode];
+   position = blit_ctx->yuv_position_locations[mode];
+
+   glUseProgram(prog);
+   glUniform4i(blit_ctx->yuv_geom_locations[mode],
+               geom[0], geom[1], geom[2], geom[3]);
+
+   glBindFramebuffer(GL_FRAMEBUFFER, blit_ctx->fb_id);
+   glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                          dst->gl_id, 0);
+   GLuint buffers = GL_COLOR_ATTACHMENT0;
+   glDrawBuffers(1, &buffers);
+
+   glActiveTexture(GL_TEXTURE0);
+   glBindTexture(GL_TEXTURE_2D, src->gl_id);
+   if (blit_ctx->yuv_sampler) {
+      glBindSampler(0, blit_ctx->yuv_sampler);
+   } else {
+      /* A host without sampler objects reads the image by what its own
+       * parameters say, which for a level-0-only texture without immutable
+       * storage must not ask for mip levels. */
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+   }
+
+   glDisable(GL_SCISSOR_TEST);
+   glDisable(GL_BLEND);
+   glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+
+   blit_ctx->dst_width = dst->base.width0;
+   blit_ctx->dst_height = dst->base.height0;
+   blitter_set_rectangle(blit_ctx, 0, first_row, dst->base.width0, end_row);
+
+   glBufferData(GL_ARRAY_BUFFER, sizeof(blit_ctx->vertices), blit_ctx->vertices,
+                GL_STATIC_DRAW);
+   if (position >= 0) {
+      glVertexAttribPointer(position, 4, GL_FLOAT, GL_FALSE,
+                            8 * sizeof(float), (void *)0);
+      glEnableVertexAttribArray(position);
+   }
+   glDrawArrays(GL_TRIANGLE_FAN, 0, 4);
+
+   if (blit_ctx->yuv_sampler)
+      glBindSampler(0, 0);
+   glBindTexture(GL_TEXTURE_2D, 0);
+   glUseProgram(0);
+   glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+                          0, 0);
+   return true;
+}
+
 static void delete_program_cb(struct hash_entry *entry)
 {
    glDeleteProgram(pointer_to_uintptr(entry->data));
@@ -919,6 +1106,14 @@ static void delete_program_cb(struct hash_entry *entry)
 void vrend_blitter_fini(void)
 {
    vrend_blit_ctx.initialised = false;
+   for (unsigned i = 0; i < ARRAY_SIZE(vrend_blit_ctx.yuv_programs); i++) {
+      if (vrend_blit_ctx.yuv_programs[i])
+         glDeleteProgram(vrend_blit_ctx.yuv_programs[i]);
+   }
+   if (vrend_blit_ctx.yuv_vs)
+      glDeleteShader(vrend_blit_ctx.yuv_vs);
+   if (vrend_blit_ctx.yuv_sampler)
+      glDeleteSamplers(1, &vrend_blit_ctx.yuv_sampler);
    if (vrend_blit_ctx.blit_programs)
       _mesa_hash_table_u64_destroy(vrend_blit_ctx.blit_programs, delete_program_cb);
    vrend_clicbs->destroy_gl_context(vrend_blit_ctx.gl_context);
diff --git a/src/vrend/vrend_blitter.h b/src/vrend/vrend_blitter.h
index 91e24352f6d569f84c92ebe11e87de187f3731a3..67939c7dd35b8410ec418045e248e56bdbfb3ff3 100644
--- a/src/vrend/vrend_blitter.h
+++ b/src/vrend/vrend_blitter.h
@@ -188,4 +188,26 @@ void vrend_renderer_blit_gl(ASSERTED struct vrend_context *ctx,
                             const struct vrend_blit_info *info);
 void vrend_blitter_fini(void);
 
+/* How a plane of a YUV picture packed into an R8 image is read out of it.
+ * geom is the image's width in texels, the picture's luma height, and for a
+ * planar chroma plane the byte offset of the plane and the bytes of one of its
+ * rows. */
+enum vrend_yuv_extract {
+   VREND_YUV_EXTRACT_LUMA,    /* the rows of the image as they are */
+   VREND_YUV_EXTRACT_PAIRS,   /* interleaved chroma pairs below the luma rows */
+   VREND_YUV_EXTRACT_PLANAR,  /* a chroma plane of half-width rows */
+   VREND_YUV_EXTRACT_COUNT
+};
+
+/* Redraw rows [first_row, end_row) of the plane texture dst from the R8 image
+ * src, in the blitter's own context. Returns false, having drawn nothing,
+ * when the host cannot, and true when the caller must make its own context
+ * current again with vrend_sync_make_current(). */
+bool vrend_blitter_extract_yuv_plane(struct vrend_resource *src,
+                                     struct vrend_resource *dst,
+                                     enum vrend_yuv_extract mode,
+                                     const int32_t geom[4],
+                                     uint32_t first_row,
+                                     uint32_t end_row);
+
 #endif
diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index ef0e44ed939753a4cbf31153d1d77505cae85615..3423fe7f586d39713e3b91fde8df1d5672bc2247 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -923,6 +923,14 @@ static void vrend_apply_sampler_state(struct vrend_sub_context *sub_ctx,
                                       struct vrend_sampler_view *tview);
 static void vrend_object_bind_dsa_to_sub_context(struct vrend_sub_context *sub_ctx,
