    VkExportMemoryAllocateInfo local_export_info;
-   VkImportMemoryMetalHandleInfoEXT local_metal_import;
+   VkImportMemoryHostPointerInfoEXT local_host_import;
 
-   if ((property_flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) && !res_info) {
+   /* VK_EXT_external_memory_host is renderer-internal.  It gives a unified-memory
+    * host a real Vulkan import of the same anonymous file that virtio-gpu maps into
+    * the guest, without pretending that the file is a dma-buf or opaque Vulkan fd.
+    */
