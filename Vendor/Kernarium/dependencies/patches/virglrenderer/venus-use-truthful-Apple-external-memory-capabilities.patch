@@ -0,0 +1,24 @@
+/*
+ * Copyright 2026 The linux-um-darwin Authors
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VKR_HOST_MEMORY_H
+#define VKR_HOST_MEMORY_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+struct vkr_host_shm {
