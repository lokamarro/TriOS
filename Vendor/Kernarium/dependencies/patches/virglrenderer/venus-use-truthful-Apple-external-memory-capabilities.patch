@@ -78,6 +77,27 @@ vkr_device_init_proc_table(struct vkr_device *dev,
                                   api_version, &ext_table, &dev->proc_table);
 }
 
+/* Look up the entry points of the extensions the renderer enabled for its own
+ * use. Returns false when the driver lacks one of them.
+ */
+static bool
+vkr_device_init_renderer_procs(struct vkr_device *dev)
+{
+   const struct vkr_physical_device *physical_dev = dev->physical_device;
+   const struct vn_physical_device_proc_table *vk = &physical_dev->proc_table;
+   VkDevice handle = dev->base.handle.device;
+
+   if (physical_dev->EXT_external_memory_host) {
+      dev->GetMemoryHostPointerPropertiesEXT =
+         (PFN_vkGetMemoryHostPointerPropertiesEXT)vk->GetDeviceProcAddr(
+            handle, "vkGetMemoryHostPointerPropertiesEXT");
+      if (!dev->GetMemoryHostPointerPropertiesEXT)
+         return false;
+   }
+
+   return true;
+}
+
 static void
 vkr_dispatch_vkCreateDevice(struct vn_dispatch_context *dispatch,
                             struct vn_command_vkCreateDevice *args)
@@ -131,6 +151,7 @@ vkr_dispatch_vkCreateDevice(struct vn_dispatch_context *dispatch,
    /* append extensions for our own use */
    const char **exts = NULL;
    uint32_t ext_count = args->pCreateInfo->enabledExtensionCount;
+   ext_count += physical_dev->EXT_external_memory_host;
    ext_count += physical_dev->EXT_external_memory_metal;
    ext_count += physical_dev->EXT_metal_objects;
    ext_count += physical_dev->KHR_portability_subset;
@@ -148,6 +169,8 @@ vkr_dispatch_vkCreateDevice(struct vn_dispatch_context *dispatch,
       for (uint32_t i = 0; i < args->pCreateInfo->enabledExtensionCount; i++)
          exts[ext_count++] = args->pCreateInfo->ppEnabledExtensionNames[i];
 
+      if (physical_dev->EXT_external_memory_host)
+         exts[ext_count++] = VK_EXT_EXTERNAL_MEMORY_HOST_EXTENSION_NAME;
       if (physical_dev->EXT_external_memory_metal)
          exts[ext_count++] = "VK_EXT_external_memory_metal";
       if (physical_dev->EXT_metal_objects)
@@ -188,9 +211,14 @@ vkr_dispatch_vkCreateDevice(struct vn_dispatch_context *dispatch,
                               args->pCreateInfo->ppEnabledExtensionNames,
                               args->pCreateInfo->enabledExtensionCount);
 
-   if (physical_dev->EXT_external_memory_metal)
-      dev->mtl_device =
-         vkr_metal_get_device(dev->base.handle.device, vk->GetDeviceProcAddr);
+   if (!vkr_device_init_renderer_procs(dev)) {
+      struct vn_device_proc_table *dev_vk = &dev->proc_table;
+      dev_vk->DestroyDevice(dev->base.handle.device, NULL);
+      free(exts);
+      free(dev);
+      args->ret = VK_ERROR_EXTENSION_NOT_PRESENT;
+      return;
+   }
 
    free(exts);
 
