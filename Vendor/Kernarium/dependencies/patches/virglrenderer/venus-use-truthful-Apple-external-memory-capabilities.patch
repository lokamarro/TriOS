+   vk->GetPhysicalDeviceProperties2(physical_dev->base.handle.physical_device, &props);
+   physical_dev->min_imported_host_pointer_alignment =
+      host_props.minImportedHostPointerAlignment;
+   if (!physical_dev->min_imported_host_pointer_alignment) {
+      vkr_log("VK_EXT_external_memory_host reported zero import alignment");
