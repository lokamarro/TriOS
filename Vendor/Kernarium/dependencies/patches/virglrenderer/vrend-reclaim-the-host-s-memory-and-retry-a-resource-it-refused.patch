index b3b7ee7501169b405c1add95d915d8a644d6ae6d..133569a3b0c733d625226afc6f803c89a5a4daa5 100644
--- a/src/vrend/vrend_renderer.h
+++ b/src/vrend/vrend_renderer.h
@@ -254,6 +254,15 @@ struct vrend_if_cbs {
    virgl_gl_context (*create_gl_context_surfaceless)(int scanout, struct virgl_gl_ctx_param *params);
    void (*destroy_gl_context_surfaceless)(virgl_gl_context ctx);
    int (*make_current_surfaceless)(virgl_gl_context ctx);
+
+   /* Optional, as a pair.  The host driver refused a resource's storage and
+    * the renderer is about to give back what its own contexts hold.
+    * reclaim_end is called when it has: release what the process's other
+    * drivers cache for reuse, which counts against the same budget, and wait
+    * briefly for the memory that was freed to count in the host's budget.
+    * Both run with no driver lock held by the renderer. */
+   void (*reclaim_begin)(void);
+   void (*reclaim_end)(void);
 };
 
 #define VREND_USE_THREAD_SYNC (1 << 0)
diff --git a/src/vrend/vrend_winsys_egl.c b/src/vrend/vrend_winsys_egl.c
index eaaba2840b343f4a6624a2003f290f24aa585ff1..de533ced0543f0719594425e5c381e47c885c81e 100644
--- a/src/vrend/vrend_winsys_egl.c
+++ b/src/vrend/vrend_winsys_egl.c
@@ -956,6 +956,26 @@ bool virgl_egl_trim_context(struct virgl_egl *egl)
    return trim_context && trim_context();
 }
 
+/* eglReleaseCachedMemoryMESA, from the same extension: free what every screen
+ * of the process caches for reuse and nothing uses, and say how many cached
+ * allocations that released.  It takes no display and needs no current
+ * context, so it can be asked from anywhere in the renderer. */
+unsigned virgl_egl_release_cached_memory(struct virgl_egl *egl)
+{
+   typedef EGLint (*release_cached_memory_proc)(void);
+   static release_cached_memory_proc release_cached_memory;
+
+   if (!egl || !has_bit(egl->extension_bits, EGL_MESA_CONTEXT_TRIM))
+      return 0;
+   if (!release_cached_memory)
+      release_cached_memory =
+         (release_cached_memory_proc)eglGetProcAddress("eglReleaseCachedMemoryMESA");
+   if (!release_cached_memory)
+      return 0;
+   const EGLint released = release_cached_memory();
+   return released > 0 ? (unsigned)released : 0;
+}
+
 bool virgl_egl_supports_host_pointer_image(struct virgl_egl *egl)
 {
    return has_bit(egl->extension_bits, EGL_MESA_IMAGE_HOST_POINTER);
