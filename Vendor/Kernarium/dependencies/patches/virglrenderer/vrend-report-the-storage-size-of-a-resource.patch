From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 8 Nov 2026 16:14:39 +0900
Subject: [PATCH] vrend: report the storage size of a resource

A host that accounts the graphics memory its guests hold needs the size
of a Virgl resource's storage, which depends on the format's block size,
the mip levels, the layers and the samples, and which the guest's create
command does not state. vrend knows the format table, so
virgl_renderer_resource_get_storage_size() returns a buffer's size or the
sum over a texture's levels, layers and samples. A planar picture, which
has no block size, counts two bytes a pixel.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/virglrenderer.c        | 13 +++++++++++++
 src/virglrenderer.h        |  8 ++++++++
 src/vrend/vrend_renderer.c | 31 +++++++++++++++++++++++++++++++
 src/vrend/vrend_renderer.h |  4 ++++
 4 files changed, 56 insertions(+)

diff --git a/src/virglrenderer.c b/src/virglrenderer.c
index a0ab0aa74968730c73293d22425c3beab71fbded..083774c3ffc08a6f511d0d83be0727b8076efac6 100644
--- a/src/virglrenderer.c
+++ b/src/virglrenderer.c
@@ -602,6 +602,19 @@ int virgl_renderer_resource_get_info(int res_handle,
    return 0;
 }
 
+uint64_t virgl_renderer_resource_get_storage_size(int res_handle)
+{
+   TRACE_FUNC();
+#ifdef ENABLE_VREND
+   struct virgl_resource *res = virgl_resource_lookup(res_handle);
+   if (res && res->pipe_resource)
+      return vrend_renderer_resource_storage_size(res->pipe_resource);
+#else
+   (void)res_handle;
+#endif
+   return 0;
+}
+
 int virgl_renderer_resource_get_info_ext(int res_handle,
                                          struct virgl_renderer_resource_info_ext *info_ext)
 {
diff --git a/src/virglrenderer.h b/src/virglrenderer.h
index 972791a2f2dcf0e411cb1789c9cd5de0a4093634..9335e0ce538787484b4fc3257d6f0030ee5d8c17 100644
--- a/src/virglrenderer.h
+++ b/src/virglrenderer.h
@@ -407,6 +407,14 @@ VIRGL_EXPORT int virgl_renderer_resource_get_info(int res_handle,
 VIRGL_EXPORT int virgl_renderer_resource_get_info_ext(int res_handle,
                                                       struct virgl_renderer_resource_info_ext *info);
 
+/*
+ * The bytes a Virgl resource's storage takes on the host, for a host that
+ * accounts the memory its guests hold: a buffer's size, or every level,
+ * layer and sample of a texture. Zero for a resource that has no host
+ * storage of its own, such as a Venus blob.
+ */
+VIRGL_EXPORT uint64_t virgl_renderer_resource_get_storage_size(int res_handle);
+
 VIRGL_EXPORT void virgl_renderer_cleanup(void *cookie);
 
 /* reset the rendererer - destroy all contexts and resource */
diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 192cb0495564b3b722fa38f0fa6b413e5f40301b..de9472ddd03a793a7356ca0825881be246d5bc1f 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -15009,6 +15009,37 @@ void vrend_renderer_resource_get_info(struct pipe_resource *pres,
    info->stride = util_format_get_nblocksx(res->base.format, u_minify(res->base.width0, 0)) * elsize;
 }
 
+uint64_t
+vrend_renderer_resource_storage_size(struct pipe_resource *pres)
+{
+   if (pres->target == PIPE_BUFFER)
+      return pres->width0;
+
+   /* A format with no block size is a planar picture: count two bytes a pixel,
+    * between the 1.5 of NV12 and the 3 of a 10 bit 4:2:0 picture.
+    */
+   const uint64_t block_bytes = util_format_get_blocksize(pres->format);
+   const uint64_t samples = MAX2(pres->nr_samples, 1);
+   uint64_t total = 0;
+
+   for (unsigned level = 0; level <= pres->last_level; level++) {
+      const uint32_t width = u_minify(pres->width0, level);
+      const uint32_t height = u_minify(pres->height0, level);
+      const uint64_t layers = pres->target == PIPE_TEXTURE_3D
+                                 ? u_minify(pres->depth0, level)
+                                 : MAX2(pres->array_size, 1);
+      uint64_t level_bytes;
+      if (block_bytes) {
+         level_bytes = (uint64_t)util_format_get_nblocksx(pres->format, width) *
+                       util_format_get_nblocksy(pres->format, height) * block_bytes;
+      } else {
+         level_bytes = (uint64_t)width * height * 2;
+      }
+      total += level_bytes * layers * samples;
+   }
+   return total;
+}
+
 int
 vrend_renderer_resource_d3d11_texture2d(struct pipe_resource *pres, void **d3d_tex2d)
 {
diff --git a/src/vrend/vrend_renderer.h b/src/vrend/vrend_renderer.h
index 81ffe90bea4519848ac979aa2e9faa2e546b9639..31496144de44ddd935b198eab280724404aee6fd 100644
--- a/src/vrend/vrend_renderer.h
+++ b/src/vrend/vrend_renderer.h
@@ -645,6 +645,10 @@ struct vrend_blit_info {
 void vrend_renderer_resource_get_info(struct pipe_resource *pres,
                                       struct vrend_renderer_resource_info *info);
 
+/* The bytes a resource's storage takes on the host: a buffer's size, or every
+ * level, layer and sample of a texture, in its format's blocks. */
+uint64_t vrend_renderer_resource_storage_size(struct pipe_resource *pres);
+
 void vrend_renderer_get_cap_set(uint32_t cap_set, uint32_t *max_ver,
                                 uint32_t *max_size);
 
