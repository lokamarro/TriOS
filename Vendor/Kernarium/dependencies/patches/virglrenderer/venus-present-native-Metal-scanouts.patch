diff --git a/src/venus/vkr_image.c b/src/venus/vkr_image.c
index bb0e867cbc7b4ffd1a262555a4c4d3b1ad9b7f5a..0ec9ccc144668c58f5fefc6a0c32e9f05e6ab491 100644
--- a/src/venus/vkr_image.c
+++ b/src/venus/vkr_image.c
@@ -6,13 +6,132 @@
 #include "vkr_image.h"
 
 #include "vkr_image_gen.h"
+#include "vkr_device_memory.h"
 #include "vkr_physical_device.h"
 
+static bool
+vkr_image_should_export_metal_texture(
+   const struct vkr_device *dev, const VkImageCreateInfo *create_info)
+{
+   if (!dev->physical_device->EXT_metal_objects ||
+       !dev->physical_device->EXT_external_memory_metal)
+      return false;
+
+   const VkExternalMemoryImageCreateInfo *external_info =
+      vkr_find_struct(create_info->pNext,
+                      VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO);
+   if (external_info &&
+       (external_info->handleTypes &
+        VK_EXTERNAL_MEMORY_HANDLE_TYPE_MTLHEAP_BIT_EXT))
+      return true;
+
+   /* Venus can export the allocation as a virtio-gpu blob without exposing
+    * the renderer's Metal handle type in the guest image create chain.  Make
+    * color-render targets exportable up front so a later MTLHeap bind can
+    * publish the native texture for zero-copy scanout: every optimal one,
+    * and every one created for external memory whatever its tiling.  A
+    * compositor's GBM scanout buffer is the latter: a DRM_FORMAT_MOD_LINEAR
+    * image that names the renderer's host-allocation handle type, while the
+    * guest allocates its dedicated device-local memory as an MTLHeap.
+    * Publication still occurs only for allocations backed by a native Metal
+    * heap.
+    */
+   if (!(create_info->usage & VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT))
+      return false;
+
+   return create_info->tiling == VK_IMAGE_TILING_OPTIMAL ||
+          (external_info && external_info->handleTypes);
+}
+
+/* A bind that cannot publish its native texture repeats as often as the guest
+ * binds one, and the renderer's stderr shares the guest console with whatever
+ * the guest is writing.  Each device therefore reports the first publication
+ * failure with its own reason and stays quiet about the rest.
+ */
+static bool
+vkr_image_first_scanout_failure(struct vkr_device *dev)
+{
+   if (dev->metal_scanout_failure_reported)
+      return false;
+
+   dev->metal_scanout_failure_reported = true;
+   return true;
+}
+
+static void
+vkr_image_publish_metal_texture(struct vkr_device *dev,
+                                const struct vkr_image *image,
+                                struct vkr_device_memory *mem,
+                                VkDeviceSize memory_offset)
+{
+   if (!image->export_metal_texture)
+      return;
+
+   if (!mem->native_resource_id) {
+      /* Color targets vkr_image_should_export_metal_texture marks are
+       * exportable up front, but only an allocation the guest asked to
+       * export as an MTLHeap owns one.  An ordinary render target on
+       * ordinary device memory is the designed outcome of that marking, not
+       * a failure, and it is the common case: a conformance run binds one
+       * for every test.
+       */
+      if (!mem->metal_heap_exportable)
+         return;
+      if (!vkr_device_memory_prepare_metal_heap_export(mem)) {
+         if (vkr_image_first_scanout_failure(dev))
+            vkr_log("failed to prepare Metal heap for scanout texture");
+         return;
+      }
+   }
+
+   VkExportMetalTextureInfoEXT texture_info = {
+      .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_TEXTURE_INFO_EXT,
+      .image = image->base.handle.image,
+      .plane = VK_IMAGE_ASPECT_COLOR_BIT,
+   };
+   VkExportMetalObjectsInfoEXT objects_info = {
+      .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT,
+      .pNext = &texture_info,
+   };
+   dev->ExportMetalObjectsEXT(dev->base.handle.device, &objects_info);
+   if (!texture_info.mtlTexture) {
+      if (vkr_image_first_scanout_failure(dev))
+         vkr_log("native scanout texture export returned null for %ux%u",
+                 image->extent.width, image->extent.height);
+      return;
+   }
+
+   if (!virgl_resource_native_set_metal_texture(
+          mem->native_resource_id, texture_info.mtlTexture, memory_offset,
+          image->extent.width, image->extent.height)) {
+      if (vkr_image_first_scanout_failure(dev))
+         vkr_log("failed to publish Metal scanout texture");
+   }
+}
+
 static void
 vkr_dispatch_vkCreateImage(struct vn_dispatch_context *dispatch,
                            struct vn_command_vkCreateImage *args)
 {
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
    const VkImageTiling tiling = args->pCreateInfo->tiling;
+   const VkExtent3D extent = args->pCreateInfo->extent;
+   const bool export_metal_texture =
+      vkr_image_should_export_metal_texture(dev, args->pCreateInfo);
+   VkImageCreateInfo local_create_info;
+   VkExportMetalObjectCreateInfoEXT local_export_info;
+   if (export_metal_texture) {
+      local_create_info = *args->pCreateInfo;
+      local_export_info = (VkExportMetalObjectCreateInfoEXT) {
+         .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECT_CREATE_INFO_EXT,
+         .pNext = local_create_info.pNext,
+         .exportObjectType =
+            VK_EXPORT_METAL_OBJECT_TYPE_METAL_TEXTURE_BIT_EXT,
+      };
+      local_create_info.pNext = &local_export_info;
+      args->pCreateInfo = &local_create_info;
+   }
+
    /* XXX If VkExternalMemoryImageCreateInfo is chained by the app, all is
     * good.  If it is not chained, we might still bind an external memory to
     * the image, because vkr_dispatch_vkAllocateMemory makes any HOST_VISIBLE
@@ -39,6 +158,8 @@ vkr_dispatch_vkCreateImage(struct vn_dispatch_context *dispatch,
       image->format = format;
       image->array_layers = array_layers;
       image->tiling = tiling;
+      image->extent = extent;
+      image->export_metal_texture = export_metal_texture;
    }
 }
 
@@ -118,12 +239,24 @@ vkr_dispatch_vkBindImageMemory(UNUSED struct vn_dispatch_context *dispatch,
 {
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
+   struct vkr_image *image = vkr_image_from_handle(args->image);
+   struct vkr_device_memory *mem =
+      vkr_device_memory_from_handle(args->memory);
+   const VkDeviceSize memory_offset = args->memoryOffset;
 
    vn_replace_vkBindImageMemory_args_handle(args);
    args->ret =
       vk->BindImageMemory(args->device, args->image, args->memory, args->memoryOffset);
+   if (args->ret == VK_SUCCESS)
+      vkr_image_publish_metal_texture(dev, image, mem, memory_offset);
 }
 
+struct vkr_metal_image_binding {
+   struct vkr_image *image;
+   struct vkr_device_memory *memory;
+   VkDeviceSize memory_offset;
+};
+
 static void
 vkr_dispatch_vkBindImageMemory2(UNUSED struct vn_dispatch_context *dispatch,
                                 struct vn_command_vkBindImageMemory2 *args)
@@ -131,8 +264,31 @@ vkr_dispatch_vkBindImageMemory2(UNUSED struct vn_dispatch_context *dispatch,
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
 
+   STACK_ARRAY(struct vkr_metal_image_binding, bindings,
+               args->bindInfoCount);
+   if (!bindings) {
+      args->ret = VK_ERROR_OUT_OF_HOST_MEMORY;
+      return;
+   }
+   for (uint32_t i = 0; i < args->bindInfoCount; i++) {
+      bindings[i] = (struct vkr_metal_image_binding) {
+         .image = vkr_image_from_handle(args->pBindInfos[i].image),
+         .memory =
+            vkr_device_memory_from_handle(args->pBindInfos[i].memory),
+         .memory_offset = args->pBindInfos[i].memoryOffset,
+      };
+   }
+
    vn_replace_vkBindImageMemory2_args_handle(args);
    args->ret = vk->BindImageMemory2(args->device, args->bindInfoCount, args->pBindInfos);
+   if (args->ret == VK_SUCCESS) {
+      for (uint32_t i = 0; i < args->bindInfoCount; i++) {
+         vkr_image_publish_metal_texture(
+            dev, bindings[i].image, bindings[i].memory,
+            bindings[i].memory_offset);
+      }
+   }
+   STACK_ARRAY_FINISH(bindings);
 }
 
