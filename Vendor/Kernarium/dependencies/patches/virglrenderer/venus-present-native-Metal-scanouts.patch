+enum virgl_renderer_native_handle_type
+virgl_renderer_create_handle_for_scanout(uint32_t res_id,
+                                         uint32_t width,
+                                         uint32_t height,
+                                         uint32_t virgl_format,
+                                         uint32_t padding,
+                                         uint32_t stride,
+                                         uint32_t offset,
+                                         virgl_renderer_native_handle *handle)
+{
+   TRACE_FUNC();
+   (void)virgl_format;
+   (void)padding;
+   (void)stride;
+#ifdef ENABLE_METAL
+   struct virgl_resource *res = virgl_resource_lookup(res_id);
+
+   if (!res)
+      return VIRGL_NATIVE_HANDLE_NONE;
+
+   /* A Venus context that allocated this blob out of a Metal heap registered
+    * the texture it wrote into; that texture is the scanout, and handing it
+    * out is what keeps presentation a zero-copy path. Every other blob is
+    * read back, which is the caller's fallback. */
+   void *native_texture = virgl_resource_native_acquire_metal_texture(
+      res->native_resource_id, offset, width, height);
+   if (native_texture) {
+      *handle = native_texture;
+      return VIRGL_NATIVE_HANDLE_METAL_TEXTURE;
+   }
