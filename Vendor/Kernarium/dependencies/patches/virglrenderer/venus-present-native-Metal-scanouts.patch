+uint64_t
+virgl_resource_native_retain(uint64_t id)
+{
+#if defined(ENABLE_METAL) && defined(ENABLE_SAME_PROCESS_RENDER_SERVER)
+   if (!id)
+      return 0;
+
+   call_once(&native_resource_once, virgl_resource_native_init_once);
+   if (!native_resource_ready)
+      return 0;
+
+   uint64_t retained_id = 0;
+   mtx_lock(&native_resource_mutex);
+   list_for_each_entry (struct virgl_native_resource, resource,
+                        &native_resources, head) {
+      if (resource->id == id && resource->refcount != UINT32_MAX) {
+         resource->refcount++;
+         retained_id = id;
+         break;
+      }
+   }
+   mtx_unlock(&native_resource_mutex);
+   return retained_id;
+#else
+   (void)id;
+   return 0;
+#endif
+}
+
+bool
+virgl_resource_native_set_metal_texture(uint64_t id,
+                                        void *texture,
+                                        uint64_t offset,
+                                        uint32_t width,
+                                        uint32_t height)
+{
+#if defined(ENABLE_METAL) && defined(ENABLE_SAME_PROCESS_RENDER_SERVER)
+   if (!id || !texture || !width || !height)
+      return false;
+
+   struct virgl_native_metal_texture *new_texture =
+      calloc(1, sizeof(*new_texture));
+   if (!new_texture)
+      return false;
+
+   new_texture->handle = virgl_metal_retain_object(texture);
+   new_texture->offset = offset;
+   new_texture->width = width;
+   new_texture->height = height;
+
+   call_once(&native_resource_once, virgl_resource_native_init_once);
+   if (!native_resource_ready) {
+      virgl_metal_release_object(new_texture->handle);
+      free(new_texture);
+      return false;
+   }
+
+   void *replaced_handle = NULL;
+   bool found = false;
+   mtx_lock(&native_resource_mutex);
+   list_for_each_entry (struct virgl_native_resource, resource,
+                        &native_resources, head) {
+      if (resource->id != id)
+         continue;
+
+      list_for_each_entry (struct virgl_native_metal_texture, existing,
+                           &resource->metal_textures, head) {
+         if (existing->offset == offset && existing->width == width &&
+             existing->height == height) {
+            replaced_handle = existing->handle;
+            existing->handle = new_texture->handle;
+            new_texture->handle = NULL;
+            found = true;
+            break;
+         }
+      }
+
+      if (!found) {
+         list_addtail(&new_texture->head, &resource->metal_textures);
+         new_texture = NULL;
+      }
+      found = true;
+      break;
+   }
+   mtx_unlock(&native_resource_mutex);
+
+   if (replaced_handle)
+      virgl_metal_release_object(replaced_handle);
+   if (new_texture) {
+      if (new_texture->handle)
+         virgl_metal_release_object(new_texture->handle);
+      free(new_texture);
+   }
+   return found;
+#else
+   (void)id;
+   (void)texture;
+   (void)offset;
+   (void)width;
+   (void)height;
+   return false;
+#endif
+}
+
+void *
+virgl_resource_native_acquire_metal_texture(uint64_t id,
+                                            uint64_t offset,
+                                            uint32_t width,
+                                            uint32_t height)
+{
+#if defined(ENABLE_METAL) && defined(ENABLE_SAME_PROCESS_RENDER_SERVER)
+   if (!id)
+      return NULL;
+
+   call_once(&native_resource_once, virgl_resource_native_init_once);
+   if (!native_resource_ready)
+      return NULL;
+
+   void *handle = NULL;
+   mtx_lock(&native_resource_mutex);
+   list_for_each_entry (struct virgl_native_resource, resource,
+                        &native_resources, head) {
+      if (resource->id != id)
+         continue;
+
+      list_for_each_entry (struct virgl_native_metal_texture, texture,
+                           &resource->metal_textures, head) {
+         if (texture->offset == offset && texture->width == width &&
+             texture->height == height) {
+            handle = virgl_metal_retain_object(texture->handle);
+            break;
+         }
+      }
+      break;
+   }
+   mtx_unlock(&native_resource_mutex);
+   return handle;
+#else
+   (void)id;
+   (void)offset;
+   (void)width;
+   (void)height;
+   return NULL;
+#endif
+}
