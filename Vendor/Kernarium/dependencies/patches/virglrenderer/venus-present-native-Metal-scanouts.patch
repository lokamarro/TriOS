+bool
+vkr_device_memory_prepare_metal_heap_export(struct vkr_device_memory *mem)
+{
+   if (mem->native_resource_id)
+      return true;
+   if (!mem->metal_heap_exportable)
+      return false;
+
+   const VkMemoryGetMetalHandleInfoEXT handle_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_GET_METAL_HANDLE_INFO_EXT,
+      .memory = mem->base.handle.device_memory,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_MTLHEAP_BIT_EXT,
+   };
+   void *metal_heap = NULL;
+   VkResult ret = mem->device->GetMemoryMetalHandleEXT(
+      mem->device->base.handle.device, &handle_info, &metal_heap);
+   if (ret != VK_SUCCESS || !metal_heap) {
+      vkr_log("mem Metal heap export failed (vk ret %d)", ret);
+      return false;
+   }
+
+   const uint64_t page_size = (uint64_t)getpagesize();
+   if (mem->allocation_size > INT64_MAX - (page_size - 1))
+      return false;
+   const uint64_t fd_size = align64(mem->allocation_size, page_size);
+   /* macOS reports st_dev == st_ino == 0 for every POSIX shared-memory
+    * descriptor.  Native resources use that identity to reconnect the fd
+    * returned to virtio-gpu with its in-process Metal object, so the fd is an
+    * unlinked file with a real vnode identity instead.  It is sized to the
+    * allocation but never holds the image payload.
+    */
+   int fd = os_create_unlinked_file((off_t)fd_size, "vkr-metal-heap");
+   if (fd < 0) {
+      vkr_log("Metal heap identity file creation failed (%s)", strerror(errno));
+      return false;
+   }
+
+   const uint64_t native_resource_id = virgl_resource_native_publish(
+      fd, VIRGL_RESOURCE_NATIVE_HANDLE_METAL_HEAP, metal_heap);
+   if (!native_resource_id) {
+      vkr_log("Metal heap native-resource publication failed");
+      close(fd);
+      return false;
+   }
+
+   mem->metal_heap_fd = fd;
+   mem->native_resource_id = native_resource_id;
+   return true;
+}
