+/*
+ * Create an unlinked regular file of the given size under TMPDIR, or /tmp
+ * when TMPDIR is unset, and return a close-on-exec descriptor for it. Unlike
+ * anonymous shared memory it has a real vnode identity (st_dev, st_ino), and
+ * it maps MAP_SHARED like any file. The tag prefixes the temporary name.
+ * Returns -1 with errno set on failure.
+ */
+int
+os_create_unlinked_file(off_t size, const char *tag)
+{
+   const char *tmpdir = getenv("TMPDIR");
+   if (!tmpdir || !tmpdir[0])
+      tmpdir = "/tmp";
+   const char *separator = tmpdir[strlen(tmpdir) - 1] == '/' ? "" : "/";
+   char path[PATH_MAX];
+   const int written =
+      snprintf(path, sizeof(path), "%s%s%s-XXXXXX", tmpdir, separator, tag);
+   if (written < 0 || (size_t)written >= sizeof(path)) {
+      errno = ENAMETOOLONG;
+      return -1;
+   }
+
+   const int fd = mkstemp(path);
+   if (fd < 0)
+      return -1;
+
+   int flags;
+   if (unlink(path) < 0 || (flags = fcntl(fd, F_GETFD)) < 0 ||
+       fcntl(fd, F_SETFD, flags | FD_CLOEXEC) < 0 || ftruncate(fd, size) < 0) {
+      const int saved_errno = errno;
+      close(fd);
+      errno = saved_errno;
+      return -1;
+   }
+
+   return fd;
+}
