diff --git a/lib/eu-config.h b/lib/eu-config.h
index 0bf2aa76e756b5a458ded06fb423494f2e0df2ef..689017a95ef48ccdc9b5b0510736f2640463404e 100644
--- a/lib/eu-config.h
+++ b/lib/eu-config.h
@@ -31,14 +31,26 @@
 
 #include "locks.h"
 
-#include <libintl.h>
 /* gettext helper macros.  */
 #define N_(Str) Str
+#ifdef ENABLE_NLS
+#include <libintl.h>
 #define _(Str) dgettext ("elfutils", Str)
+#else
+#define _(Str) Str
+#endif
 
 /* Compiler-specific definitions.  */
+#ifdef __APPLE__
+/* Mach-O has no alias attribute.  The assembler's .set directive gives the
+   same definition a second global name.  */
+#define strong_alias(name, aliasname) \
+  extern __typeof (name) aliasname; \
+  __asm__ (".globl _" #aliasname "\n\t.set _" #aliasname ", _" #name);
+#else
 #define strong_alias(name, aliasname) \
   extern __typeof (name) aliasname __attribute__ ((alias (#name)));
+#endif
 
 #ifdef __i386__
 # define internal_function __attribute__ ((regparm (3), stdcall))
diff --git a/lib/eu-search.c b/lib/eu-search.c
index fc31fe878405ad427767c4fd950b968c7089a916..fb92ed03745df5f8729ee9671582e6016e97f981 100644
--- a/lib/eu-search.c
+++ b/lib/eu-search.c
@@ -62,6 +62,27 @@ void *eu_tdelete (const void *key, search_tree *tree,
   return ret;
 }
 
+#ifndef HAVE_TDESTROY
+/* POSIX has no tdestroy.  Delete the root key until the tree is empty; the
+   comparison only needs to match the root key itself.  */
+static int
+eu_tdestroy_root_compare (const void *a, const void *b)
+{
+  return a == b ? 0 : (a < b ? -1 : 1);
+}
+
+static void
+tdestroy (void *root, void (*free_node)(void *))
+{
+  while (root != NULL)
+    {
+      void *key = *(void **) root;
+      tdelete (key, &root, eu_tdestroy_root_compare);
+      free_node (key);
+    }
+}
+#endif
+
 void eu_tdestroy (search_tree *tree, void (*free_node)(void *))
 {
   rwlock_wrlock (tree->lock);
