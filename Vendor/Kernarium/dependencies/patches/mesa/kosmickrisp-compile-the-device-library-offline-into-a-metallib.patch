+extern KK_METALLIB_HIDDEN const size_t libkk_metallib_size;
+extern KK_METALLIB_HIDDEN const uint8_t libkk_metallib[];
+
+#endif /* KK_METALLIB_H */
diff --git a/src/kosmickrisp/libkk/kk_metallib.py b/src/kosmickrisp/libkk/kk_metallib.py
new file mode 100755
index 0000000000000000000000000000000000000000..0da26e4a2b42b2e7b874587336b8ccf274da9d38
--- /dev/null
+++ b/src/kosmickrisp/libkk/kk_metallib.py
@@ -0,0 +1,129 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Compile the KosmicKrisp device library offline into one metallib.
+
+kk_clc writes every device library program's MSL into one bundle. This
+compiles each program with the Metal toolchain of the target platform, links
+them into a single metallib with each kernel renamed after its program index,
+and emits the metallib as a C array, so the driver loads compiled programs
+instead of compiling MSL when it creates a device.
+"""
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+
+# KosmicKrisp is a Metal 4 driver, so both platforms start at version 26.
+PLATFORMS = {
+    'macos': ('macosx', 'air64-apple-macos26.0'),
+    'ios': ('iphoneos', 'air64-apple-ios26.0'),
+}
+
+HEADER = re.compile(rb'//@kk-program (\d+) (\d+)\n')
+ENTRYPOINT = 'kernel void main_entrypoint('
+
+
+def parse_bundle(path):
+    with open(path, 'rb') as f:
+        data = f.read()
+    programs = {}
+    pos = 0
+    while pos < len(data):
+        match = HEADER.match(data, pos)
+        if match is None:
+            sys.exit(f'{path}: malformed program header at byte {pos}')
+        index, length = int(match[1]), int(match[2])
+        source = data[match.end():match.end() + length]
+        if len(source) != length or index in programs:
+            sys.exit(f'{path}: malformed program {index}')
+        programs[index] = source.decode('ascii')
+        pos = match.end() + length
+    if sorted(programs) != list(range(len(programs))):
+        sys.exit(f'{path}: program indices are not contiguous')
+    return programs
+
+
+def define(path, name, value):
+    with open(path, encoding='ascii') as f:
+        match = re.search(rf'^#define {name} {value}$', f.read(), re.MULTILINE)
+    if match is None:
+        sys.exit(f'{path}: no #define {name} matching {value}')
+    return match[1]
+
+
+def metal_options(compiler_header, library_header):
+    """The options the driver compiles the device library's MSL with at
+    runtime, read from where it sets them: the language version from the
+    bridge's mtl_compiler.h and the math from kk_metallib.h."""
+    major = define(compiler_header, 'MTL_COMPILER_LANGUAGE_MAJOR', r'(\d+)')
+    minor = define(compiler_header, 'MTL_COMPILER_LANGUAGE_MINOR', r'(\d+)')
+    math = define(library_header, 'KK_DEVICE_LIB_MATH_MODE',
+                  r'MTL_MATH_MODE_(SAFE|RELAXED|FAST)')
+    fp32 = define(library_header, 'KK_DEVICE_LIB_MATH_FP32_FUNCTIONS',
+                  r'MTL_MATH_FLOATING_POINT_FUNCTIONS_(FAST|PRECISE)')
+    return [
+        f'-std=metal{major}.{minor}',
+        f'-fmetal-math-mode={math.lower()}',
+        f'-fmetal-math-fp32-functions={fp32.lower()}',
+    ]
+
+
+def run(command):
+    result = subprocess.run(command, stdout=subprocess.PIPE,
+                            stderr=subprocess.STDOUT, text=True)
+    if result.returncode != 0:
+        sys.exit(f'{" ".join(command)} failed:\n{result.stdout}')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--platform', required=True, choices=sorted(PLATFORMS))
+    parser.add_argument('--private-dir', required=True)
+    parser.add_argument('--compiler-header', required=True)
+    parser.add_argument('--library-header', required=True)
+    parser.add_argument('bundle')
+    parser.add_argument('output')
+    args = parser.parse_args()
+
+    sdk, target = PLATFORMS[args.platform]
+    options = metal_options(args.compiler_header, args.library_header)
+    programs = parse_bundle(args.bundle)
+    os.makedirs(args.private_dir, exist_ok=True)
+
+    airs = []
+    for index, source in sorted(programs.items()):
+        if source.count(ENTRYPOINT) != 1:
+            sys.exit(f'program {index} does not declare one kernel entry point')
+        source = source.replace(ENTRYPOINT, f'kernel void libkk_{index}(')
+        metal = os.path.join(args.private_dir, f'libkk_{index}.metal')
+        air = os.path.join(args.private_dir, f'libkk_{index}.air')
+        with open(metal, 'w', encoding='ascii') as f:
+            f.write(source)
+        run(['xcrun', '-sdk', sdk, 'metal', '-c', '-target', target,
+             *options, '-o', air, metal])
+        airs.append(air)
+
+    metallib = os.path.join(args.private_dir, 'libkk.metallib')
+    run(['xcrun', '-sdk', sdk, 'metallib', '-o', metallib, *airs])
+    with open(metallib, 'rb') as f:
+        blob = f.read()
+
+    with open(args.output, 'w', encoding='ascii') as out:
+        out.write('/* Generated by kk_metallib.py from the device library. */\n\n')
+        out.write('#include "kk_metallib.h"\n\n')
+        out.write('KK_METALLIB_HIDDEN const unsigned libkk_metallib_programs = '
+                  f'{len(programs)};\n')
+        out.write('KK_METALLIB_HIDDEN const size_t libkk_metallib_size = '
+                  f'{len(blob)};\n')
+        out.write('KK_METALLIB_HIDDEN const uint8_t libkk_metallib[] '
+                  '__attribute__((aligned(16))) = {')
+        for offset in range(0, len(blob), 16):
+            chunk = blob[offset:offset + 16]
+            out.write('\n   ' + ''.join(f' 0x{byte:02x},' for byte in chunk))
+        out.write('\n};\n')
+
+
+if __name__ == '__main__':
+    main()
