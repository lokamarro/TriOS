+/* SPDX-License-Identifier: MIT */
+#ifndef KK_METALLIB_H
+#define KK_METALLIB_H 1
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* The device library compiled offline for the target platform, in which
+ * program i's kernel is named libkk_<i>. Only Apple builds carry it, and they
