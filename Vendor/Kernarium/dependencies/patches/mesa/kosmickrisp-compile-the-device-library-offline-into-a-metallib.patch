+mtl_library *
+mtl_new_library_with_data(mtl_device *device, const void *data, size_t size)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      /* An empty destructor makes Metal read the caller's data in place. */
+      dispatch_data_t blob = dispatch_data_create(
+         data, size, dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0), ^{});
+
+      NSError *error;
+      id<MTLLibrary> lib = [dev newLibraryWithData:blob error:&error];
+      dispatch_release(blob);
+
+      if (lib == nil) {
+         fprintf(stderr, "Failed to load MTLLibrary: %s\n", [error.localizedDescription UTF8String]);
+      }
+
+      return lib;
+   }
