diff --git a/src/kosmickrisp/vulkan/kk_device_lib.c b/src/kosmickrisp/vulkan/kk_device_lib.c
index b7906019f9f140a266945357340e97ac7634240d..615babfc44f1c279d6a9a2c6621ab746d350fe63 100644
--- a/src/kosmickrisp/vulkan/kk_device_lib.c
+++ b/src/kosmickrisp/vulkan/kk_device_lib.c
@@ -11,39 +11,81 @@
 #include "kosmickrisp/clc/kk_precompiled_shader.h"
 
 #include "libkk_shaders.h"
+#include "kk_metallib.h"
 
 #include "kosmickrisp/bridge/mtl_bridge.h"
 
 #include "nir/nir.h"
 #include "nir/nir_builder.h"
 
+/* The device library compiled offline for this platform, if the build made
+ * one; see kk_metallib.py. Compiling the programs' MSL instead costs every
+ * process that creates a device a front-end compile until Metal's cache
+ * holds the result. */
+static mtl_library *
+open_offline_library(struct kk_device *dev)
+{
+#ifdef KK_HAVE_METALLIB
+   if (libkk_metallib_programs == LIBKK_NUM_PROGRAMS)
+      return mtl_new_library_with_data(dev->mtl_handle, libkk_metallib,
+                                       libkk_metallib_size);
+#endif
+   return NULL;
+}
+
+static mtl_compute_pipeline_state *
+build_program(struct kk_device *dev, mtl_library *library,
+              const char *entry_point, uint32_t local_size_threads)
+{
+   mtl_function_descriptor *function =
+      mtl_new_library_function_descriptor(library, entry_point);
+   mtl_compute_pipeline_state *pipeline = mtl_new_compute_pipeline_state(
+      dev->mtl_compiler_handle, function, local_size_threads);
+   mtl_release(function);
+   return pipeline;
+}
+
 static VkResult
 build_precompiled_shaders(struct kk_device *dev)
 {
+   mtl_library *offline = open_offline_library(dev);
+   dev->precompiled_cache.offline_count = 0u;
+
    uint32_t i = 0u;
    for (; i < LIBKK_NUM_PROGRAMS; ++i) {
       const uint32_t *bin = libkk_AppleSilicon[i];
       const struct kk_precompiled_info *info = (void *)bin;
       const char *msl = (const char *)bin + sizeof(*info);
-
-      mtl_library *library =
-         mtl_new_library(dev->mtl_compiler_handle, msl, MTL_MATH_MODE_FAST,
-                         MTL_MATH_FLOATING_POINT_FUNCTIONS_FAST);
-      if (library == NULL)
-         goto fail;
-
       struct kk_precompiled_shader *shader = &dev->precompiled_cache.shaders[i];
-
-      /* TODO_KOSMICKRISP Do not hardcode the entrypoint */
-      mtl_function_descriptor *function =
-         mtl_new_library_function_descriptor(library, "main_entrypoint");
       uint32_t local_size_threads = info->workgroup_size[0] *
                                     info->workgroup_size[1] *
                                     info->workgroup_size[2];
-      shader->pipeline = mtl_new_compute_pipeline_state(
-         dev->mtl_compiler_handle, function, local_size_threads);
-      mtl_release(function);
-      mtl_release(library);
+
+      shader->pipeline = NULL;
+      if (offline) {
+         char entry_point[32];
+         snprintf(entry_point, sizeof(entry_point), "libkk_%u", i);
+         shader->pipeline =
+            build_program(dev, offline, entry_point, local_size_threads);
+         if (shader->pipeline)
+            dev->precompiled_cache.offline_count++;
+      }
+
