diff --git a/src/egl/main/eglapi.c b/src/egl/main/eglapi.c
index 1557dbeb9326a7273eb72db59ec7af81d6892205..71d763caded442d31164d3dd30f12c17bae193c7 100644
--- a/src/egl/main/eglapi.c
+++ b/src/egl/main/eglapi.c
@@ -591,6 +591,7 @@ _eglCreateExtensionsString(_EGLDisplay *disp)
 
    if (disp->Extensions.KHR_no_config_context)
       _eglAppendExtension(&exts, "EGL_MESA_configless_context");
+   _EGL_CHECK_EXTENSION(MESA_context_trim);
    _EGL_CHECK_EXTENSION(MESA_gl_interop);
    _EGL_CHECK_EXTENSION(MESA_image_dma_buf_export);
    _EGL_CHECK_EXTENSION(MESA_image_host_pointer);
@@ -1632,6 +1633,38 @@ eglWaitClient(void)
    return _eglWaitClientCommon();
 }
 
+/**
+ * EGL_MESA_context_trim: ask the context current to the calling thread to
+ * release what it holds for completed work.  The client calls it for a context
+ * it has flushed and then left idle.  Nothing current is nothing to trim.
+ */
+static EGLBoolean EGLAPIENTRY
+eglTrimContextMESA(void)
+{
+   _EGLContext *ctx = _eglGetCurrentContext();
+   _EGLDisplay *disp;
+   EGLBoolean ret = EGL_FALSE;
+
+   _EGL_FUNC_START(NULL, EGL_OBJECT_CONTEXT_KHR, ctx);
+
+   if (!ctx)
+      RETURN_EGL_SUCCESS(NULL, EGL_TRUE);
+
+   disp = _eglLockDisplay(ctx->Resource.Display);
+
+   /* a valid current context implies an initialized current display */
+   assert(disp->Initialized);
+
+   if (!disp->Extensions.MESA_context_trim || !disp->Driver->TrimContextMESA)
+      RETURN_EGL_ERROR(disp, EGL_BAD_ACCESS, EGL_FALSE);
+
+   egl_relax (disp, &ctx->Resource) {
+      ret = disp->Driver->TrimContextMESA(disp, ctx);
+   }
+
+   RETURN_EGL_EVAL(disp, ret);
+}
+
 PUBLIC EGLBoolean EGLAPIENTRY
 eglWaitGL(void)
 {
