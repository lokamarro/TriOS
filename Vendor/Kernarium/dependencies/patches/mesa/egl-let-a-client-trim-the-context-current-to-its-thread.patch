index 9af523a90a962a6e026a188e924646c34bfcdc6b..149c871cda0ac05c86d8bb5817afeeee38f3ea5e 100644
--- a/src/mesa/state_tracker/st_manager.c
+++ b/src/mesa/state_tracker/st_manager.c
@@ -818,6 +818,27 @@ st_context_flush(struct st_context *st, unsigned flags,
       st_manager_flush_frontbuffer(st);
 }
 
+/**
+ * Ask the driver to release what the context holds for completed work, for
+ * a context its client has flushed and left idle.  The caller owns the
+ * context on this thread.  What glthread still has queued is executed first,
+ * so that the objects it deletes are no longer referenced when the driver
+ * looks; nothing waits for the device.
+ */
+void
+st_context_trim(struct st_context *st)
+{
+   struct pipe_context *pipe = st->pipe;
+
+   MESA_TRACE_FUNC();
+
+   if (!pipe->trim)
+      return;
+
+   _mesa_glthread_finish(st->ctx);
+   pipe->trim(pipe);
+}
+
 /**
  * Replace the texture image of a texture object at the specified level.
  *
