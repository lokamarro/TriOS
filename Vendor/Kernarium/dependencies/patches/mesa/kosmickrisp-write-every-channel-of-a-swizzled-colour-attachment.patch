diff --git a/src/kosmickrisp/vulkan/tests/test_fragment_output_swizzle.c b/src/kosmickrisp/vulkan/tests/test_fragment_output_swizzle.c
new file mode 100644
index 0000000000000000000000000000000000000000..2cff37893083732e7505da0d39551150b16f2492
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_fragment_output_swizzle.c
@@ -0,0 +1,160 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* A colour format Metal only offers in another channel order is rendered to
+ * through the hardware's order, and the shader moves the channels.  A store
+ * that writes fewer than four channels is the case that breaks a naive
+ * value-only swizzle: the hardware lane a Vulkan channel belongs in can sit
+ * past the store's width, so the store has to cover all four lanes and name
+ * the written ones in its mask.
+ */
+
+#include "kosmickrisp/vulkan/kk_format.h"
+#include "kosmickrisp/vulkan/kk_shader.h"
+
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+#include "kosmickrisp/compiler/nir_to_msl.h"
+#include "vk_format.h"
+#include "vk_graphics_state.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(condition)                                                       \
+   do {                                                                        \
+      if (!(condition)) {                                                       \
+         fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__,      \
+                 #condition);                                                   \
+         abort();                                                               \
+      }                                                                         \
+   } while (0)
+
+static nir_shader *
+build_fragment_store(unsigned components)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_FRAGMENT, &kk_nir_options, "fragment colour store");
+   nir_shader *nir = b.shader;
+   nir->info.io_lowered = true;
+
+   nir_def *channels[4];
+   for (unsigned i = 0; i < components; ++i)
+      channels[i] = nir_imm_int(&b, 0x10u + i);
+
+   nir_store_output(&b, nir_vec(&b, channels, components), nir_imm_int(&b, 0),
+                    .base = 0, .range = 1, .write_mask = BITFIELD_MASK(components),
+                    .component = 0, .src_type = nir_type_uint32,
+                    .io_semantics.location = FRAG_RESULT_DATA0,
+                    .io_semantics.num_slots = 1);
+   nir->info.outputs_written |= BITFIELD64_BIT(FRAG_RESULT_DATA0);
+   return nir;
+}
+
+static nir_intrinsic_instr *
+find_store(nir_shader *nir)
+{
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+            if (intrin->intrinsic == nir_intrinsic_store_output)
+               return intrin;
+         }
+      }
+   }
+   return NULL;
+}
+
+/* The constant a lane of the rebuilt store carries; a lane the shader never
+ * wrote is left undefined instead. */
+static uint64_t
+lane_value(nir_def *value, unsigned lane)
+{
+   nir_scalar scalar = nir_scalar_resolved(value, lane);
+   CHECK(nir_scalar_is_const(scalar));
+   return nir_scalar_as_uint(scalar);
+}
+
+static bool
+lane_is_undef(nir_def *value, unsigned lane)
+{
+   nir_scalar scalar = nir_scalar_resolved(value, lane);
+   return nir_def_instr(scalar.def)->type == nir_instr_type_undef;
+}
+
+static void
+check_format(VkFormat format, unsigned components)
+{
+   struct vk_render_pass_state rp = {
+      .color_attachment_count = 1,
+      .color_attachment_formats = {format},
+   };
+   struct vk_graphics_pipeline_state state = {.rp = &rp};
+
+   nir_shader *nir = build_fragment_store(components);
+   const bool progress = kk_nir_lower_fragment_output_swizzle(nir, &state);
+
+   const struct kk_va_format *supported =
+      kk_get_va_format(vk_format_to_pipe_format(format));
+   CHECK(supported != NULL);
+
+   nir_intrinsic_instr *store = find_store(nir);
+   CHECK(store != NULL);
+
+   if (supported->is_native) {
+      CHECK(!progress);
+      CHECK(store->num_components == components);
+      ralloc_free(nir);
+      return;
+   }
+
+   /* Every lane is written, in the hardware's order, and the mask names the
+    * lanes the Vulkan channels the shader wrote actually live in. */
+   CHECK(progress);
+   CHECK(store->num_components == 4);
+   CHECK(nir_intrinsic_component(store) == 0);
+
+   unsigned expected_mask = 0;
+   for (unsigned i = 0; i < components; ++i)
+      expected_mask |= BITFIELD_BIT(supported->unswizzle.channels[i]);
+   CHECK(nir_intrinsic_write_mask(store) == expected_mask);
+
+   nir_def *value = store->src[0].ssa;
+   CHECK(value->num_components == 4);
+   for (unsigned i = 0; i < components; ++i) {
+      const unsigned lane = supported->unswizzle.channels[i];
+      CHECK(lane_value(value, lane) == 0x10u + i);
+   }
+   for (unsigned lane = 0; lane < 4; ++lane) {
+      if (expected_mask & BITFIELD_BIT(lane))
+         continue;
+      CHECK(lane_is_undef(value, lane));
+   }
+   ralloc_free(nir);
+}
+
+int
+main(void)
+{
+   glsl_type_singleton_init_or_ref();
+
+   static const VkFormat formats[] = {
+      VK_FORMAT_B4G4R4A4_UNORM_PACK16,
+      VK_FORMAT_R4G4B4A4_UNORM_PACK16,
+      VK_FORMAT_R8G8B8A8_UNORM,
+   };
+
+   for (unsigned f = 0; f < ARRAY_SIZE(formats); ++f)
+      for (unsigned components = 1; components <= 4; ++components)
+         check_format(formats[f], components);
+
+   glsl_type_singleton_decref();
+   printf("fragment output swizzle: ok\n");
+   return 0;
+}
