index 0000000000000000000000000000000000000000..a99be20458da387cf5b3d63187d3564ac977b2a9
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_nir_lower_fragment_output_swizzle.c
@@ -0,0 +1,125 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Metal refuses a swizzled view of a renderable texture, so a colour format
+ * whose channels Metal only offers in another order is rendered to through
+ * the hardware's order and the shader moves the channels itself.
+ *
+ * A store names the attachment channels it writes as the leading lanes of the
+ * store, so reordering the stored value alone cannot move a channel: the
+ * hardware lane a Vulkan channel belongs in may be past the store's width and
+ * never written at all. Rebuild such a store over all four lanes in the
+ * hardware's order and let its write mask name the lanes the shader actually
+ * wrote; a load reads every lane and picks the Vulkan channels back out.
+ */
+
+#include "kk_shader.h"
+
+#include "kk_format.h"
+
+#include "nir_builder.h"
+#include "vk_format.h"
+#include "vk_graphics_state.h"
+
+static const struct kk_va_format *
+attachment_format(nir_intrinsic_instr *intrin,
+                  const struct vk_graphics_pipeline_state *state)
+{
+   unsigned slot = nir_intrinsic_io_semantics(intrin).location;
+   if (slot < FRAG_RESULT_DATA0 || slot > FRAG_RESULT_DATA7)
+      return NULL;
+
+   VkFormat vk_format =
+      state->rp->color_attachment_formats[slot - FRAG_RESULT_DATA0];
+   if (vk_format == VK_FORMAT_UNDEFINED)
+      return NULL;
+
+   enum pipe_format format = vk_format_to_pipe_format(vk_format);
+   const struct kk_va_format *supported_format = kk_get_va_format(format);
+   if (supported_format == NULL || supported_format->is_native)
+      return NULL;
+
+   return supported_format;
+}
+
+static bool
+lower_fragment_output_swizzle(nir_builder *b, nir_intrinsic_instr *intrin,
+                              void *data)
+{
+   if (intrin->intrinsic != nir_intrinsic_store_output &&
+       intrin->intrinsic != nir_intrinsic_load_output)
+      return false;
+
+   const struct vk_graphics_pipeline_state *state =
+      (const struct vk_graphics_pipeline_state *)data;
+   const struct kk_va_format *supported_format =
+      attachment_format(intrin, state);
+   if (supported_format == NULL)
+      return false;
+
+   /* The hardware lane a Vulkan channel lives in. */
+   const unsigned channel_unswizzle[] = {
+      supported_format->unswizzle.red, supported_format->unswizzle.green,
+      supported_format->unswizzle.blue, supported_format->unswizzle.alpha};
+   /* Its inverse: the Vulkan channel a hardware lane holds. */
+   unsigned channel_swizzle[4] = {0u};
+   for (uint32_t i = 0u; i < 4u; ++i)
+      channel_swizzle[channel_unswizzle[i]] = i;
+
+   const unsigned component = nir_intrinsic_component(intrin);
+
+   if (intrin->intrinsic == nir_intrinsic_store_output) {
+      const unsigned write_mask = nir_intrinsic_write_mask(intrin);
+      nir_def *value = intrin->src[0].ssa;
+      assert(component + value->num_components <= 4u);
+
+      b->cursor = nir_before_instr(&intrin->instr);
+      nir_def *undefined = nir_undef(b, 1, value->bit_size);
+      nir_def *vulkan_order[4] = {undefined, undefined, undefined, undefined};
+      unsigned hardware_mask = 0u;
+      for (uint32_t i = 0u; i < value->num_components; ++i) {
+         if (!(write_mask & BITFIELD_BIT(i)))
+            continue;
+         vulkan_order[component + i] = nir_channel(b, value, i);
+         hardware_mask |= BITFIELD_BIT(channel_unswizzle[component + i]);
+      }
+
+      nir_def *hardware_order[4];
+      for (uint32_t i = 0u; i < 4u; ++i)
+         hardware_order[i] = vulkan_order[channel_swizzle[i]];
+
+      nir_src_rewrite(&intrin->src[0], nir_vec(b, hardware_order, 4u));
+      intrin->num_components = 4u;
+      nir_intrinsic_set_write_mask(intrin, hardware_mask);
+      nir_intrinsic_set_component(intrin, 0u);
+      return true;
+   }
+
+   const unsigned num_components = intrin->def.num_components;
+   assert(component + num_components <= 4u);
+
+   unsigned swizzle[4];
+   for (uint32_t i = 0u; i < num_components; ++i)
+      swizzle[i] = channel_unswizzle[component + i];
+
+   intrin->def.num_components = 4u;
+   intrin->num_components = 4u;
+   nir_intrinsic_set_component(intrin, 0u);
+
+   b->cursor = nir_after_instr(&intrin->instr);
+   nir_def *unswizzled =
+      nir_swizzle(b, &intrin->def, swizzle, num_components);
+   nir_def_rewrite_uses_after(&intrin->def, unswizzled);
+   return true;
+}
+
+bool
+kk_nir_lower_fragment_output_swizzle(
+   nir_shader *nir, const struct vk_graphics_pipeline_state *state)
+{
+   assert(nir->info.stage == MESA_SHADER_FRAGMENT);
+   return nir_shader_intrinsics_pass(nir, lower_fragment_output_swizzle,
+                                     nir_metadata_control_flow, (void *)state);
+}
