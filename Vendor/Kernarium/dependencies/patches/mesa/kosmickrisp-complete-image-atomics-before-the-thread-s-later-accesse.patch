diff --git a/src/kosmickrisp/compiler/nir_to_msl.c b/src/kosmickrisp/compiler/nir_to_msl.c
index 91ed11fad6f28cc5309d3153403f26cb8807bc16..8fa23b4077e5553c0071de0ca4466036c0e5c151 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.c
+++ b/src/kosmickrisp/compiler/nir_to_msl.c
@@ -309,6 +309,65 @@ msl_emit_terminate(struct nir_to_msl_ctx *ctx)
    P_IND(ctx, "return {};\n");
 }
 
+/* KK_WORKAROUND_20 */
+static void
+msl_issue_image_atomic(struct nir_to_msl_ctx *ctx)
+{
+   if (!(ctx->disabled_workarounds & BITFIELD64_BIT(20)))
+      ctx->image_atomics_unordered = true;
+}
+
+/* KK_WORKAROUND_20 */
+static void
+msl_complete_image_atomics(struct nir_to_msl_ctx *ctx)
+{
+   if (!ctx->image_atomics_unordered)
+      return;
+
+   P_IND(ctx, "atomic_thread_fence(mem_flags::mem_device | "
+              "mem_flags::mem_texture, memory_order_seq_cst, "
+              "thread_scope::thread_scope_device);\n");
+   ctx->image_atomics_unordered = false;
+}
+
+/* KK_WORKAROUND_20 */
+static bool
+msl_intrinsic_needs_image_atomics_complete(nir_intrinsic_op op)
+{
+   switch (op) {
+   case nir_intrinsic_bindless_image_load:
+   case nir_intrinsic_bindless_image_store:
+   case nir_intrinsic_load_global:
+   case nir_intrinsic_store_global:
+   case nir_intrinsic_global_atomic:
+   case nir_intrinsic_global_atomic_swap:
+   case nir_intrinsic_barrier:
+   case nir_intrinsic_terminate:
+   case nir_intrinsic_terminate_if:
+   case nir_intrinsic_printf_abort:
+      return true;
+   default:
+      return false;
+   }
+}
+
+/* KK_WORKAROUND_20 */
+static bool
+msl_cf_node_has_image_atomic(nir_cf_node *node)
+{
+   nir_foreach_block_in_cf_node(block, node) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_op op = nir_instr_as_intrinsic(instr)->intrinsic;
+         if (op == nir_intrinsic_bindless_image_atomic ||
+             op == nir_intrinsic_bindless_image_atomic_swap)
+            return true;
+      }
+   }
+   return false;
+}
+
 /* KK_WORKAROUND_17 */
 static bool
 msl_coherent_scalar_is_atomic(const char *scalar_type)
@@ -1508,6 +1567,10 @@ intrinsic_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
        instr->intrinsic == nir_intrinsic_load_barycentric_at_offset)
       return;
 
+   /* KK_WORKAROUND_20 */
+   if (msl_intrinsic_needs_image_atomics_complete(instr->intrinsic))
+      msl_complete_image_atomics(ctx);
+
    const nir_intrinsic_info *info = &nir_intrinsic_infos[instr->intrinsic];
    if (instrinsic_needs_dest_type(instr)) {
       P_IND(ctx, "t%d = ", instr->def.index);
@@ -2054,6 +2117,7 @@ intrinsic_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
       P(ctx, ", ");
       src_to_msl(ctx, &instr->src[3]);
       P(ctx, ").x;\n");
+      msl_issue_image_atomic(ctx);
       break;
    case nir_intrinsic_bindless_image_atomic_swap: {
       const char *type = msl_type_for_def(ctx->types, &instr->def);
@@ -2066,6 +2130,7 @@ intrinsic_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
       P(ctx, ", &ta%d, ", instr->def.index);
       src_to_msl(ctx, &instr->src[4]);
       P(ctx, "); %s t%d = ta%d.x;\n", type, instr->def.index, instr->def.index);
+      msl_issue_image_atomic(ctx);
       break;
    }
    case nir_intrinsic_bindless_image_fence_kk: {
@@ -2558,6 +2623,9 @@ cf_node_to_metal(struct nir_to_msl_ctx *ctx, nir_cf_node *node)
    }
    case nir_cf_node_if: {
       nir_if *ifnode = nir_cf_node_as_if(node);
+      /* KK_WORKAROUND_20: each branch starts from the state before the if, and
+       * an atomic either branch leaves unordered follows the if. */
+      const bool unordered = ctx->image_atomics_unordered;
       P_IND(ctx, "if (");
       src_to_msl(ctx, &ifnode->condition);
       P(ctx, ") {\n");
@@ -2566,6 +2634,8 @@ cf_node_to_metal(struct nir_to_msl_ctx *ctx, nir_cf_node *node)
          cf_node_to_metal(ctx, node);
       }
       ctx->indentlevel--;
+      const bool then_unordered = ctx->image_atomics_unordered;
+      ctx->image_atomics_unordered = unordered;
       if (!nir_cf_list_is_empty_block(&ifnode->else_list)) {
          P_IND(ctx, "} else {\n");
          ctx->indentlevel++;
@@ -2574,6 +2644,7 @@ cf_node_to_metal(struct nir_to_msl_ctx *ctx, nir_cf_node *node)
          }
          ctx->indentlevel--;
       }
+      ctx->image_atomics_unordered |= then_unordered;
       P_IND(ctx, "}\n");
       break;
    }
@@ -2589,11 +2660,20 @@ cf_node_to_metal(struct nir_to_msl_ctx *ctx, nir_cf_node *node)
                "; ++no_crash) {\n",
                UINT64_MAX);
       }
+      /* KK_WORKAROUND_20: an atomic anywhere in the body may precede every
+       * iteration's accesses and whatever follows the loop, and a break can
+       * leave before a fence the body emits. */
+      const bool unordered =
+         ctx->image_atomics_unordered ||
+         (!(ctx->disabled_workarounds & BITFIELD64_BIT(20)) &&
+          msl_cf_node_has_image_atomic(node));
+      ctx->image_atomics_unordered = unordered;
       ctx->indentlevel++;
       foreach_list_typed(nir_cf_node, node, node, &loop->body) {
          cf_node_to_metal(ctx, node);
       }
       ctx->indentlevel--;
+      ctx->image_atomics_unordered = unordered;
       P_IND(ctx, "}\n");
       break;
    }
@@ -2938,6 +3018,8 @@ nir_to_msl(nir_shader *shader, struct nir_to_msl_options *options)
    foreach_list_typed(nir_cf_node, node, node, &impl->body) {
       cf_node_to_metal(&ctx, node);
    }
+   /* KK_WORKAROUND_20 */
+   msl_complete_image_atomics(&ctx);
    emit_output_return(&ctx, shader);
    ctx.indentlevel--;
    P(&ctx, "}\n");
