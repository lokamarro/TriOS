diff --git a/src/kosmickrisp/vulkan/tests/test_image_atomic_order.c b/src/kosmickrisp/vulkan/tests/test_image_atomic_order.c
new file mode 100644
index 0000000000000000000000000000000000000000..f8cdbd5ec07d7bdc651e22a90402cc6abe3ea9ca
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_image_atomic_order.c
@@ -0,0 +1,319 @@
+/* SPDX-License-Identifier: MIT */
+
+/* An image atomic whose result a shader does not use must still be ordered
+ * before the same invocation's later accesses to that texel: a load that
+ * follows it has to return what the atomic left, and a store that follows it
+ * has to be the value the texel keeps.  Metal issues such an atomic without
+ * waiting for it, and the texture fence the driver places after it does not
+ * order it, so without KK_WORKAROUND_20 a load now and then returns the value
+ * from before the atomic and a later store now and then lands before it.  The
+ * loss hits a SIMD group at a time and is rare; it comes more often the
+ * busier the GPU is.
+ *
+ * Every dispatch here runs one of the two shapes over a 64x64 image pair, many
+ * dispatches to a command buffer, and every texel of every pair is checked.
+ * The test fails on any texel that is wrong.  With
+ * MESA_KK_DISABLE_WORKAROUNDS=20, `--expect-loss` makes it fail instead when
+ * no texel was lost, which is how it reproduces the defect. */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan_core.h>
+
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "kk_test.h"
+
+static const uint32_t read_comp[] =
+#include "image_atomic_order_shaders/read.comp.h"
+   ;
+static const uint32_t write_comp[] =
+#include "image_atomic_order_shaders/write.comp.h"
+   ;
+
+#define SIZE         64u
+#define TEXELS       (SIZE * SIZE)
+#define PAIRS        64u
+#define ITERATIONS   2000u
+
+int
+main(int argc, char **argv)
+{
+   const bool expect_loss = argc > 1 && strcmp(argv[1], "--expect-loss") == 0;
+   const uint32_t iterations =
+      argc > 2 ? (uint32_t)strtoul(argv[2], NULL, 0) : ITERATIONS;
+
+   struct kk_test_device t;
+   kk_test_create_instance(&t, NULL);
+   kk_test_create_device(&t, NULL, NULL, 0, NULL);
+   KK_LOAD_DEVICE_FUNCTIONS(t);
+   LOAD_D(vkCreateDescriptorSetLayout);
+   LOAD_D(vkDestroyDescriptorSetLayout);
+   LOAD_D(vkCreateComputePipelines);
+   LOAD_D(vkCreateDescriptorPool);
+   LOAD_D(vkDestroyDescriptorPool);
+   LOAD_D(vkAllocateDescriptorSets);
+   LOAD_D(vkUpdateDescriptorSets);
+   LOAD_D(vkCmdBindDescriptorSets);
+   LOAD_D(vkCmdDispatch);
+
+   /* Each pair: the image the atomic targets and the one its result is
+    * copied to. */
+   VkImage images[PAIRS][2];
+   VkDeviceMemory image_memory[PAIRS][2];
+   VkImageView views[PAIRS][2];
+   for (uint32_t p = 0; p < PAIRS; p++) {
+      for (uint32_t i = 0; i < 2; i++) {
+         VkImageCreateInfo info = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+            .imageType = VK_IMAGE_TYPE_2D,
+            .format = VK_FORMAT_R32_UINT,
+            .extent = {SIZE, SIZE, 1},
+            .mipLevels = 1,
+            .arrayLayers = 1,
+            .samples = VK_SAMPLE_COUNT_1_BIT,
+            .tiling = VK_IMAGE_TILING_OPTIMAL,
+            .usage = VK_IMAGE_USAGE_STORAGE_BIT |
+                     VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+            .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+         };
+         VK_CHECK(vkCreateImage(device, &info, NULL, &images[p][i]));
+         image_memory[p][i] = kk_test_image_memory(
+            &t, images[p][i], VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+         views[p][i] = kk_test_image_view(&t, images[p][i],
+                                          VK_IMAGE_VIEW_TYPE_2D,
+                                          VK_FORMAT_R32_UINT,
+                                          VK_IMAGE_ASPECT_COLOR_BIT, 0, 1);
+      }
+   }
+
+   VkBuffer readback = VK_NULL_HANDLE;
+   VkDeviceMemory readback_memory = VK_NULL_HANDLE;
+   void *mapped = NULL;
+   kk_test_buffer(&t, (VkDeviceSize)PAIRS * 2u * TEXELS * sizeof(uint32_t),
+                  VK_BUFFER_USAGE_TRANSFER_DST_BIT, KK_TEST_HOST_MEMORY,
+                  &readback, &readback_memory, &mapped);
+   const volatile uint32_t *words = mapped;
+
+   const VkDescriptorSetLayoutBinding bindings[] = {
+      {0, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1, VK_SHADER_STAGE_COMPUTE_BIT,
+       NULL},
+      {1, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1, VK_SHADER_STAGE_COMPUTE_BIT,
+       NULL},
+   };
+   VkDescriptorSetLayoutCreateInfo set_layout_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+      .bindingCount = 2,
+      .pBindings = bindings,
+   };
+   VkDescriptorSetLayout set_layout = VK_NULL_HANDLE;
+   VK_CHECK(vkCreateDescriptorSetLayout(device, &set_layout_info, NULL,
+                                        &set_layout));
+   VkPipelineLayoutCreateInfo layout_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+      .setLayoutCount = 1,
+      .pSetLayouts = &set_layout,
+   };
+   VkPipelineLayout pipeline_layout = VK_NULL_HANDLE;
+   VK_CHECK(vkCreatePipelineLayout(device, &layout_info, NULL,
+                                   &pipeline_layout));
+
+   /* Shape 0 reads the texel after the atomic, shape 1 overwrites it. */
+   VkShaderModule modules[2] = {
+      kk_test_shader_module(&t, read_comp, sizeof(read_comp)),
+      kk_test_shader_module(&t, write_comp, sizeof(write_comp)),
+   };
+   VkPipeline pipelines[2];
+   for (uint32_t s = 0; s < 2; s++) {
+      VkComputePipelineCreateInfo pipeline_info = {
+         .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+         .stage =
+            {
+               .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+               .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+               .module = modules[s],
+               .pName = "main",
+            },
+         .layout = pipeline_layout,
+      };
+      VK_CHECK(vkCreateComputePipelines(device, VK_NULL_HANDLE, 1,
+                                        &pipeline_info, NULL, &pipelines[s]));
+   }
+
+   const VkDescriptorPoolSize pool_size = {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+                                           2u * PAIRS};
+   VkDescriptorPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+      .maxSets = PAIRS,
+      .poolSizeCount = 1,
+      .pPoolSizes = &pool_size,
+   };
+   VkDescriptorPool descriptor_pool = VK_NULL_HANDLE;
+   VK_CHECK(vkCreateDescriptorPool(device, &pool_info, NULL,
+                                   &descriptor_pool));
+   VkDescriptorSet sets[PAIRS];
+   for (uint32_t p = 0; p < PAIRS; p++) {
+      VkDescriptorSetAllocateInfo set_info = {
+         .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+         .descriptorPool = descriptor_pool,
+         .descriptorSetCount = 1,
+         .pSetLayouts = &set_layout,
+      };
+      VK_CHECK(vkAllocateDescriptorSets(device, &set_info, &sets[p]));
+      VkDescriptorImageInfo image_infos[2] = {
+         {VK_NULL_HANDLE, views[p][0], VK_IMAGE_LAYOUT_GENERAL},
+         {VK_NULL_HANDLE, views[p][1], VK_IMAGE_LAYOUT_GENERAL},
+      };
+      VkWriteDescriptorSet write = {
+         .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+         .dstSet = sets[p],
+         .dstBinding = 0,
+         .descriptorCount = 2,
+         .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+         .pImageInfo = image_infos,
+      };
+      vkUpdateDescriptorSets(device, 1, &write, 0, NULL);
+   }
+
+   VkCommandPool command_pool = VK_NULL_HANDLE;
+   VkCommandBuffer command = VK_NULL_HANDLE;
+   kk_test_command_buffer(&t, VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+                          &command_pool, &command);
+
+   const VkImageSubresourceRange range = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0,
+                                          1};
+   uint64_t lost[2] = {0, 0}, lost_dispatches[2] = {0, 0};
+   for (uint32_t iteration = 0; iteration < iterations; iteration++) {
+      const uint32_t shape = iteration & 1u;
+      VkCommandBufferBeginInfo begin = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+         .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+      };
+      VK_CHECK(vkBeginCommandBuffer(command, &begin));
+
+      /* The previous iteration's copies, or nothing, come before the
+       * shader writes. */
+      VkImageMemoryBarrier to_shader[2 * PAIRS];
+      for (uint32_t p = 0; p < PAIRS; p++) {
+         for (uint32_t i = 0; i < 2; i++) {
+            to_shader[2 * p + i] = (VkImageMemoryBarrier){
+               .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+               .srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+               .dstAccessMask =
+                  VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT,
+               .oldLayout = iteration ? VK_IMAGE_LAYOUT_GENERAL
+                                      : VK_IMAGE_LAYOUT_UNDEFINED,
+               .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+               .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+               .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+               .image = images[p][i],
+               .subresourceRange = range,
+            };
+         }
+      }
+      vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 0, NULL,
+                           0, NULL, 2 * PAIRS, to_shader);
+
+      vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_COMPUTE,
+                        pipelines[shape]);
+      for (uint32_t p = 0; p < PAIRS; p++) {
+         vkCmdBindDescriptorSets(command, VK_PIPELINE_BIND_POINT_COMPUTE,
+                                 pipeline_layout, 0, 1, &sets[p], 0, NULL);
+         vkCmdDispatch(command, SIZE / 8u, SIZE / 8u, 1);
+      }
+
+      VkMemoryBarrier to_copy = {
+         .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+         .srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT,
+         .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+      };
+      vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &to_copy, 0,
+                           NULL, 0, NULL);
+      for (uint32_t p = 0; p < PAIRS; p++) {
+         for (uint32_t i = 0; i < 2; i++) {
+            VkBufferImageCopy region = {
+               .bufferOffset =
+                  (VkDeviceSize)(2u * p + i) * TEXELS * sizeof(uint32_t),
+               .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+               .imageExtent = {SIZE, SIZE, 1},
+            };
+            vkCmdCopyImageToBuffer(command, images[p][i],
+                                   VK_IMAGE_LAYOUT_GENERAL, readback, 1,
+                                   &region);
+         }
+      }
+      VkMemoryBarrier to_host = {
+         .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+         .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+         .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+      };
+      vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &to_host, 0,
+                           NULL, 0, NULL);
+      VK_CHECK(vkEndCommandBuffer(command));
+      VK_CHECK(kk_test_submit_and_wait(&t, command, 10ull * 1000000000ull));
+
+      for (uint32_t p = 0; p < PAIRS; p++) {
+         const volatile uint32_t *sums = words + (size_t)(2u * p) * TEXELS;
+         const volatile uint32_t *copies = sums + TEXELS;
+         uint32_t wrong = 0, first = 0;
+         for (uint32_t texel = 0; texel < TEXELS; texel++) {
+            const uint32_t sum = texel % SIZE + texel / SIZE;
+            if (sums[texel] != sum || copies[texel] != sum) {
+               if (!wrong)
+                  first = texel;
+               wrong++;
+            }
+         }
+         if (wrong) {
+            if (lost_dispatches[shape] < 8) {
+               fprintf(stderr,
+                       "iteration %u pair %u (%s): %u texel(s) wrong, first "
+                       "(%u,%u) holds %u and copied %u, sum %u\n",
+                       iteration, p, shape ? "write" : "read", wrong,
+                       first % SIZE, first / SIZE, sums[first], copies[first],
+                       first % SIZE + first / SIZE);
+            }
+            lost[shape] += wrong;
+            lost_dispatches[shape]++;
+         }
+      }
+   }
+
+   printf("%u dispatches of each shape: read lost %llu texel(s) in %llu, "
+          "write lost %llu texel(s) in %llu\n",
+          iterations / 2u * PAIRS, (unsigned long long)lost[0],
+          (unsigned long long)lost_dispatches[0], (unsigned long long)lost[1],
+          (unsigned long long)lost_dispatches[1]);
+   if (expect_loss)
+      CHECK(lost_dispatches[0] + lost_dispatches[1] > 0);
+   else
+      CHECK(lost_dispatches[0] + lost_dispatches[1] == 0);
+
+   vkDestroyCommandPool(device, command_pool, NULL);
+   vkDestroyDescriptorPool(device, descriptor_pool, NULL);
+   for (uint32_t s = 0; s < 2; s++) {
+      vkDestroyPipeline(device, pipelines[s], NULL);
+      vkDestroyShaderModule(device, modules[s], NULL);
+   }
+   vkDestroyPipelineLayout(device, pipeline_layout, NULL);
+   vkDestroyDescriptorSetLayout(device, set_layout, NULL);
+   vkDestroyBuffer(device, readback, NULL);
+   vkFreeMemory(device, readback_memory, NULL);
+   for (uint32_t p = 0; p < PAIRS; p++) {
+      for (uint32_t i = 0; i < 2; i++) {
+         vkDestroyImageView(device, views[p][i], NULL);
+         vkDestroyImage(device, images[p][i], NULL);
+         vkFreeMemory(device, image_memory[p][i], NULL);
+      }
+   }
+   kk_test_destroy(&t);
+   if (!expect_loss)
+      printf("an image atomic is ordered before the invocation's later "
+             "accesses to its texel\n");
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_msl_image_atomic_order.c b/src/kosmickrisp/vulkan/tests/test_msl_image_atomic_order.c
new file mode 100644
index 0000000000000000000000000000000000000000..8eee42eec04d415f5002f5801ab683f97164772c
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_msl_image_atomic_order.c
@@ -0,0 +1,188 @@
+/* SPDX-License-Identifier: MIT */
+
+/* Metal issues an image atomic whose result goes unused without waiting for
+ * it, and only a fence over device and texture memory at device scope orders
+ * it before the invocation's later accesses.  See KK_WORKAROUND_20.  The
+ * translation emits that fence once, before the first access that follows
+ * any number of atomics - an image or global access, a barrier or a
+ * termination - or at the end of the shader, and not between the atomics.
+ * Disabling the workaround emits no fence at all.
+ */
+
+#include "compiler/glsl_types.h"
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+#include "kosmickrisp/compiler/nir_to_msl.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "kk_test.h"
+
+#define FENCE                                                                  \
+   "atomic_thread_fence(mem_flags::mem_device | mem_flags::mem_texture, "     \
+   "memory_order_seq_cst, thread_scope::thread_scope_device);"
+
+enum shape {
+   /* An atomic and an exchange, then a load of the texel and a global store
+    * of what it read. */
+   SHAPE_STRAIGHT,
+   /* A histogram: the atomic is the last thing the kernel does. */
+   SHAPE_TAIL,
+   /* Atomics in a loop of unknown trip count, then a load. */
+   SHAPE_LOOP,
+};
+
+struct image {
+   nir_def *handle, *coord, *sample;
+};
+
+static void
+atomic_add(nir_builder *b, struct image *image, nir_def *value)
+{
+   nir_bindless_image_atomic(b, 32, image->handle, image->coord, image->sample,
+                             value, .image_dim = GLSL_SAMPLER_DIM_2D,
+                             .format = PIPE_FORMAT_R32_UINT,
+                             .access = ACCESS_COHERENT,
+                             .atomic_op = nir_atomic_op_iadd);
+}
+
+static void
+load_and_store(nir_builder *b, struct image *image)
+{
+   nir_def *loaded = nir_bindless_image_load(
+      b, 4, 32, image->handle, image->coord, image->sample, nir_imm_int(b, 0),
+      .image_dim = GLSL_SAMPLER_DIM_2D, .format = PIPE_FORMAT_R32_UINT,
+      .access = ACCESS_COHERENT, .dest_type = nir_type_uint32);
+   nir_store_global(b, nir_channel(b, loaded, 0), nir_imm_int64(b, 0x20000),
+                    .align_mul = 4);
+}
+
+static char *
+translate(enum shape shape, uint64_t disabled_workarounds)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_COMPUTE, &kk_nir_options, "msl image atomic order");
+   nir_shader *nir = b.shader;
+   nir->info.workgroup_size[0] = 1;
+   nir->info.workgroup_size[1] = 1;
+   nir->info.workgroup_size[2] = 1;
+
+   nir_def *id = nir_load_global_invocation_id(&b, 32);
+   struct image image = {
+      .handle = nir_load_texture_handle_kk(
+         &b, 1, 64, nir_imm_int64(&b, 0x10000), .dest_type = nir_type_uint32,
+         .image_dim = GLSL_SAMPLER_DIM_2D, .image_array = false,
+         .access = ACCESS_COHERENT, .flags = MSL_ACCESS_READ_WRITE),
+      .coord = nir_vec4(&b, nir_channel(&b, id, 0), nir_channel(&b, id, 1),
+                        nir_imm_int(&b, 0), nir_imm_int(&b, 0)),
+      .sample = nir_imm_int(&b, 0),
+   };
+
+   switch (shape) {
+   case SHAPE_STRAIGHT:
+      atomic_add(&b, &image, nir_channel(&b, id, 0));
+      nir_bindless_image_atomic_swap(&b, 32, image.handle, image.coord,
+                                     image.sample, nir_imm_int(&b, 0),
+                                     nir_imm_int(&b, 1),
+                                     .image_dim = GLSL_SAMPLER_DIM_2D,
+                                     .format = PIPE_FORMAT_R32_UINT,
+                                     .access = ACCESS_COHERENT,
+                                     .atomic_op = nir_atomic_op_cmpxchg);
+      load_and_store(&b, &image);
+      break;
+   case SHAPE_TAIL:
+      atomic_add(&b, &image, nir_imm_int(&b, 1));
+      break;
+   case SHAPE_LOOP: {
+      nir_variable *index =
+         nir_local_variable_create(b.impl, glsl_uint_type(), "index");
+      nir_store_var(&b, index, nir_imm_int(&b, 0), 0x1);
+      nir_push_loop(&b);
+      {
+         nir_def *i = nir_load_var(&b, index);
+         nir_push_if(&b, nir_uge(&b, i, nir_channel(&b, id, 2)));
+         {
+            nir_jump(&b, nir_jump_break);
+         }
+         nir_pop_if(&b, NULL);
+         atomic_add(&b, &image, i);
+         nir_store_var(&b, index, nir_iadd_imm(&b, i, 1), 0x1);
+      }
+      nir_pop_loop(&b, NULL);
+      load_and_store(&b, &image);
+      break;
+   }
+   }
+
+   nir_validate_shader(nir, "msl image atomic order");
+   msl_optimize_nir(nir);
+   nir_shader_gather_info(nir, nir_shader_get_entrypoint(nir));
+
+   struct nir_to_msl_options options = {
+      .disabled_workarounds = disabled_workarounds,
+   };
+   char *msl = nir_to_msl(nir, &options);
+   CHECK(msl != NULL);
+   ralloc_free(nir);
+   return msl;
+}
+
+static unsigned
+count(const char *text, const char *needle)
+{
+   unsigned found = 0;
+   for (const char *at = strstr(text, needle); at != NULL;
+        at = strstr(at + 1, needle))
+      found++;
+   return found;
+}
+
+/* Where `needle` occurs, which it must, exactly once. */
+static const char *
+find_once(const char *text, const char *needle)
+{
+   CHECK(count(text, needle) == 1);
+   return strstr(text, needle);
+}
+
+int
+main(void)
+{
+   glsl_type_singleton_init_or_ref();
+
+   /* One fence, after both atomics and before the load. */
+   char *straight = translate(SHAPE_STRAIGHT, 0);
+   const char *fence = find_once(straight, FENCE);
+   CHECK(find_once(straight, ".atomic_fetch_add(") < fence);
+   CHECK(find_once(straight, ".atomic_compare_exchange_weak(") < fence);
+   CHECK(fence < find_once(straight, ".read("));
+
+   /* The fence ends the kernel, after the atomic. */
+   char *tail = translate(SHAPE_TAIL, 0);
+   fence = find_once(tail, FENCE);
+   CHECK(find_once(tail, ".atomic_fetch_add(") < fence);
+   CHECK(strspn(fence + strlen(FENCE), " \n}") == strlen(fence + strlen(FENCE)));
+
+   /* Nothing inside the loop needs the atomics complete, so the one fence
+    * follows the loop and precedes the load. */
+   char *loop = translate(SHAPE_LOOP, 0);
+   fence = find_once(loop, FENCE);
+   CHECK(find_once(loop, ".atomic_fetch_add(") < fence);
+   CHECK(fence < find_once(loop, ".read("));
+
+   for (unsigned shape = SHAPE_STRAIGHT; shape <= SHAPE_LOOP; shape++) {
+      char *unordered = translate(shape, BITFIELD64_BIT(20));
+      CHECK(count(unordered, ".atomic_fetch_add(") == 1);
+      CHECK(count(unordered, "atomic_thread_fence") == 0);
+      ralloc_free(unordered);
+   }
+
+   printf("msl image atomic order PASS\n");
+   ralloc_free(straight);
+   ralloc_free(tail);
+   ralloc_free(loop);
+   glsl_type_singleton_decref();
+   return 0;
+}
