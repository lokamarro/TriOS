diff --git a/src/kosmickrisp/vulkan/tests/image_atomic_order_shaders/write.comp b/src/kosmickrisp/vulkan/tests/image_atomic_order_shaders/write.comp
new file mode 100644
index 0000000000000000000000000000000000000000..3b51429cf82bdf4ff63c7cb6681a22161e7a05d8
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/image_atomic_order_shaders/write.comp
@@ -0,0 +1,20 @@
+#version 450
+
+/* Zero a texel, add to it atomically without using the result, then
+ * overwrite it: the texel must end up holding the value written last. */
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(set = 0, binding = 0, r32ui) uniform coherent uimage2D sums;
+layout(set = 0, binding = 1, r32ui) uniform uimage2D copies;
+
+void main()
+{
+   ivec2 c = ivec2(gl_GlobalInvocationID.xy);
+   uint sum = uint(c.x + c.y);
+   imageStore(sums, c, uvec4(0u));
+   memoryBarrierImage();
+   imageAtomicAdd(sums, c, 1000u);
+   memoryBarrierImage();
+   imageStore(sums, c, uvec4(sum));
+   imageStore(copies, c, uvec4(sum));
+}
