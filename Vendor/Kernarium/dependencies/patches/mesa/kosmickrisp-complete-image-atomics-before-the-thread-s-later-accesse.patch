diff --git a/src/kosmickrisp/vulkan/tests/image_atomic_order_shaders/read.comp b/src/kosmickrisp/vulkan/tests/image_atomic_order_shaders/read.comp
new file mode 100644
index 0000000000000000000000000000000000000000..cbf0492f9fcd29b072f03a639c23d9fb2934c496
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/image_atomic_order_shaders/read.comp
@@ -0,0 +1,19 @@
+#version 450
+
+/* The shape of KHR-GLES31.core.compute_shader.resource-image: zero a texel,
+ * add its coordinate sum atomically without using the result, and copy what
+ * the texel then reads back into the second image. */
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(set = 0, binding = 0, r32ui) uniform coherent uimage2D sums;
+layout(set = 0, binding = 1, r32ui) uniform uimage2D copies;
+
+void main()
+{
+   ivec2 c = ivec2(gl_GlobalInvocationID.xy);
+   imageStore(sums, c, uvec4(0u));
+   memoryBarrierImage();
+   imageAtomicAdd(sums, c, uint(c.x + c.y));
+   memoryBarrierImage();
+   imageStore(copies, c, imageLoad(sums, c));
+}
