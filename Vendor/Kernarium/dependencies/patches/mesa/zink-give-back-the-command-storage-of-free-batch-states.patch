From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 8 Nov 2026 18:55:03 +0900
Subject: [PATCH] zink: give back the command storage of free batch states

The screen keeps every batch state a context has needed and hands it
to whichever context asks next. A free state keeps its command pools'
upload buffers and the driver's command allocators at the largest size
its batches reached, so after a heavy client exits the screen holds
that storage for as long as it lives: KosmicKrisp keeps up to 32
upload buffers of 128 KiB in each pool, and an Android guest that had
run one WebGL page still held about 540 of them, 68 MiB, after every
application was closed.

zink_screen_release_batch_storage() resets the pools of every free
state with VK_COMMAND_POOL_RESET_RELEASE_RESOURCES_BIT. A context's
destruction calls it, since the contexts that are left need fewer
states, and so does pipe_screen::release_cached_memory, which a host
calls before it refuses an allocation. The next batch to take a state
allocates its storage again.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/gallium/drivers/zink/zink_batch.c   | 23 +++++++++++++++++++++++
 src/gallium/drivers/zink/zink_batch.h   |  3 +++
 src/gallium/drivers/zink/zink_context.c |  2 ++
 src/gallium/drivers/zink/zink_screen.c  |  5 ++++-
 4 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/src/gallium/drivers/zink/zink_batch.c b/src/gallium/drivers/zink/zink_batch.c
index 226d29a183b8dd795009515c1198c163c1bc34d4..4285bae83e310511426833e8334af69899110d98 100644
--- a/src/gallium/drivers/zink/zink_batch.c
+++ b/src/gallium/drivers/zink/zink_batch.c
@@ -474,6 +474,29 @@ reset_active_batch_states(struct zink_screen *screen)
    simple_mtx_unlock(&screen->active_batch_states_lock);
 }
 
+/* A free state keeps the storage of the last batch it recorded: its command
+ * pools keep their upload buffers and the driver keeps the command allocators
+ * behind its command buffers at their largest size.  The screen keeps every
+ * state any context has needed and hands them to whichever context asks next,
+ * so the storage of contexts that are gone stays allocated for as long as the
+ * screen lives.  Give it back; the next batch to take a state allocates what
+ * it needs again.  Returns the number of states released. */
+unsigned
+zink_screen_release_batch_storage(struct zink_screen *screen)
+{
+   unsigned released = 0;
+   simple_mtx_lock(&screen->free_batch_states_lock);
+   for (struct zink_batch_state *bs = screen->free_batch_states; bs; bs = bs->next) {
+      VKSCR(ResetCommandPool)(screen->dev, bs->cmdpool,
+                              VK_COMMAND_POOL_RESET_RELEASE_RESOURCES_BIT);
+      VKSCR(ResetCommandPool)(screen->dev, bs->unsynchronized_cmdpool,
+                              VK_COMMAND_POOL_RESET_RELEASE_RESOURCES_BIT);
+      released++;
+   }
+   simple_mtx_unlock(&screen->free_batch_states_lock);
+   return released;
+}
+
 /* A context that is flushed and then left alone keeps its completed batch
  * states, and every resource object they reference, until its next batch asks
  * for a state; the states it already handed to the screen wait for the next
diff --git a/src/gallium/drivers/zink/zink_batch.h b/src/gallium/drivers/zink/zink_batch.h
index 35e41b099f102f086a064960a1aca1a89cab37ef..19a2f45353480f679439538101afcacc2b9acd52 100644
--- a/src/gallium/drivers/zink/zink_batch.h
+++ b/src/gallium/drivers/zink/zink_batch.h
@@ -51,6 +51,9 @@ zink_batch_reset_all(struct zink_context *ctx);
 void
 zink_batch_trim(struct zink_context *ctx);
 
+unsigned
+zink_screen_release_batch_storage(struct zink_screen *screen);
+
 void
 zink_batch_state_destroy(struct zink_screen *screen, struct zink_batch_state *bs);
 
diff --git a/src/gallium/drivers/zink/zink_context.c b/src/gallium/drivers/zink/zink_context.c
index a4382ff9d62b36bb4551d5df58eb509e05454230..512b3f82eb922b14fbe4587b1015d9403966d1df 100644
--- a/src/gallium/drivers/zink/zink_context.c
+++ b/src/gallium/drivers/zink/zink_context.c
@@ -261,6 +261,8 @@ zink_context_destroy(struct pipe_context *pctx)
    while (screen->last_free_batch_state && screen->last_free_batch_state->next)
       screen->last_free_batch_state = screen->last_free_batch_state->next;
    simple_mtx_unlock(&screen->free_batch_states_lock);
+   /* the contexts left need fewer states than were needed with this one */
+   zink_screen_release_batch_storage(screen);
 
    for (unsigned i = 0; i < 2; i++) {
       if (zink_descriptor_mode == ZINK_DESCRIPTOR_MODE_DB)
diff --git a/src/gallium/drivers/zink/zink_screen.c b/src/gallium/drivers/zink/zink_screen.c
index baeaade195538fb3cd26d0766707c7032dfbaf59..a6689c4167691016a03f07e529cdf4e075dabf59 100644
--- a/src/gallium/drivers/zink/zink_screen.c
+++ b/src/gallium/drivers/zink/zink_screen.c
@@ -1519,7 +1519,10 @@ zink_is_format_supported(struct pipe_screen *pscreen,
 static unsigned
 zink_release_cached_memory(struct pipe_screen *pscreen)
 {
-   return zink_bo_release_cached(zink_screen(pscreen));
+   struct zink_screen *screen = zink_screen(pscreen);
+   /* the driver reports what the command storage gave back itself */
+   zink_screen_release_batch_storage(screen);
+   return zink_bo_release_cached(screen);
 }
 
 static void
