diff --git a/src/kosmickrisp/vulkan/kk_image_view.c b/src/kosmickrisp/vulkan/kk_image_view.c
index 8d1786f8e7ee2212d2547901a53bce9a9d71a94b..9e601ea3333360b63fa253afdcbded153be81eaf 100644
--- a/src/kosmickrisp/vulkan/kk_image_view.c
+++ b/src/kosmickrisp/vulkan/kk_image_view.c
@@ -181,6 +181,22 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
          view->planes[view_plane].sampled_gpu_resource_id =
             mtl_texture_get_gpu_resource_id(
                view->planes[view_plane].mtl_handle_sampled);
+
+         if (dev->vk.enabled_features.nonSeamlessCubeMap &&
+             (view->vk.view_type == VK_IMAGE_VIEW_TYPE_CUBE ||
+              view->vk.view_type == VK_IMAGE_VIEW_TYPE_CUBE_ARRAY)) {
+            struct kk_view_layout array_layout = view_layout;
+            array_layout.view_type = VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+            view->planes[view_plane].mtl_handle_cube_array =
+               mtl_new_texture_view_with(mtl_handle, &array_layout);
+            if (!view->planes[view_plane].mtl_handle_cube_array) {
+               kk_image_view_finish(dev, view);
+               return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+            }
+            view->planes[view_plane].cube_array_gpu_resource_id =
+               mtl_texture_get_gpu_resource_id(
+                  view->planes[view_plane].mtl_handle_cube_array);
+         }
       }
 
       if (view->vk.usage & VK_IMAGE_USAGE_STORAGE_BIT) {
@@ -241,6 +257,9 @@ kk_image_view_finish(struct kk_device *dev, struct kk_image_view *view)
       if (view->planes[plane].mtl_handle_sampled)
          mtl_release(view->planes[plane].mtl_handle_sampled);
 
+      if (view->planes[plane].mtl_handle_cube_array)
+         mtl_release(view->planes[plane].mtl_handle_cube_array);
+
       if (view->planes[plane].mtl_handle_storage)
          mtl_release(view->planes[plane].mtl_handle_storage);
 
