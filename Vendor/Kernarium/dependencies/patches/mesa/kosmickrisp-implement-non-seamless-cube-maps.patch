diff --git a/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c b/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
index f1f7f63a6a403c1dd84fa546252f0de7fbe89415..b6a69512d544c0e52ecf00eb0f03496d85dbcf27 100644
--- a/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
+++ b/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
@@ -10,6 +10,7 @@
 #include "kk_descriptor_set.h"
 #include "kk_descriptor_set_layout.h"
 #include "kk_shader.h"
+#include "kk_sampler.h"
 
 #include "kosmickrisp/compiler/nir_to_msl.h"
 
@@ -29,8 +30,34 @@ struct lower_descriptors_ctx {
    bool clamp_desc_array_bounds;
    nir_address_format ubo_addr_format;
    nir_address_format ssbo_addr_format;
+   bool lower_non_seamless_cube;
 };
 
+enum non_seamless_cube_mode {
+   NON_SEAMLESS_CUBE_NATIVE,
+   NON_SEAMLESS_CUBE_STATIC,
+   NON_SEAMLESS_CUBE_DYNAMIC,
+};
+
+static bool
+is_non_seamless_cube_sample(const nir_tex_instr *tex)
+{
+   if (tex->sampler_dim != GLSL_SAMPLER_DIM_CUBE ||
+       !nir_tex_instr_need_sampler(tex) || nir_tex_instr_is_query(tex))
+      return false;
+
+   switch (tex->op) {
+   case nir_texop_tex:
+   case nir_texop_txb:
+   case nir_texop_txl:
+   case nir_texop_txd:
+   case nir_texop_tg4:
+      return true;
+   default:
+      return false;
+   }
+}
+
 static const struct kk_descriptor_set_binding_layout *
 get_binding_layout(uint32_t set, uint32_t binding,
                    const struct lower_descriptors_ctx *ctx)
@@ -353,6 +380,53 @@ get_resource_deref_binding(nir_builder *b, nir_deref_instr *deref,
    *binding = var->data.binding;
 }
 
+static enum non_seamless_cube_mode
+non_seamless_cube_mode(nir_tex_instr *tex, nir_deref_instr *sampler_deref,
+                       const struct lower_descriptors_ctx *ctx)
+{
+   if (!ctx->lower_non_seamless_cube || !is_non_seamless_cube_sample(tex))
+      return NON_SEAMLESS_CUBE_NATIVE;
+
+   bool constant_index = true;
+   uint32_t array_index = 0;
+   if (sampler_deref->deref_type == nir_deref_type_array) {
+      constant_index = nir_src_is_const(sampler_deref->arr.index);
+      if (constant_index)
+         array_index = nir_src_as_uint(sampler_deref->arr.index);
+      sampler_deref = nir_deref_instr_parent(sampler_deref);
+   }
+
+   assert(sampler_deref->deref_type == nir_deref_type_var);
+   const nir_variable *var = sampler_deref->var;
+
+   const struct kk_descriptor_set_binding_layout *binding_layout =
+      get_binding_layout(var->data.descriptor_set, var->data.binding, ctx);
+   if (binding_layout->immutable_samplers == NULL)
+      return NON_SEAMLESS_CUBE_DYNAMIC;
+
+   const VkSamplerCreateFlags flag =
+      VK_SAMPLER_CREATE_NON_SEAMLESS_CUBE_MAP_BIT_EXT;
+   bool non_seamless;
+   if (constant_index) {
+      assert(array_index < binding_layout->array_size);
+      non_seamless =
+         (binding_layout->immutable_samplers[array_index]->vk.flags & flag) !=
+         0;
+   } else {
+      non_seamless =
+         (binding_layout->immutable_samplers[0]->vk.flags & flag) != 0;
+      for (uint32_t i = 1; i < binding_layout->array_size; i++) {
+         bool element_non_seamless =
+            (binding_layout->immutable_samplers[i]->vk.flags & flag) != 0;
+         if (element_non_seamless != non_seamless)
+            return NON_SEAMLESS_CUBE_DYNAMIC;
+      }
+   }
+
+   return non_seamless ? NON_SEAMLESS_CUBE_STATIC
+                       : NON_SEAMLESS_CUBE_NATIVE;
+}
+
 static nir_def *
 load_resource_addr(nir_builder *b, unsigned num_components, unsigned bit_size,
                    nir_deref_instr *deref, unsigned offset_B,
@@ -548,6 +622,11 @@ lower_tex(nir_builder *b, nir_tex_instr *tex,
 
    nir_deref_instr *texture_deref =
       nir_src_as_deref(nir_src_for_ssa(texture));
+   nir_deref_instr *sampler_deref =
+      sampler ? nir_src_as_deref(nir_src_for_ssa(sampler)) : NULL;
+   enum non_seamless_cube_mode non_seamless_mode =
+      sampler_deref ? non_seamless_cube_mode(tex, sampler_deref, ctx)
+                    : NON_SEAMLESS_CUBE_NATIVE;
    if (tex->sampler_dim == GLSL_SAMPLER_DIM_BUF) {
       assert(plane == 0);
       if (tex->op == nir_texop_txs) {
@@ -690,8 +769,13 @@ lower_tex(nir_builder *b, nir_tex_instr *tex,
    }
 
    {
-      unsigned offs =
-         offsetof(struct kk_sampled_image_descriptor, image_gpu_resource_id);
+      const bool static_non_seamless =
+         non_seamless_mode == NON_SEAMLESS_CUBE_STATIC;
+      unsigned offs = static_non_seamless
+                         ? offsetof(struct kk_sampled_image_descriptor,
+                                    cube_array_gpu_resource_id)
+                         : offsetof(struct kk_sampled_image_descriptor,
+                                    image_gpu_resource_id);
 
       nir_def *resource_addr = load_resource_addr(
          b, 1, 64, nir_src_as_deref(nir_src_for_ssa(texture)),
@@ -699,15 +783,52 @@ lower_tex(nir_builder *b, nir_tex_instr *tex,
 
       nir_def *handle = NULL;
       if (tex->is_shadow) {
-         handle = nir_load_depth_texture_kk(b, 1, 64, resource_addr,
-                                            .image_dim = tex->sampler_dim,
-                                            .image_array = tex->is_array);
+         handle = nir_load_depth_texture_kk(
+            b, 1, 64, resource_addr,
+            .image_dim = static_non_seamless ? GLSL_SAMPLER_DIM_2D
+                                              : tex->sampler_dim,
+            .image_array = static_non_seamless ? true : tex->is_array);
       } else {
          handle = nir_load_texture_handle_kk(
             b, 1, 64, resource_addr, .dest_type = tex->dest_type,
-            .image_dim = tex->sampler_dim, .image_array = tex->is_array);
+            .image_dim = static_non_seamless ? GLSL_SAMPLER_DIM_2D
+                                              : tex->sampler_dim,
+            .image_array = static_non_seamless ? true : tex->is_array);
       }
       nir_tex_instr_add_src(tex, nir_tex_src_texture_handle, handle);
+
+      if (static_non_seamless)
+         tex->backend_flags |= KK_TEXTURE_FLAG_NON_SEAMLESS_STATIC;
+   }
+
+   if (non_seamless_mode == NON_SEAMLESS_CUBE_DYNAMIC) {
+      unsigned offs = offsetof(struct kk_sampled_image_descriptor,
+                               cube_array_gpu_resource_id);
+      nir_def *resource_addr = load_resource_addr(
+         b, 1, 64, texture_deref, plane_offset_B + offs, ctx);
+      nir_def *array_handle =
+         tex->is_shadow
+            ? nir_load_depth_texture_kk(b, 1, 64, resource_addr,
+                                        .image_dim = GLSL_SAMPLER_DIM_2D,
+                                        .image_array = true)
+            : nir_load_texture_handle_kk(b, 1, 64, resource_addr,
+                                         .dest_type = tex->dest_type,
+                                         .image_dim = GLSL_SAMPLER_DIM_2D,
+                                         .image_array = true);
+
+      nir_def *sampler_flags = load_resource_deref_desc(
+         b, 1, 32, sampler_deref,
+         plane_offset_B +
+            offsetof(struct kk_sampled_image_descriptor, sampler_flags),
+         ctx);
+      nir_def *non_seamless = nir_ine_imm(
+         b, nir_iand_imm(b, sampler_flags,
+                         VK_SAMPLER_CREATE_NON_SEAMLESS_CUBE_MAP_BIT_EXT),
+         0);
+
+      nir_tex_instr_add_src(tex, nir_tex_src_backend1, non_seamless);
+      nir_tex_instr_add_src(tex, nir_tex_src_backend2, array_handle);
+      tex->backend_flags |= KK_TEXTURE_FLAG_NON_SEAMLESS_DYNAMIC;
    }
 
    if (sampler != NULL) {
@@ -926,7 +1047,8 @@ bool
 kk_nir_lower_descriptors(nir_shader *nir,
                          const struct vk_pipeline_robustness_state *rs,
                          uint32_t set_layout_count,
-                         struct vk_descriptor_set_layout *const *set_layouts)
+                         struct vk_descriptor_set_layout *const *set_layouts,
+                         bool lower_non_seamless_cube)
 {
    struct lower_descriptors_ctx ctx = {
       .clamp_desc_array_bounds =
@@ -937,6 +1059,7 @@ kk_nir_lower_descriptors(nir_shader *nir,
          rs->images != VK_PIPELINE_ROBUSTNESS_IMAGE_BEHAVIOR_DISABLED,
       .ssbo_addr_format = kk_buffer_addr_format(rs->storage_buffers),
       .ubo_addr_format = kk_buffer_addr_format(rs->uniform_buffers),
+      .lower_non_seamless_cube = lower_non_seamless_cube,
    };
 
    assert(set_layout_count <= KK_MAX_SETS);
diff --git a/src/kosmickrisp/vulkan/kk_nir_lower_textures.c b/src/kosmickrisp/vulkan/kk_nir_lower_textures.c
index 4e77b4de2d79158856908ad27c3e3bd89ddbb91c..b492059e869c2e95d39ca8b765633c402ae27a26 100644
--- a/src/kosmickrisp/vulkan/kk_nir_lower_textures.c
+++ b/src/kosmickrisp/vulkan/kk_nir_lower_textures.c
@@ -17,6 +17,315 @@
 
 #include "stdbool.h"
 
+struct cube_coord {
+   nir_def *x;
+   nir_def *y;
+   nir_def *z;
+   nir_def *abs_x;
+   nir_def *abs_y;
+   nir_def *abs_z;
+   nir_def *cube_layer_base;
+};
+
+/* Width, height and layer count of the same-format 2D array alias. */
+static nir_def *
+array_texture_size(nir_builder *b, nir_def *array_handle)
+{
+   nir_tex_instr *txs = nir_tex_instr_create(b->shader, 2);
+   txs->op = nir_texop_txs;
+   txs->sampler_dim = GLSL_SAMPLER_DIM_2D;
+   txs->is_array = true;
+   txs->dest_type = nir_type_int32;
+   txs->src[0] =
+      nir_tex_src_for_ssa(nir_tex_src_texture_handle, array_handle);
+   txs->src[1] =
+      nir_tex_src_for_ssa(nir_tex_src_lod, nir_imm_int(b, 0));
+   nir_def_init(&txs->instr, &txs->def, 3, 32);
+   nir_builder_instr_insert(b, &txs->instr);
+   return &txs->def;
+}
+
+static nir_def *
+array_texture_width(nir_builder *b, nir_def *array_handle)
+{
+   return nir_channel(b, array_texture_size(b, array_handle), 0);
+}
+
+/* First face of the cube an array coordinate selects.  Vulkan rounds the
+ * coordinate to the nearest even integer and clamps it against the cube count
+ * before the six faces are indexed, so the clamp has to happen here.  Scaling
+ * first and leaving the product to the 2D array alias to clamp instead lands
+ * an out of range coordinate on the last face of the last cube rather than on
+ * the selected face of the last cube. */
+static nir_def *
+cube_array_layer_base(nir_builder *b, nir_def *layer, nir_def *array_handle)
+{
+   nir_def *layer_count =
+      nir_channel(b, array_texture_size(b, array_handle), 2);
+   nir_def *max_cube =
+      nir_i2fN(b, nir_iadd_imm(b, nir_udiv_imm(b, layer_count, 6), -1),
+               layer->bit_size);
+   nir_def *cube =
+      nir_fclamp(b, nir_fround_even(b, layer),
+                 nir_imm_floatN_t(b, 0.0, layer->bit_size), max_cube);
+
+   return nir_fmul_imm(b, cube, 6.0);
+}
+
+static nir_def *
+cube_face_x(nir_builder *b, const struct cube_coord *coord)
+{
+   nir_def *positive = nir_fge_imm(b, coord->x, 0.0);
+   nir_def *scale = nir_fdiv(
+      b, nir_imm_floatN_t(b, -0.5, coord->x->bit_size), coord->abs_x);
+   nir_def *u = nir_fadd_imm(
+      b, nir_fmul(b, nir_fmul(b, nir_fsign(b, coord->x), scale), coord->z),
+      0.5);
+   nir_def *v = nir_fadd_imm(b, nir_fmul(b, scale, coord->y), 0.5);
+   nir_def *face = nir_bcsel(
+      b, positive, nir_imm_floatN_t(b, 0.0, coord->x->bit_size),
+      nir_imm_floatN_t(b, 1.0, coord->x->bit_size));
+   return nir_vec3(b, u, v, nir_fadd(b, face, coord->cube_layer_base));
+}
+
+static nir_def *
+cube_face_y(nir_builder *b, const struct cube_coord *coord)
+{
+   nir_def *positive = nir_fge_imm(b, coord->y, 0.0);
+   nir_def *scale = nir_fdiv(
+      b, nir_imm_floatN_t(b, 0.5, coord->y->bit_size), coord->abs_y);
+   nir_def *u = nir_fadd_imm(b, nir_fmul(b, scale, coord->x), 0.5);
+   nir_def *v = nir_fadd_imm(
+      b, nir_fmul(b, nir_fmul(b, nir_fsign(b, coord->y), scale), coord->z),
+      0.5);
+   nir_def *face = nir_bcsel(
+      b, positive, nir_imm_floatN_t(b, 2.0, coord->y->bit_size),
+      nir_imm_floatN_t(b, 3.0, coord->y->bit_size));
+   return nir_vec3(b, u, v, nir_fadd(b, face, coord->cube_layer_base));
+}
+
+static nir_def *
+cube_face_z(nir_builder *b, const struct cube_coord *coord)
+{
+   nir_def *positive = nir_fge_imm(b, coord->z, 0.0);
+   nir_def *scale = nir_fdiv(
+      b, nir_imm_floatN_t(b, -0.5, coord->z->bit_size), coord->abs_z);
+   nir_def *u = nir_fadd_imm(
+      b, nir_fmul(b, nir_fmul(b, nir_fsign(b, coord->z), scale),
+                  nir_fneg(b, coord->x)),
+      0.5);
+   nir_def *v = nir_fadd_imm(b, nir_fmul(b, scale, coord->y), 0.5);
+   nir_def *face = nir_bcsel(
+      b, positive, nir_imm_floatN_t(b, 4.0, coord->z->bit_size),
+      nir_imm_floatN_t(b, 5.0, coord->z->bit_size));
+   return nir_vec3(b, u, v, nir_fadd(b, face, coord->cube_layer_base));
+}
+
+static nir_def *
+cube_to_array_coord(nir_builder *b, nir_def *coord, bool is_array,
+                    nir_def *array_handle)
+{
+   struct cube_coord cube = {
+      .x = nir_channel(b, coord, 0),
+      .y = nir_channel(b, coord, 1),
+      .z = nir_channel(b, coord, 2),
+      .cube_layer_base = nir_imm_floatN_t(b, 0.0, coord->bit_size),
+   };
+   cube.abs_x = nir_fabs(b, cube.x);
+   cube.abs_y = nir_fabs(b, cube.y);
+   cube.abs_z = nir_fabs(b, cube.z);
+
+   if (is_array) {
+      cube.cube_layer_base =
+         cube_array_layer_base(b, nir_channel(b, coord, 3), array_handle);
+   }
+
+   nir_def *face_x = cube_face_x(b, &cube);
+   nir_def *face_y = cube_face_y(b, &cube);
+   nir_def *face_z = cube_face_z(b, &cube);
+   nir_def *use_x =
+      nir_iand(b, nir_fge(b, cube.abs_x, cube.abs_y),
+               nir_fge(b, cube.abs_x, cube.abs_z));
+   nir_def *use_y =
+      nir_iand(b, nir_fge(b, cube.abs_y, cube.abs_x),
+               nir_fge(b, cube.abs_y, cube.abs_z));
+
+   return nir_bcsel(b, use_x, face_x,
+                    nir_bcsel(b, use_y, face_y, face_z));
+}
+
+/* Derive the implicit cube LOD before selecting a face.  Derivatives of the
+ * selected 2D coordinates are discontinuous across a quad that straddles a
+ * face boundary, which can otherwise select a spuriously coarse mip. */
+static nir_def *
+cube_implicit_lod(nir_builder *b, nir_def *coord, nir_def *array_handle)
+{
+   nir_def *p = nir_trim_vector(b, coord, 3);
+   nir_def *dPdx = nir_ddx(b, p);
+   nir_def *dPdy = nir_ddy(b, p);
+   nir_def *abs_p = nir_fabs(b, p);
+   nir_def *abs_x = nir_channel(b, abs_p, 0);
+   nir_def *abs_y = nir_channel(b, abs_p, 1);
+   nir_def *abs_z = nir_channel(b, abs_p, 2);
+   nir_def *use_x =
+      nir_iand(b, nir_fge(b, abs_x, abs_y), nir_fge(b, abs_x, abs_z));
+   nir_def *use_y =
+      nir_iand(b, nir_fge(b, abs_y, abs_x), nir_fge(b, abs_y, abs_z));
+   const unsigned yzx[3] = {1, 2, 0};
+   const unsigned xzy[3] = {0, 2, 1};
+
+   nir_def *Q = nir_bcsel(
+      b, use_x, nir_swizzle(b, p, yzx, 3),
+      nir_bcsel(b, use_y, nir_swizzle(b, p, xzy, 3), p));
+   nir_def *dQdx = nir_bcsel(
+      b, use_x, nir_swizzle(b, dPdx, yzx, 3),
+      nir_bcsel(b, use_y, nir_swizzle(b, dPdx, xzy, 3), dPdx));
+   nir_def *dQdy = nir_bcsel(
+      b, use_x, nir_swizzle(b, dPdy, yzx, 3),
+      nir_bcsel(b, use_y, nir_swizzle(b, dPdy, xzy, 3), dPdy));
+
+   nir_def *rcp_Q_z = nir_frcp(b, nir_channel(b, Q, 2));
+   nir_def *Q_xy = nir_trim_vector(b, Q, 2);
+   nir_def *tmp = nir_fmul(b, Q_xy, rcp_Q_z);
+   nir_def *dx = nir_fmul(
+      b, rcp_Q_z,
+      nir_fsub(b, nir_trim_vector(b, dQdx, 2),
+               nir_fmul(b, tmp, nir_channel(b, dQdx, 2))));
+   nir_def *dy = nir_fmul(
+      b, rcp_Q_z,
+      nir_fsub(b, nir_trim_vector(b, dQdy, 2),
+               nir_fmul(b, tmp, nir_channel(b, dQdy, 2))));
+   nir_def *rho2 = nir_fmax(b, nir_fdot(b, dx, dx), nir_fdot(b, dy, dy));
+   nir_def *width = nir_i2fN(
+      b, array_texture_width(b, array_handle), coord->bit_size);
+
+   return nir_fadd_imm(
+      b, nir_fmul_imm(b,
+                      nir_flog2(b, nir_fmul(b, width,
+                                           nir_fmul(b, width, rho2))),
+                      0.5),
+      -1.0);
+}
+
+static void
+remove_non_seamless_sources(nir_tex_instr *tex)
+{
+   int src = nir_tex_instr_src_index(tex, nir_tex_src_backend1);
+   if (src >= 0)
+      nir_tex_instr_remove_src(tex, src);
+
+   src = nir_tex_instr_src_index(tex, nir_tex_src_backend2);
+   if (src >= 0)
+      nir_tex_instr_remove_src(tex, src);
+
+   tex->backend_flags &= ~(KK_TEXTURE_FLAG_NON_SEAMLESS_STATIC |
+                           KK_TEXTURE_FLAG_NON_SEAMLESS_DYNAMIC);
+}
+
+static nir_tex_instr *
+clone_cube_sample(nir_builder *b, const nir_tex_instr *tex)
+{
+   nir_tex_instr *clone =
+      nir_instr_as_tex(nir_instr_clone(b->shader, &tex->instr));
+   nir_builder_instr_insert(b, &clone->instr);
+   remove_non_seamless_sources(clone);
+   return clone;
+}
+
+static nir_def *
+clone_non_seamless_sample(nir_builder *b, const nir_tex_instr *tex,
+                          nir_def *array_handle)
+{
+   int coord_src = nir_tex_instr_src_index(tex, nir_tex_src_coord);
+   assert(coord_src >= 0);
+   nir_def *cube_coord = tex->src[coord_src].src.ssa;
+   /* A statically lowered sample already carries the 2D array alias as its
+    * texture handle; a dynamic one keeps the cube handle and passes the alias
+    * alongside it. */
+   nir_def *handle = array_handle;
+   if (handle == NULL) {
+      int tex_handle_src =
+         nir_tex_instr_src_index(tex, nir_tex_src_texture_handle);
+      assert(tex_handle_src >= 0);
+      handle = tex->src[tex_handle_src].src.ssa;
+   }
+   nir_def *coord =
+      cube_to_array_coord(b, cube_coord, tex->is_array, handle);
+
+   nir_tex_instr *clone = clone_cube_sample(b, tex);
+   clone->sampler_dim = GLSL_SAMPLER_DIM_2D;
+   clone->is_array = true;
+   clone->array_is_lowered_cube = true;
+   clone->coord_components = 3;
+   coord_src = nir_tex_instr_src_index(clone, nir_tex_src_coord);
+   nir_src_rewrite(&clone->src[coord_src].src, coord);
+
+   if (array_handle != NULL) {
+      int handle_src =
+         nir_tex_instr_src_index(clone, nir_tex_src_texture_handle);
+      assert(handle_src >= 0);
+      nir_src_rewrite(&clone->src[handle_src].src, array_handle);
+   }
+
+   if (clone->op == nir_texop_tex || clone->op == nir_texop_txb) {
+      int handle_src =
+         nir_tex_instr_src_index(clone, nir_tex_src_texture_handle);
+      assert(handle_src >= 0);
+      b->cursor = nir_before_instr(&clone->instr);
+      nir_def *lod = nir_shader_supports_implicit_lod(b->shader)
+                        ? cube_implicit_lod(
+                             b, cube_coord, clone->src[handle_src].src.ssa)
+                        : nir_imm_floatN_t(b, 0.0, cube_coord->bit_size);
+      nir_def *bias = nir_steal_tex_src(clone, nir_tex_src_bias);
+      if (bias)
+         lod = nir_fadd(b, lod, nir_f2fN(b, bias, lod->bit_size));
+      nir_def *min_lod = nir_steal_tex_src(clone, nir_tex_src_min_lod);
+      if (min_lod)
+         lod = nir_fmax(b, lod, nir_f2fN(b, min_lod, lod->bit_size));
+      nir_tex_instr_add_src(clone, nir_tex_src_lod, lod);
+      clone->op = nir_texop_txl;
+      b->cursor = nir_after_instr(&clone->instr);
+   }
+
+   return &clone->def;
+}
+
+static bool
+lower_non_seamless_cube_filter(const nir_instr *instr, UNUSED const void *data)
+{
+   if (instr->type != nir_instr_type_tex)
+      return false;
+
+   const nir_tex_instr *tex = nir_instr_as_tex(instr);
+   return tex->backend_flags & (KK_TEXTURE_FLAG_NON_SEAMLESS_STATIC |
+                                KK_TEXTURE_FLAG_NON_SEAMLESS_DYNAMIC);
+}
+
+static nir_def *
+lower_non_seamless_cube(nir_builder *b, nir_instr *instr, UNUSED void *data)
+{
+   nir_tex_instr *tex = nir_instr_as_tex(instr);
+   const bool dynamic =
+      tex->backend_flags & KK_TEXTURE_FLAG_NON_SEAMLESS_DYNAMIC;
+
+   if (!dynamic)
+      return clone_non_seamless_sample(b, tex, NULL);
+
+   int condition_src = nir_tex_instr_src_index(tex, nir_tex_src_backend1);
+   int array_handle_src = nir_tex_instr_src_index(tex, nir_tex_src_backend2);
+   assert(condition_src >= 0 && array_handle_src >= 0);
+   nir_def *condition = tex->src[condition_src].src.ssa;
+   nir_def *array_handle = tex->src[array_handle_src].src.ssa;
+
+   nir_push_if(b, condition);
+   nir_def *non_seamless = clone_non_seamless_sample(b, tex, array_handle);
+   nir_push_else(b, NULL);
+   nir_def *seamless = &clone_cube_sample(b, tex)->def;
+   nir_pop_if(b, NULL);
+
+   return nir_if_phi(b, non_seamless, seamless);
+}
