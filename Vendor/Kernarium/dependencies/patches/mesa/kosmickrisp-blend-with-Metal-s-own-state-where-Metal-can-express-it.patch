+#version 450
+layout(push_constant) uniform Source {
+   vec4 colour;
+} source;
+/* An index 1 output exists but no blend factor in this test names it, so it is
+ * dead and must not cost the pipeline Metal's fixed-function blend. */
+layout(location = 0, index = 0) out vec4 out_colour;
+layout(location = 0, index = 1) out vec4 out_second;
+void main()
+{
+   out_colour = source.colour;
+   out_second = vec4(1.0) - source.colour;
+}
