+void
+mtl_render_pipeline_descriptor_set_blend(mtl_render_pipeline_descriptor *descriptor,
+                                         uint8_t index,
+                                         bool enabled,
+                                         enum mtl_blend_factor source_rgb,
+                                         enum mtl_blend_factor destination_rgb,
+                                         enum mtl_blend_operation rgb_operation,
+                                         enum mtl_blend_factor source_alpha,
+                                         enum mtl_blend_factor destination_alpha,
+                                         enum mtl_blend_operation alpha_operation)
+{
+   @autoreleasepool {
+      MTL4RenderPipelineDescriptor *desc = (MTL4RenderPipelineDescriptor *)descriptor;
+      MTL4RenderPipelineColorAttachmentDescriptor *att = desc.colorAttachments[index];
+      att.blendingState = enabled ? MTL4BlendStateEnabled : MTL4BlendStateDisabled;
+      att.sourceRGBBlendFactor = (MTLBlendFactor)source_rgb;
+      att.destinationRGBBlendFactor = (MTLBlendFactor)destination_rgb;
+      att.rgbBlendOperation = (MTLBlendOperation)rgb_operation;
+      att.sourceAlphaBlendFactor = (MTLBlendFactor)source_alpha;
+      att.destinationAlphaBlendFactor = (MTLBlendFactor)destination_alpha;
+      att.alphaBlendOperation = (MTLBlendOperation)alpha_operation;
+   }
+}
+
+void
+mtl_render_pipeline_descriptor_set_write_mask(mtl_render_pipeline_descriptor *descriptor,
+                                              uint8_t index,
+                                              enum mtl_color_write_mask mask)
+{
+   @autoreleasepool {
+      MTL4RenderPipelineDescriptor *desc = (MTL4RenderPipelineDescriptor *)descriptor;
+      desc.colorAttachments[index].writeMask = (MTLColorWriteMask)mask;
+   }
+}
+
 void
 mtl_render_pipeline_descriptor_set_raster_sample_count(mtl_render_pipeline_descriptor *descriptor,
                                                        uint32_t sample_count)
