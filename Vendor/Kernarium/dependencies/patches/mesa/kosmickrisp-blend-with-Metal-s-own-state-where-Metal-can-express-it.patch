+         bool ok = true;
+         for (uint32_t p = 0; p < kExtent * kExtent && ok; ++p) {
+            for (uint32_t c = 0; c < target.channels; ++c) {
+               const float got = decode_channel(
+                  target, pixels + p * target.texel_bytes, c);
+               if (std::fabs(got - expected.v[c]) > target.tolerance) {
+                  std::fprintf(
+                     stderr,
+                     "%s: pixel %u channel %u is %.4f, expected %.4f\n",
+                     test.name, p, c, got, expected.v[c]);
+                  ok = false;
+                  break;
+               }
+            }
+         }
+         std::printf("  %-32s %s\n", test.name, ok ? "ok" : "WRONG");
+         if (!ok)
+            ++failures;
+
+         vkDestroyPipeline(device, pipeline, nullptr);
+      }
+
+      vkDestroyImageView(device, view, nullptr);
+      vkDestroyImage(device, image, nullptr);
+      vkDestroyBuffer(device, readback, nullptr);
+      vkFreeMemory(device, image_memory, nullptr);
+      vkFreeMemory(device, buffer_memory, nullptr);
+      }
+
+
+      vkDestroyCommandPool(device, pool, nullptr);
+      vkDestroyPipelineLayout(device, layout, nullptr);
+      vkDestroyShaderModule(device, fragment_module, nullptr);
+      vkDestroyShaderModule(device, fragment_dual_module, nullptr);
+      vkDestroyShaderModule(device, vertex_module, nullptr);
+      vkDestroyDevice(device, nullptr);
+   }
+
+   vkDestroyInstance(instance, nullptr);
+   return failures == 0 ? 0 : 1;
+}
