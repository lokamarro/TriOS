index 0000000000000000000000000000000000000000..d14f00ef5e68d2e1d2d447b32a42b29dd74fc9f0
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_metal_blend.cpp
@@ -0,0 +1,797 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* KosmicKrisp blends with Metal's own fixed-function state whenever
+ * kk_blend_is_metal_expressible accepts the pipeline, which keeps the fragment
+ * shader independent of the colour-blend state and so lets a pipeline library
+ * compile it before the link.  Metal owns the whole equation there - factors,
+ * operation, write mask, blend constants and the conversion to the
+ * attachment's format - so this renders one fully covered target for a matrix
+ * of blend states and compares every channel against the same equation
+ * evaluated on the host.
+ *
+ * The matrix runs against an attachment of every shape, because the shape is
+ * what decides whether Metal can own the equation: a format with fewer than
+ * four components still needs the fragment function to return the source alpha
+ * Metal weights with, and a format Metal reaches only through a channel
+ * swizzle has to stay on the shader-lowered path, since the blend unit reads
+ * the destination straight from the texture and never sees that swizzle.
+ */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+static void require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (!ok) {
+      std::fprintf(stderr, "%s: %d\n", operation, value);
+      std::exit(1);
+   }
+}
+
+template <typename T> static T load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+#define LOAD_D(name)                                                             \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+
+static const uint32_t vertex_spirv[] =
+#include "metal_blend_shaders/blend.vert.h"
+;
+static const uint32_t fragment_spirv[] =
+#include "metal_blend_shaders/blend.frag.h"
+   ;
+static const uint32_t fragment_dual_spirv[] =
+#include "metal_blend_shaders/blend_dual.frag.h"
+;
+
+static const uint32_t kExtent = 4u;
+
+/* Vulkan blends an sRGB attachment in linear space and stores the encoded
+ * value, and Metal does the same in its own hardware, so the host model blends
+ * the linear clear value and encodes the result to compare like with like. */
+static float srgb_encode(float linear)
+{
+   return linear <= 0.0031308f
+             ? linear * 12.92f
+             : 1.055f * std::pow(linear, 1.0f / 2.4f) - 0.055f;
+}
+
+struct Rgba {
+   float v[4];
+};
+
+/* The host model of one Vulkan blend equation, evaluated in the order the
+ * specification gives: factor, operation, write mask, then the conversion the
+ * attachment's format performs. */
+static float factor_value(VkBlendFactor factor, const Rgba &src,
+                          const Rgba &dst, const Rgba &constant,
+                          uint32_t channel)
+{
+   const bool alpha = channel == 3u;
+   switch (factor) {
+   case VK_BLEND_FACTOR_ZERO:
+      return 0.0f;
+   case VK_BLEND_FACTOR_ONE:
+      return 1.0f;
+   case VK_BLEND_FACTOR_SRC_COLOR:
+      return src.v[channel];
+   case VK_BLEND_FACTOR_ONE_MINUS_SRC_COLOR:
+      return 1.0f - src.v[channel];
+   case VK_BLEND_FACTOR_DST_COLOR:
+      return dst.v[channel];
+   case VK_BLEND_FACTOR_ONE_MINUS_DST_COLOR:
+      return 1.0f - dst.v[channel];
+   case VK_BLEND_FACTOR_SRC_ALPHA:
+      return src.v[3];
+   case VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA:
+      return 1.0f - src.v[3];
+   case VK_BLEND_FACTOR_DST_ALPHA:
+      return dst.v[3];
+   case VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA:
+      return 1.0f - dst.v[3];
+   case VK_BLEND_FACTOR_CONSTANT_COLOR:
+      return constant.v[channel];
+   case VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_COLOR:
+      return 1.0f - constant.v[channel];
+   case VK_BLEND_FACTOR_CONSTANT_ALPHA:
+      return constant.v[3];
+   case VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_ALPHA:
+      return 1.0f - constant.v[3];
+   case VK_BLEND_FACTOR_SRC_ALPHA_SATURATE:
+      /* The alpha channel takes one, every colour channel the saturate. */
+      return alpha ? 1.0f
+                   : std::fmin(src.v[3], 1.0f - dst.v[3]);
+   default:
+      std::fprintf(stderr, "unmodelled blend factor %d\n", (int)factor);
+      std::exit(1);
+   }
+}
+
+static float apply_operation(VkBlendOp op, float source, float destination)
+{
+   switch (op) {
+   case VK_BLEND_OP_ADD:
+      return source + destination;
+   case VK_BLEND_OP_SUBTRACT:
+      return source - destination;
+   case VK_BLEND_OP_REVERSE_SUBTRACT:
+      return destination - source;
+   case VK_BLEND_OP_MIN:
+      return std::fmin(source, destination);
+   case VK_BLEND_OP_MAX:
+      return std::fmax(source, destination);
+   default:
+      std::fprintf(stderr, "unmodelled blend operation %d\n", (int)op);
+      std::exit(1);
+   }
+}
+
+/* The attachment format decides how many components the fragment shader has to
+ * hand Metal's blend unit and whether Metal can reach the attachment's channels
+ * in Vulkan's order at all, so every blend state is run against a format of
+ * each shape rather than against RGBA8 alone. */
+struct Format {
+   VkFormat format;
+   const char *name;
+   uint32_t channels;
+   uint32_t texel_bytes;
+   bool encoded;
+   float tolerance;
+   /* The largest value the format stores: a normalized format clamps a blend
+    * result to one, a floating-point one does not. */
+   float maximum;
+   /* One exponent shared by the three colour channels: none of them can be
+    * written on its own, so Vulkan requires their write-mask bits to move
+    * together and Metal accepts only an all-or-nothing mask. */
+   bool shared_exponent;
+   /* Render with a fragment shader that also declares an index 1 output, which
+    * no blend state here names.  Metal has no second colour source, so a
+    * pipeline that keeps its fixed-function blend has to drop the dead output
+    * rather than hand the MSL backend a colour index it cannot emit. */
+   bool dual_source_output;
+};
+
+static const Format kFormats[] = {
+   {VK_FORMAT_R8G8B8A8_UNORM, "R8G8B8A8_UNORM", 4u, 4u, false, 1.5f / 255.0f,
+    1.0f, false, false},
+   {VK_FORMAT_R8G8B8A8_SRGB, "R8G8B8A8_SRGB", 4u, 4u, true, 1.5f / 255.0f, 1.0f,
+    false, false},
+   /* Fewer than four components: Metal still weights with the source alpha the
+    * fragment function returns, so the return value may not be narrowed to the
+    * attachment. */
+   {VK_FORMAT_R5G6B5_UNORM_PACK16, "R5G6B5_UNORM_PACK16", 3u, 2u, false,
+    1.5f / 31.0f, 1.0f, false, false},
+   {VK_FORMAT_R8G8_UNORM, "R8G8_UNORM", 2u, 2u, false, 1.5f / 255.0f, 1.0f,
+    false, false},
+   {VK_FORMAT_R8_UNORM, "R8_UNORM", 1u, 1u, false, 1.5f / 255.0f, 1.0f, false,
+    false},
+   /* Metal has no B4G4R4A4, so the view reaches a compatible format through a
+    * channel swizzle that the blend unit does not apply. */
+   {VK_FORMAT_B4G4R4A4_UNORM_PACK16, "B4G4R4A4_UNORM_PACK16", 4u, 2u, false,
+    1.5f / 15.0f, 1.0f, false, false},
+   /* Three 9-bit mantissas over one shared 5-bit exponent.  It stores values
+    * above one, and at every value this test renders the quantum is at most
+    * 2^-8, which 1.5/255 covers. */
+   {VK_FORMAT_E5B9G9R9_UFLOAT_PACK32, "E5B9G9R9_UFLOAT_PACK32", 3u, 4u, false,
+    1.5f / 255.0f, 65408.0f, true, false},
+   {VK_FORMAT_R8G8B8A8_UNORM, "R8G8B8A8_UNORM (dead index 1 output)", 4u, 4u,
+    false, 1.5f / 255.0f, 1.0f, false, true},
+};
+
+static float decode_channel(const Format &format, const uint8_t *texel,
+                            uint32_t channel)
+{
+   switch (format.format) {
+   case VK_FORMAT_R5G6B5_UNORM_PACK16: {
+      /* PACK16 numbers the bits from the most significant end: R is 15..11,
+       * G is 10..5 and B is 4..0. */
+      const uint32_t v = (uint32_t)texel[0] | ((uint32_t)texel[1] << 8);
+      if (channel == 0u)
+         return ((v >> 11) & 0x1fu) / 31.0f;
+      if (channel == 1u)
+         return ((v >> 5) & 0x3fu) / 63.0f;
+      return (v & 0x1fu) / 31.0f;
+   }
+   case VK_FORMAT_B4G4R4A4_UNORM_PACK16: {
+      /* B is 15..12, G is 11..8, R is 7..4 and A is 3..0. */
+      static const uint32_t shift[4] = {4u, 8u, 12u, 0u};
+      const uint32_t v = (uint32_t)texel[0] | ((uint32_t)texel[1] << 8);
+      return ((v >> shift[channel]) & 0xfu) / 15.0f;
+   }
+   case VK_FORMAT_E5B9G9R9_UFLOAT_PACK32: {
+      /* PACK32 names the fields from the most significant end - E5 B9 G9 R9 -
+       * so R occupies bits 8..0, G 17..9 and B 26..18, and every mantissa is
+       * scaled by the one exponent in 31..27. */
+      const uint32_t v = (uint32_t)texel[0] | ((uint32_t)texel[1] << 8) |
+                         ((uint32_t)texel[2] << 16) | ((uint32_t)texel[3] << 24);
+      const uint32_t mantissa = (v >> (channel * 9u)) & 0x1ffu;
+      const int exponent = (int)(v >> 27) - 24;
+      return (float)mantissa * std::ldexp(1.0f, exponent);
+   }
+   default:
+      return texel[channel] / 255.0f;
+   }
+}
+
+struct Case {
+   const char *name;
+   bool blend_enable;
+   VkBlendFactor src_colour;
+   VkBlendFactor dst_colour;
+   VkBlendOp colour_op;
+   VkBlendFactor src_alpha;
+   VkBlendFactor dst_alpha;
+   VkBlendOp alpha_op;
+   VkColorComponentFlags write_mask;
+};
+
+static const VkColorComponentFlags kAll =
+   VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT |
+   VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT;
+
+static const Case kCases[] = {
+   {"disabled", false, VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ZERO,
+    VK_BLEND_OP_ADD, VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ZERO, VK_BLEND_OP_ADD,
+    kAll},
+   {"src_over", true, VK_BLEND_FACTOR_SRC_ALPHA,
+    VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA, VK_BLEND_OP_ADD, VK_BLEND_FACTOR_ONE,
+    VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA, VK_BLEND_OP_ADD, kAll},
+   {"additive", true, VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE, VK_BLEND_OP_ADD,
+    VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE, VK_BLEND_OP_ADD, kAll},
+   {"subtract", true, VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE,
+    VK_BLEND_OP_SUBTRACT, VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE,
+    VK_BLEND_OP_SUBTRACT, kAll},
+   {"reverse_subtract", true, VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE,
+    VK_BLEND_OP_REVERSE_SUBTRACT, VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE,
+    VK_BLEND_OP_REVERSE_SUBTRACT, kAll},
+   {"min", true, VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE, VK_BLEND_OP_MIN,
+    VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE, VK_BLEND_OP_MIN, kAll},
+   {"max", true, VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE, VK_BLEND_OP_MAX,
+    VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE, VK_BLEND_OP_MAX, kAll},
+   {"dst_colour", true, VK_BLEND_FACTOR_DST_COLOR, VK_BLEND_FACTOR_ZERO,
+    VK_BLEND_OP_ADD, VK_BLEND_FACTOR_DST_ALPHA, VK_BLEND_FACTOR_ZERO,
+    VK_BLEND_OP_ADD, kAll},
+   {"one_minus_dst", true, VK_BLEND_FACTOR_ONE_MINUS_DST_COLOR,
+    VK_BLEND_FACTOR_ONE_MINUS_SRC_COLOR, VK_BLEND_OP_ADD,
+    VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA, VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
+    VK_BLEND_OP_ADD, kAll},
+   {"constant_colour", true, VK_BLEND_FACTOR_CONSTANT_COLOR,
+    VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_COLOR, VK_BLEND_OP_ADD,
+    VK_BLEND_FACTOR_CONSTANT_ALPHA, VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_ALPHA,
+    VK_BLEND_OP_ADD, kAll},
+   {"alpha_saturate", true, VK_BLEND_FACTOR_SRC_ALPHA_SATURATE,
