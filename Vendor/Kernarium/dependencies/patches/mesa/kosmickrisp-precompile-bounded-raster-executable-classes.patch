+/* SPDX-License-Identifier: MIT */
+#include "raster_discard_state.h"
+#include "kosmickrisp/vulkan/kk_cmd_buffer.h"
+
+void
+kk_test_assert_raster_discard(VkCommandBuffer command, bool discard)
+{
+   const struct kk_cmd_buffer *cmd = kk_cmd_buffer_from_handle(command);
+   const struct kk_shader *shader = cmd->state.shaders[MESA_SHADER_VERTEX];
+   assert((shader->info.vs.raster_variant_class == KK_RASTER_DISCARD) == discard);
+   if (discard) {
+      assert(!shader->info.vs.line_raster_materialize);
+      assert(!shader->info.vs.line_raster_emulation);
+      assert(!shader->info.vs.polygon_point_emulation);
+   }
+}
