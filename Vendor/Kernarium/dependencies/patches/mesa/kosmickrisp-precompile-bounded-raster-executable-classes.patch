+ */
+
+#pragma once
+
+#include <stdint.h>
+
+/* Fixed-size metadata for one clipped edge, never one record per pixel.
+ * The prefix scan publishes cell_end in primitive order. A cell is a
+ * Bresenham pixel, a stippled unit rectangle, or an unstippled whole edge. */
+struct kk_raster_edge {
+   uint32_t cell_end;
+   int32_t major_start;
+   float endpoints[4];
+   float weights[2][3];
+   float length;
+   float phase;
+   uint32_t flags;
+   float depth_bias;
+};
+
+#define KK_RASTER_EDGE_Y_MAJOR (1u << 0)
+#define KK_RASTER_EDGE_REVERSE (1u << 1)
+#define KK_RASTER_EDGE_DECREASING (1u << 2)
+
+_Static_assert(sizeof(struct kk_raster_edge) == 64,
+               "raster edge records must remain compact");
