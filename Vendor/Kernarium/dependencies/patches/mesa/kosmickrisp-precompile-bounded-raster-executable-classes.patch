+++ b/src/kosmickrisp/vulkan/tests/test_raster_discard.cpp
@@ -0,0 +1,500 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+#include "raster_discard_state.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <span>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+static void require(bool ok, const char *operation, VkResult result = VK_SUCCESS)
+{
+   if (!ok) {
+      std::fprintf(stderr, "%s: %d\n", operation, result);
+      std::exit(1);
+   }
+}
+
+template <typename T> static T load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+#define LOAD_D(name) \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+
+static const uint32_t vertex_spirv[] =
+#include "raster_discard_shaders/discard.vert.h"
+;
+static const uint32_t geometry_spirv[] =
+#include "raster_discard_shaders/discard.geom.h"
+;
+static const uint32_t fragment_spirv[] =
+#include "raster_discard_shaders/discard.frag.h"
+;
+
+static const uint32_t stream_geometry_spirv[] =
+#include "statistics_shaders/streams.geom.h"
+;
+
+struct Buffer {
+   VkBuffer buffer = VK_NULL_HANDLE;
+   VkDeviceMemory memory = VK_NULL_HANDLE;
+   void *mapped = nullptr;
+};
+
+int main()
+{
+   std::setvbuf(stdout, nullptr, _IONBF, 0);
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+   app.pApplicationName = "raster-discard";
+   app.apiVersion = VK_API_VERSION_1_3;
+   VkInstanceCreateInfo instance_info{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+   instance_info.pApplicationInfo = &app;
+   auto result = vkCreateInstance(&instance_info, nullptr, &instance);
+   require(result == VK_SUCCESS, "create instance", result);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   uint32_t physical_count = 0;
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, nullptr);
+   require(result == VK_SUCCESS && physical_count, "physical device count", result);
+   std::vector<VkPhysicalDevice> physicals(physical_count);
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, physicals.data());
+   require(result == VK_SUCCESS, "physical devices", result);
+
+   for (VkPhysicalDevice physical : physicals) {
+      uint32_t queue_count = 0;
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, nullptr);
+      std::vector<VkQueueFamilyProperties> queues(queue_count);
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, queues.data());
+      uint32_t queue = 0;
+      while (queue < queue_count && !(queues[queue].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+         ++queue;
+      require(queue < queue_count, "graphics queue");
+      float priority = 1.0f;
+      VkDeviceQueueCreateInfo queue_info{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+      queue_info.queueFamilyIndex = queue;
+      queue_info.queueCount = 1;
+      queue_info.pQueuePriorities = &priority;
+      VkPhysicalDevicePrimitiveTopologyListRestartFeaturesEXT restart{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PRIMITIVE_TOPOLOGY_LIST_RESTART_FEATURES_EXT};
+      restart.primitiveTopologyListRestart = VK_TRUE;
+      VkPhysicalDeviceProvokingVertexFeaturesEXT provoking{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROVOKING_VERTEX_FEATURES_EXT};
+      provoking.pNext = &restart;
+      provoking.provokingVertexLast = VK_TRUE;
+      VkPhysicalDeviceTransformFeedbackFeaturesEXT xfb{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TRANSFORM_FEEDBACK_FEATURES_EXT};
+      xfb.pNext = &provoking;
+      xfb.transformFeedback = VK_TRUE;
+      xfb.geometryStreams = VK_TRUE;
+      VkPhysicalDeviceVulkan12Features features12{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+      features12.pNext = &xfb;
+      features12.bufferDeviceAddress = VK_TRUE;
+      VkPhysicalDeviceVulkan13Features features13{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+      features13.pNext = &features12;
+      features13.dynamicRendering = VK_TRUE;
+      features13.pipelineCreationCacheControl = VK_TRUE;
+      VkPhysicalDeviceFeatures features{};
+      features.geometryShader = VK_TRUE;
+      features.shaderTessellationAndGeometryPointSize = VK_TRUE;
+      features.vertexPipelineStoresAndAtomics = VK_TRUE;
+      features.fragmentStoresAndAtomics = VK_TRUE;
+      features.pipelineStatisticsQuery = VK_TRUE;
+      const char *extensions[] = {
+         VK_EXT_TRANSFORM_FEEDBACK_EXTENSION_NAME,
+         VK_EXT_PROVOKING_VERTEX_EXTENSION_NAME,
+         VK_EXT_PRIMITIVE_TOPOLOGY_LIST_RESTART_EXTENSION_NAME};
+      VkDeviceCreateInfo device_info{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+      device_info.pNext = &features13;
+      device_info.queueCreateInfoCount = 1;
+      device_info.pQueueCreateInfos = &queue_info;
+      device_info.enabledExtensionCount = std::size(extensions);
+      device_info.ppEnabledExtensionNames = extensions;
+      device_info.pEnabledFeatures = &features;
+      VkDevice device = VK_NULL_HANDLE;
+      result = vkCreateDevice(physical, &device_info, nullptr, &device);
+      require(result == VK_SUCCESS, "create device", result);
+      LOAD_D(vkDestroyDevice);
+      LOAD_D(vkCreateShaderModule);
+      LOAD_D(vkDestroyShaderModule);
+      LOAD_D(vkCreatePipelineLayout);
+      LOAD_D(vkDestroyPipelineLayout);
+      LOAD_D(vkCreateGraphicsPipelines);
+      LOAD_D(vkDestroyPipeline);
+      LOAD_D(vkCreatePipelineCache);
+      LOAD_D(vkDestroyPipelineCache);
+      LOAD_D(vkGetPipelineCacheData);
+      LOAD_D(vkCreateCommandPool);
+      LOAD_D(vkDestroyCommandPool);
+      LOAD_D(vkResetCommandPool);
+      LOAD_D(vkAllocateCommandBuffers);
+      LOAD_D(vkBeginCommandBuffer);
+      LOAD_D(vkEndCommandBuffer);
+      LOAD_D(vkCmdBeginRendering);
+      LOAD_D(vkCmdEndRendering);
+      LOAD_D(vkCmdBindPipeline);
+      LOAD_D(vkCmdSetRasterizerDiscardEnable);
+      LOAD_D(vkCmdBindVertexBuffers);
+      LOAD_D(vkCmdBindIndexBuffer);
+      LOAD_D(vkCmdPushConstants);
+      LOAD_D(vkCmdDraw);
+      LOAD_D(vkCmdDrawIndexed);
+      LOAD_D(vkGetDeviceQueue);
+      LOAD_D(vkQueueSubmit);
+      LOAD_D(vkCreateFence);
+      LOAD_D(vkDestroyFence);
+      LOAD_D(vkResetFences);
+      LOAD_D(vkWaitForFences);
+      LOAD_D(vkCreateBuffer);
+      LOAD_D(vkDestroyBuffer);
+      LOAD_D(vkGetBufferMemoryRequirements);
+      LOAD_D(vkAllocateMemory);
+      LOAD_D(vkFreeMemory);
+      LOAD_D(vkBindBufferMemory);
+      LOAD_D(vkGetBufferDeviceAddress);
+      LOAD_D(vkMapMemory);
+      LOAD_D(vkUnmapMemory);
+      LOAD_D(vkCmdBindTransformFeedbackBuffersEXT);
+      LOAD_D(vkCmdBeginTransformFeedbackEXT);
+      LOAD_D(vkCmdEndTransformFeedbackEXT);
+      LOAD_D(vkCmdPipelineBarrier);
+      LOAD_D(vkCreateQueryPool);
+      LOAD_D(vkDestroyQueryPool);
+      LOAD_D(vkCmdResetQueryPool);
+      LOAD_D(vkCmdBeginQuery);
+      LOAD_D(vkCmdEndQuery);
+      LOAD_D(vkGetQueryPoolResults);
+      VkQueue device_queue = VK_NULL_HANDLE;
+      vkGetDeviceQueue(device, queue, 0, &device_queue);
+
+      VkPhysicalDeviceMemoryProperties memory_properties{};
+      vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+      const auto make_buffer = [&](VkDeviceSize size, VkBufferUsageFlags usage) {
+         Buffer buffer;
+         VkBufferCreateInfo info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+         info.size = size;
+         info.usage = usage;
+         result = vkCreateBuffer(device, &info, nullptr, &buffer.buffer);
+         require(result == VK_SUCCESS, "create buffer", result);
+         VkMemoryRequirements requirements{};
+         vkGetBufferMemoryRequirements(device, buffer.buffer, &requirements);
+         constexpr auto properties =
+            VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+         uint32_t type = 0;
+         while (type < memory_properties.memoryTypeCount &&
+                (!(requirements.memoryTypeBits & (1u << type)) ||
+                 (memory_properties.memoryTypes[type].propertyFlags & properties) != properties))
+            ++type;
+         require(type < memory_properties.memoryTypeCount, "host-coherent memory");
+         VkMemoryAllocateFlagsInfo flags{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO};
+         flags.flags = VK_MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT;
+         VkMemoryAllocateInfo allocation{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+         allocation.pNext = usage & VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT ? &flags : nullptr;
+         allocation.allocationSize = requirements.size;
+         allocation.memoryTypeIndex = type;
+         result = vkAllocateMemory(device, &allocation, nullptr, &buffer.memory);
+         require(result == VK_SUCCESS, "allocate buffer", result);
+         result = vkBindBufferMemory(device, buffer.buffer, buffer.memory, 0);
+         require(result == VK_SUCCESS, "bind buffer", result);
+         result = vkMapMemory(device, buffer.memory, 0, VK_WHOLE_SIZE, 0, &buffer.mapped);
+         require(result == VK_SUCCESS, "map buffer", result);
+         return buffer;
+      };
+      constexpr uint32_t input_count = 1024;
+      constexpr uint32_t output_count = 204;
+      constexpr uint32_t guard_words = 256;
+      constexpr uint32_t capture_words = input_count * output_count;
+      constexpr uint32_t sentinel = 0xdeadbeef;
+      auto capture = make_buffer((capture_words + 2 * guard_words) * sizeof(uint32_t),
+                                 VK_BUFFER_USAGE_TRANSFORM_FEEDBACK_BUFFER_BIT_EXT);
+      auto vertices = make_buffer(input_count * 4 * sizeof(float), VK_BUFFER_USAGE_VERTEX_BUFFER_BIT);
+      auto indices = make_buffer((input_count + 2) * sizeof(uint32_t), VK_BUFFER_USAGE_INDEX_BUFFER_BIT);
+      auto effects = make_buffer((input_count + 1) * sizeof(uint32_t),
+                                 VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+                                 VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT);
+      auto *positions = static_cast<float *>(vertices.mapped);
+      for (uint32_t i = 0; i < input_count; ++i) {
+         positions[4 * i] = -0.5f;
+         positions[4 * i + 1] = 0.125f;
+         positions[4 * i + 2] = 0.5f;
+         positions[4 * i + 3] = 1.0f;
+      }
+      positions[4] = 0.5f;
+      auto *index = static_cast<uint32_t *>(indices.mapped);
+      index[0] = 0;
+      index[1] = UINT32_MAX;
+      index[2] = 1;
+      index[3] = UINT32_MAX;
+      for (uint32_t i = 2; i < input_count; ++i)
+         index[i + 2] = i;
+      VkBufferDeviceAddressInfo address_info{VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO};
+      address_info.buffer = effects.buffer;
+      const VkDeviceAddress address = vkGetBufferDeviceAddress(device, &address_info);
+      require(address != 0, "shader effects address");
+
+      const VkPushConstantRange push{VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT,
+                                     0, sizeof(address)};
+      VkPipelineLayoutCreateInfo layout_info{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+      layout_info.pushConstantRangeCount = 1;
+      layout_info.pPushConstantRanges = &push;
+      VkPipelineLayout layout = VK_NULL_HANDLE;
+      result = vkCreatePipelineLayout(device, &layout_info, nullptr, &layout);
+      require(result == VK_SUCCESS, "create layout", result);
+      const std::span<const uint32_t> sources[] = {
+         vertex_spirv, geometry_spirv, fragment_spirv, stream_geometry_spirv};
+      std::array<VkShaderModule, 4> modules{};
+      for (uint32_t i = 0; i < modules.size(); ++i) {
+         VkShaderModuleCreateInfo module_info{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+         module_info.codeSize = sources[i].size_bytes();
+         module_info.pCode = sources[i].data();
+         result = vkCreateShaderModule(device, &module_info, nullptr, &modules[i]);
+         require(result == VK_SUCCESS, "create shader", result);
+      }
+      VkVertexInputBindingDescription binding{0, 4 * sizeof(float), VK_VERTEX_INPUT_RATE_VERTEX};
+      VkVertexInputAttributeDescription attribute{0, 0, VK_FORMAT_R32G32B32A32_SFLOAT, 0};
+      VkPipelineVertexInputStateCreateInfo vi{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+      vi.vertexBindingDescriptionCount = 1;
+      vi.pVertexBindingDescriptions = &binding;
+      vi.vertexAttributeDescriptionCount = 1;
+      vi.pVertexAttributeDescriptions = &attribute;
+      VkPipelineInputAssemblyStateCreateInfo ia{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+      VkPipelineRasterizationProvokingVertexStateCreateInfoEXT provoking_state{
+         VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_PROVOKING_VERTEX_STATE_CREATE_INFO_EXT};
+      provoking_state.provokingVertexMode = VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT;
+      VkPipelineRasterizationStateStreamCreateInfoEXT stream_state{
+         VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_STREAM_CREATE_INFO_EXT};
+      provoking_state.pNext = &stream_state;
+      VkPipelineRasterizationStateCreateInfo rs{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+      rs.pNext = &provoking_state;
+      rs.lineWidth = 1.0f;
+      const VkViewport viewport{0, 0, 8, 8, 0, 1};
+      const VkRect2D scissor{{0, 0}, {8, 8}};
+      VkPipelineViewportStateCreateInfo vp{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+      vp.viewportCount = 1;
+      vp.pViewports = &viewport;
+      vp.scissorCount = 1;
+      vp.pScissors = &scissor;
+      VkPipelineMultisampleStateCreateInfo ms{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+      ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+      const VkDynamicState dynamic_discard = VK_DYNAMIC_STATE_RASTERIZER_DISCARD_ENABLE;
+      VkPipelineDynamicStateCreateInfo dynamic{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+      dynamic.dynamicStateCount = 1;
+      dynamic.pDynamicStates = &dynamic_discard;
+      VkPipelineRenderingCreateInfo rendering{VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+      VkGraphicsPipelineCreateInfo pipeline_info{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+      pipeline_info.pNext = &rendering;
+      pipeline_info.pVertexInputState = &vi;
+      pipeline_info.pInputAssemblyState = &ia;
+      pipeline_info.pRasterizationState = &rs;
+      pipeline_info.pViewportState = &vp;
+      pipeline_info.pMultisampleState = &ms;
+      pipeline_info.layout = layout;
+      VkCommandPoolCreateInfo pool_info{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+      pool_info.queueFamilyIndex = queue;
+      VkCommandPool pool = VK_NULL_HANDLE;
+      result = vkCreateCommandPool(device, &pool_info, nullptr, &pool);
+      require(result == VK_SUCCESS, "create command pool", result);
+      VkCommandBufferAllocateInfo allocate{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+      allocate.commandPool = pool;
+      allocate.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+      allocate.commandBufferCount = 1;
+      VkCommandBuffer command = VK_NULL_HANDLE;
+      result = vkAllocateCommandBuffers(device, &allocate, &command);
+      require(result == VK_SUCCESS, "allocate command", result);
+      VkFenceCreateInfo fence_info{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+      VkFence fence = VK_NULL_HANDLE;
+      result = vkCreateFence(device, &fence_info, nullptr, &fence);
+      require(result == VK_SUCCESS, "create fence", result);
+      VkQueryPoolCreateInfo query_info{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+      query_info.queryType = VK_QUERY_TYPE_PIPELINE_STATISTICS;
+      query_info.queryCount = 1;
+      query_info.pipelineStatistics = VK_QUERY_PIPELINE_STATISTIC_VERTEX_SHADER_INVOCATIONS_BIT |
+         VK_QUERY_PIPELINE_STATISTIC_GEOMETRY_SHADER_INVOCATIONS_BIT |
+         VK_QUERY_PIPELINE_STATISTIC_GEOMETRY_SHADER_PRIMITIVES_BIT |
+         VK_QUERY_PIPELINE_STATISTIC_CLIPPING_INVOCATIONS_BIT |
+         VK_QUERY_PIPELINE_STATISTIC_CLIPPING_PRIMITIVES_BIT |
+         VK_QUERY_PIPELINE_STATISTIC_FRAGMENT_SHADER_INVOCATIONS_BIT;
+      VkQueryPool query = VK_NULL_HANDLE;
+      result = vkCreateQueryPool(device, &query_info, nullptr, &query);
+      require(result == VK_SUCCESS, "create query pool", result);
+      VkPipelineCacheCreateInfo cache_info{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+      VkPipelineCache cache = VK_NULL_HANDLE;
+      result = vkCreatePipelineCache(device, &cache_info, nullptr, &cache);
+      require(result == VK_SUCCESS, "create cache", result);
+      std::vector<uint8_t> cache_data;
+      auto *captured = static_cast<uint32_t *>(capture.mapped);
+      auto *written = static_cast<uint32_t *>(effects.mapped);
+
+      for (unsigned reload = 0; reload < 2; ++reload) {
+         if (reload) {
+            cache_info.initialDataSize = cache_data.size();
+            cache_info.pInitialData = cache_data.data();
+            result = vkCreatePipelineCache(device, &cache_info, nullptr, &cache);
+            require(result == VK_SUCCESS, "reload cache", result);
+         }
+         for (unsigned producer = 0; producer < 3; ++producer) {
+            const bool geometry = producer != 0;
+            const bool streams = producer == 2;
+            stream_state.rasterizationStream = streams ? 1 : 0;
+            std::vector<VkPipelineShaderStageCreateInfo> stages;
+            const VkShaderStageFlagBits stage_flags[] = {
+               VK_SHADER_STAGE_VERTEX_BIT, VK_SHADER_STAGE_GEOMETRY_BIT, VK_SHADER_STAGE_FRAGMENT_BIT};
+            for (uint32_t i = 0; i < std::size(stage_flags); ++i) {
+               if (i == 1 && !geometry)
+                  continue;
+               VkPipelineShaderStageCreateInfo stage{VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};
+               stage.stage = stage_flags[i];
+               stage.module = modules[streams && i == 1 ? 3 : i];
+               stage.pName = "main";
+               stages.push_back(stage);
+            }
+            pipeline_info.stageCount = stages.size();
+            pipeline_info.pStages = stages.data();
+            ia.topology = geometry ? VK_PRIMITIVE_TOPOLOGY_POINT_LIST : VK_PRIMITIVE_TOPOLOGY_LINE_LIST;
+            ia.primitiveRestartEnable = geometry && !streams;
+            for (bool dynamic_state : {false, true}) {
+               pipeline_info.pDynamicState = dynamic_state ? &dynamic : nullptr;
+               /* A changed ignored create value must still hit a dynamic cache entry. */
+               rs.rasterizerDiscardEnable = !reload || !dynamic_state;
+               pipeline_info.flags = reload ? VK_PIPELINE_CREATE_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT : 0;
+               VkPipeline pipeline = VK_NULL_HANDLE;
+               result = vkCreateGraphicsPipelines(device, cache, 1, &pipeline_info, nullptr, &pipeline);
+               require(result == VK_SUCCESS, "create discard pipeline", result);
+               for (unsigned iteration = 0; iteration < 4; ++iteration) {
+                  const bool discard = !dynamic_state || iteration % 2 == 0;
+                  const uint32_t inputs = streams ? 3 : geometry ? discard ? input_count : 1 : 2;
+                  const uint32_t outputs = geometry && !streams ? inputs * output_count : 0;
+                  std::fill_n(captured, capture_words + 2 * guard_words, sentinel);
+                  std::fill_n(written, input_count + 1, 0);
+                  result = vkResetCommandPool(device, pool, 0);
+                  require(result == VK_SUCCESS, "reset command pool", result);
+                  result = vkResetFences(device, 1, &fence);
+                  require(result == VK_SUCCESS, "reset fence", result);
+                  VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+                  begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+                  result = vkBeginCommandBuffer(command, &begin);
+                  require(result == VK_SUCCESS, "begin command", result);
+                  vkCmdResetQueryPool(command, query, 0, 1);
+                  VkRenderingInfo render{VK_STRUCTURE_TYPE_RENDERING_INFO};
+                  render.renderArea.extent = {8, 8};
+                  render.layerCount = 1;
+                  vkCmdBeginRendering(command, &render);
+                  vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+                  if (dynamic_state)
+                     vkCmdSetRasterizerDiscardEnable(command, discard);
+                  vkCmdPushConstants(command, layout, push.stageFlags, 0, sizeof(address), &address);
+                  const VkDeviceSize zero = 0;
+                  vkCmdBindVertexBuffers(command, 0, 1, &vertices.buffer, &zero);
+                  vkCmdBeginQuery(command, query, 0, 0);
+                  if (geometry && !streams) {
+                     const VkDeviceSize offset = guard_words * sizeof(uint32_t);
+                     const VkDeviceSize size = outputs * sizeof(uint32_t);
+                     vkCmdBindTransformFeedbackBuffersEXT(command, 0, 1, &capture.buffer, &offset, &size);
+                     vkCmdBeginTransformFeedbackEXT(command, 0, 0, nullptr, nullptr);
+                     if (discard) {
+                        vkCmdBindIndexBuffer(command, indices.buffer, 0, VK_INDEX_TYPE_UINT32);
+                        vkCmdDrawIndexed(command, input_count + 2, 1, 0, 0, 0);
+                     } else {
+                        vkCmdDraw(command, inputs, 1, 0, 0);
+                     }
+                     vkCmdEndTransformFeedbackEXT(command, 0, 0, nullptr, nullptr);
+                  } else {
+                     vkCmdDraw(command, inputs, 1, 0, 0);
+                  }
+                  kk_test_assert_raster_discard(command, discard);
+                  vkCmdEndQuery(command, query, 0);
+                  vkCmdEndRendering(command);
+                  VkMemoryBarrier barrier{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+                  barrier.srcAccessMask = VK_ACCESS_TRANSFORM_FEEDBACK_WRITE_BIT_EXT | VK_ACCESS_SHADER_WRITE_BIT;
+                  barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+                  vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_ALL_GRAPHICS_BIT,
+                                       VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+                  result = vkEndCommandBuffer(command);
+                  require(result == VK_SUCCESS, "end command", result);
+                  VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+                  submit.commandBufferCount = 1;
+                  submit.pCommandBuffers = &command;
+                  result = vkQueueSubmit(device_queue, 1, &submit, fence);
+                  require(result == VK_SUCCESS, "submit command", result);
+                  result = vkWaitForFences(device, 1, &fence, VK_TRUE, 10000000000ull);
+                  require(result == VK_SUCCESS, "wait fence", result);
+                  for (uint32_t i = 0; i < input_count; ++i)
+                     require(written[i] == (i < inputs ? i + 1 : 0), "application VS stores survive discard");
+                  require(discard ? written[input_count] == 0 : written[input_count] > 0,
+                          "dynamic discard controls fragment execution");
+                  for (uint32_t i = 0; i < capture_words + 2 * guard_words; ++i) {
+                     const uint32_t expected = i >= guard_words && i < guard_words + outputs
+                                                  ? (i - guard_words) / output_count : sentinel;
+                     require(captured[i] == expected, "XFB values and guards survive discard");
+                  }
+                  std::array<uint64_t, 6> statistics{};
+                  result = vkGetQueryPoolResults(device, query, 0, 1, sizeof(statistics),
+                                                statistics.data(), sizeof(statistics),
+                                                VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT);
+                  require(result == VK_SUCCESS, "read pipeline statistics", result);
+                  require(statistics[0] == inputs, "VS invocation statistics survive discard");
+                  require(statistics[1] == (streams ? 2 * inputs : geometry ? inputs : 0),
+                          "GS invocation statistics survive discard");
+                  require(statistics[2] == (streams ? 6 * inputs : geometry ? outputs / 2 : 0),
+                          "GS primitive statistics survive discard");
+                  if (discard)
+                     require(statistics[3] == 0 && statistics[4] == 0 && statistics[5] == 0,
+                             "discard suppresses clipping and fragment statistics");
+                  else
+                     require(statistics[5] > 0, "restored rasterization invokes fragments");
+                  std::printf("reload=%u producer=%u dynamic=%u discard=%u: VS=%llu GS=%llu XFB=%u FS=%u passed\n",
+                              reload, producer, dynamic_state, discard,
+                              static_cast<unsigned long long>(statistics[0]),
+                              static_cast<unsigned long long>(statistics[1]), outputs, written[input_count]);
+               }
+               vkDestroyPipeline(device, pipeline, nullptr);
+            }
+         }
+         if (!reload) {
+            size_t size = 0;
+            result = vkGetPipelineCacheData(device, cache, &size, nullptr);
+            require(result == VK_SUCCESS, "cache size", result);
+            cache_data.resize(size);
+            result = vkGetPipelineCacheData(device, cache, &size, cache_data.data());
+            require(result == VK_SUCCESS, "serialize cache", result);
+            cache_data.resize(size);
+         }
+         vkDestroyPipelineCache(device, cache, nullptr);
+      }
+      vkDestroyQueryPool(device, query, nullptr);
+      vkDestroyFence(device, fence, nullptr);
+      vkDestroyCommandPool(device, pool, nullptr);
+      for (auto buffer : {capture, vertices, indices, effects}) {
+         vkUnmapMemory(device, buffer.memory);
+         vkDestroyBuffer(device, buffer.buffer, nullptr);
+         vkFreeMemory(device, buffer.memory, nullptr);
+      }
+      for (auto module : modules)
+         vkDestroyShaderModule(device, module, nullptr);
+      vkDestroyPipelineLayout(device, layout, nullptr);
+      vkDestroyDevice(device, nullptr);
+   }
+   vkDestroyInstance(instance, nullptr);
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_raster_variant.c b/src/kosmickrisp/vulkan/tests/test_raster_variant.c
new file mode 100644
index 0000000000000000000000000000000000000000..a656b436a85d2534ce1d803629e4913c443d1d98
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_raster_variant.c
@@ -0,0 +1,80 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kosmickrisp/vulkan/kk_raster_variant.h"
+
+#include <assert.h>
+
+int
+main(void)
+{
+   const enum mesa_prim primitives[] = {
+      MESA_PRIM_POINTS, MESA_PRIM_LINES, MESA_PRIM_LINE_STRIP,
+      MESA_PRIM_LINES_ADJACENCY, MESA_PRIM_LINE_STRIP_ADJACENCY,
+      MESA_PRIM_TRIANGLES, MESA_PRIM_TRIANGLE_STRIP,
+      MESA_PRIM_TRIANGLES_ADJACENCY, MESA_PRIM_TRIANGLE_STRIP_ADJACENCY,
+   };
+   const enum mesa_vk_dynamic_graphics_state dynamic_states[] = {
+      MESA_VK_DYNAMIC_RS_POLYGON_MODE,
+      MESA_VK_DYNAMIC_RS_LINE_MODE,
+      MESA_VK_DYNAMIC_RS_PROVOKING_VERTEX,
+      MESA_VK_DYNAMIC_RS_LINE_STIPPLE_ENABLE,
+      MESA_VK_DYNAMIC_IA_PRIMITIVE_TOPOLOGY,
+      MESA_VK_DYNAMIC_RS_RASTERIZER_DISCARD_ENABLE,
+   };
+
+   /* Independently enumerate all reachable API states. The compiler's mask
+    * must be exactly that union: neither missing an executable nor compiling
+    * ignored state combinations. Fixed GS/TES outputs ignore dynamic IA. */
+   for (unsigned p = 0; p < ARRAY_SIZE(primitives); p++) {
+      for (unsigned fixed = 0; fixed < 2; fixed++) {
+         for (unsigned dynamic = 0; dynamic < 64; dynamic++) {
+            for (unsigned initial = 0; initial < 96; initial++) {
+               struct vk_input_assembly_state ia = {0};
+               struct vk_rasterization_state rs = {
+                  .polygon_mode = initial % 3,
+                  .line.mode = (initial / 3) % 4,
+                  .provoking_vertex = (initial / 12) % 2,
+                  .line.stipple.enable = (initial / 24) % 2,
+                  .rasterizer_discard_enable = initial / 48,
+               };
+               struct vk_graphics_pipeline_state state = {
+                  .ia = &ia, .rs = &rs,
+               };
+               u_foreach_bit(bit, dynamic)
+                  BITSET_SET(state.dynamic, dynamic_states[bit]);
+               uint32_t expected = 0;
+               for (unsigned q = 0; q < ARRAY_SIZE(primitives); q++) {
+                  if ((fixed || !(dynamic & 16)) && q != p)
+                     continue;
+                  if (u_reduced_prim(primitives[q]) !=
+                      u_reduced_prim(primitives[p]))
+                     continue;
+                  for (unsigned live = 0; live < 96; live++) {
+                     struct vk_rasterization_state draw = rs;
+                     if (dynamic & 1)
+                        draw.polygon_mode = live % 3;
+                     if (dynamic & 2)
+                        draw.line.mode = (live / 3) % 4;
+                     if (dynamic & 4)
+                        draw.provoking_vertex = (live / 12) % 2;
+                     if (dynamic & 8)
+                        draw.line.stipple.enable = (live / 24) % 2;
+                     if (dynamic & 32)
+                        draw.rasterizer_discard_enable = live / 48;
+                     expected |= BITFIELD_BIT(
+                        kk_raster_variant_select(primitives[q], &draw));
+                  }
+               }
+               const uint32_t mask =
+                  kk_raster_variant_mask(&state, primitives[p], fixed);
+               assert(mask == expected);
+               assert(util_bitcount(mask) <= KK_RASTER_VARIANT_COUNT);
+            }
+         }
+      }
+   }
+   return 0;
+}
