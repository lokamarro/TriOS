--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_raster_variant.h
@@ -0,0 +1,112 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include "kk_line_raster.h"
+
+/* Executable classes, not a Cartesian product of dynamic API states.  The
+ * base class keeps fills and eligible native lines on the direct Metal path.
+ * Provoking vertex, stipple enable, and depth clipping stay dynamic within a
+ * class; only changes to the actual raster shader require another class.
+ * Discard retains application stages and transform feedback without raster
+ * materialization, coverage generation, or provoking-vertex conversion. */
+enum kk_raster_variant {
+   KK_RASTER_BASE,
+   KK_RASTER_POINT,
+   KK_RASTER_LINE,
+   KK_RASTER_RECTANGULAR,
+   KK_RASTER_SMOOTH,
+   KK_RASTER_DISCARD,
+   KK_RASTER_VARIANT_COUNT,
+};
+
+static inline enum kk_raster_variant
+kk_raster_variant_select(enum mesa_prim primitive,
+                         const struct vk_rasterization_state *rs)
+{
+   if (rs->rasterizer_discard_enable)
+      return KK_RASTER_DISCARD;
+
+   const enum mesa_prim reduced = u_reduced_prim(primitive);
+   if (reduced == MESA_PRIM_TRIANGLES) {
+      if (rs->polygon_mode == VK_POLYGON_MODE_POINT)
+         return KK_RASTER_POINT;
+      if (rs->polygon_mode != VK_POLYGON_MODE_LINE)
+         return KK_RASTER_BASE;
+   } else if (reduced != MESA_PRIM_LINES) {
+      return KK_RASTER_BASE;
+   }
+
+   switch (rs->line.mode) {
+   case VK_LINE_RASTERIZATION_MODE_RECTANGULAR_KHR:
+      return KK_RASTER_RECTANGULAR;
+   case VK_LINE_RASTERIZATION_MODE_RECTANGULAR_SMOOTH_KHR:
+      return KK_RASTER_SMOOTH;
+   default:
+      return kk_line_raster_select_generated(primitive, rs)
+                ? KK_RASTER_LINE : KK_RASTER_BASE;
+   }
+}
+
+static inline uint32_t
+kk_raster_variant_mask(const struct vk_graphics_pipeline_state *state,
+                       enum mesa_prim primitive, bool fixed_primitive)
+{
+   const struct vk_rasterization_state *rs = state->rs;
+   const bool dynamic_discard =
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_RASTERIZER_DISCARD_ENABLE);
+   if (!dynamic_discard && rs->rasterizer_discard_enable)
+      return BITFIELD_BIT(KK_RASTER_DISCARD);
+
+   const enum mesa_prim reduced = u_reduced_prim(primitive);
+   const bool triangles = reduced == MESA_PRIM_TRIANGLES;
+   const bool polygon = triangles &&
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_POLYGON_MODE);
+   const bool fill = triangles &&
+      (polygon || rs->polygon_mode == VK_POLYGON_MODE_FILL);
+   const bool point = triangles &&
+      (polygon || rs->polygon_mode == VK_POLYGON_MODE_POINT);
+   const bool line = reduced == MESA_PRIM_LINES ||
+      (triangles && (polygon || rs->polygon_mode == VK_POLYGON_MODE_LINE));
+   uint32_t mask = (fill || (!point && !line))
+                      ? BITFIELD_BIT(KK_RASTER_BASE) : 0;
+   if (dynamic_discard)
+      mask |= BITFIELD_BIT(KK_RASTER_DISCARD);
+   if (point)
+      mask |= BITFIELD_BIT(KK_RASTER_POINT);
+   if (!line)
+      return mask;
+
+   const bool modes =
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_LINE_MODE);
+   const bool provoking =
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_PROVOKING_VERTEX);
+   const bool stipple =
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_LINE_STIPPLE_ENABLE);
+   const bool topology = !fixed_primitive &&
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_IA_PRIMITIVE_TOPOLOGY);
+   const bool classic = modes ||
+      rs->line.mode == VK_LINE_RASTERIZATION_MODE_DEFAULT_KHR ||
+      rs->line.mode == VK_LINE_RASTERIZATION_MODE_BRESENHAM_KHR;
+   if (classic) {
+      if ((provoking || rs->provoking_vertex ==
+                           VK_PROVOKING_VERTEX_MODE_FIRST_VERTEX_EXT) &&
+          (stipple || !rs->line.stipple.enable) &&
+          (topology || !mesa_prim_has_adjacency(primitive)))
+         mask |= BITFIELD_BIT(KK_RASTER_BASE);
+      if (provoking || rs->provoking_vertex ==
+                          VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT ||
+          stipple || rs->line.stipple.enable || topology ||
+          mesa_prim_has_adjacency(primitive))
+         mask |= BITFIELD_BIT(KK_RASTER_LINE);
+   }
+   if (modes || rs->line.mode == VK_LINE_RASTERIZATION_MODE_RECTANGULAR_KHR)
+      mask |= BITFIELD_BIT(KK_RASTER_RECTANGULAR);
+   if (modes || rs->line.mode ==
+                   VK_LINE_RASTERIZATION_MODE_RECTANGULAR_SMOOTH_KHR)
+      mask |= BITFIELD_BIT(KK_RASTER_SMOOTH);
+   return mask;
+}
