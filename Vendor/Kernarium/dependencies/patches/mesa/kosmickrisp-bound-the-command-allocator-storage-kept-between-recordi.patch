+         /* The grown allocator exceeds what the cache keeps, so its
+          * completion leaves nothing behind to wait for. A small one-time
+          * recording submitted after it completes after it, and its
+          * allocator reaching the cache shows the large one was handled. */
+         VkCommandBufferBeginInfo sentinel_begin = {
+            .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+            .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT};
+         CHECK(vkBeginCommandBuffer(commands[3], &sentinel_begin) ==
+               VK_SUCCESS);
+         vkCmdFillBuffer(commands[3], buffer, 0, 4096, 0);
+         CHECK(vkEndCommandBuffer(commands[3]) == VK_SUCCESS);
+         VkSubmitInfo sentinel = {.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+                                  .commandBufferCount = 1,
+                                  .pCommandBuffers = &commands[3]};
+         CHECK(vkQueueSubmit(queue, 1, &sentinel, VK_NULL_HANDLE) ==
+               VK_SUCCESS);
+      }
+      CHECK(vkQueueWaitIdle(queue) == VK_SUCCESS);
+
+      if (i == 0) {
+         /* Metal hands the allocators back from its completion thread, which
+          * may run just after the wait returns. */
+         unsigned cached;
+         uint64_t bytes;
+         struct timespec start, now;
+         clock_gettime(CLOCK_MONOTONIC, &start);
+         for (;;) {
+            cache_state(dev, &cached, &bytes);
+            clock_gettime(CLOCK_MONOTONIC, &now);
+            if (cached > cached_before || now.tv_sec - start.tv_sec > 5)
+               break;
+            struct timespec pause = {0, 1000000};
+            nanosleep(&pause, NULL);
+         }
+         printf("cache holds %u allocators, %.1f MiB\n", cached,
+                bytes / 1048576.0);
+         CHECK(cached > cached_before);
+         CHECK(bytes <= KK_COMMAND_ALLOCATOR_RETAIN_MAX_B);
+
+         /* A command buffer that is begun and never records, as a GL
+          * driver's spare command buffers are, takes none of that storage. */
+         VkCommandBufferBeginInfo idle_begin = {
+            .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+            .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT};
+         CHECK(holds_no_allocator(commands[2]));
+         CHECK(vkBeginCommandBuffer(commands[2], &idle_begin) == VK_SUCCESS);
+         CHECK(holds_no_allocator(commands[2]));
+         CHECK(vkEndCommandBuffer(commands[2]) == VK_SUCCESS);
+         CHECK(holds_no_allocator(commands[2]));
+         unsigned cached_idle;
+         uint64_t bytes_idle;
+         cache_state(dev, &cached_idle, &bytes_idle);
+         CHECK(cached_idle == cached && bytes_idle == bytes);
+      } else {
+         CHECK(vkResetCommandBuffer(commands[i], 0) == VK_SUCCESS);
+         unsigned cached;
+         uint64_t bytes;
+         cache_state(dev, &cached, &bytes);
+         printf("reset left the command buffer %.1f MiB, the cache %.1f MiB\n",
+                gfx_allocator_bytes(commands[i]) / 1048576.0,
+                bytes / 1048576.0);
+         CHECK(holds_no_allocator(commands[i]));
+         CHECK(bytes <= KK_COMMAND_ALLOCATOR_RETAIN_MAX_B);
+      }
+   }
+
+   vkDestroyCommandPool(device, pool, NULL);
+   vkDestroyBuffer(device, buffer, NULL);
+   vkFreeMemory(device, buffer_memory, NULL);
+   vkDestroyImageView(device, view, NULL);
+   vkDestroyImage(device, image, NULL);
+   vkFreeMemory(device, image_memory, NULL);
+   vkDestroyDevice(device, NULL);
+   vkDestroyInstance(instance, NULL);
+   printf("command allocator budget ok\n");
+   return 0;
+}
