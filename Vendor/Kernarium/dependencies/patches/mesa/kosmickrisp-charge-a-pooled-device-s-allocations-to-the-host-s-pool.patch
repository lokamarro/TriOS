diff --git a/src/kosmickrisp/vulkan/kk_device_memory_pool.c b/src/kosmickrisp/vulkan/kk_device_memory_pool.c
new file mode 100644
index 0000000000000000000000000000000000000000..4235d84f22579f0b61c2dc35eb75cf091699c993
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_device_memory_pool.c
@@ -0,0 +1,99 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kk_device_memory_pool.h"
+
+#include "kk_device.h"
+
+#include "util/macros.h"
+#include "util/simple_mtx.h"
+#include "util/u_atomic.h"
+
+/* The pool this process states for all of its devices. Its callbacks run with
+ * the lock held, which is what makes clearing it final: no callback is running
+ * once kk_set_device_memory_pool() returns, and a device that charged it an
+ * instant earlier did so through callbacks that were valid. The host pool
+ * serializes reservations by itself, so holding the lock adds no contention.
+ * Both the lock and the pool live as long as the process, since a device may
+ * still be destroyed while exit() runs. */
+static simple_mtx_t kk_process_pool_mutex = SIMPLE_MTX_INITIALIZER;
+static VkDeviceMemoryPoolCreateInfoKK kk_process_pool;
+/* Whether kk_process_pool is set, readable without the lock. A stale answer
+ * is harmless: the reservation itself checks again under the lock. */
+static int kk_process_pool_set;
+
+static bool
+kk_pool_complete(const VkDeviceMemoryPoolCreateInfoKK *pool)
+{
+   return pool->pfnReserve != NULL && pool->pfnRelease != NULL &&
+          pool->pfnHeadroom != NULL;
+}
+
+PUBLIC void
+kk_set_device_memory_pool(const VkDeviceMemoryPoolCreateInfoKK *pPool)
+{
+   simple_mtx_lock(&kk_process_pool_mutex);
+   if (pPool != NULL && kk_pool_complete(pPool)) {
+      kk_process_pool = *pPool;
+      kk_process_pool.pNext = NULL;
+      p_atomic_set(&kk_process_pool_set, 1);
+   } else {
+      p_atomic_set(&kk_process_pool_set, 0);
+      kk_process_pool = (VkDeviceMemoryPoolCreateInfoKK){0};
+   }
+   simple_mtx_unlock(&kk_process_pool_mutex);
+}
+
+bool
+kk_device_pooled(const struct kk_device *dev)
+{
+   return dev->memory_pool.pfnReserve != NULL ||
+          p_atomic_read(&kk_process_pool_set) != 0;
+}
+
+bool
+kk_device_pool_reserve(const struct kk_device *dev, VkDeviceSize size)
+{
+   if (dev->memory_pool.pfnReserve != NULL)
+      return dev->memory_pool.pfnReserve(dev->memory_pool.pUserData, size);
+
+   simple_mtx_lock(&kk_process_pool_mutex);
+   /* A pool cleared since the device was last charged leaves it with none,
+    * and an unpooled device has no bound to refuse by. */
+   const bool admitted =
+      kk_process_pool.pfnReserve == NULL ||
+      kk_process_pool.pfnReserve(kk_process_pool.pUserData, size);
+   simple_mtx_unlock(&kk_process_pool_mutex);
+   return admitted;
+}
+
+void
+kk_device_pool_release(const struct kk_device *dev, VkDeviceSize size)
+{
+   if (dev->memory_pool.pfnRelease != NULL) {
+      dev->memory_pool.pfnRelease(dev->memory_pool.pUserData, size);
+      return;
+   }
+
+   simple_mtx_lock(&kk_process_pool_mutex);
+   if (kk_process_pool.pfnRelease != NULL)
+      kk_process_pool.pfnRelease(kk_process_pool.pUserData, size);
+   simple_mtx_unlock(&kk_process_pool_mutex);
+}
+
+VkDeviceSize
+kk_device_pool_headroom(const struct kk_device *dev)
+{
+   if (dev->memory_pool.pfnHeadroom != NULL)
+      return dev->memory_pool.pfnHeadroom(dev->memory_pool.pUserData);
+
+   simple_mtx_lock(&kk_process_pool_mutex);
+   const VkDeviceSize headroom =
+      kk_process_pool.pfnHeadroom != NULL
+         ? kk_process_pool.pfnHeadroom(kk_process_pool.pUserData)
+         : UINT64_MAX;
+   simple_mtx_unlock(&kk_process_pool_mutex);
+   return headroom;
+}
