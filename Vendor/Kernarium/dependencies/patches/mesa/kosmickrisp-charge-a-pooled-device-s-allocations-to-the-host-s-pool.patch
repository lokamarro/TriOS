 #pragma once
 
@@ -49,6 +64,14 @@ typedef struct VkDeviceMemoryPoolCreateInfoKK {
    VkDeviceSize(VKAPI_PTR *pfnHeadroom)(void *pUserData);
 } VkDeviceMemoryPoolCreateInfoKK;
 
+/* States the pool of every device this process creates, or clears it with
+ * NULL (a pool the callbacks of which are not all set is cleared too). The
+ * structure is copied; pUserData must stay valid until the pool is cleared.
+ * A device already created uses the new pool from its next reservation, and
+ * clearing it returns once no callback of the old pool is running, so
+ * pUserData may be released after it. Exported by the driver library. */
+void kk_set_device_memory_pool(const VkDeviceMemoryPoolCreateInfoKK *pPool);
+
 #ifdef __cplusplus
 }
 #endif
