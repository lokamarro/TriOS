diff --git a/src/kosmickrisp/vulkan/tests/test_device_memory_pool.c b/src/kosmickrisp/vulkan/tests/test_device_memory_pool.c
new file mode 100644
index 0000000000000000000000000000000000000000..e3e9b1349d4309cb1a106bfcb34d580335f7cb6c
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_device_memory_pool.c
@@ -0,0 +1,215 @@
+/* SPDX-License-Identifier: MIT */
+
+/* A process that states one device-memory pool has every vkAllocateMemory of
+ * its devices charged to it: the host of a renderer states the pool once, and
+ * the devices a Venus guest and the host's OpenGL driver create then share it
+ * without either chaining anything.  An allocation the pool cannot hold fails
+ * with VK_ERROR_OUT_OF_DEVICE_MEMORY and allocates nothing; the reservation of
+ * one that succeeds is returned once Metal counts the heap, so a pool that
+ * counts what its devices hold sees every byte once.
+ *
+ * The pool here counts what the test allocated, and refuses what would take
+ * that and the reservations under way past its limit.  The test checks the
+ * limit, the balance of reservations and releases, that a refusal charges
+ * nothing and leaves the device usable, that clearing the pool, or stating one
+ * with a callback missing, frees the devices of any bound, and that a pool a
+ * device names itself is charged instead of the process's. */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan_core.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "kosmickrisp/vulkan/kk_device_memory_pool.h"
+#include "kk_test.h"
+
+#define MIB(n) ((VkDeviceSize)(n) << 20)
+
+struct pool {
+   VkDeviceSize limit_B;
+   /* What the test has allocated and not freed, and the reservations under
+    * way. */
+   VkDeviceSize live_B, reserved_B;
+   unsigned reserves, refusals, releases;
+};
+
+static VkDeviceSize
+charge_B(VkDeviceSize size)
+{
+   return (size + 16383u) & ~(VkDeviceSize)16383u;
+}
+
+static VkBool32 VKAPI_PTR
+pool_reserve(void *data, VkDeviceSize size)
+{
+   struct pool *pool = data;
+   pool->reserves++;
+   if (charge_B(size) > pool->limit_B ||
+       pool->live_B + pool->reserved_B > pool->limit_B - charge_B(size)) {
+      pool->refusals++;
+      return VK_FALSE;
+   }
+   pool->reserved_B += charge_B(size);
+   return VK_TRUE;
+}
+
+static void VKAPI_PTR
+pool_release(void *data, VkDeviceSize size)
+{
+   struct pool *pool = data;
+   CHECK(pool->reserved_B >= charge_B(size));
+   pool->reserved_B -= charge_B(size);
+   pool->releases++;
+}
+
+static VkDeviceSize VKAPI_PTR
+pool_headroom(void *data)
+{
+   const struct pool *pool = data;
+   const VkDeviceSize used_B = pool->live_B + pool->reserved_B;
+   return used_B < pool->limit_B ? pool->limit_B - used_B : 0u;
+}
+
+static VkDeviceMemoryPoolCreateInfoKK
+pool_info(struct pool *pool)
+{
+   return (VkDeviceMemoryPoolCreateInfoKK){
+      .sType = VK_STRUCTURE_TYPE_DEVICE_MEMORY_POOL_CREATE_INFO_KK,
+      .pUserData = pool,
+      .pfnReserve = pool_reserve,
+      .pfnRelease = pool_release,
+      .pfnHeadroom = pool_headroom,
+   };
+}
+
+static VkResult
+allocate(const struct kk_test_device *t, uint32_t type, VkDeviceSize size,
+         VkDeviceMemory *memory, struct pool *pool)
+{
+   PFN_vkAllocateMemory allocate_memory =
+      (PFN_vkAllocateMemory)kk_test_device_proc(t, "vkAllocateMemory");
+   VkMemoryAllocateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = size,
+      .memoryTypeIndex = type,
+   };
+   *memory = VK_NULL_HANDLE;
+   const VkResult result = allocate_memory(t->device, &info, NULL, memory);
+   if (result == VK_SUCCESS && pool != NULL)
+      pool->live_B += charge_B(size);
+   return result;
+}
+
+static void
+release(const struct kk_test_device *t, VkDeviceSize size, VkDeviceMemory memory,
+        struct pool *pool)
+{
+   PFN_vkFreeMemory free_memory =
+      (PFN_vkFreeMemory)kk_test_device_proc(t, "vkFreeMemory");
+   free_memory(t->device, memory, NULL);
+   if (pool != NULL)
+      pool->live_B -= charge_B(size);
+}
+
+int
+main(void)
+{
+   /* The pool is stated before any device exists, as a host states it before
+    * it creates the renderer. */
+   struct pool process = {.limit_B = MIB(96)};
+   VkDeviceMemoryPoolCreateInfoKK info = pool_info(&process);
+   kk_set_device_memory_pool(&info);
+
+   struct kk_test_device t;
+   kk_test_create_instance(&t, NULL);
+   kk_test_create_device(&t, NULL, NULL, 0, NULL);
+   const uint32_t device_type =
+      kk_test_memory_type(&t, ~0u, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+   const uint32_t host_type = kk_test_memory_type(&t, ~0u, KK_TEST_HOST_MEMORY);
+
+   /* What fits is admitted, and its reservation is returned. */
+   VkDeviceMemory memory[3] = {0}, extra = VK_NULL_HANDLE;
+   for (unsigned i = 0; i < 3; i++)
+      CHECK(allocate(&t, device_type, MIB(32), &memory[i], &process) ==
+            VK_SUCCESS);
+   CHECK(process.live_B == MIB(96));
+   CHECK(process.reserved_B == 0u);
+   CHECK(process.reserves >= 3u && process.reserves == process.releases);
+
+   /* What does not is refused with the error an application handles, and
+    * nothing is charged for it. */
+   const unsigned refused = process.refusals;
+   CHECK(allocate(&t, device_type, MIB(32), &extra, &process) ==
+         VK_ERROR_OUT_OF_DEVICE_MEMORY);
+   CHECK(extra == VK_NULL_HANDLE);
+   CHECK(process.refusals == refused + 1u);
+   CHECK(process.reserved_B == 0u && process.live_B == MIB(96));
+   /* A full pool refuses the smallest allocation too, of either kind of
+    * memory. */
+   CHECK(allocate(&t, device_type, 16384u, &extra, &process) ==
+         VK_ERROR_OUT_OF_DEVICE_MEMORY);
+   CHECK(allocate(&t, host_type, 16384u, &extra, &process) ==
+         VK_ERROR_OUT_OF_DEVICE_MEMORY);
+
+   /* A refusal leaves the device as it was: what is freed can be allocated
+    * again, in pieces as well. */
+   release(&t, MIB(32), memory[0], &process);
+   CHECK(allocate(&t, device_type, MIB(16), &memory[0], &process) ==
+         VK_SUCCESS);
+   VkDeviceMemory visible = VK_NULL_HANDLE;
+   CHECK(allocate(&t, host_type, MIB(16), &visible, &process) == VK_SUCCESS);
+   CHECK(process.live_B == MIB(96));
+   CHECK(allocate(&t, host_type, MIB(16), &extra, &process) ==
+         VK_ERROR_OUT_OF_DEVICE_MEMORY);
+   release(&t, MIB(16), visible, &process);
+   release(&t, MIB(16), memory[0], &process);
+   for (unsigned i = 1; i < 3; i++)
+      release(&t, MIB(32), memory[i], &process);
+   CHECK(process.live_B == 0u && process.reserved_B == 0u);
+   CHECK(process.reserves == process.releases + process.refusals);
+
+   /* Clearing the pool frees every device of its bound; a pool with a
+    * callback missing is no pool. */
+   kk_set_device_memory_pool(NULL);
+   const unsigned reserves = process.reserves;
+   VkDeviceMemory large = VK_NULL_HANDLE;
+   CHECK(allocate(&t, device_type, MIB(128), &large, NULL) == VK_SUCCESS);
+   release(&t, MIB(128), large, NULL);
+   VkDeviceMemoryPoolCreateInfoKK incomplete = pool_info(&process);
+   incomplete.pfnHeadroom = NULL;
+   kk_set_device_memory_pool(&incomplete);
+   CHECK(allocate(&t, device_type, MIB(128), &large, NULL) == VK_SUCCESS);
+   release(&t, MIB(128), large, NULL);
+   CHECK(process.reserves == reserves);
+
+   /* A pool the process states again is charged from the next allocation,
+    * by the devices that exist already. */
+   process.limit_B = MIB(48);
+   kk_set_device_memory_pool(&info);
+   CHECK(allocate(&t, device_type, MIB(64), &large, &process) ==
+         VK_ERROR_OUT_OF_DEVICE_MEMORY);
+   CHECK(allocate(&t, device_type, MIB(32), &large, &process) == VK_SUCCESS);
+   release(&t, MIB(32), large, &process);
+   kk_test_destroy_device(&t);
+
+   /* A device that names a pool itself charges that one, and the process's
+    * is left alone. */
+   struct pool own = {.limit_B = MIB(64)};
+   VkDeviceMemoryPoolCreateInfoKK own_info = pool_info(&own);
+   process.limit_B = 0u;
+   const unsigned process_reserves = process.reserves;
+   kk_test_create_device(&t, &own_info, NULL, 0, NULL);
+   CHECK(allocate(&t, device_type, MIB(32), &memory[0], &own) == VK_SUCCESS);
+   CHECK(allocate(&t, device_type, MIB(48), &memory[1], &own) ==
+         VK_ERROR_OUT_OF_DEVICE_MEMORY);
+   CHECK(own.reserves >= 2u && own.refusals == 1u && own.reserved_B == 0u);
+   CHECK(process.reserves == process_reserves);
+   release(&t, MIB(32), memory[0], &own);
+
+   kk_set_device_memory_pool(NULL);
+   kk_test_destroy(&t);
+   printf("a pooled device charges every allocation and refuses what the "
+          "pool cannot hold\n");
+   return 0;
+}
