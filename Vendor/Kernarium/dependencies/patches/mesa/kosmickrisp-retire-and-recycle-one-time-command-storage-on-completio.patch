    simple_mtx_init(&dev->address_space.mutex, mtx_plain);
    list_inithead(&dev->address_space.allocations);
 
+   dev->allocator_cache = kk_command_allocator_cache_create();
+   if (dev->allocator_cache == NULL) {
+      result = vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+      goto fail_vab_memory;
+   }
+
    if (pCreateInfo->queueCreateInfoCount > 0) {
       result =
          kk_queue_init(dev, &dev->queue, &pCreateInfo->pQueueCreateInfos[0], 0);
@@ -365,6 +443,8 @@ fail_mem_cache:
       dev->has_queue = false;
    }
 fail_vab_memory:
+   if (dev->allocator_cache)
+      kk_command_allocator_cache_unref(dev->allocator_cache);
    simple_mtx_destroy(&dev->address_space.mutex);
    mtl_release(dev->residency_set.handle);
    simple_mtx_destroy(&dev->residency_set.mutex);
@@ -408,6 +488,9 @@ kk_DestroyDevice(VkDevice _device, const VkAllocationCallbacks *pAllocator)
       dev->has_queue = false;
    }
 
+   /* Outstanding completion callbacks keep their own reference. */
+   kk_command_allocator_cache_unref(dev->allocator_cache);
+
    /* Release the residency set last once all BOs are released. */
    assert(list_is_empty(&dev->address_space.allocations));
    simple_mtx_destroy(&dev->address_space.mutex);
