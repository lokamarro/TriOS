-}
-
 static void
 kk_get_image_memory_requirements(struct kk_device *dev, struct kk_image *image,
                                  VkImageAspectFlags aspects,
@@ -897,17 +924,18 @@ kk_get_image_memory_requirements(struct kk_device *dev, struct kk_image *image,
 
    // TODO hope for the best?
 
+   /* The requirement has to reach the end of the last plane, wherever the
+    * planes sit: they are packed one after another unless an importer said
+    * otherwise, and then they sit where it said. */
    uint64_t size_B = 0;
    uint32_t align_B = 0;
-   if (image->disjoint) {
-      uint8_t plane = kk_image_memory_aspects_to_plane(image, aspects);
-      kk_image_plane_add_req(dev, image, &image->planes[plane], &size_B,
-                             &align_B);
-   } else {
-      for (unsigned plane = 0; plane < image->plane_count; plane++) {
-         kk_image_plane_add_req(dev, image, &image->planes[plane], &size_B,
-                                &align_B);
-      }
+   const uint8_t first =
+      image->disjoint ? kk_image_memory_aspects_to_plane(image, aspects) : 0;
+   const uint8_t last = image->disjoint ? first + 1 : image->plane_count;
+   for (uint8_t plane = first; plane < last; plane++) {
+      const struct kk_image_plane *p = &image->planes[plane];
+      align_B = MAX2(align_B, (uint32_t)p->layout.align_B);
+      size_B = MAX2(size_B, p->offset_B + p->layout.size_B);
    }
 
    pMemoryRequirements->memoryRequirements.memoryTypeBits = memory_types;
@@ -998,14 +1026,7 @@ kk_get_image_subresource_layout(struct kk_device *dev, struct kk_image *image,
    const uint8_t p = kk_image_memory_aspects_to_plane(image, isr->aspectMask);
    const struct kk_image_plane *plane = &image->planes[p];
 
-   uint64_t offset_B = 0;
-   if (!image->disjoint) {
-      uint32_t align_B = 0;
-      for (unsigned i = 0; i < p; i++) {
-         kk_image_plane_add_req(dev, image, &image->planes[i], &offset_B,
-                                &align_B);
-      }
-   }
+   const uint64_t offset_B = plane->offset_B;
 
    pLayout->subresourceLayout = (VkSubresourceLayout){
       .offset = offset_B,
@@ -1090,13 +1111,8 @@ kk_image_plane_report_address_binding(struct kk_device *dev,
 static VkResult
 kk_image_plane_bind(struct kk_device *dev, struct kk_image *image,
                     struct kk_image_plane *plane, struct kk_device_memory *mem,
-                    uint64_t *offset_B)
+                    uint64_t offset_B)
 {
-   uint64_t plane_size_B, plane_align_B;
-   kk_image_plane_size_align_B(dev, image, plane, &plane_size_B,
-                               &plane_align_B);
-   *offset_B = align64(*offset_B, plane_align_B);
-
    if (!plane->layout.linear && !mem->bo->mtl_handle) {
       return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
                        "optimal image memory has no Metal heap");
@@ -1104,7 +1120,7 @@ kk_image_plane_bind(struct kk_device *dev, struct kk_image *image,
 
    /* Linear textures in Metal need to be allocated through a buffer... */
    plane->mem = mem;
-   plane->mem_offset_B = *offset_B;
+   plane->mem_offset_B = offset_B;
    plane->mtl_handle = kk_image_plane_create_texture(plane, &plane->layout, 0u);
    if (!plane->mtl_handle) {
       plane->mem = NULL;
@@ -1112,7 +1128,7 @@ kk_image_plane_bind(struct kk_device *dev, struct kk_image *image,
       return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
                        "Metal refused the image texture");
    }
-   plane->addr = mem->bo->gpu + *offset_B;
+   plane->addr = mem->bo->gpu + offset_B;
 
    /* Create auxiliary 2D array texture for 3D images so we can use 2D views of
     * it */
@@ -1126,7 +1142,7 @@ kk_image_plane_bind(struct kk_device *dev, struct kk_image *image,
       array_layout.depth_px = 1u;
       array_layout.levels = kk_image_layout_array_alias_levels(&plane->layout);
       plane->mtl_handle_array = mtl_new_texture_with_descriptor(
-         mem->bo->mtl_handle, &array_layout, *offset_B);
+         mem->bo->mtl_handle, &array_layout, offset_B);
       if (!plane->mtl_handle_array) {
          mtl_release(plane->mtl_handle);
          plane->mtl_handle = NULL;
@@ -1138,8 +1154,6 @@ kk_image_plane_bind(struct kk_device *dev, struct kk_image *image,
       }
    }
 
-   *offset_B += plane_size_B;
-
    kk_image_plane_report_address_binding(dev, image, plane,
                                          VK_DEVICE_ADDRESS_BINDING_TYPE_BIND_EXT);
    return VK_SUCCESS;
@@ -1197,20 +1211,21 @@ kk_bind_image_memory(struct kk_device *dev, const VkBindImageMemoryInfo *info)
    }
 #endif
 
-   uint64_t offset_B = info->memoryOffset;
    if (image->disjoint) {
       const VkBindImagePlaneMemoryInfo *plane_info =
          vk_find_struct_const(info->pNext, BIND_IMAGE_PLANE_MEMORY_INFO);
       const uint8_t plane =
          kk_image_memory_aspects_to_plane(image, plane_info->planeAspect);
-      result =
-         kk_image_plane_bind(dev, image, &image->planes[plane], mem, &offset_B);
+      result = kk_image_plane_bind(dev, image, &image->planes[plane], mem,
+                                   info->memoryOffset +
+                                      image->planes[plane].offset_B);
       if (result != VK_SUCCESS)
          return result;
    } else {
       for (unsigned plane = 0; plane < image->plane_count; plane++) {
          result = kk_image_plane_bind(dev, image, &image->planes[plane], mem,
-                                      &offset_B);
+                                      info->memoryOffset +
+                                         image->planes[plane].offset_B);
          if (result != VK_SUCCESS)
             return result;
       }
