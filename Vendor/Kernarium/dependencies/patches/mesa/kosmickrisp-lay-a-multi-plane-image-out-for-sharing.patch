diff --git a/src/kosmickrisp/vulkan/tests/test_drm_plane_offset.c b/src/kosmickrisp/vulkan/tests/test_drm_plane_offset.c
new file mode 100644
index 0000000000000000000000000000000000000000..b3353c15f4c59270f21d7216d95ac90d58161d05
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_drm_plane_offset.c
@@ -0,0 +1,158 @@
+/* SPDX-License-Identifier: MIT */
+
+/* An explicit DRM-modifier layout names where each plane starts, and Vulkan
+ * puts no bound on that offset.  The image's memory requirement is the end of
+ * its last plane, so an offset near 2^64 would wrap that requirement below
+ * the plane's own size: a small allocation would then satisfy the bind rule
+ * and the plane would be bound far outside it.  No allocation is larger than
+ * the device's largest buffer, so a plane that ends past it must be refused
+ * when the image is created, and one inside it must be required whole. */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan_core.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "drm-uapi/drm_fourcc.h"
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x); abort(); } } while (0)
+#define LOAD_I(name) PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name); CHECK(name)
+#define LOAD_D(name) PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name); CHECK(name)
+
+int
+main(void)
+{
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+                            .apiVersion = VK_API_VERSION_1_3};
+   VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   CHECK(vkCreateInstance(&instance_info, NULL, &instance) == VK_SUCCESS);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   uint32_t count = 1;
+   VkPhysicalDevice physical = VK_NULL_HANDLE;
+   VkResult enumerated =
+      vkEnumeratePhysicalDevices(instance, &count, &physical);
+   CHECK((enumerated == VK_SUCCESS || enumerated == VK_INCOMPLETE) && count);
+   VkPhysicalDeviceMaintenance4Properties maintenance4 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MAINTENANCE_4_PROPERTIES,
+   };
+   VkPhysicalDeviceProperties2 properties = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+      .pNext = &maintenance4,
+   };
+   LOAD_I(vkGetPhysicalDeviceProperties2);
+   vkGetPhysicalDeviceProperties2(physical, &properties);
+   const uint64_t max_buffer = maintenance4.maxBufferSize;
+   CHECK(max_buffer > 0);
+
+   const float priority = 1.0f;
+   VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   const char *extensions[] = {VK_EXT_IMAGE_DRM_FORMAT_MODIFIER_EXTENSION_NAME};
+   VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+      .enabledExtensionCount = 1,
+      .ppEnabledExtensionNames = extensions,
+   };
+   VkDevice device = VK_NULL_HANDLE;
+   CHECK(vkCreateDevice(physical, &device_info, NULL, &device) == VK_SUCCESS);
+   LOAD_D(vkDestroyDevice);
+   LOAD_D(vkCreateImage);
+   LOAD_D(vkDestroyImage);
+   LOAD_D(vkGetImageSubresourceLayout);
+   LOAD_D(vkGetImageMemoryRequirements);
+
+   /* The plane layout the driver chooses itself, whose row pitch an explicit
+    * layout has to repeat. */
+   const uint64_t linear = DRM_FORMAT_MOD_LINEAR;
+   VkImageDrmFormatModifierListCreateInfoEXT list = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT,
+      .drmFormatModifierCount = 1,
+      .pDrmFormatModifiers = &linear,
+   };
+   VkImageCreateInfo image_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .pNext = &list,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = VK_FORMAT_R8G8B8A8_UNORM,
+      .extent = {256, 256, 1},
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+      .usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+   };
+   VkImage listed = VK_NULL_HANDLE;
+   CHECK(vkCreateImage(device, &image_info, NULL, &listed) == VK_SUCCESS);
+   const VkImageSubresource plane0 = {
+      .aspectMask = VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT,
+   };
+   VkSubresourceLayout layout;
+   vkGetImageSubresourceLayout(device, listed, &plane0, &layout);
+   VkMemoryRequirements listed_requirements;
+   vkGetImageMemoryRequirements(device, listed, &listed_requirements);
+   vkDestroyImage(device, listed, NULL);
+   CHECK(layout.size >= 256u * 256u * 4u);
+
+   /* Every offset below is a multiple of 64 KiB, which is a multiple of any
+    * alignment Metal asks of a linear texture, so only its size can refuse
+    * it. */
+   const uint64_t offsets[] = {
+      /* Inside any allocation the device can make. */
+      UINT64_C(0x40000),
+      /* The end wraps past 2^64 to less than the plane's own size. */
+      UINT64_C(0xffffffffffff0000),
+      /* The end does not wrap but no allocation reaches it. */
+      UINT64_C(0x8000000000000000),
+   };
+   for (unsigned i = 0; i < 3; i++) {
+      const VkSubresourceLayout given = {
+         .offset = offsets[i],
+         .rowPitch = layout.rowPitch,
+      };
+      VkImageDrmFormatModifierExplicitCreateInfoEXT explicit_layout = {
+         .sType =
+            VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT,
+         .drmFormatModifier = DRM_FORMAT_MOD_LINEAR,
+         .drmFormatModifierPlaneCount = 1,
+         .pPlaneLayouts = &given,
+      };
+      image_info.pNext = &explicit_layout;
+      VkImage image = VK_NULL_HANDLE;
+      VkResult result = vkCreateImage(device, &image_info, NULL, &image);
+      const int fits = offsets[i] <= max_buffer - layout.size;
+      fprintf(stderr, "offset 0x%llx: vkCreateImage = %d\n",
+              (unsigned long long)offsets[i], result);
+      if (!fits) {
+         CHECK(result == VK_ERROR_INVALID_DRM_FORMAT_MODIFIER_PLANE_LAYOUT_EXT);
+         continue;
+      }
+      CHECK(result == VK_SUCCESS);
+      VkMemoryRequirements requirements;
+      vkGetImageMemoryRequirements(device, image, &requirements);
+      CHECK(requirements.size >= offsets[i] + layout.size);
+      CHECK(requirements.size >= listed_requirements.size);
+      vkDestroyImage(device, image, NULL);
+   }
+
+   vkDestroyDevice(device, NULL);
+   vkDestroyInstance(instance, NULL);
+   printf("an explicit DRM plane offset stays inside the largest "
+          "allocation\n");
+   return 0;
+}
