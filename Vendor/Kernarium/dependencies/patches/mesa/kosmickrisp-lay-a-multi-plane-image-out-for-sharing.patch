diff --git a/src/kosmickrisp/vulkan/kk_image.c b/src/kosmickrisp/vulkan/kk_image.c
index af698e9d6772579bf46f056b89fea6dd390ac296..72b1f4c24d3a54cddfdc590480a53cc9bc1fbdbe 100644
--- a/src/kosmickrisp/vulkan/kk_image.c
+++ b/src/kosmickrisp/vulkan/kk_image.c
@@ -634,6 +634,25 @@ kk_GetPhysicalDeviceSparseImageFormatProperties2(
    return;
 }
 
+/* A joined image packs its planes into one allocation, each starting at the
+ * alignment its own layout asks for. A disjoint image binds every plane
+ * separately, so each one starts its own allocation.
+ */
+static uint64_t
+kk_image_packed_plane_offset_B(const struct kk_image *image, uint8_t plane)
+{
+   if (image->disjoint)
+      return 0;
+
+   uint64_t offset_B = 0;
+   for (uint8_t i = 0; i < plane; i++) {
+      offset_B = align64(offset_B, image->planes[i].layout.align_B);
+      offset_B += image->planes[i].layout.size_B;
+   }
+
+   return align64(offset_B, image->planes[plane].layout.align_B);
+}
+
 static VkResult
 kk_image_init(struct kk_device *dev, struct kk_image *image,
               const VkImageCreateInfo *pCreateInfo)
@@ -734,11 +753,12 @@ kk_image_init(struct kk_device *dev, struct kk_image *image,
       }
    }
 
-   /* An explicit layout describes memory this driver did not lay out. Metal
-    * fixes a linear texture's row pitch through its own alignment rule, so
-    * the only explicit layout that can be bound here is the one this driver
-    * would have produced; anything else has to be refused rather than
-    * silently ignored. */
+   /* An explicit layout describes memory this driver did not lay out: an
+    * importer names where each plane already is, which is how one dma-buf
+    * carries a whole multi-plane frame. Metal fixes a linear texture's row
+    * pitch through its own alignment rule and can start one only at a
+    * multiple of that same alignment, so a layout that disagrees with either
+    * has to be refused rather than silently ignored. */
    if (mod_explicit != NULL) {
       if (mod_explicit->drmFormatModifierPlaneCount != image->plane_count) {
          vk_image_finish(&image->vk);
@@ -752,21 +772,52 @@ kk_image_init(struct kk_device *dev, struct kk_image *image,
          const struct kk_image_layout *layout = &image->planes[plane].layout;
          const VkSubresourceLayout *given = &mod_explicit->pPlaneLayouts[plane];
 
-         if (given->offset != 0 || given->rowPitch != layout->linear_stride_B ||
-             (given->size != 0 && given->size != layout->size_B) ||
+         /* The row pitch is Metal's to decide, so a layout that names a
+          * different one describes memory this driver cannot read. The
+          * offset is the importer's to decide - that is the whole point of
+          * an explicit layout - as long as a Metal texture can start there.
+          */
+         if (given->rowPitch != layout->linear_stride_B ||
+             given->offset % layout->align_B != 0 ||
+             (given->size != 0 && given->size < layout->size_B) ||
              given->arrayPitch != 0 || given->depthPitch != 0) {
             vk_image_finish(&image->vk);
             return vk_errorf(
                dev, VK_ERROR_INVALID_DRM_FORMAT_MODIFIER_PLANE_LAYOUT_EXT,
-               "plane %u wants offset %llu pitch %llu, Metal lays it out at "
-               "offset 0 pitch %u",
+               "plane %u wants offset %llu pitch %llu, Metal needs pitch %u "
+               "at an offset that is a multiple of %u",
                (unsigned)plane, (unsigned long long)given->offset,
                (unsigned long long)given->rowPitch,
-               (unsigned)layout->linear_stride_B);
+               (unsigned)layout->linear_stride_B,
+               (unsigned)layout->align_B);
+         }
+
+         /* Nothing Vulkan says bounds the offset, but no allocation is
+          * larger than the device's largest buffer. A plane that ends past
+          * that could only be bound through a memory requirement that
+          * wrapped, and would then sit outside its allocation. */
+         const uint64_t max_B = kk_device_physical(dev)->info.max_buffer_size;
+         if (layout->size_B > max_B || given->offset > max_B - layout->size_B) {
+            vk_image_finish(&image->vk);
+            return vk_errorf(
+               dev, VK_ERROR_INVALID_DRM_FORMAT_MODIFIER_PLANE_LAYOUT_EXT,
+               "plane %u at offset %llu ends past the largest allocation, "
+               "%llu bytes",
+               (unsigned)plane, (unsigned long long)given->offset,
+               (unsigned long long)max_B);
          }
       }
    }
 
+   /* A plane sits where the importer says it does, or, with no importer to
+    * say, packed after the plane before it.
+    */
+   for (uint8_t plane = 0; plane < image->plane_count; plane++) {
+      image->planes[plane].offset_B =
+         mod_explicit != NULL ? mod_explicit->pPlaneLayouts[plane].offset
+                              : kk_image_packed_plane_offset_B(image, plane);
+   }
+
    return VK_SUCCESS;
 }
 
@@ -783,15 +834,6 @@ kk_GetImageDrmFormatModifierPropertiesEXT(
    return VK_SUCCESS;
 }
 
-static void
-kk_image_plane_size_align_B(struct kk_device *dev, const struct kk_image *image,
-                            const struct kk_image_plane *plane,
-                            uint64_t *size_B_out, uint64_t *align_B_out)
