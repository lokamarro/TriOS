From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 8 Nov 2026 23:42:08 +0900
Subject: [PATCH] mesa: let a desktop context copy the ETC2, EAC and ASTC
 formats it has

OpenGL ES puts ETC2, EAC and ASTC in copy and view classes, and in the
table of block sizes that lets a compressed image be copied to and from
an uncompressed one. Mesa looked those up only in an OpenGL ES context,
so a desktop context refused glCopyImageSubData between, say, an ASTC
image and its sRGB form, or between an ETC2 image and RG32UI.

virglrenderer renders an OpenGL ES guest on a desktop core context.
Once that host offers the formats, the guest's copies come to it, and
dEQP-GLES31.functional.copy_image.compressed failed every pair of two
formats of one class.

A desktop context that has GL_ARB_ES3_compatibility now uses the ETC2
and EAC classes and block sizes, and one that has
GL_KHR_texture_compression_astc_ldr the ASTC ones.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/mesa/main/copyimage.c   | 14 +++++++++++---
 src/mesa/main/textureview.c |  8 +++++++-
 2 files changed, 18 insertions(+), 4 deletions(-)

diff --git a/src/mesa/main/copyimage.c b/src/mesa/main/copyimage.c
index b564edaf9a6f9f8cb9cf0e0f0ea1100e7c59a2de..6c7094f057082960bcf068dc5b450c70ec0f53d5 100644
--- a/src/mesa/main/copyimage.c
+++ b/src/mesa/main/copyimage.c
@@ -439,6 +439,14 @@ compressed_format_compatible(const struct gl_context *ctx,
     *    ---------------------------------------------------------------------
     */
 
+   /* Table 4.X.1 of OpenGL ES adds the ETC2, EAC and ASTC rows. A desktop
+    * context that has the formats takes them too, for a host whose OpenGL
+    * ES guest copies them.
+    */
+   const bool etc2 = _mesa_is_gles(ctx) || _mesa_has_ARB_ES3_compatibility(ctx);
+   const bool astc = _mesa_is_gles(ctx) ||
+                     _mesa_has_KHR_texture_compression_astc_ldr(ctx);
+
    switch (compressedFormat) {
       case GL_COMPRESSED_RGBA_S3TC_DXT3_EXT:
       case GL_COMPRESSED_SRGB_ALPHA_S3TC_DXT3_EXT:
@@ -464,7 +472,7 @@ compressed_format_compatible(const struct gl_context *ctx,
       case GL_COMPRESSED_SRGB8_ALPHA8_ETC2_EAC:
       case GL_COMPRESSED_RG11_EAC:
       case GL_COMPRESSED_SIGNED_RG11_EAC:
-         if (_mesa_is_gles(ctx))
+         if (etc2)
             compressedClass = BLOCK_CLASS_128_BITS;
          else
             return false;
@@ -475,13 +483,13 @@ compressed_format_compatible(const struct gl_context *ctx,
       case GL_COMPRESSED_SIGNED_R11_EAC:
       case GL_COMPRESSED_RGB8_PUNCHTHROUGH_ALPHA1_ETC2:
       case GL_COMPRESSED_SRGB8_PUNCHTHROUGH_ALPHA1_ETC2:
-         if (_mesa_is_gles(ctx))
+         if (etc2)
             compressedClass = BLOCK_CLASS_64_BITS;
          else
             return false;
          break;
       default:
-         if (_mesa_is_gles(ctx) && _mesa_is_astc_format(compressedFormat))
+         if (astc && _mesa_is_astc_format(compressedFormat))
             compressedClass = BLOCK_CLASS_128_BITS;
          else
             return false;
diff --git a/src/mesa/main/textureview.c b/src/mesa/main/textureview.c
index 37d935af6c2ff567831d18276fd5584e496d8282..928fc4663a642a10d2b6fcbb62284ad7753716ec 100644
--- a/src/mesa/main/textureview.c
+++ b/src/mesa/main/textureview.c
@@ -272,13 +272,19 @@ _mesa_texture_view_lookup_view_class(const struct gl_context *ctx, GLenum intern
       }
    }
 
-   if (_mesa_is_gles3(ctx)) {
+   /* OpenGL ES defines the ETC2, EAC and ASTC classes. A desktop context
+    * that has the formats uses them too, so that a host renders the copies
+    * an OpenGL ES guest of it asks for.
+    */
+   if (_mesa_is_gles3(ctx) || _mesa_has_ARB_ES3_compatibility(ctx)) {
       for (i = 0; i < ARRAY_SIZE(gles_etc2_compatible_internal_formats); i++) {
          if (gles_etc2_compatible_internal_formats[i].internal_format
              == internalformat)
             return gles_etc2_compatible_internal_formats[i].view_class;
       }
+   }
 
+   if (_mesa_is_gles3(ctx) || _mesa_is_desktop_gl(ctx)) {
       if (ctx->Extensions.KHR_texture_compression_astc_ldr) {
          for (i = 0; i < ARRAY_SIZE(gles_astc_compatible_internal_formats); i++) {
             if (gles_astc_compatible_internal_formats[i].internal_format
