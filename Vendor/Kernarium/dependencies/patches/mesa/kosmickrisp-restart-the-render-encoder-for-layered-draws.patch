diff --git a/src/kosmickrisp/vulkan/tests/layered_draw_shaders/points.vert b/src/kosmickrisp/vulkan/tests/layered_draw_shaders/points.vert
new file mode 100644
index 0000000000000000000000000000000000000000..f20b80b128ea94dd9aa2efe6649514861b7b7305
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/layered_draw_shaders/points.vert
@@ -0,0 +1,24 @@
+#version 460
+/* SPDX-License-Identifier: MIT */
+#extension GL_ARB_shader_viewport_layer_array : enable
+layout (push_constant, std430) uniform PushConstantBlock {
+    int layer;
+    int width;
+} pc;
+layout (location=0) out flat int outLayer;
+out gl_PerVertex
+{
+    vec4 gl_Position;
+    float gl_PointSize;
+};
+void main (void) {
+    /* One point per texel, in raster order. */
+    const int x = gl_VertexIndex % pc.width;
+    const int y = gl_VertexIndex / pc.width;
+    gl_Position = vec4((float(x) + 0.5) / float(pc.width) * 2.0 - 1.0,
+                       (float(y) + 0.5) / float(pc.width) * 2.0 - 1.0,
+                       0.0, 1.0);
+    gl_PointSize = 1.0;
+    gl_Layer = pc.layer;
+    outLayer = pc.layer;
+}
