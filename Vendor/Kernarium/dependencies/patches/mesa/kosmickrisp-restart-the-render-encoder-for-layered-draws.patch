+/* Whether the stage that feeds the rasterizer selects the layer: the
+ * emulated geometry shader's raster draw, else the tessellation evaluation
+ * shader, else the vertex shader. */
+static bool
+kk_raster_writes_layer(const struct kk_cmd_buffer *cmd)
+{
+   const struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   const struct kk_shader *tes = cmd->state.shaders[MESA_SHADER_TESS_EVAL];
+
+   if (vs == NULL)
+      return false;
+   if (vs->info.vs.geometry_shader_emulation)
+      return vs->info.vs.geometry_writes_layer;
+   const uint64_t outputs =
+      tes ? tes->info.tess.outputs_written : vs->info.vs.outputs_written;
+   return (outputs & VARYING_BIT_LAYER) != 0u;
+}
+
+/* KK_WORKAROUND_18: a layer-selecting Metal draw must be the first in its
+ * render encoder. */
+static bool
+kk_layered_draw_needs_encoder_restart(const struct kk_cmd_buffer *cmd)
+{
+   const struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   return gfx->render.layer_count > 1u &&
+          gfx->draws_since_encoder_start > 0u && kk_raster_writes_layer(cmd);
+}
