@@ -0,0 +1,23 @@
+#version 460
+/* SPDX-License-Identifier: MIT */
+layout (points) in;
+layout (points, max_vertices = 1) out;
+layout (push_constant, std430) uniform PushConstantBlock {
+    int layer;
+    int width;
+} pc;
+layout (location=0) out flat int outLayer;
+in gl_PerVertex
+{
+    vec4 gl_Position;
+} gl_in[];
+out gl_PerVertex
+{
+    vec4 gl_Position;
+};
+void main (void) {
+    gl_Position = gl_in[0].gl_Position;
+    gl_Layer = pc.layer;
+    outLayer = pc.layer;
+    EmitVertex();
+}
