+                                      state->vertex_amplification_count);
 
    /* Argument table won't ever change */
    mtl_render_set_argument_table(
@@ -351,6 +357,25 @@ cs_start_render(struct kk_cmd_buffer *cmd)
    kk_cmd_buffer_dirty_all_gfx(cmd);
 }
 
+void
+kk_cmd_buffer_set_vertex_amplification(struct kk_cmd_buffer *cmd,
+                                       const uint32_t *layer_ids,
+                                       uint32_t count)
+{
+   struct kk_graphics_state *state = &cmd->state.gfx;
+
+   assert(count > 0u && count <= ARRAY_SIZE(state->vertex_amplification_ids));
+   memcpy(state->vertex_amplification_ids, layer_ids,
+          count * sizeof(state->vertex_amplification_ids[0]));
+   state->vertex_amplification_count = count;
+
+   /* A restarted encoder replays this in cs_start_render, so an encoder that
+    * is not open yet needs nothing more than the recorded state. */
+   if (cmd->gfx.encoder != NULL)
+      mtl_set_vertex_amplification_count(
+         cmd->gfx.encoder, state->vertex_amplification_ids, count);
+}
