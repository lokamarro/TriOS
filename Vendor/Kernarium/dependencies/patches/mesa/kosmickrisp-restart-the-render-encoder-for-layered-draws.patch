--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_layered_draw_sequence.cpp
@@ -0,0 +1,448 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* KK_WORKAROUND_18: a render command encoder that already ran one draw drops
+ * most of the primitives of a later draw that selects a different
+ * render_target_array_index. Draw one point per texel into each layer of a
+ * two-layer attachment with one draw per layer, then require every texel of
+ * every layer to carry the value its own layer's draw writes.
+ *
+ * The attachment size, the layered point draws and the DONT_CARE load op all
+ * matter: without the workaround the second draw loses its first 908672
+ * points, but a CLEAR load op on the same pass renders correctly.
+ */
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+static void require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (!ok) {
+      std::fprintf(stderr, "%s: %d\n", operation, value);
+      std::exit(1);
+   }
+}
+
+template <typename T> static T load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+#define LOAD_D(name)                                                             \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+
+static const uint32_t vertex_spirv[] =
+#include "layered_draw_shaders/points.vert.h"
+;
+static const uint32_t fragment_spirv[] =
+#include "layered_draw_shaders/points.frag.h"
+;
+
+/* Large enough to lose primitives without the workaround: a 1024x1024 layer
+ * loses 908672 of its 1048576 points on the first affected pass. */
+static const uint32_t kExtent = 1024u;
+static const uint32_t kLayers = 2u;
+static const uint32_t kTexelBytes = 16u;
+
+struct PushConstants {
+   int32_t layer;
+   int32_t width;
+};
+
+int main()
+{
+   std::setvbuf(stdout, nullptr, _IONBF, 0);
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+   app.pApplicationName = "layered-draw-sequence";
+   app.apiVersion = VK_API_VERSION_1_3;
+   VkInstanceCreateInfo instance_info{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+   instance_info.pApplicationInfo = &app;
+   auto result = vkCreateInstance(&instance_info, nullptr, &instance);
+   require(result == VK_SUCCESS, "create instance", result);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkGetPhysicalDeviceFeatures2);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+
+   uint32_t physical_count = 0;
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, nullptr);
+   require(result == VK_SUCCESS && physical_count, "physical device count", result);
+   std::vector<VkPhysicalDevice> physicals(physical_count);
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, physicals.data());
+   require(result == VK_SUCCESS, "physical devices", result);
+
+   for (VkPhysicalDevice physical : physicals) {
+      VkPhysicalDeviceVulkan12Features supported12{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+      VkPhysicalDeviceFeatures2 supported{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+      supported.pNext = &supported12;
+      vkGetPhysicalDeviceFeatures2(physical, &supported);
+      if (!supported12.shaderOutputLayer) {
+         std::printf("shaderOutputLayer unsupported, skipping\n");
+         continue;
+      }
+
+      uint32_t queue_count = 0;
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, nullptr);
+      std::vector<VkQueueFamilyProperties> queues(queue_count);
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, queues.data());
+      uint32_t queue = 0;
+      while (queue < queue_count && !(queues[queue].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+         ++queue;
+      require(queue < queue_count, "graphics queue");
+
+      float priority = 1.0f;
+      VkDeviceQueueCreateInfo queue_info{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+      queue_info.queueFamilyIndex = queue;
+      queue_info.queueCount = 1;
+      queue_info.pQueuePriorities = &priority;
+      VkPhysicalDeviceVulkan12Features features12{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+      features12.shaderOutputLayer = VK_TRUE;
+      VkPhysicalDeviceVulkan13Features features13{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+      features13.pNext = &features12;
+      features13.dynamicRendering = VK_TRUE;
+      VkDeviceCreateInfo device_info{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+      device_info.pNext = &features13;
+      device_info.queueCreateInfoCount = 1;
+      device_info.pQueueCreateInfos = &queue_info;
+      VkDevice device = VK_NULL_HANDLE;
+      result = vkCreateDevice(physical, &device_info, nullptr, &device);
+      require(result == VK_SUCCESS, "create device", result);
+
+      LOAD_D(vkDestroyDevice);
+      LOAD_D(vkGetDeviceQueue);
+      LOAD_D(vkCreateShaderModule);
+      LOAD_D(vkDestroyShaderModule);
+      LOAD_D(vkCreatePipelineLayout);
+      LOAD_D(vkDestroyPipelineLayout);
+      LOAD_D(vkCreateGraphicsPipelines);
+      LOAD_D(vkDestroyPipeline);
+      LOAD_D(vkCreateImage);
+      LOAD_D(vkDestroyImage);
+      LOAD_D(vkGetImageMemoryRequirements);
+      LOAD_D(vkAllocateMemory);
+      LOAD_D(vkFreeMemory);
+      LOAD_D(vkBindImageMemory);
+      LOAD_D(vkCreateImageView);
+      LOAD_D(vkDestroyImageView);
+      LOAD_D(vkCreateBuffer);
+      LOAD_D(vkDestroyBuffer);
+      LOAD_D(vkGetBufferMemoryRequirements);
+      LOAD_D(vkBindBufferMemory);
+      LOAD_D(vkMapMemory);
+      LOAD_D(vkUnmapMemory);
+      LOAD_D(vkCreateCommandPool);
+      LOAD_D(vkDestroyCommandPool);
+      LOAD_D(vkAllocateCommandBuffers);
+      LOAD_D(vkBeginCommandBuffer);
+      LOAD_D(vkEndCommandBuffer);
+      LOAD_D(vkCmdBeginRendering);
+      LOAD_D(vkCmdEndRendering);
+      LOAD_D(vkCmdBindPipeline);
+      LOAD_D(vkCmdPushConstants);
+      LOAD_D(vkCmdDraw);
+      LOAD_D(vkCmdPipelineBarrier);
+      LOAD_D(vkCmdCopyImageToBuffer);
+      LOAD_D(vkQueueSubmit);
+      LOAD_D(vkQueueWaitIdle);
+
+      VkQueue graphics_queue = VK_NULL_HANDLE;
+      vkGetDeviceQueue(device, queue, 0, &graphics_queue);
+
+      VkPhysicalDeviceMemoryProperties memory_properties{};
+      vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+      auto find_memory = [&](uint32_t bits, VkMemoryPropertyFlags want) {
+         for (uint32_t i = 0; i < memory_properties.memoryTypeCount; ++i)
+            if ((bits & (1u << i)) &&
+                (memory_properties.memoryTypes[i].propertyFlags & want) == want)
+               return i;
+         require(false, "memory type");
+         return 0u;
+      };
+
+      const VkFormat format = VK_FORMAT_R32G32B32A32_SFLOAT;
+      VkImageCreateInfo image_info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+      image_info.imageType = VK_IMAGE_TYPE_2D;
+      image_info.format = format;
+      image_info.extent = {kExtent, kExtent, 1u};
+      image_info.mipLevels = 1u;
+      image_info.arrayLayers = kLayers;
+      image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+      image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+      image_info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                         VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+      image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+      VkImage image = VK_NULL_HANDLE;
+      result = vkCreateImage(device, &image_info, nullptr, &image);
+      require(result == VK_SUCCESS, "create image", result);
+      VkMemoryRequirements image_requirements{};
+      vkGetImageMemoryRequirements(device, image, &image_requirements);
+      VkMemoryAllocateInfo image_allocate{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+      image_allocate.allocationSize = image_requirements.size;
+      image_allocate.memoryTypeIndex = find_memory(
+         image_requirements.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+      VkDeviceMemory image_memory = VK_NULL_HANDLE;
+      result = vkAllocateMemory(device, &image_allocate, nullptr, &image_memory);
+      require(result == VK_SUCCESS, "allocate image", result);
+      result = vkBindImageMemory(device, image, image_memory, 0);
+      require(result == VK_SUCCESS, "bind image", result);
+
+      VkImageViewCreateInfo view_info{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+      view_info.image = image;
+      view_info.viewType = VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+      view_info.format = format;
+      view_info.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, kLayers};
+      VkImageView view = VK_NULL_HANDLE;
+      result = vkCreateImageView(device, &view_info, nullptr, &view);
+      require(result == VK_SUCCESS, "create view", result);
+
+      const VkDeviceSize layer_bytes =
+         VkDeviceSize(kExtent) * kExtent * kTexelBytes;
+      const VkDeviceSize readback_bytes = layer_bytes * kLayers;
+      VkBufferCreateInfo buffer_info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+      buffer_info.size = readback_bytes;
+      buffer_info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+      VkBuffer readback = VK_NULL_HANDLE;
+      result = vkCreateBuffer(device, &buffer_info, nullptr, &readback);
+      require(result == VK_SUCCESS, "create buffer", result);
+      VkMemoryRequirements buffer_requirements{};
+      vkGetBufferMemoryRequirements(device, readback, &buffer_requirements);
+      VkMemoryAllocateInfo buffer_allocate{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+      buffer_allocate.allocationSize = buffer_requirements.size;
+      buffer_allocate.memoryTypeIndex =
+         find_memory(buffer_requirements.memoryTypeBits,
+                     VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                        VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+      VkDeviceMemory readback_memory = VK_NULL_HANDLE;
+      result = vkAllocateMemory(device, &buffer_allocate, nullptr, &readback_memory);
+      require(result == VK_SUCCESS, "allocate buffer", result);
+      result = vkBindBufferMemory(device, readback, readback_memory, 0);
+      require(result == VK_SUCCESS, "bind buffer", result);
+      void *mapped = nullptr;
+      result = vkMapMemory(device, readback_memory, 0, VK_WHOLE_SIZE, 0, &mapped);
+      require(result == VK_SUCCESS, "map buffer", result);
+      std::memset(mapped, 0, size_t(readback_bytes));
+
+      VkShaderModuleCreateInfo module_info{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+      module_info.codeSize = sizeof(vertex_spirv);
+      module_info.pCode = vertex_spirv;
+      VkShaderModule vertex_module = VK_NULL_HANDLE;
+      result = vkCreateShaderModule(device, &module_info, nullptr, &vertex_module);
+      require(result == VK_SUCCESS, "vertex module", result);
+      module_info.codeSize = sizeof(fragment_spirv);
+      module_info.pCode = fragment_spirv;
+      VkShaderModule fragment_module = VK_NULL_HANDLE;
+      result = vkCreateShaderModule(device, &module_info, nullptr, &fragment_module);
+      require(result == VK_SUCCESS, "fragment module", result);
+
+      VkPushConstantRange push_range{VK_SHADER_STAGE_VERTEX_BIT, 0u,
+                                     sizeof(PushConstants)};
+      VkPipelineLayoutCreateInfo layout_info{
+         VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+      layout_info.pushConstantRangeCount = 1u;
+      layout_info.pPushConstantRanges = &push_range;
+      VkPipelineLayout layout = VK_NULL_HANDLE;
+      result = vkCreatePipelineLayout(device, &layout_info, nullptr, &layout);
+      require(result == VK_SUCCESS, "pipeline layout", result);
+
+      VkPipelineShaderStageCreateInfo stages[2]{};
+      stages[0].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+      stages[0].module = vertex_module;
+      stages[0].pName = "main";
+      stages[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+      stages[1].module = fragment_module;
+      stages[1].pName = "main";
+      VkPipelineVertexInputStateCreateInfo vertex_input{
+         VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+      VkPipelineInputAssemblyStateCreateInfo assembly{
+         VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+      assembly.topology = VK_PRIMITIVE_TOPOLOGY_POINT_LIST;
+      VkViewport viewport{0.0f, 0.0f, float(kExtent), float(kExtent), 0.0f, 1.0f};
+      VkRect2D scissor{{0, 0}, {kExtent, kExtent}};
+      VkPipelineViewportStateCreateInfo viewport_state{
+         VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+      viewport_state.viewportCount = 1u;
+      viewport_state.pViewports = &viewport;
+      viewport_state.scissorCount = 1u;
+      viewport_state.pScissors = &scissor;
+      VkPipelineRasterizationStateCreateInfo raster{
+         VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+      raster.polygonMode = VK_POLYGON_MODE_FILL;
+      raster.cullMode = VK_CULL_MODE_NONE;
+      raster.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+      raster.lineWidth = 1.0f;
+      VkPipelineMultisampleStateCreateInfo multisample{
+         VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+      multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+      VkPipelineColorBlendAttachmentState blend_attachment{};
+      blend_attachment.colorWriteMask = VK_COLOR_COMPONENT_R_BIT |
+                                        VK_COLOR_COMPONENT_G_BIT |
+                                        VK_COLOR_COMPONENT_B_BIT |
+                                        VK_COLOR_COMPONENT_A_BIT;
+      VkPipelineColorBlendStateCreateInfo blend{
+         VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+      blend.attachmentCount = 1u;
+      blend.pAttachments = &blend_attachment;
+      VkPipelineRenderingCreateInfo rendering_info{
+         VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+      rendering_info.colorAttachmentCount = 1u;
+      rendering_info.pColorAttachmentFormats = &format;
+      VkGraphicsPipelineCreateInfo pipeline_info{
+         VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+      pipeline_info.pNext = &rendering_info;
+      pipeline_info.stageCount = 2u;
+      pipeline_info.pStages = stages;
+      pipeline_info.pVertexInputState = &vertex_input;
+      pipeline_info.pInputAssemblyState = &assembly;
+      pipeline_info.pViewportState = &viewport_state;
+      pipeline_info.pRasterizationState = &raster;
+      pipeline_info.pMultisampleState = &multisample;
+      pipeline_info.pColorBlendState = &blend;
+      pipeline_info.layout = layout;
+      VkPipeline pipeline = VK_NULL_HANDLE;
+      result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1u, &pipeline_info,
+                                         nullptr, &pipeline);
+      require(result == VK_SUCCESS, "create pipeline", result);
+
+      VkCommandPoolCreateInfo pool_info{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+      pool_info.queueFamilyIndex = queue;
+      VkCommandPool pool = VK_NULL_HANDLE;
+      result = vkCreateCommandPool(device, &pool_info, nullptr, &pool);
+      require(result == VK_SUCCESS, "command pool", result);
+      VkCommandBufferAllocateInfo command_info{
+         VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+      command_info.commandPool = pool;
+      command_info.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+      command_info.commandBufferCount = 1u;
+      VkCommandBuffer commands = VK_NULL_HANDLE;
+      result = vkAllocateCommandBuffers(device, &command_info, &commands);
+      require(result == VK_SUCCESS, "command buffer", result);
+
+      VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+      begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+      result = vkBeginCommandBuffer(commands, &begin);
+      require(result == VK_SUCCESS, "begin commands", result);
+
+      VkRenderingAttachmentInfo color_attachment{
+         VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+      color_attachment.imageView = view;
+      color_attachment.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      /* A CLEAR load op hides the defect, so keep DONT_CARE as the CTS
+       * cases that found it use. */
+      color_attachment.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+      color_attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+      VkRenderingInfo rendering{VK_STRUCTURE_TYPE_RENDERING_INFO};
+      rendering.renderArea = scissor;
+      rendering.layerCount = kLayers;
+      rendering.colorAttachmentCount = 1u;
+      rendering.pColorAttachments = &color_attachment;
+      vkCmdBeginRendering(commands, &rendering);
+      vkCmdBindPipeline(commands, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+      for (uint32_t layer = 0u; layer < kLayers; ++layer) {
+         PushConstants push{int32_t(layer), int32_t(kExtent)};
+         vkCmdPushConstants(commands, layout, VK_SHADER_STAGE_VERTEX_BIT, 0u,
+                            sizeof(push), &push);
+         vkCmdDraw(commands, kExtent * kExtent, 1u, 0u, 0u);
+      }
+      vkCmdEndRendering(commands);
+
+      VkImageMemoryBarrier barrier{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+      barrier.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+      barrier.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+      barrier.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      barrier.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+      barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barrier.image = image;
+      barrier.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, kLayers};
+      vkCmdPipelineBarrier(commands, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT, 0u, 0u, nullptr, 0u,
+                           nullptr, 1u, &barrier);
+      VkBufferImageCopy copy{};
+      copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, 0u, kLayers};
+      copy.imageExtent = {kExtent, kExtent, 1u};
+      vkCmdCopyImageToBuffer(commands, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                             readback, 1u, &copy);
+      result = vkEndCommandBuffer(commands);
+      require(result == VK_SUCCESS, "end commands", result);
+
+      VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+      submit.commandBufferCount = 1u;
+      submit.pCommandBuffers = &commands;
+      result = vkQueueSubmit(graphics_queue, 1u, &submit, VK_NULL_HANDLE);
+      require(result == VK_SUCCESS, "submit", result);
+      result = vkQueueWaitIdle(graphics_queue);
+      require(result == VK_SUCCESS, "wait idle", result);
+
+      const uint8_t *bytes = static_cast<const uint8_t *>(mapped);
+      for (uint32_t layer = 0u; layer < kLayers; ++layer) {
+         const float expected = float(layer + 1u);
+         uint64_t wrong = 0u;
+         int64_t first_wrong = -1;
+         for (uint64_t texel = 0u; texel < uint64_t(kExtent) * kExtent; ++texel) {
+            float value[4];
+            std::memcpy(value, bytes + layer * layer_bytes + texel * kTexelBytes,
+                        sizeof(value));
+            if (value[0] == expected && value[1] == 0.0f && value[2] == 0.0f &&
+                value[3] == 1.0f)
+               continue;
+            ++wrong;
+            if (first_wrong < 0)
+               first_wrong = int64_t(texel);
+         }
+         if (wrong) {
+            float value[4];
+            std::memcpy(value,
+                        bytes + layer * layer_bytes +
+                           uint64_t(first_wrong) * kTexelBytes,
+                        sizeof(value));
+            std::fprintf(stderr,
+                         "layer %u: %llu of %llu texels were not drawn by their "
+                         "own layer's draw, first at %lld (got %f %f %f %f)\n",
+                         layer, static_cast<unsigned long long>(wrong),
+                         static_cast<unsigned long long>(uint64_t(kExtent) * kExtent),
+                         static_cast<long long>(first_wrong), double(value[0]),
+                         double(value[1]), double(value[2]), double(value[3]));
+            std::exit(1);
+         }
+      }
+
+      vkDestroyPipeline(device, pipeline, nullptr);
+      vkDestroyPipelineLayout(device, layout, nullptr);
+      vkDestroyShaderModule(device, fragment_module, nullptr);
+      vkDestroyShaderModule(device, vertex_module, nullptr);
+      vkDestroyCommandPool(device, pool, nullptr);
+      vkUnmapMemory(device, readback_memory);
+      vkDestroyBuffer(device, readback, nullptr);
+      vkFreeMemory(device, readback_memory, nullptr);
+      vkDestroyImageView(device, view, nullptr);
+      vkDestroyImage(device, image, nullptr);
+      vkFreeMemory(device, image_memory, nullptr);
+      vkDestroyDevice(device, nullptr);
+   }
+
+   vkDestroyInstance(instance, nullptr);
+   std::printf("layered draw sequence ok\n");
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_multiview_clear_attachments.cpp b/src/kosmickrisp/vulkan/tests/test_multiview_clear_attachments.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7c81b169aa4e9373728ac62754bb6c5a0fd0efbb
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_multiview_clear_attachments.cpp
@@ -0,0 +1,450 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* KK_WORKAROUND_18 restarts the render encoder mid-pass, and every encoder
+ * start has to replay the vertex amplification the pass is carrying.
+ * vkCmdClearAttachments turns amplification off because the meta clear routes
+ * its own layers, so a restart that reinstates the multiview mapping sends the
+ * clear to the wrong layers.
+ *
+ * Draw over a two-view (view mask 10) pass on a four-layer image and clear the
+ * left half. Layers 1 and 3 must carry the draw colour on the right and the
+ * clear colour on the left; layers 0 and 2 must not change.
+ */
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+static void require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (!ok) {
+      std::fprintf(stderr, "%s: %d\n", operation, value);
+      std::exit(1);
+   }
+}
+
+template <typename T> static T load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+#define LOAD_D(name)                                                             \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+
+static const uint32_t vertex_spirv[] =
+#include "multiview_clear_shaders/quad.vert.h"
+;
+static const uint32_t fragment_spirv[] =
+#include "multiview_clear_shaders/quad.frag.h"
+;
+
+static const uint32_t kExtent = 64u;
+static const uint32_t kLayers = 4u;
+static const uint32_t kViewMask = 10u; /* layers 1 and 3 */
+static const uint8_t kDrawRed = 40u;
+static const uint8_t kClearRed = 200u;
+
+int main()
+{
+   std::setvbuf(stdout, nullptr, _IONBF, 0);
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+   app.pApplicationName = "multiview-clear-attachments";
+   app.apiVersion = VK_API_VERSION_1_3;
+   VkInstanceCreateInfo instance_info{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+   instance_info.pApplicationInfo = &app;
+   auto result = vkCreateInstance(&instance_info, nullptr, &instance);
+   require(result == VK_SUCCESS, "create instance", result);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkGetPhysicalDeviceFeatures2);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+
+   uint32_t physical_count = 0;
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, nullptr);
+   require(result == VK_SUCCESS && physical_count, "physical device count", result);
+   std::vector<VkPhysicalDevice> physicals(physical_count);
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, physicals.data());
+   require(result == VK_SUCCESS, "physical devices", result);
+
+   for (VkPhysicalDevice physical : physicals) {
+      VkPhysicalDeviceVulkan11Features supported11{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES};
+      VkPhysicalDeviceFeatures2 supported{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+      supported.pNext = &supported11;
+      vkGetPhysicalDeviceFeatures2(physical, &supported);
+      if (!supported11.multiview) {
+         std::printf("multiview unsupported, skipping\n");
+         continue;
+      }
+
+      uint32_t queue_count = 0;
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, nullptr);
+      std::vector<VkQueueFamilyProperties> queues(queue_count);
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, queues.data());
+      uint32_t queue = 0;
+      while (queue < queue_count && !(queues[queue].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+         ++queue;
+      require(queue < queue_count, "graphics queue");
+
+      float priority = 1.0f;
+      VkDeviceQueueCreateInfo queue_info{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+      queue_info.queueFamilyIndex = queue;
+      queue_info.queueCount = 1;
+      queue_info.pQueuePriorities = &priority;
+      VkPhysicalDeviceVulkan11Features features11{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES};
+      features11.multiview = VK_TRUE;
+      VkPhysicalDeviceVulkan13Features features13{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+      features13.pNext = &features11;
+      features13.dynamicRendering = VK_TRUE;
+      VkDeviceCreateInfo device_info{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+      device_info.pNext = &features13;
+      device_info.queueCreateInfoCount = 1;
+      device_info.pQueueCreateInfos = &queue_info;
+      VkDevice device = VK_NULL_HANDLE;
+      result = vkCreateDevice(physical, &device_info, nullptr, &device);
+      require(result == VK_SUCCESS, "create device", result);
+
+      LOAD_D(vkDestroyDevice);
+      LOAD_D(vkGetDeviceQueue);
+      LOAD_D(vkCreateShaderModule);
+      LOAD_D(vkDestroyShaderModule);
+      LOAD_D(vkCreatePipelineLayout);
+      LOAD_D(vkDestroyPipelineLayout);
+      LOAD_D(vkCreateGraphicsPipelines);
+      LOAD_D(vkDestroyPipeline);
+      LOAD_D(vkCreateImage);
+      LOAD_D(vkDestroyImage);
+      LOAD_D(vkGetImageMemoryRequirements);
+      LOAD_D(vkAllocateMemory);
+      LOAD_D(vkFreeMemory);
+      LOAD_D(vkBindImageMemory);
+      LOAD_D(vkCreateImageView);
+      LOAD_D(vkDestroyImageView);
+      LOAD_D(vkCreateBuffer);
+      LOAD_D(vkDestroyBuffer);
+      LOAD_D(vkGetBufferMemoryRequirements);
+      LOAD_D(vkBindBufferMemory);
+      LOAD_D(vkMapMemory);
+      LOAD_D(vkUnmapMemory);
+      LOAD_D(vkCreateCommandPool);
+      LOAD_D(vkDestroyCommandPool);
+      LOAD_D(vkAllocateCommandBuffers);
+      LOAD_D(vkBeginCommandBuffer);
+      LOAD_D(vkEndCommandBuffer);
+      LOAD_D(vkCmdBeginRendering);
+      LOAD_D(vkCmdEndRendering);
+      LOAD_D(vkCmdBindPipeline);
+      LOAD_D(vkCmdPushConstants);
+      LOAD_D(vkCmdDraw);
+      LOAD_D(vkCmdClearAttachments);
+      LOAD_D(vkCmdPipelineBarrier);
+      LOAD_D(vkCmdCopyImageToBuffer);
+      LOAD_D(vkQueueSubmit);
+      LOAD_D(vkQueueWaitIdle);
+
+      VkQueue graphics_queue = VK_NULL_HANDLE;
+      vkGetDeviceQueue(device, queue, 0, &graphics_queue);
+
+      VkPhysicalDeviceMemoryProperties memory_properties{};
+      vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+      auto find_memory = [&](uint32_t bits, VkMemoryPropertyFlags want) {
+         for (uint32_t i = 0; i < memory_properties.memoryTypeCount; ++i)
+            if ((bits & (1u << i)) &&
+                (memory_properties.memoryTypes[i].propertyFlags & want) == want)
+               return i;
+         require(false, "memory type");
+         return 0u;
+      };
+
+      const VkFormat format = VK_FORMAT_R8G8B8A8_UNORM;
+      VkImageCreateInfo image_info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+      image_info.imageType = VK_IMAGE_TYPE_2D;
+      image_info.format = format;
+      image_info.extent = {kExtent, kExtent, 1u};
+      image_info.mipLevels = 1u;
+      image_info.arrayLayers = kLayers;
+      image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+      image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+      image_info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                         VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+      image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+      VkImage image = VK_NULL_HANDLE;
+      result = vkCreateImage(device, &image_info, nullptr, &image);
+      require(result == VK_SUCCESS, "create image", result);
+      VkMemoryRequirements image_requirements{};
+      vkGetImageMemoryRequirements(device, image, &image_requirements);
+      VkMemoryAllocateInfo image_allocate{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+      image_allocate.allocationSize = image_requirements.size;
+      image_allocate.memoryTypeIndex = find_memory(
+         image_requirements.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+      VkDeviceMemory image_memory = VK_NULL_HANDLE;
+      result = vkAllocateMemory(device, &image_allocate, nullptr, &image_memory);
+      require(result == VK_SUCCESS, "allocate image", result);
+      result = vkBindImageMemory(device, image, image_memory, 0);
+      require(result == VK_SUCCESS, "bind image", result);
+
+      VkImageViewCreateInfo view_info{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+      view_info.image = image;
+      view_info.viewType = VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+      view_info.format = format;
+      view_info.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, kLayers};
+      VkImageView view = VK_NULL_HANDLE;
+      result = vkCreateImageView(device, &view_info, nullptr, &view);
+      require(result == VK_SUCCESS, "create view", result);
+
+      const VkDeviceSize layer_bytes = VkDeviceSize(kExtent) * kExtent * 4u;
+      const VkDeviceSize readback_bytes = layer_bytes * kLayers;
+      VkBufferCreateInfo buffer_info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+      buffer_info.size = readback_bytes;
+      buffer_info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+      VkBuffer readback = VK_NULL_HANDLE;
+      result = vkCreateBuffer(device, &buffer_info, nullptr, &readback);
+      require(result == VK_SUCCESS, "create buffer", result);
+      VkMemoryRequirements buffer_requirements{};
+      vkGetBufferMemoryRequirements(device, readback, &buffer_requirements);
+      VkMemoryAllocateInfo buffer_allocate{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+      buffer_allocate.allocationSize = buffer_requirements.size;
+      buffer_allocate.memoryTypeIndex =
+         find_memory(buffer_requirements.memoryTypeBits,
+                     VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                        VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+      VkDeviceMemory readback_memory = VK_NULL_HANDLE;
+      result = vkAllocateMemory(device, &buffer_allocate, nullptr, &readback_memory);
+      require(result == VK_SUCCESS, "allocate buffer", result);
+      result = vkBindBufferMemory(device, readback, readback_memory, 0);
+      require(result == VK_SUCCESS, "bind buffer", result);
+      void *mapped = nullptr;
+      result = vkMapMemory(device, readback_memory, 0, VK_WHOLE_SIZE, 0, &mapped);
+      require(result == VK_SUCCESS, "map buffer", result);
+      std::memset(mapped, 0, size_t(readback_bytes));
+
+      VkShaderModuleCreateInfo module_info{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+      module_info.codeSize = sizeof(vertex_spirv);
+      module_info.pCode = vertex_spirv;
+      VkShaderModule vertex_module = VK_NULL_HANDLE;
+      result = vkCreateShaderModule(device, &module_info, nullptr, &vertex_module);
+      require(result == VK_SUCCESS, "vertex module", result);
+      module_info.codeSize = sizeof(fragment_spirv);
+      module_info.pCode = fragment_spirv;
+      VkShaderModule fragment_module = VK_NULL_HANDLE;
+      result = vkCreateShaderModule(device, &module_info, nullptr, &fragment_module);
+      require(result == VK_SUCCESS, "fragment module", result);
+
+      VkPushConstantRange push_range{VK_SHADER_STAGE_VERTEX_BIT, 0u,
+                                     sizeof(float) * 4u};
+      VkPipelineLayoutCreateInfo layout_info{
+         VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+      layout_info.pushConstantRangeCount = 1u;
+      layout_info.pPushConstantRanges = &push_range;
+      VkPipelineLayout layout = VK_NULL_HANDLE;
+      result = vkCreatePipelineLayout(device, &layout_info, nullptr, &layout);
+      require(result == VK_SUCCESS, "pipeline layout", result);
+
+      VkPipelineShaderStageCreateInfo stages[2]{};
+      stages[0].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+      stages[0].module = vertex_module;
+      stages[0].pName = "main";
+      stages[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+      stages[1].module = fragment_module;
+      stages[1].pName = "main";
+      VkPipelineVertexInputStateCreateInfo vertex_input{
+         VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+      VkPipelineInputAssemblyStateCreateInfo assembly{
+         VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+      assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+      VkViewport viewport{0.0f, 0.0f, float(kExtent), float(kExtent), 0.0f, 1.0f};
+      VkRect2D scissor{{0, 0}, {kExtent, kExtent}};
+      VkPipelineViewportStateCreateInfo viewport_state{
+         VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+      viewport_state.viewportCount = 1u;
+      viewport_state.pViewports = &viewport;
+      viewport_state.scissorCount = 1u;
+      viewport_state.pScissors = &scissor;
+      VkPipelineRasterizationStateCreateInfo raster{
+         VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+      raster.polygonMode = VK_POLYGON_MODE_FILL;
+      raster.cullMode = VK_CULL_MODE_NONE;
+      raster.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+      raster.lineWidth = 1.0f;
+      VkPipelineMultisampleStateCreateInfo multisample{
+         VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+      multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+      VkPipelineColorBlendAttachmentState blend_attachment{};
+      blend_attachment.colorWriteMask = VK_COLOR_COMPONENT_R_BIT |
+                                        VK_COLOR_COMPONENT_G_BIT |
+                                        VK_COLOR_COMPONENT_B_BIT |
+                                        VK_COLOR_COMPONENT_A_BIT;
+      VkPipelineColorBlendStateCreateInfo blend{
+         VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+      blend.attachmentCount = 1u;
+      blend.pAttachments = &blend_attachment;
+      VkPipelineRenderingCreateInfo rendering_info{
+         VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+      rendering_info.viewMask = kViewMask;
+      rendering_info.colorAttachmentCount = 1u;
+      rendering_info.pColorAttachmentFormats = &format;
+      VkGraphicsPipelineCreateInfo pipeline_info{
+         VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+      pipeline_info.pNext = &rendering_info;
+      pipeline_info.stageCount = 2u;
+      pipeline_info.pStages = stages;
+      pipeline_info.pVertexInputState = &vertex_input;
+      pipeline_info.pInputAssemblyState = &assembly;
+      pipeline_info.pViewportState = &viewport_state;
+      pipeline_info.pRasterizationState = &raster;
+      pipeline_info.pMultisampleState = &multisample;
+      pipeline_info.pColorBlendState = &blend;
+      pipeline_info.layout = layout;
+      VkPipeline pipeline = VK_NULL_HANDLE;
+      result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1u, &pipeline_info,
+                                         nullptr, &pipeline);
+      require(result == VK_SUCCESS, "create pipeline", result);
+
+      VkCommandPoolCreateInfo pool_info{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+      pool_info.queueFamilyIndex = queue;
+      VkCommandPool pool = VK_NULL_HANDLE;
+      result = vkCreateCommandPool(device, &pool_info, nullptr, &pool);
+      require(result == VK_SUCCESS, "command pool", result);
+      VkCommandBufferAllocateInfo command_info{
+         VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+      command_info.commandPool = pool;
+      command_info.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+      command_info.commandBufferCount = 1u;
+      VkCommandBuffer commands = VK_NULL_HANDLE;
+      result = vkAllocateCommandBuffers(device, &command_info, &commands);
+      require(result == VK_SUCCESS, "command buffer", result);
+
+      VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+      begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+      result = vkBeginCommandBuffer(commands, &begin);
+      require(result == VK_SUCCESS, "begin commands", result);
+
+      VkRenderingAttachmentInfo color_attachment{
+         VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+      color_attachment.imageView = view;
+      color_attachment.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      color_attachment.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+      color_attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+      color_attachment.clearValue.color.float32[3] = 1.0f;
+
+      /* Put every layer into a known state outside multiview. */
+      VkRenderingInfo rendering{VK_STRUCTURE_TYPE_RENDERING_INFO};
+      rendering.renderArea = scissor;
+      rendering.layerCount = kLayers;
+      rendering.colorAttachmentCount = 1u;
+      rendering.pColorAttachments = &color_attachment;
+      vkCmdBeginRendering(commands, &rendering);
+      vkCmdEndRendering(commands);
+
+      color_attachment.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+      rendering.viewMask = kViewMask;
+      vkCmdBeginRendering(commands, &rendering);
+      vkCmdBindPipeline(commands, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+      const float draw_color[4] = {kDrawRed / 255.0f, 0.0f, 0.0f, 1.0f};
+      vkCmdPushConstants(commands, layout, VK_SHADER_STAGE_VERTEX_BIT, 0u,
+                         sizeof(draw_color), draw_color);
+      vkCmdDraw(commands, 3u, 1u, 0u, 0u);
+      VkClearAttachment clear_attachment{};
+      clear_attachment.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+      clear_attachment.colorAttachment = 0u;
+      clear_attachment.clearValue.color.float32[0] = kClearRed / 255.0f;
+      clear_attachment.clearValue.color.float32[3] = 1.0f;
+      VkClearRect clear_rect{};
+      clear_rect.rect = {{0, 0}, {kExtent / 2u, kExtent}};
+      clear_rect.baseArrayLayer = 0u;
+      clear_rect.layerCount = 1u;
+      vkCmdClearAttachments(commands, 1u, &clear_attachment, 1u, &clear_rect);
+      vkCmdEndRendering(commands);
+
+      VkImageMemoryBarrier barrier{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+      barrier.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+      barrier.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+      barrier.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      barrier.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+      barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barrier.image = image;
+      barrier.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, kLayers};
+      vkCmdPipelineBarrier(commands, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT, 0u, 0u, nullptr, 0u,
+                           nullptr, 1u, &barrier);
+      VkBufferImageCopy copy{};
+      copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, 0u, kLayers};
+      copy.imageExtent = {kExtent, kExtent, 1u};
+      vkCmdCopyImageToBuffer(commands, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                             readback, 1u, &copy);
+      result = vkEndCommandBuffer(commands);
+      require(result == VK_SUCCESS, "end commands", result);
+
+      VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+      submit.commandBufferCount = 1u;
+      submit.pCommandBuffers = &commands;
+      result = vkQueueSubmit(graphics_queue, 1u, &submit, VK_NULL_HANDLE);
+      require(result == VK_SUCCESS, "submit", result);
+      result = vkQueueWaitIdle(graphics_queue);
+      require(result == VK_SUCCESS, "wait idle", result);
+
+      const uint8_t *texels = static_cast<const uint8_t *>(mapped);
+      for (uint32_t layer = 0u; layer < kLayers; ++layer) {
+         const bool in_view = (kViewMask & (1u << layer)) != 0u;
+         for (uint32_t y = 0u; y < kExtent; ++y) {
+            for (uint32_t x = 0u; x < kExtent; ++x) {
+               const uint8_t *value =
+                  texels + layer * layer_bytes + (y * kExtent + x) * 4u;
+               uint8_t expected_red = 0u;
+               if (in_view)
+                  expected_red = x < kExtent / 2u ? kClearRed : kDrawRed;
+               if (value[0] == expected_red && value[1] == 0u && value[2] == 0u &&
+                   value[3] == 0xffu)
+                  continue;
+               std::fprintf(stderr,
+                            "layer %u (%s view mask 0x%x) texel %u,%u is "
+                            "%u,%u,%u,%u, expected red %u\n",
+                            layer, in_view ? "in" : "outside", kViewMask, x, y,
+                            unsigned(value[0]), unsigned(value[1]),
+                            unsigned(value[2]), unsigned(value[3]),
+                            unsigned(expected_red));
+               std::exit(1);
+            }
+         }
+      }
+
+      vkDestroyPipeline(device, pipeline, nullptr);
+      vkDestroyPipelineLayout(device, layout, nullptr);
+      vkDestroyShaderModule(device, fragment_module, nullptr);
+      vkDestroyShaderModule(device, vertex_module, nullptr);
+      vkDestroyCommandPool(device, pool, nullptr);
+      vkUnmapMemory(device, readback_memory);
+      vkDestroyBuffer(device, readback, nullptr);
+      vkFreeMemory(device, readback_memory, nullptr);
+      vkDestroyImageView(device, view, nullptr);
+      vkDestroyImage(device, image, nullptr);
+      vkFreeMemory(device, image_memory, nullptr);
+      vkDestroyDevice(device, nullptr);
+   }
+
+   vkDestroyInstance(instance, nullptr);
+   std::printf("multiview clear attachments ok\n");
+   return 0;
+}
