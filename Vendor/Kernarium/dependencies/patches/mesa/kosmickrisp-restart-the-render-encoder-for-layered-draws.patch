@@ -0,0 +1,7 @@
+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+cd -- "$(dirname -- "$0")"
+for shader in points.vert points.frag draw_id.vert passthrough.vert layer.geom; do
+   glslc -O --target-env=vulkan1.3 -mfmt=c "$shader" -o "$shader.h"
+done
