diff --git a/src/gallium/auxiliary/pipebuffer/pb_cache_reaper.c b/src/gallium/auxiliary/pipebuffer/pb_cache_reaper.c
new file mode 100644
index 0000000000000000000000000000000000000000..4ec9753fb7848c3fd0fd3a01c829bee42c83002a
--- /dev/null
+++ b/src/gallium/auxiliary/pipebuffer/pb_cache_reaper.c
@@ -0,0 +1,139 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "pb_cache_reaper.h"
+
+#include "c11/time.h"
+#include "util/cnd_monotonic.h"
+#include "util/u_atomic.h"
+#include "util/u_memory.h"
+#include "util/u_thread.h"
+
+#include <stdio.h>
+
+struct pb_cache_reaper {
+   struct pb_cache *cache;
+   thrd_t thread;
+
+   /* Guards stop and orders a wake-up after the thread's decision to sleep. */
+   mtx_t lock;
+   struct u_cnd_monotonic wake;
+   bool stop;
+
+   /* Whether the thread is waiting with no deadline because the cache was
+    * empty.  Set under lock before the thread looks at the cache once more
+    * and waits; read by pb_cache_reaper_wake() after the addition it reports,
+    * which the cache's own mutex orders against that second look.  An
+    * addition that comes first is seen by the second look, and one that comes
+    * later finds the flag set. */
+   int sleeping;
+
+   char name[32];
+};
+
+static void
+deadline_after_ms(struct timespec *deadline, int64_t ms)
+{
+   timespec_get(deadline, TIME_MONOTONIC);
+   deadline->tv_sec += ms / 1000;
+   deadline->tv_nsec += (ms % 1000) * 1000000;
+   if (deadline->tv_nsec >= 1000000000) {
+      deadline->tv_nsec -= 1000000000;
+      deadline->tv_sec++;
+   }
+}
+
+static int
+reaper_thread(void *data)
+{
+   struct pb_cache_reaper *reaper = data;
+
+   u_thread_setname(reaper->name);
+
+   mtx_lock(&reaper->lock);
+   while (!reaper->stop) {
+      const int64_t left_ms = pb_cache_next_expiry_ms(reaper->cache);
+
+      if (left_ms == 0) {
+         /* Freeing a buffer hands device memory back, which can take a
+          * while; nobody who wants the lock should wait for it. */
+         mtx_unlock(&reaper->lock);
+         pb_cache_release_expired(reaper->cache);
+         mtx_lock(&reaper->lock);
+      } else if (left_ms > 0) {
+         /* A buffer added meanwhile expires after this one, so only the
+          * deadline, or the end of the reaper, needs to wake us. */
+         struct timespec deadline;
+         deadline_after_ms(&deadline, left_ms);
+         u_cnd_monotonic_timedwait(&reaper->wake, &reaper->lock, &deadline);
+      } else {
+         p_atomic_set(&reaper->sleeping, 1);
+         /* An addition that did not see the flag is in the cache by now. */
+         if (pb_cache_next_expiry_ms(reaper->cache) < 0 && !reaper->stop)
+            u_cnd_monotonic_wait(&reaper->wake, &reaper->lock);
+         p_atomic_set(&reaper->sleeping, 0);
+      }
+   }
+   mtx_unlock(&reaper->lock);
+
+   return 0;
+}
+
+struct pb_cache_reaper *
+pb_cache_reaper_create(struct pb_cache *cache, const char *name)
+{
+   struct pb_cache_reaper *reaper = CALLOC_STRUCT(pb_cache_reaper);
+   if (!reaper)
+      return NULL;
+
+   reaper->cache = cache;
+   snprintf(reaper->name, sizeof(reaper->name), "%s", name ? name : "pb-cache");
+   if (mtx_init(&reaper->lock, mtx_plain) != thrd_success)
+      goto fail_alloc;
+   if (u_cnd_monotonic_init(&reaper->wake) != thrd_success)
+      goto fail_mutex;
+   if (u_thread_create(&reaper->thread, reaper_thread, reaper) != thrd_success)
+      goto fail_cond;
+
+   return reaper;
+
+fail_cond:
+   u_cnd_monotonic_destroy(&reaper->wake);
+fail_mutex:
+   mtx_destroy(&reaper->lock);
+fail_alloc:
+   FREE(reaper);
+   return NULL;
+}
+
+void
+pb_cache_reaper_wake(struct pb_cache_reaper *reaper)
+{
+   if (!reaper || !p_atomic_read(&reaper->sleeping))
+      return;
+
+   /* The thread holds the lock from setting the flag until it waits, so this
+    * signal cannot fall between the two. */
+   mtx_lock(&reaper->lock);
+   u_cnd_monotonic_signal(&reaper->wake);
+   mtx_unlock(&reaper->lock);
+}
+
+void
+pb_cache_reaper_destroy(struct pb_cache_reaper *reaper)
+{
+   if (!reaper)
+      return;
+
+   mtx_lock(&reaper->lock);
+   reaper->stop = true;
+   u_cnd_monotonic_signal(&reaper->wake);
+   mtx_unlock(&reaper->lock);
+
+   thrd_join(reaper->thread, NULL);
+
+   u_cnd_monotonic_destroy(&reaper->wake);
+   mtx_destroy(&reaper->lock);
+   FREE(reaper);
+}
diff --git a/src/gallium/auxiliary/pipebuffer/pb_cache_reaper.h b/src/gallium/auxiliary/pipebuffer/pb_cache_reaper.h
new file mode 100644
index 0000000000000000000000000000000000000000..2c48a44935698b7e3913e7785bb61fc74aaf7812
--- /dev/null
+++ b/src/gallium/auxiliary/pipebuffer/pb_cache_reaper.h
@@ -0,0 +1,58 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef PB_CACHE_REAPER_H
+#define PB_CACHE_REAPER_H
+
+#include "pb_cache.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * A thread that frees a pb_cache's buffers once they expire.
+ *
+ * A pb_cache frees an expired buffer only when another buffer is added to it
+ * or reclaimed from it, so a client that stops allocating leaves every buffer
+ * it freed cached, however long ago, and the cache holds that memory for as
+ * long as the client stays idle.  The reaper waits for the earliest expiry
+ * and frees what has expired.  A cache that nothing has added to costs it
+ * nothing but the thread: it sleeps without a deadline until
+ * pb_cache_reaper_wake() reports an addition, and while the cache is
+ * non-empty it wakes once per expiry, at most every `usecs` microseconds the
+ * cache was created with.
+ */
+struct pb_cache_reaper;
+
+/**
+ * Starts a reaper for \p cache, whose thread is named \p name.  The cache
+ * must outlive the reaper.  Returns NULL when the thread cannot be created,
+ * and the cache then behaves as it does without one.
+ */
+struct pb_cache_reaper *
+pb_cache_reaper_create(struct pb_cache *cache, const char *name);
+
+/**
+ * Tells the reaper that a buffer was added to its cache, after
+ * pb_cache_add_buffer() returned.  Cheap unless the reaper is asleep with
+ * nothing to wait for.  Accepts NULL, so a caller whose reaper could not be
+ * created needs no test.
+ */
+void
+pb_cache_reaper_wake(struct pb_cache_reaper *reaper);
+
+/**
+ * Stops the reaper and waits for its thread.  A caller destroys it before
+ * pb_cache_deinit(), and after the last thread that can add a buffer has
+ * finished adding.  Accepts NULL.
+ */
+void
+pb_cache_reaper_destroy(struct pb_cache_reaper *reaper);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/gallium/auxiliary/pipebuffer/pb_cache_reaper_test.c b/src/gallium/auxiliary/pipebuffer/pb_cache_reaper_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..b6a3eebe72c5dec96e74f34af99cc7010d3e8368
--- /dev/null
+++ b/src/gallium/auxiliary/pipebuffer/pb_cache_reaper_test.c
@@ -0,0 +1,345 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* pb_cache_release_expired(), pb_cache_next_expiry_ms() and the reaper that
+ * frees a cache's expired buffers while nothing is added.  The buffers are
+ * heap blocks the cache destroys with free(); every check aborts, so the
+ * test fails in a build without assertions as well.  Built with
+ * -Db_sanitize=thread it covers the reaper's thread against the paths that
+ * add, reclaim and release buffers. */
+
+#include "c11/threads.h"
+#include "pipebuffer/pb_cache.h"
+#include "pipebuffer/pb_cache_reaper.h"
+#include "util/os_time.h"
+#include "util/u_atomic.h"
+
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(condition)                                                       \
+   do {                                                                        \
+      if (!(condition)) {                                                      \
+         fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__,      \
+                 #condition);                                                  \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+
+#define BUCKETS      3
+#define BUFFER_SIZE  (64u * 1024u)
+#define WAIT_LIMIT_MS 5000
+
+struct test_bo {
+   struct pb_buffer_lean base;
+   struct pb_cache_entry entry;
+};
+
+struct world {
+   struct pb_cache cache;
+   struct pb_cache_reaper *reaper;
+   int created;
+   int destroyed;
+};
+
+static void
+destroy_bo(void *winsys, struct pb_buffer_lean *buf)
+{
+   struct world *world = winsys;
+
+   /* The cache calls this with its mutex held, after taking the buffer out of
+    * its accounting: what it still holds never exceeds what it may. */
+   CHECK(world->cache.cache_size <= world->cache.max_cache_size);
+   p_atomic_inc(&world->destroyed);
+   free(buf);
+}
+
+static bool
+can_reclaim_bo(void *winsys, struct pb_buffer_lean *buf)
+{
+   (void)winsys;
+   (void)buf;
+   return true;
+}
+
+static void
+world_init(struct world *world, unsigned usecs, uint64_t max_cache_size)
+{
+   *world = (struct world){0};
+   pb_cache_init(&world->cache, BUCKETS, usecs, 1.5f, 0, max_cache_size,
+                 offsetof(struct test_bo, entry), world, destroy_bo,
+                 can_reclaim_bo);
+   CHECK(world->cache.buckets);
+}
+
+static struct test_bo *
+new_bo(struct world *world, unsigned bucket)
+{
+   struct test_bo *bo = calloc(1, sizeof(*bo));
+   CHECK(bo);
+   bo->base.size = BUFFER_SIZE;
+   bo->base.alignment_log2 = 12;
+   pipe_reference_init(&bo->base.reference, 1);
+   pb_cache_init_entry(&world->cache, &bo->entry, &bo->base, bucket);
+   p_atomic_inc(&world->created);
+   return bo;
+}
+
+/* What bo_destroy_or_cache() does when the last reference goes. */
+static void
+release_bo(struct world *world, struct test_bo *bo)
+{
+   pipe_reference_init(&bo->base.reference, 0);
+   pb_cache_add_buffer(&world->cache, &bo->entry);
+   pb_cache_reaper_wake(world->reaper);
+}
+
+static int64_t
+now_ms(void)
+{
+   return os_time_get_nano() / 1000000;
+}
+
+static void
+sleep_ms(unsigned ms)
+{
+   os_time_sleep((int64_t)ms * 1000);
+}
+
+/* Waits until the world has destroyed `count` buffers, and returns when. */
+static int64_t
+wait_destroyed(struct world *world, int count)
+{
+   const int64_t start = now_ms();
+   while (p_atomic_read(&world->destroyed) < count) {
+      CHECK(now_ms() - start < WAIT_LIMIT_MS);
+      sleep_ms(2);
+   }
+   return now_ms();
+}
+
+static void
+wait_empty(struct world *world)
+{
+   const int64_t start = now_ms();
+   while (pb_cache_next_expiry_ms(&world->cache) >= 0) {
+      CHECK(now_ms() - start < WAIT_LIMIT_MS);
+      sleep_ms(2);
+   }
+}
+
+/* Without a reaper nothing frees an expired buffer; the two entry points do. */
+static void
+test_expiry_entry_points(void)
+{
+   struct world world;
+   world_init(&world, 50000, UINT64_MAX);
+
+   CHECK(pb_cache_next_expiry_ms(&world.cache) == -1);
+   CHECK(pb_cache_release_expired(&world.cache) == 0);
+
+   release_bo(&world, new_bo(&world, 0));
+   int64_t left = pb_cache_next_expiry_ms(&world.cache);
+   CHECK(left >= 0 && left <= 50);
+
+   /* Past its expiry the buffer is still cached: this is the gap. */
+   sleep_ms(80);
+   CHECK(p_atomic_read(&world.destroyed) == 0);
+   CHECK(pb_cache_next_expiry_ms(&world.cache) == 0);
+   CHECK(pb_cache_release_expired(&world.cache) == 1);
+   CHECK(p_atomic_read(&world.destroyed) == 1);
+   CHECK(pb_cache_next_expiry_ms(&world.cache) == -1);
+
+   /* The earliest buffer of any bucket decides, not the first bucket's. */
+   release_bo(&world, new_bo(&world, 0));
+   sleep_ms(30);
+   release_bo(&world, new_bo(&world, 2));
+   left = pb_cache_next_expiry_ms(&world.cache);
+   CHECK(left >= 0 && left <= 40);
+
+   /* The first has expired by now and the second has not; a stall can only
+    * expire the second as well. */
+   sleep_ms(30);
+   CHECK(pb_cache_release_expired(&world.cache) >= 1);
+   CHECK(p_atomic_read(&world.destroyed) >= 2);
+   sleep_ms(60);
+   (void)pb_cache_release_expired(&world.cache);
+   CHECK(p_atomic_read(&world.destroyed) == p_atomic_read(&world.created));
+   CHECK(pb_cache_next_expiry_ms(&world.cache) == -1);
+
+   pb_cache_deinit(&world.cache);
+}
+
+/* The reaper frees every buffer soon after it expires, with no later addition
+ * and no reclaim, and sleeps again once the cache is empty. */
+static void
+test_reaper_frees_expired(void)
+{
+   struct world world;
+   world_init(&world, 20000, UINT64_MAX);
+   world.reaper = pb_cache_reaper_create(&world.cache, "pb-cache-test");
+   CHECK(world.reaper);
+
+   release_bo(&world, new_bo(&world, 0));
+   release_bo(&world, new_bo(&world, 1));
+   release_bo(&world, new_bo(&world, 2));
+   release_bo(&world, new_bo(&world, 1));
+   const int64_t last_add = now_ms();
+   const int64_t done = wait_destroyed(&world, 4);
+   /* 20 ms to expire, well under the second the memory budget names. */
+   CHECK(done - last_add < 1000);
+   wait_empty(&world);
+
+   /* A reaper asleep with nothing to wait for wakes for every new buffer. */
+   for (int i = 0; i < 40; i++) {
+      sleep_ms(i % 3 == 0 ? 30 : 1);
+      release_bo(&world, new_bo(&world, i % BUCKETS));
+      wait_destroyed(&world, 5 + i);
+   }
+   wait_empty(&world);
+
+   pb_cache_reaper_destroy(world.reaper);
+   CHECK(p_atomic_read(&world.destroyed) == p_atomic_read(&world.created));
+   pb_cache_deinit(&world.cache);
+}
+
+/* A buffer that is reclaimed before it expires is never freed behind the
+ * client's back. */
+static void
+test_reaper_leaves_reclaimed(void)
+{
+   struct world world;
+   world_init(&world, 300000, UINT64_MAX);
+   world.reaper = pb_cache_reaper_create(&world.cache, "pb-cache-test");
+   CHECK(world.reaper);
+
+   struct test_bo *bo = new_bo(&world, 1);
+   release_bo(&world, bo);
+   struct pb_buffer_lean *again = pb_cache_reclaim_buffer(
+      &world.cache, BUFFER_SIZE, 1, 0, 1);
+   CHECK(again == &bo->base);
+   CHECK(pipe_is_referenced(&bo->base.reference));
+   sleep_ms(500);
+   CHECK(p_atomic_read(&world.destroyed) == 0);
+   CHECK(pb_cache_next_expiry_ms(&world.cache) == -1);
+
+   release_bo(&world, bo);
+   wait_destroyed(&world, 1);
+
+   pb_cache_reaper_destroy(world.reaper);
+   pb_cache_deinit(&world.cache);
+}
+
+/* Ending a reaper that waits for a distant expiry does not wait for it. */
+static void
+test_reaper_destroy_is_prompt(void)
+{
+   struct world world;
+   world_init(&world, 60u * 1000000u, UINT64_MAX);
+   world.reaper = pb_cache_reaper_create(&world.cache, "pb-cache-test");
+   CHECK(world.reaper);
+   for (int i = 0; i < 3; i++)
+      release_bo(&world, new_bo(&world, i));
+
+   const int64_t start = now_ms();
+   pb_cache_reaper_destroy(world.reaper);
+   CHECK(now_ms() - start < 1000);
+   CHECK(p_atomic_read(&world.destroyed) == 0);
+   CHECK(pb_cache_release_all_buffers(&world.cache) == 3);
+   CHECK(p_atomic_read(&world.destroyed) == 3);
+   pb_cache_deinit(&world.cache);
+
+   /* Starting and ending reapers, with the first addition racing the thread's
+    * first look at the cache. */
+   for (int i = 0; i < 100; i++) {
+      world_init(&world, 1000, UINT64_MAX);
+      world.reaper = pb_cache_reaper_create(&world.cache, "pb-cache-test");
+      CHECK(world.reaper);
+      if (i % 2)
+         release_bo(&world, new_bo(&world, i % BUCKETS));
+      pb_cache_reaper_destroy(world.reaper);
+      world.reaper = NULL;
+      pb_cache_deinit(&world.cache);
+      CHECK(p_atomic_read(&world.destroyed) == p_atomic_read(&world.created));
+   }
+}
+
+/* Threads that add and reclaim as fast as they can, against the reaper and a
+ * cache that holds only a few buffers.  Every buffer is destroyed exactly
+ * once, and the cache never holds more than its limit. */
+#define WORKERS     4
+#define ITERATIONS  3000
+#define CACHE_LIMIT (8u * BUFFER_SIZE)
+
+struct worker {
+   struct world *world;
+   unsigned seed;
+};
+
+static int
+worker_main(void *data)
+{
+   struct worker *worker = data;
+   struct world *world = worker->world;
+   struct test_bo *held[4] = {0};
+
+   for (int i = 0; i < ITERATIONS; i++) {
+      worker->seed = worker->seed * 1664525u + 1013904223u;
+      const unsigned pick = (worker->seed >> 16) % 4;
+      const unsigned bucket = (worker->seed >> 8) % BUCKETS;
+
+      if (held[pick]) {
+         release_bo(world, held[pick]);
+         held[pick] = NULL;
+      } else {
+         struct pb_buffer_lean *buf = pb_cache_reclaim_buffer(
+            &world->cache, BUFFER_SIZE, 1, 0, bucket);
+         held[pick] = buf ? (struct test_bo *)buf : new_bo(world, bucket);
+      }
+      /* Now and then outlast the 1 ms expiry, so the reaper has work. */
+      if ((worker->seed & 0xff) == 0)
+         sleep_ms(2);
+   }
+   for (int i = 0; i < 4; i++)
+      if (held[i])
+         release_bo(world, held[i]);
+   return 0;
+}
+
+static void
+test_concurrent_add_reclaim_reap(void)
+{
+   struct world world;
+   world_init(&world, 1000, CACHE_LIMIT);
+   world.reaper = pb_cache_reaper_create(&world.cache, "pb-cache-test");
+   CHECK(world.reaper);
+
+   thrd_t threads[WORKERS];
+   struct worker workers[WORKERS];
+   for (int i = 0; i < WORKERS; i++) {
+      workers[i] = (struct worker){&world, 12345u + 7919u * i};
+      CHECK(thrd_create(&threads[i], worker_main, &workers[i]) ==
+            thrd_success);
+   }
+   for (int i = 0; i < WORKERS; i++)
+      CHECK(thrd_join(threads[i], NULL) == thrd_success);
+
+   wait_empty(&world);
+   pb_cache_reaper_destroy(world.reaper);
+   CHECK(p_atomic_read(&world.destroyed) == p_atomic_read(&world.created));
+   pb_cache_deinit(&world.cache);
+}
+
+int
+main(void)
+{
+   test_expiry_entry_points();
+   test_reaper_frees_expired();
+   test_reaper_leaves_reclaimed();
+   test_reaper_destroy_is_prompt();
+   test_concurrent_add_reclaim_reap();
+   printf("the reaper frees every expired buffer and no other\n");
+   return 0;
+}
