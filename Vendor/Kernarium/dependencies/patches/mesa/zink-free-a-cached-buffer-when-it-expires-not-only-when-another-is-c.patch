diff --git a/src/gallium/auxiliary/pipebuffer/pb_cache.c b/src/gallium/auxiliary/pipebuffer/pb_cache.c
index 7fcb13b709916b87ce1e257b80db52544f990951..4345ae4ad547313fee550ca687f63d321442e2cc 100644
--- a/src/gallium/auxiliary/pipebuffer/pb_cache.c
+++ b/src/gallium/auxiliary/pipebuffer/pb_cache.c
@@ -133,6 +133,7 @@ pb_cache_add_buffer(struct pb_cache *mgr, struct pb_cache_entry *entry)
    list_addtail(&entry->head, cache);
    ++mgr->num_buffers;
    mgr->cache_size += buf->size;
+   assert(mgr->cache_size <= mgr->max_cache_size);
    simple_mtx_unlock(&mgr->mutex);
 }
 
@@ -273,6 +274,73 @@ pb_cache_release_all_buffers(struct pb_cache *mgr)
    return num_reclaims;
 }
 
+/**
+ * Free every cached buffer whose time has run out, in every bucket.
+ *
+ * pb_cache_add_buffer() and pb_cache_reclaim_buffer() are the only other
+ * places that free expired buffers, so a cache that nothing adds to or
+ * reclaims from keeps them for good. A caller that wants them gone once they
+ * expire calls this when pb_cache_next_expiry_ms() says one has.
+ *
+ * \return the number of buffers destroyed
+ */
+unsigned
+pb_cache_release_expired(struct pb_cache *mgr)
+{
+   unsigned released;
+
+   simple_mtx_lock(&mgr->mutex);
+   const unsigned before = mgr->num_buffers;
+   const unsigned current_time_ms = time_get_ms(mgr);
+
+   for (unsigned i = 0; i < mgr->num_heaps; i++)
+      release_expired_buffers_locked(mgr, &mgr->buckets[i], current_time_ms);
+
+   released = before - mgr->num_buffers;
+   simple_mtx_unlock(&mgr->mutex);
+   return released;
+}
+
+/**
+ * The time until the first cached buffer expires.
+ *
+ * A bucket holds its buffers in the order they were added, which is the order
+ * they expire in, so its first buffer is its earliest.
+ *
+ * \return the milliseconds left before the earliest expiry, 0 when a buffer
+ *         has already expired (the next pb_cache_release_expired() frees it),
+ *         and -1 when the cache holds no buffer
+ */
+int64_t
+pb_cache_next_expiry_ms(struct pb_cache *mgr)
+{
+   int64_t next = -1;
+
+   simple_mtx_lock(&mgr->mutex);
+   const unsigned current_time_ms = time_get_ms(mgr);
+
+   for (unsigned i = 0; i < mgr->num_heaps; i++) {
+      struct list_head *cache = &mgr->buckets[i];
+
+      if (list_is_empty(cache))
+         continue;
+
+      struct pb_cache_entry *entry =
+         list_first_entry(cache, struct pb_cache_entry, head);
+      /* Unsigned, like time_timeout_ms(): a counter that wrapped reads as
+       * the time that passed since the buffer was added. */
+      const unsigned elapsed_ms = current_time_ms - entry->start_ms;
+      const int64_t left_ms =
+         elapsed_ms >= mgr->msecs ? 0 : mgr->msecs - elapsed_ms;
+
+      if (next < 0 || left_ms < next)
+         next = left_ms;
+   }
+
+   simple_mtx_unlock(&mgr->mutex);
+   return next;
+}
+
 void
 pb_cache_init_entry(struct pb_cache *mgr, struct pb_cache_entry *entry,
                     struct pb_buffer_lean *buf, unsigned bucket_index)
