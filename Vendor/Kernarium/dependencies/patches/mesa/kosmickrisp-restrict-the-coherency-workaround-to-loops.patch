index 0000000000000000000000000000000000000000..f353d01a52a9254428b04c69eda4f0147b4185b3
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_tes_sampler_indexing.cpp
@@ -0,0 +1,669 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* A tessellation evaluation shader that indexes a combined image sampler array
+ * with a uniform value and stores one record per tessellated vertex.  Line
+ * rasterization emulation runs that shader as the software materializer with
+ * custom-border emulation active, so every generated vertex must record the
+ * same lookups the hardware vertex stage would.
+ */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cstdlib>
+#include <span>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+static void require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (!ok) {
+      std::fprintf(stderr, "%s: %d\n", operation, value);
+      std::exit(1);
+   }
+}
+
+template <typename T> static T load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+#define LOAD_D(name)                                                           \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+
+static const uint32_t vertex_spirv[] =
+#include "tes_sampler_shaders/sampler.vert.h"
+;
+static const uint32_t tesc_spirv[] =
+#include "tes_sampler_shaders/sampler.tesc.h"
+;
+static const uint32_t tese_spirv[] =
+#include "tes_sampler_shaders/sampler.tese.h"
+;
+static const uint32_t fragment_spirv[] =
+#include "tes_sampler_shaders/sampler.frag.h"
+;
+
+/* The dEQP tessellation evaluation executor draws one patch per two values and
+ * derives the record index from gl_PrimitiveID and gl_TessCoord. */
+static constexpr uint32_t kInvocations = 64;
+static constexpr uint32_t kTextures = 8;
+static constexpr uint32_t kLookups = 4;
+/* Distinct colors, and lookup indices that make a collapse to texture zero
+ * visible on every lookup but the first. */
+static constexpr uint8_t kColors[kTextures][4] = {
+   {125, 59, 107, 88},   {109, 227, 144, 57},  {18, 254, 110, 163},
+   {177, 125, 129, 162}, {79, 10, 48, 163},    {207, 30, 5, 29},
+   {19, 237, 79, 201},   {126, 109, 138, 96},
+};
+static constexpr int32_t kIndices[kLookups] = {0, 4, 3, 7};
+
+int main()
+{
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+   app.pApplicationName = "tes-sampler-indexing";
+   app.apiVersion = VK_API_VERSION_1_3;
+   VkInstanceCreateInfo instance_info{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+   instance_info.pApplicationInfo = &app;
+   auto result = vkCreateInstance(&instance_info, nullptr, &instance);
+   require(result == VK_SUCCESS, "create instance", result);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   uint32_t physical_count = 0;
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, nullptr);
+   require(result == VK_SUCCESS && physical_count, "physical device count", result);
+   std::vector<VkPhysicalDevice> physicals(physical_count);
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, physicals.data());
+   require(result == VK_SUCCESS, "physical devices", result);
+
+   for (VkPhysicalDevice physical : physicals) {
+      uint32_t queue_count = 0;
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, nullptr);
+      std::vector<VkQueueFamilyProperties> queues(queue_count);
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, queues.data());
+      uint32_t queue = 0;
+      while (queue < queue_count && !(queues[queue].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+         ++queue;
+      require(queue < queue_count, "graphics queue");
+      float priority = 1.0f;
+      VkDeviceQueueCreateInfo queue_info{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+      queue_info.queueFamilyIndex = queue;
+      queue_info.queueCount = 1;
+      queue_info.pQueuePriorities = &priority;
+      VkPhysicalDeviceCustomBorderColorFeaturesEXT border{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_CUSTOM_BORDER_COLOR_FEATURES_EXT};
+      border.customBorderColors = VK_TRUE;
+      border.customBorderColorWithoutFormat = VK_TRUE;
+      VkPhysicalDeviceNonSeamlessCubeMapFeaturesEXT seamless{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_NON_SEAMLESS_CUBE_MAP_FEATURES_EXT};
+      seamless.pNext = &border;
+      seamless.nonSeamlessCubeMap = VK_TRUE;
+      VkPhysicalDeviceProvokingVertexFeaturesEXT provoking{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROVOKING_VERTEX_FEATURES_EXT};
+      provoking.pNext = &seamless;
+      provoking.provokingVertexLast = VK_TRUE;
+      VkPhysicalDeviceLineRasterizationFeaturesKHR line{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_LINE_RASTERIZATION_FEATURES_KHR};
+      line.pNext = &provoking;
+      line.rectangularLines = VK_TRUE;
+      VkPhysicalDeviceVulkan13Features features13{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+      features13.pNext = &line;
+      features13.dynamicRendering = VK_TRUE;
+      VkPhysicalDeviceFeatures features{};
+      features.tessellationShader = VK_TRUE;
+      features.imageCubeArray = VK_TRUE;
+      features.shaderSampledImageArrayDynamicIndexing = VK_TRUE;
+      features.vertexPipelineStoresAndAtomics = VK_TRUE;
+      features.robustBufferAccess = VK_TRUE;
+      const char *extensions[] = {VK_EXT_PROVOKING_VERTEX_EXTENSION_NAME,
+                                  VK_KHR_LINE_RASTERIZATION_EXTENSION_NAME,
+                                  VK_EXT_CUSTOM_BORDER_COLOR_EXTENSION_NAME,
+                                  VK_EXT_NON_SEAMLESS_CUBE_MAP_EXTENSION_NAME};
+      VkDeviceCreateInfo device_info{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+      device_info.pNext = &features13;
+      device_info.queueCreateInfoCount = 1;
+      device_info.pQueueCreateInfos = &queue_info;
+      device_info.enabledExtensionCount =
+         sizeof(extensions) / sizeof(extensions[0]);
+      device_info.ppEnabledExtensionNames = extensions;
+      device_info.pEnabledFeatures = &features;
+      VkDevice device = VK_NULL_HANDLE;
+      result = vkCreateDevice(physical, &device_info, nullptr, &device);
+      require(result == VK_SUCCESS, "create device", result);
+
+      LOAD_D(vkDestroyDevice);
+      LOAD_D(vkCreateShaderModule);
+      LOAD_D(vkDestroyShaderModule);
+      LOAD_D(vkCreateDescriptorSetLayout);
+      LOAD_D(vkDestroyDescriptorSetLayout);
+      LOAD_D(vkCreateDescriptorPool);
+      LOAD_D(vkDestroyDescriptorPool);
+      LOAD_D(vkAllocateDescriptorSets);
+      LOAD_D(vkUpdateDescriptorSets);
+      LOAD_D(vkCreatePipelineLayout);
+      LOAD_D(vkDestroyPipelineLayout);
+      LOAD_D(vkCreateGraphicsPipelines);
+      LOAD_D(vkDestroyPipeline);
+      LOAD_D(vkCreateCommandPool);
+      LOAD_D(vkDestroyCommandPool);
+      LOAD_D(vkAllocateCommandBuffers);
+      LOAD_D(vkBeginCommandBuffer);
+      LOAD_D(vkEndCommandBuffer);
+      LOAD_D(vkCmdBeginRendering);
+      LOAD_D(vkCmdEndRendering);
+      LOAD_D(vkCmdBindPipeline);
+      LOAD_D(vkCmdBindDescriptorSets);
+      LOAD_D(vkCmdSetViewport);
+      LOAD_D(vkCmdSetScissor);
+      LOAD_D(vkCmdDraw);
+      LOAD_D(vkCmdCopyBufferToImage);
+      LOAD_D(vkCmdPipelineBarrier);
+      LOAD_D(vkGetDeviceQueue);
+      LOAD_D(vkQueueSubmit);
+      LOAD_D(vkQueueWaitIdle);
+      LOAD_D(vkCreateBuffer);
+      LOAD_D(vkDestroyBuffer);
+      LOAD_D(vkGetBufferMemoryRequirements);
+      LOAD_D(vkCreateImage);
+      LOAD_D(vkDestroyImage);
+      LOAD_D(vkGetImageMemoryRequirements);
+      LOAD_D(vkBindImageMemory);
+      LOAD_D(vkCreateImageView);
+      LOAD_D(vkDestroyImageView);
+      LOAD_D(vkCreateSampler);
+      LOAD_D(vkDestroySampler);
+      LOAD_D(vkAllocateMemory);
+      LOAD_D(vkFreeMemory);
+      LOAD_D(vkBindBufferMemory);
+      LOAD_D(vkMapMemory);
+      LOAD_D(vkUnmapMemory);
+      VkQueue device_queue = VK_NULL_HANDLE;
+      vkGetDeviceQueue(device, queue, 0, &device_queue);
+
+      VkPhysicalDeviceMemoryProperties memory_properties{};
+      vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+      auto find_memory = [&](uint32_t bits, VkMemoryPropertyFlags wanted) {
+         for (uint32_t i = 0; i < memory_properties.memoryTypeCount; ++i) {
+            if ((bits & (1u << i)) &&
+                (memory_properties.memoryTypes[i].propertyFlags & wanted) == wanted)
+               return i;
+         }
+         require(false, "memory type");
+         return 0u;
+      };
+
+      struct Allocation {
+         VkBuffer buffer = VK_NULL_HANDLE;
+         VkDeviceMemory memory = VK_NULL_HANDLE;
+         void *mapped = nullptr;
+      };
+      auto make_buffer = [&](VkDeviceSize size, VkBufferUsageFlags usage) {
+         Allocation out{};
+         VkBufferCreateInfo info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+         info.size = size;
+         info.usage = usage;
+         result = vkCreateBuffer(device, &info, nullptr, &out.buffer);
+         require(result == VK_SUCCESS, "create buffer", result);
+         VkMemoryRequirements requirements{};
+         vkGetBufferMemoryRequirements(device, out.buffer, &requirements);
+         VkMemoryAllocateInfo allocate{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+         allocate.allocationSize = requirements.size;
+         allocate.memoryTypeIndex =
+            find_memory(requirements.memoryTypeBits,
+                        VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                           VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+         result = vkAllocateMemory(device, &allocate, nullptr, &out.memory);
+         require(result == VK_SUCCESS, "allocate buffer memory", result);
+         result = vkBindBufferMemory(device, out.buffer, out.memory, 0);
+         require(result == VK_SUCCESS, "bind buffer", result);
+         result = vkMapMemory(device, out.memory, 0, VK_WHOLE_SIZE, 0, &out.mapped);
+         require(result == VK_SUCCESS, "map buffer", result);
+         return out;
+      };
+
+      const Allocation indices = make_buffer(
+         sizeof(kIndices), VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT);
+      std::memcpy(indices.mapped, kIndices, sizeof(kIndices));
+
+      const VkDeviceSize input_size = kInvocations * 4 * sizeof(float);
+      const Allocation inputs =
+         make_buffer(input_size, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+      std::memset(inputs.mapped, 0, input_size);
+
+      const VkDeviceSize output_size = kInvocations * kLookups * 4 * sizeof(float);
+      const Allocation outputs =
+         make_buffer(output_size, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+      /* A record the materializer never writes must fail the comparison, so
+       * seed the buffer with a value no lookup can produce. */
+      float *seed = static_cast<float *>(outputs.mapped);
+      for (size_t i = 0; i < output_size / sizeof(float); ++i)
+         seed[i] = -1.0f;
+
+      const Allocation staging = make_buffer(
+         kTextures * 6 * 4, VK_BUFFER_USAGE_TRANSFER_SRC_BIT);
+      for (uint32_t t = 0; t < kTextures; ++t) {
+         for (uint32_t layer = 0; layer < 6; ++layer) {
+            std::memcpy(static_cast<uint8_t *>(staging.mapped) + (t * 6 + layer) * 4,
+                        kColors[t], 4);
+         }
+      }
+
+      /* One 1x1 cube array per texture, every face carrying the same texel so
+       * the sampled value identifies the descriptor and nothing else. */
+      std::array<VkImage, kTextures> images{};
+      std::array<VkDeviceMemory, kTextures> image_memory{};
+      std::array<VkImageView, kTextures> views{};
+      for (uint32_t t = 0; t < kTextures; ++t) {
+         VkImageCreateInfo info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+         info.flags = VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT;
+         info.imageType = VK_IMAGE_TYPE_2D;
+         info.format = VK_FORMAT_R8G8B8A8_UNORM;
+         info.extent = {1, 1, 1};
+         info.mipLevels = 1;
+         info.arrayLayers = 6;
+         info.samples = VK_SAMPLE_COUNT_1_BIT;
+         info.tiling = VK_IMAGE_TILING_OPTIMAL;
+         info.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+         info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+         result = vkCreateImage(device, &info, nullptr, &images[t]);
+         require(result == VK_SUCCESS, "create image", result);
+         VkMemoryRequirements requirements{};
+         vkGetImageMemoryRequirements(device, images[t], &requirements);
+         VkMemoryAllocateInfo allocate{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+         allocate.allocationSize = requirements.size;
+         allocate.memoryTypeIndex = find_memory(requirements.memoryTypeBits, 0);
+         result = vkAllocateMemory(device, &allocate, nullptr, &image_memory[t]);
+         require(result == VK_SUCCESS, "allocate image memory", result);
+         result = vkBindImageMemory(device, images[t], image_memory[t], 0);
+         require(result == VK_SUCCESS, "bind image", result);
+         VkImageViewCreateInfo view{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+         view.image = images[t];
+         view.viewType = VK_IMAGE_VIEW_TYPE_CUBE_ARRAY;
+         view.format = VK_FORMAT_R8G8B8A8_UNORM;
+         view.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 6};
+         result = vkCreateImageView(device, &view, nullptr, &views[t]);
+         require(result == VK_SUCCESS, "create image view", result);
+      }
+
+      VkSamplerCreateInfo sampler_info{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+      sampler_info.magFilter = VK_FILTER_NEAREST;
+      sampler_info.minFilter = VK_FILTER_NEAREST;
+      sampler_info.addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+      sampler_info.addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+      sampler_info.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+      VkSampler sampler = VK_NULL_HANDLE;
+      result = vkCreateSampler(device, &sampler_info, nullptr, &sampler);
+      require(result == VK_SUCCESS, "create sampler", result);
+
+      /* A tiny color attachment keeps rasterization enabled, which is what
+       * selects the generated line raster path for an isoline domain. */
+      VkImage target = VK_NULL_HANDLE;
+      VkDeviceMemory target_memory = VK_NULL_HANDLE;
+      VkImageView target_view = VK_NULL_HANDLE;
+      {
+         VkImageCreateInfo info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+         info.imageType = VK_IMAGE_TYPE_2D;
+         info.format = VK_FORMAT_R8G8B8A8_UNORM;
+         info.extent = {64, 64, 1};
+         info.mipLevels = 1;
+         info.arrayLayers = 1;
+         info.samples = VK_SAMPLE_COUNT_1_BIT;
+         info.tiling = VK_IMAGE_TILING_OPTIMAL;
+         info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+         result = vkCreateImage(device, &info, nullptr, &target);
+         require(result == VK_SUCCESS, "create target", result);
+         VkMemoryRequirements requirements{};
+         vkGetImageMemoryRequirements(device, target, &requirements);
+         VkMemoryAllocateInfo allocate{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+         allocate.allocationSize = requirements.size;
+         allocate.memoryTypeIndex = find_memory(requirements.memoryTypeBits, 0);
+         result = vkAllocateMemory(device, &allocate, nullptr, &target_memory);
+         require(result == VK_SUCCESS, "allocate target", result);
+         result = vkBindImageMemory(device, target, target_memory, 0);
+         require(result == VK_SUCCESS, "bind target", result);
+         VkImageViewCreateInfo view{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+         view.image = target;
+         view.viewType = VK_IMAGE_VIEW_TYPE_2D;
+         view.format = VK_FORMAT_R8G8B8A8_UNORM;
+         view.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+         result = vkCreateImageView(device, &view, nullptr, &target_view);
+         require(result == VK_SUCCESS, "create target view", result);
+      }
+
+      const VkDescriptorSetLayoutBinding bindings[] = {
+         {0, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, kTextures,
+          VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT, nullptr},
+         {1, VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, 1,
+          VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT, nullptr},
+         {2, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1,
+          VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT, nullptr},
+         {3, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1,
+          VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT, nullptr},
+      };
+      VkDescriptorSetLayoutCreateInfo set_layout_info{
+         VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+      set_layout_info.bindingCount = 4;
+      set_layout_info.pBindings = bindings;
+      VkDescriptorSetLayout set_layout = VK_NULL_HANDLE;
+      result = vkCreateDescriptorSetLayout(device, &set_layout_info, nullptr, &set_layout);
+      require(result == VK_SUCCESS, "create set layout", result);
+
+      const VkDescriptorPoolSize sizes[] = {
+         {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, kTextures},
+         {VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, 1},
+         {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 2},
+      };
+      VkDescriptorPoolCreateInfo pool_create{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+      pool_create.maxSets = 1;
+      pool_create.poolSizeCount = 3;
+      pool_create.pPoolSizes = sizes;
+      VkDescriptorPool descriptor_pool = VK_NULL_HANDLE;
+      result = vkCreateDescriptorPool(device, &pool_create, nullptr, &descriptor_pool);
+      require(result == VK_SUCCESS, "create descriptor pool", result);
+      VkDescriptorSetAllocateInfo set_allocate{
+         VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+      set_allocate.descriptorPool = descriptor_pool;
+      set_allocate.descriptorSetCount = 1;
+      set_allocate.pSetLayouts = &set_layout;
+      VkDescriptorSet set = VK_NULL_HANDLE;
+      result = vkAllocateDescriptorSets(device, &set_allocate, &set);
+      require(result == VK_SUCCESS, "allocate descriptor set", result);
+
+      std::array<VkDescriptorImageInfo, kTextures> image_infos{};
+      for (uint32_t t = 0; t < kTextures; ++t) {
+         image_infos[t].sampler = sampler;
+         image_infos[t].imageView = views[t];
+         image_infos[t].imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+      }
+      const VkDescriptorBufferInfo index_info{indices.buffer, 0, sizeof(kIndices)};
+      const VkDescriptorBufferInfo input_info{inputs.buffer, 0, input_size};
+      const VkDescriptorBufferInfo output_info{outputs.buffer, 0, output_size};
+      VkWriteDescriptorSet writes[4]{};
+      writes[0] = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+      writes[0].dstSet = set;
+      writes[0].dstBinding = 0;
+      writes[0].descriptorCount = kTextures;
+      writes[0].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+      writes[0].pImageInfo = image_infos.data();
+      writes[1] = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+      writes[1].dstSet = set;
+      writes[1].dstBinding = 1;
+      writes[1].descriptorCount = 1;
+      writes[1].descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
+      writes[1].pBufferInfo = &index_info;
+      writes[2] = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+      writes[2].dstSet = set;
+      writes[2].dstBinding = 2;
+      writes[2].descriptorCount = 1;
+      writes[2].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+      writes[2].pBufferInfo = &input_info;
+      writes[3] = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+      writes[3].dstSet = set;
+      writes[3].dstBinding = 3;
+      writes[3].descriptorCount = 1;
+      writes[3].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+      writes[3].pBufferInfo = &output_info;
+      vkUpdateDescriptorSets(device, 4, writes, 0, nullptr);
+
+      VkPipelineLayoutCreateInfo layout_info{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+      layout_info.setLayoutCount = 1;
+      layout_info.pSetLayouts = &set_layout;
+      VkPipelineLayout layout = VK_NULL_HANDLE;
+      result = vkCreatePipelineLayout(device, &layout_info, nullptr, &layout);
+      require(result == VK_SUCCESS, "create pipeline layout", result);
+
+      const std::span<const uint32_t> code[] = {vertex_spirv, tesc_spirv, tese_spirv,
+                                                fragment_spirv};
+      const VkShaderStageFlagBits stages[] = {
+         VK_SHADER_STAGE_VERTEX_BIT, VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT,
+         VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT, VK_SHADER_STAGE_FRAGMENT_BIT};
+      std::array<VkPipelineShaderStageCreateInfo, 4> stage_infos{};
+      std::array<VkShaderModule, 4> modules{};
+      for (uint32_t i = 0; i < 4; ++i) {
+         VkShaderModuleCreateInfo module_info{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+         module_info.codeSize = code[i].size_bytes();
+         module_info.pCode = code[i].data();
+         result = vkCreateShaderModule(device, &module_info, nullptr, &modules[i]);
+         require(result == VK_SUCCESS, "create module", result);
+         stage_infos[i] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};
+         stage_infos[i].stage = stages[i];
+         stage_infos[i].module = modules[i];
+         stage_infos[i].pName = "main";
+      }
+
+      VkPipelineVertexInputStateCreateInfo vi{
+         VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+      VkPipelineInputAssemblyStateCreateInfo ia{
+         VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+      ia.topology = VK_PRIMITIVE_TOPOLOGY_PATCH_LIST;
+      VkPipelineTessellationStateCreateInfo ts{
+         VK_STRUCTURE_TYPE_PIPELINE_TESSELLATION_STATE_CREATE_INFO};
+      ts.patchControlPoints = 2;
+      VkPipelineViewportStateCreateInfo vp{
+         VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+      vp.viewportCount = 1;
+      vp.scissorCount = 1;
+      /* GL's last-vertex provoking convention and rectangular lines are what
+       * make the driver rasterize isolines through generated geometry. */
+      VkPipelineRasterizationProvokingVertexStateCreateInfoEXT provoking_state{
+         VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_PROVOKING_VERTEX_STATE_CREATE_INFO_EXT};
+      provoking_state.provokingVertexMode = VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT;
+      VkPipelineRasterizationLineStateCreateInfoKHR line_state{
+         VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_LINE_STATE_CREATE_INFO_KHR};
+      line_state.pNext = &provoking_state;
+      line_state.lineRasterizationMode = VK_LINE_RASTERIZATION_MODE_RECTANGULAR_KHR;
+      VkPipelineRasterizationStateCreateInfo rs{
+         VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+      rs.pNext = &line_state;
+      rs.rasterizerDiscardEnable = VK_FALSE;
+      rs.polygonMode = VK_POLYGON_MODE_FILL;
+      rs.cullMode = VK_CULL_MODE_NONE;
+      rs.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+      rs.lineWidth = 1.0f;
+      VkPipelineMultisampleStateCreateInfo ms{
+         VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+      ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+      VkPipelineColorBlendAttachmentState blend_attachment{};
+      blend_attachment.colorWriteMask = 0xf;
+      VkPipelineColorBlendStateCreateInfo cb{
+         VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+      cb.attachmentCount = 1;
+      cb.pAttachments = &blend_attachment;
+      const VkDynamicState dynamic_states[] = {VK_DYNAMIC_STATE_VIEWPORT,
+                                               VK_DYNAMIC_STATE_SCISSOR};
+      VkPipelineDynamicStateCreateInfo dyn{
+         VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+      dyn.dynamicStateCount = 2;
+      dyn.pDynamicStates = dynamic_states;
+      const VkFormat color_format = VK_FORMAT_R8G8B8A8_UNORM;
+      VkPipelineRenderingCreateInfo rendering{VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+      rendering.colorAttachmentCount = 1;
+      rendering.pColorAttachmentFormats = &color_format;
+      VkGraphicsPipelineCreateInfo pipeline_info{
+         VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+      pipeline_info.pNext = &rendering;
+      pipeline_info.stageCount = 4;
+      pipeline_info.pStages = stage_infos.data();
+      pipeline_info.pVertexInputState = &vi;
+      pipeline_info.pInputAssemblyState = &ia;
+      pipeline_info.pTessellationState = &ts;
+      pipeline_info.pViewportState = &vp;
+      pipeline_info.pRasterizationState = &rs;
+      pipeline_info.pMultisampleState = &ms;
+      pipeline_info.pColorBlendState = &cb;
+      pipeline_info.pDynamicState = &dyn;
+      pipeline_info.layout = layout;
+      VkPipeline pipeline = VK_NULL_HANDLE;
+      result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &pipeline_info,
+                                         nullptr, &pipeline);
+      require(result == VK_SUCCESS, "create pipeline", result);
+      for (VkShaderModule module : modules)
+         vkDestroyShaderModule(device, module, nullptr);
+
+      VkCommandPoolCreateInfo pool_info{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+      pool_info.queueFamilyIndex = queue;
+      VkCommandPool pool = VK_NULL_HANDLE;
+      result = vkCreateCommandPool(device, &pool_info, nullptr, &pool);
+      require(result == VK_SUCCESS, "create command pool", result);
+      VkCommandBufferAllocateInfo allocate{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+      allocate.commandPool = pool;
+      allocate.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+      allocate.commandBufferCount = 1;
+      VkCommandBuffer command = VK_NULL_HANDLE;
+      result = vkAllocateCommandBuffers(device, &allocate, &command);
+      require(result == VK_SUCCESS, "allocate command", result);
+
+      VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+      begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+      result = vkBeginCommandBuffer(command, &begin);
+      require(result == VK_SUCCESS, "begin command", result);
+      std::array<VkImageMemoryBarrier, kTextures> to_transfer{};
+      for (uint32_t t = 0; t < kTextures; ++t) {
+         to_transfer[t] = {VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+         to_transfer[t].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+         to_transfer[t].oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+         to_transfer[t].newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+         to_transfer[t].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+         to_transfer[t].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+         to_transfer[t].image = images[t];
+         to_transfer[t].subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 6};
+      }
+      vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr,
+                           kTextures, to_transfer.data());
+      for (uint32_t t = 0; t < kTextures; ++t) {
+         VkBufferImageCopy copy{};
+         copy.bufferOffset = t * 6 * 4;
+         copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 6};
+         copy.imageExtent = {1, 1, 1};
+         vkCmdCopyBufferToImage(command, staging.buffer, images[t],
+                                VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+      }
+      std::array<VkImageMemoryBarrier, kTextures> to_sample{};
+      for (uint32_t t = 0; t < kTextures; ++t) {
+         to_sample[t] = {VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+         to_sample[t].srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+         to_sample[t].dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+         to_sample[t].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+         to_sample[t].newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+         to_sample[t].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+         to_sample[t].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+         to_sample[t].image = images[t];
+         to_sample[t].subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 6};
+      }
+      VkImageMemoryBarrier target_barrier{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+      target_barrier.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+      target_barrier.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+      target_barrier.newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      target_barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      target_barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      target_barrier.image = target;
+      target_barrier.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+      vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_PIPELINE_STAGE_ALL_GRAPHICS_BIT, 0, 0, nullptr, 0, nullptr,
+                           kTextures, to_sample.data());
+      vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                           VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, 0, 0, nullptr,
+                           0, nullptr, 1, &target_barrier);
+
+      VkRenderingAttachmentInfo color{VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+      color.imageView = target_view;
+      color.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      color.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+      color.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+      VkRenderingInfo render{VK_STRUCTURE_TYPE_RENDERING_INFO};
+      render.renderArea.extent = {64, 64};
+      render.layerCount = 1;
+      render.colorAttachmentCount = 1;
+      render.pColorAttachments = &color;
+      vkCmdBeginRendering(command, &render);
+      const VkViewport viewport{0.0f, 0.0f, 64.0f, 64.0f, 0.0f, 1.0f};
+      const VkRect2D scissor{{0, 0}, {64, 64}};
+      vkCmdSetViewport(command, 0, 1, &viewport);
+      vkCmdSetScissor(command, 0, 1, &scissor);
+      vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+      vkCmdBindDescriptorSets(command, VK_PIPELINE_BIND_POINT_GRAPHICS, layout, 0, 1,
+                              &set, 0, nullptr);
+      vkCmdDraw(command, kInvocations, 1, 0, 0);
+      vkCmdEndRendering(command);
+      VkMemoryBarrier host_barrier{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+      host_barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+      host_barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+      vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_ALL_GRAPHICS_BIT,
+                           VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &host_barrier, 0, nullptr, 0,
+                           nullptr);
+      result = vkEndCommandBuffer(command);
+      require(result == VK_SUCCESS, "end command", result);
+      VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+      submit.commandBufferCount = 1;
+      submit.pCommandBuffers = &command;
+      result = vkQueueSubmit(device_queue, 1, &submit, VK_NULL_HANDLE);
+      require(result == VK_SUCCESS, "submit", result);
+      result = vkQueueWaitIdle(device_queue);
+      require(result == VK_SUCCESS, "wait", result);
+
+      const float *values = static_cast<const float *>(outputs.mapped);
+      unsigned failures = 0;
+      for (uint32_t invocation = 0; invocation < kInvocations; ++invocation) {
+         for (uint32_t lookup = 0; lookup < kLookups; ++lookup) {
+            const uint8_t *expected = kColors[kIndices[lookup]];
+            for (uint32_t c = 0; c < 4; ++c) {
+               const float got = values[(invocation * kLookups + lookup) * 4 + c];
+               const float want = float(expected[c]) / 255.0f;
+               if (got < want - 1.0f / 512.0f || got > want + 1.0f / 512.0f) {
+                  if (failures < 16)
+                     std::fprintf(stderr,
+                                  "invocation %u lookup %u component %u: got %f expected %f\n",
+                                  invocation, lookup, c, got, want);
+                  ++failures;
+                  break;
+               }
+            }
+         }
+      }
+      require(failures == 0, "tessellation evaluation sampler array indexing");
+      std::printf("%u tessellated invocations x %u sampler lookups matched\n",
+                  kInvocations, kLookups);
+
+      vkDestroyCommandPool(device, pool, nullptr);
+      vkDestroyPipeline(device, pipeline, nullptr);
+      vkDestroyPipelineLayout(device, layout, nullptr);
+      vkDestroyDescriptorPool(device, descriptor_pool, nullptr);
+      vkDestroyDescriptorSetLayout(device, set_layout, nullptr);
+      vkDestroyImageView(device, target_view, nullptr);
+      vkDestroyImage(device, target, nullptr);
+      vkFreeMemory(device, target_memory, nullptr);
+      vkDestroySampler(device, sampler, nullptr);
+      for (uint32_t t = 0; t < kTextures; ++t) {
+         vkDestroyImageView(device, views[t], nullptr);
+         vkDestroyImage(device, images[t], nullptr);
+         vkFreeMemory(device, image_memory[t], nullptr);
+      }
+      for (const Allocation *allocation : {&indices, &inputs, &outputs, &staging}) {
+         vkUnmapMemory(device, allocation->memory);
+         vkDestroyBuffer(device, allocation->buffer, nullptr);
+         vkFreeMemory(device, allocation->memory, nullptr);
+      }
+      vkDestroyDevice(device, nullptr);
+   }
+   vkDestroyInstance(instance, nullptr);
+   return 0;
+}
