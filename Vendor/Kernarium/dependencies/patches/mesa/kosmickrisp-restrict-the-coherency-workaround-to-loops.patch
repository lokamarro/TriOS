@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: MIT
+#version 450
+layout(isolines, equal_spacing) in;
+
+layout(set = 0, binding = 0) uniform samplerCubeArray textures[8];
+
+layout(set = 0, binding = 1, std140) uniform Indices {
+   int index0;
+   int index1;
+   int index2;
+   int index3;
+};
+
+struct Inputs {
+   vec4 coords;
+};
+
+struct Outputs {
+   vec4 out0;
+   vec4 out1;
+   vec4 out2;
+   vec4 out3;
+};
+
+layout(set = 0, binding = 2, std430) buffer InBuffer { Inputs inputs[]; };
+layout(set = 0, binding = 3, std430) buffer OutBuffer { Outputs outputs[]; };
+
+void main()
+{
+   gl_Position = vec4(gl_TessCoord.x, 0.0, 0.0, 1.0);
+   uint invocationId = uint(gl_PrimitiveID) * 2u + (gl_TessCoord.x > 0.5 ? 1u : 0u);
+   vec4 coords = inputs[invocationId].coords;
+   vec4 value0 = texture(textures[index0], coords);
+   vec4 value1 = texture(textures[index1], coords);
+   vec4 value2 = texture(textures[index2], coords);
+   vec4 value3 = texture(textures[index3], coords);
+   outputs[invocationId].out0 = value0;
+   outputs[invocationId].out1 = value1;
+   outputs[invocationId].out2 = value2;
+   outputs[invocationId].out3 = value3;
+}
