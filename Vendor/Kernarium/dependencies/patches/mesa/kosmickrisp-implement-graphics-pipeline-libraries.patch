+static VkResult
+kk_compile_shaders(struct vk_device *device, uint32_t shader_count,
+                   struct vk_shader_compile_info *infos,
+                   const struct vk_graphics_pipeline_state *state,
+                   const struct vk_features *enabled_features,
+                   const VkAllocationCallbacks *pAllocator,
+                   struct vk_shader **shaders_out)
+{
+   struct kk_device *dev = container_of(device, struct kk_device, vk);
+
+   /* A pipeline library's stages keep their NIR until the final link. */
+   if (shader_count > 0 && infos[0].stage != MESA_SHADER_COMPUTE &&
+       infos[0].defer_graphics_pipeline_link) {
+      return kk_defer_graphics_shaders(dev, shader_count, infos, pAllocator,
+                                       shaders_out);
+   }
+
+   return kk_compile_shaders_impl(device, shader_count, infos, state,
+                                  enabled_features, pAllocator, shaders_out);
+}
+
+/* The compile infos of a deferred graphics chain, one stage per entry in
+ * pipeline order, from the NIR each stage retained.  On failure every NIR
+ * already deserialized is freed. */
+static VkResult
+kk_deserialize_deferred_graphics_shaders(
+   struct kk_device *dev, uint32_t count, const mesa_shader_stage *stages,
+   const struct vk_pipeline_robustness_state *const *robustness,
+   const struct blob *const *nir, uint32_t set_layout_count,
+   struct vk_descriptor_set_layout *const *set_layouts,
+   struct vk_shader_compile_info *infos)
+{
+   for (uint32_t i = 0; i < count; i++) {
+      const nir_shader_compiler_options *nir_options =
+         kk_get_nir_options(dev->vk.physical, stages[i], robustness[i]);
+      struct blob_reader reader;
+      blob_reader_init(&reader, nir[i]->data, nir[i]->size);
+      nir_shader *shader = nir_deserialize(NULL, nir_options, &reader);
+      if (shader == NULL || reader.overrun) {
+         ralloc_free(shader);
+         for (uint32_t j = 0; j < i; j++)
+            ralloc_free(infos[j].nir);
+         return vk_error(dev, VK_ERROR_INVALID_SHADER_NV);
+      }
+
+      VkShaderStageFlags next_stage = 0;
+      if (stages[i] != MESA_SHADER_FRAGMENT) {
+         next_stage = i + 1 < count ? mesa_to_vk_shader_stage(stages[i + 1])
+                                    : VK_SHADER_STAGE_FRAGMENT_BIT;
+      }
+
+      infos[i] = (struct vk_shader_compile_info) {
+         .stage = stages[i],
+         .flags = count > 1 ? VK_SHADER_CREATE_LINK_STAGE_BIT_EXT : 0,
+         .next_stage_mask = next_stage,
+         .nir = shader,
+         .robustness = robustness[i],
+         .set_layout_count = set_layout_count,
+         .set_layouts = set_layouts,
+      };
+   }
+
+   return VK_SUCCESS;
+}
+
+struct kk_linked_graphics_pipeline {
+   blake3_hash key;
+   struct kk_shader *shaders[MESA_SHADER_STAGES];
+};
+
+static void
+kk_free_linked_graphics_pipeline(
+   struct vk_device *vk_dev, void *linked_data,
+   const VkAllocationCallbacks *pAllocator)
+{
+   struct kk_device *dev = container_of(vk_dev, struct kk_device, vk);
+   struct kk_linked_graphics_pipeline *linked = linked_data;
+
+   for (uint32_t stage = 0; stage < MESA_SHADER_STAGES; stage++) {
+      if (linked->shaders[stage] != NULL)
+         kk_shader_destroy(vk_dev, linked->shaders[stage], pAllocator);
+   }
+
+   vk_free2(&dev->vk.alloc, pAllocator, linked);
+}
+
+static uint32_t
+kk_linked_graphics_pipeline_hash(const void *key)
+{
+   return _mesa_hash_data(key, sizeof(blake3_hash));
+}
+
+static bool
+kk_linked_graphics_pipeline_equal(const void *a, const void *b)
+{
+   return memcmp(a, b, sizeof(blake3_hash)) == 0;
+}
+
+VkResult
+kk_linked_graphics_pipeline_cache_init(struct kk_device *dev)
+{
+   dev->linked_graphics_pipelines = _mesa_hash_table_create(
+      NULL, kk_linked_graphics_pipeline_hash,
+      kk_linked_graphics_pipeline_equal);
+   if (dev->linked_graphics_pipelines == NULL)
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   simple_mtx_init(&dev->linked_graphics_pipelines_lock, mtx_plain);
+   return VK_SUCCESS;
+}
+
+void
+kk_linked_graphics_pipeline_cache_finish(struct kk_device *dev)
+{
+   hash_table_foreach(dev->linked_graphics_pipelines, entry) {
+      kk_free_linked_graphics_pipeline(&dev->vk, entry->data,
+                                       &dev->vk.alloc);
+   }
+   _mesa_hash_table_destroy(dev->linked_graphics_pipelines, NULL);
+   dev->linked_graphics_pipelines = NULL;
+   simple_mtx_destroy(&dev->linked_graphics_pipelines_lock);
+}
+
+static void
+kk_linked_graphics_pipeline_key(
+   struct vk_device *vk_dev, uint32_t shader_count,
+   struct vk_shader *const *shaders,
+   const struct vk_graphics_pipeline_state *state, blake3_hash key)
+{
+   struct mesa_blake3 hash;
+   _mesa_blake3_init(&hash);
+
+   VkShaderStageFlags stages = 0;
+   for (uint32_t i = 0; i < shader_count; i++) {
+      _mesa_blake3_update(&hash, &shaders[i]->stage,
+                          sizeof(shaders[i]->stage));
+      _mesa_blake3_update(&hash, shaders[i]->pipeline.cache_key,
+                          sizeof(shaders[i]->pipeline.cache_key));
+      stages |= mesa_to_vk_shader_stage(shaders[i]->stage);
+   }
+
+   blake3_hash state_key;
+   kk_hash_graphics_state(vk_dev->physical, state, &vk_dev->enabled_features,
+                          stages, state_key);
+   _mesa_blake3_update(&hash, state_key, sizeof(state_key));
+   _mesa_blake3_update(&hash, state->dynamic, sizeof(state->dynamic));
+   _mesa_blake3_update(&hash, &state->pipeline_flags,
+                       sizeof(state->pipeline_flags));
+
+   if (state->ia != NULL) {
+      _mesa_blake3_update(&hash, &state->ia->primitive_topology,
+                          sizeof(state->ia->primitive_topology));
+   }
+   if (state->cal != NULL)
+      _mesa_blake3_update(&hash, state->cal, sizeof(*state->cal));
+
+   _mesa_blake3_final(&hash, key);
+}
+
+static void
+kk_destroy_linked_graphics_pipeline(
+   UNUSED struct vk_device *vk_dev, UNUSED void *linked_data,
+   UNUSED const VkAllocationCallbacks *pAllocator)
+{
+   /* Entries remain reusable until device destruction. */
+}
+
+static VkResult
+kk_link_graphics_pipeline(
+   struct vk_device *vk_dev, VkPipelineCreateFlags2KHR pipeline_flags,
+   uint32_t shader_count, struct vk_shader *const *vk_shaders,
+   const struct vk_graphics_pipeline_state *state, uint32_t set_layout_count,
+   struct vk_descriptor_set_layout *const *set_layouts,
+   UNUSED const VkAllocationCallbacks *pAllocator, void **linked_data_out)
+{
+   struct kk_device *dev = container_of(vk_dev, struct kk_device, vk);
+   *linked_data_out = NULL;
+
+   bool has_deferred = false;
+   for (uint32_t i = 0; i < shader_count; i++) {
+      struct kk_shader *shader =
+         container_of(vk_shaders[i], struct kk_shader, vk);
+      has_deferred |= shader->info.deferred;
+   }
+
+   /* Monolithic pipelines and complete libraries already own their native
+    * Metal pipeline in the vertex shader.
+    */
+   if (!has_deferred)
+      return VK_SUCCESS;
+
+   blake3_hash key;
+   kk_linked_graphics_pipeline_key(vk_dev, shader_count, vk_shaders, state,
+                                   key);
+
+   simple_mtx_lock(&dev->linked_graphics_pipelines_lock);
+   struct hash_entry *cached =
+      _mesa_hash_table_search(dev->linked_graphics_pipelines, key);
+   if (cached != NULL) {
+      *linked_data_out = cached->data;
+      simple_mtx_unlock(&dev->linked_graphics_pipelines_lock);
+      return VK_SUCCESS;
+   }
+   simple_mtx_unlock(&dev->linked_graphics_pipelines_lock);
+
+   if (pipeline_flags &
+       VK_PIPELINE_CREATE_2_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT_KHR)
+      return VK_PIPELINE_COMPILE_REQUIRED;
+
+   struct vk_shader_compile_info infos[MESA_VK_MAX_GRAPHICS_PIPELINE_STAGES] =
+      {0};
+   struct vk_shader *compiled[MESA_VK_MAX_GRAPHICS_PIPELINE_STAGES] = {0};
+
+   mesa_shader_stage stages[MESA_VK_MAX_GRAPHICS_PIPELINE_STAGES];
+   const struct vk_pipeline_robustness_state
+      *robustness[MESA_VK_MAX_GRAPHICS_PIPELINE_STAGES];
+   const struct blob *nir[MESA_VK_MAX_GRAPHICS_PIPELINE_STAGES];
+   for (uint32_t i = 0; i < shader_count; i++) {
+      const struct kk_shader *shader =
+         container_of(vk_shaders[i], struct kk_shader, vk);
+      if (!shader->info.deferred)
+         return vk_error(dev, VK_ERROR_INVALID_SHADER_NV);
+
+      stages[i] = shader->info.stage;
+      robustness[i] = &shader->deferred_robustness;
+      nir[i] = &shader->deferred_nir;
+   }
+
+   VkResult result = kk_deserialize_deferred_graphics_shaders(
+      dev, shader_count, stages, robustness, nir, set_layout_count,
+      set_layouts, infos);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result = kk_compile_shaders_impl(
+      vk_dev, shader_count, infos, state, &vk_dev->enabled_features,
+      &dev->vk.alloc, compiled);
+   if (result != VK_SUCCESS)
+      return result;
+
+   struct kk_linked_graphics_pipeline *linked =
+      vk_zalloc(&dev->vk.alloc, sizeof(*linked), 8,
+                VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (linked == NULL) {
+      for (uint32_t i = 0; i < shader_count; i++) {
+         kk_shader_destroy(vk_dev,
+                           container_of(compiled[i], struct kk_shader, vk),
+                           &dev->vk.alloc);
+      }
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
+   memcpy(linked->key, key, sizeof(linked->key));
+
+   for (uint32_t i = 0; i < shader_count; i++) {
+      struct kk_shader *shader =
+         container_of(compiled[i], struct kk_shader, vk);
+      linked->shaders[shader->info.stage] = shader;
+   }
+
+   simple_mtx_lock(&dev->linked_graphics_pipelines_lock);
+   cached = _mesa_hash_table_search(dev->linked_graphics_pipelines, key);
+   if (cached == NULL) {
+      _mesa_hash_table_insert(dev->linked_graphics_pipelines, linked->key,
+                              linked);
+      *linked_data_out = linked;
+   } else {
+      *linked_data_out = cached->data;
+   }
+   simple_mtx_unlock(&dev->linked_graphics_pipelines_lock);
+
+   if (cached != NULL)
+      kk_free_linked_graphics_pipeline(vk_dev, linked, &dev->vk.alloc);
+
+   return VK_SUCCESS;
+}
