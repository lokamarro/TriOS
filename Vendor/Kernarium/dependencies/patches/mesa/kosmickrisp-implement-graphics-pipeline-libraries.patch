diff --git a/src/kosmickrisp/vulkan/kk_gpl.h b/src/kosmickrisp/vulkan/kk_gpl.h
new file mode 100644
index 0000000000000000000000000000000000000000..6ffdd35f9b902675129f89b523e89eb18e4726d0
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_gpl.h
@@ -0,0 +1,114 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef KK_GPL_H
+#define KK_GPL_H
+
+#include "kk_depth_clip.h"
+
+#include "vk_graphics_state.h"
+
+#include <string.h>
+
+static inline bool
+kk_graphics_state_is_complete(const struct vk_graphics_pipeline_state *state)
+{
+   if (state == NULL || state->rs == NULL || state->mv == NULL ||
+       state->rp == NULL)
+      return false;
+
+   if ((state->shader_stages & VK_SHADER_STAGE_VERTEX_BIT) &&
+       (state->vi == NULL || state->ia == NULL))
+      return false;
+
+   /* A statically-discarded pipeline has no fragment shader or fragment
+    * output interface.  Otherwise the complete render-pass attachment state
+    * arrives only after the fragment-output library has been linked.
+    */
+   if (state->rs->rasterizer_discard_enable &&
+       !BITSET_TEST(state->dynamic,
+                    MESA_VK_DYNAMIC_RS_RASTERIZER_DISCARD_ENABLE))
+      return true;
+
+   return vk_render_pass_state_has_attachment_info(state->rp);
+}
+
+static inline bool
+kk_graphics_state_has_static_depth_stencil(
+   const struct vk_graphics_pipeline_state *state)
+{
+   if (!state->ds)
+      return false;
+
+   return !(
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_DS_DEPTH_TEST_ENABLE) |
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_DS_DEPTH_WRITE_ENABLE) |
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_DS_DEPTH_COMPARE_OP) |
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_DS_STENCIL_TEST_ENABLE) |
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_DS_STENCIL_OP) |
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_DS_STENCIL_COMPARE_MASK) |
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_DS_STENCIL_WRITE_MASK));
+}
+
+/* Fragment-output identity of a graphics pipeline.  A linked pipeline library
+ * is cached device-wide under this key, so it must describe every attachment
+ * the compiled Metal pipeline and its depth-stencil state are built from.
+ */
+struct kk_fs_key {
+   VkFormat color_formats[MESA_VK_MAX_COLOR_ATTACHMENTS];
+   VkFormat depth_attachment_format;
+   VkFormat stencil_attachment_format;
+   struct vk_color_blend_state color_blend;
+   struct vk_depth_stencil_state ds;
+   uint32_t rasterization_samples;
+   uint16_t static_sample_mask;
+   uint8_t color_attachment_count;
+   bool sample_shading_enable;
+   bool alpha_to_coverage_enable;
+   bool alpha_to_one_enable;
+   enum kk_fragment_depth_clamp_mode depth_clamp_mode;
+};
+
+static inline void
+kk_populate_fs_key(struct kk_fs_key *key,
+                   const struct vk_graphics_pipeline_state *state)
+{
+   memset(key, 0, sizeof(*key));
+
+   /* Required since we [de]serialize blend, and render target swizzle for
+    * non-native formats */
+   memcpy(key->color_formats, state->rp->color_attachment_formats,
+          sizeof(key->color_formats));
+   key->color_attachment_count = state->rp->color_attachment_count;
+
+   if (kk_graphics_state_has_static_depth_stencil(state))
+      key->ds = *(state->ds);
+
+   /* Blend state gets [de]serialized, so we need to hash it */
+   if (state->cb)
+      key->color_blend = *(state->cb);
+
+   if (state->ms) {
+      key->rasterization_samples = state->ms->rasterization_samples;
+      key->static_sample_mask = state->ms->sample_mask;
+      key->sample_shading_enable = state->ms->sample_shading_enable;
+      key->alpha_to_coverage_enable = state->ms->alpha_to_coverage_enable;
+      key->alpha_to_one_enable = state->ms->alpha_to_one_enable;
+   }
+
+   /* Both depth/stencil attachment formats belong to the identity, exactly as
+    * the colour attachment formats do.  Depth writes are removed without a
+    * depth attachment, and the Metal depth-stencil state carries stencil
+    * descriptors only when a stencil attachment is bound, so a key that
+    * recorded only "some depth attachment exists" let one compilation serve
+    * both a depth-only and a depth+stencil render pass; whichever was
+    * compiled first then decided whether the other wrote stencil at all.
+    */
+   key->depth_attachment_format = state->rp->depth_attachment_format;
+   key->stencil_attachment_format = state->rp->stencil_attachment_format;
+   key->depth_clamp_mode = kk_fragment_depth_clamp_mode(state);
+}
+
+#endif /* KK_GPL_H */
