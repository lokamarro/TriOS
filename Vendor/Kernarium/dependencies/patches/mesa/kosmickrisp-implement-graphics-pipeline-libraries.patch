+ */
+
+#include "kosmickrisp/vulkan/kk_gpl.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+static void
+require(bool condition)
+{
+   if (!condition)
+      abort();
+}
+
+/* Two render passes may share one linked pipeline library only when their
+ * fragment-output keys are identical.
+ */
+static bool
+same_fragment_output(struct vk_graphics_pipeline_state *state,
+                     struct vk_render_pass_state *rp, VkFormat depth_a,
+                     VkFormat stencil_a, VkFormat depth_b, VkFormat stencil_b)
+{
+   struct kk_fs_key a, b;
+
+   rp->depth_attachment_format = depth_a;
+   rp->stencil_attachment_format = stencil_a;
+   kk_populate_fs_key(&a, state);
+
+   rp->depth_attachment_format = depth_b;
+   rp->stencil_attachment_format = stencil_b;
+   kk_populate_fs_key(&b, state);
+
+   return memcmp(&a, &b, sizeof(a)) == 0;
+}
+
+static void
+check_fragment_output_key(void)
+{
+   struct vk_rasterization_state rs = {0};
+   struct vk_multiview_state mv = {0};
+   struct vk_multisample_state ms = {
+      .rasterization_samples = VK_SAMPLE_COUNT_4_BIT,
+      .sample_mask = 0xffff,
+   };
+   /* The application state a multisampled depth/stencil pipeline sets is the
+    * same whichever aspects its render pass actually carries, so only the
+    * attachment formats can tell the two pipelines apart.
+    */
+   struct vk_depth_stencil_state ds = {
+      .depth =
+         {
+            .test_enable = true,
+            .write_enable = true,
+            .compare_op = VK_COMPARE_OP_LESS,
+         },
+      .stencil =
+         {
+            .test_enable = true,
+            .front = {.op = {.pass = VK_STENCIL_OP_REPLACE},
+                      .write_mask = 0xff},
+            .back = {.op = {.pass = VK_STENCIL_OP_REPLACE},
+                     .write_mask = 0xff},
+         },
+   };
+   struct vk_render_pass_state rp = {
+      .attachments = MESA_VK_RP_ATTACHMENT_COLOR_0_BIT |
+                     MESA_VK_RP_ATTACHMENT_DEPTH_BIT |
+                     MESA_VK_RP_ATTACHMENT_STENCIL_BIT,
+      .color_attachment_count = 1,
+      .color_attachment_formats = {VK_FORMAT_R8G8B8A8_UNORM},
+   };
+   struct vk_graphics_pipeline_state state = {
+      .shader_stages = VK_SHADER_STAGE_VERTEX_BIT |
+                       VK_SHADER_STAGE_FRAGMENT_BIT,
+      .rs = &rs,
+      .mv = &mv,
+      .ms = &ms,
+      .ds = &ds,
+      .rp = &rp,
+   };
+
+   /* A depth-only pass compiles a depth-stencil state with no stencil
+    * descriptor at all, so it must never serve a depth+stencil pass: the
+    * shared pipeline would silently stop writing stencil.
+    */
+   require(!same_fragment_output(&state, &rp, VK_FORMAT_D16_UNORM,
+                                 VK_FORMAT_UNDEFINED,
+                                 VK_FORMAT_D32_SFLOAT_S8_UINT,
+                                 VK_FORMAT_D32_SFLOAT_S8_UINT));
+   require(!same_fragment_output(&state, &rp, VK_FORMAT_D32_SFLOAT,
+                                 VK_FORMAT_UNDEFINED,
+                                 VK_FORMAT_D32_SFLOAT_S8_UINT,
+                                 VK_FORMAT_D32_SFLOAT_S8_UINT));
+
+   /* A stencil-only pass is likewise distinct from one with no depth/stencil
+    * attachment, and the concrete depth format is part of the identity.
+    */
+   require(!same_fragment_output(&state, &rp, VK_FORMAT_UNDEFINED,
+                                 VK_FORMAT_S8_UINT, VK_FORMAT_UNDEFINED,
+                                 VK_FORMAT_UNDEFINED));
+   require(!same_fragment_output(&state, &rp, VK_FORMAT_D16_UNORM,
+                                 VK_FORMAT_UNDEFINED, VK_FORMAT_D32_SFLOAT,
+                                 VK_FORMAT_UNDEFINED));
+
+   /* Equal render passes still share one compilation. */
+   require(same_fragment_output(&state, &rp, VK_FORMAT_D32_SFLOAT_S8_UINT,
+                                VK_FORMAT_D32_SFLOAT_S8_UINT,
+                                VK_FORMAT_D32_SFLOAT_S8_UINT,
+                                VK_FORMAT_D32_SFLOAT_S8_UINT));
+
+   /* The rest of the fragment-output identity is still keyed. */
+   rp.depth_attachment_format = VK_FORMAT_D32_SFLOAT_S8_UINT;
+   rp.stencil_attachment_format = VK_FORMAT_D32_SFLOAT_S8_UINT;
+   struct kk_fs_key four_samples, two_samples;
+   kk_populate_fs_key(&four_samples, &state);
+   ms.rasterization_samples = VK_SAMPLE_COUNT_2_BIT;
+   kk_populate_fs_key(&two_samples, &state);
+   require(memcmp(&four_samples, &two_samples, sizeof(four_samples)) != 0);
+}
+
+int
+main(void)
+{
+   struct vk_vertex_input_state vi = {0};
+   struct vk_input_assembly_state ia = {0};
+   struct vk_rasterization_state rs = {0};
+   struct vk_multiview_state mv = {0};
+   struct vk_render_pass_state rp = {
+      .attachments = MESA_VK_RP_ATTACHMENT_INFO_INVALID,
+   };
+   struct vk_graphics_pipeline_state state = {
+      .shader_stages = VK_SHADER_STAGE_VERTEX_BIT |
+                       VK_SHADER_STAGE_FRAGMENT_BIT,
+      .vi = &vi,
+      .ia = &ia,
+      .rs = &rs,
+      .mv = &mv,
+      .rp = &rp,
+   };
+
+   /* Pre-raster and fragment-shader libraries only carry incomplete render
+    * pass state and therefore retain preprocessed NIR for the final link.
+    */
+   require(!kk_graphics_state_is_complete(&state));
+
+   rp.attachments = MESA_VK_RP_ATTACHMENT_COLOR_0_BIT;
+   require(kk_graphics_state_is_complete(&state));
+
+   state.vi = NULL;
+   require(!kk_graphics_state_is_complete(&state));
+   state.vi = &vi;
+
+   /* Static rasterizer discard completes without a fragment-output subset. */
+   rp.attachments = MESA_VK_RP_ATTACHMENT_INFO_INVALID;
+   rs.rasterizer_discard_enable = true;
+   require(kk_graphics_state_is_complete(&state));
+
+   BITSET_SET(state.dynamic,
+              MESA_VK_DYNAMIC_RS_RASTERIZER_DISCARD_ENABLE);
+   require(!kk_graphics_state_is_complete(&state));
+
+   check_fragment_output_key();
+
