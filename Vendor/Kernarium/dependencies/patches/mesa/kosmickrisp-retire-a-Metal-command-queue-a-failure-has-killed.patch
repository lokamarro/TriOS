+   /* A timeout is the one failure the device survives, by retiring the queue
+    * that reported it. Anything else stopped the queue. */
    if (data->error != MTL_COMMAND_QUEUE_ERROR_TIMEOUT)
       return true;
 
    /* A start timestamp means Metal admitted the submission. Admitting it and
     * reporting no execution for it is the queue killing work it had already
     * taken, which is what it does to whatever is queued behind a submission
-    * that has just timed out; the queue is running, not stopped. Only a
-    * submission the queue never admitted, or one it started and abandoned
-    * without ever timestamping an end, says the queue itself stopped. */
+    * that has just timed out; the queue is retired, not lost with the
+    * device. Only a submission the queue never admitted, or one it started
+    * and abandoned without ever timestamping an end, says the queue itself
+    * stopped. */
    return !kk_queue_error_admitted_submission(data);
 }
 
