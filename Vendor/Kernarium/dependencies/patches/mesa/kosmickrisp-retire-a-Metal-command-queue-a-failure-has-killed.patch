-   ++feedback->reported;
-   simple_mtx_unlock(&feedback->signal_mutex);
+   char report[KK_QUEUE_ERROR_REPORT_SIZE];
+   const bool failed = data->error != MTL_COMMAND_QUEUE_ERROR_NONE;
+   /* A lost queue owes every signal it still holds, because it runs nothing
+    * further. A survivable failure owes only the signals ordered behind the
+    * submission it names. */
+   const bool lost = failed && kk_queue_error_is_device_lost(data);
 
-   if (data->error != MTL_COMMAND_QUEUE_ERROR_NONE) {
-      char report[KK_QUEUE_ERROR_REPORT_SIZE];
+   if (failed) {
       kk_queue_error_describe(report, sizeof(report), data);
       fprintf(stderr, "KosmicKrisp %s\n", report);
+   }
 
-      /* A lost queue owes every signal it still holds, because it runs
-       * nothing further. A survivable failure owes only the signals ordered
-       * behind the submission it names. */
-      bool lost = kk_queue_error_is_device_lost(data);
-      simple_mtx_lock(&feedback->signal_mutex);
+   /* A serial is reserved immediately before its commit, so a submission the
+    * queue is still holding always keeps this below last_serial.
+    *
+    * Publish the report together with the failure it carries. Retirement reads
+    * both under this lock and acts once the queue has failed and has answered
+    * for everything it was given, so a report published ahead of its own
+    * failure lets a failing queue look drained and healthy: it is replaced,
+    * the replacement's state is cleared, and the failure then lands on the
+    * queue that replaced it.
+    *
+    * Act on the report in the same critical section. Once the lock is
+    * dropped, the submit thread can retire a queue this report drained, clear
+    * its failures and enqueue signals on the replacement at the serial it
+    * last committed, so a sweep decided here and run after the lock would
+    * raise signals whose work the replacement has not run.
+    */
+   unsigned made_good = 0u;
+   simple_mtx_lock(&feedback->signal_mutex);
+   ++feedback->reported;
+   if (failed) {
+      /* Survived or not, a failed queue runs nothing more that can be
+       * trusted. */
       ++feedback->failures;
-      simple_mtx_unlock(&feedback->signal_mutex);
-      unsigned made_good = kk_queue_signals_make_good(
+      made_good = kk_queue_signals_make_good_locked(
          feedback, lost ? UINT64_MAX : submission->serial);
-      if (made_good)
-         fprintf(stderr,
-                 "KosmicKrisp completed %u timeline signal%s the failed "
-                 "submission owed, so its waiters do not block forever\n",
-                 made_good, made_good == 1u ? "" : "s");
-
-      /* Device teardown clears this pointer under the same lock. Never carry
-       * a Vulkan pointer outside the lock into an asynchronous callback. */
-      if (lost) {
-         simple_mtx_lock(&feedback->mutex);
-         if (feedback->device)
-            vk_device_set_lost(&feedback->device->vk, "Metal %s", report);
-         simple_mtx_unlock(&feedback->mutex);
-      }
-   } else if (p_atomic_read(&feedback->failures) > 0u) {
+   } else if (feedback->failures > 0u) {
       /* This queue processes what it is given in order, so a completion also
        * proves it went past every signal enqueued before this submission.
        * One of those still short of its value was discarded rather than run,
        * which is how the work killed behind a reported failure gets resolved
        * without a report of its own. */
-      kk_queue_signals_make_good(feedback, submission->serial - 1u);
+      kk_queue_signals_make_good_locked(feedback, submission->serial - 1u);
    } else {
       /* A completion proves every signal ordered ahead of it has run. */
-      kk_queue_signals_retire(feedback);
+      kk_queue_signals_prune_locked(feedback);
    }
+   kk_queue_resolve_if_drained_locked(feedback);
+   simple_mtx_unlock(&feedback->signal_mutex);
 
-   kk_queue_resolve_if_drained(feedback);
+   if (made_good)
+      fprintf(stderr,
+              "KosmicKrisp completed %u timeline signal%s the failed "
+              "submission owed, so its waiters do not block forever\n",
+              made_good, made_good == 1u ? "" : "s");
+
+   /* Device teardown clears this pointer under the same lock. Never carry
+    * a Vulkan pointer outside the lock into an asynchronous callback. */
+   if (lost) {
+      simple_mtx_lock(&feedback->mutex);
+      if (feedback->device)
+         vk_device_set_lost(&feedback->device->vk, "Metal %s", report);
+      simple_mtx_unlock(&feedback->mutex);
+   }
 
    if (feedback->submit_timing) {
       /* These host-second timestamps cover the entire committed Metal batch.
@@ -393,6 +483,13 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
    if (vk_queue_is_lost(&queue->vk))
       return VK_ERROR_DEVICE_LOST;
 
+   /* A queue Metal has already failed accepts work and runs none of it, so it
