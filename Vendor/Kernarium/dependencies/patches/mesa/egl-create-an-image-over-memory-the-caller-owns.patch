index 96713679a2314c0d2e506fe4fab54b03554f096f..1ff5a43b8c3f176d3828d6d777e7b32ad2044fea 100644
--- a/src/gallium/frontends/dri/dri_util.h
+++ b/src/gallium/frontends/dri/dri_util.h
@@ -294,6 +294,11 @@ dri_create_image_with_modifiers(struct dri_screen *screen,
                                  const uint64_t *modifiers,
                                  unsigned int modifiers_count,
                                  void *loaderPrivate);
+PUBLIC struct dri_image *
+dri_create_image_from_host_pointer(struct dri_screen *screen,
+                                   void *host_pointer, uint64_t size,
+                                   int width, int height, int fourcc,
+                                   unsigned pitch, unsigned offset);
 PUBLIC int
 dri_query_compatible_render_only_device_fd(int kms_only_fd);
 
