+static inline uint
+libkk_primitive_count(enum mesa_prim prim, uint vertices,
+                      uint verts_per_patch)
+{
+   return prim == MESA_PRIM_PATCHES
+             ? vertices / verts_per_patch
+             : poly_decomposed_prims_for_vertices_u32(prim, vertices);
+}
+
+KERNEL(1)
+libkk_increment_ia(global uint32_t *ia_vertices,
+                   global uint32_t *ia_primitives,
+                   global uint32_t *vs_invocations,
+                   global uint32_t *c_prims, global uint32_t *c_invs,
+                   constant uint32_t *draw, enum mesa_prim prim,
+                   unsigned verts_per_patch, uint32_t view_count)
+{
+   uint64_t instances = (uint64_t)draw[1] * view_count;
+   poly_increment_counters(ia_vertices, vs_invocations, NULL,
+                            (uint64_t)draw[0] * instances);
+   poly_increment_counters(
+      ia_primitives, c_prims, c_invs,
+      (uint64_t)libkk_primitive_count(prim, draw[0], verts_per_patch) * instances);
+}
+
+KERNEL(256)
+libkk_increment_ia_restart(global uint32_t *ia_vertices,
+                           global uint32_t *ia_primitives,
+                           global uint32_t *vs_invocations,
+                           global uint32_t *c_prims,
+                           global uint32_t *c_invs,
+                           constant uint32_t *draw, uint64_t index_buffer,
+                           uint32_t index_buffer_range_el,
+                           uint32_t restart_index, uint32_t index_size_B,
+                           enum mesa_prim prim, unsigned verts_per_patch,
+                           uint32_t view_count)
+{
+   uint tid = cl_local_id.x;
+   uint count = draw[0];
+   if (count == 0 || draw[1] == 0)
+      return;
+
+   /* Each lane summarizes a contiguous range. Only its first and final run
+    * can meet a neighboring lane's run. Combining 256 such summaries is
+    * bounded work, even for an indirect draw with billions of indices. */
+   uint begin = ((uint64_t)count * tid) / 256;
+   uint end = ((uint64_t)count * (tid + 1)) / 256;
+   uint run = 0, prefix = 0, vertices = 0, primitives = 0;
+   bool first_run = true;
+   for (uint i = begin; i < end; i++) {
+      uint index = poly_load_index(index_buffer, index_buffer_range_el,
+                                   draw[2] + i, index_size_B);
+      if (index != restart_index) {
+         run++;
+         vertices++;
+      } else {
+         if (first_run)
+            prefix = run;
+         first_run = false;
+         primitives += libkk_primitive_count(prim, run, verts_per_patch);
+         run = 0;
+      }
+   }
+   if (first_run)
+      prefix = run;
+   primitives += libkk_primitive_count(prim, run, verts_per_patch);
+
+   local uint4 summaries[256];
+   summaries[tid] = (uint4)(vertices, primitives, prefix, run);
+   barrier(CLK_LOCAL_MEM_FENCE);
+
+   if (tid == 0) {
+      uint total_vertices = 0, total_primitives = 0, previous_run = 0;
+      for (uint lane = 0; lane < 256; lane++) {
+         uint4 summary = summaries[lane];
+         uint chunk_begin = ((uint64_t)count * lane) / 256;
+         uint chunk_end = ((uint64_t)count * (lane + 1)) / 256;
+         total_vertices += summary.x;
+         total_primitives += summary.y;
+         total_primitives +=
+            libkk_primitive_count(prim, previous_run + summary.z,
+                                   verts_per_patch) -
+            libkk_primitive_count(prim, previous_run, verts_per_patch) -
+            libkk_primitive_count(prim, summary.z, verts_per_patch);
+         previous_run = summary.x == chunk_end - chunk_begin
+                           ? previous_run + summary.w : summary.w;
+      }
+
+      uint64_t instances = (uint64_t)draw[1] * view_count;
+      poly_increment_counters(ia_vertices, vs_invocations, NULL,
+                               (uint64_t)total_vertices * instances);
+      poly_increment_counters(ia_primitives, c_prims, c_invs,
+                               (uint64_t)total_primitives * instances);
+   }
+}
 
