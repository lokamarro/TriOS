 libkk_zero_indirect_grid(global uint32_t *grid)
@@ -362,7 +462,10 @@ libkk_line_raster_setup_indirect(
 }
 
 KERNEL(1024)
-libkk_prefix_sum_tess(global struct poly_tess_params *p)
+libkk_prefix_sum_tess(global struct poly_tess_params *p,
+                      global uint32_t *c_prims,
+                      global uint32_t *c_invs,
+                      uint32_t increment_stats)
 {
    local uint scratch[32];
    poly_prefix_sum(scratch, p->counts, p->nr_patches, 1 /* words */,
@@ -392,4 +495,12 @@ libkk_prefix_sum_tess(global struct poly_tess_params *p)
    desc[2] = alloc_B / elsize_B; /* start */
    desc[3] = 0;                  /* index_bias */
    desc[4] = 0;                  /* start_instance */
+
+   if (increment_stats) {
+      uint prims = p->points_mode ? total
+                   : p->isolines  ? (total / 2)
+                                  : (total / 3);
+
+      poly_increment_counters(c_prims, c_invs, NULL, prims);
+   }
 }
