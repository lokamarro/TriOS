--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/statistics_shaders/streams.geom
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: MIT
+#version 450
+layout(points, invocations = 2) in;
+layout(points, max_vertices = 3) out;
+void main()
+{
+   gl_Position = vec4(0.0, 0.0, 0.0, 1.0);
+   gl_PointSize = 1.0;
+   EmitStreamVertex(0);
+   for (int i = 0; i < 2; i++) {
+      gl_Position = vec4(0.0, 0.0, 0.0, 1.0);
+      gl_PointSize = 1.0;
+      EmitStreamVertex(1);
+   }
+}
