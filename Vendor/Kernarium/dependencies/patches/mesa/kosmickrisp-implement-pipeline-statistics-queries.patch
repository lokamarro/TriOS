+/* A pipeline-statistics query active in a recording: where its report is
+ * and which statistics it counts. */
+struct kk_statistics_query {
+   uint64_t report;
+   VkQueryPipelineStatisticFlags statistics;
+};
+
+/* Pipeline statistics count into an interval block: each statistic at its
+ * fixed slot, for as long as one set of queries is active.  Beginning or
+ * ending a statistics query closes an interval that anything counted into,
+ * adding it into the report of every query that was active through it, so
+ * any number of queries can overlap, two counting the same statistic
+ * included.  Vulkan forbids two active queries of one type
+ * (VUID-vkCmdBeginQuery-queryPool-01922), but Zink begins one per GL target
+ * and relies on drivers tolerating it.
+ *
+ * A resolve goes out the way an availability write does.  During a render
+ * pass that is the post-render encoder, so it follows every draw of the pass
+ * that counted into the interval and precedes anything recorded later.  A
+ * host polling availability could see a word written in the same encoder
+ * before the counts a resolve adds, so a statistics query publishes its
+ * availability once that encoder has ended, as a timestamp does; copies and
+ * resets land what is pending first. */
+static void
+kk_close_statistics_interval(struct kk_cmd_buffer *cmd)
+{
+   if (!cmd->state.statistics_interval_used)
+      return;
+
+   util_dynarray_foreach(&cmd->statistics_queries, struct kk_statistics_query,
+                         query) {
+      libkk_resolve_statistics(cmd, kk_grid_1d(1), !cmd->gfx.encoder,
+                               query->report, cmd->state.statistics_interval,
+                               query->statistics);
+   }
+   cmd->state.statistics_interval = 0;
+   cmd->state.statistics_interval_used = false;
+}
+
+/* Points every draw and dispatch at the interval block, opening a fresh one
+ * if the active queries need it, and enables what they count. */
+static void
+kk_update_statistics_root(struct kk_cmd_buffer *cmd)
+{
+   VkQueryPipelineStatisticFlags statistics = 0;
+   util_dynarray_foreach(&cmd->statistics_queries, struct kk_statistics_query,
+                         query)
+      statistics |= query->statistics;
+
+   if (statistics && !cmd->state.statistics_interval) {
+      const uint32_t size = KK_PIPELINE_STATISTICS_COUNT * sizeof(uint64_t);
+      struct kk_ptr interval = kk_pool_alloc(cmd, size, 8u);
+      if (interval.gpu) {
+         memset(interval.cpu, 0, size);
+         cmd->state.statistics_interval = interval.gpu;
+      } else {
+         /* The recording has failed. Count nothing rather than near null. */
+         statistics = 0;
+      }
+   }
+
+   struct kk_descriptor_state *states[] = {
+      &cmd->state.gfx.descriptors,
+      &cmd->state.cs.descriptors,
+   };
+   for (uint32_t i = 0; i < ARRAY_SIZE(states); ++i) {
+      struct kk_root_descriptor_table *root = &states[i]->root;
+      if (root->pipeline_stats != cmd->state.statistics_interval ||
+          root->pipeline_stats_flags != statistics) {
+         root->pipeline_stats = cmd->state.statistics_interval;
+         root->pipeline_stats_flags = statistics;
+         states[i]->root_dirty = true;
+      }
+   }
+}
+
+/* Makes an ended statistics query available once the encoder that would
+ * have resolved into it has ended. */
+static void
+kk_publish_statistics_query(struct kk_cmd_buffer *cmd,
+                            struct kk_query_pool *pool, uint32_t query)
+{
+   const bool pre_gfx = !cmd->gfx.encoder;
+   /* The recording has failed if no encoder opens. */
+   if (!cs_get_compute(cmd, pre_gfx))
+      return;
+
+   struct kk_encoder_state *es = pre_gfx ? cmd->pre_gfx : cmd->post_gfx;
+   const struct kk_ts_resolve publish = {
+      .availability = mtl_retain(pool->bo->map),
+      .availability_offset = (uint64_t)query * sizeof(uint32_t),
+      .availability_count = 1u,
+   };
+   util_dynarray_append(&es->ts_resolves, publish);
+}
