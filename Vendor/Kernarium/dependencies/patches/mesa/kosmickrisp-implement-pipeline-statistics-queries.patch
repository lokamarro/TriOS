@@ -0,0 +1,7 @@
+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+cd -- "$(dirname -- "$0")"
+for shader in fullscreen.vert count.frag streams.geom; do
+   glslc -O --target-env=vulkan1.3 -mfmt=c "$shader" -o "$shader.h"
+done
diff --git a/src/kosmickrisp/vulkan/tests/statistics_shaders/streams.geom b/src/kosmickrisp/vulkan/tests/statistics_shaders/streams.geom
