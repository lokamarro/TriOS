+/* Add one to the 64-bit counter at address when count holds, with 32-bit
+ * atomics: the low word takes the increment and carries into the high word
+ * when it wraps. This inserts control flow, so a pass that uses it preserves
+ * no metadata. */
+static void
+kk_nir_count_u64(nir_builder *b, nir_def *address, nir_def *count)
+{
+   nir_push_if(b, count);
+   nir_def *previous = nir_global_atomic(
+      b, 32, address, nir_imm_int(b, 1), .atomic_op = nir_atomic_op_iadd);
+   nir_push_if(b, nir_ieq_imm(b, previous, UINT32_MAX));
+   nir_global_atomic(b, 32, nir_iadd_imm(b, address, sizeof(uint32_t)),
+                     nir_imm_int(b, 1), .atomic_op = nir_atomic_op_iadd);
+   nir_pop_if(b, NULL);
+   nir_pop_if(b, NULL);
