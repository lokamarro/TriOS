    *address = value;
 }
 
+KERNEL(1)
+libkk_increment_statistic(global uint32_t *statistic, uint64_t delta)
+{
+   poly_atomic_add_u64(statistic, delta);
+}
+
+KERNEL(1)
+libkk_increment_cs_invocations(global uint *grid,
+                               global uint32_t *statistic,
+                               uint32_t local_size_threads)
+{
+   poly_atomic_add_u64(statistic,
+                        (uint64_t)local_size_threads * grid[0] * grid[1] * grid[2]);
+}
+
+/* Adds a pipeline-statistics interval, which holds each statistic at the
+ * index of its bit, into a query's report, which holds the statistics the
+ * query counts in ascending bit order. */
+KERNEL(1)
+libkk_resolve_statistics(global uint32_t *report, global uint64_t *interval,
+                         uint32_t statistics)
+{
+   for (uint32_t bits = statistics; bits != 0; bits &= bits - 1) {
+      poly_atomic_add_u64(report, interval[ctz(bits)]);
+      report += 2;
+   }
+}
