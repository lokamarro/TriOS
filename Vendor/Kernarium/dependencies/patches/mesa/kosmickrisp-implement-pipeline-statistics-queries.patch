+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef KK_PIPELINE_STATISTICS_H
+#define KK_PIPELINE_STATISTICS_H 1
+
+#include "util/bitscan.h"
+
+#include <assert.h>
+#include <stdint.h>
+
+/* Pipeline statistics count into an interval block that holds each statistic
+ * at a fixed slot, the index of its VkQueryPipelineStatisticFlagBits bit, so
+ * one block counts for every query active through it, whatever statistics
+ * each counts. These are the statistics up to compute shader invocations. */
+#define KK_PIPELINE_STATISTICS_COUNT 11
+
+/* The offset of a statistic's slot in an interval block. */
+static inline uint32_t
+kk_pipeline_stat_offset(uint32_t stat)
+{
+   assert(util_bitcount(stat) == 1);
+   return (ffs(stat) - 1) * sizeof(uint64_t);
+}
+
+static inline uint64_t
+kk_pipeline_stat_addr_for_flags(uint64_t base, uint32_t flags, uint32_t stat)
+{
+   assert(util_bitcount(stat) == 1);
+   if (!(flags & stat))
+      return 0;
+
+   return base + kk_pipeline_stat_offset(stat);
+}
+
+#endif /* KK_PIPELINE_STATISTICS_H */
