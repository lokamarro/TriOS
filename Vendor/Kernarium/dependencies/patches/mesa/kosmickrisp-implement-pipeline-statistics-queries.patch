index 415776344eb730514d1e97aeacd14821752ad124..b3f40aab031d50e5143965b27288234a03f4fe80 100644
--- a/src/kosmickrisp/compiler/msl_iomap.c
+++ b/src/kosmickrisp/compiler/msl_iomap.c
@@ -8,6 +8,7 @@
  * model of I/O to the Metal one. */
 
 #include "msl_private.h"
+#include "nir_to_msl.h"
 
 #include "nir_builder.h"
 
@@ -414,6 +415,29 @@ msl_nir_gather_io_info(nir_builder *b, nir_intrinsic_instr *intrin, void *data)
    return false;
 }
 
+unsigned
+msl_fs_varying_components(nir_shader *shader)
+{
+   assert(shader->info.stage == MESA_SHADER_FRAGMENT);
+
+   struct io_slot_info inputs[NUM_TOTAL_VARYING_SLOTS] = {};
+   struct io_slot_info outputs[NUM_TOTAL_VARYING_SLOTS] = {};
+   struct gather_ctx gather_ctx = {
+      .input = inputs,
+      .output = outputs,
+   };
+   nir_shader_intrinsics_pass(shader, msl_nir_gather_io_info, nir_metadata_all,
+                              &gather_ctx);
+
+   unsigned components = 0u;
+   for (unsigned location = 0u; location < NUM_TOTAL_VARYING_SLOTS;
+        ++location) {
+      if (VARYING_SLOT_INFO[location].user)
+         components += inputs[location].num_components;
+   }
+   return components;
+}
+
