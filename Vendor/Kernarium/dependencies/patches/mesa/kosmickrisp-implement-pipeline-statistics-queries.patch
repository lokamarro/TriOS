+static void
+kk_cmd_begin_end_statistics_query(struct kk_cmd_buffer *cmd,
+                                  struct kk_query_pool *pool, uint32_t query,
+                                  bool end)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   const struct kk_statistics_query statistics_query = {
+      .report = kk_query_report_addr(dev, pool, query),
+      .statistics = pool->vk.pipeline_statistics,
+   };
+   assert(statistics_query.statistics <
+          BITFIELD_BIT(KK_PIPELINE_STATISTICS_COUNT));
+
+   kk_close_statistics_interval(cmd);
+
+   if (end) {
+      util_dynarray_foreach(&cmd->statistics_queries,
+                            struct kk_statistics_query, active) {
+         if (active->report == statistics_query.report) {
+            *active = util_dynarray_pop(&cmd->statistics_queries,
+                                        struct kk_statistics_query);
+            break;
+         }
+      }
+   } else {
+      struct kk_statistics_query *active = util_dynarray_grow(
+         &cmd->statistics_queries, struct kk_statistics_query, 1);
+      if (active)
+         *active = statistics_query;
+      else
+         vk_command_buffer_set_error(&cmd->vk, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
+   kk_update_statistics_root(cmd);
+
+   if (end)
+      kk_publish_statistics_query(cmd, pool, query);
+}
