+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+cd -- "$(dirname -- "$0")"
+for shader in pdc.vert pdc.frag pdc_read.comp; do
+   glslc -O --target-env=vulkan1.3 -mfmt=c "$shader" -o "$shader.h"
+done
diff --git a/src/kosmickrisp/vulkan/tests/post_depth_coverage_shaders/pdc.frag b/src/kosmickrisp/vulkan/tests/post_depth_coverage_shaders/pdc.frag
new file mode 100644
index 0000000000000000000000000000000000000000..fe7f9663b1b27d623602535cb2f571c318b81cde
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/post_depth_coverage_shaders/pdc.frag
@@ -0,0 +1,12 @@
+#version 460
+/* SPDX-License-Identifier: MIT */
+#extension GL_ARB_post_depth_coverage : enable
+layout (post_depth_coverage) in;
+layout (location=0) out vec4 fragColor;
+/* One channel per sample, so a sample of the colour attachment reports the
+ * whole mask the invocation that wrote it received. */
+void main (void) {
+    int mask = gl_SampleMaskIn[0];
+    fragColor = vec4(float(mask & 1), float((mask >> 1) & 1),
+                     float((mask >> 2) & 1), float((mask >> 3) & 1));
+}
