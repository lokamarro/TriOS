+#version 460
+/* SPDX-License-Identifier: MIT */
+layout (local_size_x = 4) in;
+layout (set=0, binding=0) uniform sampler2DMS samples;
+layout (set=0, binding=1) buffer ResultBlock { uvec4 value[4]; } result;
+void main (void) {
+    uint sample_index = gl_LocalInvocationID.x;
+    vec4 texel = texelFetch(samples, ivec2(0, 0), int(sample_index));
+    result.value[sample_index] = uvec4(round(texel * 255.0));
+}
