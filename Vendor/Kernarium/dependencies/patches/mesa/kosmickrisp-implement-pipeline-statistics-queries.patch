diff --git a/src/kosmickrisp/vulkan/tests/test_max_varyings.cpp b/src/kosmickrisp/vulkan/tests/test_max_varyings.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e1c257b6196e45dcae4a84a517a5fabf70963070
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_max_varyings.cpp
@@ -0,0 +1,552 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* A pipeline that declares as many varying components as the device
+ * advertises has to compile and deliver every one of them.  Each case here
+ * declares min(maxXOutputComponents / 4 - 1, maxFragmentInputComponents / 4)
+ * flat ivec4 varyings between the last pre-rasterization stage and the
+ * fragment shader, the way the conformance suite's max_varyings group does,
+ * and renders a full screen quad whose fragment shader turns green only when
+ * every component arrived intact.  The vertex, tessellation-evaluation and
+ * geometry producers are all covered because the emulated stages carry their
+ * varyings through a different record layout than the native vertex stage.
+ */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+static void require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (!ok) {
+      std::fprintf(stderr, "%s: %d\n", operation, value);
+      std::exit(1);
+   }
+}
+
+template <typename T> static T load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+#define LOAD_D(name)                                                             \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+
+static const uint32_t vertex_spirv[] =
+#include "max_varyings_shaders/max_varyings.vert.h"
+;
+static const uint32_t vertex_passthrough_spirv[] =
+#include "max_varyings_shaders/max_varyings_passthrough.vert.h"
+;
+static const uint32_t fragment_spirv[] =
+#include "max_varyings_shaders/max_varyings.frag.h"
+;
+static const uint32_t tess_control_spirv[] =
+#include "max_varyings_shaders/max_varyings.tesc.h"
+;
+static const uint32_t tess_eval_spirv[] =
+#include "max_varyings_shaders/max_varyings.tese.h"
+;
+static const uint32_t geometry_spirv[] =
+#include "max_varyings_shaders/max_varyings.geom.h"
+;
+
+enum producer {
+   PRODUCER_VERTEX,
+   PRODUCER_TESS_EVAL,
+   PRODUCER_GEOMETRY,
+};
+
+int main()
+{
+   std::setvbuf(stdout, nullptr, _IONBF, 0);
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+   app.pApplicationName = "max-varyings";
+   app.apiVersion = VK_API_VERSION_1_3;
+   VkInstanceCreateInfo instance_info{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+   instance_info.pApplicationInfo = &app;
+   auto result = vkCreateInstance(&instance_info, nullptr, &instance);
+   require(result == VK_SUCCESS, "create instance", result);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceProperties);
+   LOAD_I(vkGetPhysicalDeviceFeatures);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   uint32_t physical_count = 0;
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, nullptr);
+   require(result == VK_SUCCESS && physical_count, "physical device count",
+           result);
+   std::vector<VkPhysicalDevice> physicals(physical_count);
+   result = vkEnumeratePhysicalDevices(instance, &physical_count,
+                                       physicals.data());
+   require(result == VK_SUCCESS, "physical devices", result);
+
+   constexpr uint32_t extent = 32;
+   constexpr VkFormat color_format = VK_FORMAT_R8G8B8A8_UNORM;
+
+   for (VkPhysicalDevice physical : physicals) {
+      VkPhysicalDeviceProperties properties{};
+      vkGetPhysicalDeviceProperties(physical, &properties);
+      VkPhysicalDeviceFeatures features{};
+      vkGetPhysicalDeviceFeatures(physical, &features);
+      require(features.tessellationShader && features.geometryShader &&
+                 features.pipelineStatisticsQuery,
+              "tessellation, geometry and pipeline statistics");
+
+      uint32_t queue_count = 0;
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, nullptr);
+      std::vector<VkQueueFamilyProperties> queues(queue_count);
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count,
+                                               queues.data());
+      uint32_t queue = 0;
+      while (queue < queue_count &&
+             !(queues[queue].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+         ++queue;
+      require(queue < queue_count, "graphics queue");
+      float priority = 1.0f;
+      VkDeviceQueueCreateInfo queue_info{
+         VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+      queue_info.queueFamilyIndex = queue;
+      queue_info.queueCount = 1;
+      queue_info.pQueuePriorities = &priority;
+      VkPhysicalDeviceFeatures enabled{};
+      enabled.tessellationShader = VK_TRUE;
+      enabled.geometryShader = VK_TRUE;
+      /* Every conformance run enables this, and it is what makes the driver
+       * compile a second, instrumented variant of every graphics pipeline. */
+      enabled.pipelineStatisticsQuery = features.pipelineStatisticsQuery;
+      VkPhysicalDeviceVulkan13Features features13{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+      features13.dynamicRendering = VK_TRUE;
+      VkDeviceCreateInfo device_info{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+      device_info.pNext = &features13;
+      device_info.queueCreateInfoCount = 1;
+      device_info.pQueueCreateInfos = &queue_info;
+      device_info.pEnabledFeatures = &enabled;
+      VkDevice device = VK_NULL_HANDLE;
+      result = vkCreateDevice(physical, &device_info, nullptr, &device);
+      require(result == VK_SUCCESS, "create device", result);
+      LOAD_D(vkDestroyDevice);
+      LOAD_D(vkCreateShaderModule);
+      LOAD_D(vkDestroyShaderModule);
+      LOAD_D(vkCreatePipelineLayout);
+      LOAD_D(vkDestroyPipelineLayout);
+      LOAD_D(vkCreateGraphicsPipelines);
+      LOAD_D(vkDestroyPipeline);
+      LOAD_D(vkCreateCommandPool);
+      LOAD_D(vkDestroyCommandPool);
+      LOAD_D(vkResetCommandPool);
+      LOAD_D(vkAllocateCommandBuffers);
+      LOAD_D(vkBeginCommandBuffer);
+      LOAD_D(vkEndCommandBuffer);
+      LOAD_D(vkCmdBeginRendering);
+      LOAD_D(vkCmdEndRendering);
+      LOAD_D(vkCmdBindPipeline);
+      LOAD_D(vkCmdBindVertexBuffers);
+      LOAD_D(vkCmdDraw);
+      LOAD_D(vkGetDeviceQueue);
+      LOAD_D(vkQueueSubmit);
+      LOAD_D(vkCreateFence);
+      LOAD_D(vkDestroyFence);
+      LOAD_D(vkWaitForFences);
+      LOAD_D(vkCreateImage);
+      LOAD_D(vkDestroyImage);
+      LOAD_D(vkCreateImageView);
+      LOAD_D(vkDestroyImageView);
+      LOAD_D(vkGetImageMemoryRequirements);
+      LOAD_D(vkCreateBuffer);
+      LOAD_D(vkDestroyBuffer);
+      LOAD_D(vkGetBufferMemoryRequirements);
+      LOAD_D(vkAllocateMemory);
+      LOAD_D(vkFreeMemory);
+      LOAD_D(vkBindImageMemory);
+      LOAD_D(vkBindBufferMemory);
+      LOAD_D(vkMapMemory);
+      LOAD_D(vkCmdPipelineBarrier);
+      LOAD_D(vkCmdCopyImageToBuffer);
+      VkQueue device_queue = VK_NULL_HANDLE;
+      vkGetDeviceQueue(device, queue, 0, &device_queue);
+
+      VkPhysicalDeviceMemoryProperties memory_properties{};
+      vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+      auto pick_memory = [&](uint32_t bits, VkMemoryPropertyFlags flags) {
+         uint32_t type = 0;
+         while (type < memory_properties.memoryTypeCount &&
+                (!(bits & (1u << type)) ||
+                 (memory_properties.memoryTypes[type].propertyFlags & flags) !=
+                    flags))
+            ++type;
+         require(type < memory_properties.memoryTypeCount, "memory type");
+         return type;
+      };
+
+      VkImageCreateInfo image_info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+      image_info.imageType = VK_IMAGE_TYPE_2D;
+      image_info.format = color_format;
+      image_info.extent = {extent, extent, 1};
+      image_info.mipLevels = 1;
+      image_info.arrayLayers = 1;
+      image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+      image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+      image_info.usage =
+         VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+      VkImage color_image = VK_NULL_HANDLE;
+      result = vkCreateImage(device, &image_info, nullptr, &color_image);
+      require(result == VK_SUCCESS, "create image", result);
+      VkMemoryRequirements image_requirements{};
+      vkGetImageMemoryRequirements(device, color_image, &image_requirements);
+      VkMemoryAllocateInfo image_memory_info{
+         VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+      image_memory_info.allocationSize = image_requirements.size;
+      image_memory_info.memoryTypeIndex =
+         pick_memory(image_requirements.memoryTypeBits, 0);
+      VkDeviceMemory color_memory = VK_NULL_HANDLE;
+      result =
+         vkAllocateMemory(device, &image_memory_info, nullptr, &color_memory);
+      require(result == VK_SUCCESS, "allocate image", result);
+      result = vkBindImageMemory(device, color_image, color_memory, 0);
+      require(result == VK_SUCCESS, "bind image", result);
+      VkImageViewCreateInfo view_info{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+      view_info.image = color_image;
+      view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+      view_info.format = color_format;
+      view_info.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+      VkImageView color_view = VK_NULL_HANDLE;
+      result = vkCreateImageView(device, &view_info, nullptr, &color_view);
+      require(result == VK_SUCCESS, "create view", result);
+
+      auto make_buffer = [&](VkDeviceSize size, VkBufferUsageFlags usage,
+                             VkBuffer *buffer, VkDeviceMemory *memory,
+                             void **mapped) {
+         VkBufferCreateInfo buffer_info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+         buffer_info.size = size;
+         buffer_info.usage = usage;
+         result = vkCreateBuffer(device, &buffer_info, nullptr, buffer);
+         require(result == VK_SUCCESS, "create buffer", result);
+         VkMemoryRequirements requirements{};
+         vkGetBufferMemoryRequirements(device, *buffer, &requirements);
+         VkMemoryAllocateInfo memory_info{
+            VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+         memory_info.allocationSize = requirements.size;
+         memory_info.memoryTypeIndex =
+            pick_memory(requirements.memoryTypeBits,
+                        VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                           VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+         result = vkAllocateMemory(device, &memory_info, nullptr, memory);
+         require(result == VK_SUCCESS, "allocate buffer", result);
+         result = vkBindBufferMemory(device, *buffer, *memory, 0);
+         require(result == VK_SUCCESS, "bind buffer", result);
+         result = vkMapMemory(device, *memory, 0, VK_WHOLE_SIZE, 0, mapped);
+         require(result == VK_SUCCESS, "map buffer", result);
+      };
+
+      const VkDeviceSize readback_size = VkDeviceSize(extent) * extent * 4;
+      VkBuffer readback = VK_NULL_HANDLE;
+      VkDeviceMemory readback_memory = VK_NULL_HANDLE;
+      void *readback_data = nullptr;
+      make_buffer(readback_size, VK_BUFFER_USAGE_TRANSFER_DST_BIT, &readback,
+                  &readback_memory, &readback_data);
+
+      /* Two triangles covering the whole render area, the same six vertices
+       * the conformance suite draws. */
+      const float vertices[6][4] = {
+         {-1.0f, -1.0f, 0.0f, 1.0f}, {-1.0f, 1.0f, 0.0f, 1.0f},
+         {1.0f, 1.0f, 0.0f, 1.0f},   {-1.0f, -1.0f, 0.0f, 1.0f},
+         {1.0f, -1.0f, 0.0f, 1.0f},  {1.0f, 1.0f, 0.0f, 1.0f},
+      };
+      VkBuffer vertex_buffer = VK_NULL_HANDLE;
+      VkDeviceMemory vertex_memory = VK_NULL_HANDLE;
+      void *vertex_data = nullptr;
+      make_buffer(sizeof(vertices), VK_BUFFER_USAGE_VERTEX_BUFFER_BIT,
+                  &vertex_buffer, &vertex_memory, &vertex_data);
+      std::memcpy(vertex_data, vertices, sizeof(vertices));
+
+      VkPipelineLayoutCreateInfo layout_info{
+         VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+      VkPipelineLayout layout = VK_NULL_HANDLE;
+      result = vkCreatePipelineLayout(device, &layout_info, nullptr, &layout);
+      require(result == VK_SUCCESS, "create layout", result);
+
+      auto make_module = [&](const uint32_t *code, size_t size) {
+         VkShaderModuleCreateInfo module_info{
+            VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+         module_info.codeSize = size;
+         module_info.pCode = code;
+         VkShaderModule module = VK_NULL_HANDLE;
+         result = vkCreateShaderModule(device, &module_info, nullptr, &module);
+         require(result == VK_SUCCESS, "create module", result);
+         return module;
+      };
+      VkShaderModule vertex_module =
+         make_module(vertex_spirv, sizeof(vertex_spirv));
+      VkShaderModule vertex_passthrough_module =
+         make_module(vertex_passthrough_spirv, sizeof(vertex_passthrough_spirv));
+      VkShaderModule fragment_module =
+         make_module(fragment_spirv, sizeof(fragment_spirv));
+      VkShaderModule tess_control_module =
+         make_module(tess_control_spirv, sizeof(tess_control_spirv));
+      VkShaderModule tess_eval_module =
+         make_module(tess_eval_spirv, sizeof(tess_eval_spirv));
+      VkShaderModule geometry_module =
+         make_module(geometry_spirv, sizeof(geometry_spirv));
+
+      const VkViewport viewport{0.0f, 0.0f, float(extent), float(extent), 0.0f,
+                                1.0f};
+      const VkRect2D scissor{{0, 0}, {extent, extent}};
+
+      VkCommandPoolCreateInfo pool_info{
+         VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+      pool_info.queueFamilyIndex = queue;
+      VkCommandPool pool = VK_NULL_HANDLE;
+      result = vkCreateCommandPool(device, &pool_info, nullptr, &pool);
+      require(result == VK_SUCCESS, "create command pool", result);
+      VkCommandBufferAllocateInfo allocate{
+         VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+      allocate.commandPool = pool;
+      allocate.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+      allocate.commandBufferCount = 1;
+      VkCommandBuffer command = VK_NULL_HANDLE;
+      result = vkAllocateCommandBuffers(device, &allocate, &command);
+      require(result == VK_SUCCESS, "allocate command", result);
+
+      /* Renders one producer stage at the widest varying count the device
+       * claims to carry.  Returns 0 when every pixel came out green, 1 when
+       * the pipeline could not be built, and 2 when the image is wrong. */
+      auto run = [&](producer stage, int32_t data) {
+         VkSpecializationMapEntry entry{0u, 0u, sizeof(data)};
+         VkSpecializationInfo specialization{1u, &entry, sizeof(data), &data};
+
+         VkPipelineShaderStageCreateInfo stages[4]{};
+         uint32_t stage_count = 0;
+         auto add_stage = [&](VkShaderStageFlagBits bit, VkShaderModule module,
+                              bool specialize) {
+            VkPipelineShaderStageCreateInfo &info = stages[stage_count++];
+            info.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+            info.stage = bit;
+            info.module = module;
+            info.pName = "main";
+            info.pSpecializationInfo = specialize ? &specialization : nullptr;
+         };
+         add_stage(VK_SHADER_STAGE_VERTEX_BIT,
+                   stage == PRODUCER_VERTEX ? vertex_module
+                                            : vertex_passthrough_module,
+                   stage == PRODUCER_VERTEX);
+         if (stage == PRODUCER_TESS_EVAL) {
+            add_stage(VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT,
+                      tess_control_module, false);
+            add_stage(VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT,
+                      tess_eval_module, true);
+         } else if (stage == PRODUCER_GEOMETRY) {
+            add_stage(VK_SHADER_STAGE_GEOMETRY_BIT, geometry_module, true);
+         }
+         add_stage(VK_SHADER_STAGE_FRAGMENT_BIT, fragment_module, true);
+
+         const VkVertexInputBindingDescription binding{
+            0u, uint32_t(sizeof(float) * 4), VK_VERTEX_INPUT_RATE_VERTEX};
+         const VkVertexInputAttributeDescription attribute{
+            0u, 0u, VK_FORMAT_R32G32B32A32_SFLOAT, 0u};
+         VkPipelineVertexInputStateCreateInfo vi{
+            VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+         vi.vertexBindingDescriptionCount = 1;
+         vi.pVertexBindingDescriptions = &binding;
+         vi.vertexAttributeDescriptionCount = 1;
+         vi.pVertexAttributeDescriptions = &attribute;
+         VkPipelineInputAssemblyStateCreateInfo ia{
+            VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+         ia.topology = stage == PRODUCER_TESS_EVAL
+                          ? VK_PRIMITIVE_TOPOLOGY_PATCH_LIST
+                          : VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+         VkPipelineTessellationStateCreateInfo ts{
+            VK_STRUCTURE_TYPE_PIPELINE_TESSELLATION_STATE_CREATE_INFO};
+         ts.patchControlPoints = 3;
+         VkPipelineViewportStateCreateInfo vp{
+            VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+         vp.viewportCount = 1;
+         vp.pViewports = &viewport;
+         vp.scissorCount = 1;
+         vp.pScissors = &scissor;
+         VkPipelineRasterizationStateCreateInfo rs{
+            VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+         rs.polygonMode = VK_POLYGON_MODE_FILL;
+         rs.cullMode = VK_CULL_MODE_NONE;
+         rs.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+         rs.lineWidth = 1.0f;
+         VkPipelineMultisampleStateCreateInfo ms{
+            VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+         ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+         VkPipelineDepthStencilStateCreateInfo ds{
+            VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+         VkPipelineColorBlendAttachmentState blend_attachment{};
+         blend_attachment.colorWriteMask = 0xf;
+         VkPipelineColorBlendStateCreateInfo blend{
+            VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+         blend.attachmentCount = 1;
+         blend.pAttachments = &blend_attachment;
+         VkPipelineRenderingCreateInfo rendering{
+            VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+         rendering.colorAttachmentCount = 1;
+         rendering.pColorAttachmentFormats = &color_format;
+         VkGraphicsPipelineCreateInfo pipeline_info{
+            VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+         pipeline_info.pNext = &rendering;
+         pipeline_info.stageCount = stage_count;
+         pipeline_info.pStages = stages;
+         pipeline_info.pVertexInputState = &vi;
+         pipeline_info.pInputAssemblyState = &ia;
+         pipeline_info.pTessellationState = &ts;
+         pipeline_info.pViewportState = &vp;
+         pipeline_info.pRasterizationState = &rs;
+         pipeline_info.pMultisampleState = &ms;
+         pipeline_info.pDepthStencilState = &ds;
+         pipeline_info.pColorBlendState = &blend;
+         pipeline_info.layout = layout;
+         VkPipeline pipeline = VK_NULL_HANDLE;
+         result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
+                                            &pipeline_info, nullptr, &pipeline);
+         if (result != VK_SUCCESS) {
+            std::printf("  pipeline creation failed: %d\n", result);
+            return 1;
+         }
+
+         result = vkResetCommandPool(device, pool, 0);
+         require(result == VK_SUCCESS, "reset command pool", result);
+         VkCommandBufferBeginInfo begin{
+            VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+         begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+         result = vkBeginCommandBuffer(command, &begin);
+         require(result == VK_SUCCESS, "begin command", result);
+
+         VkRenderingAttachmentInfo color_attachment{
+            VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+         color_attachment.imageView = color_view;
+         color_attachment.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+         color_attachment.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+         color_attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+         color_attachment.clearValue.color.float32[3] = 1.0f;
+         VkRenderingInfo render_info{VK_STRUCTURE_TYPE_RENDERING_INFO};
+         render_info.renderArea = scissor;
+         render_info.layerCount = 1;
+         render_info.colorAttachmentCount = 1;
+         render_info.pColorAttachments = &color_attachment;
+         vkCmdBeginRendering(command, &render_info);
+         vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+         VkDeviceSize offset = 0;
+         vkCmdBindVertexBuffers(command, 0, 1, &vertex_buffer, &offset);
+         vkCmdDraw(command, 6, 1, 0, 0);
+         vkCmdEndRendering(command);
+
+         VkImageMemoryBarrier to_source{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+         to_source.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+         to_source.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+         to_source.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+         to_source.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+         to_source.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+         to_source.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+         to_source.image = color_image;
+         to_source.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+         vkCmdPipelineBarrier(command,
+                              VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                              VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0,
+                              nullptr, 1, &to_source);
+         VkBufferImageCopy region{};
+         region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+         region.imageExtent = {extent, extent, 1};
+         vkCmdCopyImageToBuffer(command, color_image,
+                                VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, readback,
+                                1, &region);
+         result = vkEndCommandBuffer(command);
+         require(result == VK_SUCCESS, "end command", result);
+
+         VkFenceCreateInfo fence_info{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+         VkFence fence = VK_NULL_HANDLE;
+         result = vkCreateFence(device, &fence_info, nullptr, &fence);
+         require(result == VK_SUCCESS, "create fence", result);
+         VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+         submit.commandBufferCount = 1;
+         submit.pCommandBuffers = &command;
+         result = vkQueueSubmit(device_queue, 1, &submit, fence);
+         require(result == VK_SUCCESS, "submit command", result);
+         result = vkWaitForFences(device, 1, &fence, VK_TRUE, 20000000000ull);
+         require(result == VK_SUCCESS, "draw retired", result);
+         vkDestroyFence(device, fence, nullptr);
+         vkDestroyPipeline(device, pipeline, nullptr);
+
+         const auto *pixels = static_cast<const uint8_t *>(readback_data);
+         uint32_t wrong = 0;
+         for (VkDeviceSize p = 0; p < readback_size; p += 4) {
+            if (pixels[p + 0] > 5 || pixels[p + 1] < 250)
+               ++wrong;
+         }
+         if (wrong) {
+            std::printf("  %u of %u pixels are not green (first %u,%u,%u,%u)\n",
+                        wrong, uint32_t(readback_size / 4), pixels[0], pixels[1],
+                        pixels[2], pixels[3]);
+            return 2;
+         }
+         return 0;
+      };
+
+      struct Case {
+         const char *name;
+         producer stage;
+         uint32_t output_components;
+      };
+      const Case cases[] = {
+         {"vertex to fragment", PRODUCER_VERTEX,
+          properties.limits.maxVertexOutputComponents},
+         {"tessellation evaluation to fragment", PRODUCER_TESS_EVAL,
+          properties.limits.maxTessellationEvaluationOutputComponents},
+         {"geometry to fragment", PRODUCER_GEOMETRY,
+          properties.limits.maxGeometryOutputComponents},
+      };
+      bool failed = false;
+      for (const Case &test : cases) {
+         /* The producer spends four of its components on gl_Position. */
+         const int32_t produced = int32_t(test.output_components / 4) - 1;
+         const int32_t consumed =
+            int32_t(properties.limits.maxFragmentInputComponents / 4);
+         const int32_t data = produced < consumed ? produced : consumed;
+         require(data > 0, "advertised varying components");
+         std::printf("%s: %d components (%d varyings)\n", test.name, data * 4,
+                     data);
+         if (run(test.stage, data) != 0)
+            failed = true;
+      }
+      require(!failed, "every advertised varying component survives");
+      std::printf("all advertised varying components arrive intact\n");
+
+      vkDestroyCommandPool(device, pool, nullptr);
+      for (VkShaderModule module :
+           {vertex_module, vertex_passthrough_module, fragment_module,
+            tess_control_module, tess_eval_module, geometry_module})
+         vkDestroyShaderModule(device, module, nullptr);
+      vkDestroyPipelineLayout(device, layout, nullptr);
+      vkDestroyBuffer(device, vertex_buffer, nullptr);
+      vkFreeMemory(device, vertex_memory, nullptr);
+      vkDestroyBuffer(device, readback, nullptr);
+      vkFreeMemory(device, readback_memory, nullptr);
+      vkDestroyImageView(device, color_view, nullptr);
+      vkDestroyImage(device, color_image, nullptr);
+      vkFreeMemory(device, color_memory, nullptr);
+      vkDestroyDevice(device, nullptr);
+   }
+   vkDestroyInstance(instance, nullptr);
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_pipeline_statistics.c b/src/kosmickrisp/vulkan/tests/test_pipeline_statistics.c
new file mode 100644
index 0000000000000000000000000000000000000000..55257b636929c5aef00d92efea0cd2755a013491
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_pipeline_statistics.c
@@ -0,0 +1,49 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kosmickrisp/vulkan/kk_pipeline_statistics.h"
+
+#include <vulkan/vulkan_core.h>
+
+#include <assert.h>
+
+static const VkQueryPipelineStatisticFlagBits statistics[] = {
+   VK_QUERY_PIPELINE_STATISTIC_INPUT_ASSEMBLY_VERTICES_BIT,
+   VK_QUERY_PIPELINE_STATISTIC_INPUT_ASSEMBLY_PRIMITIVES_BIT,
+   VK_QUERY_PIPELINE_STATISTIC_VERTEX_SHADER_INVOCATIONS_BIT,
+   VK_QUERY_PIPELINE_STATISTIC_GEOMETRY_SHADER_INVOCATIONS_BIT,
+   VK_QUERY_PIPELINE_STATISTIC_GEOMETRY_SHADER_PRIMITIVES_BIT,
+   VK_QUERY_PIPELINE_STATISTIC_CLIPPING_INVOCATIONS_BIT,
+   VK_QUERY_PIPELINE_STATISTIC_CLIPPING_PRIMITIVES_BIT,
+   VK_QUERY_PIPELINE_STATISTIC_FRAGMENT_SHADER_INVOCATIONS_BIT,
+   VK_QUERY_PIPELINE_STATISTIC_TESSELLATION_CONTROL_SHADER_PATCHES_BIT,
+   VK_QUERY_PIPELINE_STATISTIC_TESSELLATION_EVALUATION_SHADER_INVOCATIONS_BIT,
+   VK_QUERY_PIPELINE_STATISTIC_COMPUTE_SHADER_INVOCATIONS_BIT,
+};
+
+static_assert(ARRAY_SIZE(statistics) == KK_PIPELINE_STATISTICS_COUNT,
+              "an interval block holds every statistic");
+
+int
+main(void)
+{
+   /* Each statistic has its own slot in an interval block, the same whatever
+    * else the mask enables, so overlapping queries can share one block. */
+   const uint64_t base = 0x100000;
+   for (uint32_t mask = 0; mask < BITFIELD_BIT(ARRAY_SIZE(statistics));
+        mask++) {
+      for (uint32_t i = 0; i < ARRAY_SIZE(statistics); i++) {
+         const VkQueryPipelineStatisticFlagBits statistic = statistics[i];
+         assert(statistic == BITFIELD_BIT(i));
+         const uint64_t expected =
+            (mask & statistic) ? base + i * sizeof(uint64_t) : 0;
+
+         assert(kk_pipeline_stat_addr_for_flags(base, mask, statistic) ==
+                expected);
+      }
+   }
+
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_pipeline_statistics_gpu.c b/src/kosmickrisp/vulkan/tests/test_pipeline_statistics_gpu.c
new file mode 100644
index 0000000000000000000000000000000000000000..edb8932ef7c11470bbeb3023d2e32c5f23cd3be4
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_pipeline_statistics_gpu.c
@@ -0,0 +1,922 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* These tests use private query storage only to seed counters near overflow
+ * and launch the production helpers directly. No test hook is linked into the
+ * provider. Rendering and query retrieval use ordinary Vulkan entry points. */
+#include "kosmickrisp/vulkan/kk_bo.h"
+#include "kosmickrisp/vulkan/kk_cmd_buffer.h"
+#include "kosmickrisp/vulkan/kk_device.h"
+#include "kosmickrisp/vulkan/kk_entrypoints.h"
+#include "kosmickrisp/vulkan/kk_query_pool.h"
+#include "kosmickrisp/vulkan/kk_shader.h"
+
+#include <inttypes.h>
+#include <stdlib.h>
+
+#define CHECK(expr) do { \
+   VkResult result_ = (expr); \
+   if (result_ != VK_SUCCESS) { \
+      fprintf(stderr, "%s:%d: %s = %d\n", __FILE__, __LINE__, #expr, result_); \
+      abort(); \
+   } \
+} while (0)
+
+enum { REPORTS = 11, QUERY_COUNT = 32 };
+
+struct context {
+   VkDevice device;
+   VkDevice query_disabled_device;
+   VkQueue queue;
+   VkCommandPool commands;
+   VkCommandBuffer command;
+   VkQueryPool queries;
+   const struct vk_device_dispatch_table *api;
+   VkPhysicalDeviceMemoryProperties memory;
+};
+
+static void
+begin(struct context *ctx)
+{
+   const VkCommandBufferBeginInfo info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+   };
+   CHECK(ctx->api->BeginCommandBuffer(ctx->command, &info));
+}
+
+static void
+submit_without_wait(struct context *ctx)
+{
+   CHECK(ctx->api->EndCommandBuffer(ctx->command));
+   const VkSubmitInfo info = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &ctx->command,
+   };
+   CHECK(ctx->api->QueueSubmit(ctx->queue, 1, &info, VK_NULL_HANDLE));
+}
+
+static void
+submit(struct context *ctx)
+{
+   submit_without_wait(ctx);
+   CHECK(ctx->api->QueueWaitIdle(ctx->queue));
+}
+
+static uint64_t
+seed_query(struct context *ctx, uint32_t query, uint64_t seed)
+{
+   struct kk_query_pool *pool = kk_query_pool_from_handle(ctx->queries);
+   uint64_t *values = (void *)((char *)pool->bo->cpu + pool->query_start +
+                              query * pool->query_stride);
+   for (uint32_t i = 0; i < REPORTS; i++)
+      values[i] = seed;
+   return pool->bo->gpu + pool->query_start + query * pool->query_stride;
+}
+
+static void
+check_queries(struct context *ctx, uint32_t first, uint32_t count,
+               uint64_t expected[][REPORTS])
+{
+   uint64_t values[QUERY_COUNT][REPORTS + 1];
+   memset(values, 0xa5, sizeof(values));
+   CHECK(ctx->api->GetQueryPoolResults(
+      ctx->device, ctx->queries, first, count, sizeof(values), values,
+      sizeof(values[0]), VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT |
+                            VK_QUERY_RESULT_WITH_AVAILABILITY_BIT));
+   for (uint32_t q = 0; q < count; q++) {
+      assert(values[q][REPORTS] == 1);
+      for (uint32_t i = 0; i < REPORTS; i++) {
+         if (values[q][i] != expected[q][i]) {
+            fprintf(stderr, "query %u counter %u: expected %" PRIu64
+                            ", got %" PRIu64 "\n",
+                    first + q, i, expected[q][i], values[q][i]);
+            abort();
+         }
+      }
+   }
+}
+
+static void
+test_helpers(struct context *ctx)
+{
+   ctx->api->ResetQueryPool(ctx->device, ctx->queries, 0, QUERY_COUNT);
+   begin(ctx);
+   struct kk_cmd_buffer *cmd = kk_cmd_buffer_from_handle(ctx->command);
+   const uint64_t seed = UINT64_C(0x12345678fffffff1);
+   uint64_t expected[QUERY_COUNT][REPORTS];
+   for (uint32_t q = 0; q < QUERY_COUNT; q++)
+      for (uint32_t i = 0; i < REPORTS; i++)
+         expected[q][i] = seed;
+
+   uint64_t address = seed_query(ctx, 0, seed);
+   ctx->api->CmdBeginQuery(ctx->command, ctx->queries, 0, 0);
+   /* Independent workgroups concurrently carry into the same high word. */
+   const uint64_t delta = UINT64_C(0x100000003);
+   libkk_increment_statistic(cmd, kk_grid_1d(4096), true, address, delta);
+   expected[0][0] += 4096 * delta;
+   ctx->api->CmdEndQuery(ctx->command, ctx->queries, 0);
+
+   address = seed_query(ctx, 1, seed);
+   const uint32_t groups[] = {65535, 65535, 3};
+   struct kk_ptr grid = kk_pool_upload(cmd, groups, sizeof(groups), 4);
+   ctx->api->CmdBeginQuery(ctx->command, ctx->queries, 1, 0);
+   libkk_increment_cs_invocations(cmd, kk_grid_1d(1), true, grid.gpu,
+                                   address + 10 * sizeof(uint64_t), 1024);
+   expected[1][10] += UINT64_C(1024) * 65535 * 65535 * 3;
+   ctx->api->CmdEndQuery(ctx->command, ctx->queries, 1);
+
+   address = seed_query(ctx, 2, seed);
+   const uint32_t large_draw[] = {0xfffffff7u, 3, 0, 0};
+   struct kk_ptr draw = kk_pool_upload(cmd, large_draw, sizeof(large_draw), 4);
+   ctx->api->CmdBeginQuery(ctx->command, ctx->queries, 2, 0);
+   libkk_increment_ia(cmd, kk_grid_1d(1), true, address, address + 8,
+                      address + 16, address + 48, address + 40, draw.gpu,
+                      MESA_PRIM_TRIANGLES, 3, 5);
+   expected[2][0] += UINT64_C(0xfffffff7) * 15;
+   expected[2][2] = expected[2][0];
+   expected[2][1] += (UINT64_C(0xfffffff7) / 3) * 15;
+   expected[2][5] = expected[2][6] = expected[2][1];
+   ctx->api->CmdEndQuery(ctx->command, ctx->queries, 2);
+
+   uint32_t indices[19019];
+   for (uint32_t i = 0; i < ARRAY_SIZE(indices); i++)
+      indices[i] = i % 137 == 0 || i % 71 == 0 ? UINT32_MAX : i;
+   struct kk_ptr index = kk_pool_upload(cmd, indices, sizeof(indices), 4);
+   const uint32_t restart_draw[] = {19003, 7, 13, 0, 0};
+   draw = kk_pool_upload(cmd, restart_draw, sizeof(restart_draw), 4);
+   const enum mesa_prim topologies[] = {
+      MESA_PRIM_POINTS, MESA_PRIM_LINES, MESA_PRIM_LINE_STRIP,
+      MESA_PRIM_TRIANGLES, MESA_PRIM_TRIANGLE_STRIP, MESA_PRIM_TRIANGLE_FAN,
+      MESA_PRIM_LINES_ADJACENCY, MESA_PRIM_LINE_STRIP_ADJACENCY,
+      MESA_PRIM_TRIANGLES_ADJACENCY, MESA_PRIM_TRIANGLE_STRIP_ADJACENCY,
+      MESA_PRIM_PATCHES,
+   };
+   for (uint32_t t = 0; t < ARRAY_SIZE(topologies); t++) {
+      uint32_t q = 3 + t;
+      address = seed_query(ctx, q, seed);
+      ctx->api->CmdBeginQuery(ctx->command, ctx->queries, q, 0);
+      libkk_increment_ia_restart(
+         cmd, kk_grid_1d(256), true, address, address + 8, address + 16,
+         address + 48, address + 40, draw.gpu, index.gpu, ARRAY_SIZE(indices),
+         UINT32_MAX, sizeof(uint32_t), topologies[t], 3, 2);
+      uint64_t vertices = 0, primitives = 0;
+      uint32_t run = 0;
+      for (uint32_t i = 0; i <= restart_draw[0]; i++) {
+         if (i == restart_draw[0] || indices[restart_draw[2] + i] == UINT32_MAX) {
+            primitives += poly_decomposed_prims_for_vertices_with_tess(
+               topologies[t], run, 3);
+            run = 0;
+         } else {
+            run++;
+            vertices++;
+         }
+      }
+      expected[q][0] += vertices * 14;
+      expected[q][2] = expected[q][0];
+      expected[q][1] += primitives * 14;
+      expected[q][5] = expected[q][6] = expected[q][1];
+      ctx->api->CmdEndQuery(ctx->command, ctx->queries, q);
+   }
+   submit(ctx);
+   check_queries(ctx, 0, 3 + ARRAY_SIZE(topologies), expected);
+}
+
+static void
+test_empty_multiview(struct context *ctx)
+{
+   ctx->api->ResetQueryPool(ctx->device, ctx->queries, 0, QUERY_COUNT);
+   uint64_t unavailable[REPORTS + 1];
+   memset(unavailable, 0xa5, sizeof(unavailable));
+   assert(ctx->api->GetQueryPoolResults(
+      ctx->device, ctx->queries, 0, 1, sizeof(unavailable), unavailable,
+      sizeof(unavailable), VK_QUERY_RESULT_64_BIT |
+                              VK_QUERY_RESULT_WITH_AVAILABILITY_BIT) == VK_NOT_READY);
+   assert(unavailable[0] == UINT64_C(0xa5a5a5a5a5a5a5a5));
+   assert(unavailable[REPORTS] == 0);
+   seed_query(ctx, 1, UINT64_MAX);
+   seed_query(ctx, 2, UINT64_MAX);
+   begin(ctx);
+   const VkRenderingInfo rendering = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+      .renderArea = {{0, 0}, {16, 16}},
+      .layerCount = 1,
+      .viewMask = 0x85,
+   };
+   ctx->api->CmdBeginRendering(ctx->command, &rendering);
+   ctx->api->CmdBeginQuery(ctx->command, ctx->queries, 0, 0);
+   assert(kk_cmd_buffer_from_handle(ctx->command)->gfx.encoder == NULL);
+   ctx->api->CmdEndQuery(ctx->command, ctx->queries, 0);
+   ctx->api->CmdEndRendering(ctx->command);
+   submit_without_wait(ctx);
+   uint64_t expected[3][REPORTS] = {0};
+   check_queries(ctx, 0, 3, expected);
+   CHECK(ctx->api->QueueWaitIdle(ctx->queue));
+}
+
+static void
+test_fragment_invocations(struct context *ctx)
+{
+   const VkBufferCreateInfo buffer_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = 3 * sizeof(uint32_t),
+      .usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+   };
+   VkBuffer buffer;
+   CHECK(ctx->api->CreateBuffer(ctx->device, &buffer_info, NULL, &buffer));
+   VkMemoryRequirements requirements;
+   ctx->api->GetBufferMemoryRequirements(ctx->device, buffer, &requirements);
+   uint32_t type = 0;
+   const uint32_t flags = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                          VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+   while (type < ctx->memory.memoryTypeCount &&
+          (!(requirements.memoryTypeBits & BITFIELD_BIT(type)) ||
+           (ctx->memory.memoryTypes[type].propertyFlags & flags) != flags))
+      type++;
+   assert(type < ctx->memory.memoryTypeCount);
+   const VkMemoryAllocateInfo memory_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = requirements.size,
+      .memoryTypeIndex = type,
+   };
+   VkDeviceMemory memory;
+   CHECK(ctx->api->AllocateMemory(ctx->device, &memory_info, NULL, &memory));
+   CHECK(ctx->api->BindBufferMemory(ctx->device, buffer, memory, 0));
+   uint32_t *invocations;
+   CHECK(ctx->api->MapMemory(ctx->device, memory, 0, VK_WHOLE_SIZE, 0,
+                             (void **)&invocations));
+
+   const VkDescriptorSetLayoutBinding binding = {
+      .binding = 0,
+      .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+      .descriptorCount = 1,
+      .stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT,
+   };
+   const VkDescriptorSetLayoutCreateInfo set_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+      .bindingCount = 1,
+      .pBindings = &binding,
+   };
+   VkDescriptorSetLayout set_layout;
+   CHECK(ctx->api->CreateDescriptorSetLayout(ctx->device, &set_info, NULL,
+                                              &set_layout));
+   const VkDescriptorPoolSize pool_size = {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1};
+   const VkDescriptorPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+      .maxSets = 1,
+      .poolSizeCount = 1,
+      .pPoolSizes = &pool_size,
+   };
+   VkDescriptorPool descriptors;
+   CHECK(ctx->api->CreateDescriptorPool(ctx->device, &pool_info, NULL, &descriptors));
+   const VkDescriptorSetAllocateInfo set_allocation = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+      .descriptorPool = descriptors,
+      .descriptorSetCount = 1,
+      .pSetLayouts = &set_layout,
+   };
+   VkDescriptorSet set;
+   CHECK(ctx->api->AllocateDescriptorSets(ctx->device, &set_allocation, &set));
+   const VkDescriptorBufferInfo buffer_descriptor = {buffer, 0, VK_WHOLE_SIZE};
+   const VkWriteDescriptorSet write = {
+      .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+      .dstSet = set,
+      .descriptorCount = 1,
+      .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+      .pBufferInfo = &buffer_descriptor,
+   };
+   ctx->api->UpdateDescriptorSets(ctx->device, 1, &write, 0, NULL);
+   const VkPushConstantRange push = {VK_SHADER_STAGE_FRAGMENT_BIT, 0, 4};
+   const VkPipelineLayoutCreateInfo layout_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+      .setLayoutCount = 1,
+      .pSetLayouts = &set_layout,
+      .pushConstantRangeCount = 1,
+      .pPushConstantRanges = &push,
+   };
+   VkPipelineLayout layout;
+   CHECK(ctx->api->CreatePipelineLayout(ctx->device, &layout_info, NULL, &layout));
+   static const uint32_t vertex[] =
+#include "statistics_shaders/fullscreen.vert.h"
+   ;
+   static const uint32_t fragment[] =
+#include "statistics_shaders/count.frag.h"
+   ;
+   static const uint32_t geometry[] =
+#include "statistics_shaders/streams.geom.h"
+   ;
+   VkShaderModule modules[3];
+   const uint32_t *codes[] = {vertex, fragment, geometry};
+   const size_t sizes[] = {sizeof(vertex), sizeof(fragment), sizeof(geometry)};
+   const VkShaderStageFlagBits stage_bits[] = {
+      VK_SHADER_STAGE_VERTEX_BIT, VK_SHADER_STAGE_FRAGMENT_BIT,
+      VK_SHADER_STAGE_GEOMETRY_BIT,
+   };
+   VkPipelineShaderStageCreateInfo stages[3];
+   for (unsigned i = 0; i < 3; i++) {
+      const VkShaderModuleCreateInfo module_info = {
+         .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+         .codeSize = sizes[i],
+         .pCode = codes[i],
+      };
+      CHECK(ctx->api->CreateShaderModule(ctx->device, &module_info, NULL, &modules[i]));
+      stages[i] = (VkPipelineShaderStageCreateInfo){
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+         .stage = stage_bits[i],
+         .module = modules[i],
+         .pName = "main",
+      };
+   }
+   const VkPipelineVertexInputStateCreateInfo vi = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO,
+   };
+   VkPipelineInputAssemblyStateCreateInfo ia = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+      .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
+   };
+   const VkViewport viewport = {0, 0, 32, 32, 0, 1};
+   const VkRect2D scissor = {{0, 0}, {32, 32}};
+   const VkPipelineViewportStateCreateInfo vp = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+      .viewportCount = 1,
+      .pViewports = &viewport,
+      .scissorCount = 1,
+      .pScissors = &scissor,
+   };
+   VkPipelineRasterizationStateStreamCreateInfoEXT stream = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_STREAM_CREATE_INFO_EXT,
+   };
+   VkPipelineRasterizationStateCreateInfo rs = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+      .pNext = &stream,
+      .lineWidth = 1.0f,
+   };
+   VkPipelineMultisampleStateCreateInfo ms = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+   };
+   const VkPipelineColorBlendStateCreateInfo cb = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+   };
+   const VkPipelineRenderingCreateInfo rendering = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO,
+   };
+   VkGraphicsPipelineCreateInfo pipeline_info = {
+      .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO,
+      .pNext = &rendering,
+      .stageCount = 2,
+      .pStages = stages,
+      .pVertexInputState = &vi,
+      .pInputAssemblyState = &ia,
+      .pViewportState = &vp,
+      .pRasterizationState = &rs,
+      .pMultisampleState = &ms,
+      .pColorBlendState = &cb,
+      .layout = layout,
+   };
+
+   /* Cache blobs are portable across devices with different enabled
+    * features. A query-disabled executable has no instrumentation and
+    * cannot satisfy a query-enabled pipeline lookup. */
+   const struct vk_device_dispatch_table *off_api =
+      &kk_device_from_handle(ctx->query_disabled_device)->exposed_dispatch_table;
+   VkDescriptorSetLayout off_set_layout;
+   CHECK(off_api->CreateDescriptorSetLayout(ctx->query_disabled_device,
+                                              &set_info, NULL, &off_set_layout));
+   VkPipelineLayoutCreateInfo off_layout_info = layout_info;
+   off_layout_info.pSetLayouts = &off_set_layout;
+   VkPipelineLayout off_layout;
+   CHECK(off_api->CreatePipelineLayout(ctx->query_disabled_device,
+                                         &off_layout_info, NULL, &off_layout));
+   VkPipelineShaderStageCreateInfo off_stages[2];
+   memcpy(off_stages, stages, sizeof(off_stages));
+   for (unsigned i = 0; i < 2; i++) {
+      const VkShaderModuleCreateInfo info = {
+         .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+         .codeSize = sizes[i],
+         .pCode = codes[i],
+      };
+      CHECK(off_api->CreateShaderModule(ctx->query_disabled_device, &info, NULL,
+                                          &off_stages[i].module));
+   }
+   VkPipelineCacheCreateInfo cache_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO,
+   };
+   VkPipelineCache off_cache;
+   CHECK(off_api->CreatePipelineCache(ctx->query_disabled_device, &cache_info,
+                                        NULL, &off_cache));
+   VkGraphicsPipelineCreateInfo off_pipeline_info = pipeline_info;
+   off_pipeline_info.layout = off_layout;
+   off_pipeline_info.pStages = off_stages;
+   ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+   VkPipeline off_pipeline;
+   CHECK(off_api->CreateGraphicsPipelines(ctx->query_disabled_device, off_cache,
+                                            1, &off_pipeline_info, NULL, &off_pipeline));
+   size_t cache_size;
+   CHECK(off_api->GetPipelineCacheData(ctx->query_disabled_device, off_cache,
+                                         &cache_size, NULL));
+   void *cache_bytes = malloc(cache_size);
+   assert(cache_bytes);
+   CHECK(off_api->GetPipelineCacheData(ctx->query_disabled_device, off_cache,
+                                         &cache_size, cache_bytes));
+   cache_info.initialDataSize = cache_size;
+   cache_info.pInitialData = cache_bytes;
+   VkPipelineCache cache;
+   CHECK(ctx->api->CreatePipelineCache(ctx->device, &cache_info, NULL, &cache));
+   free(cache_bytes);
+   off_api->DestroyPipeline(ctx->query_disabled_device, off_pipeline, NULL);
+   off_api->DestroyPipelineCache(ctx->query_disabled_device, off_cache, NULL);
+   for (unsigned i = 0; i < 2; i++)
+      off_api->DestroyShaderModule(ctx->query_disabled_device, off_stages[i].module, NULL);
+   off_api->DestroyPipelineLayout(ctx->query_disabled_device, off_layout, NULL);
+   off_api->DestroyDescriptorSetLayout(ctx->query_disabled_device, off_set_layout, NULL);
+
+   pipeline_info.flags = VK_PIPELINE_CREATE_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT;
+   VkPipeline must_compile = VK_NULL_HANDLE;
+   assert(ctx->api->CreateGraphicsPipelines(ctx->device, cache, 1, &pipeline_info,
+                                             NULL, &must_compile) == VK_PIPELINE_COMPILE_REQUIRED);
+   pipeline_info.flags = 0;
+   for (unsigned scenario = 0; scenario < 6; scenario++) {
+      const bool gs = scenario >= 2;
+      const bool discard = scenario >= 4;
+      stream.rasterizationStream = gs ? scenario % 2 : 0;
+      rs.rasterizerDiscardEnable = discard;
+      pipeline_info.stageCount = gs ? 3 : 2;
+      ia.topology = gs ? VK_PRIMITIVE_TOPOLOGY_POINT_LIST
+                      : VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+      ms.rasterizationSamples = !gs && scenario ? VK_SAMPLE_COUNT_4_BIT
+                                               : VK_SAMPLE_COUNT_1_BIT;
+      VkPipeline pipeline;
+      CHECK(ctx->api->CreateGraphicsPipelines(ctx->device, cache, 1,
+                                                &pipeline_info, NULL, &pipeline));
+      /* A serialized cache must reconstruct the same guarded executable,
+       * including its native state, without a fresh shader compilation. */
+      size_t size;
+      CHECK(ctx->api->GetPipelineCacheData(ctx->device, cache, &size, NULL));
+      void *bytes = malloc(size);
+      assert(bytes);
+      CHECK(ctx->api->GetPipelineCacheData(ctx->device, cache, &size, bytes));
+      const VkPipelineCacheCreateInfo reload_info = {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO,
+         .initialDataSize = size,
+         .pInitialData = bytes,
+      };
+      VkPipelineCache reloaded_cache;
+      CHECK(ctx->api->CreatePipelineCache(ctx->device, &reload_info, NULL,
+                                            &reloaded_cache));
+      free(bytes);
+      pipeline_info.flags = VK_PIPELINE_CREATE_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT;
+      VkPipeline reloaded_pipeline;
+      CHECK(ctx->api->CreateGraphicsPipelines(ctx->device, reloaded_cache, 1,
+                                                &pipeline_info, NULL,
+                                                &reloaded_pipeline));
+      pipeline_info.flags = 0;
+      ctx->api->DestroyPipeline(ctx->device, pipeline, NULL);
+      ctx->api->DestroyPipelineCache(ctx->device, cache, NULL);
+      pipeline = reloaded_pipeline;
+      cache = reloaded_cache;
+
+      ctx->api->ResetQueryPool(ctx->device, ctx->queries, 0, QUERY_COUNT);
+      const uint64_t seed = UINT64_C(0x12345678fffffff1);
+      seed_query(ctx, 0, seed);
+      memset(invocations, 0, buffer_info.size);
+      begin(ctx);
+      const VkRenderingInfo draw_rendering = {
+         .sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+         .renderArea = scissor,
+         .layerCount = 1,
+      };
+      ctx->api->CmdBeginRendering(ctx->command, &draw_rendering);
+      ctx->api->CmdBindPipeline(ctx->command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+      ctx->api->CmdBindDescriptorSets(ctx->command, VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                       layout, 0, 1, &set, 0, NULL);
+      struct kk_cmd_buffer *cmd = kk_cmd_buffer_from_handle(ctx->command);
+      struct kk_shader *bound[MESA_SHADER_STAGES];
+      memcpy(bound, cmd->state.gfx.bound_shaders, sizeof(bound));
+      for (uint32_t draw = 0; draw < 3; draw++) {
+         if (draw == 1)
+            ctx->api->CmdBeginQuery(ctx->command, ctx->queries, 0, 0);
+         ctx->api->CmdPushConstants(ctx->command, layout, VK_SHADER_STAGE_FRAGMENT_BIT,
+                                      0, sizeof(draw), &draw);
+         ctx->api->CmdDraw(ctx->command, 3, 1, 0, 0);
+         /* Query state changes only descriptor data, never the executable. */
+         for (unsigned stage = MESA_SHADER_VERTEX;
+              stage <= MESA_SHADER_FRAGMENT; stage++)
+            assert(cmd->state.shaders[stage] == bound[stage]);
+         if (draw == 1)
+            ctx->api->CmdEndQuery(ctx->command, ctx->queries, 0);
+      }
+      ctx->api->CmdEndRendering(ctx->command);
+      submit(ctx);
+      uint64_t results[REPORTS + 1];
+      CHECK(ctx->api->GetQueryPoolResults(
+         ctx->device, ctx->queries, 0, 1, sizeof(results), results, sizeof(results),
+         VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT |
+            VK_QUERY_RESULT_WITH_AVAILABILITY_BIT));
+      assert(results[REPORTS] == 1);
+      assert((discard ? invocations[0] == 0 : invocations[0] > 0) &&
+             invocations[0] == invocations[1] &&
+             invocations[1] == invocations[2]);
+      if (results[7] != seed + invocations[1]) {
+         fprintf(stderr, "%ux MSAA: fragment query %" PRIu64 ", shader %u\n",
+                 ms.rasterizationSamples, results[7], invocations[1]);
+         abort();
+      }
+      if (gs) {
+         assert(results[3] == seed + 6); /* Three inputs, two invocations. */
+         assert(results[4] == seed + 18); /* One point on stream 0, two on 1. */
+         const uint64_t clipped = discard ? 0 : 6 * (stream.rasterizationStream + 1);
+         assert(results[5] == seed + clipped);
+         assert(results[6] == seed + clipped);
+      }
+      ctx->api->DestroyPipeline(ctx->device, pipeline, NULL);
+   }
+   ctx->api->DestroyPipelineCache(ctx->device, cache, NULL);
+   for (unsigned i = 0; i < 3; i++)
+      ctx->api->DestroyShaderModule(ctx->device, modules[i], NULL);
+   ctx->api->DestroyPipelineLayout(ctx->device, layout, NULL);
+   ctx->api->DestroyDescriptorPool(ctx->device, descriptors, NULL);
+   ctx->api->DestroyDescriptorSetLayout(ctx->device, set_layout, NULL);
+   ctx->api->UnmapMemory(ctx->device, memory);
+   ctx->api->DestroyBuffer(ctx->device, buffer, NULL);
+   ctx->api->FreeMemory(ctx->device, memory, NULL);
+}
+
+/* Pipeline-statistics queries that overlap in one command buffer.  Every case
+ * but the sequential control begins a second statistics query while one is
+ * active, which VUID-vkCmdBeginQuery-queryPool-01922 forbids.  Zink does it
+ * anyway: it gives each GL statistics target a pool of its own and begins each
+ * GL query separately, and it emulates GL_PRIMITIVES_GENERATED with a
+ * geometry-primitives plus clipping-invocations pool, so one statistic can be
+ * active in two queries at once.  Other drivers tolerate that, so KosmicKrisp
+ * counts each such query as if it ran alone.  No valid application needs it.
+ *
+ * Each case is a step string: 'a' to 'c' begin a query of the pool with that
+ * index and 'A' to 'C' end it; a digit draws that many primitives.  Every
+ * query is read back twice: by vkCmdCopyQueryPoolResults recorded after the
+ * render pass in the same command buffer, which must observe each count, and
+ * by vkGetQueryPoolResults. */
+enum { OVERLAP_POOLS = 3, OVERLAP_REPORTS = 2 };
+
+static const VkQueryPipelineStatisticFlags overlap_statistics[OVERLAP_POOLS] = {
+   VK_QUERY_PIPELINE_STATISTIC_CLIPPING_INVOCATIONS_BIT,
+   VK_QUERY_PIPELINE_STATISTIC_INPUT_ASSEMBLY_VERTICES_BIT,
+   VK_QUERY_PIPELINE_STATISTIC_GEOMETRY_SHADER_PRIMITIVES_BIT |
+      VK_QUERY_PIPELINE_STATISTIC_CLIPPING_INVOCATIONS_BIT,
+};
+
+struct overlap_case {
+   const char *name;
+   const char *steps;
+   bool geometry;
+};
+
+/* What one primitive of a case's draw adds to a statistic.  A triangle from
+ * the vertex-only pipeline is three vertices and one primitive at the clipper;
+ * a point through streams.geom runs two invocations that each emit one point
+ * on stream 0, which is rasterized, and two on stream 1. */
+static uint64_t
+overlap_count(bool geometry, VkQueryPipelineStatisticFlagBits statistic)
+{
+   switch (statistic) {
+   case VK_QUERY_PIPELINE_STATISTIC_INPUT_ASSEMBLY_VERTICES_BIT:
+      return geometry ? 1 : 3;
+   case VK_QUERY_PIPELINE_STATISTIC_GEOMETRY_SHADER_PRIMITIVES_BIT:
+      return geometry ? 6 : 0;
+   case VK_QUERY_PIPELINE_STATISTIC_CLIPPING_INVOCATIONS_BIT:
+      return geometry ? 2 : 1;
+   default:
+      abort();
+   }
+}
+
+static void
+test_overlapping_queries(struct context *ctx)
+{
+   static const struct overlap_case cases[] = {
+      {"sequential control", "a2Ab2B", false},
+      {"A: begin clip, begin vert, draw, end vert, end clip", "ab2BA", false},
+      {"B: begin vert, begin clip, draw, end clip, end vert", "ba2AB", false},
+      {"C: begin clip, begin vert, end vert, draw, end clip", "abB2A", false},
+      {"shared clipping statistic, vertex shader", "c1a2C4A", false},
+      {"shared clipping statistic, geometry shader", "c1a2C4A", true},
+   };
+
+   VkQueryPool pools[OVERLAP_POOLS];
+   for (uint32_t p = 0; p < OVERLAP_POOLS; p++) {
+      const VkQueryPoolCreateInfo info = {
+         .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+         .queryType = VK_QUERY_TYPE_PIPELINE_STATISTICS,
+         .queryCount = 1,
+         .pipelineStatistics = overlap_statistics[p],
+      };
+      CHECK(ctx->api->CreateQueryPool(ctx->device, &info, NULL, &pools[p]));
+   }
+
+   const VkDeviceSize copy_stride = (OVERLAP_REPORTS + 1) * sizeof(uint64_t);
+   const VkBufferCreateInfo buffer_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = OVERLAP_POOLS * copy_stride,
+      .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+   };
+   VkBuffer buffer;
+   CHECK(ctx->api->CreateBuffer(ctx->device, &buffer_info, NULL, &buffer));
+   VkMemoryRequirements requirements;
+   ctx->api->GetBufferMemoryRequirements(ctx->device, buffer, &requirements);
+   uint32_t type = 0;
+   const uint32_t flags = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                          VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+   while (type < ctx->memory.memoryTypeCount &&
+          (!(requirements.memoryTypeBits & BITFIELD_BIT(type)) ||
+           (ctx->memory.memoryTypes[type].propertyFlags & flags) != flags))
+      type++;
+   assert(type < ctx->memory.memoryTypeCount);
+   const VkMemoryAllocateInfo memory_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = requirements.size,
+      .memoryTypeIndex = type,
+   };
+   VkDeviceMemory memory;
+   CHECK(ctx->api->AllocateMemory(ctx->device, &memory_info, NULL, &memory));
+   CHECK(ctx->api->BindBufferMemory(ctx->device, buffer, memory, 0));
+   uint64_t *copied;
+   CHECK(ctx->api->MapMemory(ctx->device, memory, 0, VK_WHOLE_SIZE, 0, (void **)&copied));
+
+   static const uint32_t vertex[] =
+#include "statistics_shaders/fullscreen.vert.h"
+   ;
+   static const uint32_t geometry[] =
+#include "statistics_shaders/streams.geom.h"
+   ;
+   const uint32_t *codes[] = {vertex, geometry};
+   const size_t sizes[] = {sizeof(vertex), sizeof(geometry)};
+   VkPipelineShaderStageCreateInfo stages[2];
+   for (unsigned i = 0; i < 2; i++) {
+      const VkShaderModuleCreateInfo module_info = {
+         .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+         .codeSize = sizes[i],
+         .pCode = codes[i],
+      };
+      stages[i] = (VkPipelineShaderStageCreateInfo){
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+         .stage = i ? VK_SHADER_STAGE_GEOMETRY_BIT : VK_SHADER_STAGE_VERTEX_BIT,
+         .pName = "main",
+      };
+      CHECK(ctx->api->CreateShaderModule(ctx->device, &module_info, NULL, &stages[i].module));
+   }
+   const VkPipelineLayoutCreateInfo layout_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+   };
+   VkPipelineLayout layout;
+   CHECK(ctx->api->CreatePipelineLayout(ctx->device, &layout_info, NULL, &layout));
+   const VkPipelineVertexInputStateCreateInfo vi = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO,
+   };
+   const VkViewport viewport = {0, 0, 32, 32, 0, 1};
+   const VkRect2D scissor = {{0, 0}, {32, 32}};
+   const VkPipelineViewportStateCreateInfo vp = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+      .viewportCount = 1,
+      .pViewports = &viewport,
+      .scissorCount = 1,
+      .pScissors = &scissor,
+   };
+   const VkPipelineRasterizationStateCreateInfo rs = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+      .lineWidth = 1.0f,
+   };
+   const VkPipelineMultisampleStateCreateInfo ms = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+      .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT,
+   };
+   const VkPipelineColorBlendStateCreateInfo cb = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+   };
+   const VkPipelineRenderingCreateInfo rendering = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO,
+   };
+   VkPipeline pipelines[2];
+   for (unsigned g = 0; g < 2; g++) {
+      const VkPipelineInputAssemblyStateCreateInfo ia = {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+         .topology = g ? VK_PRIMITIVE_TOPOLOGY_POINT_LIST
+                       : VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
+      };
+      const VkGraphicsPipelineCreateInfo info = {
+         .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO,
+         .pNext = &rendering,
+         .stageCount = g ? 2 : 1,
+         .pStages = stages,
+         .pVertexInputState = &vi,
+         .pInputAssemblyState = &ia,
+         .pViewportState = &vp,
+         .pRasterizationState = &rs,
+         .pMultisampleState = &ms,
+         .pColorBlendState = &cb,
+         .layout = layout,
+      };
+      CHECK(ctx->api->CreateGraphicsPipelines(ctx->device, VK_NULL_HANDLE, 1, &info, NULL,
+                                              &pipelines[g]));
+   }
+
+   const VkRenderingInfo render_info = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+      .renderArea = scissor,
+      .layerCount = 1,
+   };
+   const VkQueryResultFlags result_flags = VK_QUERY_RESULT_64_BIT |
+                                           VK_QUERY_RESULT_WAIT_BIT |
+                                           VK_QUERY_RESULT_WITH_AVAILABILITY_BIT;
+   uint32_t lost_cases = 0;
+   for (uint32_t c = 0; c < ARRAY_SIZE(cases); c++) {
+      const struct overlap_case *test = &cases[c];
+      const uint32_t vertices_per_primitive = overlap_count(
+         test->geometry, VK_QUERY_PIPELINE_STATISTIC_INPUT_ASSEMBLY_VERTICES_BIT);
+      uint64_t expected[OVERLAP_POOLS][OVERLAP_REPORTS] = {{0}};
+      bool used[OVERLAP_POOLS] = {false};
+      bool active[OVERLAP_POOLS] = {false};
+
+      begin(ctx);
+      for (uint32_t p = 0; p < OVERLAP_POOLS; p++)
+         ctx->api->CmdResetQueryPool(ctx->command, pools[p], 0, 1);
+      ctx->api->CmdBeginRendering(ctx->command, &render_info);
+      ctx->api->CmdBindPipeline(ctx->command, VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                pipelines[test->geometry]);
+      for (const char *step = test->steps; *step; step++) {
+         if (*step >= 'a' && *step < 'a' + OVERLAP_POOLS) {
+            const uint32_t p = *step - 'a';
+            ctx->api->CmdBeginQuery(ctx->command, pools[p], 0, 0);
+            used[p] = active[p] = true;
+         } else if (*step >= 'A' && *step < 'A' + OVERLAP_POOLS) {
+            const uint32_t p = *step - 'A';
+            ctx->api->CmdEndQuery(ctx->command, pools[p], 0);
+            active[p] = false;
+         } else {
+            assert(*step >= '1' && *step <= '9');
+            const uint32_t primitives = *step - '0';
+            ctx->api->CmdDraw(ctx->command, primitives * vertices_per_primitive, 1, 0, 0);
+            for (uint32_t p = 0; p < OVERLAP_POOLS; p++) {
+               uint32_t report = 0;
+               u_foreach_bit(bit, active[p] ? overlap_statistics[p] : 0) {
+                  expected[p][report++] +=
+                     primitives * overlap_count(test->geometry, BITFIELD_BIT(bit));
+               }
+            }
+         }
+      }
+      ctx->api->CmdEndRendering(ctx->command);
+      for (uint32_t p = 0; p < OVERLAP_POOLS; p++) {
+         if (used[p]) {
+            ctx->api->CmdCopyQueryPoolResults(ctx->command, pools[p], 0, 1, buffer,
+                                              p * copy_stride, copy_stride, result_flags);
+         }
+      }
+      memset(copied, 0xa5, buffer_info.size);
+      submit(ctx);
+
+      bool lost = false;
+      for (uint32_t p = 0; p < OVERLAP_POOLS; p++) {
+         if (!used[p])
+            continue;
+         const uint32_t reports = util_bitcount(overlap_statistics[p]);
+         uint64_t results[OVERLAP_REPORTS + 1];
+         CHECK(ctx->api->GetQueryPoolResults(ctx->device, pools[p], 0, 1, sizeof(results),
+                                             results, sizeof(results), result_flags));
+         const uint64_t *copy = copied + p * (OVERLAP_REPORTS + 1);
+         for (uint32_t r = 0; r <= reports; r++) {
+            const uint64_t want = r < reports ? expected[p][r] : 1;
+            if (results[r] != want || copy[r] != want) {
+               fprintf(stderr,
+                       "%s: query %c value %u: expected %" PRIu64 ", got %" PRIu64
+                       " from the host and %" PRIu64 " from the copy\n",
+                       test->name, 'a' + p, r, want, results[r], copy[r]);
+               lost = true;
+            }
+         }
+      }
+      printf("%s: %s\n", test->name, lost ? "LOST" : "ok");
+      lost_cases += lost;
+   }
+   if (lost_cases)
+      abort();
+
+   for (unsigned g = 0; g < 2; g++)
+      ctx->api->DestroyPipeline(ctx->device, pipelines[g], NULL);
+   ctx->api->DestroyPipelineLayout(ctx->device, layout, NULL);
+   for (unsigned i = 0; i < 2; i++)
+      ctx->api->DestroyShaderModule(ctx->device, stages[i].module, NULL);
+   ctx->api->UnmapMemory(ctx->device, memory);
+   ctx->api->DestroyBuffer(ctx->device, buffer, NULL);
+   ctx->api->FreeMemory(ctx->device, memory, NULL);
+   for (uint32_t p = 0; p < OVERLAP_POOLS; p++)
+      ctx->api->DestroyQueryPool(ctx->device, pools[p], NULL);
+}
+
+int
+main(void)
+{
+   const VkApplicationInfo app = {
+      .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+      .apiVersion = VK_API_VERSION_1_3,
+   };
+   const VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   VkInstance instance;
+   CHECK(kk_CreateInstance(&instance_info, NULL, &instance));
+   PFN_vkEnumeratePhysicalDevices enumerate =
+      (PFN_vkEnumeratePhysicalDevices)kk_GetInstanceProcAddr(instance,
+                                                            "vkEnumeratePhysicalDevices");
+   uint32_t count = 1;
+   VkPhysicalDevice physical;
+   CHECK(enumerate(instance, &count, &physical));
+   assert(count == 1);
+   const float priority = 1;
+   const VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   const VkPhysicalDeviceTransformFeedbackFeaturesEXT xfb = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TRANSFORM_FEEDBACK_FEATURES_EXT,
+      .transformFeedback = true,
+      .geometryStreams = true,
+   };
+   VkPhysicalDeviceVulkan13Features features13 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES,
+      .pNext = (void *)&xfb,
+      .dynamicRendering = true,
+      .pipelineCreationCacheControl = true,
+   };
+   const VkPhysicalDeviceVulkan11Features features11 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES,
+      .pNext = &features13,
+      .multiview = true,
+   };
+   const VkPhysicalDeviceFeatures features = {
+      .pipelineStatisticsQuery = true,
+      .fragmentStoresAndAtomics = true,
+      .inheritedQueries = true,
+      .geometryShader = true,
+      .shaderTessellationAndGeometryPointSize = true,
+   };
+   const char *extensions[] = {VK_EXT_TRANSFORM_FEEDBACK_EXTENSION_NAME};
+   const VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .pNext = &features11,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+      .pEnabledFeatures = &features,
+      .enabledExtensionCount = ARRAY_SIZE(extensions),
+      .ppEnabledExtensionNames = extensions,
+   };
+   struct context ctx = {0};
+   CHECK(kk_CreateDevice(physical, &device_info, NULL, &ctx.device));
+   VkPhysicalDeviceFeatures off_features = features;
+   off_features.pipelineStatisticsQuery = false;
+   VkDeviceCreateInfo off_device_info = device_info;
+   off_device_info.pEnabledFeatures = &off_features;
+   CHECK(kk_CreateDevice(physical, &off_device_info, NULL, &ctx.query_disabled_device));
+   PFN_vkGetPhysicalDeviceMemoryProperties get_memory =
+      (PFN_vkGetPhysicalDeviceMemoryProperties)kk_GetInstanceProcAddr(
+         instance, "vkGetPhysicalDeviceMemoryProperties");
+   get_memory(physical, &ctx.memory);
+   ctx.api = &kk_device_from_handle(ctx.device)->exposed_dispatch_table;
+   ctx.api->GetDeviceQueue(ctx.device, 0, 0, &ctx.queue);
+   const VkCommandPoolCreateInfo commands_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+      .queueFamilyIndex = 0,
+   };
+   CHECK(ctx.api->CreateCommandPool(ctx.device, &commands_info, NULL, &ctx.commands));
+   const VkCommandBufferAllocateInfo allocation = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = ctx.commands,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   CHECK(ctx.api->AllocateCommandBuffers(ctx.device, &allocation, &ctx.command));
+   const VkQueryPoolCreateInfo query_info = {
+      .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+      .queryType = VK_QUERY_TYPE_PIPELINE_STATISTICS,
+      .queryCount = QUERY_COUNT,
+      .pipelineStatistics = BITFIELD_MASK(REPORTS),
+   };
+   CHECK(ctx.api->CreateQueryPool(ctx.device, &query_info, NULL, &ctx.queries));
+   test_helpers(&ctx);
+   test_empty_multiview(&ctx);
+   test_fragment_invocations(&ctx);
+   test_overlapping_queries(&ctx);
+   ctx.api->DestroyQueryPool(ctx.device, ctx.queries, NULL);
+   ctx.api->DestroyCommandPool(ctx.device, ctx.commands, NULL);
+   kk_DestroyDevice(ctx.query_disabled_device, NULL);
+   ctx.api->DestroyDevice(ctx.device, NULL);
+   kk_DestroyInstance(instance, NULL);
+   puts("pipeline statistics GPU arithmetic, empty multiview, fragments and "
+        "overlapping queries passed");
+   return 0;
+}
