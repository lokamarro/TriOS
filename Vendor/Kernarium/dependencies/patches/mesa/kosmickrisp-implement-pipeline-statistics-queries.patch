diff --git a/src/kosmickrisp/vulkan/tests/post_depth_coverage_shaders/pdc.vert b/src/kosmickrisp/vulkan/tests/post_depth_coverage_shaders/pdc.vert
new file mode 100644
index 0000000000000000000000000000000000000000..74c453bc11b65f2a4a6cfc4167b1a44bdc057c54
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/post_depth_coverage_shaders/pdc.vert
@@ -0,0 +1,20 @@
+#version 460
+/* SPDX-License-Identifier: MIT */
+/* Two primitives over a one pixel viewport: a near one that only reaches the
+ * first standard sample position, and a far one that covers every sample. */
+layout (push_constant, std430) uniform PushConstantBlock { int primitive; } pc;
+vec3 near_primitive[3] = vec3[](
+    vec3(-1.0, -1.0, 0.25),
+    vec3(0.4, -1.0, 0.25),
+    vec3(-1.0, 0.4, 0.25)
+);
+vec3 far_primitive[3] = vec3[](
+    vec3(-1.0, -1.0, 0.75),
+    vec3(3.0, -1.0, 0.75),
+    vec3(-1.0, 3.0, 0.75)
+);
+void main (void) {
+    vec3 position = pc.primitive == 0 ? near_primitive[gl_VertexIndex % 3]
+                                      : far_primitive[gl_VertexIndex % 3];
+    gl_Position = vec4(position, 1.0);
+}
