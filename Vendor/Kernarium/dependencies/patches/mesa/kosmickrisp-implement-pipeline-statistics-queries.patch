index 0000000000000000000000000000000000000000..de1006e8e0911729f7df47cb3a700e0324c06576
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/max_varyings_shaders/generate.sh
@@ -0,0 +1,8 @@
+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+cd -- "$(dirname -- "$0")"
+for shader in max_varyings.vert max_varyings_passthrough.vert max_varyings.frag \
+              max_varyings.tesc max_varyings.tese max_varyings.geom; do
+   glslc --target-env=vulkan1.3 -mfmt=c "$shader" -o "$shader.h"
+done
diff --git a/src/kosmickrisp/vulkan/tests/max_varyings_shaders/max_varyings.frag b/src/kosmickrisp/vulkan/tests/max_varyings_shaders/max_varyings.frag
new file mode 100644
