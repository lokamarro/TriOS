+      uint64_t count = static_count[i] >= 0
+         ? (uint64_t)unrolled_in_prims * static_count[i] : in_prims[i];
+      emitted_prims += count;
+      if (i == rasterization_stream)
+         rasterized_prims = count;
    }
 
    uint4 prims = in_prims;
-   uint emitted_prims = prims[0] + prims[1] + prims[2] + prims[3];
 
    if (buffers_written) {
       poly_foreach_xfb(buffers_written, i) {
@@ -356,8 +365,9 @@ poly_pre_gs(global struct poly_geometry_params *p, uint streams,
     *    geometry shader invocations count is incremented for each separate
