+         const bool renders_as_3d = image->vk.image_type == VK_IMAGE_TYPE_3D;
+         view->planes[view_plane].render_is_view =
+            requires_format_change && !renders_as_3d;
+         if (requires_format_change && renders_as_3d) {
+            struct kk_view_layout render_layout = view_layout;
+            render_layout.view_type = VK_IMAGE_VIEW_TYPE_3D;
+            render_layout.base_level = 0u;
+            render_layout.num_levels = image->vk.mip_levels;
+            render_layout.base_array_layer = 0u;
+            render_layout.array_len = 1u;
+            view->planes[view_plane].mtl_handle_render =
+               mtl_new_texture_view_with_no_swizzle(
+                  image->planes[image_plane].mtl_handle, &render_layout);
+         } else if (requires_format_change) {
             view_layout.view_type = original_type;
             view->planes[view_plane].mtl_handle_render =
                mtl_new_texture_view_with_no_swizzle(mtl_handle, &view_layout);
-         } else /* Subresource indices will be set in attachment descriptor */
-            view->planes[view_plane].mtl_handle_render = mtl_retain(mtl_handle);
+         } else {
+            /* Subresource indices will be set in attachment descriptor. */
+            view->planes[view_plane].mtl_handle_render = mtl_retain(
+               renders_as_3d ? image->planes[image_plane].mtl_handle
+                             : mtl_handle);
+         }
       }
    }
 
