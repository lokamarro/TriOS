diff --git a/src/kosmickrisp/vulkan/tests/test_3d_array_alias.c b/src/kosmickrisp/vulkan/tests/test_3d_array_alias.c
new file mode 100644
index 0000000000000000000000000000000000000000..de3edebf0bef81f70a5438d0a5d8b7919ba80bc1
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_3d_array_alias.c
@@ -0,0 +1,339 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* A 3D image deeper than it is wide carries more mip levels than a 2D array of
+ * the same width and height may hold, so the auxiliary 2D array alias of such
+ * an image must stay within what Metal can describe. Rendering selects a z
+ * slice of the image itself rather than a layer of that alias, so a 2D or 2D
+ * array view of every slice of every level, the levels the alias omits
+ * included, must be made and must receive exactly the color drawn into it,
+ * whether the view keeps the image's usage, as Zink's render targets do, or
+ * only the attachment usage. */
+#include "kosmickrisp/vulkan/kk_device.h"
+#include "kosmickrisp/vulkan/kk_entrypoints.h"
+#include "kosmickrisp/vulkan/kk_image.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(expr) do { \
+   VkResult result_ = (expr); \
+   if (result_ != VK_SUCCESS) { \
+      fprintf(stderr, "%s:%d: %s = %d\n", __FILE__, __LINE__, #expr, result_); \
+      abort(); \
+   } \
+} while (0)
+
+/* 7x7x12 is the geometry the OpenGL CTS copy_image functional tests build: a
+ * 3D texture whose four level mip chain exceeds the three levels a 7x7 2D
+ * array can describe. */
+enum { WIDTH = 7, HEIGHT = 7, DEPTH = 12, MAX_LEVELS = 4, TEXEL = 4 };
+
+struct context {
+   VkDevice device;
+   VkQueue queue;
+   VkCommandBuffer cmd;
+   const struct vk_device_dispatch_table *api;
+   VkPhysicalDeviceMemoryProperties memory;
+};
+
+static uint32_t
+minify(uint32_t value, uint32_t level)
+{
+   return MAX2(value >> level, 1u);
+}
+
+static uint32_t
+memory_type(struct context *ctx, uint32_t bits, VkMemoryPropertyFlags flags)
+{
+   for (uint32_t i = 0; i < ctx->memory.memoryTypeCount; i++) {
+      if ((bits & BITFIELD_BIT(i)) &&
+          (ctx->memory.memoryTypes[i].propertyFlags & flags) == flags)
+         return i;
+   }
+   abort();
+}
+
+static void
+image_barrier(struct context *ctx, VkImage image, VkImageLayout from,
+              VkImageLayout to)
+{
+   const VkImageMemoryBarrier barrier = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+      .oldLayout = from, .newLayout = to,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = image,
+      .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0,
+                           VK_REMAINING_MIP_LEVELS, 0,
+                           VK_REMAINING_ARRAY_LAYERS},
+   };
+   ctx->api->CmdPipelineBarrier(ctx->cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                                VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, NULL,
+                                0, NULL, 1, &barrier);
+}
+
+/* Draw one solid color into every z slice of every level through a 2D or 2D
+ * array view, read the whole image back and count the mismatching texels. */
+static bool
+test_levels(struct context *ctx, uint32_t levels, bool reinterpret,
+            bool attachment_usage)
+{
+   /* A view that changes the format takes a different path to the render
+    * target, so cover it with an equivalent integer view of the same texels. */
+   const VkFormat view_format =
+      reinterpret ? VK_FORMAT_R8G8B8A8_UINT : VK_FORMAT_R8G8B8A8_UNORM;
+   const VkImageCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .flags = VK_IMAGE_CREATE_2D_ARRAY_COMPATIBLE_BIT |
+               (reinterpret ? VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT : 0),
+      .imageType = VK_IMAGE_TYPE_3D,
+      .format = VK_FORMAT_R8G8B8A8_UNORM,
+      .extent = {WIDTH, HEIGHT, DEPTH},
+      .mipLevels = levels,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+               VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+               VK_IMAGE_USAGE_SAMPLED_BIT |
+               VK_IMAGE_USAGE_STORAGE_BIT |
+               VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   VkImage image;
+   CHECK(ctx->api->CreateImage(ctx->device, &info, NULL, &image));
+   VkMemoryRequirements req;
+   ctx->api->GetImageMemoryRequirements(ctx->device, image, &req);
+   const VkMemoryAllocateInfo alloc = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = req.size,
+      .memoryTypeIndex = memory_type(ctx, req.memoryTypeBits,
+                                     VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT),
+   };
+   VkDeviceMemory memory;
+   CHECK(ctx->api->AllocateMemory(ctx->device, &alloc, NULL, &memory));
+   /* Metal rejects an over deep 2D array descriptor outright, so an unbounded
+    * alias aborts the process here rather than failing the bind. */
+   CHECK(ctx->api->BindImageMemory(ctx->device, image, memory, 0));
+
+   const struct kk_image *kk_img = kk_image_from_handle(image);
+   const uint32_t alias_levels =
+      kk_image_layout_array_alias_levels(&kk_img->planes[0].layout);
+
+   uint32_t readback_B = 0;
+   uint32_t level_offset_B[MAX_LEVELS];
+   for (uint32_t level = 0; level < levels; level++) {
+      level_offset_B[level] = readback_B;
+      readback_B += minify(WIDTH, level) * minify(HEIGHT, level) *
+                    minify(DEPTH, level) * TEXEL;
+   }
+   const VkBufferCreateInfo buffer_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = readback_B,
+      .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+   };
+   VkBuffer readback;
+   CHECK(ctx->api->CreateBuffer(ctx->device, &buffer_info, NULL, &readback));
+   VkMemoryRequirements breq;
+   ctx->api->GetBufferMemoryRequirements(ctx->device, readback, &breq);
+   const VkMemoryAllocateInfo balloc = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = breq.size,
+      .memoryTypeIndex = memory_type(ctx, breq.memoryTypeBits,
+                                     VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                     VK_MEMORY_PROPERTY_HOST_COHERENT_BIT),
+   };
+   VkDeviceMemory readback_mem;
+   CHECK(ctx->api->AllocateMemory(ctx->device, &balloc, NULL, &readback_mem));
+   CHECK(ctx->api->BindBufferMemory(ctx->device, readback, readback_mem, 0));
+   uint8_t *pixels;
+   CHECK(ctx->api->MapMemory(ctx->device, readback_mem, 0, VK_WHOLE_SIZE, 0,
+                             (void **)&pixels));
+
+   const VkCommandBufferBeginInfo begin = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+   };
+   CHECK(ctx->api->BeginCommandBuffer(ctx->cmd, &begin));
+   image_barrier(ctx, image, VK_IMAGE_LAYOUT_UNDEFINED,
+                 VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+
+   /* One attachment view per z slice: a 2D array view restricted to
+    * attachment usage, or a 2D view keeping every usage of the image, which
+    * is the view Zink clears a single slice through. */
+   VkImageView slice_views[MAX_LEVELS][DEPTH] = {{VK_NULL_HANDLE}};
+   uint32_t refused = 0;
+   for (uint32_t level = 0; level < levels; level++) {
+      for (uint32_t slice = 0; slice < minify(DEPTH, level); slice++) {
+         const VkImageViewUsageCreateInfo usage = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_USAGE_CREATE_INFO,
+            .usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT,
+         };
+         const VkImageViewCreateInfo view_info = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+            .pNext = attachment_usage ? &usage : NULL,
+            .image = image,
+            .viewType = attachment_usage ? VK_IMAGE_VIEW_TYPE_2D_ARRAY
+                                         : VK_IMAGE_VIEW_TYPE_2D,
+            .format = view_format,
+            .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, level, 1, slice, 1},
+         };
+         const VkResult result = ctx->api->CreateImageView(
+            ctx->device, &view_info, NULL, &slice_views[level][slice]);
+         if (result != VK_SUCCESS) {
+            refused++;
+            continue;
+         }
+         const VkRenderingAttachmentInfo attachment = {
+            .sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO,
+            .imageView = slice_views[level][slice],
+            .imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+            .loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR,
+            .storeOp = VK_ATTACHMENT_STORE_OP_STORE,
+            .clearValue =
+               reinterpret
+                  ? (VkClearValue){.color = {.uint32 = {slice + 1, level + 1,
+                                                        0u, 255u}}}
+                  : (VkClearValue){.color = {.float32 = {(slice + 1) / 255.0f,
+                                                         (level + 1) / 255.0f,
+                                                         0.0f, 1.0f}}},
+         };
+         const VkRenderingInfo rendering = {
+            .sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+            .renderArea = {{0, 0},
+                           {minify(WIDTH, level), minify(HEIGHT, level)}},
+            .layerCount = 1,
+            .colorAttachmentCount = 1,
+            .pColorAttachments = &attachment,
+         };
+         ctx->api->CmdBeginRendering(ctx->cmd, &rendering);
+         ctx->api->CmdEndRendering(ctx->cmd);
+      }
+   }
+
+   image_barrier(ctx, image, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                 VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+   for (uint32_t level = 0; level < levels; level++) {
+      const VkBufferImageCopy copy = {
+         .bufferOffset = level_offset_B[level],
+         .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, level, 0, 1},
+         .imageExtent = {minify(WIDTH, level), minify(HEIGHT, level),
+                         minify(DEPTH, level)},
+      };
+      ctx->api->CmdCopyImageToBuffer(ctx->cmd, image,
+         VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, readback, 1, &copy);
+   }
+   CHECK(ctx->api->EndCommandBuffer(ctx->cmd));
+   const VkSubmitInfo submit = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1, .pCommandBuffers = &ctx->cmd,
+   };
+   CHECK(ctx->api->QueueSubmit(ctx->queue, 1, &submit, VK_NULL_HANDLE));
+   CHECK(ctx->api->QueueWaitIdle(ctx->queue));
+
+   uint32_t bad = 0;
+   for (uint32_t level = 0; level < levels; level++) {
+      const uint32_t texels = minify(WIDTH, level) * minify(HEIGHT, level);
+      for (uint32_t slice = 0; slice < minify(DEPTH, level); slice++) {
+         const uint8_t expect[4] = {slice + 1, level + 1, 0, 255};
+         for (uint32_t i = 0; i < texels; i++) {
+            const uint8_t *p = pixels + level_offset_B[level] +
+                               (slice * texels + i) * TEXEL;
+            for (uint32_t c = 0; c < 4; c++)
+               bad += p[c] != expect[c];
+         }
+      }
+   }
+   printf("levels=%u reinterpret=%u attachment_usage=%u alias_levels=%u "
+          "refused_views=%u mismatches=%u\n", levels, reinterpret,
+          attachment_usage, alias_levels, refused, bad);
+
+   for (uint32_t level = 0; level < levels; level++) {
+      for (uint32_t slice = 0; slice < DEPTH; slice++) {
+         if (slice_views[level][slice] != VK_NULL_HANDLE)
+            ctx->api->DestroyImageView(ctx->device, slice_views[level][slice],
+                                       NULL);
+      }
+   }
+   ctx->api->UnmapMemory(ctx->device, readback_mem);
+   ctx->api->DestroyBuffer(ctx->device, readback, NULL);
+   ctx->api->FreeMemory(ctx->device, readback_mem, NULL);
+   ctx->api->DestroyImage(ctx->device, image, NULL);
+   ctx->api->FreeMemory(ctx->device, memory, NULL);
+
+   /* The four level chain must have a level the alias omits, and every level
+    * must hold exactly what was drawn into it. */
+   return bad == 0 && refused == 0 &&
+          (levels == 1 || alias_levels < levels);
+}
+
+int
+main(void)
+{
+   const VkApplicationInfo app = {
+      .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+      .apiVersion = VK_API_VERSION_1_3,
+   };
+   const VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   VkInstance instance;
+   CHECK(kk_CreateInstance(&instance_info, NULL, &instance));
+   PFN_vkEnumeratePhysicalDevices enumerate = (PFN_vkEnumeratePhysicalDevices)
+      kk_GetInstanceProcAddr(instance, "vkEnumeratePhysicalDevices");
+   uint32_t count = 1;
+   VkPhysicalDevice physical;
+   CHECK(enumerate(instance, &count, &physical));
+   const float priority = 1;
+   const VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0, .queueCount = 1, .pQueuePriorities = &priority,
+   };
+   const VkPhysicalDeviceVulkan13Features features13 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES,
+      .dynamicRendering = VK_TRUE,
+   };
+   const VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO, .pNext = &features13,
+      .queueCreateInfoCount = 1, .pQueueCreateInfos = &queue_info,
+   };
+   struct context ctx = {0};
+   CHECK(kk_CreateDevice(physical, &device_info, NULL, &ctx.device));
+   PFN_vkGetPhysicalDeviceMemoryProperties get_memory =
+      (PFN_vkGetPhysicalDeviceMemoryProperties)kk_GetInstanceProcAddr(
+         instance, "vkGetPhysicalDeviceMemoryProperties");
+   get_memory(physical, &ctx.memory);
+   ctx.api = &kk_device_from_handle(ctx.device)->exposed_dispatch_table;
+   ctx.api->GetDeviceQueue(ctx.device, 0, 0, &ctx.queue);
+   const VkCommandPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+      .queueFamilyIndex = 0,
+   };
+   VkCommandPool pool;
+   CHECK(ctx.api->CreateCommandPool(ctx.device, &pool_info, NULL, &pool));
+   const VkCommandBufferAllocateInfo alloc = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = pool, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   CHECK(ctx.api->AllocateCommandBuffers(ctx.device, &alloc, &ctx.cmd));
+
+   bool pass = true;
+   pass &= test_levels(&ctx, 1, false, true);
+   pass &= test_levels(&ctx, MAX_LEVELS, false, true);
+   pass &= test_levels(&ctx, MAX_LEVELS, true, true);
+   pass &= test_levels(&ctx, MAX_LEVELS, false, false);
+   pass &= test_levels(&ctx, MAX_LEVELS, true, false);
+
+   ctx.api->DestroyCommandPool(ctx.device, pool, NULL);
+   ctx.api->DestroyDevice(ctx.device, NULL);
+   kk_DestroyInstance(instance, NULL);
+   return pass ? 0 : 1;
+}
