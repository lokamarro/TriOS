             view_layout.swizzle.alpha = PIPE_SWIZZLE_0;
       }
 
+      /* Metal cannot view a 3D texture as a 2D array, so a non 3D view of a
+       * 3D image is sampled, stored and read as an input attachment through
+       * the auxiliary 2D array texture that aliases the same memory, and it
+       * renders through the image's own texture (see below). That alias only
