From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 31 Oct 2026 10:46:37 +0900
Subject: [PATCH] gallium: let a client ask an idle context to release what it
 holds

A context that has been flushed and then left alone keeps references to the
resources of its last batches until it submits again.  For a guest whose GPU
contexts go quiet for minutes, that is whole render targets and textures that
no live object names, held by a driver that has nothing left to do with them.

pipe_context::trim is the client's way to say that the context has been idle:
the driver releases what it holds for completed work and keeps the context
usable.  It is optional, never flushes and never waits for the device.

u_threaded_context forwards it to the driver thread behind everything queued
before it, and submits the batch at once, since nothing else will follow; a
context in the middle of a render pass is not idle and is left alone.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 docs/gallium/context.rst                      |  9 ++++++
 .../auxiliary/util/u_threaded_context.c       | 29 +++++++++++++++++++
 .../auxiliary/util/u_threaded_context_calls.h |  1 +
 src/gallium/include/pipe/p_context.h          | 12 ++++++++
 4 files changed, 51 insertions(+)

diff --git a/docs/gallium/context.rst b/docs/gallium/context.rst
index acfc6ed712cd1d218acd7d3c0863e6f8361a29dc..29b28d5c00f8b4274b8332171dd4737d2b1cd30a 100644
--- a/docs/gallium/context.rst
+++ b/docs/gallium/context.rst
@@ -627,6 +627,15 @@ by a single pipe_screen and is not shared with another process.
 (i.e. you shouldn't use it to flush caches explicitly if you want to e.g.
 use the resource for texturing)
 
+``trim``
+
+Release what the context still holds for work that has completed, for a
+context that has been flushed and is idle. A context keeps references to the
+resources its last batches used until it submits again; the client calls this
+once the context has been idle for a while so that they can go. It is optional,
+never flushes or waits for the device, and leaves work that has not completed
+for the next use of the context.
+
 Fences
 ^^^^^^
 
diff --git a/src/gallium/auxiliary/util/u_threaded_context.c b/src/gallium/auxiliary/util/u_threaded_context.c
index d498eb6fea9c8c37e75ebe2e24eb41f9e490273b..ba3695800eb2a6e70396330b240237b1f499da95 100644
--- a/src/gallium/auxiliary/util/u_threaded_context.c
+++ b/src/gallium/auxiliary/util/u_threaded_context.c
@@ -3613,6 +3613,34 @@ tc_set_context_param(struct pipe_context *_pipe,
 }
 
 
+/* The client's idle trim goes to the driver thread behind everything queued
+ * before it, so the driver sees the context as the last flush left it, and the
+ * batch is submitted at once because nothing else may follow.  A context in
+ * the middle of a render pass is not idle and is left alone. */
+struct tc_trim_call {
+   struct tc_call_base base;
+};
+
+static uint16_t ALWAYS_INLINE
+tc_call_trim(struct pipe_context *pipe, void *call)
+{
+   pipe->trim(pipe);
+   return call_size(tc_trim_call);
+}
+
+static void
+tc_trim(struct pipe_context *_pipe)
+{
+   struct threaded_context *tc = threaded_context(_pipe);
+
+   if (tc->in_renderpass)
+      return;
+
+   tc_add_call(tc, TC_CALL_trim, tc_trim_call);
+   tc_batch_flush(tc, false);
+}
+
+
 /********************************************************************
  * draw, launch, clear, blit, copy, flush
  */
@@ -5733,6 +5761,7 @@ threaded_context_create(struct pipe_context *pipe,
    CTX_INIT(texture_subdata);
    CTX_INIT(texture_barrier);
    CTX_INIT(memory_barrier);
+   CTX_INIT(trim);
    CTX_INIT(resource_commit);
    CTX_INIT(create_video_codec);
    CTX_INIT(create_video_buffer);
diff --git a/src/gallium/auxiliary/util/u_threaded_context_calls.h b/src/gallium/auxiliary/util/u_threaded_context_calls.h
index 2cdbb1cb31f42b3563aa14de6b8c1f773818f983..5f9b97f7d8f49e50b175bddfb94c5ed2c8861a89 100644
--- a/src/gallium/auxiliary/util/u_threaded_context_calls.h
+++ b/src/gallium/auxiliary/util/u_threaded_context_calls.h
@@ -88,6 +88,7 @@ CALL(set_active_query_state)
 CALL(set_clip_state)
 CALL(texture_barrier)
 CALL(memory_barrier)
+CALL(trim)
 CALL(delete_texture_handle)
 CALL(make_texture_handle_resident)
 CALL(delete_image_handle)
diff --git a/src/gallium/include/pipe/p_context.h b/src/gallium/include/pipe/p_context.h
index e2dd3dddf1b9a907b2e7c5bdd037aac494b1bc36..3cbbddf0d7bc1fb0d239d46413b615b568ff97b6 100644
--- a/src/gallium/include/pipe/p_context.h
+++ b/src/gallium/include/pipe/p_context.h
@@ -1083,6 +1083,18 @@ struct pipe_context {
    void (*flush_resource)(struct pipe_context *ctx,
                           struct pipe_resource *resource);
 
+   /**
+    * Release what the context still holds for work that has completed.
+    *
+    * A context that has been flushed and is not being used keeps references
+    * to the resources its last batches used until it submits again, which
+    * can be a long time.  The client calls this once such a context has been
+    * idle for a while, so those resources can go.  It is optional, it never
+    * flushes or waits for the device, and what is not yet complete is left
+    * for the next use.  The context stays valid and usable.
+    */
+   void (*trim)(struct pipe_context *ctx);
+
    /**
     * Invalidate the contents of the resource. This is used to
     *
