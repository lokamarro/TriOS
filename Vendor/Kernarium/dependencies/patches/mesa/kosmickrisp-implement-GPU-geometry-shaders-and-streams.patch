+/* SPDX-License-Identifier: MIT */
+
+/* Launch only the production setup helper. Oversized logical draws are never
+ * dispatched, so overflow and stale-record checks need only a bounded heap. */
+#include "kosmickrisp/vulkan/kk_cmd_buffer.h"
+#include "kosmickrisp/vulkan/kk_device.h"
+#include "kosmickrisp/vulkan/kk_entrypoints.h"
+
+#include <stdlib.h>
+
+#define CHECK(expr) do { \
+   VkResult result_ = (expr); \
+   if (result_ != VK_SUCCESS) { \
+      fprintf(stderr, "%s:%d: %s = %d\n", __FILE__, __LINE__, #expr, result_); \
+      abort(); \
+   } \
+} while (0)
+
+struct setup_case {
+   const char *name;
+   uint32_t vertices, instances;
+   enum mesa_prim prim;
+   uint64_t outputs;
+   uint32_t stride, output_vertices;
+   bool publish, valid;
+};
+
+static void
+check_setup(VkDevice device, VkQueue queue, VkCommandBuffer command,
+            const struct setup_case *test)
+{
+   const struct vk_device_dispatch_table *api =
+      &kk_device_from_handle(device)->exposed_dispatch_table;
+   const VkCommandBufferBeginInfo begin = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+   };
+   CHECK(api->BeginCommandBuffer(command, &begin));
+   struct kk_cmd_buffer *cmd = kk_cmd_buffer_from_handle(command);
+   const uint32_t local[3] = {64, 1, 1};
+   struct poly_vertex_params vertex;
+   struct poly_geometry_params geometry;
+   poly_vertex_params_init(&vertex, test->outputs, local);
+   poly_geometry_params_init(&geometry, test->prim, local);
+   geometry.output_vertex_stride = test->stride;
+   geometry.output_vertices = test->output_vertices;
+   struct kk_ptr vp = kk_pool_upload(cmd, &vertex, sizeof(vertex), 4);
+   struct kk_ptr gp = kk_pool_upload(cmd, &geometry, sizeof(geometry), 4);
+   const uint32_t draw_words[4] = {test->vertices, test->instances, 0, 0};
+   struct kk_ptr draw = kk_pool_upload(cmd, draw_words, sizeof(draw_words), 4);
+   const uint32_t guard = 0xa5a5a5a5;
+   const uint32_t initial[5] = {guard, guard, guard, guard, guard};
+   struct kk_ptr groups = kk_pool_upload(cmd, initial, sizeof(initial), 4);
+   struct kk_ptr storage = kk_pool_alloc(cmd, 65536, 16);
+   const struct poly_heap heap_data = {
+      .base = storage.gpu,
+      .bottom = 16,
+      .size = 65536,
+   };
+   struct kk_ptr heap = kk_pool_upload(cmd, &heap_data, sizeof(heap_data), 4);
+   assert(vp.cpu && gp.cpu && draw.cpu && groups.cpu && storage.cpu && heap.cpu);
+   const struct libkk_gs_setup_indirect_args args = {
+      .draw = draw.gpu,
+      .vp = vp.gpu,
+      .p = gp.gpu,
+      .heap = heap.gpu,
+      .vertex_outputs = test->outputs,
+      .prim = test->prim,
+      .shape = POLY_GS_SHAPE_STATIC_PER_INSTANCE,
+      .gs_group_grid = test->publish ? groups.gpu + sizeof(uint32_t) : 0,
+   };
+   libkk_gs_setup_indirect_struct(cmd, kk_grid_1d(1), true, args);
+   CHECK(api->EndCommandBuffer(command));
+   const VkSubmitInfo submit = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &command,
+   };
+   CHECK(api->QueueSubmit(queue, 1, &submit, VK_NULL_HANDLE));
+   CHECK(api->QueueWaitIdle(queue));
+
+   const struct poly_vertex_params *actual_vp = vp.cpu;
+   const struct poly_geometry_params *actual_gp = gp.cpu;
+   const struct poly_heap *actual_heap = heap.cpu;
+   const uint32_t *actual_groups = groups.cpu;
+   assert(actual_groups[0] == guard && actual_groups[4] == guard);
+   const uint32_t primitives = test->valid
+      ? poly_decomposed_prims_for_vertices_u32(test->prim, test->vertices) : 0;
+   const uint32_t expected_vs[6] = {
+      test->vertices, test->instances, 1, 64, 1, 1,
+   };
+   const uint32_t expected_gs[6] = {
+      primitives, test->instances, 1, 64, 1, 1,
+   };
+   const uint32_t expected_groups[3] = {
+      primitives / 64 + (primitives % 64 != 0), test->instances, 1,
+   };
+   for (unsigned i = 0; i < 6; i++) {
+      assert(actual_vp->grid[i] == (test->valid ? expected_vs[i] : 0));
+      assert(actual_gp->grid[i] == (test->valid ? expected_gs[i] : 0));
+   }
+   for (unsigned i = 0; i < 3; i++) {
+      const uint32_t expected = !test->publish ? guard
+         : test->valid ? expected_groups[i] : 0;
+      assert(actual_groups[1 + i] == expected);
+   }
+   if (!test->valid) {
+      const struct poly_indirect_draw empty = {0};
+      assert(memcmp(&actual_gp->draw, &empty, sizeof(empty)) == 0);
+      assert(actual_gp->input_primitives == 0);
+      assert(actual_gp->output_vertex_buffer == 0);
+      assert(actual_heap->bottom == heap_data.bottom);
+   } else {
+      assert(actual_gp->input_primitives == primitives * test->instances);
+      assert(actual_heap->bottom >= heap_data.bottom &&
+             actual_heap->bottom < heap_data.size);
+   }
+   printf("geometry setup PASS %s\n", test->name);
+}
