+      {"optional-output-disabled", 65, 1, MESA_PRIM_POINTS, 1, 32, 6, false, true},
+      {"maximum-grid-ceiling", UINT32_MAX, 1, MESA_PRIM_POINTS, 0, 0, 0, true, true},
+      {"vertex-count-overflow", UINT32_MAX, 2, MESA_PRIM_POINTS, 1, 32, 6, true, false},
+      {"vertex-size-overflow", UINT32_MAX / 16 + 1, 1, MESA_PRIM_POINTS, 1, 0, 0, true, false},
+      {"output-size-overflow", UINT32_MAX / 192 + 1, 1, MESA_PRIM_POINTS, 0, 32, 6, true, false},
+      {"output-alignment-overflow", UINT32_MAX, 1, MESA_PRIM_POINTS, 0, 1, 1, true, false},
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(cases); i++) {
+      CHECK(api->ResetCommandPool(device, commands, 0));
+      check_setup(device, queue, command, &cases[i]);
+   }
+   api->DestroyCommandPool(device, commands, NULL);
+   api->DestroyDevice(device, NULL);
+   kk_DestroyInstance(instance, NULL);
+   return 0;
+}
