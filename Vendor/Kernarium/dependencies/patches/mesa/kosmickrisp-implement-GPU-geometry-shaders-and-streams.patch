+static void
+kk_dispatch_geometry_stage(mtl_compute_encoder *enc,
+                           mtl_compute_pipeline_state *pipeline,
+                           struct kk_grid grid, uint64_t indirect_grid,
+                           uint32_t local_size, bool indirect_threadgroups)
+{
+   mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH,
+                                    MTL_STAGE_DISPATCH);
+   mtl_compute_set_pipeline_state(enc, pipeline);
+   if (kk_grid_is_indirect(grid)) {
+      if (indirect_threadgroups) {
+         mtl_dispatch_threadgroups_with_indirect_buffer(
+            enc, indirect_grid, (struct mtl_size){local_size, 1, 1});
+      } else {
+         mtl_dispatch_threads_with_indirect_buffer(enc, indirect_grid);
+      }
+   } else {
+      kk_dispatch_compute(enc, grid, (struct mtl_size){local_size, 1, 1});
+   }
+}
+
+static struct kk_draw_data
+kk_launch_geometry(struct kk_cmd_buffer *cmd, struct kk_draw_data draw,
+                   enum mesa_prim prim)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   struct kk_shader *tes = cmd->state.shaders[MESA_SHADER_TESS_EVAL];
+   const struct poly_gs_info *gsi = &vs->info.vs.geometry;
+   bool indirect = kk_grid_is_indirect(draw.grid);
+   uint64_t vertex_params = gfx->per_draw_data.vertex_params;
+   uint64_t geometry_params = gfx->per_draw_data.geometry_params;
+   uint64_t gs_group_grid = 0;
+
+   uint64_t preceding_outputs =
+      tes ? tes->info.tess.outputs_written : vs->info.vs.outputs_written;
+
+   if (indirect) {
+      struct kk_ptr group_grid = kk_pool_alloc(cmd, 3 * sizeof(uint32_t), 4);
+      if (unlikely(group_grid.cpu == NULL)) {
+         draw.grid = kk_grid_1d(0);
+         return draw;
+      }
+      gs_group_grid = group_grid.gpu;
+
+      struct libkk_gs_setup_indirect_args args = {
+         .index_buffer = draw.index.gpu.addr,
+         .draw = draw.grid.addr,
+         .vp = vertex_params,
+         .p = geometry_params,
+         .heap = kk_heap(cmd),
+         .vertex_outputs = preceding_outputs,
+         .index_size_B = draw.index.el_size_B,
+         .index_buffer_range_el =
+            draw.index.el_size_B
+               ? draw.index.gpu.range / draw.index.el_size_B
+               : 0,
+         .prim = prim,
+         .is_prefix_summing = gsi->prefix_sum,
+         .max_indices = gsi->max_indices,
+         .shape = gsi->shape,
+         .gs_group_grid = gs_group_grid,
+      };
+      libkk_gs_setup_indirect_struct(cmd, kk_grid_1d(1), true, args);
+   }
+
+   struct kk_grid grid_vs;
+   struct kk_grid grid_gs;
+   if (indirect) {
+      grid_vs = kk_grid_indirect(
+         vertex_params + offsetof(struct poly_vertex_params, grid));
+      grid_gs = kk_grid_indirect(gs_group_grid);
+   } else {
+      grid_vs = kk_grid_2d(draw.grid.size.x, draw.grid.size.y);
+      grid_gs = kk_grid_2d(
+         u_decomposed_prims_for_vertices(prim, draw.grid.size.x),
+         draw.grid.size.y);
+   }
+
+   mtl_compute_encoder *enc = cs_get_compute(cmd, true);
+   mtl_compute_pipeline_state *preceding =
+      vs->pipeline.gfx.pre_render[tes ? 2 : 0];
+   kk_dispatch_geometry_stage(
+      enc, preceding, grid_vs,
+      vertex_params + offsetof(struct poly_vertex_params, grid), 64, false);
+
+   /* The preceding vertex stage still runs for an incomplete input primitive,
+    * but Metal rejects a direct zero-sized compute dispatch. */
+   if (!indirect && (grid_gs.size.x == 0 || grid_gs.size.y == 0)) {
+      draw.grid = kk_grid_1d(0);
+      draw.index.gpu = (struct kk_addr_range){0};
+      draw.index.el_size_B = 0;
+      draw.vertex_offset = 0;
+      draw.primitive_type = mesa_prim_to_mtl_primitive_type(gsi->mode);
+      return draw;
+   }
+
+   bool query_active = false;
+   for (uint32_t i = 0; i < POLY_MAX_VERTEX_STREAMS; ++i)
+      query_active |= gfx->xfb.query[i] != 0;
+
+   if (gsi->xfb || query_active) {
+      if (gsi->count_words > 0) {
+         kk_dispatch_geometry_stage(
+            enc, vs->pipeline.gfx.geometry_count, grid_gs,
+            gs_group_grid, KK_GEOMETRY_THREADGROUP_WIDTH, true);
+      }
+
+      if (gsi->prefix_sum) {
+         libkk_prefix_sum_geom(cmd, kk_grid_1d(1024 * gsi->count_words), true,
+                               geometry_params);
+      }
+
+      kk_dispatch_geometry_stage(enc, vs->pipeline.gfx.geometry_pre_gs,
+                                 kk_grid_1d(1), 0, 1, false);
+   }
+
+   kk_dispatch_geometry_stage(
+      enc, vs->pipeline.gfx.geometry_main, grid_gs,
+      gs_group_grid, KK_GEOMETRY_THREADGROUP_WIDTH, true);
+
+   if (indirect) {
+      draw.grid = kk_grid_indirect(
+         geometry_params + offsetof(struct poly_geometry_params, draw));
+   } else {
+      draw.grid = kk_grid_3d(gfx->geometry.vertex_count,
+                             gfx->geometry.instance_count, 0);
+   }
+
+   draw.index.gpu = gfx->geometry.index;
+   draw.index.el_size_B =
+      gsi->shape == POLY_GS_SHAPE_STATIC_INDEXED
+         ? sizeof(uint32_t)
+         : poly_gs_index_size(gsi->shape);
+   draw.vertex_offset = 0;
+   draw.primitive_type = mesa_prim_to_mtl_primitive_type(gsi->mode);
+   return draw;
+}
+
 /* Get modifiable per draw data. */
 static struct kk_draw_data
 build_draw_data(struct kk_cmd_buffer *cmd, struct kk_draw_command *data,
                 uint32_t draw_id)
 {
    bool tess = cmd->state.shaders[MESA_SHADER_TESS_EVAL];
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   bool geometry = vs && vs->info.vs.geometry_shader_emulation;
    struct kk_draw_data draw = {
       .index.gpu = data->index_buffer,
       .index.el_size_B = data->index_buffer_el_size_B,
-      .primitive_type = tess ? 0u : mesa_prim_to_mtl_primitive_type(data->prim),
+      /* Geometry inputs, including adjacency topologies, are consumed by the
+       * compute emulation path.  Only its output primitive reaches Metal. */
+      .primitive_type = tess || geometry
+                           ? 0u
+                           : mesa_prim_to_mtl_primitive_type(data->prim),
    };
 
