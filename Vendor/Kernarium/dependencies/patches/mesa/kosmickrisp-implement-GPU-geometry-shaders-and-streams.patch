diff --git a/src/poly/nir/tests/test_gs_invocations.c b/src/poly/nir/tests/test_gs_invocations.c
new file mode 100644
index 0000000000000000000000000000000000000000..cdcabfc2314894a7b7d6cf9243af3dac7c0adab1
--- /dev/null
+++ b/src/poly/nir/tests/test_gs_invocations.c
@@ -0,0 +1,105 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "poly/nir/poly_nir.h"
+#include "compiler/nir/nir_builder.h"
+#include "util/ralloc.h"
+
+#include <assert.h>
+
+static void
+check_invocations(enum mesa_prim primitive, unsigned vertices,
+                  unsigned invocations, unsigned stream)
+{
+   const nir_shader_compiler_options options = {.max_unroll_iterations = 1024};
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_GEOMETRY, &options, "geometry_invocations");
+   nir_shader *gs = b.shader;
+   gs->info.gs.input_primitive = MESA_PRIM_POINTS;
+   gs->info.gs.output_primitive = primitive;
+   gs->info.gs.vertices_in = 1;
+   gs->info.gs.vertices_out = vertices;
+   gs->info.gs.invocations = invocations;
+   gs->info.gs.active_stream_mask = BITFIELD_BIT(stream);
+
+   /* No explicit primitive ending: every invocation completes every stream.
+    * Position-free output is legal with rasterizer discard. */
+   for (unsigned vertex = 0; vertex < vertices; vertex++)
+      nir_emit_vertex(&b, stream);
+
+   nir_shader *count = NULL, *raster = NULL, *pre_gs = NULL;
+   struct poly_gs_info info = {0};
+   poly_nir_lower_gs(gs, &count, &raster, &pre_gs, &info, false);
+
+   if (primitive == MESA_PRIM_LINE_STRIP) {
+      assert(vertices == 2 && invocations == 2 && stream == 1);
+      assert(info.shape == POLY_GS_SHAPE_STATIC_INDEXED);
+      assert(info.max_indices == 5);
+      const uint8_t expected[] = {1, 3, UINT8_MAX, 5, 7};
+      for (unsigned i = 0; i < ARRAY_SIZE(expected); i++)
+         assert(info.topology[i] == expected[i]);
+   } else {
+      assert(primitive == MESA_PRIM_POINTS);
+      assert(info.max_indices == vertices * invocations);
+      assert(info.shape == POLY_GS_SHAPE_STATIC_PER_PRIM);
+   }
+
+   nir_validate_shader(gs, "instanced GS producer");
+   nir_validate_shader(raster, "instanced GS consumer");
+   ralloc_free(count);
+   ralloc_free(raster);
+   ralloc_free(pre_gs);
+   ralloc_free(gs);
+}
+
+static void
+check_sparse_topology(void)
+{
+   const nir_shader_compiler_options options = {.max_unroll_iterations = 1024};
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_GEOMETRY, &options, "geometry_sparse_topology");
+   nir_shader *gs = b.shader;
+   gs->info.gs.input_primitive = MESA_PRIM_POINTS;
+   gs->info.gs.output_primitive = MESA_PRIM_LINE_STRIP;
+   gs->info.gs.vertices_in = 1;
+   gs->info.gs.vertices_out = 256;
+   gs->info.gs.invocations = 1;
+   gs->info.gs.active_stream_mask = 1;
+
+   /* Incomplete primitives advance vertex IDs without producing indices. The
+    * final complete line uses a value reserved for restart in the byte-sized
+    * serialized topology, despite having only two output indices.
+    */
+   for (unsigned vertex = 0; vertex < 254; vertex++) {
+      nir_emit_vertex(&b);
+      nir_end_primitive(&b);
+   }
+   nir_emit_vertex(&b);
+   nir_emit_vertex(&b);
+
+   nir_shader *count = NULL, *raster = NULL, *pre_gs = NULL;
+   struct poly_gs_info info = {0};
+   poly_nir_lower_gs(gs, &count, &raster, &pre_gs, &info, false);
+   assert(info.shape == POLY_GS_SHAPE_DYNAMIC_INDEXED);
+   assert(info.max_indices == 3); /* Includes the dynamic restart marker. */
+   nir_validate_shader(gs, "sparse GS producer");
+   nir_validate_shader(raster, "sparse GS consumer");
+   ralloc_free(count);
+   ralloc_free(raster);
+   ralloc_free(pre_gs);
+   ralloc_free(gs);
+}
+
+int
+main(void)
+{
+   check_invocations(MESA_PRIM_LINE_STRIP, 2, 2, 1);
+   /* Instancing makes valid per-invocation output bounds exceed the small
+    * static-topology scratch allocation. */
+   check_invocations(MESA_PRIM_POINTS, 256, 2, 0);
+   check_invocations(MESA_PRIM_POINTS, 512, 1, 0);
+   check_sparse_topology();
+   return 0;
+}
