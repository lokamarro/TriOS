-static void
-kk_init_heap(const void *data)
+/* The geometry heap holds what the emulated stages reserve on the GPU: unrolled
+ * index buffers, tessellated domain points and indices, geometry and line
+ * outputs. A render segment resets it after its work, so a heap only has to
+ * hold one segment's reservations.
+ *
+ * It starts at 16 MiB, because a Venus host pays it once per guest VkDevice
+ * that draws through it. The heaviest command buffer in the CTS
+ * tessellation, geometry, draw and rasterization groups asks it for 1.53 MiB,
+ * but demand is linear in patches and primitives, which the API does not
+ * bound, and 130 quad patches at level 64 already need 17.2 MB. So the heap
+ * grows, at least doubling, up to a cap:
+ *
+ * - A direct draw whose reservations the host can bound, the restart unroll
+ *   and tessellation at the largest level its TCS can write, grows it before
+ *   it is recorded and renders on its first submission. A bound past the cap
+ *   grows the heap to the cap, and the GPU reports the rest.
+ * - A reservation only the GPU can size is refused when it does not fit, and
+ *   its draw loses its output: kernels that reserve suppress their draw
+ *   instead of aborting, because a shader abort() ends only the invocation
+ *   that calls it. The header counts refusals and what each refused render
+ *   segment needed, what it reserved plus every size it was refused, and the
+ *   next draw that pins the heap, or the reset of a recording that used it,
+ *   grows it for later command buffers to hold that in one step. The first
+ *   loss is logged once per device. Vulkan has no way to fail a command
+ *   buffer after it ran short of losing the device, so none fails.
+ *
+ * MESA_KK_HEAP_SIZE_MIB sets the starting size. The header's size is 32-bit,
+ * so only 1 to 4095 MiB is honoured, and any other value keeps 16 MiB. The cap
+ * is 128 MiB or the starting size, whichever is larger. */
+#define KK_HEAP_START_MIB   16u
+#define KK_HEAP_MIN_CAP_MIB 128u
+
+static uint64_t
+kk_heap_start_B(void)
 {
-   struct kk_cmd_buffer *cmd = (struct kk_cmd_buffer *)data;
-   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   uint64_t mib = KK_HEAP_START_MIB;
+   const char *size_override = getenv("MESA_KK_HEAP_SIZE_MIB");
+   if (size_override != NULL) {
+      long requested = strtol(size_override, NULL, 10);
+      if (requested >= 1 && requested <= 4095)
+         mib = (uint64_t)requested;
+   }
+   return mib << 20;
+}
 
-   size_t size = 128 * 1024 * 1024;
-   kk_alloc_bo(dev, &dev->vk.base, size, 0, &dev->heap);
+static struct kk_geometry_heap *
+kk_geometry_heap_create(struct kk_device *dev, uint64_t size_B)
+{
+   struct kk_geometry_heap *heap = calloc(1, sizeof(*heap));
+   if (heap == NULL)
+      return NULL;
 
-   struct poly_heap *map = (struct poly_heap *)dev->heap->cpu;
+   if (kk_alloc_bo(dev, &dev->vk.base, size_B, 0, &heap->bo) != VK_SUCCESS) {
+      free(heap);
+      return NULL;
+   }
+
+   heap->usable_B = size_B - sizeof(struct poly_heap);
+   heap->refcount = 1;
+   const uint64_t live_B =
+      p_atomic_add_return(&dev->heap_live_B, heap->bo->size_B);
+   dev->heap_peak_B = MAX2(dev->heap_peak_B, live_B);
 
    /* TODO_KOSMICKRISP Self-contained until we have rodata at the device. */
-   *map = (struct poly_heap){
-      .base = dev->heap->gpu + sizeof(struct poly_heap),
-      .size = size - sizeof(struct poly_heap),
+   *(struct poly_heap *)heap->bo->cpu = (struct poly_heap){
+      .base = heap->bo->gpu + sizeof(struct poly_heap),
+      .size = heap->usable_B,
    };
+   return heap;
+}
+
+static void
+kk_geometry_heap_free(struct kk_device *dev, struct kk_geometry_heap *heap)
+{
+   p_atomic_add(&dev->heap_live_B, -(int64_t)heap->bo->size_B);
+   kk_destroy_bo(dev, heap->bo);
+   free(heap);
+}
+
+void
+kk_geometry_heap_unref(struct kk_device *dev, struct kk_geometry_heap *heap)
+{
+   simple_mtx_lock(&dev->heap_lock);
+   assert(heap->refcount > 0);
+   const bool last = --heap->refcount == 0;
+   simple_mtx_unlock(&dev->heap_lock);
+
+   if (last)
+      kk_geometry_heap_free(dev, heap);
 }
 
+/* Takes the refusals the GPU counted in a heap since the host last read them,
+ * asks the next pin to grow the heap by what they needed, and logs the first
+ * loss. Called with heap_lock held. */
+static void
+kk_heap_observe_locked(struct kk_device *dev, struct kk_geometry_heap *heap)
+{
+   /* struct poly_heap is packed, so its words are read through a plain
+    * pointer. */
+   const uint32_t *words = heap->bo->cpu;
+   const uint32_t refusals =
+      p_atomic_read(&words[offsetof(struct poly_heap, refusals) / 4]);
+   if (refusals == heap->seen_refusals)
+      return;
+
+   /* Every render segment that was refused needed what it reserved plus
+    * every size it was refused. The GPU folded each segment the heap has
+    * reset since into needed_units; the one still open is its bottom and
+    * refused sizes. Growing to hold the larger holds each of them. */
+   const uint64_t needed_B =
+      (uint64_t)p_atomic_read(
+         &words[offsetof(struct poly_heap, needed_units) / 4]) *
+      16u;
+   const uint64_t open_B =
+      p_atomic_read(&words[offsetof(struct poly_heap, bottom) / 4]) +
+      (uint64_t)p_atomic_read(
+         &words[offsetof(struct poly_heap, segment_refused_units) / 4]) *
+         16u;
+   heap->seen_refusals = refusals;
+   dev->heap_wanted_B =
+      MAX2(dev->heap_wanted_B, MAX2(needed_B, open_B));
+
+   if (!dev->heap_loss_reported) {
+      dev->heap_loss_reported = true;
+      fprintf(stderr,
+              "KosmicKrisp's %u MiB geometry heap refused a reservation, and "
+              "the draw that made it lost its output; later command buffers "
+              "get a heap of up to %u MiB, which MESA_KK_HEAP_SIZE_MIB "
+              "raises\n",
+              (unsigned)((heap->usable_B + sizeof(struct poly_heap)) >> 20),
+              (unsigned)(dev->heap_cap_B >> 20));
+   }
+}
+
+/* The size of a heap whose usable size exceeds want_B, in one step however
+ * far that is, at least floor_B and at most the cap. */
 static uint64_t
-kk_heap(struct kk_cmd_buffer *cmd)
+kk_heap_size_for(const struct kk_device *dev, uint64_t floor_B,
+                 uint64_t want_B)
+{
+   /* The GPU grants a reservation only if it ends before the usable size. */
+   const uint64_t size_B =
+      MAX2(floor_B,
+           util_next_power_of_two64(want_B + sizeof(struct poly_heap) + 16u));
+   return MIN2(size_B, dev->heap_cap_B);
+}
+
+/* Creates the device's first heap, at the starting size or, when the draw
+ * that asks for it already needs more, at the size that holds it. Called
+ * with heap_lock held. */
+static void
+kk_heap_create_first_locked(struct kk_device *dev, uint64_t want_B)
+{
+   dev->heap_attempted = true;
+   const uint64_t start_B = kk_heap_start_B();
+   dev->heap_cap_B = MAX2(start_B, (uint64_t)KK_HEAP_MIN_CAP_MIB << 20);
+
+   const uint64_t size_B = kk_heap_size_for(dev, start_B, want_B);
+   dev->heap = kk_geometry_heap_create(dev, size_B);
+   if (dev->heap == NULL && size_B > start_B)
+      dev->heap = kk_geometry_heap_create(dev, start_B);
+}
+
+/* Replaces the device's heap with one whose usable size exceeds want_B, at
+ * least twice the old size and at most the cap, and returns the old heap when
+ * nothing else holds it, for the caller to free once it has unlocked. When
+ * Metal refuses the larger heap the device keeps the one it has and stops
+ * growing. Called with heap_lock held. */
+static struct kk_geometry_heap *
+kk_heap_grow_locked(struct kk_device *dev, uint64_t want_B)
+{
+   struct kk_geometry_heap *old = dev->heap;
+   const uint64_t old_B = old->usable_B + sizeof(struct poly_heap);
+   if (want_B < old->usable_B || old_B >= dev->heap_cap_B)
+      return NULL;
+
+   const uint64_t size_B = kk_heap_size_for(dev, old_B * 2u, want_B);
+   struct kk_geometry_heap *heap = kk_geometry_heap_create(dev, size_B);
+   if (heap == NULL) {
+      dev->heap_cap_B = old_B;
+      return NULL;
+   }
+
+   dev->heap = heap;
+   assert(old->refcount > 0);
+   return --old->refcount == 0 ? old : NULL;
+}
+
+/* Pins a heap for the render segment being recorded, grown first to hold
+ * direct_B, the most the draw about to be recorded is known to reserve, and
+ * whatever refusals asked for, and queues the heap's reset for the segment.
+ * A draw that does not fit beside the segment's earlier ones moves the
+ * segment to the grown heap; those already recorded keep theirs. A call that
+ * knows no bound, from a stage re-pinning after a render encoder restarted
+ * inside its draw, keeps the heap the draw's earlier stages reserved from,
+ * however another recording has grown the device's. Only a device with no
+ * heap at all fails the draw, and its recording. */
+static bool
+kk_heap_prepare(struct kk_cmd_buffer *cmd, uint64_t direct_B)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+
+   if (cmd->heap_in_segment &&
+       cmd->heap_demand_B + direct_B < cmd->heap->usable_B) {
+      cmd->heap_demand_B += direct_B;
+      return true;
+   }
+
+   simple_mtx_lock(&dev->heap_lock);
+   if (!dev->heap_attempted)
+      kk_heap_create_first_locked(dev, MAX2(dev->heap_wanted_B, direct_B));
+   if (dev->heap == NULL) {
+      simple_mtx_unlock(&dev->heap_lock);
+      vk_command_buffer_set_error(&cmd->vk, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      return false;
+   }
+
+   /* A draw that does not fit beside the segment's earlier draws on the
+    * device's heap needs a larger one, which it then starts on alone. */
+   kk_heap_observe_locked(dev, dev->heap);
+   const uint64_t need_B = cmd->heap_in_segment && cmd->heap == dev->heap
+                              ? cmd->heap_demand_B + direct_B
+                              : direct_B;
+   struct kk_geometry_heap *retired =
