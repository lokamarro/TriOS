new file mode 100644
index 0000000000000000000000000000000000000000..65ad692a99d258a32b9bcb17037d6dc25ee12d72
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_tess_bound.h
@@ -0,0 +1,53 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include "compiler/shader_enums.h"
+#include "util/macros.h"
+
+#include <math.h>
+#include <stdint.h>
+
+/* The most domain points and indices the tessellator gives one patch of the
+ * domain when no level it reads exceeds max_level, or any level up to 64
+ * when max_level is 64 or more.
+ *
+ * Below 62 the bound is generous rather than exact. The tessellator rounds a
+ * level up to an integer, or to an odd or even one for fractional
+ * partitioning, and treats an inner level of 1 beside a larger outer one as
+ * 2 or 3, so no level it uses exceeds l = max(ceil(max_level) + 1, 2). The
+ * bound is the domain's count with every level at l, and at 62 or more the
+ * count at 64. kosmickrisp_tess_bound_gpu checks it against the tessellator
+ * for every domain and partitioning. */
+static inline void
+kk_tess_patch_bound(enum tess_primitive_mode mode, float max_level,
+                    uint32_t *points, uint32_t *indices)
+{
+   const uint32_t l =
+      max_level < 62.0f
+         ? MAX2((uint32_t)ceilf(MAX2(max_level, 0.0f)) + 1, 2)
+         : 64;
+
+   switch (mode) {
+   case TESS_PRIMITIVE_QUADS:
+      /* (l + 1)^2 points, two triangles per unit square. */
+      *points = (l + 1) * (l + 1);
+      *indices = l * l * 2 * 3;
+      break;
+   case TESS_PRIMITIVE_ISOLINES:
+      /* l lines of l + 1 points, l segments each. */
+      *points = l * (l + 1);
+      *indices = l * l * 2;
+      break;
+   default:
+      /* Rings of 3(l - 2k) points around the centre, 3(l^2 / 4 + l / 2) + 1
+       * points for even l and fewer for odd, and at most 1.5 l^2
+       * triangles. */
+      *points = (3 * l * l + 6 * l + 4 + 3) / 4;
+      *indices = (3 * l * l + 1) / 2 * 3;
+      break;
+   }
+}
