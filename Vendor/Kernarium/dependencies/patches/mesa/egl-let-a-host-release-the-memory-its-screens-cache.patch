 dri_context_trim(struct dri_context *ctx);
 
+/* Frees what every screen of the process keeps for reuse and nothing uses,
+ * from any thread. Returns the number of cached allocations released. */
+PUBLIC unsigned
+dri_release_cached_memory(void);
+
 PUBLIC int
 dri_interop_query_device_info(struct dri_context *ctx,
                               struct mesa_glinterop_device_info *out);
diff --git a/src/gallium/include/pipe/p_screen.h b/src/gallium/include/pipe/p_screen.h
index f17ea2110a42e6ae9c587814bf12aa6b065c986c..3d9571d71484a11361dcf3b348ec6fbd7c23801a 100644
--- a/src/gallium/include/pipe/p_screen.h
+++ b/src/gallium/include/pipe/p_screen.h
@@ -640,6 +640,21 @@ struct pipe_screen {
                              unsigned int nrects,
                              const struct pipe_box *rects);
 
+   /**
+    * Free the memory the driver keeps for reuse and nothing uses.
+    *
+    * A driver caches what its clients freed (buffers, slab backing) so that
+    * the next allocation is cheap, and holds on to it until a client frees
+    * enough or the cache expires. A host that bounds the memory it gives out
+    * calls this for a screen that is not the one asking, when another's
+    * allocation was refused. Optional. May be called from any thread, with
+    * no context current, while the screen allocates and frees; it never
+    * waits for the device.
+    *
+    * \return the number of cached allocations released.
+    */
+   unsigned (*release_cached_memory)(struct pipe_screen *screen);
+
    /**
     * Run driver-specific NIR lowering and optimization passes.
     *
