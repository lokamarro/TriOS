+++ b/src/gallium/drivers/zink/zink_bo.c
@@ -183,12 +183,27 @@ bo_slab_destroy(struct zink_screen *screen, struct zink_bo *bo)
    pb_slab_free(&screen->pb.bo_slabs, &bo->u.slab.entry);
 }
 
-static bool
-clean_up_buffer_managers(struct zink_screen *screen)
+static unsigned
+release_cached_buffers(struct zink_screen *screen)
 {
    unsigned num_reclaims = pb_slabs_reclaim(&screen->pb.bo_slabs);
    num_reclaims += pb_cache_release_all_buffers(&screen->pb.bo_cache);
-   return !!num_reclaims;
+   return num_reclaims;
+}
+
+static bool
+clean_up_buffer_managers(struct zink_screen *screen)
+{
+   return !!release_cached_buffers(screen);
+}
+
+/* Frees what the screen's buffer managers keep for reuse. It takes only the
+ * locks that zink_bo_create takes when an allocation fails, and runs on
+ * whatever thread asks. */
+unsigned
+zink_bo_release_cached(struct zink_screen *screen)
+{
+   return release_cached_buffers(screen);
 }
 
