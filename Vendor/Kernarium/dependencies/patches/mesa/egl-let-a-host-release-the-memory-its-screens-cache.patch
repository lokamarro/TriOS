    screen->total_video_mem = get_video_mem(screen);
diff --git a/src/gallium/frontends/dri/dri_screen.c b/src/gallium/frontends/dri/dri_screen.c
index 7855f4b2b27d6795de4cbe7795d54ed669dcfba7..5c3ffe2088ac21243bdf8a526734fa6476ddaeb9 100644
--- a/src/gallium/frontends/dri/dri_screen.c
+++ b/src/gallium/frontends/dri/dri_screen.c
@@ -33,6 +33,7 @@
 #include "dri_context.h"
 #include "dri_helpers.h"
 
+#include "util/simple_mtx.h"
 #include "util/u_inlines.h"
 #include "pipe/p_screen.h"
 #include "util/format/u_formats.h"
@@ -573,9 +574,53 @@ dri_get_param(struct pipe_frontend_screen *fscreen,
    return 0;
 }
 
+/* The screens that can release cached memory, for dri_release_cached_memory().
+ * A screen leaves the list before it is destroyed, under the same lock, so a
+ * release in progress never meets a screen that is going away. */
+static simple_mtx_t cached_memory_mutex = SIMPLE_MTX_INITIALIZER;
+static struct list_head cached_memory_screens =
+   { &cached_memory_screens, &cached_memory_screens };
+
+unsigned
+dri_release_cached_memory(void)
+{
+   unsigned released = 0;
+
+   simple_mtx_lock(&cached_memory_mutex);
+   list_for_each_entry(struct dri_screen, screen, &cached_memory_screens,
+                       cached_memory_link) {
+      released += screen->base.screen->release_cached_memory(screen->base.screen);
+   }
+   simple_mtx_unlock(&cached_memory_mutex);
+
+   return released;
+}
+
+static void
+dri_register_cached_memory(struct dri_screen *screen)
+{
+   if (!screen->base.screen->release_cached_memory)
+      return;
+
+   simple_mtx_lock(&cached_memory_mutex);
+   list_addtail(&screen->cached_memory_link, &cached_memory_screens);
+   simple_mtx_unlock(&cached_memory_mutex);
+}
+
+static void
+dri_unregister_cached_memory(struct dri_screen *screen)
+{
+   simple_mtx_lock(&cached_memory_mutex);
+   if (list_is_linked(&screen->cached_memory_link))
+      list_del(&screen->cached_memory_link);
+   simple_mtx_unlock(&cached_memory_mutex);
+}
+
 void
 dri_release_screen(struct dri_screen * screen)
 {
+   dri_unregister_cached_memory(screen);
+
    st_screen_destroy(&screen->base);
 
    if (screen->base.screen) {
@@ -624,6 +669,7 @@ dri_init_screen(struct dri_screen *screen,
                 bool has_multibuffer)
 {
    screen->base.screen = pscreen;
+   dri_register_cached_memory(screen);
    screen->base.get_egl_image = dri_get_egl_image;
    screen->base.get_param = dri_get_param;
    screen->base.set_background_context = dri_set_background_context;
