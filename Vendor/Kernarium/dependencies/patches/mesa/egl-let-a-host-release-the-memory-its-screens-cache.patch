diff --git a/src/egl/main/eglapi.c b/src/egl/main/eglapi.c
index 71d763caded442d31164d3dd30f12c17bae193c7..e7caae051a8351a59fc40b4bc311807da0df2730 100644
--- a/src/egl/main/eglapi.c
+++ b/src/egl/main/eglapi.c
@@ -1665,6 +1665,25 @@ eglTrimContextMESA(void)
    RETURN_EGL_EVAL(disp, ret);
 }
 
+/**
+ * EGL_MESA_context_trim: free the memory that the driver screens of the
+ * process keep for reuse and nothing uses, and return how many cached
+ * allocations that released.  A host that bounds the memory it hands out
+ * calls it when an allocation was refused, from any thread, with or without a
+ * current context.  It does not lock a display: surface and image creation
+ * allocate while holding one, and a refusal there is what calls it.
+ */
+static EGLint EGLAPIENTRY
+eglReleaseCachedMemoryMESA(void)
+{
+   _EGL_FUNC_START(NULL, EGL_OBJECT_THREAD_KHR, NULL);
+
+   if (!_eglDriver.ReleaseCachedMemoryMESA)
+      RETURN_EGL_ERROR(NULL, EGL_BAD_ACCESS, 0);
+
+   RETURN_EGL_SUCCESS(NULL, _eglDriver.ReleaseCachedMemoryMESA());
+}
+
 PUBLIC EGLBoolean EGLAPIENTRY
 eglWaitGL(void)
 {
