new file mode 100755
index 0000000000000000000000000000000000000000..c2020fe8490e939ab59c068b8fe113ed717f17a1
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/generate-shaders.sh
@@ -0,0 +1,28 @@
+#!/bin/sh
+# SPDX-License-Identifier: MIT
+#
+# Compiles each GLSL shader in the given *_shaders directories, all of them
+# by default, to the SPIR-V header the tests include: <shader>.h beside
+# <shader>.  A directory with a generate.sh of its own builds its headers
+# with it instead.
+set -eu
+cd -- "$(dirname -- "$0")"
+# These two directories' headers are built without -O.
+no_optimize="max_varyings_shaders primitive_id_link_shaders"
+[ "$#" -gt 0 ] || set -- *_shaders
+for dir in "$@"; do
+   dir=${dir%/}
+   if [ -e "$dir/generate.sh" ]; then
+      sh "$dir/generate.sh"
+      continue
+   fi
+   optimize=-O
+   case " $no_optimize " in *" $dir "*) optimize= ;; esac
+   (
+      cd -- "$dir"
+      for shader in *.vert *.tesc *.tese *.geom *.frag *.comp; do
+         [ -e "$shader" ] || continue
+         glslc $optimize --target-env=vulkan1.3 -mfmt=c "$shader" -o "$shader.h"
+      done
+   )
+done
