+
+/* A command pool of the device's queue family, created with `flags`, and
+ * one primary command buffer allocated from it. */
+static inline void
+kk_test_command_buffer(const struct kk_test_device *t,
+                       VkCommandPoolCreateFlags flags, VkCommandPool *pool,
+                       VkCommandBuffer *command)
+{
+   VkCommandPoolCreateInfo pool_info = {
+      VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+   pool_info.flags = flags;
+   pool_info.queueFamilyIndex = t->queue_family;
+   PFN_vkCreateCommandPool create_command_pool =
+      (PFN_vkCreateCommandPool)kk_test_device_proc(t, "vkCreateCommandPool");
+   VK_CHECK(create_command_pool(t->device, &pool_info, NULL, pool));
+   VkCommandBufferAllocateInfo allocate = {
+      VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+   allocate.commandPool = *pool;
+   allocate.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+   allocate.commandBufferCount = 1;
+   PFN_vkAllocateCommandBuffers allocate_command_buffers =
+      (PFN_vkAllocateCommandBuffers)kk_test_device_proc(
+         t, "vkAllocateCommandBuffers");
+   VK_CHECK(allocate_command_buffers(t->device, &allocate, command));
+}
+
+/* Submits `command` to the device's queue with a fence and waits up to
+ * `timeout` nanoseconds for it; returns what the wait returned.  A fence the
+ * wait gave up on is left alone, since the GPU may still signal it. */
+static inline VkResult
+kk_test_submit_and_wait(const struct kk_test_device *t,
+                        VkCommandBuffer command, uint64_t timeout)
+{
+   PFN_vkCreateFence create_fence =
+      (PFN_vkCreateFence)kk_test_device_proc(t, "vkCreateFence");
+   PFN_vkQueueSubmit queue_submit =
+      (PFN_vkQueueSubmit)kk_test_device_proc(t, "vkQueueSubmit");
+   PFN_vkWaitForFences wait_for_fences =
+      (PFN_vkWaitForFences)kk_test_device_proc(t, "vkWaitForFences");
+   PFN_vkDestroyFence destroy_fence =
+      (PFN_vkDestroyFence)kk_test_device_proc(t, "vkDestroyFence");
+   VkFenceCreateInfo fence_info = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+   VkFence fence = VK_NULL_HANDLE;
+   VK_CHECK(create_fence(t->device, &fence_info, NULL, &fence));
+   VkSubmitInfo submit = {VK_STRUCTURE_TYPE_SUBMIT_INFO};
+   submit.commandBufferCount = 1;
+   submit.pCommandBuffers = &command;
+   VK_CHECK(queue_submit(t->queue, 1, &submit, fence));
+   VkResult result = wait_for_fences(t->device, 1, &fence, VK_TRUE, timeout);
+   if (result == VK_SUCCESS)
+      destroy_fence(t->device, fence, NULL);
+   return result;
+}
