diff --git a/src/kosmickrisp/vulkan/tests/kk_test.h b/src/kosmickrisp/vulkan/tests/kk_test.h
new file mode 100644
index 0000000000000000000000000000000000000000..2cdadaf4e30d16a001bd37da9b45bb0c8795a21a
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/kk_test.h
@@ -0,0 +1,469 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Checks shared by the KosmicKrisp tests.  Each one names the failed
+ * expression and aborts, in every build: assert() compiles away under NDEBUG,
+ * and some checks - a wait for Metal to finish with a stack-allocated
+ * completion, for example - have to run for the test to be safe at all.
+ *
+ * LOAD_I and LOAD_D fetch an entry point into a local of the same name from
+ * the `instance` or `device` in scope and fail when the driver lacks it.
+ *
+ * struct kk_test_device holds the setup every Vulkan-level test repeats: a
+ * Vulkan 1.3 instance, the one physical device an Apple host exposes, its
+ * first graphics queue family with that family's properties, its memory
+ * properties, and a device with one queue of that family.
+ * kk_test_create_instance() fills the first half, so a test can query the
+ * physical device before it chooses what the device enables, and
+ * kk_test_create_device() the second.  A test passes its own feature chain,
+ * features and extensions; the fixture enables nothing else.
+ * KK_LOAD_DEVICE_FUNCTIONS(t) declares `device`, `vkGetDeviceProcAddr` and the
+ * common device entry points below as locals for the device `t` holds, so call
+ * sites stay vkCreateImage(device, ...); LOAD_D fetches any other.
+ *
+ * kk_test_buffer(), kk_test_image_memory() and kk_test_image_view() make the
+ * resources most tests need: a buffer with its own memory, optionally mapped,
+ * the memory of an image the test created from its own VkImageCreateInfo, and
+ * a view of one mip level of it.  A resource that needs a pNext chain on the
+ * buffer, the allocation or the view keeps its own code. */
+
+#pragma once
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <vulkan/vulkan_core.h>
+
+#ifdef __cplusplus
+extern "C"
+#endif
+PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+#define CHECK(condition)                                                       \
+   do {                                                                        \
+      if (!(condition)) {                                                      \
+         fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__,      \
+                 #condition);                                                  \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+
+#define VK_CHECK(expr)                                                         \
+   do {                                                                        \
+      VkResult result_ = (expr);                                               \
+      if (result_ != VK_SUCCESS) {                                             \
+         fprintf(stderr, "%s:%d: %s = %d\n", __FILE__, __LINE__, #expr,        \
+                 result_);                                                     \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+
+#ifdef __cplusplus
+
+/* The C++ tests report an operation and its result and exit with status 1. */
+static inline void
+require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (!ok) {
+      fprintf(stderr, "%s: %d\n", operation, value);
+      exit(1);
+   }
+}
+
+template <typename T>
+static inline T
+load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+#define LOAD_D(name)                                                           \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+
+#else
+
+#define LOAD_I(name)                                                           \
+   PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name);       \
+   CHECK(name)
+#define LOAD_D(name)                                                           \
+   PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name);           \
+   CHECK(name)
+
+#endif
+
+struct kk_test_device {
+   VkInstance instance;
+   VkPhysicalDevice physical;
+   uint32_t queue_family;
+   VkQueueFamilyProperties queue_family_properties;
+   VkPhysicalDeviceMemoryProperties memory;
+   PFN_vkGetDeviceProcAddr get_device_proc_addr;
+   VkDevice device;
+   VkQueue queue;
+};
+
+static inline PFN_vkVoidFunction
+kk_test_instance_proc(const struct kk_test_device *t, const char *name)
+{
+   PFN_vkVoidFunction function = vkGetInstanceProcAddr(t->instance, name);
+   if (!function) {
+      fprintf(stderr, "%s: missing %s\n", __FILE__, name);
+      abort();
+   }
+   return function;
+}
+
+static inline PFN_vkVoidFunction
+kk_test_device_proc(const struct kk_test_device *t, const char *name)
+{
+   PFN_vkVoidFunction function = t->get_device_proc_addr(t->device, name);
+   if (!function) {
+      fprintf(stderr, "%s: missing %s\n", __FILE__, name);
+      abort();
+   }
+   return function;
+}
+
+/* Creates the instance, named `name`, with `next` and the given instance
+ * extensions, and picks the physical device and its graphics queue family. */
+static inline void
+kk_test_create_instance_ext(struct kk_test_device *t, const char *name,
+                            const void *next, uint32_t extension_count,
+                            const char *const *extensions)
+{
+   memset(t, 0, sizeof(*t));
+   VkApplicationInfo app = {VK_STRUCTURE_TYPE_APPLICATION_INFO};
+   app.pApplicationName = name;
+   app.apiVersion = VK_API_VERSION_1_3;
+   VkInstanceCreateInfo info = {VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+   info.pNext = next;
+   info.pApplicationInfo = &app;
+   info.enabledExtensionCount = extension_count;
+   info.ppEnabledExtensionNames = extensions;
+   PFN_vkCreateInstance create_instance =
+      (PFN_vkCreateInstance)kk_test_instance_proc(t, "vkCreateInstance");
+   VK_CHECK(create_instance(&info, NULL, &t->instance));
+
+   PFN_vkEnumeratePhysicalDevices enumerate_physical_devices =
+      (PFN_vkEnumeratePhysicalDevices)kk_test_instance_proc(
+         t, "vkEnumeratePhysicalDevices");
+   uint32_t count = 0;
+   VK_CHECK(enumerate_physical_devices(t->instance, &count, NULL));
+   CHECK(count == 1);
+   VK_CHECK(enumerate_physical_devices(t->instance, &count, &t->physical));
+
+   PFN_vkGetPhysicalDeviceQueueFamilyProperties get_families =
+      (PFN_vkGetPhysicalDeviceQueueFamilyProperties)kk_test_instance_proc(
+         t, "vkGetPhysicalDeviceQueueFamilyProperties");
+   uint32_t family_count = 0;
+   get_families(t->physical, &family_count, NULL);
+   VkQueueFamilyProperties *families =
+      (VkQueueFamilyProperties *)calloc(family_count, sizeof(*families));
+   CHECK(families);
+   get_families(t->physical, &family_count, families);
+   while (t->queue_family < family_count &&
+          !(families[t->queue_family].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+      t->queue_family++;
+   CHECK(t->queue_family < family_count);
+   t->queue_family_properties = families[t->queue_family];
+   free(families);
+
+   PFN_vkGetPhysicalDeviceMemoryProperties get_memory_properties =
+      (PFN_vkGetPhysicalDeviceMemoryProperties)kk_test_instance_proc(
+         t, "vkGetPhysicalDeviceMemoryProperties");
+   get_memory_properties(t->physical, &t->memory);
+   t->get_device_proc_addr = (PFN_vkGetDeviceProcAddr)kk_test_instance_proc(
+      t, "vkGetDeviceProcAddr");
+}
+
+static inline void
+kk_test_create_instance(struct kk_test_device *t, const char *name)
+{
+   kk_test_create_instance_ext(t, name, NULL, 0, NULL);
+}
+
+/* Creates the device, with one queue of the graphics family, from `next`,
+ * `features` and the given device extensions. */
+static inline void
+kk_test_create_device(struct kk_test_device *t, const void *next,
+                      const VkPhysicalDeviceFeatures *features,
+                      uint32_t extension_count,
+                      const char *const *extensions)
+{
+   const float priority = 1.0f;
+   VkDeviceQueueCreateInfo queue_info = {
+      VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+   queue_info.queueFamilyIndex = t->queue_family;
+   queue_info.queueCount = 1;
+   queue_info.pQueuePriorities = &priority;
+   VkDeviceCreateInfo info = {VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+   info.pNext = next;
+   info.queueCreateInfoCount = 1;
+   info.pQueueCreateInfos = &queue_info;
+   info.enabledExtensionCount = extension_count;
+   info.ppEnabledExtensionNames = extensions;
+   info.pEnabledFeatures = features;
+   PFN_vkCreateDevice create_device =
+      (PFN_vkCreateDevice)kk_test_instance_proc(t, "vkCreateDevice");
+   VK_CHECK(create_device(t->physical, &info, NULL, &t->device));
+   PFN_vkGetDeviceQueue get_device_queue =
+      (PFN_vkGetDeviceQueue)kk_test_device_proc(t, "vkGetDeviceQueue");
+   get_device_queue(t->device, t->queue_family, 0, &t->queue);
+}
+
+/* Destroys the device, which a test may then create again. */
+static inline void
+kk_test_destroy_device(struct kk_test_device *t)
+{
+   PFN_vkDestroyDevice destroy_device =
+      (PFN_vkDestroyDevice)kk_test_device_proc(t, "vkDestroyDevice");
+   destroy_device(t->device, NULL);
+   t->device = VK_NULL_HANDLE;
+   t->queue = VK_NULL_HANDLE;
+}
+
+/* Destroys the device, when there is one, and the instance. */
+static inline void
+kk_test_destroy(struct kk_test_device *t)
+{
+   if (t->device)
+      kk_test_destroy_device(t);
+   PFN_vkDestroyInstance destroy_instance =
+      (PFN_vkDestroyInstance)kk_test_instance_proc(t, "vkDestroyInstance");
+   destroy_instance(t->instance, NULL);
+   t->instance = VK_NULL_HANDLE;
+}
+
+/* The first memory type in `bits` that has every flag in `flags`. */
+static inline uint32_t
+kk_test_memory_type(const struct kk_test_device *t, uint32_t bits,
+                    VkMemoryPropertyFlags flags)
+{
+   for (uint32_t type = 0; type < t->memory.memoryTypeCount; type++) {
+      if ((bits & (1u << type)) &&
+          (t->memory.memoryTypes[type].propertyFlags & flags) == flags)
+         return type;
+   }
+   fprintf(stderr, "%s: no memory type in 0x%x with 0x%x\n", __FILE__, bits,
+           flags);
+   abort();
+}
+
+/* The memory a test reads and writes through a mapping. */
+#define KK_TEST_HOST_MEMORY                                                    \
+   (VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)
+
+/* A buffer of `size` bytes and `usage`, bound at offset 0 to an allocation of
+ * its own from the first memory type with every flag in `memory_flags`.  A
+ * non-NULL `mapped` receives the address of a mapping of the whole
+ * allocation. */
+static inline void
+kk_test_buffer(const struct kk_test_device *t, VkDeviceSize size,
+               VkBufferUsageFlags usage, VkMemoryPropertyFlags memory_flags,
+               VkBuffer *buffer, VkDeviceMemory *memory, void **mapped)
+{
+   VkBufferCreateInfo info = {VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+   info.size = size;
+   info.usage = usage;
+   PFN_vkCreateBuffer create_buffer =
+      (PFN_vkCreateBuffer)kk_test_device_proc(t, "vkCreateBuffer");
+   PFN_vkGetBufferMemoryRequirements get_requirements =
+      (PFN_vkGetBufferMemoryRequirements)kk_test_device_proc(
+         t, "vkGetBufferMemoryRequirements");
+   PFN_vkAllocateMemory allocate_memory =
+      (PFN_vkAllocateMemory)kk_test_device_proc(t, "vkAllocateMemory");
+   PFN_vkBindBufferMemory bind_buffer_memory =
+      (PFN_vkBindBufferMemory)kk_test_device_proc(t, "vkBindBufferMemory");
+   VK_CHECK(create_buffer(t->device, &info, NULL, buffer));
+   VkMemoryRequirements requirements;
+   get_requirements(t->device, *buffer, &requirements);
+   VkMemoryAllocateInfo allocate = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+   allocate.allocationSize = requirements.size;
+   allocate.memoryTypeIndex =
+      kk_test_memory_type(t, requirements.memoryTypeBits, memory_flags);
+   VK_CHECK(allocate_memory(t->device, &allocate, NULL, memory));
+   VK_CHECK(bind_buffer_memory(t->device, *buffer, *memory, 0));
+   if (mapped) {
+      PFN_vkMapMemory map_memory =
+         (PFN_vkMapMemory)kk_test_device_proc(t, "vkMapMemory");
+      VK_CHECK(map_memory(t->device, *memory, 0, VK_WHOLE_SIZE, 0, mapped));
+   }
+}
+
+/* An allocation of its own for `image`, from the first memory type with every
+ * flag in `memory_flags`, bound to it at offset 0. */
+static inline VkDeviceMemory
+kk_test_image_memory(const struct kk_test_device *t, VkImage image,
+                     VkMemoryPropertyFlags memory_flags)
+{
+   PFN_vkGetImageMemoryRequirements get_requirements =
+      (PFN_vkGetImageMemoryRequirements)kk_test_device_proc(
+         t, "vkGetImageMemoryRequirements");
+   PFN_vkAllocateMemory allocate_memory =
+      (PFN_vkAllocateMemory)kk_test_device_proc(t, "vkAllocateMemory");
+   PFN_vkBindImageMemory bind_image_memory =
+      (PFN_vkBindImageMemory)kk_test_device_proc(t, "vkBindImageMemory");
+   VkMemoryRequirements requirements;
+   get_requirements(t->device, image, &requirements);
+   VkMemoryAllocateInfo allocate = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+   allocate.allocationSize = requirements.size;
+   allocate.memoryTypeIndex =
+      kk_test_memory_type(t, requirements.memoryTypeBits, memory_flags);
+   VkDeviceMemory memory = VK_NULL_HANDLE;
+   VK_CHECK(allocate_memory(t->device, &allocate, NULL, &memory));
+   VK_CHECK(bind_image_memory(t->device, image, memory, 0));
+   return memory;
+}
+
+/* A view of `layer_count` layers of mip level 0 of `image`, starting at
+ * `base_layer`, with the identity swizzle. */
+static inline VkImageView
+kk_test_image_view(const struct kk_test_device *t, VkImage image,
+                   VkImageViewType view_type, VkFormat format,
+                   VkImageAspectFlags aspect, uint32_t base_layer,
+                   uint32_t layer_count)
+{
+   VkImageViewCreateInfo info = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+   info.image = image;
+   info.viewType = view_type;
+   info.format = format;
+   info.subresourceRange.aspectMask = aspect;
+   info.subresourceRange.levelCount = 1;
+   info.subresourceRange.baseArrayLayer = base_layer;
+   info.subresourceRange.layerCount = layer_count;
+   PFN_vkCreateImageView create_image_view =
+      (PFN_vkCreateImageView)kk_test_device_proc(t, "vkCreateImageView");
+   VkImageView view = VK_NULL_HANDLE;
+   VK_CHECK(create_image_view(t->device, &info, NULL, &view));
+   return view;
+}
+
+/* A shader module of the `size` bytes of SPIR-V at `code`. */
+static inline VkShaderModule
+kk_test_shader_module(const struct kk_test_device *t, const uint32_t *code,
+                      size_t size)
+{
+   VkShaderModuleCreateInfo info = {
+      VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+   info.codeSize = size;
+   info.pCode = code;
+   PFN_vkCreateShaderModule create_shader_module =
+      (PFN_vkCreateShaderModule)kk_test_device_proc(t, "vkCreateShaderModule");
+   VkShaderModule module = VK_NULL_HANDLE;
+   VK_CHECK(create_shader_module(t->device, &info, NULL, &module));
+   return module;
