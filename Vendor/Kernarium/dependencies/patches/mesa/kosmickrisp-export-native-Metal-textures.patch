From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 4 Sep 2026 18:25:09 +0900
Subject: [PATCH] kosmickrisp: export native Metal textures

VK_EXT_metal_objects lets code that shares objects with Metal ask for the
Metal object behind a Vulkan one; Zink's GL interop asks it for an image's
texture. vkExportMetalObjectsEXT returns nothing, so a caller can only tell
what it got from the outputs it passed in, and every export structure in the
chain is answered. A device gives its MTLDevice, device memory its MTLBuffer,
an image the texture of the plane asked for, an image view its sampled
texture, a buffer view its texel-buffer texture and a timeline semaphore its
MTLSharedEvent. The rest have no Metal object to give and come back NULL: the
queue runs on an MTL4CommandQueue, which is not the MTLCommandQueue the
structure names, no image is backed by an IOSurface, a VkEvent has no shared
event, and a binary semaphore counts internal points on its event that a
caller could not interpret.

A test chains one of each export structure, every output holding a value the
caller left there, and checks that none keeps it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kosmickrisp/vulkan/kk_image.c             | 111 ++++++
 src/kosmickrisp/vulkan/kk_physical_device.c   |   1 +
 src/kosmickrisp/vulkan/meson.build            |  13 +
 .../vulkan/tests/test_metal_objects_export.c  | 332 ++++++++++++++++++
 4 files changed, 457 insertions(+)
 create mode 100644 src/kosmickrisp/vulkan/tests/test_metal_objects_export.c

diff --git a/src/kosmickrisp/vulkan/kk_image.c b/src/kosmickrisp/vulkan/kk_image.c
index 5b4dd8f4ace41a608daece1a4d2f7cc564ae9867..28b4b063976cb6dda3f946326915bea04910c913 100644
--- a/src/kosmickrisp/vulkan/kk_image.c
+++ b/src/kosmickrisp/vulkan/kk_image.c
@@ -7,11 +7,14 @@
 
 #include "kk_image.h"
 
+#include "kk_buffer_view.h"
 #include "kk_device.h"
 #include "kk_device_memory.h"
 #include "kk_entrypoints.h"
 #include "kk_format.h"
+#include "kk_image_view.h"
 #include "kk_physical_device.h"
+#include "kk_sync.h"
 
 #include "kosmickrisp/bridge/mtl_bridge.h"
 #include "kosmickrisp/bridge/vk_to_mtl_map.h"
@@ -19,8 +22,11 @@
 #include "vk_enum_defines.h"
 #include "vk_enum_to_str.h"
 #include "vk_format.h"
+#include "vk_semaphore.h"
 #include "wsi_common_private.h"
 
+#include <vulkan/vulkan_metal.h>
+
 static VkFormatFeatureFlags2
 kk_get_image_plane_format_features(struct kk_physical_device *pdev,
                                    VkFormat vk_format, VkImageTiling tiling,
@@ -982,6 +988,111 @@ kk_BindImageMemory2(VkDevice device, uint32_t bindInfoCount,
    return first_error_or_success;
 }
 
+#ifdef VK_USE_PLATFORM_METAL_EXT
+static uint8_t
+kk_export_plane(VkImageAspectFlagBits aspect)
+{
+   switch (aspect) {
+   case VK_IMAGE_ASPECT_PLANE_1_BIT:
+      return 1u;
+   case VK_IMAGE_ASPECT_PLANE_2_BIT:
+      return 2u;
+   default:
+      return 0u;
+   }
+}
+
+static MTLTexture_id
+kk_export_metal_texture(const VkExportMetalTextureInfoEXT *info)
+{
+   const uint8_t plane = kk_export_plane(info->plane);
+
+   if (info->image != VK_NULL_HANDLE) {
+      VK_FROM_HANDLE(kk_image, image, info->image);
+      return plane < image->plane_count ? image->planes[plane].mtl_handle
+                                        : NULL;
+   }
+   if (info->imageView != VK_NULL_HANDLE) {
+      VK_FROM_HANDLE(kk_image_view, view, info->imageView);
+      return plane < view->plane_count ? view->planes[plane].mtl_handle_sampled
+                                       : NULL;
+   }
+   if (info->bufferView != VK_NULL_HANDLE) {
+      VK_FROM_HANDLE(kk_buffer_view, view, info->bufferView);
+      return view->mtl_texel_buffer_handle;
+   }
+   return NULL;
+}
+
+/* A timeline semaphore's payload is a Metal shared event whose values are the
+ * semaphore's own. A binary semaphore counts internal points on its event,
+ * which a caller could not interpret, so it has nothing to export. */
+static MTLSharedEvent_id
+kk_export_metal_shared_event(const VkExportMetalSharedEventInfoEXT *info)
+{
+   if (info->semaphore == VK_NULL_HANDLE)
+      return NULL;
+
+   VK_FROM_HANDLE(vk_semaphore, semaphore, info->semaphore);
+   struct vk_sync *sync = vk_semaphore_get_active_sync(semaphore);
+   if (sync->type != &kk_sync_type)
+      return NULL;
+
+   return container_of(sync, struct kk_sync_timeline, base)->mtl_handle;
+}
+
+/* Every structure the extension defines gets an answer, so a caller never
+ * reads back whatever it had left in an output. The queue runs on an
+ * MTL4CommandQueue, which is not the MTLCommandQueue the structure asks for,
+ * no image is backed by an IOSurface, and a VkEvent has no shared event, so
+ * those answers are NULL. */
+VKAPI_ATTR void VKAPI_CALL
+kk_ExportMetalObjectsEXT(VkDevice _device,
+                         VkExportMetalObjectsInfoEXT *pMetalObjectsInfo)
+{
+   VK_FROM_HANDLE(kk_device, dev, _device);
+
+   vk_foreach_struct(metal_object, (void *)pMetalObjectsInfo->pNext) {
+      switch (metal_object->sType) {
+      case VK_STRUCTURE_TYPE_EXPORT_METAL_DEVICE_INFO_EXT: {
+         VkExportMetalDeviceInfoEXT *info = (void *)metal_object;
+         info->mtlDevice = (MTLDevice_id)dev->mtl_handle;
+         break;
+      }
+      case VK_STRUCTURE_TYPE_EXPORT_METAL_COMMAND_QUEUE_INFO_EXT: {
+         VkExportMetalCommandQueueInfoEXT *info = (void *)metal_object;
+         info->mtlCommandQueue = NULL;
+         break;
+      }
+      case VK_STRUCTURE_TYPE_EXPORT_METAL_BUFFER_INFO_EXT: {
+         VkExportMetalBufferInfoEXT *info = (void *)metal_object;
+         VK_FROM_HANDLE(kk_device_memory, mem, info->memory);
+         info->mtlBuffer =
+            mem != NULL ? (MTLBuffer_id)mem->bo->map : (MTLBuffer_id)NULL;
+         break;
+      }
+      case VK_STRUCTURE_TYPE_EXPORT_METAL_TEXTURE_INFO_EXT: {
+         VkExportMetalTextureInfoEXT *info = (void *)metal_object;
+         info->mtlTexture = kk_export_metal_texture(info);
+         break;
+      }
+      case VK_STRUCTURE_TYPE_EXPORT_METAL_IO_SURFACE_INFO_EXT: {
+         VkExportMetalIOSurfaceInfoEXT *info = (void *)metal_object;
+         info->ioSurface = NULL;
+         break;
+      }
+      case VK_STRUCTURE_TYPE_EXPORT_METAL_SHARED_EVENT_INFO_EXT: {
+         VkExportMetalSharedEventInfoEXT *info = (void *)metal_object;
+         info->mtlSharedEvent = kk_export_metal_shared_event(info);
+         break;
+      }
+      default:
+         break;
+      }
+   }
+}
+#endif
+
 VKAPI_ATTR VkResult VKAPI_CALL
 kk_GetImageOpaqueCaptureDescriptorDataEXT(
    VkDevice _device, const VkImageCaptureDescriptorDataInfoEXT *pInfo,
