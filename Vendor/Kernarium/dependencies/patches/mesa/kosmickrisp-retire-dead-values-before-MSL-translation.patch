diff --git a/src/kosmickrisp/compiler/nir_to_msl.c b/src/kosmickrisp/compiler/nir_to_msl.c
index 14770e63fa4974e23da92856cddcd176dffca313..cd62fbda0a3c61f641210a44f9869917c468df83 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.c
+++ b/src/kosmickrisp/compiler/nir_to_msl.c
@@ -2440,6 +2440,11 @@ msl_optimize_nir(struct nir_shader *nir)
    NIR_PASS(_, nir, nir_convert_from_ssa, true, false);
    NIR_PASS(_, nir, nir_trivialize_registers);
    NIR_PASS(_, nir, nir_opt_copy_prop);
+   /* Copy propagation abandons the wider values a propagated copy used to
+    * read. MSL type inference only reaches a value through its uses, so an
+    * abandoned vector reaches translation with no type and is emitted as
+    * invalid MSL. Retire the dead producers instead. */
+   NIR_PASS(_, nir, nir_opt_dce);
 
    return progress;
 }
