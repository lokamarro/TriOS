index d189f090a3f999a531f039721c7e9f156fda535f..214ef3aedca7e94295f41d810c46f2f957382c13 100644
--- a/src/kosmickrisp/vulkan/meson.build
+++ b/src/kosmickrisp/vulkan/meson.build
@@ -1077,6 +1077,20 @@ if with_tests
     suite : ['kosmickrisp'],
