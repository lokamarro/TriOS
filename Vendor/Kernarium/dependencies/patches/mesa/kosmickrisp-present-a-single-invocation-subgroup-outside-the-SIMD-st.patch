From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 12 Sep 2026 14:50:52 +0900
Subject: [PATCH] kosmickrisp: present a single-invocation subgroup outside the
 SIMD stages

Metal declares the SIMD-group attributes and the SIMD- and quad-group
functions in kernel and fragment functions only, which is why the driver
advertises subgroupSupportedStages as compute plus fragment.  The MSL
translation nevertheless emitted [[thread_index_in_simdgroup]] and
[[threads_per_simdgroup]] for a vertex, tessellation or geometry shader
that reads the subgroup builtins.  A plain vertex and fragment pipeline
then failed to create with VK_ERROR_INVALID_SHADER_NV, because a Metal
vertex function rejects those attributes, while the same vertex shader
inside a tessellation or geometry pipeline compiled -- those stages run
as Metal kernels -- and reported the lane of the kernel that emulates the
stage, which has nothing to do with the stage's own invocations.

A client that follows the advertised properties reads the opposite: zink
compiles the GL ARB_shader_ballot builtins with a subgroup size of one in
those stages while still reading SubgroupLocalInvocationId, so the masks
it derives disagreed with the size it assumed and
KHR-GL46.shader_ballot_tests.ShaderBallotBitmasks failed in every run.

Lower every subgroup intrinsic in those stages to the single-invocation
value the properties imply: size and count one, invocation and subgroup
index zero, the equal, greater-equal and less-equal masks set for that
one invocation, and every group operation the value this invocation
contributed.  Compute and fragment shaders keep the real SIMD group.

Covered by kosmickrisp_subgroup_stages.
---
 .../compiler/msl_nir_lower_subgroups.c        | 128 ++++++++++-
 src/kosmickrisp/vulkan/meson.build            |  14 ++
 .../vulkan/tests/test_subgroup_stages.c       | 211 ++++++++++++++++++
 3 files changed, 352 insertions(+), 1 deletion(-)
 create mode 100644 src/kosmickrisp/vulkan/tests/test_subgroup_stages.c

diff --git a/src/kosmickrisp/compiler/msl_nir_lower_subgroups.c b/src/kosmickrisp/compiler/msl_nir_lower_subgroups.c
index 87a46649370856ba4fdf2c801dcab1b574f555bd..01bfbe41a9bda83c48a2e3d8f66a309a5766522b 100644
--- a/src/kosmickrisp/compiler/msl_nir_lower_subgroups.c
+++ b/src/kosmickrisp/compiler/msl_nir_lower_subgroups.c
@@ -51,11 +51,132 @@ lower_bool_ops(nir_builder *b, nir_intrinsic_instr *intrin, void *_unused)
    return true;
 }
 
+/* Metal declares the SIMD-group attributes ([[thread_index_in_simdgroup]],
+ * [[threads_per_simdgroup]]) and the SIMD- and quad-group functions in kernel
+ * and fragment functions only, which is what the driver advertises through
+ * VkPhysicalDeviceVulkan11Properties::subgroupSupportedStages.  The remaining
+ * stages still have to translate, and the values they observe have to be the
+ * single-invocation subgroup those properties imply.  A Metal vertex function
+ * does not compile with the attributes at all, and a stage this driver
+ * emulates with a kernel would otherwise report the lane of the kernel that
+ * runs it, which has nothing to do with the stage's own invocations. */
+static bool
+msl_stage_has_simd_group(mesa_shader_stage stage)
+{
+   return stage == MESA_SHADER_FRAGMENT || stage == MESA_SHADER_COMPUTE ||
+          stage == MESA_SHADER_KERNEL;
+}
+
+static bool
+lower_single_invocation(nir_builder *b, nir_intrinsic_instr *intrin,
+                        void *_unused)
+{
+   nir_def *replacement = NULL;
+
+   b->cursor = nir_before_instr(&intrin->instr);
+
+   switch (intrin->intrinsic) {
+   case nir_intrinsic_load_subgroup_size:
+   case nir_intrinsic_load_num_subgroups:
+      replacement = nir_imm_intN_t(b, 1, intrin->def.bit_size);
+      break;
+
+   case nir_intrinsic_load_subgroup_invocation:
+   case nir_intrinsic_load_subgroup_id:
+   case nir_intrinsic_first_invocation:
+   case nir_intrinsic_last_invocation:
+      replacement = nir_imm_intN_t(b, 0, intrin->def.bit_size);
+      break;
+
+   /* The one invocation is its own subgroup: it is equal to, not greater
+    * than, and not less than itself. */
+   case nir_intrinsic_load_subgroup_eq_mask:
+   case nir_intrinsic_load_subgroup_ge_mask:
+   case nir_intrinsic_load_subgroup_le_mask:
+      replacement =
+         nir_pad_vector_imm_int(b, nir_imm_intN_t(b, 1, intrin->def.bit_size),
+                                0, intrin->def.num_components);
+      break;
+
+   case nir_intrinsic_load_subgroup_gt_mask:
+   case nir_intrinsic_load_subgroup_lt_mask:
+      replacement =
+         nir_imm_zero(b, intrin->def.num_components, intrin->def.bit_size);
+      break;
+
+   case nir_intrinsic_elect:
+   case nir_intrinsic_vote_ieq:
+   case nir_intrinsic_vote_feq:
+      replacement = nir_imm_true(b);
+      break;
+
+   /* Every group operation observes this invocation alone, so it returns the
+    * value this invocation contributed. */
+   case nir_intrinsic_vote_all:
+   case nir_intrinsic_vote_any:
+   case nir_intrinsic_quad_vote_all:
+   case nir_intrinsic_quad_vote_any:
+   case nir_intrinsic_read_invocation:
+   case nir_intrinsic_read_first_invocation:
+   case nir_intrinsic_shuffle:
+   case nir_intrinsic_shuffle_up:
+   case nir_intrinsic_shuffle_down:
+   case nir_intrinsic_shuffle_xor:
+   case nir_intrinsic_rotate:
+   case nir_intrinsic_quad_broadcast:
+   case nir_intrinsic_quad_swap_horizontal:
+   case nir_intrinsic_quad_swap_vertical:
+   case nir_intrinsic_quad_swap_diagonal:
+   case nir_intrinsic_reduce:
+   case nir_intrinsic_inclusive_scan:
+      replacement = intrin->src[0].ssa;
+      break;
+
+   /* An exclusive scan covers the invocations before this one: none. */
+   case nir_intrinsic_exclusive_scan: {
+      nir_const_value identity = nir_alu_binop_identity(
+         nir_intrinsic_reduction_op(intrin), intrin->def.bit_size);
+      replacement = nir_replicate(
+         b, nir_build_imm(b, 1, intrin->def.bit_size, &identity),
+         intrin->def.num_components);
+      break;
+   }
+
+   case nir_intrinsic_ballot:
+   case nir_intrinsic_ballot_relaxed:
+      replacement = nir_pad_vector_imm_int(
+         b, nir_b2iN(b, intrin->src[0].ssa, intrin->def.bit_size), 0,
+         intrin->def.num_components);
+      break;
+
+   case nir_intrinsic_inverse_ballot:
+      replacement = nir_ine_imm(
+         b, nir_iand_imm(b, nir_channel(b, intrin->src[0].ssa, 0), 1), 0);
+      break;
+
+   default:
+      return false;
+   }
+
+   nir_def_replace(&intrin->def, replacement);
+   return true;
+}
+
 void
 msl_nir_lower_subgroups(nir_shader *nir)
 {
+   const bool simd_group = msl_stage_has_simd_group(nir->info.stage);
+
+   /* Lower the group operations first so that the ones nir_lower_subgroups
+    * expands into shuffles and ballots never appear, then lower again to
+    * retire the subgroup size and invocation reads that its own lowering of
+    * the remaining ballot arithmetic introduces. */
+   if (!simd_group)
+      NIR_PASS(_, nir, nir_shader_intrinsics_pass, lower_single_invocation,
+               nir_metadata_control_flow, NULL);
+
    const nir_lower_subgroups_options subgroups_options = {
-      .subgroup_size = 32,
+      .subgroup_size = simd_group ? 32 : 1,
       .ballot_bit_size = 32,
       .ballot_components = 1,
       .lower_subgroup_masks = true,
@@ -71,6 +192,11 @@ msl_nir_lower_subgroups(nir_shader *nir)
       .lower_rotate_clustered_to_shuffle = true,
    };
    NIR_PASS(_, nir, nir_lower_subgroups, &subgroups_options);
+
+   if (!simd_group)
+      NIR_PASS(_, nir, nir_shader_intrinsics_pass, lower_single_invocation,
+               nir_metadata_control_flow, NULL);
+
    NIR_PASS(_, nir, nir_shader_intrinsics_pass, lower_bool_ops,
             nir_metadata_control_flow, NULL);
 }
