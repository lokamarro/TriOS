   test(
     'kosmickrisp_pipeline_statistics',
     executable(
diff --git a/src/kosmickrisp/vulkan/tests/test_subgroup_stages.c b/src/kosmickrisp/vulkan/tests/test_subgroup_stages.c
new file mode 100644
index 0000000000000000000000000000000000000000..e8d38bd1cb8083e69d7d84ccd8f26de60b2a552b
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_subgroup_stages.c
@@ -0,0 +1,211 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Metal has SIMD groups in kernel and fragment functions only, which is what
+ * the driver advertises as subgroupSupportedStages.  A vertex, tessellation or
+ * geometry shader that reads the subgroup builtins must therefore observe the
+ * single-invocation subgroup those properties imply: reading a SIMD lane there
+ * either fails to compile as a Metal vertex function or reports the lane of
+ * the kernel that emulates the stage.  Compute and fragment shaders must keep
+ * the real SIMD group.
+ */
+
+#include "compiler/glsl_types.h"
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+#include "kosmickrisp/compiler/msl_private.h"
+#include "kosmickrisp/compiler/nir_to_msl.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(condition)                                                     \
+   do {                                                                      \
+      if (!(condition)) {                                                    \
+         fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__,    \
+                 #condition);                                                \
+         abort();                                                            \
+      }                                                                      \
+   } while (0)
+
+enum slot {
+   SLOT_INVOCATION,
+   SLOT_SIZE,
+   SLOT_EQ_MASK,
+   SLOT_GE_MASK,
+   SLOT_GT_MASK,
+   SLOT_LE_MASK,
+   SLOT_LT_MASK,
+   SLOT_COUNT,
+};
+
+/* Every subgroup value the GL ARB_shader_ballot builtins reach the driver
+ * with, plus the group operations that back ballotARB() and
+ * readFirstInvocationARB(), written to global memory. */
+static nir_shader *
+build_ballot_shader(mesa_shader_stage stage)
+{
+   nir_builder b = nir_builder_init_simple_shader(stage, &kk_nir_options,
+                                                  "subgroup stages");
+   nir_shader *nir = b.shader;
+   nir->info.workgroup_size[0] = 1;
+   nir->info.workgroup_size[1] = 1;
+   nir->info.workgroup_size[2] = 1;
+
+   nir_def *base = nir_imm_int64(&b, 4096);
+   nir_def *source = nir_load_global(&b, 1, 32, base, .align_mul = 4);
+
+   nir_def *value[SLOT_COUNT];
+   value[SLOT_INVOCATION] = nir_load_subgroup_invocation(&b);
+   value[SLOT_SIZE] = nir_load_subgroup_size(&b);
+   value[SLOT_EQ_MASK] = nir_load_subgroup_eq_mask(&b, 1, 32);
+   value[SLOT_GE_MASK] = nir_load_subgroup_ge_mask(&b, 1, 32);
+   value[SLOT_GT_MASK] = nir_load_subgroup_gt_mask(&b, 1, 32);
+   value[SLOT_LE_MASK] = nir_load_subgroup_le_mask(&b, 1, 32);
+   value[SLOT_LT_MASK] = nir_load_subgroup_lt_mask(&b, 1, 32);
+
+   for (unsigned i = 0; i < SLOT_COUNT; i++) {
+      nir_def *to = nir_iadd_imm(&b, base, 4 * i);
+      nir_store_global(&b, value[i], to, .write_mask = 0x1, .align_mul = 4);
+   }
+
+   nir_def *ballot = nir_ballot(&b, 1, 32, nir_ine_imm(&b, source, 0));
+   nir_store_global(&b, ballot, nir_iadd_imm(&b, base, 1024), .write_mask = 0x1,
+                    .align_mul = 4);
+   nir_def *first = nir_read_first_invocation(&b, source);
+   nir_store_global(&b, first, nir_iadd_imm(&b, base, 1028), .write_mask = 0x1,
+                    .align_mul = 4);
+
+   nir_validate_shader(nir, "subgroup stages");
+   return nir;
+}
+
+static bool
+is_subgroup_intrinsic(nir_intrinsic_op op)
+{
+   const nir_intrinsic_info *info = &nir_intrinsic_infos[op];
+
+   return (info->flags & NIR_INTRINSIC_SUBGROUP) != 0 ||
+          (info->flags & NIR_INTRINSIC_QUADGROUP) != 0;
+}
+
+static unsigned
+count_subgroup_intrinsics(nir_shader *nir)
+{
+   unsigned found = 0;
+
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            if (is_subgroup_intrinsic(nir_instr_as_intrinsic(instr)->intrinsic))
+               found++;
+         }
+      }
+   }
+
+   return found;
+}
+
+/* The constant a slot was folded to, or -1 when it did not fold. */
+static int64_t
+folded_value(nir_shader *nir, enum slot slot)
+{
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+            if (intrin->intrinsic != nir_intrinsic_store_global)
+               continue;
+
+            nir_const_value *offset = nir_src_as_const_value(intrin->src[1]);
+            if (offset == NULL ||
+                nir_const_value_as_uint(*offset, 64) != 4096 + 4 * slot)
+               continue;
+
+            nir_const_value *stored = nir_src_as_const_value(intrin->src[0]);
+            if (stored == NULL)
+               return -1;
+            return (int64_t)nir_const_value_as_uint(*stored, 32);
+         }
+      }
+   }
+
+   return -1;
+}
+
+static nir_shader *
+lower(mesa_shader_stage stage)
+{
+   nir_shader *nir = build_ballot_shader(stage);
+
+   msl_nir_lower_subgroups(nir);
+   nir_opt_constant_folding(nir);
+   nir_opt_dce(nir);
+   nir_shader_gather_info(nir, nir_shader_get_entrypoint(nir));
+
+   return nir;
+}
+
+static void
+check_single_invocation_stage(mesa_shader_stage stage)
+{
+   nir_shader *nir = lower(stage);
+
+   /* No Metal SIMD-group attribute or function is left to translate. */
+   CHECK(count_subgroup_intrinsics(nir) == 0);
+   CHECK(!BITSET_TEST(nir->info.system_values_read,
+                      SYSTEM_VALUE_SUBGROUP_INVOCATION));
+   CHECK(!BITSET_TEST(nir->info.system_values_read, SYSTEM_VALUE_SUBGROUP_SIZE));
+
+   /* The invocation is alone in a subgroup of one, so it is equal to itself
+    * and neither greater nor less than itself. */
+   CHECK(folded_value(nir, SLOT_INVOCATION) == 0);
+   CHECK(folded_value(nir, SLOT_SIZE) == 1);
+   CHECK(folded_value(nir, SLOT_EQ_MASK) == 1);
+   CHECK(folded_value(nir, SLOT_GE_MASK) == 1);
+   CHECK(folded_value(nir, SLOT_GT_MASK) == 0);
+   CHECK(folded_value(nir, SLOT_LE_MASK) == 1);
+   CHECK(folded_value(nir, SLOT_LT_MASK) == 0);
+
+   ralloc_free(nir);
+}
+
+static void
+check_simd_group_stage(mesa_shader_stage stage)
+{
+   nir_shader *nir = lower(stage);
+
+   /* The real SIMD group: the masks still come from the lane index, which is
+    * read from Metal. */
+   CHECK(BITSET_TEST(nir->info.system_values_read,
+                     SYSTEM_VALUE_SUBGROUP_INVOCATION));
+   CHECK(folded_value(nir, SLOT_INVOCATION) == -1);
+   CHECK(folded_value(nir, SLOT_EQ_MASK) == -1);
+   CHECK(folded_value(nir, SLOT_SIZE) == 32);
+   CHECK(count_subgroup_intrinsics(nir) > 0);
+
+   ralloc_free(nir);
+}
+
+int
+main(void)
+{
+   glsl_type_singleton_init_or_ref();
+
+   check_single_invocation_stage(MESA_SHADER_VERTEX);
+   check_single_invocation_stage(MESA_SHADER_TESS_CTRL);
+   check_single_invocation_stage(MESA_SHADER_TESS_EVAL);
+   check_single_invocation_stage(MESA_SHADER_GEOMETRY);
+
+   check_simd_group_stage(MESA_SHADER_FRAGMENT);
+   check_simd_group_stage(MESA_SHADER_COMPUTE);
+
+   glsl_type_singleton_decref();
+   return 0;
+}
