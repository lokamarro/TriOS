From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 13 Sep 2026 17:12:22 +0900
Subject: [PATCH] poly: compute a tessellation shader's index once, not once
 per load

Lowering a tessellation evaluation shader to compute replaces every
load_vertex_id with an inlined library call that reads the TES index out of
the index buffer, and the earlier input lowering emits one load_vertex_id per
lowered input load. Inlining a serialized function re-indexes the whole shader
afterwards, so a shader with many inputs paid a full walk of an ever-growing
shader for every one of them.

A profile of a GL45-ES31 shard makes it the single hottest thing the driver
does: nir_index_ssa_defs is 19.4% of the host's on-CPU samples, 99.9% of it
under nir_call_serialized, and 70% of that under this one lowering.

The index depends only on the tessellation parameter buffer and the invocation
id, both available at the entry, so compute it once there and let every load
share it.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/poly/nir/poly_nir_lower_tess.c | 51 ++++++++++++++++++++++++++----
 1 file changed, 45 insertions(+), 6 deletions(-)

diff --git a/src/poly/nir/poly_nir_lower_tess.c b/src/poly/nir/poly_nir_lower_tess.c
index c286924ffcde00460f2976fe679bf83c80a253c1..8498306d8eca995c5f0b8a59c34473beb8a1ff0b 100644
--- a/src/poly/nir/poly_nir_lower_tess.c
+++ b/src/poly/nir/poly_nir_lower_tess.c
@@ -263,13 +263,53 @@ lower_tes_indexing(nir_builder *b, nir_intrinsic_instr *intr, void *data)
    if (intr->intrinsic != nir_intrinsic_load_vertex_id)
       return false;
 
-   b->cursor = nir_before_instr(&intr->instr);
-   nir_def *p = nir_load_tess_param_buffer_poly(b);
-   nir_def *id = nir_channel(b, nir_load_global_invocation_id(b, 32), 0);
-   nir_def_replace(&intr->def, poly_load_tes_index(b, p, id));
+   nir_def_replace(&intr->def, data);
    return true;
 }
 
+static bool
+impl_loads_vertex_id(nir_function_impl *impl)
+{
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         if (nir_instr_as_intrinsic(instr)->intrinsic ==
+             nir_intrinsic_load_vertex_id)
+            return true;
+      }
+   }
+
+   return false;
+}
+
+/*
+ * Every lowered input load in a tessellation-as-compute shader reads the same
+ * TES index, and computing it inlines a serialized library function. Inlining
+ * re-indexes the whole shader afterwards, so producing the index once per load
+ * costs a walk of a shader that each inline has just made larger: the lowering
+ * was quadratic in the shader it was building. The index depends only on the
+ * tessellation parameter buffer and the invocation, both of which are
+ * available at the entry, so compute it once there and share it.
+ */
+static void
+lower_tes_indices(nir_shader *tes)
+{
+   nir_foreach_function_impl(impl, tes) {
+      if (!impl_loads_vertex_id(impl))
+         continue;
+
+      nir_builder b = nir_builder_at(nir_before_impl(impl));
+      nir_def *p = nir_load_tess_param_buffer_poly(&b);
+      nir_def *id = nir_channel(&b, nir_load_global_invocation_id(&b, 32), 0);
+      nir_def *index = poly_load_tes_index(&b, p, id);
+
+      nir_function_intrinsics_pass(impl, lower_tes_indexing,
+                                   nir_metadata_control_flow, index);
+   }
+}
+
 bool
 poly_nir_lower_tes(nir_shader *tes, bool to_hw_vs)
 {
@@ -295,8 +335,7 @@ poly_nir_lower_tes(nir_shader *tes, bool to_hw_vs)
        * buffer manually. Fortunately, this doesn't require a shader key:
        * tess-as-compute always use U32 index buffers.
        */
-      nir_shader_intrinsics_pass(tes, lower_tes_indexing,
-                                 nir_metadata_control_flow, NULL);
+      lower_tes_indices(tes);
    }
 
    nir_lower_idiv(tes, &(nir_lower_idiv_options){.allow_fp16 = true});
