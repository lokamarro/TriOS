diff --git a/src/kosmickrisp/vulkan/kk_nir_lower_vbo.c b/src/kosmickrisp/vulkan/kk_nir_lower_vbo.c
index 6d56e5669ce5c77657322ffa90111fa45fb0de1a..1217364bde7fbf302095e86e77e62ed1aa453959 100644
--- a/src/kosmickrisp/vulkan/kk_nir_lower_vbo.c
+++ b/src/kosmickrisp/vulkan/kk_nir_lower_vbo.c
@@ -18,6 +18,7 @@
 struct ctx {
    struct kk_attribute *attribs;
    bool requires_robustness2;
+   bool byte_strides;
 };
 
 static bool
@@ -86,6 +87,14 @@ kk_vbo_supports_format(enum pipe_format format)
    return kk_vbo_internal_format(format) != PIPE_FORMAT_NONE;
 }
 
+unsigned
+kk_vbo_interchange_alignment(enum pipe_format format)
+{
+   enum pipe_format interchange_format = kk_vbo_internal_format(format);
+   assert(interchange_format != PIPE_FORMAT_NONE);
+   return util_format_get_blocksize(interchange_format);
+}
+
 static nir_def *
 apply_swizzle_channel(nir_builder *b, nir_def *vec, unsigned swizzle,
                       bool is_int)
@@ -109,6 +118,34 @@ apply_swizzle_channel(nir_builder *b, nir_def *vec, unsigned swizzle,
    }
 }
 
+static nir_def *
+load_unaligned_components(nir_builder *b, nir_def *base,
+                          nir_def *byte_offset, unsigned num_components,
+                          unsigned bit_size)
+{
+   assert(num_components <= 4);
+   assert(bit_size == 8 || bit_size == 16 || bit_size == 32);
+
+   const unsigned bytes_per_component = bit_size / 8;
+   nir_def *components[4] = {NULL};
+   for (unsigned c = 0; c < num_components; c++) {
+      nir_def *value = nir_imm_int(b, 0);
+      for (unsigned byte_index = 0; byte_index < bytes_per_component;
+           byte_index++) {
+         nir_def *offset = nir_iadd_imm(
+            b, byte_offset, c * bytes_per_component + byte_index);
+         nir_def *byte = nir_load_constant_agx(
+            b, 1, 32, base, offset, .format = PIPE_FORMAT_R8_UINT,
+            .base = 0u);
+         value = nir_ior(
+            b, value, nir_ishl_imm(b, byte, byte_index * 8));
+      }
+      components[c] = nir_u2uN(b, value, bit_size);
+   }
+
+   return nir_vec(b, components, num_components);
+}
+
 static bool
 pass(struct nir_builder *b, nir_intrinsic_instr *intr, void *data)
 {
@@ -141,7 +178,7 @@ pass(struct nir_builder *b, nir_intrinsic_instr *intr, void *data)
    enum pipe_format interchange_format = kk_vbo_internal_format(attrib.format);
    assert(interchange_format != PIPE_FORMAT_NONE);
 
-   unsigned interchange_align = util_format_get_blocksize(interchange_format);
+   unsigned interchange_align = kk_vbo_interchange_alignment(attrib.format);
    unsigned interchange_comps = util_format_get_nr_components(attrib.format);
 
    /* In the hardware, uint formats zero-extend and float formats convert.
@@ -188,13 +225,27 @@ pass(struct nir_builder *b, nir_intrinsic_instr *intr, void *data)
       struct kk_root_descriptor_table, draw.buffer_strides[attrib.binding]);
    nir_def *stride = nir_load_global_constant(
       b, 1, 32, nir_iadd_imm(b, argbuf, buffer_stride_offset));
-   nir_def *stride_offset_el =
-      nir_imul(b, el, nir_udiv_imm(b, stride, interchange_align));
 
-   /* Load the raw vector */
-   nir_def *memory = nir_load_constant_agx(
-      b, interchange_comps, interchange_register_size, base, stride_offset_el,
-      .format = interchange_format, .base = 0u);
+   nir_def *memory;
+   if (ctx->byte_strides) {
+      /* Legacy vertex attributes permit strides which are not multiples of
+       * the interchange element size.  Keep the buffer base uniform and use
+       * R8 typed loads with a byte offset; wider typed loads align their base,
+       * while making the 64-bit base itself divergent is not supported by the
+       * Metal load path.  Reassemble each logical component explicitly.
+       */
+      nir_def *byte_offset = nir_imul(b, el, stride);
+      memory = load_unaligned_components(
+         b, base, byte_offset, interchange_comps,
+         interchange_register_size);
+   } else {
+      /* Preserve the ordinary aligned path as an element-indexed load. */
+      nir_def *load_offset =
+         nir_imul(b, el, nir_udiv_imm(b, stride, interchange_align));
+      memory = nir_load_constant_agx(
+         b, interchange_comps, interchange_register_size, base, load_offset,
+         .format = interchange_format, .base = 0u);
+   }
 
    if (ctx->requires_robustness2) {
       uint64_t attrib_clamp_offset =
@@ -269,13 +320,14 @@ pass(struct nir_builder *b, nir_intrinsic_instr *intr, void *data)
 
 bool
 kk_nir_lower_vbo(nir_shader *nir, struct kk_attribute *attribs,
-                 bool robustness2)
+                 bool robustness2, bool byte_strides)
 {
    assert(nir->info.stage == MESA_SHADER_VERTEX);
 
    struct ctx ctx = {
       .attribs = attribs,
       .requires_robustness2 = robustness2,
+      .byte_strides = byte_strides,
    };
    return nir_shader_intrinsics_pass(nir, pass, nir_metadata_control_flow,
                                      &ctx);
