@@ -184,14 +190,17 @@ kk_hash_graphics_state(struct vk_physical_device *device,
    const bool complete = kk_graphics_state_is_complete(state);
    _mesa_blake3_update(&blake3_ctx, &complete, sizeof(complete));
 
