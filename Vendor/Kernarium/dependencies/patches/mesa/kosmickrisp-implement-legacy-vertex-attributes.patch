+/* Live VkPipeline owners share each dynamic vertex-input parent until the
+ * last owner releases it.  The parent, state copy, and compiled variants use
+ * the device allocator because they may outlive the first pipeline owner.
+ */
+static VkResult
+kk_create_dynamic_vertex_input_pipeline(
+   struct kk_device *dev, uint32_t shader_count,
+   struct kk_shader *const *shaders,
+   const struct vk_graphics_pipeline_state *state, uint32_t set_layout_count,
+   struct vk_descriptor_set_layout *const *set_layouts,
+   struct kk_linked_graphics_pipeline **linked_out)
+{
+   struct kk_linked_graphics_pipeline *linked = vk_zalloc(
+      &dev->vk.alloc, sizeof(*linked), 8, VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (linked == NULL)
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   linked->dynamic_vertex_input = true;
+   simple_mtx_init(&linked->dynamic.lock, mtx_plain);
+   linked->dynamic.variants = _mesa_hash_table_create(
+      NULL, kk_linked_graphics_pipeline_hash,
+      kk_linked_graphics_pipeline_equal);
+   if (linked->dynamic.variants == NULL) {
+      simple_mtx_destroy(&linked->dynamic.lock);
+      vk_free(&dev->vk.alloc, linked);
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
+   VkResult result = vk_graphics_pipeline_state_copy(
+      &dev->vk, &linked->dynamic.state, state, NULL,
+      VK_SYSTEM_ALLOCATION_SCOPE_DEVICE, &linked->dynamic.state_data);
+   if (result != VK_SUCCESS)
+      goto fail;
+
+   for (uint32_t i = 0; i < shader_count; i++) {
+      const struct kk_shader *shader = shaders[i];
+      if (!shader->info.deferred) {
+         result = vk_error(dev, VK_ERROR_INVALID_SHADER_NV);
+         goto fail;
+      }
+
+      struct kk_deferred_graphics_shader *source =
+         &linked->dynamic.sources[linked->dynamic.shader_count++];
+      source->stage = shader->info.stage;
+      source->robustness = shader->deferred_robustness;
+      blob_init(&source->nir);
+      blob_write_bytes(&source->nir, shader->deferred_nir.data,
+                       shader->deferred_nir.size);
+      if (source->nir.out_of_memory) {
+         result = vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+         goto fail;
+      }
