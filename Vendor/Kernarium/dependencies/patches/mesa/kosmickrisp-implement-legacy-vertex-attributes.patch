@@ -0,0 +1,43 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kk_shader_info.h"
+
+#include "compiler/nir/nir_builder.h"
+
+#include <assert.h>
+
+static bool
+gather_lowered_vs_inputs(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_input)
+      return false;
+
+   const struct nir_io_semantics io = nir_intrinsic_io_semantics(intr);
+   assert(io.location >= VERT_ATTRIB_GENERIC0);
+   assert(io.location < VERT_ATTRIB_GENERIC0 + 32);
+
+   uint32_t *attribs_read = data;
+   *attribs_read |= BITFIELD_BIT(io.location - VERT_ATTRIB_GENERIC0);
+   return false;
+}
+
+uint32_t
+kk_gather_vs_attribs_read(nir_shader *nir)
+{
+   assert(nir->info.stage == MESA_SHADER_VERTEX);
+
+   if (!nir->info.io_lowered) {
+      assert(!(nir->info.inputs_read &
+               BITFIELD64_MASK(VERT_ATTRIB_GENERIC0)) &&
+             "Fixed-function attributes not used in Vulkan");
+      return nir->info.inputs_read >> VERT_ATTRIB_GENERIC0;
+   }
+
+   uint32_t attribs_read = 0;
+   nir_shader_intrinsics_pass(nir, gather_lowered_vs_inputs,
+                              nir_metadata_all, &attribs_read);
+   return attribs_read;
+}
