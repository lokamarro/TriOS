+            vk_descriptor_set_layout_ref(set_layouts[i]);
+      }
+   }
+
+   *linked_out = linked;
+   return VK_SUCCESS;
+
+fail:
+   kk_free_linked_graphics_pipeline(&dev->vk, linked, NULL);
+   return result;
+}
