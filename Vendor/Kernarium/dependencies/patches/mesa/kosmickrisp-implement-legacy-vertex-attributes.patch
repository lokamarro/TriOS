+   };
+   CHECK(ctx->api->AllocateMemory(ctx->device, &alloc, NULL, &image.memory));
+   CHECK(ctx->api->BindImageMemory(ctx->device, image.image, image.memory, 0));
+   const VkImageViewCreateInfo view_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+      .image = image.image,
+      .viewType = VK_IMAGE_VIEW_TYPE_2D,
+      .format = VK_FORMAT_R8G8B8A8_UNORM,
+      .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+   };
+   CHECK(ctx->api->CreateImageView(ctx->device, &view_info, NULL, &image.view));
+   return image;
+}
+
+static void
+destroy_image(struct context *ctx, struct image image)
+{
+   ctx->api->DestroyImageView(ctx->device, image.view, NULL);
+   ctx->api->DestroyImage(ctx->device, image.image, NULL);
+   ctx->api->FreeMemory(ctx->device, image.memory, NULL);
+}
+
+static nir_shader *
+build_vertex_shader(void)
+{
+   nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_VERTEX, NULL,
+                                                  "blend-key-vs");
+   nir_def *id = nir_load_vertex_id(&b);
+   nir_def *x = nir_u2f32(&b, nir_iand_imm(&b, nir_ishl_imm(&b, id, 1), 2));
+   nir_def *y = nir_u2f32(&b, nir_iand_imm(&b, id, 2));
+   nir_variable *position = nir_variable_create(
+      b.shader, nir_var_shader_out, glsl_vec4_type(), "gl_Position");
+   position->data.location = VARYING_SLOT_POS;
+   nir_store_var(&b, position,
+      nir_vec4(&b, nir_fadd_imm(&b, nir_fmul_imm(&b, x, 2), -1),
+                   nir_fadd_imm(&b, nir_fmul_imm(&b, y, 2), -1),
+                   nir_imm_float(&b, 0), nir_imm_float(&b, 1)), 0xf);
+   return b.shader;
+}
+
+static nir_shader *
+build_fragment_shader(void)
+{
+   nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_FRAGMENT, NULL,
+                                                  "blend-key-fs");
+   nir_variable *color = nir_variable_create(
+      b.shader, nir_var_shader_out, glsl_vec4_type(), "outColor");
+   color->data.location = FRAG_RESULT_DATA0;
+   nir_store_var(&b, color,
+      nir_vec4(&b, nir_imm_float(&b, source_color[0]),
+                   nir_imm_float(&b, source_color[1]),
+                   nir_imm_float(&b, source_color[2]),
+                   nir_imm_float(&b, source_color[3])), 0xf);
+   return b.shader;
+}
+
+/* Every pipeline uses the same shaders, layout, topology and dynamic state,
+ * so only the blend configuration may separate them. */
+static VkPipeline
+create_pipeline(struct context *ctx, VkPipelineLayout layout,
+                const struct blend_case *blend)
+{
+   const VkPipelineShaderStageNirCreateInfoMESA nir[] = {
+      {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_NIR_CREATE_INFO_MESA,
+       .nir = build_vertex_shader()},
+      {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_NIR_CREATE_INFO_MESA,
+       .nir = build_fragment_shader()},
+   };
+   const VkPipelineShaderStageCreateInfo stages[] = {
+      {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+       .pNext = &nir[0], .stage = VK_SHADER_STAGE_VERTEX_BIT, .pName = "main"},
+      {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+       .pNext = &nir[1], .stage = VK_SHADER_STAGE_FRAGMENT_BIT,
+       .pName = "main"},
+   };
+   const VkPipelineInputAssemblyStateCreateInfo ia = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+      .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
+   };
+   const VkViewport viewport = {0, 0, WIDTH, HEIGHT, 0, 1};
+   const VkRect2D scissor = {{0, 0}, {WIDTH, HEIGHT}};
+   const VkPipelineViewportStateCreateInfo vp = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+      .viewportCount = 1, .pViewports = &viewport,
+      .scissorCount = 1, .pScissors = &scissor,
+   };
+   const VkPipelineRasterizationStateCreateInfo rs = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+      .polygonMode = VK_POLYGON_MODE_FILL,
+      .cullMode = VK_CULL_MODE_NONE,
+      .lineWidth = 1,
+   };
+   const VkPipelineMultisampleStateCreateInfo ms = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+      .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT,
+   };
+   const VkPipelineColorBlendAttachmentState att = {
+      .blendEnable = VK_TRUE,
+      .srcColorBlendFactor = blend->src_color,
+      .dstColorBlendFactor = blend->dst_color,
+      .colorBlendOp = blend->color_op,
+      .srcAlphaBlendFactor = blend->src_alpha,
+      .dstAlphaBlendFactor = blend->dst_alpha,
+      .alphaBlendOp = blend->alpha_op,
+      .colorWriteMask = 0xf,
+   };
+   const VkPipelineColorBlendStateCreateInfo cb = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+      .logicOp = VK_LOGIC_OP_CLEAR,
+      .attachmentCount = 1, .pAttachments = &att,
+   };
+   /* Dynamic vertex input defers shader compilation past pipeline creation,
+    * exactly as the Zink OpenGL frontend does for every program. */
+   const VkDynamicState dynamic_states[] = {VK_DYNAMIC_STATE_VERTEX_INPUT_EXT};
+   const VkPipelineDynamicStateCreateInfo dynamic = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO,
+      .dynamicStateCount = ARRAY_SIZE(dynamic_states),
+      .pDynamicStates = dynamic_states,
+   };
+   const VkFormat format = VK_FORMAT_R8G8B8A8_UNORM;
+   const VkPipelineRenderingCreateInfo rendering = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO,
+      .colorAttachmentCount = 1, .pColorAttachmentFormats = &format,
+   };
+   const VkGraphicsPipelineCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO,
+      .pNext = &rendering,
+      .stageCount = 2, .pStages = stages,
+      .pInputAssemblyState = &ia,
+      .pViewportState = &vp, .pRasterizationState = &rs,
+      .pMultisampleState = &ms, .pColorBlendState = &cb,
+      .pDynamicState = &dynamic,
+      .layout = layout,
+   };
+   VkPipeline pipeline;
+   CHECK(ctx->api->CreateGraphicsPipelines(ctx->device, VK_NULL_HANDLE, 1,
+                                           &info, NULL, &pipeline));
+   ralloc_free(nir[0].nir);
+   ralloc_free(nir[1].nir);
+   return pipeline;
+}
+
+static float
+apply_factor(VkBlendFactor factor, const float *color, unsigned channel)
+{
+   switch (factor) {
+   case VK_BLEND_FACTOR_ZERO:
+      return 0.0f;
+   case VK_BLEND_FACTOR_ONE:
+      return 1.0f;
+   case VK_BLEND_FACTOR_SRC_ALPHA:
+      return source_color[3];
+   case VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA:
+      return 1.0f - source_color[3];
+   case VK_BLEND_FACTOR_DST_ALPHA:
+      return dest_color[3];
+   case VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA:
+      return 1.0f - dest_color[3];
+   case VK_BLEND_FACTOR_SRC_COLOR:
+      return source_color[channel];
+   case VK_BLEND_FACTOR_DST_COLOR:
+      return dest_color[channel];
+   default:
+      abort();
+   }
+}
+
+static float
+apply_op(VkBlendOp op, float src, float dst)
+{
+   switch (op) {
+   case VK_BLEND_OP_ADD:
+      return src + dst;
+   case VK_BLEND_OP_SUBTRACT:
+      return src - dst;
+   case VK_BLEND_OP_REVERSE_SUBTRACT:
+      return dst - src;
+   case VK_BLEND_OP_MIN:
+      return fminf(src, dst);
+   case VK_BLEND_OP_MAX:
+      return fmaxf(src, dst);
+   default:
+      abort();
+   }
+}
+
+static unsigned
+expected_channel(const struct blend_case *blend, unsigned channel)
+{
+   const bool alpha = channel == 3;
+   const VkBlendFactor src_factor = alpha ? blend->src_alpha : blend->src_color;
+   const VkBlendFactor dst_factor = alpha ? blend->dst_alpha : blend->dst_color;
+   const VkBlendOp op = alpha ? blend->alpha_op : blend->color_op;
+   const float src =
+      source_color[channel] * apply_factor(src_factor, source_color, channel);
+   const float dst =
+      dest_color[channel] * apply_factor(dst_factor, dest_color, channel);
+   const float result = fminf(fmaxf(apply_op(op, src, dst), 0.0f), 1.0f);
+   return lroundf(result * 255.0f);
+}
+
+static bool
+render_and_verify(struct context *ctx, VkPipeline pipeline,
+                  const struct blend_case *blend)
+{
+   struct image target = create_image(ctx);
+
+   VkBuffer buffer;
+   const VkBufferCreateInfo buffer_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = PIXELS * 4,
+      .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   CHECK(ctx->api->CreateBuffer(ctx->device, &buffer_info, NULL, &buffer));
+   VkMemoryRequirements req;
+   ctx->api->GetBufferMemoryRequirements(ctx->device, buffer, &req);
+   const VkMemoryAllocateInfo alloc = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = req.size,
+      .memoryTypeIndex = memory_type(ctx, req.memoryTypeBits,
+         VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+         VK_MEMORY_PROPERTY_HOST_COHERENT_BIT),
+   };
+   VkDeviceMemory memory;
+   CHECK(ctx->api->AllocateMemory(ctx->device, &alloc, NULL, &memory));
+   CHECK(ctx->api->BindBufferMemory(ctx->device, buffer, memory, 0));
+   uint8_t *pixels;
+   CHECK(ctx->api->MapMemory(ctx->device, memory, 0, VK_WHOLE_SIZE, 0,
+                             (void **)&pixels));
+   memset(pixels, 0xa5, PIXELS * 4);
+
+   CHECK(ctx->api->ResetCommandBuffer(ctx->cmd, 0));
+   const VkCommandBufferBeginInfo begin = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+   };
+   CHECK(ctx->api->BeginCommandBuffer(ctx->cmd, &begin));
+   const VkImageMemoryBarrier barrier = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .dstAccessMask = VK_ACCESS_MEMORY_WRITE_BIT | VK_ACCESS_MEMORY_READ_BIT,
+      .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+      .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = target.image,
+      .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+   };
+   ctx->api->CmdPipelineBarrier(ctx->cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+      VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, NULL, 0, NULL, 1, &barrier);
+
+   const VkRenderingAttachmentInfo attachment = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO,
+      .imageView = target.view, .imageLayout = VK_IMAGE_LAYOUT_GENERAL,
+      .loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR,
+      .storeOp = VK_ATTACHMENT_STORE_OP_STORE,
+      .clearValue = {.color = {.float32 = {dest_color[0], dest_color[1],
+                                           dest_color[2], dest_color[3]}}},
+   };
+   const VkRenderingInfo rendering = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+      .renderArea = {{0, 0}, {WIDTH, HEIGHT}}, .layerCount = 1,
+      .colorAttachmentCount = 1, .pColorAttachments = &attachment,
+   };
+   ctx->api->CmdBeginRendering(ctx->cmd, &rendering);
+   ctx->api->CmdBindPipeline(ctx->cmd, VK_PIPELINE_BIND_POINT_GRAPHICS,
+                             pipeline);
+   ctx->api->CmdSetVertexInputEXT(ctx->cmd, 0, NULL, 0, NULL);
+   ctx->api->CmdDraw(ctx->cmd, 3, 1, 0, 0);
+   ctx->api->CmdEndRendering(ctx->cmd);
+
+   const VkImageMemoryBarrier read_barrier = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+      .oldLayout = VK_IMAGE_LAYOUT_GENERAL,
+      .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = target.image,
+      .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+   };
+   ctx->api->CmdPipelineBarrier(ctx->cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+      VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, NULL, 0, NULL, 1,
+      &read_barrier);
+   const VkBufferImageCopy copy = {
+      .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+      .imageExtent = {WIDTH, HEIGHT, 1},
+   };
+   ctx->api->CmdCopyImageToBuffer(ctx->cmd, target.image,
+      VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buffer, 1, &copy);
+   const VkMemoryBarrier host = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+   };
+   ctx->api->CmdPipelineBarrier(ctx->cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &host, 0, NULL, 0, NULL);
+   CHECK(ctx->api->EndCommandBuffer(ctx->cmd));
+   const VkSubmitInfo submit = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1, .pCommandBuffers = &ctx->cmd,
+   };
+   CHECK(ctx->api->QueueSubmit(ctx->queue, 1, &submit, VK_NULL_HANDLE));
+   CHECK(ctx->api->QueueWaitIdle(ctx->queue));
+
+   unsigned expected[4];
+   for (unsigned c = 0; c < 4; c++)
+      expected[c] = expected_channel(blend, c);
+   unsigned bad = 0;
+   for (unsigned i = 0; i < PIXELS; i++)
+      for (unsigned c = 0; c < 4; c++)
+         bad += abs((int)pixels[4 * i + c] - (int)expected[c]) > 1;
+   printf("blend=%s pixel0=%u,%u,%u,%u expected=%u,%u,%u,%u mismatches=%u\n",
+          blend->name, pixels[0], pixels[1], pixels[2], pixels[3],
+          expected[0], expected[1], expected[2], expected[3], bad);
+
+   ctx->api->UnmapMemory(ctx->device, memory);
+   ctx->api->DestroyBuffer(ctx->device, buffer, NULL);
+   ctx->api->FreeMemory(ctx->device, memory, NULL);
+   destroy_image(ctx, target);
+   return bad == 0;
+}
+
+int
+main(void)
+{
+   const VkApplicationInfo app = {
+      .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+      .apiVersion = VK_API_VERSION_1_3,
+   };
+   const VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   VkInstance instance;
+   CHECK(kk_CreateInstance(&instance_info, NULL, &instance));
+   PFN_vkEnumeratePhysicalDevices enumerate = (PFN_vkEnumeratePhysicalDevices)
+      kk_GetInstanceProcAddr(instance, "vkEnumeratePhysicalDevices");
+   uint32_t count = 1;
+   VkPhysicalDevice physical;
+   CHECK(enumerate(instance, &count, &physical));
+   const float priority = 1;
+   const VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0, .queueCount = 1, .pQueuePriorities = &priority,
+   };
+   const VkPhysicalDeviceVertexInputDynamicStateFeaturesEXT vertex_input = {
+      .sType =
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VERTEX_INPUT_DYNAMIC_STATE_FEATURES_EXT,
+      .vertexInputDynamicState = VK_TRUE,
+   };
+   const VkPhysicalDeviceVulkan13Features features13 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES,
+      .pNext = (void *)&vertex_input, .dynamicRendering = VK_TRUE,
+   };
+   const char *extensions[] = {
+      VK_EXT_VERTEX_INPUT_DYNAMIC_STATE_EXTENSION_NAME,
+   };
+   const VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO, .pNext = &features13,
+      .queueCreateInfoCount = 1, .pQueueCreateInfos = &queue_info,
+      .enabledExtensionCount = ARRAY_SIZE(extensions),
+      .ppEnabledExtensionNames = extensions,
+   };
+   struct context ctx = {0};
+   CHECK(kk_CreateDevice(physical, &device_info, NULL, &ctx.device));
+   PFN_vkGetPhysicalDeviceMemoryProperties get_memory =
+      (PFN_vkGetPhysicalDeviceMemoryProperties)kk_GetInstanceProcAddr(
+         instance, "vkGetPhysicalDeviceMemoryProperties");
+   get_memory(physical, &ctx.memory);
+   ctx.api = &kk_device_from_handle(ctx.device)->exposed_dispatch_table;
+   ctx.api->GetDeviceQueue(ctx.device, 0, 0, &ctx.queue);
+   const VkCommandPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+      .queueFamilyIndex = 0,
+   };
+   VkCommandPool pool;
+   CHECK(ctx.api->CreateCommandPool(ctx.device, &pool_info, NULL, &pool));
+   const VkCommandBufferAllocateInfo alloc = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = pool, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   CHECK(ctx.api->AllocateCommandBuffers(ctx.device, &alloc, &ctx.cmd));
+
+   const VkPipelineLayoutCreateInfo layout_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+   };
+   VkPipelineLayout layout;
+   CHECK(ctx.api->CreatePipelineLayout(ctx.device, &layout_info, NULL,
+                                       &layout));
+
+   /* The first configuration establishes the compiled pipeline that a broken
+    * cache key would hand to the later ones. */
+   const struct blend_case cases[] = {
+      {"add_add", VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE, VK_BLEND_OP_ADD,
+       VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE, VK_BLEND_OP_ADD},
+      {"add_subtract_alpha", VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE,
+       VK_BLEND_OP_ADD, VK_BLEND_FACTOR_ONE, VK_BLEND_FACTOR_ONE,
+       VK_BLEND_OP_SUBTRACT},
+      {"separate_factors", VK_BLEND_FACTOR_SRC_ALPHA,
+       VK_BLEND_FACTOR_DST_ALPHA, VK_BLEND_OP_ADD,
+       VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA,
+       VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA, VK_BLEND_OP_ADD},
+   };
+   VkPipeline pipelines[ARRAY_SIZE(cases)];
+   for (unsigned i = 0; i < ARRAY_SIZE(cases); i++)
+      pipelines[i] = create_pipeline(&ctx, layout, &cases[i]);
+
+   bool pass = true;
+   for (unsigned i = 0; i < ARRAY_SIZE(cases); i++)
+      pass &= render_and_verify(&ctx, pipelines[i], &cases[i]);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(cases); i++)
+      ctx.api->DestroyPipeline(ctx.device, pipelines[i], NULL);
+   ctx.api->DestroyPipelineLayout(ctx.device, layout, NULL);
+   ctx.api->FreeCommandBuffers(ctx.device, pool, 1, &ctx.cmd);
+   ctx.api->DestroyCommandPool(ctx.device, pool, NULL);
+   printf("%s\n", pass ? "PASS" : "FAIL");
+   return pass ? 0 : 1;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_dynamic_vertex_input_cache.cpp b/src/kosmickrisp/vulkan/tests/test_dynamic_vertex_input_cache.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..65706eb0008d3ae0755a925ff0ddbdc1ef9f3c3e
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_dynamic_vertex_input_cache.cpp
@@ -0,0 +1,350 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ *
+ * Dynamic vertex-input pipelines defer native compilation to the draw that
+ * first supplies concrete vertex-input state.  Equivalent pipelines must share
+ * one parent so that the variants it compiled during command recording are
+ * reused, and that sharing must survive the destruction of the VkPipeline that
+ * happened to link the parent first.  An OpenGL frontend builds an equivalent
+ * pipeline for every program it links, so a per-VkPipeline parent repeats a
+ * complete native compilation at the first draw of each one.
+ */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+#include "dynamic_vertex_input_cache_state.h"
+
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+static void require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (ok)
+      return;
+   std::fprintf(stderr, "%s: %d\n", operation, value);
+   std::exit(1);
+}
+
+template <typename T> static T load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+
+static const uint32_t vertex_spirv[] =
+#include "line_raster_shaders/cache.vert.h"
+;
+static const uint32_t fragment_spirv[] =
+#include "line_raster_shaders/cache.frag.h"
+;
+
+int main()
+{
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+   app.pApplicationName = "dynamic-vertex-input-cache";
+   app.apiVersion = VK_API_VERSION_1_3;
+   VkInstanceCreateInfo instance_info{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+   instance_info.pApplicationInfo = &app;
+   auto result = vkCreateInstance(&instance_info, nullptr, &instance);
+   require(result == VK_SUCCESS, "create instance", result);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkGetPhysicalDeviceFeatures2);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+
+   uint32_t physical_count = 0;
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, nullptr);
+   require(result == VK_SUCCESS && physical_count, "physical device count",
+           result);
+   std::vector<VkPhysicalDevice> physicals(physical_count);
+   result =
+      vkEnumeratePhysicalDevices(instance, &physical_count, physicals.data());
+   require(result == VK_SUCCESS, "physical devices", result);
+
+   for (VkPhysicalDevice physical : physicals) {
+      VkPhysicalDeviceVertexInputDynamicStateFeaturesEXT reported_vertex_input{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VERTEX_INPUT_DYNAMIC_STATE_FEATURES_EXT};
+      VkPhysicalDeviceFeatures2 reported{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+      reported.pNext = &reported_vertex_input;
+      vkGetPhysicalDeviceFeatures2(physical, &reported);
+      require(reported_vertex_input.vertexInputDynamicState,
+              "reported dynamic vertex input feature");
+
+      uint32_t queue_count = 0;
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, nullptr);
+      std::vector<VkQueueFamilyProperties> queues(queue_count);
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count,
+                                               queues.data());
+      uint32_t queue = 0;
+      while (queue < queue_count &&
+             !(queues[queue].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+         ++queue;
+      require(queue < queue_count, "graphics queue");
+
+      float priority = 1.0f;
+      VkDeviceQueueCreateInfo queue_info{
+         VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+      queue_info.queueFamilyIndex = queue;
+      queue_info.queueCount = 1;
+      queue_info.pQueuePriorities = &priority;
+      VkPhysicalDeviceVertexInputDynamicStateFeaturesEXT vertex_input_features{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VERTEX_INPUT_DYNAMIC_STATE_FEATURES_EXT};
+      vertex_input_features.vertexInputDynamicState = VK_TRUE;
+      VkPhysicalDeviceVulkan13Features features13{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+      features13.pNext = &vertex_input_features;
+      features13.dynamicRendering = VK_TRUE;
+      const char *extensions[] = {
+         VK_EXT_VERTEX_INPUT_DYNAMIC_STATE_EXTENSION_NAME};
+      VkDeviceCreateInfo device_info{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+      device_info.pNext = &features13;
+      device_info.queueCreateInfoCount = 1;
+      device_info.pQueueCreateInfos = &queue_info;
+      device_info.enabledExtensionCount = 1;
+      device_info.ppEnabledExtensionNames = extensions;
+      VkDevice device = VK_NULL_HANDLE;
+      result = vkCreateDevice(physical, &device_info, nullptr, &device);
+      require(result == VK_SUCCESS, "create device", result);
+
+#define LOAD_D(name)                                                          \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+      LOAD_D(vkDestroyDevice);
+      LOAD_D(vkCreateShaderModule);
+      LOAD_D(vkDestroyShaderModule);
+      LOAD_D(vkCreatePipelineLayout);
+      LOAD_D(vkDestroyPipelineLayout);
+      LOAD_D(vkCreateGraphicsPipelines);
+      LOAD_D(vkDestroyPipeline);
+      LOAD_D(vkCreateCommandPool);
+      LOAD_D(vkDestroyCommandPool);
+      LOAD_D(vkAllocateCommandBuffers);
+      LOAD_D(vkBeginCommandBuffer);
+      LOAD_D(vkEndCommandBuffer);
+      LOAD_D(vkCmdBeginRendering);
+      LOAD_D(vkCmdEndRendering);
+      LOAD_D(vkCmdBindPipeline);
+      LOAD_D(vkCmdSetViewport);
+      LOAD_D(vkCmdSetScissor);
+      LOAD_D(vkCmdSetVertexInputEXT);
+      LOAD_D(vkCmdDraw);
+      LOAD_D(vkGetDeviceQueue);
+      LOAD_D(vkQueueSubmit);
+      LOAD_D(vkQueueWaitIdle);
+#undef LOAD_D
+
+      VkQueue device_queue = VK_NULL_HANDLE;
+      vkGetDeviceQueue(device, queue, 0, &device_queue);
+      require(device_queue != VK_NULL_HANDLE, "device queue");
+
+      std::array<VkShaderModule, 2> modules{};
+      const std::array<const uint32_t *, 2> sources{vertex_spirv,
+                                                    fragment_spirv};
+      const std::array<size_t, 2> sizes{sizeof(vertex_spirv),
+                                        sizeof(fragment_spirv)};
+      for (unsigned i = 0; i < modules.size(); ++i) {
+         VkShaderModuleCreateInfo info{
+            VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+         info.codeSize = sizes[i];
+         info.pCode = sources[i];
+         result = vkCreateShaderModule(device, &info, nullptr, &modules[i]);
+         require(result == VK_SUCCESS, "create module", result);
+      }
+
+      VkPipelineLayoutCreateInfo layout_info{
+         VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+      VkPipelineLayout layout = VK_NULL_HANDLE;
+      result = vkCreatePipelineLayout(device, &layout_info, nullptr, &layout);
+      require(result == VK_SUCCESS, "create layout", result);
+
+      const std::array<VkPipelineShaderStageCreateInfo, 2> stages{{
+         {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+          VK_SHADER_STAGE_VERTEX_BIT, modules[0], "main", nullptr},
+         {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0,
+          VK_SHADER_STAGE_FRAGMENT_BIT, modules[1], "main", nullptr},
+      }};
+      VkPipelineVertexInputStateCreateInfo vi{
+         VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+      VkPipelineInputAssemblyStateCreateInfo ia{
+         VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+      ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+      VkPipelineViewportStateCreateInfo vp{
+         VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+      vp.viewportCount = vp.scissorCount = 1;
+      VkPipelineRasterizationStateCreateInfo rs{
+         VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+      rs.lineWidth = 1.0f;
+      VkPipelineMultisampleStateCreateInfo ms{
+         VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+      ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+      VkPipelineColorBlendAttachmentState attachment{};
+      attachment.colorWriteMask = 15;
+      VkPipelineColorBlendStateCreateInfo cb{
+         VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+      cb.attachmentCount = 1;
+      cb.pAttachments = &attachment;
+      const VkDynamicState dynamic_states[] = {
+         VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR,
+         VK_DYNAMIC_STATE_VERTEX_INPUT_EXT};
+      VkPipelineDynamicStateCreateInfo dynamic{
+         VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+      dynamic.dynamicStateCount = 3;
+      dynamic.pDynamicStates = dynamic_states;
+      const VkFormat format = VK_FORMAT_R8G8B8A8_UNORM;
+      VkPipelineRenderingCreateInfo rendering{
+         VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+      rendering.colorAttachmentCount = 1;
+      rendering.pColorAttachmentFormats = &format;
+      VkGraphicsPipelineCreateInfo pipeline_info{
+         VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+      pipeline_info.pNext = &rendering;
+      pipeline_info.stageCount = stages.size();
+      pipeline_info.pStages = stages.data();
+      pipeline_info.pVertexInputState = &vi;
+      pipeline_info.pInputAssemblyState = &ia;
+      pipeline_info.pViewportState = &vp;
+      pipeline_info.pRasterizationState = &rs;
+      pipeline_info.pMultisampleState = &ms;
+      pipeline_info.pColorBlendState = &cb;
+      pipeline_info.pDynamicState = &dynamic;
+      pipeline_info.layout = layout;
+
+      /* A compile is required for the first concrete vertex-input state, so
+       * pipeline creation must report it rather than deferring forbidden
+       * compilation into command recording. */
+      pipeline_info.flags =
+         VK_PIPELINE_CREATE_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT;
+      VkPipeline unexpected = VK_NULL_HANDLE;
+      result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
+                                         &pipeline_info, nullptr, &unexpected);
+      require(result == VK_PIPELINE_COMPILE_REQUIRED,
+              "dynamic vertex-input compile-required", result);
+      require(unexpected == VK_NULL_HANDLE, "compile-required pipeline handle");
+
+      const unsigned baseline = kk_test_linked_graphics_pipeline_count(device);
+      pipeline_info.flags = 0;
+      VkPipeline first = VK_NULL_HANDLE;
+      result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
+                                         &pipeline_info, nullptr, &first);
+      require(result == VK_SUCCESS, "first pipeline", result);
+      require(kk_test_linked_graphics_pipeline_count(device) == baseline + 1,
+              "first pipeline adds one parent");
+
+      VkCommandPoolCreateInfo pool_info{
+         VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+      pool_info.queueFamilyIndex = queue;
+      VkCommandPool pool = VK_NULL_HANDLE;
+      result = vkCreateCommandPool(device, &pool_info, nullptr, &pool);
+      require(result == VK_SUCCESS, "command pool", result);
+
+      const VkViewport viewport{0, 0, 8, 8, 0, 1};
+      const VkRect2D scissor{{0, 0}, {8, 8}};
+      VkVertexInputBindingDescription2EXT binding{
+         VK_STRUCTURE_TYPE_VERTEX_INPUT_BINDING_DESCRIPTION_2_EXT};
+      binding.binding = 0;
+      binding.stride = 4;
+      binding.inputRate = VK_VERTEX_INPUT_RATE_VERTEX;
+      binding.divisor = 1;
+      VkVertexInputAttributeDescription2EXT attribute_state{
+         VK_STRUCTURE_TYPE_VERTEX_INPUT_ATTRIBUTE_DESCRIPTION_2_EXT};
+      attribute_state.location = 0;
+      attribute_state.binding = 0;
+      attribute_state.format = VK_FORMAT_R8G8B8A8_UNORM;
+      attribute_state.offset = 0;
+
+      /* Record one draw with the given pipeline and report the native vertex
+       * shader the dynamic vertex-input resolution selected. */
+      const auto record_draw = [&](VkPipeline pipeline) {
+         VkCommandBufferAllocateInfo allocate{
+            VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+         allocate.commandPool = pool;
+         allocate.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+         allocate.commandBufferCount = 1;
+         VkCommandBuffer command = VK_NULL_HANDLE;
+         auto allocated = vkAllocateCommandBuffers(device, &allocate, &command);
+         require(allocated == VK_SUCCESS, "command allocation", allocated);
+         VkCommandBufferBeginInfo begin{
+            VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+         begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+         allocated = vkBeginCommandBuffer(command, &begin);
+         require(allocated == VK_SUCCESS, "command begin", allocated);
+         VkRenderingInfo render{VK_STRUCTURE_TYPE_RENDERING_INFO};
+         render.renderArea.extent = {8, 8};
+         render.layerCount = 1;
+         vkCmdBeginRendering(command, &render);
+         vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+         vkCmdSetViewport(command, 0, 1, &viewport);
+         vkCmdSetScissor(command, 0, 1, &scissor);
+         vkCmdSetVertexInputEXT(command, 1, &binding, 1, &attribute_state);
+         vkCmdDraw(command, 3, 1, 0, 0);
+         const struct kk_shader *resolved =
+            kk_test_dynamic_vertex_input_shader(command);
+         require(resolved != nullptr, "resolved dynamic vertex-input shader");
+         vkCmdEndRendering(command);
+         allocated = vkEndCommandBuffer(command);
+         require(allocated == VK_SUCCESS, "command end", allocated);
+         VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+         submit.commandBufferCount = 1;
+         submit.pCommandBuffers = &command;
+         allocated = vkQueueSubmit(device_queue, 1, &submit, VK_NULL_HANDLE);
+         require(allocated == VK_SUCCESS, "command submit", allocated);
+         allocated = vkQueueWaitIdle(device_queue);
+         require(allocated == VK_SUCCESS, "command completion", allocated);
+         return resolved;
+      };
+
+      const struct kk_shader *compiled = record_draw(first);
+
+      /* An OpenGL frontend creates an equivalent pipeline for every program.
+       * The second pipeline must reuse the variant the first one compiled
+       * instead of repeating the native compilation. */
+      VkPipeline second = VK_NULL_HANDLE;
+      result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
+                                         &pipeline_info, nullptr, &second);
+      require(result == VK_SUCCESS, "second pipeline", result);
+      require(kk_test_linked_graphics_pipeline_count(device) == baseline + 1,
+              "equivalent pipeline shares its parent");
+      require(record_draw(second) == compiled,
+              "equivalent pipeline reuses the compiled variant");
+
+      /* The shared parent outlives the pipeline that linked it first. */
+      vkDestroyPipeline(device, first, nullptr);
+      require(record_draw(second) == compiled,
+              "shared variant survives destroying the first pipeline");
+
+      vkDestroyPipeline(device, second, nullptr);
+      require(kk_test_linked_graphics_pipeline_count(device) == baseline,
+              "last pipeline releases its parent and native variants");
+
+      for (unsigned i = 0; i < 8; ++i) {
+         VkPipeline transient = VK_NULL_HANDLE;
+         result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
+                                            &pipeline_info, nullptr, &transient);
+         require(result == VK_SUCCESS, "transient pipeline", result);
+         record_draw(transient);
+         vkDestroyPipeline(device, transient, nullptr);
+         require(kk_test_linked_graphics_pipeline_count(device) == baseline,
+                 "repeated pipeline destruction returns cache to baseline");
+      }
+      vkDestroyCommandPool(device, pool, nullptr);
+      vkDestroyPipelineLayout(device, layout, nullptr);
+      for (auto module : modules)
+         vkDestroyShaderModule(device, module, nullptr);
+      vkDestroyDevice(device, nullptr);
+   }
+   vkDestroyInstance(instance, nullptr);
+   std::puts("dynamic vertex-input parent cache regression passed");
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_legacy_vertex_attributes.c b/src/kosmickrisp/vulkan/tests/test_legacy_vertex_attributes.c
new file mode 100644
index 0000000000000000000000000000000000000000..52b911ba1d73f1cbcac004db2ec9ee60affcaf3d
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_legacy_vertex_attributes.c
@@ -0,0 +1,239 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kosmickrisp/vulkan/kk_nir_lower_vbo.h"
+#include "kosmickrisp/vulkan/kk_shader_info.h"
+
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+#include "kosmickrisp/compiler/nir_to_msl.h"
+
+#include <assert.h>
+#include <string.h>
+
+struct lowering_stats {
+   nir_intrinsic_instr *typed_load;
+   nir_intrinsic_instr *first_byte_load;
+   unsigned byte_loads;
+   unsigned global_constant_loads;
+   unsigned input_loads;
+   unsigned imul32;
+   unsigned imul64;
+   unsigned udiv32;
+   unsigned bcsel;
+   unsigned ult;
+   unsigned u2f32;
+   unsigned u2u32;
+   unsigned i2i32;
+};
+
+static void
+collect_stats(nir_shader *shader, struct lowering_stats *stats)
+{
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_intrinsic) {
+               nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+               if (intr->intrinsic == nir_intrinsic_load_input)
+                  stats->input_loads++;
+               else if (intr->intrinsic == nir_intrinsic_load_constant_agx) {
+                  if (nir_intrinsic_format(intr) == PIPE_FORMAT_R8_UINT) {
+                     if (stats->first_byte_load == NULL)
+                        stats->first_byte_load = intr;
+                     stats->byte_loads++;
+                  } else {
+                     stats->typed_load = intr;
+                  }
+               } else if (intr->intrinsic ==
+                          nir_intrinsic_load_global_constant)
+                  stats->global_constant_loads++;
+            } else if (instr->type == nir_instr_type_alu) {
+               nir_alu_instr *alu = nir_instr_as_alu(instr);
+               if (alu->op == nir_op_imul && alu->def.bit_size == 32)
+                  stats->imul32++;
+               else if (alu->op == nir_op_imul && alu->def.bit_size == 64)
+                  stats->imul64++;
+               else if (alu->op == nir_op_udiv && alu->def.bit_size == 32)
+                  stats->udiv32++;
+               else if (alu->op == nir_op_bcsel)
+                  stats->bcsel++;
+               else if (alu->op == nir_op_ult)
+                  stats->ult++;
+               else if (alu->op == nir_op_u2f32)
+                  stats->u2f32++;
+               else if (alu->op == nir_op_u2u32)
+                  stats->u2u32++;
+               else if (alu->op == nir_op_i2i32)
+                  stats->i2i32++;
+            }
+         }
+      }
+   }
+}
+
+static nir_shader *
+lower_vertex_fetch(enum pipe_format format, nir_alu_type dest_type,
+                   bool robustness2, bool byte_strides)
+{
+   static const nir_shader_compiler_options options = {0};
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_VERTEX, &options, "legacy vertex attribute lowering test");
+
+   nir_def *input = nir_load_input(
+      &b, 1, 32, nir_imm_int(&b, 0), .base = 0, .range = 1,
+      .dest_type = dest_type,
+      .io_semantics = (nir_io_semantics) {
+         .location = VERT_ATTRIB_GENERIC0,
+         .num_slots = 1,
+      });
+   nir_store_global(&b, input, nir_imm_int64(&b, 0x1000),
+                    .align_mul = sizeof(uint32_t));
+
+   struct kk_attribute attribs[KK_MAX_ATTRIBS] = {
+      [0] = {
+         .binding = 0,
+         .format = format,
+      },
+   };
+   assert(kk_nir_lower_vbo(b.shader, attribs, robustness2, byte_strides));
+   nir_validate_shader(b.shader, "after legacy vertex attribute lowering");
+   return b.shader;
+}
+
+static void
+check_vertex_attribute_mask_phases(void)
+{
+   static const nir_shader_compiler_options options = {0};
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_VERTEX, &options, "vertex attribute mask phase test");
+
+   b.shader->info.inputs_read =
+      BITFIELD64_BIT(VERT_ATTRIB_GENERIC0 + 1) |
+      BITFIELD64_BIT(VERT_ATTRIB_GENERIC0 + 7);
+   assert(!b.shader->info.io_lowered);
+   assert(kk_gather_vs_attribs_read(b.shader) ==
+          (BITFIELD_BIT(1) | BITFIELD_BIT(7)));
+
+   nir_load_input(&b, 1, 32, nir_imm_int(&b, 0), .base = 0, .range = 1,
+                  .dest_type = nir_type_uint32,
+                  .io_semantics = (nir_io_semantics) {
+                     .location = VERT_ATTRIB_GENERIC0 + 3,
+                     .num_slots = 1,
+                  });
+   b.shader->info.io_lowered = true;
+   assert(kk_gather_vs_attribs_read(b.shader) == BITFIELD_BIT(3));
+
+   ralloc_free(b.shader);
+}
+
+static void
+check_aligned_fast_path(void)
+{
+   nir_shader *shader = lower_vertex_fetch(
+      PIPE_FORMAT_R32_UINT, nir_type_uint32, false, false);
+   struct lowering_stats stats = {0};
+   collect_stats(shader, &stats);
+
+   assert(stats.typed_load != NULL);
+   assert(stats.byte_loads == 0);
+   assert(stats.input_loads == 0);
+   assert(stats.imul32 == 1);
+   assert(stats.imul64 == 0);
+   assert(!nir_src_is_const(stats.typed_load->src[1]));
+
+   ralloc_free(shader);
+}
+
+static void
+check_legacy_byte_stride_path(void)
+{
+   nir_shader *shader = lower_vertex_fetch(
+      PIPE_FORMAT_R32_UINT, nir_type_uint32, false, true);
+   struct lowering_stats stats = {0};
+   collect_stats(shader, &stats);
+
+   assert(stats.typed_load == NULL);
+   assert(stats.byte_loads == sizeof(uint32_t));
+   assert(stats.first_byte_load != NULL);
+   assert(stats.input_loads == 0);
+   assert(stats.imul32 == 1);
+   assert(stats.imul64 == 0);
+   assert(stats.udiv32 == 0);
+   assert(stats.first_byte_load->src[0].ssa->bit_size == 64);
+   assert(stats.first_byte_load->src[1].ssa->bit_size == 32);
+   assert(stats.first_byte_load->def.bit_size == 32);
+
+   msl_optimize_nir(shader);
+   nir_shader_gather_info(shader, nir_shader_get_entrypoint(shader));
+   struct nir_to_msl_options options = {0};
+   char *msl = nir_to_msl(shader, &options);
+   assert(strstr(msl, "uint(*((constant uchar*)") != NULL);
+   ralloc_free(msl);
+
+   ralloc_free(shader);
+}
+
+static struct lowering_stats
+lower_and_collect(enum pipe_format format, nir_alu_type dest_type,
+                  bool robustness2)
+{
+   nir_shader *shader = lower_vertex_fetch(
+      format, dest_type, robustness2, true);
+   struct lowering_stats stats = {0};
+   collect_stats(shader, &stats);
+   ralloc_free(shader);
+   return stats;
+}
+
+static void
+check_numeric_type_mismatches(void)
+{
+   /* Cross-type results are implementation-dependent.  Keep KosmicKrisp's
+    * stable choice explicit: convert according to the vertex format, then let
+    * typeless NIR SSA carry those bits to the shader-declared type.
+    */
+   struct lowering_stats unorm_to_uint = lower_and_collect(
+      PIPE_FORMAT_R8_UNORM, nir_type_uint32, false);
+   assert(unorm_to_uint.byte_loads == 1);
+   assert(unorm_to_uint.u2f32 > 0);
+   assert(unorm_to_uint.u2u32 == 0);
+
+   struct lowering_stats uint_to_float = lower_and_collect(
+      PIPE_FORMAT_R8_UINT, nir_type_float32, false);
+   assert(uint_to_float.byte_loads == 1);
+   assert(uint_to_float.u2u32 > 0);
+   assert(uint_to_float.u2f32 == 0);
+
+   struct lowering_stats sint_to_uint = lower_and_collect(
+      PIPE_FORMAT_R8_SINT, nir_type_uint32, false);
+   assert(sint_to_uint.byte_loads == 1);
+   assert(sint_to_uint.i2i32 > 0);
+}
+
+static void
+check_robust_unaligned_fetch(void)
+{
+   struct lowering_stats stats = lower_and_collect(
+      PIPE_FORMAT_R16_UINT, nir_type_uint32, true);
+
+   assert(stats.byte_loads == sizeof(uint16_t));
+   assert(stats.global_constant_loads == 3);
+   assert(stats.bcsel == 1);
+   assert(stats.ult == 1);
+   assert(stats.imul32 == 1);
+   assert(stats.udiv32 == 0);
+}
+
+int
+main(void)
+{
+   check_vertex_attribute_mask_phases();
+   check_aligned_fast_path();
+   check_legacy_byte_stride_path();
+   check_numeric_type_mismatches();
+   check_robust_unaligned_fetch();
