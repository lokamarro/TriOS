 static void
@@ -3106,6 +3105,28 @@ kk_compile_graphics_pipeline(struct kk_device *device, struct kk_shader *vs)
                                        &pipe->gfx.render);
 }
 
+static VkResult
+kk_new_render_pipeline_state_from_origin(struct kk_device *dev,
+                                         struct kk_shader *vs,
+                                         uint16_t color_mask,
+                                         mtl_render_pipeline_state **state_out);
+
+/* Makes every render pipeline of a dynamic vertex-input variant come from
+ * regenerated MSL, as one for an attachment mask the shader did not declare
+ * does, so the tests can run that path on every draw. */
+static bool
+kk_regenerate_msl_forced(void)
+{
+   static int forced = -1;
+   int value = p_atomic_read(&forced);
+   if (value < 0) {
+      const char *env = getenv("MESA_KK_REGENERATE_MSL");
+      value = env != NULL && env[0] != '\0' && env[0] != '0';
+      p_atomic_set(&forced, value);
+   }
+   return value;
+}
+
 mtl_render_pipeline_state *
 kk_shader_render_pipeline(struct kk_device *dev, struct kk_shader *vs,
                           uint16_t bound_color_mask)
@@ -3115,7 +3136,8 @@ kk_shader_render_pipeline(struct kk_device *dev, struct kk_shader *vs,
    /* A render pass binds every attachment the pipeline declares unless the
     * application uses VK_EXT_dynamic_rendering_unused_attachments, so the
     * pipeline compiled with the shader is almost always the right one. */
-   if (likely(bound_color_mask == declared))
+   if (likely(bound_color_mask == declared) &&
+       (vs->msl_origin == NULL || !kk_regenerate_msl_forced()))
       return vs->pipeline.gfx.render;
 
    assert((bound_color_mask & ~declared) == 0);
@@ -3134,8 +3156,10 @@ kk_shader_render_pipeline(struct kk_device *dev, struct kk_shader *vs,
    /* Metal compiles outside the lock: command buffers recorded concurrently
     * for different attachment masks must not serialize on it. */
    mtl_render_pipeline_state *state = NULL;
-   VkResult result =
-      kk_new_render_pipeline_state(dev, vs, bound_color_mask, &state);
+   VkResult result = vs->msl_origin != NULL
+      ? kk_new_render_pipeline_state_from_origin(dev, vs, bound_color_mask,
+                                                 &state)
+      : kk_new_render_pipeline_state(dev, vs, bound_color_mask, &state);
