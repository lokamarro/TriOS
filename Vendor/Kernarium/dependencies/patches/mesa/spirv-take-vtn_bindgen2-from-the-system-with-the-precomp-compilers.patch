From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 14 Sep 2026 02:12:09 +0900
Subject: [PATCH] spirv: take vtn_bindgen2 from the system with the precomp
 compilers

A cross build cannot compile vtn_bindgen2 itself: it is a build machine
target and its vtn, nir and util dependencies are host machine libraries,
which meson refuses to mix. The drivers' precompiled shader compilers have
the same shape and already have a 'system' route, and the two tools are
driven together by the same generators, so let precomp-compiler=system
supply vtn_bindgen2 as well. mesa-clc=system stays a separate switch,
because it additionally demands a mesa_clc that a Vulkan-only build has no
use for.
---
 src/compiler/spirv/meson.build | 33 +++++++++++++++++++++------------
 1 file changed, 21 insertions(+), 12 deletions(-)

diff --git a/src/compiler/spirv/meson.build b/src/compiler/spirv/meson.build
index 83e72020b1c6988ba0180b66e8ce286503b61ccb..53e3a24367cde1f0815a89e3b624a9d51012b164 100644
--- a/src/compiler/spirv/meson.build
+++ b/src/compiler/spirv/meson.build
@@ -81,18 +81,27 @@ spirv2nir = executable(
 if get_option('mesa-clc') != 'system' and (with_driver_using_cl or \
                                            with_kosmickrisp_vk or \
                                            get_option('install-mesa-clc'))
-   prog_vtn_bindgen2 = executable(
-     'vtn_bindgen2',
-     ['vtn_bindgen2.c'],
-     include_directories : [inc_include, inc_src],
-     c_args : [c_msvc_compat_args, no_override_init_args],
-     dependencies : [idep_vtn, idep_mesautil, idep_nir],
-     # If we can run host binaries directly, just build vtn_bindgen for the host.
-     # Most commonly this happens when doing a cross compile from an x86_64 build
-     # machine to an x86 host
-     native : not meson.can_run_host_binaries(),
-     install : get_option('install-mesa-clc'),
-   )
+   if get_option('precomp-compiler') == 'system'
+     # vtn_bindgen2 and the drivers' precompiled shader compilers are driven
+     # together by the same generators, so a cross build that takes one from
+     # the build machine takes both. Building it here instead would link a
+     # build machine target against the host machine's vtn, which meson
+     # refuses.
+     prog_vtn_bindgen2 = find_program('vtn_bindgen2', native : true)
+   else
+     prog_vtn_bindgen2 = executable(
+       'vtn_bindgen2',
+       ['vtn_bindgen2.c'],
+       include_directories : [inc_include, inc_src],
+       c_args : [c_msvc_compat_args, no_override_init_args],
+       dependencies : [idep_vtn, idep_mesautil, idep_nir],
+       # If we can run host binaries directly, just build vtn_bindgen for the host.
+       # Most commonly this happens when doing a cross compile from an x86_64 build
+       # machine to an x86 host
+       native : not meson.can_run_host_binaries(),
+       install : get_option('install-mesa-clc'),
+     )
+   endif
 endif
 
 if with_tests and not with_nir_headers_only
