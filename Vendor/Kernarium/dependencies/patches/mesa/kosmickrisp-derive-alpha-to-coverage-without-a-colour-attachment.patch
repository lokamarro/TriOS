+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+cd -- "$(dirname -- "$0")"
+for shader in a2c.vert a2c_alpha.frag a2c_red.frag; do
+   glslc -O --target-env=vulkan1.3 -mfmt=c "$shader" -o "$shader.h"
+done
diff --git a/src/kosmickrisp/vulkan/tests/test_alpha_to_coverage_no_attachment.cpp b/src/kosmickrisp/vulkan/tests/test_alpha_to_coverage_no_attachment.cpp
