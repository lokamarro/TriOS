index 0000000000000000000000000000000000000000..ebdfed33ce4a020438e3da4a795ff64b88fdf6bb
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_alpha_to_coverage_no_attachment.cpp
@@ -0,0 +1,542 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Alpha to coverage derives the coverage from the fragment shader's Location 0
+ * alpha even when that output reaches no colour attachment.  Both shapes the
+ * conformance suite renders are covered here: a subpass whose first colour
+ * attachment is unused, and a subpass with no colour attachment at all, where
+ * the coverage is only observable through the depth writes it gates.
+ */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+static void require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (!ok) {
+      std::fprintf(stderr, "%s: %d\n", operation, value);
+      std::exit(1);
+   }
+}
+
+template <typename T> static T load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+#define LOAD_D(name)                                                             \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+
+static const uint32_t vertex_spirv[] =
+#include "alpha_to_coverage_shaders/a2c.vert.h"
+;
+static const uint32_t alpha_fragment_spirv[] =
+#include "alpha_to_coverage_shaders/a2c_alpha.frag.h"
+;
+static const uint32_t red_fragment_spirv[] =
+#include "alpha_to_coverage_shaders/a2c_red.frag.h"
+;
+
+int main()
+{
+   std::setvbuf(stdout, nullptr, _IONBF, 0);
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+   app.pApplicationName = "alpha-to-coverage-no-attachment";
+   app.apiVersion = VK_API_VERSION_1_3;
+   VkInstanceCreateInfo instance_info{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+   instance_info.pApplicationInfo = &app;
+   auto result = vkCreateInstance(&instance_info, nullptr, &instance);
+   require(result == VK_SUCCESS, "create instance", result);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceProperties);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   uint32_t physical_count = 0;
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, nullptr);
+   require(result == VK_SUCCESS && physical_count, "physical device count", result);
+   std::vector<VkPhysicalDevice> physicals(physical_count);
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, physicals.data());
+   require(result == VK_SUCCESS, "physical devices", result);
+
+   constexpr uint32_t extent = 32;
+   constexpr VkSampleCountFlagBits samples = VK_SAMPLE_COUNT_4_BIT;
+   constexpr VkFormat color_format = VK_FORMAT_R8G8B8A8_UNORM;
+   constexpr VkFormat depth_format = VK_FORMAT_D32_SFLOAT;
+
+   for (VkPhysicalDevice physical : physicals) {
+      VkPhysicalDeviceProperties properties{};
+      vkGetPhysicalDeviceProperties(physical, &properties);
+      require((properties.limits.framebufferColorSampleCounts & samples) &&
+                 (properties.limits.framebufferDepthSampleCounts & samples),
+              "four sample framebuffers");
+
+      uint32_t queue_count = 0;
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, nullptr);
+      std::vector<VkQueueFamilyProperties> queues(queue_count);
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, queues.data());
+      uint32_t queue = 0;
+      while (queue < queue_count && !(queues[queue].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+         ++queue;
+      require(queue < queue_count, "graphics queue");
+      float priority = 1.0f;
+      VkDeviceQueueCreateInfo queue_info{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+      queue_info.queueFamilyIndex = queue;
+      queue_info.queueCount = 1;
+      queue_info.pQueuePriorities = &priority;
+      VkPhysicalDeviceVulkan13Features features13{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+      features13.dynamicRendering = VK_TRUE;
+      VkDeviceCreateInfo device_info{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+      device_info.pNext = &features13;
+      device_info.queueCreateInfoCount = 1;
+      device_info.pQueueCreateInfos = &queue_info;
+      VkDevice device = VK_NULL_HANDLE;
+      result = vkCreateDevice(physical, &device_info, nullptr, &device);
+      require(result == VK_SUCCESS, "create device", result);
+      LOAD_D(vkDestroyDevice);
+      LOAD_D(vkCreateShaderModule);
+      LOAD_D(vkDestroyShaderModule);
+      LOAD_D(vkCreatePipelineLayout);
+      LOAD_D(vkDestroyPipelineLayout);
+      LOAD_D(vkCreateGraphicsPipelines);
+      LOAD_D(vkDestroyPipeline);
+      LOAD_D(vkCreateCommandPool);
+      LOAD_D(vkDestroyCommandPool);
+      LOAD_D(vkResetCommandPool);
+      LOAD_D(vkAllocateCommandBuffers);
+      LOAD_D(vkBeginCommandBuffer);
+      LOAD_D(vkEndCommandBuffer);
+      LOAD_D(vkCmdBeginRendering);
+      LOAD_D(vkCmdEndRendering);
+      LOAD_D(vkCmdBindPipeline);
+      LOAD_D(vkCmdPushConstants);
+      LOAD_D(vkCmdDraw);
+      LOAD_D(vkGetDeviceQueue);
+      LOAD_D(vkQueueSubmit);
+      LOAD_D(vkCreateFence);
+      LOAD_D(vkDestroyFence);
+      LOAD_D(vkWaitForFences);
+      LOAD_D(vkCreateImage);
+      LOAD_D(vkDestroyImage);
+      LOAD_D(vkCreateImageView);
+      LOAD_D(vkDestroyImageView);
+      LOAD_D(vkGetImageMemoryRequirements);
+      LOAD_D(vkCreateBuffer);
+      LOAD_D(vkDestroyBuffer);
+      LOAD_D(vkGetBufferMemoryRequirements);
+      LOAD_D(vkAllocateMemory);
+      LOAD_D(vkFreeMemory);
+      LOAD_D(vkBindImageMemory);
+      LOAD_D(vkBindBufferMemory);
+      LOAD_D(vkMapMemory);
+      LOAD_D(vkCmdPipelineBarrier);
+      LOAD_D(vkCmdCopyImageToBuffer);
+      VkQueue device_queue = VK_NULL_HANDLE;
+      vkGetDeviceQueue(device, queue, 0, &device_queue);
+
+      VkPhysicalDeviceMemoryProperties memory_properties{};
+      vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+      auto pick_memory = [&](uint32_t bits, VkMemoryPropertyFlags flags) {
+         uint32_t type = 0;
+         while (type < memory_properties.memoryTypeCount &&
+                (!(bits & (1u << type)) ||
+                 (memory_properties.memoryTypes[type].propertyFlags & flags) != flags))
+            ++type;
+         require(type < memory_properties.memoryTypeCount, "memory type");
+         return type;
+      };
+
+      struct Attachment {
+         VkImage image = VK_NULL_HANDLE;
+         VkImageView view = VK_NULL_HANDLE;
+         VkDeviceMemory memory = VK_NULL_HANDLE;
+      };
+      auto make_attachment = [&](VkFormat format, VkSampleCountFlagBits count,
+                                 VkImageUsageFlags usage,
+                                 VkImageAspectFlags aspect) {
+         Attachment attachment;
+         VkImageCreateInfo image_info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+         image_info.imageType = VK_IMAGE_TYPE_2D;
+         image_info.format = format;
+         image_info.extent = {extent, extent, 1};
+         image_info.mipLevels = 1;
+         image_info.arrayLayers = 1;
+         image_info.samples = count;
+         image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+         image_info.usage = usage;
+         result = vkCreateImage(device, &image_info, nullptr, &attachment.image);
+         require(result == VK_SUCCESS, "create image", result);
+         VkMemoryRequirements requirements{};
+         vkGetImageMemoryRequirements(device, attachment.image, &requirements);
+         VkMemoryAllocateInfo memory_info{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+         memory_info.allocationSize = requirements.size;
+         memory_info.memoryTypeIndex = pick_memory(requirements.memoryTypeBits, 0);
+         result = vkAllocateMemory(device, &memory_info, nullptr, &attachment.memory);
+         require(result == VK_SUCCESS, "allocate image", result);
+         result = vkBindImageMemory(device, attachment.image, attachment.memory, 0);
+         require(result == VK_SUCCESS, "bind image", result);
+         VkImageViewCreateInfo view_info{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+         view_info.image = attachment.image;
+         view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+         view_info.format = format;
+         view_info.subresourceRange = {aspect, 0, 1, 0, 1};
+         result = vkCreateImageView(device, &view_info, nullptr, &attachment.view);
+         require(result == VK_SUCCESS, "create view", result);
+         return attachment;
+      };
+
+      const Attachment color = make_attachment(
+         color_format, samples, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT,
+         VK_IMAGE_ASPECT_COLOR_BIT);
+      const Attachment resolve = make_attachment(
+         color_format, VK_SAMPLE_COUNT_1_BIT,
+         VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+         VK_IMAGE_ASPECT_COLOR_BIT);
+      const Attachment depth = make_attachment(
+         depth_format, samples, VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT,
+         VK_IMAGE_ASPECT_DEPTH_BIT);
+
+      const VkDeviceSize readback_size = VkDeviceSize(extent) * extent * 4;
+      VkBufferCreateInfo readback_info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+      readback_info.size = readback_size;
+      readback_info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+      VkBuffer readback = VK_NULL_HANDLE;
+      result = vkCreateBuffer(device, &readback_info, nullptr, &readback);
+      require(result == VK_SUCCESS, "create readback buffer", result);
+      VkMemoryRequirements readback_requirements{};
+      vkGetBufferMemoryRequirements(device, readback, &readback_requirements);
+      VkMemoryAllocateInfo readback_memory_info{
+         VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+      readback_memory_info.allocationSize = readback_requirements.size;
+      readback_memory_info.memoryTypeIndex =
+         pick_memory(readback_requirements.memoryTypeBits,
+                     VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                        VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+      VkDeviceMemory readback_memory = VK_NULL_HANDLE;
+      result = vkAllocateMemory(device, &readback_memory_info, nullptr,
+                                &readback_memory);
+      require(result == VK_SUCCESS, "allocate readback memory", result);
+      result = vkBindBufferMemory(device, readback, readback_memory, 0);
+      require(result == VK_SUCCESS, "bind readback buffer", result);
+      void *readback_data = nullptr;
+      result = vkMapMemory(device, readback_memory, 0, VK_WHOLE_SIZE, 0,
+                           &readback_data);
+      require(result == VK_SUCCESS, "map readback buffer", result);
+
+      const VkPushConstantRange push_range{VK_SHADER_STAGE_FRAGMENT_BIT, 0,
+                                           sizeof(float)};
+      VkPipelineLayoutCreateInfo layout_info{
+         VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+      layout_info.pushConstantRangeCount = 1;
+      layout_info.pPushConstantRanges = &push_range;
+      VkPipelineLayout layout = VK_NULL_HANDLE;
+      result = vkCreatePipelineLayout(device, &layout_info, nullptr, &layout);
+      require(result == VK_SUCCESS, "create layout", result);
+
+      VkShaderModule modules[3] = {};
+      const uint32_t *sources[3] = {vertex_spirv, alpha_fragment_spirv,
+                                    red_fragment_spirv};
+      const size_t sizes[3] = {sizeof(vertex_spirv), sizeof(alpha_fragment_spirv),
+                               sizeof(red_fragment_spirv)};
+      for (unsigned i = 0; i < 3; ++i) {
+         VkShaderModuleCreateInfo module_info{
+            VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+         module_info.codeSize = sizes[i];
+         module_info.pCode = sources[i];
+         result = vkCreateShaderModule(device, &module_info, nullptr, &modules[i]);
+         require(result == VK_SUCCESS, "create module", result);
+      }
+
+      const VkViewport viewport{0.0f, 0.0f, float(extent), float(extent), 0.0f,
+                                1.0f};
+      const VkRect2D scissor{{0, 0}, {extent, extent}};
+
+      /* Every pipeline draws the same full screen triangle at depth zero. */
+      auto make_pipeline = [&](VkShaderModule fragment,
+                               const VkFormat *color_formats,
+                               uint32_t color_format_count, bool has_depth,
+                               bool depth_write, bool alpha_to_coverage) {
+         VkPipelineShaderStageCreateInfo stages[2]{};
+         stages[0].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+         stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+         stages[0].module = modules[0];
+         stages[0].pName = "main";
+         stages[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+         stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+         stages[1].module = fragment;
+         stages[1].pName = "main";
+
+         VkPipelineVertexInputStateCreateInfo vi{
+            VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+         VkPipelineInputAssemblyStateCreateInfo ia{
+            VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+         ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+         VkPipelineViewportStateCreateInfo vp{
+            VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+         vp.viewportCount = 1;
+         vp.pViewports = &viewport;
+         vp.scissorCount = 1;
+         vp.pScissors = &scissor;
+         VkPipelineRasterizationStateCreateInfo rs{
+            VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+         rs.polygonMode = VK_POLYGON_MODE_FILL;
+         rs.cullMode = VK_CULL_MODE_NONE;
+         rs.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+         rs.lineWidth = 1.0f;
+         VkPipelineMultisampleStateCreateInfo ms{
+            VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+         ms.rasterizationSamples = samples;
+         ms.alphaToCoverageEnable = alpha_to_coverage ? VK_TRUE : VK_FALSE;
+         VkPipelineDepthStencilStateCreateInfo ds{
+            VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+         ds.depthTestEnable = has_depth ? VK_TRUE : VK_FALSE;
+         ds.depthWriteEnable = depth_write ? VK_TRUE : VK_FALSE;
+         ds.depthCompareOp = VK_COMPARE_OP_LESS;
+         VkPipelineColorBlendAttachmentState blend_attachments[2]{};
+         for (VkPipelineColorBlendAttachmentState &attachment : blend_attachments)
+            attachment.colorWriteMask = 0xf;
+         VkPipelineColorBlendStateCreateInfo blend{
+            VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+         blend.attachmentCount = color_format_count;
+         blend.pAttachments = blend_attachments;
+         VkPipelineRenderingCreateInfo rendering{
+            VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+         rendering.colorAttachmentCount = color_format_count;
+         rendering.pColorAttachmentFormats = color_formats;
+         rendering.depthAttachmentFormat =
+            has_depth ? depth_format : VK_FORMAT_UNDEFINED;
+         VkGraphicsPipelineCreateInfo pipeline_info{
+            VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+         pipeline_info.pNext = &rendering;
+         pipeline_info.stageCount = 2;
+         pipeline_info.pStages = stages;
+         pipeline_info.pVertexInputState = &vi;
+         pipeline_info.pInputAssemblyState = &ia;
+         pipeline_info.pViewportState = &vp;
+         pipeline_info.pRasterizationState = &rs;
+         pipeline_info.pMultisampleState = &ms;
+         pipeline_info.pDepthStencilState = &ds;
+         pipeline_info.pColorBlendState = &blend;
+         pipeline_info.layout = layout;
+         VkPipeline pipeline = VK_NULL_HANDLE;
+         result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
+                                            &pipeline_info, nullptr, &pipeline);
+         require(result == VK_SUCCESS, "create pipeline", result);
+         return pipeline;
+      };
+
+      const VkFormat unused_formats[2] = {VK_FORMAT_UNDEFINED, color_format};
+      const VkFormat single_format[1] = {color_format};
+      /* The first colour attachment is unused; the shader's Location 0 alpha
+       * still has to drive the coverage of the attached Location 1. */
+      VkPipeline unused_pipeline =
+         make_pipeline(modules[1], unused_formats, 2, false, false, true);
+      /* No colour attachment at all: the coverage is only visible in the depth
+       * writes it gates. */
+      VkPipeline depth_only_pipeline =
+         make_pipeline(modules[1], nullptr, 0, true, true, true);
+      /* The probe that reports whether the depth-only draw wrote depth. */
+      VkPipeline depth_probe_pipeline =
+         make_pipeline(modules[2], single_format, 1, true, false, false);
+
+      VkCommandPoolCreateInfo pool_info{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+      pool_info.queueFamilyIndex = queue;
+      VkCommandPool pool = VK_NULL_HANDLE;
+      result = vkCreateCommandPool(device, &pool_info, nullptr, &pool);
+      require(result == VK_SUCCESS, "create command pool", result);
+      VkCommandBufferAllocateInfo allocate{
+         VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+      allocate.commandPool = pool;
+      allocate.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+      allocate.commandBufferCount = 1;
+      VkCommandBuffer command = VK_NULL_HANDLE;
+      result = vkAllocateCommandBuffers(device, &allocate, &command);
+      require(result == VK_SUCCESS, "allocate command", result);
+
+      VkRenderingAttachmentInfo resolved_color{
+         VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+      resolved_color.imageView = color.view;
+      resolved_color.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      resolved_color.resolveMode = VK_RESOLVE_MODE_AVERAGE_BIT;
+      resolved_color.resolveImageView = resolve.view;
+      resolved_color.resolveImageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      resolved_color.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+      resolved_color.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+      resolved_color.clearValue.color.float32[3] = 1.0f;
+
+      /* Renders one case and returns the red channel every resolved pixel
+       * agreed on, or -1 when the image is not uniform. */
+      auto render = [&](bool depth_only, float alpha) {
+         result = vkResetCommandPool(device, pool, 0);
+         require(result == VK_SUCCESS, "reset command pool", result);
+         VkCommandBufferBeginInfo begin{
+            VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+         begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+         result = vkBeginCommandBuffer(command, &begin);
+         require(result == VK_SUCCESS, "begin command", result);
+
+         VkRenderingAttachmentInfo unused{
+            VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+         VkRenderingAttachmentInfo colors[2] = {unused, resolved_color};
+         VkRenderingAttachmentInfo depth_attachment{
+            VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+         depth_attachment.imageView = depth.view;
+         depth_attachment.imageLayout =
+            VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+         depth_attachment.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+         depth_attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+         depth_attachment.clearValue.depthStencil.depth = 1.0f;
+
+         VkRenderingInfo render_info{VK_STRUCTURE_TYPE_RENDERING_INFO};
+         render_info.renderArea = scissor;
+         render_info.layerCount = 1;
+         if (depth_only) {
+            render_info.colorAttachmentCount = 0;
+            render_info.pDepthAttachment = &depth_attachment;
+         } else {
+            render_info.colorAttachmentCount = 2;
+            render_info.pColorAttachments = colors;
+         }
+         vkCmdBeginRendering(command, &render_info);
+         vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS,
+                           depth_only ? depth_only_pipeline : unused_pipeline);
+         vkCmdPushConstants(command, layout, VK_SHADER_STAGE_FRAGMENT_BIT, 0,
+                            sizeof(alpha), &alpha);
+         vkCmdDraw(command, 3, 1, 0, 0);
+         vkCmdEndRendering(command);
+
+         if (depth_only) {
+            VkMemoryBarrier depth_barrier{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+            depth_barrier.srcAccessMask =
+               VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+            depth_barrier.dstAccessMask =
+               VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT;
+            vkCmdPipelineBarrier(command,
+                                 VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT,
+                                 VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT, 0,
+                                 1, &depth_barrier, 0, nullptr, 0, nullptr);
+
+            /* Draw the same triangle at the same depth with the depth test
+             * kept.  It only reaches the colour attachment where the first
+             * draw left the cleared depth, that is, where coverage was zero. */
+            depth_attachment.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+            depth_attachment.storeOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+            VkRenderingInfo probe_info{VK_STRUCTURE_TYPE_RENDERING_INFO};
+            probe_info.renderArea = scissor;
+            probe_info.layerCount = 1;
+            probe_info.colorAttachmentCount = 1;
+            probe_info.pColorAttachments = &resolved_color;
+            probe_info.pDepthAttachment = &depth_attachment;
+            vkCmdBeginRendering(command, &probe_info);
+            vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS,
+                              depth_probe_pipeline);
+            vkCmdDraw(command, 3, 1, 0, 0);
+            vkCmdEndRendering(command);
+         }
+
+         VkImageMemoryBarrier to_source{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+         to_source.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+         to_source.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+         to_source.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+         to_source.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+         to_source.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+         to_source.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+         to_source.image = resolve.image;
+         to_source.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+         vkCmdPipelineBarrier(command,
+                              VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                              VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0,
+                              nullptr, 1, &to_source);
+         VkBufferImageCopy region{};
+         region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+         region.imageExtent = {extent, extent, 1};
+         vkCmdCopyImageToBuffer(command, resolve.image,
+                                VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, readback,
+                                1, &region);
+         result = vkEndCommandBuffer(command);
+         require(result == VK_SUCCESS, "end command", result);
+
+         VkFenceCreateInfo fence_info{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+         VkFence fence = VK_NULL_HANDLE;
+         result = vkCreateFence(device, &fence_info, nullptr, &fence);
+         require(result == VK_SUCCESS, "create fence", result);
+         VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+         submit.commandBufferCount = 1;
+         submit.pCommandBuffers = &command;
+         result = vkQueueSubmit(device_queue, 1, &submit, fence);
+         require(result == VK_SUCCESS, "submit command", result);
+         result = vkWaitForFences(device, 1, &fence, VK_TRUE, 20000000000ull);
+         require(result == VK_SUCCESS, "draw retired", result);
+         vkDestroyFence(device, fence, nullptr);
+
+         const auto *pixels = static_cast<const uint8_t *>(readback_data);
+         int red = pixels[0];
+         for (VkDeviceSize p = 0; p < readback_size; p += 4) {
+            if (int(pixels[p]) != red)
+               return -1;
+         }
+         return red;
+      };
+
+      struct Case {
+         const char *name;
+         bool depth_only;
+         float alpha;
+         int expected;
+      };
+      /* Zero coverage keeps the unused-attachment draw off the attached colour
+       * and keeps the depth-only draw off the depth buffer, which is what lets
+       * the probe through. */
+      const Case cases[] = {
+         {"unused_attachment alpha 1.0", false, 1.0f, 255},
+         {"unused_attachment alpha 0.0", false, 0.0f, 0},
+         {"no_color_attachment alpha 1.0", true, 1.0f, 0},
+         {"no_color_attachment alpha 0.0", true, 0.0f, 255},
+      };
+      bool failed = false;
+      for (const Case &test : cases) {
+         const int red = render(test.depth_only, test.alpha);
+         std::printf("%s: red %d, expected %d\n", test.name, red, test.expected);
+         if (red != test.expected)
+            failed = true;
+      }
+      require(!failed, "alpha to coverage without a colour attachment");
+      std::printf("alpha to coverage gates every uncovered sample\n");
+
+      vkDestroyCommandPool(device, pool, nullptr);
+      vkDestroyPipeline(device, unused_pipeline, nullptr);
+      vkDestroyPipeline(device, depth_only_pipeline, nullptr);
+      vkDestroyPipeline(device, depth_probe_pipeline, nullptr);
+      for (VkShaderModule module : modules)
+         vkDestroyShaderModule(device, module, nullptr);
+      vkDestroyPipelineLayout(device, layout, nullptr);
+      vkDestroyBuffer(device, readback, nullptr);
+      vkFreeMemory(device, readback_memory, nullptr);
+      for (const Attachment &attachment : {color, resolve, depth}) {
+         vkDestroyImageView(device, attachment.view, nullptr);
+         vkDestroyImage(device, attachment.image, nullptr);
+         vkFreeMemory(device, attachment.memory, nullptr);
+      }
+      vkDestroyDevice(device, nullptr);
+   }
+   vkDestroyInstance(instance, nullptr);
+   return 0;
+}
