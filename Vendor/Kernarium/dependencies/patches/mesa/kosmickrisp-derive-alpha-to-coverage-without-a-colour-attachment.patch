 bool msl_ensure_vertex_point_size_output(nir_shader *nir);
diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
index ff1f36fb770cde1d4508dceec05b49e05ce94b04..f04574b19f162d29a290723989b6feb4207e0f99 100644
--- a/src/kosmickrisp/vulkan/kk_shader.c
+++ b/src/kosmickrisp/vulkan/kk_shader.c
@@ -546,6 +546,30 @@ kk_get_logical_color_att_index(const struct vk_graphics_pipeline_state *state,
    return (state->cal) ? state->cal->color_map[i] : i;
 }
 
+/* Metal derives alpha to coverage from the alpha of colour attachment 0, so it
+ * has nothing to read when the fragment shader's Location 0 output reaches no
+ * attachment: a subpass with no colour attachment at all, or one whose first
+ * attachment is VK_ATTACHMENT_UNUSED.  Vulkan still requires the coverage to
+ * follow that output's alpha, which then gates the depth and stencil writes,
+ * so those pipelines compute the coverage in the shader instead.
+ */
+static bool
+kk_alpha_to_coverage_is_emulated(const struct vk_graphics_pipeline_state *state)
+{
+   if (state == NULL || state->ms == NULL || state->rp == NULL ||
+       !state->ms->alpha_to_coverage_enable)
+      return false;
+
+   for (uint32_t i = 0; i < state->rp->color_attachment_count; ++i) {
+      if (state->rp->color_attachment_formats[i] == VK_FORMAT_UNDEFINED)
+         continue;
+      if (kk_get_logical_color_att_index(state, i) == 0)
+         return false;
+   }
+
+   return true;
+}
+
 static bool
 kk_nir_remove_undeclared_fs_output(nir_builder *b,
                                    nir_intrinsic_instr *intrin, void *data)
@@ -724,14 +748,6 @@ kk_lower_fs(struct kk_device *dev, nir_shader *nir,
             const struct vk_graphics_pipeline_state *state, bool writes_depth,
             bool pipeline_statistics)
 {
-   /* Metal pipelines must not expose fragment outputs for attachments that
-    * were not declared by the Vulkan pipeline.  In particular, an extra
-    * attachment supplied by VkRenderingInfo must still get its render-pass
-    * load/store operations without becoming a shader output. */
-   NIR_PASS(_, nir, nir_shader_intrinsics_pass,
-            kk_nir_remove_undeclared_fs_output, nir_metadata_control_flow,
-            (void *)state);
-
    nir->info.fs.uses_sample_shading |=
       state->ms && state->ms->sample_shading_enable;
 
@@ -742,6 +758,20 @@ kk_lower_fs(struct kk_device *dev, nir_shader *nir,
    if (nir->info.fs.uses_sample_shading)
       NIR_PASS(_, nir, msl_nir_lower_sample_shading);
 
+   /* Emulated alpha to coverage consumes the Location 0 alpha, so it runs
+    * before the output that carries it is dropped below.  Sample shading has
+    * already narrowed the incoming coverage to the sample being shaded. */
+   if (kk_alpha_to_coverage_is_emulated(state))
+      NIR_PASS(_, nir, msl_lower_alpha_to_coverage);
+
+   /* Metal pipelines must not expose fragment outputs for attachments that
+    * were not declared by the Vulkan pipeline.  In particular, an extra
+    * attachment supplied by VkRenderingInfo must still get its render-pass
+    * load/store operations without becoming a shader output. */
+   NIR_PASS(_, nir, nir_shader_intrinsics_pass,
+            kk_nir_remove_undeclared_fs_output, nir_metadata_control_flow,
+            (void *)state);
+
    if (state->cb)
       kk_lower_fs_blend(nir, state);
 
@@ -3610,7 +3640,11 @@ gather_graphics_pipeline_create_info(
    if (info->vs.has_ms) {
       const struct vk_multisample_state *ms = state->ms;
       info->vs.sample_count = ms->rasterization_samples;
-      info->vs.has_alpha_to_coverage_enabled = ms->alpha_to_coverage_enable;
+      /* Metal's own alpha to coverage would read an attachment that carries
+       * neither the shader's Location 0 output nor a defined alpha, so the
+       * emulated pipelines keep it off and mask the coverage in the shader. */
+      info->vs.has_alpha_to_coverage_enabled =
+         ms->alpha_to_coverage_enable && !kk_alpha_to_coverage_is_emulated(state);
       info->vs.has_alpha_to_one_enabled = ms->alpha_to_one_enable;
    }
 
