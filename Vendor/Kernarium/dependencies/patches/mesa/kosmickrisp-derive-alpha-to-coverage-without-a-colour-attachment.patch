diff --git a/src/kosmickrisp/compiler/msl_nir_lower_common.c b/src/kosmickrisp/compiler/msl_nir_lower_common.c
index 2c837a01f80e43657c37bbd3fb2535bc8d9a674a..d3b0aaff248a874ebd48f71c5981b1b5d15bfa50 100644
--- a/src/kosmickrisp/compiler/msl_nir_lower_common.c
+++ b/src/kosmickrisp/compiler/msl_nir_lower_common.c
@@ -189,6 +189,94 @@ msl_lower_static_sample_mask(nir_shader *nir, uint32_t sample_mask)
    return true;
 }
 
+/* Coverage from an alpha value, with a number of set bits proportional to the
+ * alpha and one mask per alpha.  The low 2, 4, 8 or 16 bits are each a valid
+ * mask on their own, so the same value serves every sample count Metal
+ * rasterizes with.
+ */
+static nir_def *
+build_alpha_coverage_mask(nir_builder *b, nir_def *alpha)
+{
+   nir_def *m = nir_f2i32(b, nir_fmul_imm(b, nir_fsat(b, alpha), 16.0));
+
+   nir_def *part_a = nir_iand_imm(
+      b, nir_ushr(b, nir_imm_int(b, 0xfea80), nir_iand_imm(b, m, ~3)), 0xf);
+   nir_def *part_b = nir_iand_imm(b, m, 2);
+   nir_def *part_c = nir_iand_imm(b, m, 1);
+
+   return nir_ior(b, nir_imul_imm(b, part_a, 0x1111),
+                  nir_ior(b, nir_imul_imm(b, part_b, 0x0808),
+                          nir_imul_imm(b, part_c, 0x0100)));
+}
+
+bool
+msl_lower_alpha_to_coverage(nir_shader *nir)
+{
+   assert(nir->info.stage == MESA_SHADER_FRAGMENT);
+
+   /* Fragment outputs have been sunk into the final block, so both stores are
+    * unique and both operands dominate the end of the shader. */
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_intrinsic_instr *color_store = NULL;
+   nir_intrinsic_instr *mask_store = NULL;
+
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+         if (intrin->intrinsic != nir_intrinsic_store_output)
+            continue;
+
+         const nir_io_semantics io = nir_intrinsic_io_semantics(intrin);
+         if (io.location == FRAG_RESULT_SAMPLE_MASK) {
+            mask_store = intrin;
+         } else if (io.location == FRAG_RESULT_DATA0 ||
+                    io.location == FRAG_RESULT_COLOR) {
+            const unsigned written = nir_intrinsic_write_mask(intrin)
+                                     << nir_intrinsic_component(intrin);
+            if (written & BITFIELD_BIT(3))
+               color_store = intrin;
+         }
+      }
+   }
+
+   /* Without an alpha there is nothing to derive coverage from; Vulkan leaves
+    * the fragment fully covered. */
+   if (color_store == NULL)
+      return false;
+
+   nir_builder b = nir_builder_at(nir_after_impl(impl));
+
+   const unsigned component = nir_intrinsic_component(color_store);
+   assert(component <= 3u);
+   nir_def *alpha = nir_channel(&b, color_store->src[0].ssa, 3u - component);
+   nir_def *coverage = build_alpha_coverage_mask(&b, alpha);
+
+   nir_def *sample_mask;
+   if (mask_store != NULL) {
+      sample_mask = mask_store->src[0].ssa;
+      nir_instr_remove(&mask_store->instr);
+   } else {
+      sample_mask = nir_load_sample_mask_in(&b);
+      BITSET_SET(nir->info.system_values_read, SYSTEM_VALUE_SAMPLE_MASK_IN);
+   }
+
+   struct nir_io_semantics io_semantics = {
+      .location = FRAG_RESULT_SAMPLE_MASK,
+      .num_slots = 1u,
+   };
+   nir_store_output(&b, nir_iand(&b, sample_mask, coverage), nir_imm_int(&b, 0u),
+                    .base = 0u, .range = 1u, .write_mask = 0x1, .component = 0u,
+                    .src_type = nir_type_uint32, .io_semantics = io_semantics);
+   nir->info.outputs_written |= BITFIELD64_BIT(FRAG_RESULT_SAMPLE_MASK);
+
+   nir_progress(true, impl, nir_metadata_control_flow);
+
+   return true;
+}
+
 bool
 msl_ensure_depth_write(nir_shader *nir)
 {
