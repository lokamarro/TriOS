--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/helper_invocation_shaders/generate.sh
@@ -0,0 +1,7 @@
+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+cd -- "$(dirname -- "$0")"
+for shader in helper.vert helper.frag; do
+   glslc -O --target-env=vulkan1.3 -mfmt=c "$shader" -o "$shader.h"
+done
diff --git a/src/kosmickrisp/vulkan/tests/helper_invocation_shaders/helper.frag b/src/kosmickrisp/vulkan/tests/helper_invocation_shaders/helper.frag
new file mode 100644
index 0000000000000000000000000000000000000000..a078add2abf486713f17a13f0c042d7e9580f621
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/helper_invocation_shaders/helper.frag
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: MIT */
+#version 460
+#extension GL_EXT_demote_to_helper_invocation : require
+#extension GL_KHR_shader_subgroup_quad : require
+
+/* The shape of dEQP-VK.draw.renderpass.shader_invocation.helper_invocation:
+ * a quad demotes two of its four invocations, then reads the helper state and
+ * the memory a demoted invocation must no longer write. */
+
+layout(set = 0, binding = 0) readonly buffer Block0 {
+   float alpha[];
+};
+
+layout(set = 0, binding = 1) buffer Block1 {
+   uint atomics[];
+};
+
+layout(location = 0) out vec4 color;
+
+float build_alpha_shuffle(float v)
+{
+   v = (helperInvocationEXT() ? 8.0 : roundEven(v));
+   vec4 helpers;
+   helpers.x = subgroupQuadBroadcast(v, 0u);
+   helpers.y = subgroupQuadBroadcast(v, 1u);
+   helpers.z = subgroupQuadBroadcast(v, 2u);
+   helpers.w = subgroupQuadBroadcast(v, 3u);
+
+   return dot(helpers, vec4(1, 10, 100, 1000));
+}
+
+void main()
+{
+   ivec2 coord = ivec2(gl_FragCoord.xy);
+   int linear_coord = coord.y * 2 + coord.x;
+
+   float alpha_value = alpha[linear_coord];
+   float mask0 = build_alpha_shuffle(alpha_value);
+
+   /* Lane 1 and 2 are demoted here. */
+   if (fract(alpha_value) < 0.5) {
+      demote;
+   }
+
+   float mask1 = build_alpha_shuffle(alpha_value);
+   uint last_value = 0u;
+
+   last_value = atomicAdd(atomics[linear_coord], 101u);
+
+   if (linear_coord == 3 || last_value > 1000) {
+      demote;
+   }
+
+   float mask2 = build_alpha_shuffle(alpha_value);
+
+   color = vec4(1.0, mask0, mask1, mask2);
+}
