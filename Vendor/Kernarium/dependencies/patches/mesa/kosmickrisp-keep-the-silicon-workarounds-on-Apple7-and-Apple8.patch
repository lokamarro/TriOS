diff --git a/src/kosmickrisp/vulkan/kk_device.c b/src/kosmickrisp/vulkan/kk_device.c
index 9fc9b511a30ed945122bb8c598ffe791db3071c7..954f3eb96626ab721bcf0af834f2e955df797655 100644
--- a/src/kosmickrisp/vulkan/kk_device.c
+++ b/src/kosmickrisp/vulkan/kk_device.c
@@ -245,10 +245,18 @@ kk_parse_device_environment_options(struct kk_device *dev)
       dev->disabled_workarounds |= BITFIELD64_BIT(index);
    }
 
-   /* Workarounds resolved on macOS 27 */
+   /* Workarounds resolved on macOS 27.  KK_WORKAROUND_3 and KK_WORKAROUND_4
+    * are not among them on every GPU: both compensate for Apple7 and Apple8
+    * silicon, where simd_is_helper_thread() does not observe a
+    * discard_fragment() that ran before it and a ballot or vote inside a
+    * conditional block answers for every thread the SIMD group entered the
+    * shader with.  Neither query becomes usable there whatever the operating
+    * system reports. */
    if (ns_is_os_version_at_least(27, 0, 0)) {
-      dev->disabled_workarounds |= BITFIELD64_MASK(7);
-      dev->disabled_workarounds |= BITFIELD64_BIT(12);
+      uint64_t resolved = BITFIELD64_MASK(7) | BITFIELD64_BIT(12);
+      if (kk_device_physical(dev)->info.gpu_apple_family <= 8u)
+         resolved &= ~(BITFIELD64_BIT(3) | BITFIELD64_BIT(4));
+      dev->disabled_workarounds |= resolved;
    }
 }
 
