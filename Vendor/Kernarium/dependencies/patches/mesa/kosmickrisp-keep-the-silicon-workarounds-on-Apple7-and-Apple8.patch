--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/helper_invocation_shaders/helper.vert
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: MIT */
+#version 460
+
+/* A right triangle whose three corners sit exactly on the clip volume, so no
+ * clipper splits it into several primitives, and whose hypotenuse stays well
+ * clear of the top left two by two quad the test reads. */
+void main()
+{
+   vec2 p = vec2(float(gl_VertexIndex & 1), float((gl_VertexIndex >> 1) & 1));
+   gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
