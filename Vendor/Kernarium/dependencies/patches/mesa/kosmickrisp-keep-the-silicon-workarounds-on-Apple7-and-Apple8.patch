+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* A demoted fragment invocation keeps executing: every later read of the
+ * helper built-in must see the demote, every earlier read must not, it keeps
+ * taking part in the quad group so its neighbours read the value it computes,
+ * and it stops writing memory.  This renders the shape of
+ * dEQP-VK.draw.renderpass.shader_invocation.helper_invocation over one fully
+ * covered quad, where the outcome is exact: the two invocations whose alpha
+ * has a low fraction demote before the atomic, the last one demotes after it,
+ * and only the first invocation survives to write colour.  A helper query
+ * that reports one moment of the shader for all three reads - what the Metal
+ * compiler produces when the driver leaves the query to the hardware - gets
+ * the first two quad broadcasts wrong.
+ */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+static void require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (!ok) {
+      std::fprintf(stderr, "%s: %d\n", operation, value);
+      std::exit(1);
+   }
+}
+
+template <typename T> static T load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+#define LOAD_D(name)                                                             \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+
+static const uint32_t vertex_spirv[] =
+#include "helper_invocation_shaders/helper.vert.h"
+   ;
+static const uint32_t fragment_spirv[] =
+#include "helper_invocation_shaders/helper.frag.h"
+   ;
+
+/* The alpha the shader reads for invocation n of the quad.  Invocations one
+ * and two have a fraction below a half and demote before the atomic. */
+static const float alpha_values[4] = {0.75f, 2.25f, 3.25f, 3.75f};
+
+/* roundEven of the four alphas, the value a non-helper contributes to the
+ * quad broadcast, weighted by the shader's dot product. */
+static constexpr float weights[4] = {1.0f, 10.0f, 100.0f, 1000.0f};
+
+static float shuffle(const float v[4])
+{
+   return v[0] * weights[0] + v[1] * weights[1] + v[2] * weights[2] +
+          v[3] * weights[3];
+}
+
+int main()
+{
+   std::setvbuf(stdout, nullptr, _IONBF, 0);
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+   app.pApplicationName = "helper-invocation-demote";
+   app.apiVersion = VK_API_VERSION_1_3;
+   VkInstanceCreateInfo instance_info{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+   instance_info.pApplicationInfo = &app;
+   auto result = vkCreateInstance(&instance_info, nullptr, &instance);
+   require(result == VK_SUCCESS, "create instance", result);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceProperties2);
+   LOAD_I(vkGetPhysicalDeviceFeatures2);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   uint32_t physical_count = 0;
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, nullptr);
+   require(result == VK_SUCCESS && physical_count, "physical device count", result);
+   std::vector<VkPhysicalDevice> physicals(physical_count);
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, physicals.data());
+   require(result == VK_SUCCESS, "physical devices", result);
+
+   /* The render area is four by four so the one triangle the test draws fits
+    * inside the clip volume - a triangle that has to be clipped comes back as
+    * several primitives, and each of those shades the quad with a different
+    * coverage.  A scissor then keeps every fragment inside the single top left
+    * quad, which the triangle covers completely. */
+   constexpr uint32_t extent = 4;
+   constexpr uint32_t quad = 2;
+   constexpr VkFormat color_format = VK_FORMAT_R32G32B32A32_SFLOAT;
+
+   for (VkPhysicalDevice physical : physicals) {
+      VkPhysicalDeviceSubgroupProperties subgroup{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_PROPERTIES};
+      VkPhysicalDeviceProperties2 properties{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2};
+      properties.pNext = &subgroup;
+      vkGetPhysicalDeviceProperties2(physical, &properties);
+      require((subgroup.supportedOperations & VK_SUBGROUP_FEATURE_QUAD_BIT) &&
+                 (subgroup.supportedStages & VK_SHADER_STAGE_FRAGMENT_BIT),
+              "fragment quad subgroup operations");
+
+      VkPhysicalDeviceVulkan13Features features13{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+      VkPhysicalDeviceFeatures2 supported{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+      supported.pNext = &features13;
+      vkGetPhysicalDeviceFeatures2(physical, &supported);
+      require(features13.shaderDemoteToHelperInvocation == VK_TRUE,
+              "demote to helper invocation");
+
+      uint32_t queue_count = 0;
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, nullptr);
+      std::vector<VkQueueFamilyProperties> queues(queue_count);
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, queues.data());
+      uint32_t queue = 0;
+      while (queue < queue_count && !(queues[queue].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+         ++queue;
+      require(queue < queue_count, "graphics queue");
+      float priority = 1.0f;
+      VkDeviceQueueCreateInfo queue_info{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+      queue_info.queueFamilyIndex = queue;
+      queue_info.queueCount = 1;
+      queue_info.pQueuePriorities = &priority;
+      VkPhysicalDeviceVulkan13Features enabled13{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+      enabled13.dynamicRendering = VK_TRUE;
+      enabled13.shaderDemoteToHelperInvocation = VK_TRUE;
+      VkPhysicalDeviceFeatures2 features{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+      features.pNext = &enabled13;
+      features.features.fragmentStoresAndAtomics = VK_TRUE;
+      VkDeviceCreateInfo device_info{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+      device_info.pNext = &features;
+      device_info.queueCreateInfoCount = 1;
+      device_info.pQueueCreateInfos = &queue_info;
+      VkDevice device = VK_NULL_HANDLE;
+      result = vkCreateDevice(physical, &device_info, nullptr, &device);
+      require(result == VK_SUCCESS, "create device", result);
+
+      LOAD_D(vkDestroyDevice);
+      LOAD_D(vkCreateShaderModule);
+      LOAD_D(vkDestroyShaderModule);
+      LOAD_D(vkCreateDescriptorSetLayout);
+      LOAD_D(vkDestroyDescriptorSetLayout);
+      LOAD_D(vkCreateDescriptorPool);
+      LOAD_D(vkDestroyDescriptorPool);
+      LOAD_D(vkAllocateDescriptorSets);
+      LOAD_D(vkUpdateDescriptorSets);
