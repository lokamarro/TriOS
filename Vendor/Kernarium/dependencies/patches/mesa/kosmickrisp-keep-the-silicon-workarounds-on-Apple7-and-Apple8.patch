+      pipeline_info.layout = layout;
+      VkPipeline pipeline = VK_NULL_HANDLE;
+      result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &pipeline_info,
+                                         nullptr, &pipeline);
+      require(result == VK_SUCCESS, "create pipeline", result);
+
+      VkCommandPoolCreateInfo pool_info{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+      pool_info.queueFamilyIndex = queue;
+      VkCommandPool pool = VK_NULL_HANDLE;
+      result = vkCreateCommandPool(device, &pool_info, nullptr, &pool);
+      require(result == VK_SUCCESS, "create command pool", result);
+      VkCommandBufferAllocateInfo allocate{
+         VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+      allocate.commandPool = pool;
+      allocate.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+      allocate.commandBufferCount = 1;
+      VkCommandBuffer command = VK_NULL_HANDLE;
+      result = vkAllocateCommandBuffers(device, &allocate, &command);
+      require(result == VK_SUCCESS, "allocate command", result);
+
+      VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+      begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+      result = vkBeginCommandBuffer(command, &begin);
+      require(result == VK_SUCCESS, "begin command", result);
+      VkRenderingAttachmentInfo attachment{
+         VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+      attachment.imageView = color_view;
+      attachment.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      attachment.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+      attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+      for (float &channel : attachment.clearValue.color.float32)
+         channel = 1.0f;
+      VkRenderingInfo render_info{VK_STRUCTURE_TYPE_RENDERING_INFO};
+      render_info.renderArea = render_area;
+      render_info.layerCount = 1;
+      render_info.colorAttachmentCount = 1;
+      render_info.pColorAttachments = &attachment;
+      vkCmdBeginRendering(command, &render_info);
+      vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+      vkCmdBindDescriptorSets(command, VK_PIPELINE_BIND_POINT_GRAPHICS, layout, 0,
+                              1, &set, 0, nullptr);
+      vkCmdDraw(command, 3, 1, 0, 0);
+      vkCmdEndRendering(command);
+
+      VkImageMemoryBarrier to_source{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+      to_source.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+      to_source.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+      to_source.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      to_source.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+      to_source.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      to_source.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      to_source.image = color;
+      to_source.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+      vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr,
+                           1, &to_source);
+      VkBufferImageCopy region{};
+      region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+      region.imageExtent = {extent, extent, 1};
+      vkCmdCopyImageToBuffer(command, color, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                             readback.buffer, 1, &region);
+      result = vkEndCommandBuffer(command);
+      require(result == VK_SUCCESS, "end command", result);
+
+      VkFenceCreateInfo fence_info{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+      VkFence fence = VK_NULL_HANDLE;
+      result = vkCreateFence(device, &fence_info, nullptr, &fence);
+      require(result == VK_SUCCESS, "create fence", result);
+      VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+      submit.commandBufferCount = 1;
+      submit.pCommandBuffers = &command;
+      result = vkQueueSubmit(device_queue, 1, &submit, fence);
+      require(result == VK_SUCCESS, "submit command", result);
+      result = vkWaitForFences(device, 1, &fence, VK_TRUE, 20000000000ull);
+      require(result == VK_SUCCESS, "draw retired", result);
+      vkDestroyFence(device, fence, nullptr);
+
+      /* Invocation zero survives both demotes and writes the only colour.  Its
+       * three neighbours keep contributing to the quad broadcast after they
+       * demote, with the helper value the shader substitutes. */
+      const float pre[4] = {std::nearbyint(alpha_values[0]),
+                            std::nearbyint(alpha_values[1]),
+                            std::nearbyint(alpha_values[2]),
+                            std::nearbyint(alpha_values[3])};
+      const float after_first[4] = {pre[0], 8.0f, 8.0f, pre[3]};
+      const float after_second[4] = {pre[0], 8.0f, 8.0f, 8.0f};
+      const float expected_pixel[4] = {1.0f, shuffle(pre), shuffle(after_first),
+                                       shuffle(after_second)};
+      /* Only the invocations that reach the atomic as non-helpers add to it. */
+      const uint32_t expected_atomics[4] = {101, 0, 0, 101};
+
+      const auto *pixels = static_cast<const float *>(readback.data);
+      const auto *counts = static_cast<const uint32_t *>(atomics.data);
+      const float clear[4] = {1.0f, 1.0f, 1.0f, 1.0f};
+      bool failed = false;
+      for (unsigned y = 0; y < extent; ++y) {
+         for (unsigned x = 0; x < extent; ++x) {
+            /* Only the invocation that never demoted writes; every other
+             * pixel of the quad demoted and the rest were scissored away. */
+            const float *expected = (x | y) == 0 ? expected_pixel : clear;
+            const float *pixel = &pixels[(y * extent + x) * 4];
+            if (std::memcmp(pixel, expected, sizeof(clear)) == 0)
+               continue;
+            std::printf("pixel %u,%u: %g %g %g %g, expected %g %g %g %g\n", x, y,
+                        pixel[0], pixel[1], pixel[2], pixel[3], expected[0],
+                        expected[1], expected[2], expected[3]);
+            failed = true;
+         }
+      }
+      std::printf("quad colour: %g %g %g %g, expected %g %g %g %g\n", pixels[0],
+                  pixels[1], pixels[2], pixels[3], expected_pixel[0],
+                  expected_pixel[1], expected_pixel[2], expected_pixel[3]);
+      std::printf("atomics: %u %u %u %u, expected %u %u %u %u\n", counts[0],
+                  counts[1], counts[2], counts[3], expected_atomics[0],
+                  expected_atomics[1], expected_atomics[2], expected_atomics[3]);
+      for (unsigned i = 0; i < 4; ++i) {
+         if (counts[i] != expected_atomics[i])
+            failed = true;
+      }
+      require(!failed, "demoted invocations stay helpers in the quad");
+      std::printf("a demoted invocation reports itself and stops writing\n");
+
+      vkDestroyCommandPool(device, pool, nullptr);
+      vkDestroyPipeline(device, pipeline, nullptr);
+      for (VkShaderModule module : modules)
+         vkDestroyShaderModule(device, module, nullptr);
+      vkDestroyPipelineLayout(device, layout, nullptr);
+      vkDestroyDescriptorPool(device, descriptor_pool, nullptr);
+      vkDestroyDescriptorSetLayout(device, set_layout, nullptr);
+      vkDestroyImageView(device, color_view, nullptr);
+      vkDestroyImage(device, color, nullptr);
+      vkFreeMemory(device, image_memory, nullptr);
+      for (const Buffer &buffer : {alpha, atomics, readback}) {
+         vkDestroyBuffer(device, buffer.buffer, nullptr);
+         vkFreeMemory(device, buffer.memory, nullptr);
+      }
+      vkDestroyDevice(device, nullptr);
+   }
+   vkDestroyInstance(instance, nullptr);
+   return 0;
+}
