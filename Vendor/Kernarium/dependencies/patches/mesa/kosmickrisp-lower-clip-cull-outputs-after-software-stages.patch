From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 5 Sep 2026 20:45:53 +0900
Subject: [PATCH] kosmickrisp: lower clip/cull outputs after software stages

Keep compact clip/cull varyings intact while materializing software vertex and tessellation stages. Raster-only clip-distance intrinsics otherwise become invalid compute outputs, while separated cull varyings no longer match the raw transform-feedback interface.

Lower the final Metal vertex/fragment interface only after software-stage conversion. Add native clip, cull, and mixed transform-feedback regressions for ordinary and device-address bindings, negative values, nonzero ranges, and untouched range guards.
---
 src/kosmickrisp/vulkan/kk_shader.c            |  14 +-
 src/kosmickrisp/vulkan/meson.build            |  14 +
 .../test_transform_feedback_builtins.cpp      | 333 ++++++++++++++++++
 .../xfb_builtin_shaders/builtins-0.vert.h     |  59 ++++
 .../xfb_builtin_shaders/builtins-1.vert.h     |  59 ++++
 .../xfb_builtin_shaders/builtins-2.vert.h     |  77 ++++
 .../tests/xfb_builtin_shaders/builtins.vert   |  34 ++
 .../tests/xfb_builtin_shaders/generate.sh     |   8 +
 8 files changed, 594 insertions(+), 4 deletions(-)
 create mode 100644 src/kosmickrisp/vulkan/tests/test_transform_feedback_builtins.cpp
 create mode 100644 src/kosmickrisp/vulkan/tests/xfb_builtin_shaders/builtins-0.vert.h
 create mode 100644 src/kosmickrisp/vulkan/tests/xfb_builtin_shaders/builtins-1.vert.h
 create mode 100644 src/kosmickrisp/vulkan/tests/xfb_builtin_shaders/builtins-2.vert.h
 create mode 100644 src/kosmickrisp/vulkan/tests/xfb_builtin_shaders/builtins.vert
 create mode 100644 src/kosmickrisp/vulkan/tests/xfb_builtin_shaders/generate.sh

diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
index eef5df8c536f110b24844c369551666188d11d14..0377cb8f26162bdd3841689fa367b5ed9b2e14fb 100644
--- a/src/kosmickrisp/vulkan/kk_shader.c
+++ b/src/kosmickrisp/vulkan/kk_shader.c
@@ -1170,10 +1170,6 @@ kk_compile_shader_as(struct kk_device *dev, nir_shader *nir,
    gather_shader_info(shader, nir, state);
    shader->info.stage = logical_stage;
 
-   unsigned num_cull_distances =
-      prev_stage ? prev_stage->info.num_cull_distances : 0;
-   msl_nir_lower_clip_cull_distance(nir, num_cull_distances);
-
    /* When using poly to emulate tessellation, vertex and tess control shaders
     * are turned to compute shaders that will be dispatched before the draw
     * call. Tess evalutaion shaders are turned into vertex shaders. */
@@ -1225,6 +1221,16 @@ kk_compile_shader_as(struct kk_device *dev, nir_shader *nir,
       }
    }
 
+   /* Software stages exchange compact clip/cull varyings, including the raw
+    * values captured by transform feedback.  Separate that interface and emit
+    * Metal raster outputs only after software-stage materialization. */
+   if (nir->info.stage == MESA_SHADER_VERTEX ||
+       nir->info.stage == MESA_SHADER_FRAGMENT) {
+      unsigned num_cull_distances =
+         prev_stage ? prev_stage->info.num_cull_distances : 0;
+      msl_nir_lower_clip_cull_distance(nir, num_cull_distances);
+   }
+
    NIR_PASS(_, nir, kk_nir_lower_poly, pipeline_statistics);
 
    msl_optimize_nir(nir);
