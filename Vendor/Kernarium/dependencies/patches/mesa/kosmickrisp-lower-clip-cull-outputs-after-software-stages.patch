@@ -0,0 +1,8 @@
+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+cd -- "$(dirname -- "$0")"
+for kind in 0 1 2; do
+   glslc -O --target-env=vulkan1.3 -mfmt=c -DKIND="$kind" \
+      builtins.vert -o "builtins-$kind.vert.h"
+done
