--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/xfb_builtin_shaders/builtins.vert
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: MIT
+#version 450
+
+layout(push_constant) uniform Push { float bias; } pc;
+
+#if KIND == 0
+layout(xfb_buffer = 1, xfb_offset = 0) out gl_PerVertex {
+   float gl_ClipDistance[8];
+};
+#elif KIND == 1
+layout(xfb_buffer = 1, xfb_offset = 0) out gl_PerVertex {
+   float gl_CullDistance[8];
+};
+#else
+layout(xfb_buffer = 1, xfb_offset = 0) out gl_PerVertex {
+   float gl_CullDistance[5];
+   float gl_ClipDistance[1];
+};
+#endif
+
+void main()
+{
+#if KIND == 0
+   for (int i = 0; i < 8; ++i)
+      gl_ClipDistance[i] = float(8 * gl_VertexIndex + i) / 32768.0 + pc.bias;
+#elif KIND == 1
+   for (int i = 0; i < 8; ++i)
+      gl_CullDistance[i] = float(8 * gl_VertexIndex + i) / 32768.0 + pc.bias;
+#else
+   for (int i = 0; i < 5; ++i)
+      gl_CullDistance[i] = float(6 * gl_VertexIndex + i) / 32768.0 + pc.bias;
+   gl_ClipDistance[0] = float(6 * gl_VertexIndex + 5) / 32768.0 + pc.bias;
+#endif
+}
