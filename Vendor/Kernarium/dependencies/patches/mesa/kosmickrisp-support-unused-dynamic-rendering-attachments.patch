+   NIR_PASS(_, nir, nir_shader_intrinsics_pass,
+            kk_nir_remove_undeclared_fs_output, nir_metadata_control_flow,
+            (void *)state);
+
    nir->info.fs.uses_sample_shading |=
       state->ms && state->ms->sample_shading_enable;
 
