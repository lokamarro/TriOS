+mtl_render_pipeline_state *
+kk_shader_render_pipeline(struct kk_device *dev, struct kk_shader *vs,
+                          uint16_t bound_color_mask)
+{
+   const uint16_t declared = kk_shader_color_attachment_mask(vs);
+
+   /* A render pass binds every attachment the pipeline declares unless the
+    * application uses VK_EXT_dynamic_rendering_unused_attachments, so the
+    * pipeline compiled with the shader is almost always the right one. */
+   if (likely(bound_color_mask == declared))
+      return vs->pipeline.gfx.render;
+
+   assert((bound_color_mask & ~declared) == 0);
+
+   simple_mtx_lock(&attachment_variants_lock);
+   util_dynarray_foreach(&vs->attachment_variants,
+                         struct kk_attachment_variant, variant) {
+      if (variant->color_mask == bound_color_mask) {
+         mtl_render_pipeline_state *state = variant->state;
+         simple_mtx_unlock(&attachment_variants_lock);
+         return state;
+      }
+   }
+   simple_mtx_unlock(&attachment_variants_lock);
+
+   /* Metal compiles outside the lock: command buffers recorded concurrently
+    * for different attachment masks must not serialize on it. */
+   mtl_render_pipeline_state *state = NULL;
+   VkResult result =
+      kk_new_render_pipeline_state(dev, vs, bound_color_mask, &state);
+   if (result != VK_SUCCESS)
+      return NULL;
+
+   simple_mtx_lock(&attachment_variants_lock);
+   util_dynarray_foreach(&vs->attachment_variants,
+                         struct kk_attachment_variant, variant) {
+      if (variant->color_mask == bound_color_mask) {
+         /* A concurrent recorder won the race for this mask. */
+         mtl_release(state);
+         state = variant->state;
+         simple_mtx_unlock(&attachment_variants_lock);
+         return state;
+      }
+   }
+   struct kk_attachment_variant *slot = util_dynarray_grow(
+      &vs->attachment_variants, struct kk_attachment_variant, 1);
+   if (slot == NULL) {
+      simple_mtx_unlock(&attachment_variants_lock);
+      mtl_release(state);
+      return NULL;
+   }
+   slot->color_mask = bound_color_mask;
+   slot->state = state;
+   simple_mtx_unlock(&attachment_variants_lock);
+
+   return state;
