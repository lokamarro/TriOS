index 0000000000000000000000000000000000000000..8e2d589df8860818eecee59439eb63e98b83c943
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/unused_attachment_shaders/unused_att.frag
@@ -0,0 +1,14 @@
+#version 460
+/* SPDX-License-Identifier: MIT */
+/* Every output carries its own location in the blue channel so a value that
+ * lands in the wrong colour attachment names the output it came from. */
+layout (location=0) out uvec4 color0;
+layout (location=1) out uvec4 color1;
+layout (location=2) out uvec4 color2;
+layout (location=3) out uvec4 color3;
+void main (void) {
+    color0 = uvec4(0u, 255u, 0u, 255u);
+    color1 = uvec4(0u, 255u, 1u, 255u);
+    color2 = uvec4(0u, 255u, 2u, 255u);
+    color3 = uvec4(0u, 255u, 3u, 255u);
+}
