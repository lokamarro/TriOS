+static void
+kk_set_depth_stencil_attachments(
+   mtl_render_pass_descriptor *pass_descriptor,
+   struct kk_rendering_state *render, uint16_t bound_attachments,
+   bool force_attachment_load)
+{
+   mtl_render_pass_attachment_descriptor *depth_descriptor =
+      mtl_render_pass_descriptor_get_depth_attachment(pass_descriptor);
+   kk_clear_common_attachment_description(depth_descriptor);
+   if (render->depth_att.iview &&
+       (bound_attachments & MESA_VK_RP_ATTACHMENT_DEPTH_BIT)) {
+      const struct kk_image_view *iview = render->depth_att.iview;
+      const struct kk_image *image =
+         container_of(iview->vk.image, struct kk_image, vk);
+      render->samples = image->vk.samples;
+
+      kk_fill_common_attachment_description(
+         depth_descriptor, &render->depth_att, force_attachment_load);
+
+      /* Metal validation rejects invalid clear-depth values even if the load
+       * action does not clear the attachment. */
+      if (render->depth_att.load_op == VK_ATTACHMENT_LOAD_OP_CLEAR)
+         mtl_render_pass_attachment_descriptor_set_clear_depth(
+            depth_descriptor, render->depth_att.clear_value.depthStencil.depth);
+   }
+
+   mtl_render_pass_attachment_descriptor *stencil_descriptor =
+      mtl_render_pass_descriptor_get_stencil_attachment(pass_descriptor);
+   kk_clear_common_attachment_description(stencil_descriptor);
+   if (render->stencil_att.iview &&
+       (bound_attachments & MESA_VK_RP_ATTACHMENT_STENCIL_BIT)) {
+      const struct kk_image_view *iview = render->stencil_att.iview;
+      const struct kk_image *image =
+         container_of(iview->vk.image, struct kk_image, vk);
+      render->samples = image->vk.samples;
+
+      kk_fill_common_attachment_description(
+         stencil_descriptor, &render->stencil_att, force_attachment_load);
+      mtl_render_pass_attachment_descriptor_set_clear_stencil(
+         stencil_descriptor,
+         render->stencil_att.clear_value.depthStencil.stencil);
+   }
+}
+
+static uint16_t
+kk_rendering_attachment_mask(const struct kk_rendering_state *render,
+                             const struct vk_dynamic_graphics_state *dyn)
+{
+   uint16_t mask = 0;
+   for (uint32_t i = 0; i < render->color_att_count; i++) {
+      const uint8_t logical_index = dyn->cal.color_map[i];
+      if (render->color_att[i].iview &&
+          logical_index != MESA_VK_ATTACHMENT_UNUSED)
+         mask |= BITFIELD_BIT(logical_index);
+   }
+
+   if (render->depth_att.iview)
+      mask |= MESA_VK_RP_ATTACHMENT_DEPTH_BIT;
+   if (render->stencil_att.iview)
+      mask |= MESA_VK_RP_ATTACHMENT_STENCIL_BIT;
+
+   return mask;
+}
+
+static uint16_t
+kk_pipeline_attachment_mask(const struct kk_shader *vs)
+{
+   uint16_t mask = kk_shader_color_attachment_mask(vs);
+
+   if (vs->info.vs.d_format != MTL_PIXEL_FORMAT_INVALID)
+      mask |= MESA_VK_RP_ATTACHMENT_DEPTH_BIT;
+   if (vs->info.vs.s_format != MTL_PIXEL_FORMAT_INVALID)
+      mask |= MESA_VK_RP_ATTACHMENT_STENCIL_BIT;
+
+   return mask;
+}
