+static bool
+kk_nir_remove_undeclared_fs_output(nir_builder *b,
+                                   nir_intrinsic_instr *intrin, void *data)
+{
+   if (intrin->intrinsic != nir_intrinsic_store_output)
+      return false;
+
+   const nir_io_semantics io = nir_intrinsic_io_semantics(intrin);
+   if (io.location < FRAG_RESULT_DATA0 || io.location > FRAG_RESULT_DATA7)
+      return false;
+
+   const struct vk_graphics_pipeline_state *state = data;
+   const uint8_t logical_index = io.location - FRAG_RESULT_DATA0;
+
+   for (uint32_t i = 0; i < state->rp->color_attachment_count; i++) {
+      if (state->rp->color_attachment_formats[i] != VK_FORMAT_UNDEFINED &&
+          kk_get_logical_color_att_index(state, i) == logical_index)
+         return false;
+   }
+
+   nir_instr_remove(&intrin->instr);
+   b->shader->info.outputs_written &= ~BITFIELD64_BIT(io.location);
+
+   return true;
+}
