diff --git a/src/kosmickrisp/vulkan/tests/test_depth_clip.c b/src/kosmickrisp/vulkan/tests/test_depth_clip.c
new file mode 100644
index 0000000000000000000000000000000000000000..ea22399e94091d0ed8b1f3a7f9964071bf9fe9ef
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_depth_clip.c
@@ -0,0 +1,223 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kosmickrisp/vulkan/kk_depth_clip.h"
+
+#include <assert.h>
+
+static void
+check_state(enum vk_mesa_depth_clip_enable depth_clip_enable,
+            bool depth_clamp_enable, enum mtl_depth_clip_mode expected_mode,
+            bool expected_remap, bool expected_manual_clamp)
+{
+   struct vk_rasterization_state rs = {
+      .depth_clamp_enable = depth_clamp_enable,
+      .depth_clip_enable = depth_clip_enable,
+   };
+
+   assert(kk_mtl_depth_clip_mode(&rs) == expected_mode);
+   assert(kk_depth_clip_requires_viewport_remap(&rs) == expected_remap);
+   assert(kk_manual_depth_clamp_enable(&rs) == expected_manual_clamp);
+}
+
+static void
+check_fragment_mode(enum vk_mesa_depth_clip_enable depth_clip_enable,
+                    bool depth_clamp_enable, bool dynamic_clip,
+                    bool dynamic_clamp,
+                    enum kk_fragment_depth_clamp_mode expected)
+{
+   struct vk_rasterization_state rs = {
+      .depth_clamp_enable = depth_clamp_enable,
+      .depth_clip_enable = depth_clip_enable,
+   };
+   struct vk_graphics_pipeline_state state = {.rs = &rs};
+
+   if (dynamic_clip)
+      BITSET_SET(state.dynamic, MESA_VK_DYNAMIC_RS_DEPTH_CLIP_ENABLE);
+   if (dynamic_clamp)
+      BITSET_SET(state.dynamic, MESA_VK_DYNAMIC_RS_DEPTH_CLAMP_ENABLE);
+
+   assert(kk_fragment_depth_clamp_mode(&state) == expected);
+}
+
+static void
+check_possible(enum vk_mesa_depth_clip_enable depth_clip_enable,
+               bool depth_clamp_enable, bool dynamic_clip, bool dynamic_clamp,
+               bool enabled, bool expected)
+{
+   struct vk_rasterization_state rs = {
+      .depth_clamp_enable = depth_clamp_enable,
+      .depth_clip_enable = depth_clip_enable,
+   };
+   struct vk_graphics_pipeline_state state = {.rs = &rs};
+
+   if (dynamic_clip)
+      BITSET_SET(state.dynamic, MESA_VK_DYNAMIC_RS_DEPTH_CLIP_ENABLE);
+   if (dynamic_clamp)
+      BITSET_SET(state.dynamic, MESA_VK_DYNAMIC_RS_DEPTH_CLAMP_ENABLE);
+
+   assert(kk_is_possible_both_depth_clip_clamp(&state, enabled) == expected);
+}
+
+static bool
+reference_possible(enum vk_mesa_depth_clip_enable static_clip,
+                   bool static_clamp, bool dynamic_clip, bool dynamic_clamp,
+                   bool enabled)
+{
+   for (unsigned clamp = 0; clamp <= 1; clamp++) {
+      if (!dynamic_clamp && clamp != static_clamp)
+         continue;
+
+      for (unsigned clip = 0; clip <= 1; clip++) {
+         if (!dynamic_clip) {
+            const bool resolved_clip =
+               static_clip == VK_MESA_DEPTH_CLIP_ENABLE_NOT_CLAMP
+                  ? !clamp
+                  : static_clip == VK_MESA_DEPTH_CLIP_ENABLE_TRUE;
+            if (clip != resolved_clip)
+               continue;
+         }
+
+         if (clip == enabled && clamp == enabled)
+            return true;
+      }
+   }
+
+   return false;
+}
+
+static void
+check_all_pipeline_possibilities(void)
+{
+   const enum vk_mesa_depth_clip_enable clip_states[] = {
+      VK_MESA_DEPTH_CLIP_ENABLE_NOT_CLAMP,
+      VK_MESA_DEPTH_CLIP_ENABLE_FALSE,
+      VK_MESA_DEPTH_CLIP_ENABLE_TRUE,
+   };
+
+   for (unsigned s = 0; s < ARRAY_SIZE(clip_states); s++) {
+      for (unsigned static_clamp = 0; static_clamp <= 1; static_clamp++) {
+         for (unsigned dynamic_clip = 0; dynamic_clip <= 1; dynamic_clip++) {
+            for (unsigned dynamic_clamp = 0; dynamic_clamp <= 1;
+                 dynamic_clamp++) {
+               for (unsigned enabled = 0; enabled <= 1; enabled++) {
+                  const bool expected =
+                     reference_possible(clip_states[s], static_clamp,
+                                        dynamic_clip, dynamic_clamp, enabled);
+                  check_possible(clip_states[s], static_clamp, dynamic_clip,
+                                 dynamic_clamp, enabled, expected);
+               }
+            }
+         }
+      }
+   }
+}
+
+static void
+check_transform(enum vk_mesa_depth_clip_enable depth_clip_enable,
+                bool depth_clamp_enable, float min_depth, float max_depth,
+                float expected_scale, float expected_bias)
+{
+   const struct vk_rasterization_state rs = {
+      .depth_clamp_enable = depth_clamp_enable,
+      .depth_clip_enable = depth_clip_enable,
+   };
+   const struct kk_depth_clip_transform transform =
+      kk_depth_clip_transform(&rs, min_depth, max_depth);
+
+   assert(transform.scale == expected_scale);
+   assert(transform.bias == expected_bias);
+}
+
+int
+main(void)
+{
+   /* Explicit depth clipping is independent of depth clamping. */
+   check_state(VK_MESA_DEPTH_CLIP_ENABLE_FALSE, false,
+               MTL_DEPTH_CLIP_MODE_CLAMP, true, false);
+   check_state(VK_MESA_DEPTH_CLIP_ENABLE_FALSE, true, MTL_DEPTH_CLIP_MODE_CLAMP,
+               false, false);
+   check_state(VK_MESA_DEPTH_CLIP_ENABLE_TRUE, false, MTL_DEPTH_CLIP_MODE_CLIP,
+               false, false);
+   check_state(VK_MESA_DEPTH_CLIP_ENABLE_TRUE, true, MTL_DEPTH_CLIP_MODE_CLIP,
+               false, true);
+
+   /* Without explicit state, depthClampEnable retains Vulkan 1.0 behavior. */
+   check_state(VK_MESA_DEPTH_CLIP_ENABLE_NOT_CLAMP, false,
+               MTL_DEPTH_CLIP_MODE_CLIP, false, false);
+   check_state(VK_MESA_DEPTH_CLIP_ENABLE_NOT_CLAMP, true,
+               MTL_DEPTH_CLIP_MODE_CLAMP, false, false);
+
+   check_fragment_mode(VK_MESA_DEPTH_CLIP_ENABLE_TRUE, true, false, false,
+                       KK_FRAGMENT_DEPTH_CLAMP_ALWAYS);
+   check_fragment_mode(VK_MESA_DEPTH_CLIP_ENABLE_TRUE, true, true, false,
+                       KK_FRAGMENT_DEPTH_CLAMP_DYNAMIC);
+   check_fragment_mode(VK_MESA_DEPTH_CLIP_ENABLE_TRUE, true, false, true,
+                       KK_FRAGMENT_DEPTH_CLAMP_DYNAMIC);
+   check_fragment_mode(VK_MESA_DEPTH_CLIP_ENABLE_TRUE, false, false, true,
+                       KK_FRAGMENT_DEPTH_CLAMP_DYNAMIC);
+   check_fragment_mode(VK_MESA_DEPTH_CLIP_ENABLE_FALSE, true, true, false,
+                       KK_FRAGMENT_DEPTH_CLAMP_DYNAMIC);
+   check_fragment_mode(VK_MESA_DEPTH_CLIP_ENABLE_TRUE, false, true, false,
+                       KK_FRAGMENT_DEPTH_CLAMP_NONE);
+   check_fragment_mode(VK_MESA_DEPTH_CLIP_ENABLE_FALSE, true, false, true,
+                       KK_FRAGMENT_DEPTH_CLAMP_NONE);
+   check_fragment_mode(VK_MESA_DEPTH_CLIP_ENABLE_NOT_CLAMP, true, false, true,
+                       KK_FRAGMENT_DEPTH_CLAMP_NONE);
+
+   /* Compile shader emulation only when a matching state is reachable. */
+   check_possible(VK_MESA_DEPTH_CLIP_ENABLE_FALSE, false, false, false, false,
+                  true);
+   check_possible(VK_MESA_DEPTH_CLIP_ENABLE_TRUE, true, false, false, true,
+                  true);
+   check_possible(VK_MESA_DEPTH_CLIP_ENABLE_TRUE, false, false, false, false,
+                  false);
+   check_possible(VK_MESA_DEPTH_CLIP_ENABLE_FALSE, true, false, false, true,
+                  false);
+   check_possible(VK_MESA_DEPTH_CLIP_ENABLE_TRUE, false, true, false, false,
+                  true);
+   check_possible(VK_MESA_DEPTH_CLIP_ENABLE_FALSE, true, false, true, false,
+                  true);
+   check_possible(VK_MESA_DEPTH_CLIP_ENABLE_TRUE, false, false, true, true,
+                  true);
+   check_possible(VK_MESA_DEPTH_CLIP_ENABLE_FALSE, true, true, false, true,
+                  true);
+   check_possible(VK_MESA_DEPTH_CLIP_ENABLE_NOT_CLAMP, false, false, true,
+                  false, false);
+   check_possible(VK_MESA_DEPTH_CLIP_ENABLE_NOT_CLAMP, true, false, true, true,
+                  false);
+   check_all_pipeline_possibilities();
+
+   struct vk_graphics_pipeline_state dynamic_only = {};
+   BITSET_SET(dynamic_only.dynamic, MESA_VK_DYNAMIC_RS_DEPTH_CLIP_ENABLE);
+   BITSET_SET(dynamic_only.dynamic, MESA_VK_DYNAMIC_RS_DEPTH_CLAMP_ENABLE);
+   assert(kk_is_possible_both_depth_clip_clamp(&dynamic_only, false));
+   assert(kk_is_possible_both_depth_clip_clamp(&dynamic_only, true));
+   assert(kk_fragment_depth_clamp_mode(&dynamic_only) ==
+          KK_FRAGMENT_DEPTH_CLAMP_DYNAMIC);
+
+   /* Native clip/clamp needs no additional viewport transform. */
+   check_transform(VK_MESA_DEPTH_CLIP_ENABLE_TRUE, false, 0.25f, 0.75f, 1.0f,
+                   0.0f);
+   check_transform(VK_MESA_DEPTH_CLIP_ENABLE_TRUE, true, 0.25f, 0.75f, 1.0f,
+                   0.0f);
+
+   /* This follows the ordinary clip-range conversion, so both Vulkan clip
+    * ranges use the same final viewport transform.
+    */
+   check_transform(VK_MESA_DEPTH_CLIP_ENABLE_FALSE, false, 0.25f, 0.75f, 0.5f,
+                   0.25f);
+   check_transform(VK_MESA_DEPTH_CLIP_ENABLE_FALSE, false, 0.75f, 0.25f, -0.5f,
+                   0.75f);
+
+   const struct kk_depth_clamp_range forward =
+      kk_depth_clamp_range(0.25f, 0.75f);
+   const struct kk_depth_clamp_range reverse =
+      kk_depth_clamp_range(0.75f, 0.25f);
+   assert(forward.min == 0.25f && forward.max == 0.75f);
+   assert(reverse.min == 0.25f && reverse.max == 0.75f);
+
+   return 0;
+}
