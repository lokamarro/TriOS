diff --git a/src/kosmickrisp/vulkan/kk_depth_clip.h b/src/kosmickrisp/vulkan/kk_depth_clip.h
new file mode 100644
index 0000000000000000000000000000000000000000..8b698c583019baad22275dfd358aacb4e77726fc
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_depth_clip.h
@@ -0,0 +1,117 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef KK_DEPTH_CLIP_H
+#define KK_DEPTH_CLIP_H 1
+
+#include "kosmickrisp/bridge/mtl_types.h"
+
+#include "vulkan/runtime/vk_graphics_state.h"
+
+struct kk_depth_clip_transform {
+   float scale;
+   float bias;
+};
+
+struct kk_depth_clamp_range {
+   float min;
+   float max;
+};
+
+enum kk_fragment_depth_clamp_mode {
+   KK_FRAGMENT_DEPTH_CLAMP_NONE,
+   KK_FRAGMENT_DEPTH_CLAMP_ALWAYS,
+   KK_FRAGMENT_DEPTH_CLAMP_DYNAMIC,
+};
+
+static inline bool
+kk_is_possible_both_depth_clip_clamp(
+   const struct vk_graphics_pipeline_state *state, bool enabled)
+{
+   const bool clamp_dynamic =
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_DEPTH_CLAMP_ENABLE);
+   const bool clip_dynamic =
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_DEPTH_CLIP_ENABLE);
+
+   /* Without rasterization state, depth clamp must be dynamic and depth clip
+    * remains its inverse unless that state is dynamic too.
+    */
+   if (state->rs == NULL)
+      return clamp_dynamic && clip_dynamic;
+
+   /* The legacy state is defined as the inverse of depthClampEnable. */
+   if (!clip_dynamic &&
+       state->rs->depth_clip_enable == VK_MESA_DEPTH_CLIP_ENABLE_NOT_CLAMP)
+      return false;
+
+   const bool static_clamp_match = state->rs->depth_clamp_enable == enabled;
+   const bool static_clip_match =
+      vk_rasterization_state_depth_clip_enable(state->rs) == enabled;
+
+   return (clamp_dynamic || static_clamp_match) &&
+          (clip_dynamic || static_clip_match);
+}
+
+static inline enum mtl_depth_clip_mode
+kk_mtl_depth_clip_mode(const struct vk_rasterization_state *rs)
+{
+   return vk_rasterization_state_depth_clip_enable(rs)
+             ? MTL_DEPTH_CLIP_MODE_CLIP
+             : MTL_DEPTH_CLIP_MODE_CLAMP;
+}
+
+static inline bool
+kk_depth_clip_requires_viewport_remap(const struct vk_rasterization_state *rs)
+{
+   return !vk_rasterization_state_depth_clip_enable(rs) &&
+          !rs->depth_clamp_enable;
+}
+
+static inline bool
+kk_manual_depth_clamp_enable(const struct vk_rasterization_state *rs)
+{
+   return rs->depth_clamp_enable &&
+          vk_rasterization_state_depth_clip_enable(rs);
+}
+
+static inline enum kk_fragment_depth_clamp_mode
+kk_fragment_depth_clamp_mode(const struct vk_graphics_pipeline_state *state)
+{
+   const bool clamp_dynamic =
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_DEPTH_CLAMP_ENABLE);
+   const bool clip_dynamic =
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_DEPTH_CLIP_ENABLE);
+
+   if (!kk_is_possible_both_depth_clip_clamp(state, true))
+      return KK_FRAGMENT_DEPTH_CLAMP_NONE;
+
+   return clamp_dynamic || clip_dynamic ? KK_FRAGMENT_DEPTH_CLAMP_DYNAMIC
+                                        : KK_FRAGMENT_DEPTH_CLAMP_ALWAYS;
+}
+
+static inline struct kk_depth_clip_transform
+kk_depth_clip_transform(const struct vk_rasterization_state *rs,
+                        float min_depth, float max_depth)
+{
+   if (kk_depth_clip_requires_viewport_remap(rs)) {
+      return (struct kk_depth_clip_transform){
+         .scale = max_depth - min_depth,
+         .bias = min_depth,
+      };
+   }
+
+   return (struct kk_depth_clip_transform){.scale = 1.0f, .bias = 0.0f};
+}
+
+static inline struct kk_depth_clamp_range
+kk_depth_clamp_range(float min_depth, float max_depth)
+{
+   return min_depth < max_depth
+             ? (struct kk_depth_clamp_range){.min = min_depth, .max = max_depth}
+             : (struct kk_depth_clamp_range){.min = max_depth,
+                                             .max = min_depth};
+}
+
+#endif /* KK_DEPTH_CLIP_H */
