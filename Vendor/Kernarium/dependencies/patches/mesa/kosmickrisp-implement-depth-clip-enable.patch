+static nir_def *
+kk_load_depth_clip_array(nir_builder *b, nir_def *viewport,
+                         unsigned array_offset, unsigned element_size)
+{
+   viewport = nir_umin_imm(b, nir_u2u32(b, viewport), KK_MAX_VIEWPORTS - 1);
+
+   nir_def *byte_offset = nir_imul_imm(b, viewport, element_size);
+   byte_offset = nir_iadd_imm(b, byte_offset, array_offset);
+
+   return kk_nir_load_root(b, 2, 32, byte_offset, 4);
+}
+
+static nir_def *
+kk_load_depth_clip_transform(nir_builder *b, nir_def *viewport)
+{
+   return kk_load_depth_clip_array(
+      b, viewport,
+      offsetof(struct kk_root_descriptor_table, draw.depth_clip_transforms),
+      sizeof(struct kk_depth_clip_transform));
+}
+
+static nir_def *
+kk_load_depth_clamp_range(nir_builder *b, nir_def *viewport)
+{
+   return kk_load_depth_clip_array(
+      b, viewport,
+      offsetof(struct kk_root_descriptor_table, draw.depth_clamp_ranges),
+      sizeof(struct kk_depth_clamp_range));
+}
+
+static nir_def *
+kk_load_manual_depth_clamp_enable(nir_builder *b)
+{
+   return kk_nir_load_root(
+      b, 1, 32,
+      nir_imm_int(b, offsetof(struct kk_root_descriptor_table,
+                              draw.manual_depth_clamp_enable)),
+      4);
+}
+
+static bool
+kk_nir_lower_depth_clip_position(nir_shader *nir)
+{
+   bool progress = false;
+
+   nir_foreach_function_impl(impl, nir) {
+      bool impl_progress = false;
+
+      nir_foreach_block(block, impl) {
+         nir_intrinsic_instr *position = NULL;
+         nir_intrinsic_instr *viewport = NULL;
+
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic != nir_intrinsic_store_output)
+               continue;
+
+            const nir_io_semantics io = nir_intrinsic_io_semantics(intr);
+            if (io.location == VARYING_SLOT_POS) {
+               assert(position == NULL && "one position store per exit");
+               position = intr;
+            } else if (io.location == VARYING_SLOT_VIEWPORT) {
+               assert(viewport == NULL && "one viewport store per exit");
+               viewport = intr;
+            }
+         }
+
+         if (position == NULL)
+            continue;
+
+         /* Output stores are unordered.  Place position last so a dynamic
+          * viewport index is available regardless of source assignment order.
+          */
+         nir_instr_move(nir_after_block_before_jump(block), &position->instr);
+
+         nir_builder b = nir_builder_at(nir_before_instr(&position->instr));
+         nir_def *viewport_index =
+            viewport ? viewport->src[0].ssa : nir_imm_int(&b, 0);
+         nir_def *transform = kk_load_depth_clip_transform(&b, viewport_index);
+         nir_def *pos = position->src[0].ssa;
+         nir_def *z = nir_ffma_weak(&b, nir_channel(&b, pos, 2),
+                                    nir_channel(&b, transform, 0),
+                                    nir_fmul(&b, nir_channel(&b, pos, 3),
+                                             nir_channel(&b, transform, 1)));
+
+         nir_src_rewrite(&position->src[0],
+                         nir_vector_insert_imm(&b, pos, z, 2));
+         impl_progress = true;
+      }
+
+      if (impl_progress)
+         nir_progress(true, impl, nir_metadata_control_flow);
+      progress |= impl_progress;
+   }
+
+   return progress;
+}
+
 /* Lowering for the stage which ends up as the vertex stage on hardware */
 static void
 kk_lower_hw_vs(nir_shader *nir, const struct vk_graphics_pipeline_state *state)
@@ -392,6 +498,14 @@ kk_lower_hw_vs(nir_shader *nir, const struct vk_graphics_pipeline_state *state)
 
    NIR_PASS(_, nir, msl_ensure_vertex_position_output);
    NIR_PASS(_, nir, nir_lower_clip_halfz_dynamic);
+
+   /* Metal's clamp mode also clamps the post-viewport depth.  Apply the
+    * Vulkan viewport transform in the vertex shader only when both clipping
+    * and clamping can be disabled, and give Metal an identity depth range.
+    */
+   if (kk_is_possible_both_depth_clip_clamp(state, false))
+      NIR_PASS(_, nir, kk_nir_lower_depth_clip_position);
+
    NIR_PASS(_, nir, msl_nir_vs_io_types);
 }
 
@@ -525,9 +639,46 @@ lower_subpass_dim(nir_builder *b, nir_tex_instr *tex, UNUSED void *_data)
    return true;
 }
 
+static bool
+lower_fragment_depth_clamp(nir_builder *b, nir_intrinsic_instr *intr,
+                           void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_store_output ||
+       nir_intrinsic_io_semantics(intr).location != FRAG_RESULT_DEPTH)
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *depth = intr->src[0].ssa;
+   const enum kk_fragment_depth_clamp_mode mode =
+      *(const enum kk_fragment_depth_clamp_mode *)data;
+
+   if (mode == KK_FRAGMENT_DEPTH_CLAMP_DYNAMIC)
+      nir_push_if(b, nir_ine_imm(b, kk_load_manual_depth_clamp_enable(b), 0));
+
+   nir_def *viewport = nir_load_input(b, 1, 32, nir_imm_int(b, 0), .base = 0,
+                                      .range = 1, .dest_type = nir_type_uint32,
+                                      .io_semantics = (nir_io_semantics){
+                                         .location = VARYING_SLOT_VIEWPORT,
+                                         .num_slots = 1,
+                                      });
+   nir_def *range = kk_load_depth_clamp_range(b, viewport);
+   nir_def *clamped =
+      nir_fclamp(b, depth, nir_channel(b, range, 0), nir_channel(b, range, 1));
+
+   if (mode == KK_FRAGMENT_DEPTH_CLAMP_DYNAMIC) {
+      nir_pop_if(b, NULL);
+      clamped = nir_if_phi(b, clamped, depth);
+   } else {
+      assert(mode == KK_FRAGMENT_DEPTH_CLAMP_ALWAYS);
+   }
+
+   nir_src_rewrite(&intr->src[0], clamped);
+   return true;
+}
