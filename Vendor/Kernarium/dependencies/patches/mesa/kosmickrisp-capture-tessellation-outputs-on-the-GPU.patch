+/* Scans x and y across the 1024-thread group at once, sharing one pair of
+ * barriers: returns their inclusive prefix sums in .xy and the group's
+ * totals in .zw. scratch holds 64 words. */
+static uint4
+libkk_work_group_scan_inclusive_add2(uint x, uint y, local uint *scratch)
+{
+   uint sg_id = get_sub_group_id();
+   uint sg_x = sub_group_scan_inclusive_add(x);
+   uint sg_y = sub_group_scan_inclusive_add(y);
+
+   barrier(CLK_LOCAL_MEM_FENCE);
+   scratch[sg_id] = sub_group_broadcast(sg_x, 31);
+   scratch[32 + sg_id] = sub_group_broadcast(sg_y, 31);
+   barrier(CLK_LOCAL_MEM_FENCE);
+
+   uint lane = get_sub_group_local_id();
+   uint other_x = scratch[lane], other_y = scratch[32 + lane];
+   uint before_x = sub_group_scan_exclusive_add(other_x);
+   uint before_y = sub_group_scan_exclusive_add(other_y);
+   return (uint4)(sub_group_broadcast(before_x, sg_id) + sg_x,
+                  sub_group_broadcast(before_y, sg_id) + sg_y,
+                  sub_group_broadcast(before_x + other_x, 31),
+                  sub_group_broadcast(before_y + other_y, 31));
+}
+
 KERNEL(1024)
 libkk_prefix_sum_tess(global struct poly_tess_params *p,
                       global uint32_t *c_prims,
                       global uint32_t *c_invs,
                       uint32_t increment_stats)
 {
-   local uint scratch[32];
-   poly_prefix_sum(scratch, p->counts, p->nr_patches, 1 /* words */,
-                   0 /* word */, 1024);
+   local uint scratch[64];
+   local uint wrapped;
+   const uint nr_patches = p->nr_patches;
+   const uint tid = cl_local_id.x;
+
+   /* Counting left each patch's number of indices in counts and of domain
+    * points in coord_allocs. One pass turns the first into their inclusive
+    * sum and the second into their exclusive sum, which places each patch's
+    * points after the previous patch's, so the draw reserves all of them at
+    * once below, together with its indices, instead of every patch
+    * contending for the heap on its own. The counts follow the application's
+    * tessellation levels, so a 32-bit running sum can wrap, and it wrapped
+    * exactly where it is smaller than the count it just added. */
+   if (tid == 0)
+      wrapped = 0;
+   uint total = 0, total_points = 0;
+   for (uint first = 0; first < nr_patches; first += 1024) {
+      uint i = first + tid;
+      uint index_count = i < nr_patches ? p->counts[i] : 0;
+      uint point_count = i < nr_patches ? p->coord_allocs[i] : 0;
+      uint4 sums = libkk_work_group_scan_inclusive_add2(index_count,
+                                                        point_count, scratch);
+
+      uint index_end = total + sums.x, point_end = total_points + sums.y;
+      if (i < nr_patches) {
+         p->counts[i] = index_end;
+         p->coord_allocs[i] = point_end - point_count;
+         if (index_end < index_count || point_end < point_count)
+            atomic_or(&wrapped, 1u);
+      }
+      total += sums.z;
+      total_points += sums.w;
+   }
+   barrier(CLK_LOCAL_MEM_FENCE);
 
-   /* After prefix summing, we know the total # of indices, so allocate the
-    * index buffer now. Elect a thread for the allocation.
+   /* After prefix summing, we know the total # of indices and points, so
+    * allocate the index buffer and the points now. Elect a thread for the
+    * allocation.
     */
-   barrier(CLK_LOCAL_MEM_FENCE);
    if (cl_local_id.x != 0)
       return;
 
-   /* The last element of an inclusive prefix sum is the total sum */
-   uint total = p->nr_patches > 0 ? p->counts[p->nr_patches - 1] : 0;
-
-   /* Allocate 4-byte indices */
+   /* Allocate 4-byte indices followed by 8-byte points in one reservation,
+    * unless their size does not fit the 32 bits the heap addresses or the
+    * heap cannot hold them. Then draw nothing and write no index or point
+    * either: the tessellator skips every patch once nr_patches is zero. */
    uint32_t elsize_B = sizeof(uint32_t);
-   uint32_t size_B = total * elsize_B;
-   uint alloc_B = poly_heap_alloc_offs(p->heap, size_B);
-   p->index_buffer = (global uint32_t *)(((uintptr_t)p->heap->base) + alloc_B);
-
-   /* ...and now we can generate the API indexed draw */
+   uint32_t point_B = sizeof(struct poly_tess_point);
+   uint32_t size_B, points_B, alloc_size_B;
    global uint32_t *desc = p->out_draws;
+   uint alloc_B;
+   if (wrapped ||
+       !poly_u32_checked_mul(total, elsize_B, &size_B) ||
+       !poly_heap_size_can_align(size_B) ||
+       !poly_u32_checked_mul(total_points, point_B, &points_B) ||
+       !poly_u32_checked_add(align(size_B, 16), points_B, &alloc_size_B) ||
+       !poly_heap_try_alloc_offs(p->heap, alloc_size_B, &alloc_B)) {
+      p->nr_patches = 0;
+      for (uint i = 0; i < 5; ++i)
+         desc[i] = 0;
+      return;
+   }
+
+   global uchar *indices = p->heap->base + alloc_B;
+   p->index_buffer = (global uint32_t *)indices;
+
+   /* coord_allocs now counts each patch's first point from here. */
+   p->patch_coord_buffer =
+      (global struct poly_tess_point *)(indices + align(size_B, 16));
 
+   /* ...and now we can generate the API indexed draw */
    desc[0] = total;              /* count */
    desc[1] = 1;                  /* instance_count */
    desc[2] = alloc_B / elsize_B; /* start */
    desc[3] = 0;                  /* index_bias */
    desc[4] = 0;                  /* start_instance */
 
+   /* The statistic is for tessellation evaluation shader invocations, which
+    * is equal to the number of domain points generated. */
+   if (p->statistic)
+      poly_atomic_add_u64((global uint32_t *)p->statistic, total_points);
+
    if (increment_stats) {
       uint prims = p->points_mode ? total
                    : p->isolines  ? (total / 2)
