index 0000000000000000000000000000000000000000..8520b58507639682dc3be9b8658c2cfffa350ec7
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/tess_draw_size_shaders/wide.tesc
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: MIT */
+#version 450
+/* 32 output vertices of a position and 15 vec4 outputs each. Every output
+ * is its own function of the invocation and the TES indexes them
+ * dynamically, so the compiler cannot fold them away. */
+layout(vertices = 32) out;
+layout(location = 0) out vec4 wide[][15];
+void main()
+{
+   gl_out[gl_InvocationID].gl_Position = gl_in[0].gl_Position;
+   for (int i = 0; i < 15; ++i) {
+      float seed = float(gl_InvocationID * 15 + i) + gl_in[0].gl_Position.x;
+      wide[gl_InvocationID][i] =
+         vec4(sin(seed), cos(seed), sin(2.0 * seed), cos(3.0 * seed));
+   }
+   gl_TessLevelOuter[0] = 1.0;
+   gl_TessLevelOuter[1] = 1.0;
+   gl_TessLevelOuter[2] = 1.0;
+   gl_TessLevelInner[0] = 1.0;
+}
