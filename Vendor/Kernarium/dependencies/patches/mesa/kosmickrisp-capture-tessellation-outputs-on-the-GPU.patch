+                                   &unrolled_patches, &patch_buffers_B) ||
+       !poly_u32_checked_mul(count, instance_count, &vertices) ||
+       !poly_u32_checked_mul(vertices, util_bitcount64(vertex_outputs) * 16,
+                             &vb_B) ||
+       !poly_u32_checked_add(patch_buffers_B, vb_B, &blob_B) ||
+       !poly_heap_try_alloc_offs(p->heap, blob_B, &blob_offs)) {
+      for (uint i = 0; i < 18; ++i)
+         grids[i] = 0;
+      p->nr_patches = 0;
+      return;
+   }
+
    /* TCS invocation counter increments once per-patch */
    if (tcs_statistic) {
       poly_atomic_add_u64(tcs_statistic,
@@ -29,7 +51,6 @@ libkk_tess_setup_indirect(
    }
 
    size_t draw_stride = 5 * sizeof(uint32_t);
-   unsigned unrolled_patches = in_patches * instance_count;
 
    uint32_t alloc = 0;
    uint32_t tcs_out_offs = alloc;
@@ -45,8 +66,9 @@ libkk_tess_setup_indirect(
    uint vb_size = poly_tcs_in_size(count * instance_count, vertex_outputs);
    alloc += vb_size;
 
-   /* Allocate all patch calculations in one go */
-   global uchar *blob = poly_heap_alloc(p->heap, alloc);
+   /* All patch calculations share the one reservation made above, which
+    * the same sizes bound. */
+   global uchar *blob = p->heap->base + blob_offs;
 
    p->tcs_buffer = (global float *)(blob + tcs_out_offs);
    p->patches_per_instance = in_patches;
@@ -81,14 +103,23 @@ libkk_tess_setup_indirect(
    grids[0] = count;
    grids[1] = instance_count;
    grids[2] = 1;
+   grids[3] = 64;
+   grids[4] = 1;
+   grids[5] = 1;
 
