diff --git a/src/kosmickrisp/vulkan/kk_logic_op.h b/src/kosmickrisp/vulkan/kk_logic_op.h
new file mode 100644
index 0000000000000000000000000000000000000000..c3b85e7f09becb7312ff056380725810efd0e5a7
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_logic_op.h
@@ -0,0 +1,42 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef KK_LOGIC_OP_H
+#define KK_LOGIC_OP_H 1
+
+#include "vk_graphics_state.h"
+
+/* Keep fragment shader runtime state in the existing four-byte root slot so
+ * the root descriptor ABI, including every following push/descriptor offset,
+ * remains unchanged for the precompiled device library.
+ */
+#define KK_FRAGMENT_DYNAMIC_DEPTH_CLAMP_ENABLE BITFIELD_BIT(0)
+#define KK_FRAGMENT_DYNAMIC_LOGIC_OP_SHIFT     1
+#define KK_FRAGMENT_DYNAMIC_LOGIC_OP_MASK \
+   (0xfu << KK_FRAGMENT_DYNAMIC_LOGIC_OP_SHIFT)
+
+static inline bool
+kk_logic_op_is_dynamic(const struct vk_graphics_pipeline_state *state)
+{
+   return state->cb && state->cb->logic_op_enable &&
+          BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_CB_LOGIC_OP);
+}
+
+static inline uint32_t
+kk_fragment_dynamic_state_set_logic_op(uint32_t state, uint32_t logic_op)
+{
+   return (state & ~KK_FRAGMENT_DYNAMIC_LOGIC_OP_MASK) |
+          ((logic_op << KK_FRAGMENT_DYNAMIC_LOGIC_OP_SHIFT) &
+           KK_FRAGMENT_DYNAMIC_LOGIC_OP_MASK);
+}
+
+static inline uint32_t
+kk_fragment_dynamic_state_logic_op(uint32_t state)
+{
+   return (state & KK_FRAGMENT_DYNAMIC_LOGIC_OP_MASK) >>
+          KK_FRAGMENT_DYNAMIC_LOGIC_OP_SHIFT;
+}
+
+#endif
