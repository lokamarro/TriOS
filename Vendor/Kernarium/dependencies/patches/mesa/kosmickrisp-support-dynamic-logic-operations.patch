diff --git a/src/kosmickrisp/vulkan/tests/test_logic_op.c b/src/kosmickrisp/vulkan/tests/test_logic_op.c
new file mode 100644
index 0000000000000000000000000000000000000000..1de26ed282a1d0aa8a9680d553c6c6b525c499b4
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_logic_op.c
@@ -0,0 +1,134 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kosmickrisp/vulkan/kk_logic_op.h"
+
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+#include "compiler/nir/nir_lower_blend.h"
+#include "vulkan/runtime/vk_blend.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(condition)                                                     \
+   do {                                                                      \
+      if (!(condition)) {                                                    \
+         fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__,   \
+                 #condition);                                                \
+         abort();                                                            \
+      }                                                                      \
+   } while (0)
+
+static uint32_t
+reference_logic_op(uint32_t op, uint32_t src, uint32_t dst)
+{
+   uint32_t result = 0;
+   for (unsigned bit = 0; bit < 8; bit++) {
+      const unsigned inputs = (((src >> bit) & 1u) << 1) |
+                              ((dst >> bit) & 1u);
+      result |= ((op >> inputs) & 1u) << bit;
+   }
+   return result;
+}
+
+static void
+check_dynamic_nir_truth_table(void)
+{
+   static const nir_shader_compiler_options options = {0};
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_FRAGMENT, &options, "dynamic logic-op test");
+
+   const uint32_t src_values[4] = {0x00, 0x0f, 0x55, 0xa6};
+   const uint32_t dst_values[4] = {0xff, 0x33, 0xaa, 0x69};
+   nir_def *src = nir_imm_ivec4(&b, src_values[0], src_values[1],
+                                src_values[2], src_values[3]);
+   nir_def *dst = nir_imm_ivec4(&b, dst_values[0], dst_values[1],
+                                dst_values[2], dst_values[3]);
+
+   nir_intrinsic_instr *uses[16];
+   for (unsigned op = 0; op < ARRAY_SIZE(uses); op++) {
+      nir_def *result = nir_color_logicop_dynamic(
+         &b, src, dst, nir_imm_int(&b, op), PIPE_FORMAT_R8G8B8A8_UINT);
+      uses[op] = nir_use(&b, result);
+   }
+
+   CHECK(nir_opt_constant_folding(b.shader));
+   nir_validate_shader(b.shader, "after dynamic logic-op folding");
+
+   for (unsigned op = 0; op < ARRAY_SIZE(uses); op++) {
+      nir_def *result = uses[op]->src[0].ssa;
+      CHECK(nir_def_is_const(result));
+      const nir_const_value *value = nir_def_as_load_const(result)->value;
+      for (unsigned channel = 0; channel < 4; channel++) {
+         CHECK(value[channel].u32 ==
+               reference_logic_op(op, src_values[channel],
+                                  dst_values[channel]));
+      }
+   }
+
+   ralloc_free(b.shader);
+}
+
+static void
+check_vulkan_mapping_and_root_packing(void)
+{
+   static const uint8_t expected_pipe_op[] = {
+      [VK_LOGIC_OP_CLEAR] = PIPE_LOGICOP_CLEAR,
+      [VK_LOGIC_OP_AND] = PIPE_LOGICOP_AND,
+      [VK_LOGIC_OP_AND_REVERSE] = PIPE_LOGICOP_AND_REVERSE,
+      [VK_LOGIC_OP_COPY] = PIPE_LOGICOP_COPY,
+      [VK_LOGIC_OP_AND_INVERTED] = PIPE_LOGICOP_AND_INVERTED,
+      [VK_LOGIC_OP_NO_OP] = PIPE_LOGICOP_NOOP,
+      [VK_LOGIC_OP_XOR] = PIPE_LOGICOP_XOR,
+      [VK_LOGIC_OP_OR] = PIPE_LOGICOP_OR,
+      [VK_LOGIC_OP_NOR] = PIPE_LOGICOP_NOR,
+      [VK_LOGIC_OP_EQUIVALENT] = PIPE_LOGICOP_EQUIV,
+      [VK_LOGIC_OP_INVERT] = PIPE_LOGICOP_INVERT,
+      [VK_LOGIC_OP_OR_REVERSE] = PIPE_LOGICOP_OR_REVERSE,
+      [VK_LOGIC_OP_COPY_INVERTED] = PIPE_LOGICOP_COPY_INVERTED,
+      [VK_LOGIC_OP_OR_INVERTED] = PIPE_LOGICOP_OR_INVERTED,
+      [VK_LOGIC_OP_NAND] = PIPE_LOGICOP_NAND,
+      [VK_LOGIC_OP_SET] = PIPE_LOGICOP_SET,
+   };
+
+   for (unsigned vk_op = 0; vk_op < ARRAY_SIZE(expected_pipe_op); vk_op++) {
+      const uint32_t pipe_op = vk_logic_op_to_pipe((VkLogicOp)vk_op);
+      CHECK(pipe_op == expected_pipe_op[vk_op]);
+
+      const uint32_t original = 0xa5a50001u;
+      const uint32_t packed =
+         kk_fragment_dynamic_state_set_logic_op(original, pipe_op);
+      CHECK(kk_fragment_dynamic_state_logic_op(packed) == pipe_op);
+      CHECK((packed & ~KK_FRAGMENT_DYNAMIC_LOGIC_OP_MASK) ==
+            (original & ~KK_FRAGMENT_DYNAMIC_LOGIC_OP_MASK));
+   }
+
+}
+
+static void
+check_pipeline_selection(void)
+{
+   struct vk_color_blend_state cb = {.logic_op_enable = true};
+   struct vk_graphics_pipeline_state state = {.cb = &cb};
+
+   CHECK(!kk_logic_op_is_dynamic(&state));
+   BITSET_SET(state.dynamic, MESA_VK_DYNAMIC_CB_LOGIC_OP);
+   CHECK(kk_logic_op_is_dynamic(&state));
+
+   cb.logic_op_enable = false;
+   CHECK(!kk_logic_op_is_dynamic(&state));
+   state.cb = NULL;
+   CHECK(!kk_logic_op_is_dynamic(&state));
+}
+
+int
+main(void)
+{
+   check_dynamic_nir_truth_table();
+   check_vulkan_mapping_and_root_packing();
+   check_pipeline_selection();
+   return 0;
+}
