-nir_def *
-nir_color_logicop(nir_builder *b, nir_def *src, nir_def *dst,
-                  enum pipe_logicop func, enum pipe_format format)
+/* Gallium logic-op values encode the four-row Boolean truth table directly:
+ * bit 2 * src + dst is the result for that pair of input bits.  Expand those
+ * four scalar bits to integer masks and select every bit in parallel.  This
+ * keeps a runtime-selected operation branch-free and implements all 16
+ * operations without shader variants.
+ */
+static nir_def *
+nir_logicop_func_dynamic(nir_builder *b, nir_def *func, nir_def *src,
+                         nir_def *dst, nir_def *bitmask)
+{
+   func = nir_u2u32(b, func);
+
+   nir_def *not_src = nir_ixor(b, src, bitmask);
+   nir_def *not_dst = nir_ixor(b, dst, bitmask);
+   nir_def *terms[4] = {
+      nir_iand(b, not_src, not_dst),
+      nir_iand(b, not_src, dst),
+      nir_iand(b, src, not_dst),
+      nir_iand(b, src, dst),
+   };
+
+   nir_def *result = nir_imm_zero(b, src->num_components, src->bit_size);
+   for (unsigned i = 0; i < ARRAY_SIZE(terms); i++) {
+      nir_def *enabled = nir_iand_imm(b, nir_ushr_imm(b, func, i), 1);
+      nir_def *mask = nir_ineg(b, enabled);
+      result = nir_ior(b, result, nir_iand(b, terms[i], mask));
+   }
+
+   return result;
+}
+
+static nir_def *
+nir_color_logicop_impl(nir_builder *b, nir_def *src, nir_def *dst,
+                       enum pipe_logicop static_func, nir_def *dynamic_func,
+                       enum pipe_format format)
 {
    unsigned bit_size = src->bit_size;
    const struct util_format_description *format_desc =
@@ -274,9 +306,9 @@ nir_color_logicop(nir_builder *b, nir_def *src, nir_def *dst,
     */
    if (util_format_is_float(format) || util_format_is_srgb(format))
       return src;
-   else if (func == PIPE_LOGICOP_COPY)
+   else if (dynamic_func == NULL && static_func == PIPE_LOGICOP_COPY)
       return src;
-   else if (func == PIPE_LOGICOP_NOOP)
+   else if (dynamic_func == NULL && static_func == PIPE_LOGICOP_NOOP)
       return dst;
 
    nir_alu_type type =
@@ -308,8 +340,11 @@ nir_color_logicop(nir_builder *b, nir_def *src, nir_def *dst,
    for (int i = 0; i < 4; ++i)
       mask[i] = nir_const_value_for_uint(BITFIELD_MASK(bits[i]), 32);
 
-   nir_def *out = nir_logicop_func(b, func, src, dst,
-                                   nir_build_imm(b, 4, 32, mask));
+   nir_def *bitmask = nir_build_imm(b, 4, 32, mask);
+   nir_def *out = dynamic_func != NULL
+                     ? nir_logicop_func_dynamic(b, dynamic_func, src, dst,
+                                                bitmask)
+                     : nir_logicop_func(b, static_func, src, dst, bitmask);
 
    if (util_format_is_unorm(format)) {
       out = nir_format_unorm_to_float(b, out, bits);
@@ -327,6 +362,21 @@ nir_color_logicop(nir_builder *b, nir_def *src, nir_def *dst,
    return out;
 }
 
+nir_def *
+nir_color_logicop(nir_builder *b, nir_def *src, nir_def *dst,
+                  enum pipe_logicop func, enum pipe_format format)
+{
+   return nir_color_logicop_impl(b, src, dst, func, NULL, format);
+}
+
+nir_def *
+nir_color_logicop_dynamic(nir_builder *b, nir_def *src, nir_def *dst,
+                          nir_def *func, enum pipe_format format)
+{
+   return nir_color_logicop_impl(b, src, dst, PIPE_LOGICOP_CLEAR, func,
+                                 format);
+}
+
 static bool
 channel_exists(const struct util_format_description *desc, unsigned i)
 {
@@ -1049,8 +1099,11 @@ nir_lower_blend_instr(nir_builder *b, nir_intrinsic_instr *store, void *data)
