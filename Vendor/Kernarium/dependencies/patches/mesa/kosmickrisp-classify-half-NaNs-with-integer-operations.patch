From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 3 Sep 2026 17:33:07 +0900
Subject: [PATCH] kosmickrisp: classify half NaNs with integer operations

---
 src/kosmickrisp/compiler/msl_type_inference.c |  6 +--
 src/kosmickrisp/compiler/nir_to_msl.c         | 44 +++++++++++++++----
 2 files changed, 38 insertions(+), 12 deletions(-)

diff --git a/src/kosmickrisp/compiler/msl_type_inference.c b/src/kosmickrisp/compiler/msl_type_inference.c
index 11b78d1466aa07f66467d584a1f83f03fe52eca1..a65587e0589e4f9509966fb50432ecd8110b4766 100644
--- a/src/kosmickrisp/compiler/msl_type_inference.c
+++ b/src/kosmickrisp/compiler/msl_type_inference.c
@@ -753,11 +753,11 @@ emit_src_component(struct nir_to_msl_ctx *ctx, nir_src *src, unsigned comp)
    case TYPE_FLOAT: {
       double v = nir_src_comp_as_float(*src, comp);
       if (v == INFINITY) {
-         P(ctx, "(INFINITY");
+         P(ctx, src->ssa->bit_size == 16 ? "half(INFINITY" : "(INFINITY");
       } else if (v == -INFINITY) {
-         P(ctx, "(-INFINITY");
+         P(ctx, src->ssa->bit_size == 16 ? "half(-INFINITY" : "(-INFINITY");
       } else if (isnan(v)) {
-         P(ctx, "(NAN");
+         P(ctx, src->ssa->bit_size == 16 ? "half(NAN" : "(NAN");
       } else {
          /* Building the types explicitly is required since the MSL compiler is
           * too dumb to understand that "max(as_type<int>(t53), -2147483648)" is
diff --git a/src/kosmickrisp/compiler/nir_to_msl.c b/src/kosmickrisp/compiler/nir_to_msl.c
index 305f6ef5eb89f266bdeb3b1c9a687b005681719d..975c7237b61428dee0e47c80dc2ef2294674b6f1 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.c
+++ b/src/kosmickrisp/compiler/nir_to_msl.c
@@ -245,6 +245,34 @@ alu_funclike_precise(struct nir_to_msl_ctx *ctx, nir_alu_instr *instr,
    alu_funclike(ctx, instr, name);
 }
 
+static void
+alu_isnan_to_msl(struct nir_to_msl_ctx *ctx, nir_alu_instr *instr,
+                 unsigned srcn)
+{
+   /* Apple's native half isnan code generation can fault in graphics stages.
+    * Classify IEEE-754 half values with integer operations instead. */
+   if (nir_src_bit_size(instr->src[srcn].src) != 16) {
+      P(ctx, "isnan(");
+      alu_src_to_msl(ctx, instr, srcn);
+      P(ctx, ")");
+      return;
+   }
+
+   const unsigned components = instr->def.num_components;
+   P(ctx, "((as_type<ushort");
+   if (components > 1)
+      P(ctx, "%u", components);
+   P(ctx, ">(");
+   alu_src_to_msl(ctx, instr, srcn);
+   P(ctx, ") & ushort");
+   if (components > 1)
+      P(ctx, "%u", components);
+   P(ctx, "(0x7fff)) > ushort");
+   if (components > 1)
+      P(ctx, "%u", components);
+   P(ctx, "(0x7c00))");
+}
+
 #define ALU_BINOP(op)                                                          \
    do {                                                                        \
       alu_src_to_msl(ctx, instr, 0);                                           \
@@ -262,9 +290,10 @@ alu_fcmp_to_msl(struct nir_to_msl_ctx *ctx, nir_alu_instr *instr,
       /* fneu is unordered (true on NaN), the others are ordered. */
       bool ordered = instr->op != nir_op_fneu;
       for (unsigned i = 0; i < 2; i++) {
-         P(ctx, ordered ? "!isnan(" : "isnan(");
-         alu_src_to_msl(ctx, instr, i);
-         P(ctx, ordered ? ") && " : ") || ");
+         if (ordered)
+            P(ctx, "!");
+         alu_isnan_to_msl(ctx, instr, i);
+         P(ctx, ordered ? " && " : " || ");
       }
    }
    ALU_BINOP(op);
@@ -360,9 +389,8 @@ alu_to_msl(struct nir_to_msl_ctx *ctx, nir_alu_instr *instr)
    case nir_op_feq:
       /* "x == x" is a special case checking for non-NANs */
       if (nir_alu_srcs_equal(instr, instr, 0, 1)) {
-         P(ctx, "!isnan(");
-         alu_src_to_msl(ctx, instr, 0);
-         P(ctx, ")");
+         P(ctx, "!");
+         alu_isnan_to_msl(ctx, instr, 0);
       } else
          alu_fcmp_to_msl(ctx, instr, "==");
       break;
@@ -372,9 +400,7 @@ alu_to_msl(struct nir_to_msl_ctx *ctx, nir_alu_instr *instr)
    case nir_op_fneu:
       /* "x != x" is a special case checking for NANs */
       if (nir_alu_srcs_equal(instr, instr, 0, 1)) {
-         P(ctx, "isnan(");
-         alu_src_to_msl(ctx, instr, 0);
-         P(ctx, ")");
+         alu_isnan_to_msl(ctx, instr, 0);
       } else
          alu_fcmp_to_msl(ctx, instr, "!=");
       break;
