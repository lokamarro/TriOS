From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 6 Sep 2026 22:58:59 +0900
Subject: [PATCH] kosmickrisp: read every merged clip/cull fragment element

A fragment shader reads gl_ClipDistance and gl_CullDistance through the one
compact array that nir_merge_clip_cull_distance_vars leaves in CLIP_DIST0/1,
and varying optimization vectorizes those element reads into one vector load
per slot. nir_separate_merged_clip_cull_io requires scalar accesses, and the
Metal backend names one varying per element, so a surviving vector load
silently broadcast the slot's first distance into every component.

Scalarize fragment clip/cull inputs alongside the final vertex stage's stores.
Add a regression covering the separated scalar reads and the per-element Metal
varying names for every split of the eight combined distances.
---
 .../compiler/msl_nir_lower_common.c           |  23 +-
 src/kosmickrisp/vulkan/meson.build            |  14 ++
 .../vulkan/tests/test_clip_cull_distance_io.c | 211 ++++++++++++++++++
 3 files changed, 245 insertions(+), 3 deletions(-)
 create mode 100644 src/kosmickrisp/vulkan/tests/test_clip_cull_distance_io.c

diff --git a/src/kosmickrisp/compiler/msl_nir_lower_common.c b/src/kosmickrisp/compiler/msl_nir_lower_common.c
index 8699eadad62942d034287e60713e850a2768f92f..2c837a01f80e43657c37bbd3fb2535bc8d9a674a 100644
--- a/src/kosmickrisp/compiler/msl_nir_lower_common.c
+++ b/src/kosmickrisp/compiler/msl_nir_lower_common.c
@@ -552,13 +552,19 @@ msl_nir_lower_cull_distance_fs(nir_shader *s, unsigned nr_distances)
    return nir_progress(true, b->impl, nir_metadata_control_flow);
 }
 
-/* Scalarize stores to CLIP_DIST* varyings */
+/* Scalarize accesses to the merged CLIP_DIST* varyings */
 static bool
 scalarize_clip_cull_distance_filter(const nir_intrinsic_instr *intrin,
                                     UNUSED const void *_data)
 {
-   if (intrin->intrinsic != nir_intrinsic_store_output)
+   switch (intrin->intrinsic) {
+   case nir_intrinsic_store_output:
+   case nir_intrinsic_load_input:
+   case nir_intrinsic_load_interpolated_input:
+      break;
+   default:
       return false;
+   }
    nir_io_semantics semantics = nir_intrinsic_io_semantics(intrin);
    return semantics.location == VARYING_SLOT_CLIP_DIST0 ||
           semantics.location == VARYING_SLOT_CLIP_DIST1 ||
@@ -569,7 +575,18 @@ scalarize_clip_cull_distance_filter(const nir_intrinsic_instr *intrin,
 void
 msl_nir_lower_clip_cull_distance(nir_shader *nir, unsigned num_cull_distances)
 {
-   NIR_PASS(_, nir, nir_lower_io_to_scalar, nir_var_shader_out,
+   /* A fragment shader reads gl_ClipDistance and gl_CullDistance through the
+    * same merged compact array, and an indexed or vectorized read produces a
+    * multi-component load.  Splitting that array and naming one Metal varying
+    * per element both require scalar element accesses, so scalarize the
+    * fragment inputs as well as the final vertex stage's stores.  Vertex
+    * inputs use attribute locations rather than varying slots and are never
+    * part of this interface. */
+   nir_variable_mode modes = nir_var_shader_out;
+   if (nir->info.stage == MESA_SHADER_FRAGMENT)
+      modes |= nir_var_shader_in;
+
+   NIR_PASS(_, nir, nir_lower_io_to_scalar, modes,
             scalarize_clip_cull_distance_filter, NULL);
    NIR_PASS(_, nir, nir_separate_merged_clip_cull_io);
    if (nir->info.stage == MESA_SHADER_FRAGMENT)
