From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 14 Sep 2026 02:12:09 +0900
Subject: [PATCH] vulkan/wsi: only ask for immediate present where Metal offers
 it

CAMetalLayer.displaySyncEnabled is macOS-only; every other Apple platform
composites on the display refresh boundary and the property does not exist,
so the Metal WSI does not compile for iOS. Keep the macOS behaviour and make
the request a no-op elsewhere, with the one call site routed through the
setter so both paths stay in one place.

The surface query agrees: it offers VK_PRESENT_MODE_IMMEDIATE_KHR only on
macOS, so an iOS client that asks for present modes gets FIFO alone rather than
choosing IMMEDIATE and silently waiting for the display.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/vulkan/wsi/wsi_common_metal.c       |  6 ++++++
 src/vulkan/wsi/wsi_common_metal_layer.m | 11 ++++++++++-
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/src/vulkan/wsi/wsi_common_metal.c b/src/vulkan/wsi/wsi_common_metal.c
index 0a186282b1a1bee4087ce7a622a84224966943f7..49be768989285ba109e9d34d14a89474956f2c33 100644
--- a/src/vulkan/wsi/wsi_common_metal.c
+++ b/src/vulkan/wsi/wsi_common_metal.c
@@ -19,6 +19,8 @@
 
 #include <assert.h>
 
+#include <TargetConditionals.h>
+
 struct wsi_metal {
    struct wsi_interface base;
 
@@ -38,8 +40,12 @@ wsi_metal_surface_get_support(VkIcdSurfaceBase *surface,
    return VK_SUCCESS;
 }
 
+/* Only macOS lets a CAMetalLayer present without waiting for the display;
+ * elsewhere the layer ignores the request, so IMMEDIATE is not offered. */
 static const VkPresentModeKHR present_modes[] = {
+#if TARGET_OS_OSX
    VK_PRESENT_MODE_IMMEDIATE_KHR,
+#endif
    VK_PRESENT_MODE_FIFO_KHR,
 };
 
diff --git a/src/vulkan/wsi/wsi_common_metal_layer.m b/src/vulkan/wsi/wsi_common_metal_layer.m
index 67c3e7ff1cb522e43a5d50aebe5732e47e6f677c..57c9c83b619d1e0856e7837ddabd4f5a02c99831 100644
--- a/src/vulkan/wsi/wsi_common_metal_layer.m
+++ b/src/vulkan/wsi/wsi_common_metal_layer.m
@@ -6,6 +6,8 @@
 
 #include "wsi_common_metal_layer.h"
 
+#include <TargetConditionals.h>
+
 #import <QuartzCore/CAMetalLayer.h>
 #import <Metal/Metal.h>
 
@@ -137,7 +139,14 @@
 wsi_metal_layer_set_immediate(const CAMetalLayer *metal_layer,
                               bool enable_immediate)
 {
+#if TARGET_OS_OSX
    metal_layer.displaySyncEnabled = !enable_immediate;
+#else
+   /* Only macOS lets a layer present without waiting for the display; every
+    * other Apple platform composites on the refresh boundary. */
+   (void)metal_layer;
+   (void)enable_immediate;
+#endif
 }
 
 VkResult
@@ -169,7 +178,7 @@
       metal_layer.maximumDrawableCount = image_count;
       metal_layer.drawableSize = (CGSize){.width = width, .height = height};
       metal_layer.opaque = enable_opaque;
-      metal_layer.displaySyncEnabled = !enable_immediate;
+      wsi_metal_layer_set_immediate(metal_layer, enable_immediate);
       metal_layer.pixelFormat = metal_format;
 
       metal_layer.colorspace = cg_color_space;
