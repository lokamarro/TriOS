diff --git a/src/kosmickrisp/compiler/msl_iomap.c b/src/kosmickrisp/compiler/msl_iomap.c
index f0cf216fd0db5b7b7170738d8c0541a72978c787..45bb7b7ecb42236676c3be8a60835e20f913d45b 100644
--- a/src/kosmickrisp/compiler/msl_iomap.c
+++ b/src/kosmickrisp/compiler/msl_iomap.c
@@ -62,7 +62,15 @@ static const struct {
 } VARYING_SLOT_INFO[NUM_TOTAL_VARYING_SLOTS] = {
    [VARYING_SLOT_POS] = {"position"},
    [VARYING_SLOT_PSIZ] = {"point_size"},
-   [VARYING_SLOT_PRIMITIVE_ID] = {"primitive_id"},
+   /* Metal's [[primitive_id]] is an unsigned value the rasterizer hands to
+    * the fragment stage; it is not a vertex output and it is not an int, so a
+    * pipeline that carries an authored primitive ID as a varying - a geometry
+    * shader that writes gl_PrimitiveID, or the generated raster stage that
+    * republishes the application's primitive ID - has to carry it as an
+    * ordinary user varying.  A fragment shader that wants the rasterizer's own
+    * value reads the system value instead, which nir_to_msl still spells with
+    * the Metal attribute. */
+   [VARYING_SLOT_PRIMITIVE_ID] = {"primitive_id", .user = true},
    [VARYING_SLOT_LAYER] = {"render_target_array_index"},
    [VARYING_SLOT_VIEWPORT] = {"viewport_array_index"},
    [VARYING_SLOT_CLIP_DIST0] = {"clip_0", .user = true, .scalarized = true},
@@ -236,31 +244,41 @@ fs_input_no_interpolant(struct nir_to_msl_ctx *ctx, uint64_t location)
       scalarized ? "" : vector_suffixes[info.num_components];
    unsigned components = scalarized ? info.num_components : 1;
    const char *interp = "";
-   switch (info.interpolation) {
-   case INTERP_MODE_NOPERSPECTIVE:
-      if (info.centroid)
-         interp = "[[centroid_no_perspective]]";
-      else if (info.sample)
-         interp = "[[sample_no_perspective]]";
-      else
-         interp = "[[center_no_perspective]]";
-      break;
-   case INTERP_MODE_FLAT:
-      interp = "[[flat]]";
-      break;
-   default:
-      if (info.centroid)
-         interp = "[[centroid_perspective]]";
-      else if (info.sample)
-         interp = "[[sample_perspective]]";
-      break;
+   /* Only a user varying is sampled by an interpolation qualifier.  The layer
+    * and viewport indices are values of the primitive that Metal hands over
+    * under its own attribute, and they are declared with that attribute
+    * alone. */
+   if (VARYING_SLOT_INFO[location].user) {
+      switch (info.interpolation) {
+      case INTERP_MODE_NOPERSPECTIVE:
+         if (info.centroid)
+            interp = "[[centroid_no_perspective]]";
+         else if (info.sample)
+            interp = "[[sample_no_perspective]]";
+         else
+            interp = "[[center_no_perspective]]";
+         break;
+      case INTERP_MODE_FLAT:
+         interp = "[[flat]]";
+         break;
+      default:
+         if (info.centroid)
+            interp = "[[centroid_perspective]]";
+         else if (info.sample)
+            interp = "[[sample_perspective]]";
+         break;
+      }
    }
    for (int c = 0; c < components; c++) {
       P_IND(ctx, "%s%s ", type, vector_suffix);
       varying_slot_name(ctx, location, c);
       P(ctx, " ");
       varying_slot_semantic(ctx, location, c);
-      P(ctx, " %s;\n", interp);
+      if (*interp) {
+         P(ctx, " %s;\n", interp);
+      } else {
+         P(ctx, ";\n");
+      }
    }
 }
 
@@ -485,6 +503,15 @@ pin_metal_builtin_slot_shapes(struct io_slot_info *slots)
       {VARYING_SLOT_PSIZ, nir_type_float32, 1u},
       {VARYING_SLOT_LAYER, nir_type_uint32, 1u},
       {VARYING_SLOT_VIEWPORT, nir_type_uint32, 1u},
+      /* An authored primitive ID travels as a user varying, so Metal does not
+       * fix its type, but the two ends of it are not written by the same
+       * party: the generated raster stages store it unsigned, a geometry
+       * shader stores gl_PrimitiveID signed, and the fragment shader reads it
+       * signed. Declare both ends as the unsigned scalar of the Metal value it
+       * stands in for, so that the interface never depends on how Metal links
+       * integer varyings whose signedness differs.
+       */
+      {VARYING_SLOT_PRIMITIVE_ID, nir_type_uint32, 1u},
    };
 
    for (unsigned i = 0u; i < ARRAY_SIZE(fixed); ++i) {
