diff --git a/src/kosmickrisp/vulkan/tests/test_geometry_primitive_id_link.cpp b/src/kosmickrisp/vulkan/tests/test_geometry_primitive_id_link.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..031f97d4361d2691a506927ca820136172ebb45f
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_geometry_primitive_id_link.cpp
@@ -0,0 +1,638 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* A geometry shader may write gl_PrimitiveID whether or not the fragment
+ * shader reads it: a GL driver that emulates quads, flat shading or a
+ * provoking-vertex convention with a generated geometry stage copies the
+ * primitive ID unconditionally and expects the Vulkan driver to drop the
+ * write when nothing consumes it (Mesa's zink does exactly this).  A write
+ * that survives the link reaches the generated Metal vertex function as
+ * `int primitive_id [[primitive_id]]`, which Metal rejects - primitive_id is
+ * an unsigned rasterizer input, never a vertex output - so every pipeline
+ * with that shape fails to compile and the application re-creates it frame
+ * after frame.
+ *
+ * The three cases below cover the write that must disappear, the write that
+ * must arrive when the fragment shader does read it, and the rasterizer's own
+ * primitive ID with no geometry stage at all.  Each renders three triangles,
+ * only the last of which covers the render area, so a fragment shader that
+ * compares against primitive ID 2 proves the value and not just the compile.
+ */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+static void require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (!ok) {
+      std::fprintf(stderr, "%s: %d\n", operation, value);
+      std::exit(1);
+   }
+}
+
+template <typename T> static T load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+#define LOAD_D(name)                                                             \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+
+static const uint32_t vertex_spirv[] =
+#include "primitive_id_link_shaders/passthrough.vert.h"
+;
+static const uint32_t geometry_spirv[] =
+#include "primitive_id_link_shaders/copy_id.geom.h"
+;
+static const uint32_t green_spirv[] =
+#include "primitive_id_link_shaders/green.frag.h"
+;
+static const uint32_t green_if_id_spirv[] =
+#include "primitive_id_link_shaders/green_if_id.frag.h"
+;
+
+int main()
+{
+   std::setvbuf(stdout, nullptr, _IONBF, 0);
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+   app.pApplicationName = "primitive-id-link";
+   app.apiVersion = VK_API_VERSION_1_3;
+   VkInstanceCreateInfo instance_info{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+   instance_info.pApplicationInfo = &app;
+   auto result = vkCreateInstance(&instance_info, nullptr, &instance);
+   require(result == VK_SUCCESS, "create instance", result);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceFeatures);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   uint32_t physical_count = 0;
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, nullptr);
+   require(result == VK_SUCCESS && physical_count, "physical device count",
+           result);
+   std::vector<VkPhysicalDevice> physicals(physical_count);
+   result = vkEnumeratePhysicalDevices(instance, &physical_count,
+                                       physicals.data());
+   require(result == VK_SUCCESS, "physical devices", result);
+
+   constexpr uint32_t extent = 32;
+   constexpr VkFormat color_format = VK_FORMAT_R8G8B8A8_UNORM;
+
+   for (VkPhysicalDevice physical : physicals) {
+      VkPhysicalDeviceFeatures features{};
+      vkGetPhysicalDeviceFeatures(physical, &features);
+      require(features.geometryShader, "geometry shaders");
+
+      uint32_t queue_count = 0;
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, nullptr);
+      std::vector<VkQueueFamilyProperties> queues(queue_count);
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count,
+                                               queues.data());
+      uint32_t queue = 0;
+      while (queue < queue_count &&
+             !(queues[queue].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+         ++queue;
+      require(queue < queue_count, "graphics queue");
+      float priority = 1.0f;
+      VkDeviceQueueCreateInfo queue_info{
+         VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+      queue_info.queueFamilyIndex = queue;
+      queue_info.queueCount = 1;
+      queue_info.pQueuePriorities = &priority;
+      VkPhysicalDeviceFeatures enabled{};
+      enabled.geometryShader = VK_TRUE;
+      /* Every GL driver enables this for the GL query objects, and it makes
+       * the driver compile a second, instrumented variant of the pipeline. */
+      enabled.pipelineStatisticsQuery = features.pipelineStatisticsQuery;
+      VkPhysicalDeviceVulkan13Features features13{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+      features13.dynamicRendering = VK_TRUE;
+      /* A GL driver builds these pipelines out of libraries, which is what
+       * keeps the fragment stage out of sight while the pre-rasterization
+       * stages are compiled. */
+      VkPhysicalDeviceGraphicsPipelineLibraryFeaturesEXT library_features{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_GRAPHICS_PIPELINE_LIBRARY_FEATURES_EXT};
+      library_features.graphicsPipelineLibrary = VK_TRUE;
+      features13.pNext = &library_features;
+      /* A GL driver leaves the polygon mode dynamic, which makes the driver
+       * precompile the point and line raster variants of every pipeline. */
+      VkPhysicalDeviceExtendedDynamicState3FeaturesEXT dynamic3{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTENDED_DYNAMIC_STATE_3_FEATURES_EXT};
+      dynamic3.extendedDynamicState3PolygonMode = VK_TRUE;
+      library_features.pNext = &dynamic3;
+      static const char *const device_extensions[] = {
+         VK_KHR_PIPELINE_LIBRARY_EXTENSION_NAME,
+         VK_EXT_GRAPHICS_PIPELINE_LIBRARY_EXTENSION_NAME,
+         VK_EXT_EXTENDED_DYNAMIC_STATE_3_EXTENSION_NAME,
+      };
+      VkDeviceCreateInfo device_info{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+      device_info.pNext = &features13;
+      device_info.queueCreateInfoCount = 1;
+      device_info.pQueueCreateInfos = &queue_info;
+      device_info.pEnabledFeatures = &enabled;
+      device_info.enabledExtensionCount = 3;
+      device_info.ppEnabledExtensionNames = device_extensions;
+      VkDevice device = VK_NULL_HANDLE;
+      result = vkCreateDevice(physical, &device_info, nullptr, &device);
+      require(result == VK_SUCCESS, "create device", result);
+      LOAD_D(vkDestroyDevice);
+      LOAD_D(vkCreateShaderModule);
+      LOAD_D(vkDestroyShaderModule);
+      LOAD_D(vkCreatePipelineLayout);
+      LOAD_D(vkDestroyPipelineLayout);
+      LOAD_D(vkCreateGraphicsPipelines);
+      LOAD_D(vkDestroyPipeline);
+      LOAD_D(vkCreateCommandPool);
+      LOAD_D(vkDestroyCommandPool);
+      LOAD_D(vkResetCommandPool);
+      LOAD_D(vkAllocateCommandBuffers);
+      LOAD_D(vkBeginCommandBuffer);
+      LOAD_D(vkEndCommandBuffer);
+      LOAD_D(vkCmdBeginRendering);
+      LOAD_D(vkCmdEndRendering);
+      LOAD_D(vkCmdBindPipeline);
+      LOAD_D(vkCmdBindVertexBuffers);
+      LOAD_D(vkCmdDraw);
+      LOAD_D(vkGetDeviceQueue);
+      LOAD_D(vkQueueSubmit);
+      LOAD_D(vkCreateFence);
+      LOAD_D(vkDestroyFence);
+      LOAD_D(vkWaitForFences);
+      LOAD_D(vkCreateImage);
+      LOAD_D(vkDestroyImage);
+      LOAD_D(vkCreateImageView);
+      LOAD_D(vkDestroyImageView);
+      LOAD_D(vkGetImageMemoryRequirements);
+      LOAD_D(vkCreateBuffer);
+      LOAD_D(vkDestroyBuffer);
+      LOAD_D(vkGetBufferMemoryRequirements);
+      LOAD_D(vkAllocateMemory);
+      LOAD_D(vkFreeMemory);
+      LOAD_D(vkBindImageMemory);
+      LOAD_D(vkBindBufferMemory);
+      LOAD_D(vkMapMemory);
+      LOAD_D(vkCmdPipelineBarrier);
+      LOAD_D(vkCmdCopyImageToBuffer);
+      VkQueue device_queue = VK_NULL_HANDLE;
+      vkGetDeviceQueue(device, queue, 0, &device_queue);
+
+      VkPhysicalDeviceMemoryProperties memory_properties{};
+      vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+      auto pick_memory = [&](uint32_t bits, VkMemoryPropertyFlags flags) {
+         uint32_t type = 0;
+         while (type < memory_properties.memoryTypeCount &&
+                (!(bits & (1u << type)) ||
+                 (memory_properties.memoryTypes[type].propertyFlags & flags) !=
+                    flags))
+            ++type;
+         require(type < memory_properties.memoryTypeCount, "memory type");
+         return type;
+      };
+
+      VkImageCreateInfo image_info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+      image_info.imageType = VK_IMAGE_TYPE_2D;
+      image_info.format = color_format;
+      image_info.extent = {extent, extent, 1};
+      image_info.mipLevels = 1;
+      image_info.arrayLayers = 1;
+      image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+      image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+      image_info.usage =
+         VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+      VkImage color_image = VK_NULL_HANDLE;
+      result = vkCreateImage(device, &image_info, nullptr, &color_image);
+      require(result == VK_SUCCESS, "create image", result);
+      VkMemoryRequirements image_requirements{};
+      vkGetImageMemoryRequirements(device, color_image, &image_requirements);
+      VkMemoryAllocateInfo image_memory_info{
+         VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+      image_memory_info.allocationSize = image_requirements.size;
+      image_memory_info.memoryTypeIndex =
+         pick_memory(image_requirements.memoryTypeBits, 0);
+      VkDeviceMemory color_memory = VK_NULL_HANDLE;
+      result =
+         vkAllocateMemory(device, &image_memory_info, nullptr, &color_memory);
+      require(result == VK_SUCCESS, "allocate image", result);
+      result = vkBindImageMemory(device, color_image, color_memory, 0);
+      require(result == VK_SUCCESS, "bind image", result);
+      VkImageViewCreateInfo view_info{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+      view_info.image = color_image;
+      view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+      view_info.format = color_format;
+      view_info.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+      VkImageView color_view = VK_NULL_HANDLE;
+      result = vkCreateImageView(device, &view_info, nullptr, &color_view);
+      require(result == VK_SUCCESS, "create view", result);
+
+      auto make_buffer = [&](VkDeviceSize size, VkBufferUsageFlags usage,
+                             VkBuffer *buffer, VkDeviceMemory *memory,
+                             void **mapped) {
+         VkBufferCreateInfo buffer_info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+         buffer_info.size = size;
+         buffer_info.usage = usage;
+         result = vkCreateBuffer(device, &buffer_info, nullptr, buffer);
+         require(result == VK_SUCCESS, "create buffer", result);
+         VkMemoryRequirements requirements{};
+         vkGetBufferMemoryRequirements(device, *buffer, &requirements);
+         VkMemoryAllocateInfo memory_info{
+            VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+         memory_info.allocationSize = requirements.size;
+         memory_info.memoryTypeIndex =
+            pick_memory(requirements.memoryTypeBits,
+                        VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                           VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+         result = vkAllocateMemory(device, &memory_info, nullptr, memory);
+         require(result == VK_SUCCESS, "allocate buffer", result);
+         result = vkBindBufferMemory(device, *buffer, *memory, 0);
+         require(result == VK_SUCCESS, "bind buffer", result);
+         result = vkMapMemory(device, *memory, 0, VK_WHOLE_SIZE, 0, mapped);
+         require(result == VK_SUCCESS, "map buffer", result);
+      };
+
+      const VkDeviceSize readback_size = VkDeviceSize(extent) * extent * 4;
+      VkBuffer readback = VK_NULL_HANDLE;
+      VkDeviceMemory readback_memory = VK_NULL_HANDLE;
+      void *readback_data = nullptr;
+      make_buffer(readback_size, VK_BUFFER_USAGE_TRANSFER_DST_BIT, &readback,
+                  &readback_memory, &readback_data);
+
+      /* Three triangles: two off screen, then one that covers the render
+       * area, so the covering primitive's ID is 2. */
+      const float vertices[9][4] = {
+         {2.0f, 2.0f, 0.0f, 1.0f},  {2.0f, 3.0f, 0.0f, 1.0f},
+         {3.0f, 3.0f, 0.0f, 1.0f},  {2.0f, 2.0f, 0.0f, 1.0f},
+         {3.0f, 2.0f, 0.0f, 1.0f},  {3.0f, 3.0f, 0.0f, 1.0f},
+         {-1.0f, -1.0f, 0.0f, 1.0f}, {3.0f, -1.0f, 0.0f, 1.0f},
+         {-1.0f, 3.0f, 0.0f, 1.0f},
+      };
+      VkBuffer vertex_buffer = VK_NULL_HANDLE;
+      VkDeviceMemory vertex_memory = VK_NULL_HANDLE;
+      void *vertex_data = nullptr;
+      make_buffer(sizeof(vertices), VK_BUFFER_USAGE_VERTEX_BUFFER_BIT,
+                  &vertex_buffer, &vertex_memory, &vertex_data);
+      std::memcpy(vertex_data, vertices, sizeof(vertices));
+
+      VkPipelineLayoutCreateInfo layout_info{
+         VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+      VkPipelineLayout layout = VK_NULL_HANDLE;
+      result = vkCreatePipelineLayout(device, &layout_info, nullptr, &layout);
+      require(result == VK_SUCCESS, "create layout", result);
+
+      auto make_module = [&](const uint32_t *code, size_t size) {
+         VkShaderModuleCreateInfo module_info{
+            VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+         module_info.codeSize = size;
+         module_info.pCode = code;
+         VkShaderModule module = VK_NULL_HANDLE;
+         result = vkCreateShaderModule(device, &module_info, nullptr, &module);
+         require(result == VK_SUCCESS, "create module", result);
+         return module;
+      };
+      VkShaderModule vertex_module =
+         make_module(vertex_spirv, sizeof(vertex_spirv));
+      VkShaderModule geometry_module =
+         make_module(geometry_spirv, sizeof(geometry_spirv));
+      VkShaderModule green_module = make_module(green_spirv, sizeof(green_spirv));
+      VkShaderModule green_if_id_module =
+         make_module(green_if_id_spirv, sizeof(green_if_id_spirv));
+
+      const VkViewport viewport{0.0f, 0.0f, float(extent), float(extent), 0.0f,
+                                1.0f};
+      const VkRect2D scissor{{0, 0}, {extent, extent}};
+
+      VkCommandPoolCreateInfo pool_info{
+         VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+      pool_info.queueFamilyIndex = queue;
+      VkCommandPool pool = VK_NULL_HANDLE;
+      result = vkCreateCommandPool(device, &pool_info, nullptr, &pool);
+      require(result == VK_SUCCESS, "create command pool", result);
+      VkCommandBufferAllocateInfo allocate{
+         VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+      allocate.commandPool = pool;
+      allocate.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+      allocate.commandBufferCount = 1;
+      VkCommandBuffer command = VK_NULL_HANDLE;
+      result = vkAllocateCommandBuffers(device, &allocate, &command);
+      require(result == VK_SUCCESS, "allocate command", result);
+
+      /* Returns 0 when every pixel came out green, 1 when the pipeline could
+       * not be built at all, and 2 when the image is wrong. */
+      auto run = [&](bool geometry, VkShaderModule fragment, bool libraries,
+                     bool dynamic_polygon_mode) {
+         const int32_t expected_id = 2;
+         VkSpecializationMapEntry entry{0u, 0u, sizeof(expected_id)};
+         VkSpecializationInfo specialization{1u, &entry, sizeof(expected_id),
+                                             &expected_id};
+
+         VkPipelineShaderStageCreateInfo stages[3]{};
+         uint32_t stage_count = 0;
+         auto add_stage = [&](VkShaderStageFlagBits bit, VkShaderModule module,
+                              bool specialize) {
+            VkPipelineShaderStageCreateInfo &info = stages[stage_count++];
+            info.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+            info.stage = bit;
+            info.module = module;
+            info.pName = "main";
+            info.pSpecializationInfo = specialize ? &specialization : nullptr;
+         };
+         add_stage(VK_SHADER_STAGE_VERTEX_BIT, vertex_module, false);
+         if (geometry)
+            add_stage(VK_SHADER_STAGE_GEOMETRY_BIT, geometry_module, false);
+         add_stage(VK_SHADER_STAGE_FRAGMENT_BIT, fragment,
+                   fragment == green_if_id_module);
+
+         const VkVertexInputBindingDescription binding{
+            0u, uint32_t(sizeof(float) * 4), VK_VERTEX_INPUT_RATE_VERTEX};
+         const VkVertexInputAttributeDescription attribute{
+            0u, 0u, VK_FORMAT_R32G32B32A32_SFLOAT, 0u};
+         VkPipelineVertexInputStateCreateInfo vi{
+            VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+         vi.vertexBindingDescriptionCount = 1;
+         vi.pVertexBindingDescriptions = &binding;
+         vi.vertexAttributeDescriptionCount = 1;
+         vi.pVertexAttributeDescriptions = &attribute;
+         VkPipelineInputAssemblyStateCreateInfo ia{
+            VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+         ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+         VkPipelineViewportStateCreateInfo vp{
+            VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+         vp.viewportCount = 1;
+         vp.pViewports = &viewport;
+         vp.scissorCount = 1;
+         vp.pScissors = &scissor;
+         VkPipelineRasterizationStateCreateInfo rs{
+            VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+         rs.polygonMode = VK_POLYGON_MODE_FILL;
+         rs.cullMode = VK_CULL_MODE_NONE;
+         rs.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+         rs.lineWidth = 1.0f;
+         VkPipelineMultisampleStateCreateInfo ms{
+            VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+         ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+         VkPipelineDepthStencilStateCreateInfo ds{
+            VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+         VkPipelineColorBlendAttachmentState blend_attachment{};
+         blend_attachment.colorWriteMask = 0xf;
+         VkPipelineColorBlendStateCreateInfo blend{
+            VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+         blend.attachmentCount = 1;
+         blend.pAttachments = &blend_attachment;
+         const VkDynamicState dynamic_states[] = {
+            VK_DYNAMIC_STATE_POLYGON_MODE_EXT,
+         };
+         VkPipelineDynamicStateCreateInfo dynamic{
+            VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+         dynamic.dynamicStateCount = 1;
+         dynamic.pDynamicStates = dynamic_states;
+         VkPipelineRenderingCreateInfo rendering{
+            VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+         rendering.colorAttachmentCount = 1;
+         rendering.pColorAttachmentFormats = &color_format;
+         VkGraphicsPipelineCreateInfo pipeline_info{
+            VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+         pipeline_info.pNext = &rendering;
+         pipeline_info.stageCount = stage_count;
+         pipeline_info.pStages = stages;
+         pipeline_info.pVertexInputState = &vi;
+         pipeline_info.pInputAssemblyState = &ia;
+         pipeline_info.pViewportState = &vp;
+         pipeline_info.pRasterizationState = &rs;
+         pipeline_info.pMultisampleState = &ms;
+         pipeline_info.pDepthStencilState = &ds;
+         pipeline_info.pColorBlendState = &blend;
+         if (dynamic_polygon_mode)
+            pipeline_info.pDynamicState = &dynamic;
+         pipeline_info.layout = layout;
+         VkPipeline pipeline = VK_NULL_HANDLE;
+         VkPipeline parts[4] = {};
+         if (!libraries) {
+            result = vkCreateGraphicsPipelines(
+               device, VK_NULL_HANDLE, 1, &pipeline_info, nullptr, &pipeline);
+            if (result != VK_SUCCESS || pipeline == VK_NULL_HANDLE) {
+               std::printf("  pipeline creation failed: %d\n", result);
+               return 1;
+            }
+         } else {
+            auto create_part = [&](uint32_t index,
+                                   VkGraphicsPipelineLibraryFlagsEXT flags,
+                                   VkGraphicsPipelineCreateInfo info) {
+               VkGraphicsPipelineLibraryCreateInfoEXT part{
+                  VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_LIBRARY_CREATE_INFO_EXT};
+               part.flags = flags;
+               part.pNext = &rendering;
+               info.pNext = &part;
+               info.flags |= VK_PIPELINE_CREATE_LIBRARY_BIT_KHR;
+               info.layout = layout;
+               result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
+                                                  &info, nullptr, &parts[index]);
+               return result == VK_SUCCESS && parts[index] != VK_NULL_HANDLE;
+            };
+            VkGraphicsPipelineCreateInfo input_info{
+               VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+            input_info.pVertexInputState = &vi;
+            input_info.pInputAssemblyState = &ia;
+            VkGraphicsPipelineCreateInfo pre_raster_info{
+               VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+            pre_raster_info.stageCount = stage_count - 1;
+            pre_raster_info.pStages = stages;
+            pre_raster_info.pViewportState = &vp;
+            pre_raster_info.pRasterizationState = &rs;
+            if (dynamic_polygon_mode)
+               pre_raster_info.pDynamicState = &dynamic;
+            VkGraphicsPipelineCreateInfo fragment_info{
+               VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+            fragment_info.stageCount = 1;
+            fragment_info.pStages = &stages[stage_count - 1];
+            fragment_info.pMultisampleState = &ms;
+            fragment_info.pDepthStencilState = &ds;
+            VkGraphicsPipelineCreateInfo output_info{
+               VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+            output_info.pMultisampleState = &ms;
+            output_info.pColorBlendState = &blend;
+            const bool built =
+               create_part(0,
+                           VK_GRAPHICS_PIPELINE_LIBRARY_VERTEX_INPUT_INTERFACE_BIT_EXT,
+                           input_info) &&
+               create_part(1,
+                           VK_GRAPHICS_PIPELINE_LIBRARY_PRE_RASTERIZATION_SHADERS_BIT_EXT,
+                           pre_raster_info) &&
+               create_part(2, VK_GRAPHICS_PIPELINE_LIBRARY_FRAGMENT_SHADER_BIT_EXT,
+                           fragment_info) &&
+               create_part(3,
+                           VK_GRAPHICS_PIPELINE_LIBRARY_FRAGMENT_OUTPUT_INTERFACE_BIT_EXT,
+                           output_info);
+            if (!built) {
+               std::printf("  library creation failed: %d\n", result);
+               for (VkPipeline part : parts)
+                  if (part != VK_NULL_HANDLE)
+                     vkDestroyPipeline(device, part, nullptr);
+               return 1;
+            }
+            VkPipelineLibraryCreateInfoKHR link{
+               VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR};
+            link.libraryCount = 4;
+            link.pLibraries = parts;
+            VkGraphicsPipelineCreateInfo link_info{
+               VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+            link_info.pNext = &link;
+            link_info.layout = layout;
+            result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
+                                               &link_info, nullptr, &pipeline);
+            for (VkPipeline part : parts)
+               vkDestroyPipeline(device, part, nullptr);
+            if (result != VK_SUCCESS || pipeline == VK_NULL_HANDLE) {
+               std::printf("  library link failed: %d\n", result);
+               return 1;
+            }
+         }
+
+         result = vkResetCommandPool(device, pool, 0);
+         require(result == VK_SUCCESS, "reset command pool", result);
+         VkCommandBufferBeginInfo begin{
+            VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+         begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+         result = vkBeginCommandBuffer(command, &begin);
+         require(result == VK_SUCCESS, "begin command", result);
+
+         VkRenderingAttachmentInfo color_attachment{
+            VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+         color_attachment.imageView = color_view;
+         color_attachment.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+         color_attachment.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+         color_attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+         color_attachment.clearValue.color.float32[3] = 1.0f;
+         VkRenderingInfo render_info{VK_STRUCTURE_TYPE_RENDERING_INFO};
+         render_info.renderArea = scissor;
+         render_info.layerCount = 1;
+         render_info.colorAttachmentCount = 1;
+         render_info.pColorAttachments = &color_attachment;
+         vkCmdBeginRendering(command, &render_info);
+         vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+         VkDeviceSize offset = 0;
+         vkCmdBindVertexBuffers(command, 0, 1, &vertex_buffer, &offset);
+         vkCmdDraw(command, 9, 1, 0, 0);
+         vkCmdEndRendering(command);
+
+         VkImageMemoryBarrier to_source{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+         to_source.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+         to_source.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+         to_source.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+         to_source.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+         to_source.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+         to_source.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+         to_source.image = color_image;
+         to_source.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+         vkCmdPipelineBarrier(command,
+                              VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                              VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0,
+                              nullptr, 1, &to_source);
+         VkBufferImageCopy region{};
+         region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+         region.imageExtent = {extent, extent, 1};
+         vkCmdCopyImageToBuffer(command, color_image,
+                                VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, readback,
+                                1, &region);
+         result = vkEndCommandBuffer(command);
+         require(result == VK_SUCCESS, "end command", result);
+
+         VkFenceCreateInfo fence_info{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+         VkFence fence = VK_NULL_HANDLE;
+         result = vkCreateFence(device, &fence_info, nullptr, &fence);
+         require(result == VK_SUCCESS, "create fence", result);
+         VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+         submit.commandBufferCount = 1;
+         submit.pCommandBuffers = &command;
+         result = vkQueueSubmit(device_queue, 1, &submit, fence);
+         require(result == VK_SUCCESS, "submit command", result);
+         result = vkWaitForFences(device, 1, &fence, VK_TRUE, 20000000000ull);
+         require(result == VK_SUCCESS, "draw retired", result);
+         vkDestroyFence(device, fence, nullptr);
+         vkDestroyPipeline(device, pipeline, nullptr);
+
+         const auto *pixels = static_cast<const uint8_t *>(readback_data);
+         uint32_t wrong = 0;
+         for (VkDeviceSize p = 0; p < readback_size; p += 4) {
+            if (pixels[p + 0] > 5 || pixels[p + 1] < 250)
+               ++wrong;
+         }
+         if (wrong) {
+            std::printf("  %u of %u pixels are not green (first %u,%u,%u,%u)\n",
+                        wrong, uint32_t(readback_size / 4), pixels[0], pixels[1],
+                        pixels[2], pixels[3]);
+            return 2;
+         }
+         return 0;
+      };
+
+      struct Case {
+         const char *name;
+         bool geometry;
+         VkShaderModule fragment;
+         bool libraries;
+         bool dynamic_polygon_mode;
+      };
+      const Case cases[] = {
+         {"geometry writes the primitive id, fragment ignores it", true,
+          green_module, false, false},
+         {"geometry writes the primitive id, fragment reads it", true,
+          green_if_id_module, false, false},
+         {"no geometry stage, fragment reads the rasterizer primitive id",
+          false, green_if_id_module, false, false},
+         {"libraries: geometry writes the primitive id, fragment ignores it",
+          true, green_module, true, false},
+         {"libraries: geometry writes the primitive id, fragment reads it",
+          true, green_if_id_module, true, false},
+         {"libraries: no geometry stage, fragment reads the primitive id",
+          false, green_if_id_module, true, false},
+         {"dynamic polygon mode: geometry writes the primitive id, fragment "
+          "ignores it", true, green_module, false, true},
+         {"dynamic polygon mode: geometry writes the primitive id, fragment "
+          "reads it", true, green_if_id_module, false, true},
+         {"dynamic polygon mode, libraries: geometry writes the primitive id, "
+          "fragment ignores it", true, green_module, true, true},
+         {"dynamic polygon mode: no geometry stage, fragment reads the "
+          "primitive id", false, green_if_id_module, false, true},
+      };
+      bool failed = false;
+      for (const Case &test : cases) {
+         std::printf("%s\n", test.name);
+         if (run(test.geometry, test.fragment, test.libraries,
+                 test.dynamic_polygon_mode) != 0)
+            failed = true;
+      }
+      require(!failed, "every primitive id link compiles and delivers");
+      std::printf("primitive id links compile and deliver\n");
+
+      vkDestroyCommandPool(device, pool, nullptr);
+      for (VkShaderModule module : {vertex_module, geometry_module,
+                                    green_module, green_if_id_module})
+         vkDestroyShaderModule(device, module, nullptr);
+      vkDestroyPipelineLayout(device, layout, nullptr);
+      vkDestroyBuffer(device, vertex_buffer, nullptr);
+      vkFreeMemory(device, vertex_memory, nullptr);
+      vkDestroyBuffer(device, readback, nullptr);
+      vkFreeMemory(device, readback_memory, nullptr);
+      vkDestroyImageView(device, color_view, nullptr);
+      vkDestroyImage(device, color_image, nullptr);
+      vkFreeMemory(device, color_memory, nullptr);
+      vkDestroyDevice(device, nullptr);
+   }
+   vkDestroyInstance(instance, nullptr);
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_msl_temporaries.c b/src/kosmickrisp/vulkan/tests/test_msl_temporaries.c
index 0f65860e7d4baf25aa0379875e18fe7c902e71db..f8d557ed6d555b9c593649653428cd50404df1c3 100644
--- a/src/kosmickrisp/vulkan/tests/test_msl_temporaries.c
