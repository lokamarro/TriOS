+#version 450
+layout(location = 0) out vec4 color;
+layout(constant_id = 0) const int expected_id = 0;
+void main()
+{
+   color = gl_PrimitiveID == expected_id ? vec4(0.0, 1.0, 0.0, 1.0)
+                                         : vec4(1.0, 0.0, 0.0, 1.0);
+}
