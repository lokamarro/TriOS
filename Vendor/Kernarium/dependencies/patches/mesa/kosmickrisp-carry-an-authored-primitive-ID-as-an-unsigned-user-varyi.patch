diff --git a/src/kosmickrisp/vulkan/tests/primitive_id_link_shaders/copy_id.geom b/src/kosmickrisp/vulkan/tests/primitive_id_link_shaders/copy_id.geom
new file mode 100644
index 0000000000000000000000000000000000000000..4111e7f7c62f041e92313ae7fd761ba221a003ba
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/primitive_id_link_shaders/copy_id.geom
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: MIT */
+#version 450
+layout(triangles) in;
+layout(triangle_strip, max_vertices = 3) out;
+
+/* The shape a GL driver generates when it has to emulate a primitive Vulkan
+ * lacks: the geometry stage re-emits the primitive unchanged and copies the
+ * primitive ID, whether or not the fragment stage reads it. */
+void main()
+{
+   for (int i = 0; i < 3; ++i) {
+      gl_Position = gl_in[i].gl_Position;
+      gl_PrimitiveID = gl_PrimitiveIDIn;
+      EmitVertex();
+   }
+   EndPrimitive();
+}
