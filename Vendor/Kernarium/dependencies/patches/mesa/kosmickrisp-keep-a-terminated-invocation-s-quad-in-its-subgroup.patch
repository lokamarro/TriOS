diff --git a/src/kosmickrisp/vulkan/tests/terminate_full_quads_shaders/terminate.frag b/src/kosmickrisp/vulkan/tests/terminate_full_quads_shaders/terminate.frag
new file mode 100644
index 0000000000000000000000000000000000000000..aef91b8a06977771ad942319e75083a87b01e1b1
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/terminate_full_quads_shaders/terminate.frag
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: MIT */
+#version 450
+#extension GL_EXT_terminate_invocation : require
+#extension GL_KHR_shader_subgroup_ballot : require
+#extension GL_EXT_shader_quad_control : require
+
+/* The shape of dEQP-VK.reconvergence.terminate_invocation.bit_count: the
+ * invocations the divisor selects terminate between two ballots of the whole
+ * subgroup, and the counts have to add up.  Under full_quads every invocation
+ * of a quad stays active for the whole shader, so a helper invocation is still
+ * counted after the fragment it helps has terminated.  The divisor arrives
+ * through a push constant, and a second copy of it drives the terminate, so
+ * the compiler cannot fold the two conditions together. */
+
+layout(full_quads) in;
+
+layout(push_constant, std430) uniform PCBlock {
+   uint divisor;
+   uint divisorCopy;
+} pc;
+
+layout(location = 0) out uvec4 outBallots;
+
+void main()
+{
+   bool should_terminate = (gl_SubgroupInvocationID % pc.divisor == 0u);
+   bool should_terminate_2 = (gl_SubgroupInvocationID % pc.divisorCopy == 0u);
+
+   uvec4 all_ballot = subgroupBallot(true);
+   uvec4 terminated_ballot = subgroupBallot(should_terminate);
+   uvec4 helper_ballot = subgroupBallot(gl_HelperInvocation);
+
+   if (should_terminate_2)
+      terminateInvocation;
+
+   uvec4 alive_ballot = subgroupBallot(true);
+
+   outBallots = uvec4(all_ballot.x, terminated_ballot.x, alive_ballot.x,
+                      helper_ballot.x);
+}
