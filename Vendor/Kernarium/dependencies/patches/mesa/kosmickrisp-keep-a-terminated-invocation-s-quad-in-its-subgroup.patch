+/* SPDX-License-Identifier: MIT */
+#version 460
+
+/* Two triangles whose six corners all sit exactly on the clip volume, so no
+ * clipper splits them, covering the whole attachment.  The quads the shared
+ * diagonal crosses are only partly covered, which is where the helper
+ * invocations this test needs come from. */
+void main()
+{
+   const vec2 corners[6] = vec2[6](vec2(-1.0, -1.0), vec2(1.0, -1.0),
+                                   vec2(-1.0, 1.0), vec2(-1.0, 1.0),
+                                   vec2(1.0, -1.0), vec2(1.0, 1.0));
+   gl_Position = vec4(corners[gl_VertexIndex], 0.0, 1.0);
+}
