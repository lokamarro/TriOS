--- a/docs/drivers/kosmickrisp/workarounds.rst
+++ b/docs/drivers/kosmickrisp/workarounds.rst
@@ -49,6 +49,49 @@ info on what was updated.
 Workarounds
 ===========
 
+KK_WORKAROUND_19
+----------------
+| macOS version: 27.0
+| Metal ticket: Not reported
+| Metal ticket status:
+| CTS test failure: ``dEQP-VK.reconvergence.terminate_invocation.bit_count``
+| Comments:
+
+``discard_fragment()`` retires the whole 2x2 quad as soon as it has taken the
+quad's last live fragment, and the helper invocations that remain stop
+answering the SIMD group functions. A shader that declares
+``RequireFullQuadsKHR`` has the opposite guarantee: every invocation of a quad,
+helpers included, stays active for the whole shader, so the ballots taken after
+an ``OpTerminateInvocation`` must still count the helper lanes of a quad whose
+covered fragments have terminated.
+
+On an Apple7 GPU under macOS 27.0 (build 26A428) they do not. Rendering two
+triangles over an 8x8 attachment gives one 32-lane SIMD group whose quads 3 and
+6 hold one covered fragment and three helper lanes each. The first
+``subgroupBallot(true)`` returns ``0xffffffff`` and the helper ballot
+``0x0e00e000``, so all 32 lanes and 6 helpers take part. Terminating the even
+lanes then leaves ``subgroupBallot(true)`` at ``0xa0aa0aaa`` rather than
+``0xaaaaaaaa``: lanes 13, 15, 25 and 27 - the helpers of the two quads whose
+only covered fragment terminated - have dropped out, and
+``terminated_count + alive_count`` no longer reaches ``all_count``. The same
+shape with one fully covering triangle, which has no helper lanes at all, comes
+back exact, and replacing the terminate with a plain early return keeps every
+lane, so it is the discard that retires the quad and not the early exit.
+
+The workaround gives a terminating invocation a sample mask of zero and returns
+instead of discarding. The fragment writes neither colour, depth, stencil nor
+memory either way, the invocation stops contributing to the group operations
+that follow because it has left the shader, and the quad keeps a lane inside
+the shader until the end, so its helpers stay in the SIMD group. It applies
+only to a fragment shader that declares ``RequireFullQuadsKHR`` and already
+carries a sample mask output, which the full-quad lowering in ``kk_shader.c``
+writes for exactly those shaders; every other shader keeps
+``discard_fragment()``. The ``kosmickrisp_terminate_full_quads`` test
+reproduces the loss with the workaround disabled.
+
+| Log:
+| 2026-09-17: Workaround implemented
+
 KK_WORKAROUND_18
 ----------------
 | macOS version: 27.0
diff --git a/src/kosmickrisp/compiler/nir_to_msl.c b/src/kosmickrisp/compiler/nir_to_msl.c
index d77537c3ea6bf584640b043f0b0d553d144e35ad..a920e1d0375935d395c8a8e79c4ca0d5b6143520 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.c
+++ b/src/kosmickrisp/compiler/nir_to_msl.c
@@ -278,6 +278,37 @@ msl_coherent_workaround(const struct nir_to_msl_ctx *ctx,
    return msl_instr_in_loop(instr);
 }
 
+/* KK_WORKAROUND_19 */
+static bool
+msl_terminate_kills_samples(const struct nir_to_msl_ctx *ctx)
+{
+   if (ctx->disabled_workarounds & BITFIELD64_BIT(19))
+      return false;
+
+   const nir_shader *shader = ctx->shader;
+
+   return shader->info.stage == MESA_SHADER_FRAGMENT &&
+          shader->info.fs.require_full_quads &&
+          (shader->info.outputs_written &
+           BITFIELD64_BIT(FRAG_RESULT_SAMPLE_MASK));
+}
+
+/* KK_WORKAROUND_19 */
+static void
+msl_emit_terminate(struct nir_to_msl_ctx *ctx)
+{
+   if (msl_terminate_kills_samples(ctx)) {
+      P_INDENT(ctx);
+      msl_output_name(ctx, FRAG_RESULT_SAMPLE_MASK, 0u);
+      P(ctx, " = 0u;\n");
+      P_IND(ctx, "return out;\n");
+      return;
+   }
+
+   P_IND(ctx, "discard_fragment();\n");
+   P_IND(ctx, "return {};\n");
+}
+
 /* KK_WORKAROUND_17 */
 static bool
 msl_coherent_scalar_is_atomic(const char *scalar_type)
@@ -1797,16 +1828,14 @@ intrinsic_to_msl(struct nir_to_msl_ctx *ctx, nir_intrinsic_instr *instr)
       ctx->indentlevel--;
       break;
    case nir_intrinsic_terminate:
-      P_IND(ctx, "discard_fragment();\n");
-      P_IND(ctx, "return {};\n");
+      msl_emit_terminate(ctx);
       break;
    case nir_intrinsic_terminate_if:
       P_IND(ctx, "if (")
       src_to_msl(ctx, &instr->src[0]);
       P(ctx, ") {\n");
       ctx->indentlevel++;
-      P_IND(ctx, "discard_fragment();\n");
-      P_IND(ctx, "return {};\n");
+      msl_emit_terminate(ctx);
       ctx->indentlevel--;
       P_IND(ctx, "}\n");
       break;
