diff --git a/src/kosmickrisp/vulkan/kk_image_extent.h b/src/kosmickrisp/vulkan/kk_image_extent.h
new file mode 100644
index 0000000000000000000000000000000000000000..f2e928c33351888104b676a6f6d114a8946c52d7
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_image_extent.h
@@ -0,0 +1,34 @@
+/*
+ * Copyright 2026 LunarG, Inc.
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef KK_IMAGE_EXTENT_H
+#define KK_IMAGE_EXTENT_H 1
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* The size fields of one Metal texture descriptor. */
+struct kk_image_extent {
+   uint32_t width_px;
+   uint32_t height_px;
+   uint32_t depth_px;
+   uint32_t layers;
+   uint32_t levels;
+   uint32_t sample_count_sa;
+};
+
+/* Whether Metal will accept a texture descriptor of this size.
+ *
+ * Metal validates a texture descriptor with an assertion that ends the
+ * process, and it validates one for a heap size query just as it does for
+ * texture creation, so a zero in any of these fields costs the host rather
+ * than the Vulkan call. Vulkan already requires every one of them to be at
+ * least one, so refusing is invisible to a conforming caller. This driver
+ * serves a guest across a protocol, and a guest that has just lost its Vulkan
+ * device is exactly where an out-of-contract image arrives.
+ */
+bool kk_image_extent_is_creatable(const struct kk_image_extent *extent);
+
+#endif /* KK_IMAGE_EXTENT_H */
diff --git a/src/kosmickrisp/vulkan/kk_image_layout.c b/src/kosmickrisp/vulkan/kk_image_layout.c
index f65cb2c38c11e5809c71de90abdd6570ff162320..b746720288d3a4a4718a7974968b439b3fa86e7e 100644
--- a/src/kosmickrisp/vulkan/kk_image_layout.c
+++ b/src/kosmickrisp/vulkan/kk_image_layout.c
@@ -8,6 +8,7 @@
 
 #include "kk_device.h"
 #include "kk_format.h"
+#include "kk_image_extent.h"
 
 #include "kosmickrisp/bridge/mtl_bridge.h"
 #include "kosmickrisp/bridge/mtl_format.h"
@@ -200,7 +201,7 @@ kk_image_layout_calc_tiled(const struct kk_device *dev,
    assert(layout->level_offsets_B[layout->levels] <= layout->layer_stride_B);
 }
 
-void
+VkResult
 kk_image_layout_init(const struct kk_device *dev, const struct vk_image *image,
                      enum pipe_format format, const uint8_t width_scale,
                      const uint8_t height_scale, struct kk_image_layout *layout)
@@ -235,9 +236,27 @@ kk_image_layout_init(const struct kk_device *dev, const struct vk_image *image,
       layout->usage |= MTL_TEXTURE_USAGE_PIXEL_FORMAT_VIEW;
    }
 
+   /* Both branches below hand this layout to Metal, the tiled one immediately
+    * for a heap size query. Metal answers a descriptor it cannot represent
+    * with an assertion that ends the process, so a degenerate extent has to
+    * stop here and become a Vulkan error instead. A chroma plane divides the
+    * image extent, so a plane can be degenerate where the image is not. */
+   const struct kk_image_extent extent = {
+      .width_px = layout->width_px,
+      .height_px = layout->height_px,
+      .depth_px = layout->depth_px,
+      .layers = layout->layers,
+      .levels = layout->levels,
+      .sample_count_sa = layout->sample_count_sa,
+   };
+   if (!kk_image_extent_is_creatable(&extent))
+      return VK_ERROR_INITIALIZATION_FAILED;
+
    if (layout->linear) {
       kk_image_layout_calc_linear(dev, layout);
    } else {
       kk_image_layout_calc_tiled(dev, layout);
    }
+
+   return VK_SUCCESS;
 }
