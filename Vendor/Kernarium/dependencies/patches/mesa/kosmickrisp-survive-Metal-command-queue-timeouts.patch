diff --git a/src/kosmickrisp/bridge/mtl_command_queue.m b/src/kosmickrisp/bridge/mtl_command_queue.m
index a43bb13ca72ad8d33bdacd080742ff90c0915ce7..08008fef7e61bb41e60053e8c610ccad0b9af936 100644
--- a/src/kosmickrisp/bridge/mtl_command_queue.m
+++ b/src/kosmickrisp/bridge/mtl_command_queue.m
@@ -28,10 +28,36 @@
       [opt addFeedbackHandler:^(id<MTL4CommitFeedback> feedback) {
          @autoreleasepool {
             NSError *error = feedback.error;
+            /* The top-level error names only its domain and code; the
+             * system's account of the failure is nested under it. Keep the
+             * most specific description and the innermost error's domain and
+             * code. The walk is bounded in case a chain ever loops. */
+            NSError *described = nil, *innermost = nil;
+            NSError *nested = error.userInfo[NSUnderlyingErrorKey];
+            for (unsigned depth = 0u;
+                 depth < 8u && [nested isKindOfClass:[NSError class]];
+                 ++depth, nested = nested.userInfo[NSUnderlyingErrorKey]) {
+               if (nested.userInfo[NSLocalizedDescriptionKey] != nil)
+                  described = nested;
+               innermost = nested;
+            }
+            NSString *reason = nil;
+            if (innermost != nil) {
+               NSString *code = [NSString
+                  stringWithFormat:@"[%@ %ld]", innermost.domain,
+                                   (long)innermost.code];
+               reason = described != nil
+                           ? [NSString
+                                stringWithFormat:@"%@ %@",
+                                                 described.localizedDescription,
+                                                 code]
+                           : code;
+            }
             struct mtl_feedback_data feedback_data = (struct mtl_feedback_data){
                .user_data = data,
                .error_message =
                   error ? error.localizedDescription.UTF8String : NULL,
+               .reason = reason.UTF8String,
                .gpu_start = feedback.GPUStartTime,
                .gpu_end = feedback.GPUEndTime,
                .error = error
diff --git a/src/kosmickrisp/bridge/mtl_types.h b/src/kosmickrisp/bridge/mtl_types.h
