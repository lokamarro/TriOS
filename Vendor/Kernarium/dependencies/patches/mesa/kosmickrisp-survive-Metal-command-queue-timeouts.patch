+++ b/src/kosmickrisp/bridge/mtl_types.h
@@ -374,6 +374,13 @@ struct mtl_texture_memory_copy {
 struct mtl_feedback_data {
    void *user_data;
    const char *error_message;
+   /* What the system says happened: the most specific description Metal
+    * nests under the error, with the innermost nested error's domain and
+    * code, or NULL when Metal nests none. A submission that hung the GPU and
+    * one the system discarded while recovering from another submission's
+    * hang, in this process or any other, share one Metal error code; only
+    * this tells them apart. */
+   const char *reason;
    double gpu_start;
    double gpu_end;
    enum mtl_command_queue_error error;
