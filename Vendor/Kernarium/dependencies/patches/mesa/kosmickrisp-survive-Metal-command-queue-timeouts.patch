diff --git a/src/kosmickrisp/vulkan/kk_queue_error.c b/src/kosmickrisp/vulkan/kk_queue_error.c
new file mode 100644
index 0000000000000000000000000000000000000000..66e8e1e365f641dab079cb9816f465a953d82b11
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_queue_error.c
@@ -0,0 +1,120 @@
+/*
+ * Copyright 2026 LunarG, Inc.
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kk_queue_error.h"
+
+#include "kosmickrisp/bridge/vk_to_mtl_map.h"
+
+#include <math.h>
+#include <stdio.h>
+
+/* Longest interval that can be a measurement. A system that reports a timeout
+ * has already stopped the workload, in tens of milliseconds on the tightest
+ * device this driver targets and in seconds anywhere, so a minute of reported
+ * execution is not a duration. Metal puts a fixed placeholder in the end
+ * timestamp of a submission it has no end for -- 6148826548.220315 on every
+ * report an A15 has produced, nine orders of magnitude past this bound -- and
+ * reading that as execution turned a submission with no reported end into a
+ * claim that the GPU ran it for 195 years. */
+static const double kk_longest_credible_execution_s = 60.0;
+
+bool
+kk_queue_error_has_execution_interval(const struct mtl_feedback_data *data)
+{
+   return isfinite(data->gpu_start) && isfinite(data->gpu_end) &&
+          data->gpu_start > 0.0 && data->gpu_end > data->gpu_start &&
+          data->gpu_end - data->gpu_start < kk_longest_credible_execution_s;
+}
+
+bool
+kk_queue_error_admitted_submission(const struct mtl_feedback_data *data)
+{
+   return isfinite(data->gpu_start) && isfinite(data->gpu_end) &&
+          data->gpu_start > 0.0 && data->gpu_end >= data->gpu_start;
+}
+
+bool
+kk_queue_error_is_device_lost(const struct mtl_feedback_data *data)
+{
+   if (data->error == MTL_COMMAND_QUEUE_ERROR_NONE)
+      return false;
+
+   /* A timeout is the one failure that leaves a live queue behind. Anything
+    * else stopped the queue. */
+   if (data->error != MTL_COMMAND_QUEUE_ERROR_TIMEOUT)
+      return true;
+
+   /* A start timestamp means Metal admitted the submission. Admitting it and
+    * reporting no execution for it is the queue killing work it had already
+    * taken, which is what it does to whatever is queued behind a submission
+    * that has just timed out; the queue is running, not stopped. Only a
+    * submission the queue never admitted, or one it started and abandoned
+    * without ever timestamping an end, says the queue itself stopped. */
+   return !kk_queue_error_admitted_submission(data);
+}
+
+void
+kk_queue_error_describe(char *buffer, size_t size,
+                        const struct mtl_feedback_data *data)
+{
+   if (buffer == NULL || size == 0u)
+      return;
+
+   char execution[96];
+
+   if (kk_queue_error_has_execution_interval(data)) {
+      snprintf(execution, sizeof(execution),
+               "the GPU accounted for %.6f s of execution",
+               data->gpu_end - data->gpu_start);
+   } else if (data->gpu_start == 0.0 && data->gpu_end == 0.0) {
+      snprintf(execution, sizeof(execution),
+               "the GPU never started this submission");
+   } else if (kk_queue_error_admitted_submission(data) &&
+              data->gpu_end > data->gpu_start) {
+      /* Admitted, and the end is the placeholder rather than a time, so the
+       * submission was still running when the queue gave up on it: admitted,
+       * no end reported. This names a submission whose own work never
+       * finished, as opposed to one the queue killed on entry. */
+      snprintf(execution, sizeof(execution),
+               "the GPU started this submission and never reported it "
+               "finishing");
+   } else if (kk_queue_error_admitted_submission(data)) {
+      snprintf(execution, sizeof(execution),
+               "the GPU started this submission and ran none of it");
+   } else {
+      snprintf(execution, sizeof(execution),
+               "the GPU reported no execution interval for this submission");
+   }
+
+   /* State the disposition the caller acts on, so a report can never claim
+    * something other than what happened to the device. */
+   const char *disposition =
+      kk_queue_error_is_device_lost(data)
+         ? "the queue stopped making progress and the device is lost"
+         : "the device survives and only this submission's results are in "
+           "doubt";
+
+   const char *message =
+      (data->error_message != NULL && data->error_message[0] != '\0')
+         ? data->error_message
+         : "(none)";
+   const char *reason = (data->reason != NULL && data->reason[0] != '\0')
+                           ? data->reason
+                           : "(none)";
+
+   /* The timestamps are the raw host GPU clock, so two processes that fail at
+    * once can be lined up against each other directly. Metal's own text goes
+    * last, the system's reason before the top-level message: they are the
+    * only unbounded parts, and truncating them must not take the disposition
+    * with it. */
+   snprintf(buffer, size,
+            "command queue error: %s (code %u), %s "
+            "(gpu_start_s=%.17g gpu_end_s=%.17g), so %s, reason: %s, "
+            "message: %s",
+            mtl_command_queue_error_to_string(data->error),
+            (unsigned)data->error, execution, data->gpu_start, data->gpu_end,
+            disposition, reason, message);
+}
diff --git a/src/kosmickrisp/vulkan/kk_queue_error.h b/src/kosmickrisp/vulkan/kk_queue_error.h
new file mode 100644
index 0000000000000000000000000000000000000000..bd564c9ec9f0039cb6f1ac08d94d9108f8f2fc9d
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_queue_error.h
@@ -0,0 +1,72 @@
+/*
+ * Copyright 2026 LunarG, Inc.
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef KK_QUEUE_ERROR_H
+#define KK_QUEUE_ERROR_H 1
+
+#include "kosmickrisp/bridge/mtl_types.h"
+
+#include <stdbool.h>
+
+/* Upper bound on one report, including the terminating NUL. */
+#define KK_QUEUE_ERROR_REPORT_SIZE 512u
+
+/* Whether Metal accounted for this submission from a start to a credible later
+ * end. Metal leaves both timestamps at zero for a submission the GPU never
+ * scheduled, reports a start without a later end for one it abandoned, and puts
+ * a fixed placeholder in the end timestamp of one it admitted and reported no
+ * end for. None of those is a measurement. */
+bool
+kk_queue_error_has_execution_interval(const struct mtl_feedback_data *data);
+
+/* Whether this failure destroyed the device.
+ *
+ * A Metal command queue timeout says one submission exceeded the time the
+ * system allows, or was discarded while the system recovered from a hang
+ * another submission caused, in this process or any other; it does not say
+ * the device is broken. On a contended host the queue keeps accepting and
+ * completing work after such a report, and how long the GPU ran does not
+ * predict it: a submission executing for a fraction of a second is reported
+ * while a longer one on the same GPU succeeds. Losing the device would throw
+ * away a live queue and every result that would follow it, so a timeout for
+ * a submission Metal admitted is reported and survived. What such a report
+ * puts in doubt is that one submission's contents, which the driver cannot
+ * repair and Vulkan cannot express short of device loss; the work itself is
+ * where that shows.
+ *
+ * Every other error, and a timeout for a submission the queue never admitted
+ * or started and abandoned without an end timestamp, means the queue stopped
+ * making progress. That is a hang, and it stays device loss. A submission
+ * whose end is only Metal's placeholder is not one: it was admitted, no end
+ * was reported, and its timeout is survived like any other admitted one.
+ */
+bool kk_queue_error_is_device_lost(const struct mtl_feedback_data *data);
+
+/* Whether Metal took this submission on: it timestamped a start, and any end
+ * it reported is not before that start.
+ *
+ * A submission admitted and then reported with no execution is work the queue
+ * killed on entry, which is what it does to whatever is queued behind a
+ * submission that has just timed out. It says nothing about the queue's
+ * health, so it must not be read as one.
+ */
+bool kk_queue_error_admitted_submission(const struct mtl_feedback_data *data);
+
+/* Describe one failed Metal commit into buffer without allocating.
+ *
+ * Metal reports a commit failure asynchronously, long after the submission
+ * that caused it returned, so this report is the only evidence the failure
+ * leaves behind. It therefore always states what Metal accounted for, and
+ * the disposition kk_queue_error_is_device_lost() chose, so the report and
+ * the action can never disagree. It then carries the system's reason: a GPU
+ * hang in any process makes the system discard every process's in-flight
+ * work, and Metal reports each discard with the timeout code of the
+ * submission that hung, so only the reason says whether this submission
+ * hung the GPU or was thrown away during another's recovery.
+ */
+void kk_queue_error_describe(char *buffer, size_t size,
+                             const struct mtl_feedback_data *data);
+
+#endif /* KK_QUEUE_ERROR_H */
