+/* Closes every encoder and command buffer, in submission order. */
+void
+cs_flush(struct kk_cmd_buffer *cmd)
+{
+   /* Twice: the first promotes post-render work, the second closes it. */
+   cs_end(cmd);
+   cs_end(cmd);
+   cs_end_main(cmd);
+}
