From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 3 Sep 2026 17:12:40 +0900
Subject: [PATCH] kosmickrisp: own feedback options per Metal commit

---
 src/kosmickrisp/vulkan/kk_queue.c | 20 ++++++++++++++------
 src/kosmickrisp/vulkan/kk_queue.h |  2 +-
 2 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index 313a85af8a08d970f6950e8faedf2d7906097d52..28577a5e8f2b50716c89b8ad509620115f264f6d 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -83,10 +83,19 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
 
       /* Metal complains with empty submissions. */
       if (count > 0u) {
-         mtl_commit_options_add_feedback_handler(queue->commit_options,
-                                                 commit_callback, dev);
-         mtl_command_queue_commit(queue->mtl_handle, cmds, count,
-                                  queue->commit_options);
+         /* Feedback handlers may be consumed by commit. Fresh options avoid
+          * both losing later notifications and accumulating old handlers.
+          */
+         mtl_commit_options *options = mtl_new_commit_options();
+         if (!options)
+            /* Earlier waits or command buffers may already be queued. */
+            return vk_queue_set_lost(&queue->vk,
+                                     "Failed to allocate Metal commit options");
+
+         mtl_commit_options_add_feedback_handler(options,
+                                                 queue->feedback_callback, dev);
+         mtl_command_queue_commit(queue->mtl_handle, cmds, count, options);
+         mtl_release(options);
       }
 
       if (cmd_buffer->drawable) {
@@ -144,7 +153,7 @@ kk_queue_init(struct kk_device *dev, struct kk_queue *queue,
    queue->mtl_handle = mtl_new_command_queue(dev->mtl_handle);
    mtl_command_queue_add_residency_set(queue->mtl_handle,
                                        dev->residency_set.handle);
-   queue->commit_options = mtl_new_commit_options();
+   queue->feedback_callback = commit_callback;
 
    queue->vk.driver_submit = kk_queue_submit;
 
@@ -156,7 +165,6 @@ kk_queue_finish(struct kk_device *dev, struct kk_queue *queue)
 {
    mtl_command_queue_remove_residency_set(queue->mtl_handle,
                                           dev->residency_set.handle);
-   mtl_release(queue->commit_options);
    mtl_release(queue->mtl_handle);
    vk_queue_finish(&queue->vk);
 }
diff --git a/src/kosmickrisp/vulkan/kk_queue.h b/src/kosmickrisp/vulkan/kk_queue.h
index a7f19ef41c8d380cde2e503129f40726ebf66b59..985352222940c90815d7c9938e8e0ae01f4e2db4 100644
--- a/src/kosmickrisp/vulkan/kk_queue.h
+++ b/src/kosmickrisp/vulkan/kk_queue.h
@@ -17,7 +17,7 @@
 struct kk_queue {
    struct vk_queue vk;
    struct mtl_command_queue *mtl_handle;
-   mtl_commit_options *commit_options;
+   mtl_feedback_handler_callback feedback_callback;
 };
 
 static inline struct kk_device *
