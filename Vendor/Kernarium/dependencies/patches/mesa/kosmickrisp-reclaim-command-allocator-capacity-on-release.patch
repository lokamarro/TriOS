diff --git a/src/kosmickrisp/vulkan/tests/test_command_pool_release.m b/src/kosmickrisp/vulkan/tests/test_command_pool_release.m
new file mode 100644
index 0000000000000000000000000000000000000000..f92d7dfcd9344e4234b7ffcb205f442aabff01b5
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_command_pool_release.m
@@ -0,0 +1,223 @@
+/* SPDX-License-Identifier: MIT */
+
+#define VK_NO_PROTOTYPES
+#include "kosmickrisp/vulkan/kk_cmd_buffer.h"
+#include "kosmickrisp/vulkan/kk_cmd_pool.h"
+#include <Metal/MTL4CommandAllocator.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x); abort(); } } while (0)
+#define LOAD_I(name) PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name); CHECK(name)
+#define LOAD_D(name) PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name); CHECK(name)
+
+struct test_allocation {
+   void *base;
+   size_t size;
+};
+
+static void *VKAPI_PTR
+poison_alloc(void *data, size_t size, size_t alignment, VkSystemAllocationScope scope)
+{
+   (void)data; (void)scope;
+   alignment = MAX2(alignment, _Alignof(struct test_allocation));
+   void *base = malloc(size + alignment + sizeof(struct test_allocation));
+   if (!base)
+      return NULL;
+   uintptr_t address = ((uintptr_t)base + sizeof(struct test_allocation) + alignment - 1) & ~(alignment - 1);
+   struct test_allocation *header = (struct test_allocation *)address - 1;
+   *header = (struct test_allocation){base, size};
+   memset((void *)address, 0xa5, size);
+   return (void *)address;
+}
+
+static void VKAPI_PTR
+poison_free(void *data, void *p)
+{
+   (void)data;
+   if (p)
+      free(((struct test_allocation *)p - 1)->base);
+}
+
+static void *VKAPI_PTR
+poison_realloc(void *data, void *old, size_t size, size_t alignment,
+               VkSystemAllocationScope scope)
+{
+   if (!size) {
+      poison_free(data, old);
+      return NULL;
+   }
+   void *p = poison_alloc(data, size, alignment, scope);
+   if (p && old) {
+      memcpy(p, old, MIN2(size, ((struct test_allocation *)old - 1)->size));
+      poison_free(data, old);
+   }
+   return p;
+}
+
+static size_t
+allocator_bytes(VkCommandBuffer command)
+{
+   struct kk_cmd_buffer *cmd = kk_cmd_buffer_from_handle(command);
+   struct kk_encoder_state *es[] = {&cmd->cmp[0], &cmd->gfx, &cmd->cmp[1]};
+   size_t bytes = 0;
+   for (unsigned i = 0; i < ARRAY_SIZE(es); i++)
+      bytes += [(id<MTL4CommandAllocator>)es[i]->allocator allocatedSize];
+   return bytes;
+}
+
+static void
+check_released(VkCommandBuffer command)
+{
+   struct kk_cmd_buffer *cmd = kk_cmd_buffer_from_handle(command);
+   CHECK(cmd->cmp[0].allocator == NULL);
+   CHECK(cmd->cmp[1].allocator == NULL);
+   CHECK(cmd->gfx.allocator == NULL);
+}
+
+static void
+check_pool_recycled_released(struct kk_cmd_pool *pool)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(pool->vk.free_command_buffers); i++) {
+      list_for_each_entry(struct vk_command_buffer, cmd,
+                          &pool->vk.free_command_buffers[i], pool_link)
+         check_released(vk_command_buffer_to_handle(cmd));
+   }
+}
+
+int main(void)
+{
+   @autoreleasepool {
+      VkInstance instance = VK_NULL_HANDLE;
+      LOAD_I(vkCreateInstance);
+      VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+                              .apiVersion = VK_API_VERSION_1_3};
+      VkInstanceCreateInfo ici = {.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+                                  .pApplicationInfo = &app};
+      CHECK(vkCreateInstance(&ici, NULL, &instance) == VK_SUCCESS);
+      LOAD_I(vkDestroyInstance);
+      LOAD_I(vkEnumeratePhysicalDevices);
+      LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+      LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+      LOAD_I(vkCreateDevice);
+      LOAD_I(vkGetDeviceProcAddr);
+      uint32_t count = 1;
+      VkPhysicalDevice physical;
+      CHECK(vkEnumeratePhysicalDevices(instance, &count, &physical) == VK_SUCCESS);
+      CHECK(count == 1);
+      uint32_t family_count = 0;
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &family_count, NULL);
+      VkQueueFamilyProperties *families = calloc(family_count, sizeof(*families));
+      CHECK(families);
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &family_count, families);
+      uint32_t family = 0;
+      while (family < family_count && !(families[family].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+         family++;
+      CHECK(family < family_count);
+      free(families);
+      float priority = 1;
+      VkDeviceQueueCreateInfo qci = {.sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+         .queueFamilyIndex = family, .queueCount = 1, .pQueuePriorities = &priority};
+      VkDeviceCreateInfo dci = {.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+         .queueCreateInfoCount = 1, .pQueueCreateInfos = &qci};
+      VkDevice device;
+      CHECK(vkCreateDevice(physical, &dci, NULL, &device) == VK_SUCCESS);
+      LOAD_D(vkDestroyDevice); LOAD_D(vkGetDeviceQueue);
+      LOAD_D(vkCreateCommandPool); LOAD_D(vkDestroyCommandPool);
+      LOAD_D(vkAllocateCommandBuffers); LOAD_D(vkFreeCommandBuffers);
+      LOAD_D(vkBeginCommandBuffer); LOAD_D(vkEndCommandBuffer);
+      LOAD_D(vkResetCommandBuffer); LOAD_D(vkResetCommandPool); LOAD_D(vkTrimCommandPool);
+      LOAD_D(vkCreateBuffer); LOAD_D(vkDestroyBuffer); LOAD_D(vkGetBufferMemoryRequirements);
+      LOAD_D(vkAllocateMemory); LOAD_D(vkFreeMemory); LOAD_D(vkBindBufferMemory);
+      LOAD_D(vkMapMemory); LOAD_D(vkUnmapMemory); LOAD_D(vkCmdFillBuffer);
+      LOAD_D(vkQueueSubmit); LOAD_D(vkCreateFence); LOAD_D(vkWaitForFences); LOAD_D(vkDestroyFence);
+      VkQueue queue;
+      vkGetDeviceQueue(device, family, 0, &queue);
+      VkBufferCreateInfo bci = {.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+         .size = 4096, .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT};
+      VkBuffer buffer;
+      CHECK(vkCreateBuffer(device, &bci, NULL, &buffer) == VK_SUCCESS);
+      VkMemoryRequirements requirements;
+      vkGetBufferMemoryRequirements(device, buffer, &requirements);
+      VkPhysicalDeviceMemoryProperties properties;
+      vkGetPhysicalDeviceMemoryProperties(physical, &properties);
+      uint32_t type = 0;
+      const VkMemoryPropertyFlags required = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+      while (type < properties.memoryTypeCount &&
+             (!(requirements.memoryTypeBits & (1u << type)) ||
+              (properties.memoryTypes[type].propertyFlags & required) != required))
+         type++;
+      CHECK(type < properties.memoryTypeCount);
+      VkMemoryAllocateInfo mai = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+         .allocationSize = requirements.size, .memoryTypeIndex = type};
+      VkDeviceMemory memory;
+      CHECK(vkAllocateMemory(device, &mai, NULL, &memory) == VK_SUCCESS);
+      CHECK(vkBindBufferMemory(device, buffer, memory, 0) == VK_SUCCESS);
+      uint32_t *mapped;
+      CHECK(vkMapMemory(device, memory, 0, VK_WHOLE_SIZE, 0, (void **)&mapped) == VK_SUCCESS);
+      const VkAllocationCallbacks alloc = {.pfnAllocation = poison_alloc,
+         .pfnReallocation = poison_realloc, .pfnFree = poison_free};
+      VkCommandPoolCreateInfo pci = {.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+         .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT, .queueFamilyIndex = family};
+      VkCommandPool pool_handle;
+      CHECK(vkCreateCommandPool(device, &pci, &alloc, &pool_handle) == VK_SUCCESS);
+      struct kk_cmd_pool *pool = kk_cmd_pool_from_handle(pool_handle);
+      CHECK(pool->num_free_bos == 0);
+      VkCommandBufferAllocateInfo cai = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+         .commandPool = pool_handle, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY, .commandBufferCount = 2};
+      VkCommandBuffer commands[2];
+      CHECK(vkAllocateCommandBuffers(device, &cai, commands) == VK_SUCCESS);
+      VkCommandBufferBeginInfo begin = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+      const VkCommandBufferResetFlags release = VK_COMMAND_BUFFER_RESET_RELEASE_RESOURCES_BIT;
+      CHECK(vkResetCommandBuffer(commands[0], release) == VK_SUCCESS);
+      check_released(commands[0]);
+      for (unsigned round = 0; round < 3; round++) {
+         CHECK(vkBeginCommandBuffer(commands[0], &begin) == VK_SUCCESS);
+         vkCmdFillBuffer(commands[0], buffer, 0, 4096, 0x13579bdf);
+         CHECK(vkEndCommandBuffer(commands[0]) == VK_SUCCESS);
+         CHECK(allocator_bytes(commands[0]) > 0);
+         if (round == 0) {
+            CHECK(vkResetCommandBuffer(commands[0], 0) == VK_SUCCESS);
+            CHECK(allocator_bytes(commands[0]) > 0);
+            CHECK(vkResetCommandBuffer(commands[0], release) == VK_SUCCESS);
+            check_released(commands[0]);
+         } else if (round == 1) {
+            CHECK(vkResetCommandPool(device, pool_handle, VK_COMMAND_POOL_RESET_RELEASE_RESOURCES_BIT) == VK_SUCCESS);
+            check_released(commands[0]);
+            check_released(commands[1]);
+            CHECK(pool->num_free_bos == 0);
+         }
+      }
+      /* Trimming must preserve an active executable recording and its storage. */
+      vkFreeCommandBuffers(device, pool_handle, 1, &commands[1]);
+      check_pool_recycled_released(pool);
+      size_t recorded_bytes = allocator_bytes(commands[0]);
+      vkTrimCommandPool(device, pool_handle, 0);
+      CHECK(pool->num_free_bos == 0);
+      CHECK(allocator_bytes(commands[0]) == recorded_bytes);
+      memset(mapped, 0, 4096);
+      VkFenceCreateInfo fci = {.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+      VkFence fence;
+      CHECK(vkCreateFence(device, &fci, NULL, &fence) == VK_SUCCESS);
+      VkSubmitInfo submit = {.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+         .commandBufferCount = 1, .pCommandBuffers = &commands[0]};
+      CHECK(vkQueueSubmit(queue, 1, &submit, fence) == VK_SUCCESS);
+      CHECK(vkWaitForFences(device, 1, &fence, VK_TRUE, 10000000000ull) == VK_SUCCESS);
+      for (unsigned i = 0; i < 1024; i++)
+         CHECK(mapped[i] == 0x13579bdf);
+      vkDestroyFence(device, fence, NULL);
+      vkFreeCommandBuffers(device, pool_handle, 1, &commands[0]);
+      check_pool_recycled_released(pool);
+      CHECK(vkResetCommandPool(device, pool_handle, VK_COMMAND_POOL_RESET_RELEASE_RESOURCES_BIT) == VK_SUCCESS);
+      CHECK(pool->num_free_bos == 0);
+      vkDestroyCommandPool(device, pool_handle, &alloc);
+      vkUnmapMemory(device, memory);
+      vkDestroyBuffer(device, buffer, NULL);
+      vkFreeMemory(device, memory, NULL);
+      vkDestroyDevice(device, NULL);
+      vkDestroyInstance(instance, NULL);
+   }
+   return 0;
+}
