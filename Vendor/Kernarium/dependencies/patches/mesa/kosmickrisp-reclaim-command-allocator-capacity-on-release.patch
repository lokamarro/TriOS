From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Wed, 9 Sep 2026 02:34:30 +0900
Subject: [PATCH] kosmickrisp: reclaim command allocator capacity on release

Metal allocator reset retains its high-water capacity. Drop allocators after RELEASE_RESOURCES discards a recording, including INITIAL command buffers, and recreate them at Begin. Return cached pool storage on pool release and initialize and bound its BO accounting.

Add native coverage for release, reset, recycling and trim, with real GPU fill readback after lazy allocator recreation.
---
 src/kosmickrisp/vulkan/kk_cmd_buffer.c        |  38 ++-
 src/kosmickrisp/vulkan/kk_cmd_pool.c          |  22 +-
 src/kosmickrisp/vulkan/meson.build            |  22 ++
 .../vulkan/tests/test_command_pool_release.m  | 223 ++++++++++++++++++
 4 files changed, 302 insertions(+), 3 deletions(-)
 create mode 100644 src/kosmickrisp/vulkan/tests/test_command_pool_release.m

diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.c b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
index ce93d646e781664d7c0c479bb47631b2a5afef97..7bb009a0a617d744af8887dbe31d622028fef9c4 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
@@ -194,7 +194,8 @@ alloc_fail:
 static void
 kk_reset_encoder_state(struct kk_encoder_state *es)
 {
-   mtl_command_allocator_reset(es->allocator);
+   if (es->allocator)
+      mtl_command_allocator_reset(es->allocator);
 }
 
 void
@@ -221,13 +222,23 @@ kk_reset_cmd_buffer_internal(struct kk_cmd_buffer *cmd)
 
 static void
 kk_reset_cmd_buffer(struct vk_command_buffer *vk_cmd_buffer,
-                    UNUSED VkCommandBufferResetFlags flags)
+                    VkCommandBufferResetFlags flags)
 {
    struct kk_cmd_buffer *cmd =
       container_of(vk_cmd_buffer, struct kk_cmd_buffer, vk);
 
    vk_command_buffer_reset(&cmd->vk);
    kk_reset_cmd_buffer_internal(cmd);
+   if (flags & VK_COMMAND_BUFFER_RESET_RELEASE_RESOURCES_BIT) {
+      /* Metal reset retains allocator high-water capacity. The recording has
+       * been discarded, so release the allocators and recreate them at Begin. */
+      struct kk_encoder_state *encoders[] = {&cmd->cmp[0], &cmd->gfx,
+                                             &cmd->cmp[1]};
+      for (unsigned i = 0; i < ARRAY_SIZE(encoders); i++) {
+         mtl_release(encoders[i]->allocator);
+         encoders[i]->allocator = NULL;
+      }
+   }
    cmd->submitted = false;
    cmd->one_time_submit = false;
 }
@@ -238,6 +249,17 @@ const struct vk_command_buffer_ops kk_cmd_buffer_ops = {
    .destroy = kk_destroy_cmd_buffer,
 };
 
+VKAPI_ATTR VkResult VKAPI_CALL
+kk_ResetCommandBuffer(VkCommandBuffer commandBuffer,
+                      VkCommandBufferResetFlags flags)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+
+   /* INITIAL buffers can retain capacity from an earlier reset without release. */
+   kk_reset_cmd_buffer(&cmd->vk, flags);
+   return VK_SUCCESS;
+}
+
 VKAPI_ATTR VkResult VKAPI_CALL
 kk_BeginCommandBuffer(VkCommandBuffer commandBuffer,
                       const VkCommandBufferBeginInfo *pBeginInfo)
@@ -245,6 +267,18 @@ kk_BeginCommandBuffer(VkCommandBuffer commandBuffer,
    VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
 
    kk_reset_cmd_buffer(&cmd->vk, 0u);
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_encoder_state *encoders[] = {&cmd->cmp[0], &cmd->gfx,
+                                          &cmd->cmp[1]};
+   for (unsigned i = 0; i < ARRAY_SIZE(encoders); i++) {
+      if (!encoders[i]->allocator)
+         encoders[i]->allocator = mtl_new_command_allocator(dev->mtl_handle);
+      if (!encoders[i]->allocator) {
+         kk_reset_cmd_buffer(&cmd->vk,
+                             VK_COMMAND_BUFFER_RESET_RELEASE_RESOURCES_BIT);
+         return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      }
+   }
    vk_command_buffer_begin(&cmd->vk, pBeginInfo);
    cmd->one_time_submit =
       pBeginInfo->flags & VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
diff --git a/src/kosmickrisp/vulkan/kk_cmd_pool.c b/src/kosmickrisp/vulkan/kk_cmd_pool.c
index 9962c952d9612ba18f409cf16e87ed97bf6990f3..e505acdf6e537df2696af29175c119482401bbfe 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_pool.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_pool.c
@@ -11,6 +11,8 @@
 #include "kk_entrypoints.h"
 #include "kk_physical_device.h"
 
+#include "vk_common_entrypoints.h"
+
 static VkResult
 kk_cmd_bo_create(struct kk_cmd_pool *pool, struct kk_cmd_bo **bo_out)
 {
@@ -47,6 +49,7 @@ kk_cmd_pool_destroy_bos(struct kk_cmd_pool *pool)
       kk_cmd_bo_destroy(pool, bo);
 
    list_inithead(&pool->free_bos);
+   pool->num_free_bos = 0;
 }
 
 VkResult
@@ -72,7 +75,7 @@ kk_cmd_pool_free_bo_list(struct kk_cmd_pool *pool, struct list_head *bos)
 {
    list_for_each_entry_safe(struct kk_cmd_bo, bo, bos, link) {
       list_del(&bo->link);
-      if (pool->num_free_bos > KK_CMD_POOL_BO_MAX) {
+      if (pool->num_free_bos >= KK_CMD_POOL_BO_MAX) {
          kk_cmd_bo_destroy(pool, bo);
       } else {
          list_addtail(&bo->link, &pool->free_bos);
@@ -103,6 +106,7 @@ kk_CreateCommandPool(VkDevice _device,
    }
 
    list_inithead(&pool->free_bos);
+   pool->num_free_bos = 0;
 
    *pCmdPool = kk_cmd_pool_to_handle(pool);
 
@@ -124,6 +128,22 @@ kk_DestroyCommandPool(VkDevice _device, VkCommandPool commandPool,
    vk_free2(&device->vk.alloc, pAllocator, pool);
 }
 
+VKAPI_ATTR VkResult VKAPI_CALL
+kk_ResetCommandPool(VkDevice device, VkCommandPool commandPool,
+                    VkCommandPoolResetFlags flags)
+{
+   VK_FROM_HANDLE(kk_cmd_pool, pool, commandPool);
+   VkResult result = vk_common_ResetCommandPool(device, commandPool, flags);
+   if (result == VK_SUCCESS &&
+       (flags & VK_COMMAND_POOL_RESET_RELEASE_RESOURCES_BIT)) {
+      /* Recycled buffers already released their Metal allocators at free.
+       * Also return their objects and the pool's cached upload BOs. */
+      vk_command_pool_trim(&pool->vk, 0);
+      kk_cmd_pool_destroy_bos(pool);
+   }
+   return result;
+}
+
 VKAPI_ATTR void VKAPI_CALL
 kk_TrimCommandPool(VkDevice device, VkCommandPool commandPool,
                    VkCommandPoolTrimFlags flags)
diff --git a/src/kosmickrisp/vulkan/meson.build b/src/kosmickrisp/vulkan/meson.build
index 97cfe19cf16e39d0e554aaca62fa9b3cc13da341..ee47b277137ebbf97140d36170ee567034fb4774 100644
