diff --git a/src/kosmickrisp/bridge/tests/test_descriptor_lifetime.c b/src/kosmickrisp/bridge/tests/test_descriptor_lifetime.c
new file mode 100644
index 0000000000000000000000000000000000000000..157d890ad74a20f55dfc68bbcdfdd21bc44a308c
--- /dev/null
+++ b/src/kosmickrisp/bridge/tests/test_descriptor_lifetime.c
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: MIT */
+
+#include "kosmickrisp/bridge/mtl_bridge.h"
+
+#include <malloc/malloc.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+struct descriptor_case {
+   const char *name;
+   void *(*create)(void);
+};
+
+static void
+exercise(const struct descriptor_case *test, unsigned count)
+{
+   for (unsigned i = 0; i < count; i++) {
+      void *descriptor = test->create();
+      if (descriptor == NULL) {
+         fprintf(stderr, "%s creation failed\n", test->name);
+         exit(1);
+      }
+      mtl_release(descriptor);
+   }
+}
+
+int
+main(void)
+{
+   const struct descriptor_case cases[] = {
+      {"render pass", mtl_new_render_pass_descriptor},
+      {"stencil", mtl_new_stencil_descriptor},
+      {"depth stencil", mtl_new_depth_stencil_descriptor},
+      {"commit options", mtl_new_commit_options},
+      {"argument table", mtl_new_argument_table_descriptor},
+   };
+
+   /* Warm Objective-C class initialization before measuring live allocations.
+    * Measure bytes still in use, not allocator pages retained for reuse.
+    * Reinitializing a render-pass descriptor loses its first attachment array
+    * and leaves about 4.8 MB live after this many create/release pairs.
+    */
+   for (unsigned i = 0; i < sizeof(cases) / sizeof(cases[0]); i++)
+      exercise(&cases[i], 512);
+
+   for (unsigned i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+      malloc_statistics_t before, after;
+      malloc_zone_statistics(NULL, &before);
+      exercise(&cases[i], 50000);
+      malloc_zone_statistics(NULL, &after);
+      if (after.size_in_use > before.size_in_use &&
+          after.size_in_use - before.size_in_use > 1024 * 1024) {
+         fprintf(stderr, "%s retained %zu bytes after create/release\n",
+                 cases[i].name, after.size_in_use - before.size_in_use);
+         return 1;
+      }
+   }
+
+   puts("Metal descriptor lifetime regression passed");
+   return 0;
+}
