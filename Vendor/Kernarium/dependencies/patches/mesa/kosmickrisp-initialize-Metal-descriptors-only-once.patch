 .../bridge/tests/test_descriptor_lifetime.c   | 61 +++++++++++++++++++
 5 files changed, 83 insertions(+), 5 deletions(-)
 create mode 100644 src/kosmickrisp/bridge/tests/test_descriptor_lifetime.c

