diff --git a/src/kosmickrisp/vulkan/kk_gpl.h b/src/kosmickrisp/vulkan/kk_gpl.h
index de3e4d7158ce0e569afd1c490d3d632c150a483a..fe1de5ed5aea8a91980dd71163d546051de05580 100644
--- a/src/kosmickrisp/vulkan/kk_gpl.h
+++ b/src/kosmickrisp/vulkan/kk_gpl.h
@@ -53,6 +53,34 @@ kk_graphics_state_has_static_depth_stencil(
       BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_DS_STENCIL_WRITE_MASK));
 }
 
+/* Vulkan performs the sample mask test before the early depth and stencil
+ * tests and before occlusion sample counting.  Metal has no fixed-function
+ * sample mask at all: the only place a mask can be expressed is the fragment
+ * function's [[sample_mask]] output, and a function that declares early
+ * fragment tests applies that output after Metal's visibility counter has
+ * already counted the sample.  Such a pipeline counts the samples in the
+ * fragment function instead - a function that writes memory is invoked once
+ * per sample that survived the early tests - so the mask reaches the count.
+ */
+static inline bool
+kk_fs_counts_occlusion_samples(const struct vk_graphics_pipeline_state *state,
+                               bool early_fragment_tests)
+{
+   if (!early_fragment_tests || state == NULL || state->ms == NULL)
+      return false;
+
+   const uint32_t samples = state->ms->rasterization_samples;
+   if (samples <= 1u)
+      return false;
+
+   /* vk_multisample_state carries sixteen mask bits; a larger sample count
+    * can only be masked in the bits it does carry. */
+   const uint32_t bits = samples < 16u ? samples : 16u;
+   const uint32_t covered = (1u << bits) - 1u;
+
+   return (state->ms->sample_mask & covered) != covered;
+}
+
 /* Fragment-output identity of a graphics pipeline.  A linked pipeline library
  * is cached device-wide under this key, so it must describe every attachment
  * the compiled Metal pipeline and its depth-stencil state are built from.
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.c b/src/kosmickrisp/vulkan/kk_physical_device.c
index 82f5d4aff2015f1e0bb72a28ec399f8a69d6a141..50f97c4fb549e15259ad97b1855ed13e8491a75c 100644
--- a/src/kosmickrisp/vulkan/kk_physical_device.c
+++ b/src/kosmickrisp/vulkan/kk_physical_device.c
@@ -805,7 +805,11 @@ kk_get_device_properties(const struct kk_physical_device *pdev,
 
       /* VK_KHR_maintenance5 */
       .earlyFragmentMultisampleCoverageAfterSampleCounting = true,
-      .earlyFragmentSampleMaskTestBeforeSampleCounting = false,
+      /* A pipeline whose static sample mask discards samples counts them in
+       * its fragment function rather than with Metal's visibility counter,
+       * which cannot see the mask, so the sample mask test does reach the
+       * count. */
+      .earlyFragmentSampleMaskTestBeforeSampleCounting = true,
       .depthStencilSwizzleOneSupport = true,
       .polygonModePointSize = true,
       .nonStrictSinglePixelWideLinesUseParallelogram = false,
diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
index 969e22bf1033d129b243745e7e9f86f8adaa638e..6e00807230fe733939d329ffa3322843b835ace3 100644
--- a/src/kosmickrisp/vulkan/kk_shader.c
+++ b/src/kosmickrisp/vulkan/kk_shader.c
@@ -743,6 +743,63 @@ kk_nir_lower_fs_pipeline_statistics(nir_shader *nir)
    nir_progress(true, b.impl, nir_metadata_none);
 }
 
+/* The lowering below and the pipeline info the draw path reads must agree
+ * exactly: an info bit set without the counter would disable Metal's counter
+ * and report nothing at all.  Its one caller therefore asks once, late enough
+ * that the cross-stage varying optimizer has already shrunk the varying count
+ * the budget test reads, and drives both the lowering and the info bit from
+ * that single answer. */
+static bool
+kk_fs_wants_early_sample_counting(
+   const struct vk_graphics_pipeline_state *state, const nir_shader *nir)
+{
+   /* The memory write below makes Metal shade a multisampled fragment in
+    * sample groups, and the mask a post-depth-coverage group receives then
+    * keeps the samples the stencil test killed.  A shader that asked for
+    * post-depth-coverage keeps the mask that extension promises and the
+    * doubled count the specification permits, exactly as it keeps its mask
+    * rather than the pipeline-statistics counter. */
+   return !nir->info.fs.post_depth_coverage &&
+          kk_fs_counts_occlusion_samples(state,
+                                         nir->info.fs.early_fragment_tests);
+}
+
+/* Count the samples Vulkan asks an occlusion query to count, in the fragment
+ * function, because Metal's visibility counter cannot see the static sample
+ * mask: it runs before a fragment function that declares early fragment
+ * tests, and the mask has no fixed-function form in Metal.  Writing memory
+ * makes Metal invoke the function once per sample that survived the early
+ * depth and stencil tests, so counting the invocations whose own sample the
+ * mask keeps is exactly the count the specification prefers.  The slot is a
+ * 64-bit counter shared with Metal's own writes, so a wrapping low word
+ * carries into the high one. */
+static void
+kk_nir_lower_fs_early_sample_counting(nir_shader *nir, uint32_t sample_mask)
+{
+   assert(nir->info.stage == MESA_SHADER_FRAGMENT);
+
+   nir_builder b =
+      nir_builder_at(nir_before_impl(nir_shader_get_entrypoint(nir)));
+
+   nir_def *address = kk_nir_load_root(
+      &b, 1, 64,
+      nir_imm_int(&b, offsetof(struct kk_root_descriptor_table,
+                               draw.occlusion_counter)),
+      8);
+
+   nir_def *enabled = nir_ine_imm(&b, address, 0);
+   nir_def *non_helper = nir_inot(&b, nir_load_helper_invocation(&b, 1));
+   nir_def *sample_bit =
+      nir_ishl(&b, nir_imm_int(&b, 1), nir_load_sample_id(&b));
+   nir_def *kept =
+      nir_ine_imm(&b, nir_iand_imm(&b, sample_bit, sample_mask), 0u);
+
+   kk_nir_count_u64(&b, address,
+                    nir_iand(&b, nir_iand(&b, enabled, non_helper), kept));
+
+   nir_progress(true, b.impl, nir_metadata_none);
+}
+
 static void
 kk_lower_fs(struct kk_device *dev, nir_shader *nir,
             const struct vk_graphics_pipeline_state *state, bool writes_depth,
@@ -1099,7 +1156,6 @@ gather_shader_info(struct kk_shader *shader, nir_shader *nir,
       shader->info.fs.flat_inputs =
          nir->info.inputs_read &
          ~(nir->info.linear_varyings | nir->info.perspective_varyings);
-
       /* Some meta shaders like vk-meta-resolve will have depth_layout as NONE
        * which is not a valid Metal layout */
       if (nir->info.fs.depth_layout == FRAG_DEPTH_LAYOUT_NONE)
@@ -1263,6 +1319,19 @@ kk_compile_shader_as(struct kk_device *dev, nir_shader *nir,
       msl_nir_lower_clip_cull_distance(nir, num_cull_distances);
    }
 
+   /* Metal charges one varying component to a fragment function that writes
+    * memory, exactly as it does for the invocation counter above, so a shader
+    * that consumes every component the hardware carries keeps its pipeline and
+    * reports the unmasked count rather than losing the pipeline. */
+   if (nir->info.stage == MESA_SHADER_FRAGMENT) {
+      const bool count_samples =
+         kk_fs_wants_early_sample_counting(state, nir) &&
+         msl_fs_varying_components(nir) < MSL_MAX_FRAGMENT_VARYING_COMPONENTS;
+      if (count_samples)
+         kk_nir_lower_fs_early_sample_counting(nir, state->ms->sample_mask);
+      shader->info.fs.counts_occlusion_samples = count_samples;
+   }
+
    NIR_PASS(_, nir, kk_nir_lower_poly, pipeline_statistics);
 
    msl_optimize_nir(nir);
@@ -3695,8 +3764,11 @@ gather_graphics_pipeline_create_info(
       if (s->info.stage == MESA_SHADER_TESS_CTRL)
          info->vs.tess_local_thread_size = s->info.tess.tcs_output_patch_size;
 
-      if (s->info.stage == MESA_SHADER_FRAGMENT)
+      if (s->info.stage == MESA_SHADER_FRAGMENT) {
          info->vs.flat_outputs = s->info.fs.flat_inputs;
+         info->vs.counts_occlusion_samples =
+            s->info.fs.counts_occlusion_samples;
+      }
    }
 
    uint8_t topology = state->ia->primitive_topology;
