+#version 460
+/* SPDX-License-Identifier: MIT */
+/* With early fragment tests the coverage the shader writes comes after sample
+ * counting and must not change the count; only the pipeline's static sample
+ * mask, which is tested first of all, may. */
+layout (early_fragment_tests) in;
+layout (location=0) out vec4 fragColor;
+void main (void) {
+    gl_SampleMask[0] = 0x0;
+    fragColor = vec4(1.0, 1.0, 0.0, 1.0);
+}
