From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 3 Sep 2026 17:42:15 +0900
Subject: [PATCH] kosmickrisp: compile application shaders with safe math

---
 src/kosmickrisp/vulkan/kk_shader.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
index c3583d73726036889a9e29e6b0d2f3b41a758a6a..463c743c6bb932be789180a12ab601ca8aeee401 100644
--- a/src/kosmickrisp/vulkan/kk_shader.c
+++ b/src/kosmickrisp/vulkan/kk_shader.c
@@ -980,8 +980,8 @@ kk_compile_compute_pipeline(struct kk_device *device,
                             mtl_compute_pipeline_state **pipe)
 {
    mtl_library *library = mtl_new_library(
-      device->mtl_compiler_handle, data->code, MTL_MATH_MODE_FAST,
-      MTL_MATH_FLOATING_POINT_FUNCTIONS_FAST);
+      device->mtl_compiler_handle, data->code, MTL_MATH_MODE_SAFE,
+      MTL_MATH_FLOATING_POINT_FUNCTIONS_PRECISE);
    if (library == NULL)
       return VK_ERROR_INVALID_SHADER_NV;
 
@@ -1225,8 +1225,8 @@ kk_compile_graphics_pipeline(struct kk_device *device, struct kk_shader *vs)
 
    const struct msl_compile_data *vs_data = &vs->msl_data[vs_stage];
    mtl_library *vertex_library = mtl_new_library(
-      device->mtl_compiler_handle, vs_data->code, MTL_MATH_MODE_FAST,
-      MTL_MATH_FLOATING_POINT_FUNCTIONS_FAST);
+      device->mtl_compiler_handle, vs_data->code, MTL_MATH_MODE_SAFE,
+      MTL_MATH_FLOATING_POINT_FUNCTIONS_PRECISE);
    if (vertex_library == NULL)
       return VK_ERROR_INVALID_SHADER_NV;
 
@@ -1236,8 +1236,8 @@ kk_compile_graphics_pipeline(struct kk_device *device, struct kk_shader *vs)
 
    const struct msl_compile_data *fs_data = &vs->msl_data[MESA_SHADER_FRAGMENT];
    mtl_library *fragment_library = mtl_new_library(
-      device->mtl_compiler_handle, fs_data->code, MTL_MATH_MODE_FAST,
-      MTL_MATH_FLOATING_POINT_FUNCTIONS_FAST);
+      device->mtl_compiler_handle, fs_data->code, MTL_MATH_MODE_SAFE,
+      MTL_MATH_FLOATING_POINT_FUNCTIONS_PRECISE);
    if (fragment_library == NULL) {
       result = VK_ERROR_INVALID_SHADER_NV;
       goto destroy_vertex;
