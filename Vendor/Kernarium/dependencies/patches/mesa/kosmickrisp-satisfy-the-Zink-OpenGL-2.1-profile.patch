@@ -1785,6 +1799,32 @@ kk_upload_per_draw_data(struct kk_cmd_buffer *cmd, uint32_t upload_mask,
          VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT;
    }
 
+   if (rectangular_lines) {
+      const struct vk_dynamic_graphics_state *dyn =
+         &cmd->vk.dynamic_graphics_state;
+      gfx->per_draw_data.rectangular_line_topology = prim;
+      gfx->per_draw_data.rectangular_line_provoking_last =
+         dyn->rs.provoking_vertex ==
+         VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT;
+      gfx->per_draw_data.rectangular_line_half_width =
+         dyn->rs.line.width * 0.5f;
+
+      for (uint32_t i = 0; i < KK_MAX_VIEWPORTS; ++i) {
+         const VkViewport *viewport =
+            i < dyn->vp.viewport_count ? &dyn->vp.viewports[i] : NULL;
