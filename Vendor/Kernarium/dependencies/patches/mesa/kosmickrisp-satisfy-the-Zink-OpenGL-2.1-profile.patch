       if (sampler->has_border) {
diff --git a/src/kosmickrisp/vulkan/kk_descriptor_types.h b/src/kosmickrisp/vulkan/kk_descriptor_types.h
index 8cd9f485f258d52cd8d57e3ae50b52b6eaebd156..0dee65bc71a37905d5fb2baadf89380533066fe4 100644
--- a/src/kosmickrisp/vulkan/kk_descriptor_types.h
+++ b/src/kosmickrisp/vulkan/kk_descriptor_types.h
@@ -21,14 +21,52 @@ struct kk_sampled_image_descriptor {
     * high bits carry the sampler's compare operation, which a depth-compare
     * sample needs in order to evaluate the emulated border itself. */
    int32_t clamp_0_sampler_index_or_negative;
-   uint32_t pad_to_64_bits;
+   /* Packed VkComponentMapping from the sampled image view.  Each component
+    * occupies three bits and has already had IDENTITY resolved. */
+   uint32_t image_swizzle;
    uint32_t border[4];
-   uint64_t pad_to_power_2[3];
+   /* Packed VkComponentMapping supplied with the sampler.  Bit 31 indicates
+    * that the mapping was explicit; otherwise image_swizzle is used. */
+   uint32_t sampler_swizzle;
+   uint32_t pad_to_power_2[5];
 };
 
 static_assert(sizeof(struct kk_sampled_image_descriptor) == 64,
               "kk_sampled_image_descriptor has no holes");
 
+#define KK_COMPONENT_SWIZZLE_BITS 3u
+#define KK_COMPONENT_SWIZZLE_MASK ((1u << KK_COMPONENT_SWIZZLE_BITS) - 1u)
+#define KK_COMPONENT_SWIZZLE_EXPLICIT BITFIELD_BIT(31)
+
+static inline uint32_t
+kk_pack_component_mapping(VkComponentMapping mapping)
+{
+   const VkComponentSwizzle components[4] = {
+      mapping.r,
+      mapping.g,
+      mapping.b,
+      mapping.a,
+   };
+   const VkComponentSwizzle identity[4] = {
+      VK_COMPONENT_SWIZZLE_R,
+      VK_COMPONENT_SWIZZLE_G,
+      VK_COMPONENT_SWIZZLE_B,
+      VK_COMPONENT_SWIZZLE_A,
+   };
+   uint32_t packed = 0;
+
+   for (unsigned i = 0; i < ARRAY_SIZE(components); ++i) {
+      VkComponentSwizzle component = components[i];
+      if (component == VK_COMPONENT_SWIZZLE_IDENTITY)
+         component = identity[i];
+
+      assert(component <= VK_COMPONENT_SWIZZLE_A);
+      packed |= component << (i * KK_COMPONENT_SWIZZLE_BITS);
+   }
+
+   return packed;
+}
+
 struct kk_storage_image_descriptor {
    uint64_t image_gpu_resource_id;
 };
diff --git a/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c b/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
index 79ba814a6ab9c639a965c4d0f4dde7920f951d41..2a78510347829bd4e05061187204f7711d1a2fc3 100644
--- a/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
+++ b/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
@@ -550,6 +550,56 @@ lower_tex(nir_builder *b, nir_tex_instr *tex,
       nir_alu_type T = nir_alu_type_get_base_type(tex->dest_type);
       border = nir_convert_to_bit_size(b, border, T, tex->def.bit_size);
 
+      unsigned sampler_swizzle_offs =
+         offsetof(struct kk_sampled_image_descriptor, sampler_swizzle);
+      nir_def *sampler_swizzle = load_resource_deref_desc(
+         b, 1, 32, nir_src_as_deref(nir_src_for_ssa(sampler)),
+         plane_offset_B + sampler_swizzle_offs, ctx);
+
+      unsigned image_swizzle_offs =
+         offsetof(struct kk_sampled_image_descriptor, image_swizzle);
+      nir_def *image_swizzle = load_resource_deref_desc(
+         b, 1, 32, nir_src_as_deref(nir_src_for_ssa(texture)),
+         plane_offset_B + image_swizzle_offs, ctx);
+
+      nir_def *explicit = nir_ine_imm(
+         b, nir_iand_imm(b, sampler_swizzle,
+                         KK_COMPONENT_SWIZZLE_EXPLICIT),
+         0);
+      nir_def *swizzle =
+         nir_bcsel(b, explicit, sampler_swizzle, image_swizzle);
+      nir_def *zero = T == nir_type_float
+                         ? nir_imm_floatN_t(b, 0.0, border->bit_size)
+                         : nir_imm_intN_t(b, 0, border->bit_size);
+      nir_def *one = T == nir_type_float
+                        ? nir_imm_floatN_t(b, 1.0, border->bit_size)
+                        : nir_imm_intN_t(b, 1, border->bit_size);
+      nir_def *components[4];
+
+      for (unsigned i = 0; i < ARRAY_SIZE(components); ++i) {
+         nir_def *component = nir_iand_imm(
+            b, nir_ushr_imm(b, swizzle, i * KK_COMPONENT_SWIZZLE_BITS),
+            KK_COMPONENT_SWIZZLE_MASK);
+         nir_def *value = zero;
+         value = nir_bcsel(
+            b, nir_ieq_imm(b, component, VK_COMPONENT_SWIZZLE_ONE), one,
+            value);
+         value = nir_bcsel(
+            b, nir_ieq_imm(b, component, VK_COMPONENT_SWIZZLE_R),
+            nir_channel(b, border, 0), value);
+         value = nir_bcsel(
+            b, nir_ieq_imm(b, component, VK_COMPONENT_SWIZZLE_G),
+            nir_channel(b, border, 1), value);
+         value = nir_bcsel(
+            b, nir_ieq_imm(b, component, VK_COMPONENT_SWIZZLE_B),
+            nir_channel(b, border, 2), value);
+         value = nir_bcsel(
+            b, nir_ieq_imm(b, component, VK_COMPONENT_SWIZZLE_A),
+            nir_channel(b, border, 3), value);
+         components[i] = value;
+      }
+      border = nir_vec(b, components, ARRAY_SIZE(components));
+
       nir_def_replace(&tex->def, border);
       return true;
    }
