 src/kosmickrisp/bridge/mtl_command_buffer.m   |  8 +-
 src/kosmickrisp/bridge/mtl_encoder.m          |  4 +-
 .../bridge/stubs/mtl_command_buffer.c         |  4 +-
 src/kosmickrisp/vulkan/kk_cmd_buffer.c        | 73 +++++++++++++++++--
 src/kosmickrisp/vulkan/kk_cmd_buffer.h        | 22 +++++-
 src/kosmickrisp/vulkan/kk_query_pool.c        | 68 +++++++++--------
 src/kosmickrisp/vulkan/kk_query_pool.h        |  8 --
 8 files changed, 138 insertions(+), 53 deletions(-)

