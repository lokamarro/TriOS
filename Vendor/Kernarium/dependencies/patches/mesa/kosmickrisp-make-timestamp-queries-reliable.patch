 void mtl_command_resolve_counter_heap(mtl_command_buffer *command_buffer,
                                       mtl_counter_heap *heap,
                                       uint32_t first_index, uint32_t count,
-                                      uint64_t dst_addr);
+                                      uint64_t dst_addr,
+                                      mtl_fence *wait_fence,
+                                      mtl_fence *update_fence);
 
 #endif /* MTL_COMMAND_BUFFER_H */
diff --git a/src/kosmickrisp/bridge/mtl_command_buffer.m b/src/kosmickrisp/bridge/mtl_command_buffer.m
index 9f0edc5d9c8ee06791f9a5caf4f33b25d178110f..334c218016d7b4a68836f27d417f2410666b84ff 100644
--- a/src/kosmickrisp/bridge/mtl_command_buffer.m
+++ b/src/kosmickrisp/bridge/mtl_command_buffer.m
@@ -43,7 +43,9 @@
 void
 mtl_command_resolve_counter_heap(mtl_command_buffer *command_buffer,
                                  mtl_counter_heap *heap, uint32_t first_index,
-                                 uint32_t count, uint64_t dst_addr)
+                                 uint32_t count, uint64_t dst_addr,
+                                 mtl_fence *wait_fence,
+                                 mtl_fence *update_fence)
 {
    @autoreleasepool {
       id<MTL4CommandBuffer> cmd_buf = (id<MTL4CommandBuffer>)command_buffer;
@@ -55,7 +57,7 @@
       [cmd_buf resolveCounterHeap:h
                         withRange:NSMakeRange(first_index, count)
                        intoBuffer:range
-                        waitFence:nil
-                      updateFence:nil];
+                        waitFence:(id<MTLFence>)wait_fence
+                      updateFence:(id<MTLFence>)update_fence];
    }
 }
diff --git a/src/kosmickrisp/bridge/mtl_encoder.m b/src/kosmickrisp/bridge/mtl_encoder.m
index 433cced84277902b9b899f564fd3b842382b8a97..a1942ff809fcb1002237236ede4e17aec91f5238 100644
--- a/src/kosmickrisp/bridge/mtl_encoder.m
