 void
+st_report_upload_failure(struct st_context *st)
+{
+   /* The driver had no memory for the upload a state update needed. Nothing
+    * is lost but the draw: the state stays dirty for the next one to retry.
+    */
+   _mesa_error(st->ctx, GL_OUT_OF_MEMORY, "no memory for the draw's uploads");
+}
