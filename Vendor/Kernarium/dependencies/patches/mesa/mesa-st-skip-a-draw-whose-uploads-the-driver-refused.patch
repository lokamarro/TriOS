+static unsigned
+st_constants_atom(mesa_shader_stage stage)
+{
+   switch (stage) {
+   case MESA_SHADER_VERTEX:
+      return ST_NEW_VS_CONSTANTS;
+   case MESA_SHADER_TESS_CTRL:
+      return ST_NEW_TCS_CONSTANTS;
+   case MESA_SHADER_TESS_EVAL:
+      return ST_NEW_TES_CONSTANTS;
+   case MESA_SHADER_GEOMETRY:
+      return ST_NEW_GS_CONSTANTS;
+   case MESA_SHADER_FRAGMENT:
+      return ST_NEW_FS_CONSTANTS;
+   case MESA_SHADER_COMPUTE:
+      return ST_NEW_CS_CONSTANTS;
+   case MESA_SHADER_TASK:
+      return ST_NEW_TS_CONSTANTS;
+   default:
+      assert(stage == MESA_SHADER_MESH);
+      return ST_NEW_MS_CONSTANTS;
+   }
+}
