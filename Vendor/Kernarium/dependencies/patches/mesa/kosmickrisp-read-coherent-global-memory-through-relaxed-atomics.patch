diff --git a/src/kosmickrisp/vulkan/tests/test_msl_coherent_access.c b/src/kosmickrisp/vulkan/tests/test_msl_coherent_access.c
new file mode 100644
index 0000000000000000000000000000000000000000..5942563dda3eef69a4ff18a915429155e6c9ddd8
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_msl_coherent_access.c
@@ -0,0 +1,147 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* A coherent global access must reach Metal as a relaxed atomic rather than a
+ * `coherent device` pointer dereference, which the Metal compiler folds away
+ * once a kernel contains more than one of them.  See KK_WORKAROUND_17.
+ *
+ * Only a shader that actually asks for coherency may gain the helpers: the
+ * miscompilation this avoids is sensitive to unrelated changes in the emitted
+ * text, so every other shader has to translate byte for byte as before.
+ */
+
+#include "compiler/glsl_types.h"
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+#include "kosmickrisp/compiler/nir_to_msl.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(condition)                                                     \
+   do {                                                                      \
+      if (!(condition)) {                                                    \
+         fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__,    \
+                 #condition);                                                \
+         abort();                                                            \
+      }                                                                      \
+   } while (0)
+
+/* A kernel that copies four 32-bit components through global memory inside a
+ * loop, which is the shape the robustness lowering produces for a vec4 read of
+ * a storage buffer. */
+static nir_shader *
+build_copy_cs(enum gl_access_qualifier access)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_COMPUTE, &kk_nir_options, "msl coherent access");
+   nir_shader *nir = b.shader;
+   nir->info.workgroup_size[0] = 1;
+   nir->info.workgroup_size[1] = 1;
+   nir->info.workgroup_size[2] = 1;
+
+   nir_variable *index =
+      nir_local_variable_create(b.impl, glsl_uint_type(), "index");
+   nir_store_var(&b, index, nir_imm_int(&b, 0), 0x1);
+
+   nir_def *source = nir_load_global_invocation_id(&b, 64);
+   nir_def *base = nir_channel(&b, source, 0);
+
+   nir_push_loop(&b);
+   {
+      nir_def *i = nir_load_var(&b, index);
+      nir_push_if(&b, nir_uge_imm(&b, i, 4));
+      {
+         nir_jump(&b, nir_jump_break);
+      }
+      nir_pop_if(&b, NULL);
+
+      nir_def *offset = nir_u2u64(&b, nir_imul_imm(&b, i, 16));
+      nir_def *from = nir_iadd(&b, base, offset);
+      nir_def *value = nir_load_global(&b, 4, 32, from, .align_mul = 4,
+                                       .access = access);
+      nir_def *to = nir_iadd_imm(&b, from, 4096);
+      nir_store_global(&b, value, to, .write_mask = 0xf, .align_mul = 4,
+                       .access = access);
+
+      nir_store_var(&b, index, nir_iadd_imm(&b, i, 1), 0x1);
+   }
+   nir_pop_loop(&b, NULL);
+
+   nir_validate_shader(nir, "msl coherent access");
+   return nir;
+}
+
+static char *
+translate(enum gl_access_qualifier access, uint64_t disabled_workarounds)
+{
+   nir_shader *nir = build_copy_cs(access);
+   msl_optimize_nir(nir);
+   nir_shader_gather_info(nir, nir_shader_get_entrypoint(nir));
+
+   struct nir_to_msl_options options = {
+      .disabled_workarounds = disabled_workarounds,
+   };
+   char *msl = nir_to_msl(nir, &options);
+   CHECK(msl != NULL);
+   ralloc_free(nir);
+   return msl;
+}
+
+static unsigned
+count(const char *text, const char *needle)
+{
+   unsigned found = 0;
+   for (const char *at = strstr(text, needle); at != NULL;
+        at = strstr(at + 1, needle))
+      found++;
+   return found;
+}
+
+int
+main(void)
+{
+   glsl_type_singleton_init_or_ref();
+
+   /* A coherent access becomes one relaxed atomic per component and the
+    * kernel keeps no coherent pointer at all. */
+   char *coherent = translate(ACCESS_COHERENT, 0);
+   CHECK(count(coherent, "coherent device") == 0);
+   CHECK(count(coherent, "kk_coherent_load_32(") == 5);
+   CHECK(count(coherent, "kk_coherent_store_32(") == 5);
+   CHECK(count(coherent, "atomic_load_explicit") == 1);
+   CHECK(count(coherent, "atomic_store_explicit") == 1);
+
+   /* An access the shader did not ask to be coherent is translated as before:
+    * KK_WORKAROUND_6 still marks it through the pointer because it is inside a
+    * loop, and the helpers are not even declared. */
+   char *workaround_6 = translate(0, 0);
+   CHECK(count(workaround_6, "kk_coherent_load_32") == 0);
+   CHECK(count(workaround_6, "kk_coherent_store_32") == 0);
+   CHECK(count(workaround_6, "coherent device") == 2);
+
+   /* Without that marking the same shader keeps plain device accesses. */
+   char *plain = translate(0, BITFIELD64_BIT(6));
+   CHECK(count(plain, "kk_coherent_load_32") == 0);
+   CHECK(count(plain, "kk_coherent_store_32") == 0);
+   CHECK(count(plain, "coherent device") == 0);
+   CHECK(count(plain, "*(device packed_uint4*)") > 0);
+
+   /* Disabling this workaround restores the pointer qualifier. */
+   char *disabled = translate(ACCESS_COHERENT, BITFIELD64_BIT(17));
+   CHECK(count(disabled, "kk_coherent_load_32") == 0);
+   CHECK(count(disabled, "kk_coherent_store_32") == 0);
+   CHECK(count(disabled, "coherent device") == 2);
+
+   printf("msl coherent access PASS\n");
+
+   ralloc_free(coherent);
+   ralloc_free(workaround_6);
+   ralloc_free(plain);
+   ralloc_free(disabled);
+   glsl_type_singleton_decref();
+   return 0;
+}
