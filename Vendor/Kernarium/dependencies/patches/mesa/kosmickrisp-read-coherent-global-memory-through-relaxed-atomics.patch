+/* KK_WORKAROUND_17 */
+static bool
+msl_coherent_scalar_is_atomic(const char *scalar_type)
+{
+   return strcmp(scalar_type, "uint") == 0 || strcmp(scalar_type, "int") == 0 ||
+          strcmp(scalar_type, "float") == 0;
+}
+
+/* KK_WORKAROUND_17 */
+static bool
+msl_coherent_access_is_atomic(uint64_t disabled_workarounds,
+                              struct hash_table *types,
+                              nir_intrinsic_instr *instr)
+{
+   if (disabled_workarounds & BITFIELD64_BIT(17))
+      return false;
+   if (!nir_intrinsic_has_access(instr))
+      return false;
+
+   const enum gl_access_qualifier access = nir_intrinsic_access(instr);
+   if (!(access & ACCESS_COHERENT) || (access & ACCESS_ATOMIC))
+      return false;
+
+   switch (instr->intrinsic) {
+   case nir_intrinsic_load_global:
+      return instr->def.bit_size == 32 &&
+             msl_coherent_scalar_is_atomic(
+                msl_scalar_type_for_def(types, &instr->def));
+   case nir_intrinsic_store_global:
+      return instr->src[0].ssa->bit_size == 32 &&
+             msl_coherent_scalar_is_atomic(
+                msl_scalar_type_for_src(types, &instr->src[0]));
+   default:
+      return false;
+   }
+}
+
+/* KK_WORKAROUND_17 */
+static bool
+msl_shader_has_atomic_coherent_access(struct nir_to_msl_ctx *ctx)
+{
+   nir_foreach_function_impl(impl, ctx->shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            if (msl_coherent_access_is_atomic(ctx->disabled_workarounds,
+                                              ctx->types,
+                                              nir_instr_as_intrinsic(instr)))
+               return true;
+         }
+      }
+   }
+
+   return false;
+}
+
+/* KK_WORKAROUND_17 */
+static void
+emit_coherent_access_helpers(struct nir_to_msl_ctx *ctx)
+{
+   P(ctx,
+     "static inline uint kk_coherent_load_32(ulong address)\n"
+     "{\n"
+     "   return atomic_load_explicit((device atomic_uint *)address,\n"
+     "                               memory_order_relaxed);\n"
+     "}\n"
+     "\n"
+     "static inline void kk_coherent_store_32(ulong address, uint value)\n"
+     "{\n"
+     "   atomic_store_explicit((device atomic_uint *)address, value,\n"
+     "                         memory_order_relaxed);\n"
+     "}\n"
+     "\n");
+}
+
 static void
 emit_local_vars(struct nir_to_msl_ctx *ctx, nir_shader *shader)
 {
@@ -1050,6 +1126,61 @@ src_to_packed_load_offset(struct nir_to_msl_ctx *ctx, nir_src *src,
    P(ctx, "))");
 }
 
+/* KK_WORKAROUND_17 */
+static void
+src_to_coherent_load(struct nir_to_msl_ctx *ctx, nir_src *src,
+                     const char *scalar_type, const char *type,
+                     uint32_t component_count)
+{
+   const bool cast = strcmp(scalar_type, "uint") != 0;
+
+   if (component_count > 1)
+      P(ctx, "%s(", type);
+   for (uint32_t i = 0; i < component_count; i++) {
+      if (i > 0)
+         P(ctx, ", ");
+      if (cast)
+         P(ctx, "as_type<%s>(", scalar_type);
+      P(ctx, "kk_coherent_load_32(");
+      src_to_msl(ctx, src);
+      if (i > 0)
+         P(ctx, " + %uu", i * 4u);
+      P(ctx, ")");
+      if (cast)
+         P(ctx, ")");
+   }
+   if (component_count > 1)
+      P(ctx, ")");
+}
+
+/* KK_WORKAROUND_17 */
+static void
+src_to_coherent_store(struct nir_to_msl_ctx *ctx, nir_src *address,
+                      nir_src *value, const char *scalar_type,
+                      unsigned write_mask, uint32_t component_count)
+{
+   const bool cast = strcmp(scalar_type, "uint") != 0;
+
+   for (uint32_t i = 0; i < component_count; i++) {
+      if (!(write_mask & (1u << i)))
+         continue;
+
+      P_IND(ctx, "kk_coherent_store_32(");
+      src_to_msl(ctx, address);
+      if (i > 0)
+         P(ctx, " + %uu", i * 4u);
+      P(ctx, ", ");
+      if (cast)
+         P(ctx, "as_type<uint>(");
+      src_to_msl(ctx, value);
+      if (component_count > 1)
+         P(ctx, ".%c", "xyzw"[i]);
+      if (cast)
+         P(ctx, ")");
+      P(ctx, ");\n");
+   }
+}
