From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 3 Sep 2026 15:51:18 +0900
Subject: [PATCH] kosmickrisp: reject unusable image memory

---
 src/kosmickrisp/vulkan/kk_image.c | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/src/kosmickrisp/vulkan/kk_image.c b/src/kosmickrisp/vulkan/kk_image.c
index 5f9b7877ddf7571e8b4ba56054aee84aab0e66f8..5b4dd8f4ace41a608daece1a4d2f7cc564ae9867 100644
--- a/src/kosmickrisp/vulkan/kk_image.c
+++ b/src/kosmickrisp/vulkan/kk_image.c
@@ -855,12 +855,21 @@ kk_image_plane_bind(struct kk_device *dev, struct kk_image *image,
                                &plane_align_B);
    *offset_B = align64(*offset_B, plane_align_B);
 
-   assert(plane->layout.linear || mem->bo->mtl_handle);
+   if (!plane->layout.linear && !mem->bo->mtl_handle) {
+      return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                       "optimal image memory has no Metal heap");
+   }
 
    /* Linear textures in Metal need to be allocated through a buffer... */
    plane->mem = mem;
    plane->mem_offset_B = *offset_B;
    plane->mtl_handle = kk_image_plane_create_texture(plane, &plane->layout, 0u);
+   if (!plane->mtl_handle) {
+      plane->mem = NULL;
+      plane->mem_offset_B = 0;
+      return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                       "Metal refused the image texture");
+   }
    plane->addr = mem->bo->gpu + *offset_B;
 
    /* Create auxiliary 2D array texture for 3D images so we can use 2D views of
@@ -875,6 +884,15 @@ kk_image_plane_bind(struct kk_device *dev, struct kk_image *image,
       array_layout.depth_px = 1u;
       plane->mtl_handle_array = mtl_new_texture_with_descriptor(
          mem->bo->mtl_handle, &array_layout, *offset_B);
+      if (!plane->mtl_handle_array) {
+         mtl_release(plane->mtl_handle);
+         plane->mtl_handle = NULL;
+         plane->mem = NULL;
+         plane->mem_offset_B = 0;
+         plane->addr = 0;
+         return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                          "Metal refused the auxiliary image texture");
+      }
    }
 
    *offset_B += plane_size_B;
