@@ -306,4 +320,25 @@ if with_tests
     ),
     suite : ['kosmickrisp'],
   )
+
+  test(
+    'kosmickrisp_rgb32_texel_lowering',
+    executable(
+      'test_kosmickrisp_rgb32_texel_lowering',
+      files(
+        'tests/test_rgb32_texel_lowering.c',
+        'kk_nir_lower_descriptors.c',
+      ),
+      include_directories : kk_test_include_directories,
+      dependencies : [
+        idep_nir,
+        idep_vulkan_runtime_headers,
+        idep_vulkan_util_headers,
+        idep_vulkan_wsi_headers,
