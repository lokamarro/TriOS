 static VkResult
-kk_compile_graphics_pipeline(struct kk_device *device, struct kk_shader *vs)
+kk_compile_graphics_pipeline(struct kk_device *device, struct kk_shader *vs,
+                             bool speculative)
 {
    VkResult result = VK_SUCCESS;
    struct kk_pipeline_handles *pipe = &vs->pipeline;
@@ -4577,7 +4718,7 @@ kk_compile_graphics_pipeline(struct kk_device *device, struct kk_shader *vs)
 
