@@ -4663,9 +4805,200 @@ kk_shader_render_pipeline(struct kk_device *dev, struct kk_shader *vs,
    return state;
 }
 
+static VkResult
+kk_compile_shaders_single(struct vk_device *device, uint32_t shader_count,
+                          struct vk_shader_compile_info *infos,
+                          const struct vk_graphics_pipeline_state *state,
+                          const struct vk_features *enabled_features,
+                          const VkAllocationCallbacks *pAllocator,
+                          struct vk_shader **shaders_out, bool byte_strides,
+                          bool pipeline_statistics, bool fast_link,
+                          bool precompile_only);
+
+/* The substates a graphics pipeline library does not own yet.  Each is filled
+ * with the value that selects Metal's state-independent path - Metal's own
+ * vertex fetch, its fixed-function blend, no raster emulation, no multiview and
+ * one sample - because that is the shape whose MSL does not depend on the
+ * missing state.  A link whose real state agrees regenerates exactly the MSL
+ * precompiled here and reuses Metal's compile; a link that disagrees produces
+ * different MSL, misses the cache and compiles the stage itself.  So nothing
+ * here has to be conservative: a wrong guess costs a precompile, never
+ * correctness.
+ */
+struct kk_precompile_state {
+   struct vk_graphics_pipeline_state state;
+   struct vk_vertex_input_state vi;
+   struct vk_input_assembly_state ia;
+   struct vk_rasterization_state rs;
+   struct vk_multisample_state ms;
+   struct vk_color_blend_state cb;
+   struct vk_multiview_state mv;
+   struct vk_render_pass_state rp;
+};
+
+static void
+kk_precompile_state_init(struct kk_precompile_state *out,
+                         const struct vk_graphics_pipeline_state *state,
+                         uint32_t attribs_read)
+{
+   memset(out, 0, sizeof(*out));
+   if (state != NULL)
+      out->state = *state;
+
+   if (out->state.vi == NULL) {
+      /* One tightly packed four-component float per attribute the shader
+       * reads.  Any Metal-expressible layout generates the same MSL: Metal
+       * converts the fetched format to the type the shader declared, so only
+       * the choice of Metal's fetch over the lowered one is visible here. */
+      u_foreach_bit(location, attribs_read) {
+         out->vi.attributes_valid |= BITFIELD_BIT(location);
+         out->vi.attributes[location].binding = location;
+         out->vi.attributes[location].format = VK_FORMAT_R32G32B32A32_SFLOAT;
+         out->vi.bindings_valid |= BITFIELD_BIT(location);
+         out->vi.bindings[location].stride = 16u;
+         out->vi.bindings[location].input_rate = VK_VERTEX_INPUT_RATE_VERTEX;
+         out->vi.bindings[location].divisor = 1u;
+      }
+      out->state.vi = &out->vi;
+   }
+
+   if (out->state.ia == NULL) {
+      out->ia.primitive_topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+      out->state.ia = &out->ia;
+   }
+
+   if (out->state.rs == NULL) {
+      out->rs.polygon_mode = VK_POLYGON_MODE_FILL;
+      out->rs.provoking_vertex = VK_PROVOKING_VERTEX_MODE_FIRST_VERTEX_EXT;
+      out->rs.line.mode = VK_LINE_RASTERIZATION_MODE_DEFAULT_KHR;
+      out->rs.line.width = 1.0f;
+      out->state.rs = &out->rs;
+   }
+
+   if (out->state.ms == NULL) {
+      out->ms.rasterization_samples = 1u;
+      out->ms.sample_mask = 0xffffu;
+      out->state.ms = &out->ms;
+   }
+
+   if (out->state.cb == NULL) {
+      out->cb.logic_op = VK_LOGIC_OP_COPY;
