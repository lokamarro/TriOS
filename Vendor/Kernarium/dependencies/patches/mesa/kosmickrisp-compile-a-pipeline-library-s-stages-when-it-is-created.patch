+/* Turning MSL text into an MTLLibrary is Metal's front-end compile, and it is
+ * the single most expensive step of building a native graphics pipeline: about
+ * 4 ms for one small stage on an M1 Ultra, against 7 ms for the whole render
+ * pipeline state built from two such libraries.  The result depends on nothing
+ * but the source text, so a graphics pipeline library compiles the stages it
+ * owns when the library is created and keeps the MTLLibrary here; the link that
+ * combines libraries then regenerates the same MSL and finds the compiled
+ * library instead of paying Metal's front end a second time.
+ *
+ * Entries live exactly as long as the objects that registered them.  The key is
+ * the source text's hash, so nothing but identical MSL can ever share an entry.
+ */
+struct kk_msl_library {
+   blake3_hash key;
+   mtl_library *library;
+   uint32_t refcount;
+};
+
+/* A new reference to the library compiled from code, or NULL when no live
+ * owner has registered one.  The caller releases it like any other handle. */
+static mtl_library *
+kk_msl_library_acquire(struct kk_device *dev, const char *code)
+{
+   if (dev->msl_libraries == NULL || code == NULL)
+      return NULL;
+
+   blake3_hash key;
+   _mesa_blake3_compute(code, strlen(code), key);
+
+   simple_mtx_lock(&dev->msl_libraries_lock);
+   struct hash_entry *entry = _mesa_hash_table_search(dev->msl_libraries, key);
+   mtl_library *library = NULL;
+   if (entry != NULL) {
+      struct kk_msl_library *cached = entry->data;
+      library = mtl_retain(cached->library);
+   }
+   simple_mtx_unlock(&dev->msl_libraries_lock);
+
+   return library;
+}
+
+/* Compiles code unless an equal source is already cached, and keeps the result
+ * reachable until the matching kk_msl_library_unregister.  Failure to compile
+ * is not an error here: the link that needs the library reports it. */
+static bool
+kk_msl_library_register(struct kk_device *dev, const char *code,
+                        blake3_hash key_out)
+{
+   memset(key_out, 0, sizeof(blake3_hash));
+   if (dev->msl_libraries == NULL || code == NULL)
+      return false;
+
+   blake3_hash key;
+   _mesa_blake3_compute(code, strlen(code), key);
+
+   simple_mtx_lock(&dev->msl_libraries_lock);
+   struct hash_entry *entry = _mesa_hash_table_search(dev->msl_libraries, key);
+   if (entry != NULL) {
+      struct kk_msl_library *cached = entry->data;
+      cached->refcount++;
+      simple_mtx_unlock(&dev->msl_libraries_lock);
+      memcpy(key_out, key, sizeof(blake3_hash));
+      return true;
+   }
+   simple_mtx_unlock(&dev->msl_libraries_lock);
+
+   /* Metal compiles outside the lock: concurrent pipeline library creation
+    * must not serialize on it. */
+   mtl_library *library =
+      mtl_new_library(dev->mtl_compiler_handle, code, MTL_MATH_MODE_SAFE,
+                      MTL_MATH_FLOATING_POINT_FUNCTIONS_PRECISE);
+   if (library == NULL)
+      return false;
+
+   struct kk_msl_library *cached =
+      vk_zalloc(&dev->vk.alloc, sizeof(*cached), 8,
+                VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (cached == NULL) {
+      mtl_release(library);
+      return false;
+   }
+
+   simple_mtx_lock(&dev->msl_libraries_lock);
+   entry = _mesa_hash_table_search(dev->msl_libraries, key);
+   if (entry != NULL) {
+      /* A concurrent registration won the race for this source. */
+      struct kk_msl_library *winner = entry->data;
+      winner->refcount++;
+      simple_mtx_unlock(&dev->msl_libraries_lock);
+      vk_free(&dev->vk.alloc, cached);
+      mtl_release(library);
+      memcpy(key_out, key, sizeof(blake3_hash));
+      return true;
+   }
+   memcpy(cached->key, key, sizeof(blake3_hash));
+   cached->library = library;
+   cached->refcount = 1;
+   _mesa_hash_table_insert(dev->msl_libraries, cached->key, cached);
+   simple_mtx_unlock(&dev->msl_libraries_lock);
+
+   memcpy(key_out, key, sizeof(blake3_hash));
+   return true;
+}
+
+static void
+kk_msl_library_unregister(struct kk_device *dev, const blake3_hash key)
+{
+   if (dev->msl_libraries == NULL)
+      return;
+
+   simple_mtx_lock(&dev->msl_libraries_lock);
+   struct hash_entry *entry = _mesa_hash_table_search(dev->msl_libraries, key);
+   struct kk_msl_library *cached = entry != NULL ? entry->data : NULL;
+   if (cached != NULL && --cached->refcount == 0)
+      _mesa_hash_table_remove(dev->msl_libraries, entry);
+   else
+      cached = NULL;
+   simple_mtx_unlock(&dev->msl_libraries_lock);
+
+   if (cached != NULL) {
+      mtl_release(cached->library);
+      vk_free(&dev->vk.alloc, cached);
+   }
+}
