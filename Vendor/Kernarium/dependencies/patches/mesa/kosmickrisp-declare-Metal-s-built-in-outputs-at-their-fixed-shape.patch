From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 12 Sep 2026 23:01:21 +0900
Subject: [PATCH] kosmickrisp: declare Metal's built-in outputs at their fixed
 shape

The MSL translator sizes each output struct member from the components
the shader happens to store, but Metal fixes the type of the slots it
owns. A vertex shader that writes only gl_Position.xy is legal GL and
legal SPIR-V, and it produced "float2 position [[position]]", which the
shading language rejects: the library never builds, so the pipeline
never builds, and every draw that needs it is lost. The same reasoning
covers point size, the layer and viewport indices, and the element type
of the clip and cull distance arrays.

Declare those slots at the shape Metal requires and give the clip
coordinate the identity value, so a component no store reaches is (0,0,
0,1) rather than a degenerate zero w. Only the stages whose interface
is varyings are indexed by varying slot: a vertex shader's inputs are
vertex attributes and a fragment shader's outputs are depth, stencil
and colour results, and both number those from zero too.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/kosmickrisp/compiler/msl_iomap.c | 61 ++++++++++++++++++++++++++++
 1 file changed, 61 insertions(+)

diff --git a/src/kosmickrisp/compiler/msl_iomap.c b/src/kosmickrisp/compiler/msl_iomap.c
index 01f8997d145686eb1c30118b0a8c57f0dc8ef847..f0cf216fd0db5b7b7170738d8c0541a72978c787 100644
--- a/src/kosmickrisp/compiler/msl_iomap.c
+++ b/src/kosmickrisp/compiler/msl_iomap.c
@@ -465,6 +465,50 @@ msl_fs_varying_components(nir_shader *shader)
    return components;
 }
 
+/* Metal fixes the type of the built-in slots it owns, while the gather above
+ * only sees what the shader happens to write. A shader that writes two
+ * components of gl_Position is legal GL and legal SPIR-V, but declaring
+ * "float2 position [[position]]" is not legal MSL and the library fails to
+ * compile, so the declared shape of these slots comes from Metal rather than
+ * from the store. The components the shader does not write keep the value
+ * msl_emit_output_var() gives them.
+ */
+static void
+pin_metal_builtin_slot_shapes(struct io_slot_info *slots)
+{
+   static const struct {
+      unsigned location;
+      nir_alu_type type;
+      unsigned num_components;
+   } fixed[] = {
+      {VARYING_SLOT_POS, nir_type_float32, 4u},
+      {VARYING_SLOT_PSIZ, nir_type_float32, 1u},
+      {VARYING_SLOT_LAYER, nir_type_uint32, 1u},
+      {VARYING_SLOT_VIEWPORT, nir_type_uint32, 1u},
+   };
+
+   for (unsigned i = 0u; i < ARRAY_SIZE(fixed); ++i) {
+      struct io_slot_info *slot = &slots[fixed[i].location];
+      if (!slot->num_components)
+         continue;
+      slot->type = fixed[i].type;
+      slot->num_components = fixed[i].num_components;
+   }
+
+   /* The distance slots are emitted one scalar per array element, so their
+    * count is the extent of the array and only the element type is fixed.
+    */
+   static const unsigned distances[] = {
+      VARYING_SLOT_CLIP_DIST0, VARYING_SLOT_CLIP_DIST1,
+      VARYING_SLOT_CULL_DIST0, VARYING_SLOT_CULL_DIST1,
+   };
+   for (unsigned i = 0u; i < ARRAY_SIZE(distances); ++i) {
+      struct io_slot_info *slot = &slots[distances[i]];
+      if (slot->num_components)
+         slot->type = nir_type_float32;
+   }
+}
+
 void
 msl_gather_io_info(struct nir_to_msl_ctx *ctx,
                    struct io_slot_info *info_array_input,
@@ -476,6 +520,17 @@ msl_gather_io_info(struct nir_to_msl_ctx *ctx,
    };
    nir_shader_intrinsics_pass(ctx->shader, msl_nir_gather_io_info,
                               nir_metadata_all, &gather_ctx);
+
+   /* Only index these arrays by varying slot where the stage's interface is
+    * varyings. A vertex shader's inputs are vertex attributes and a fragment
+    * shader's outputs are depth, stencil and colour results, and both number
+    * those from zero as well, so pinning there would retype an unrelated
+    * attribute or render target.
+    */
+   if (ctx->shader->info.stage == MESA_SHADER_FRAGMENT)
+      pin_metal_builtin_slot_shapes(info_array_input);
+   if (ctx->shader->info.stage == MESA_SHADER_VERTEX)
+      pin_metal_builtin_slot_shapes(info_array_output);
 }
 
 /* Generate all the struct definitions needed for shader I/O */
@@ -520,6 +575,12 @@ msl_emit_output_var(struct nir_to_msl_ctx *ctx, nir_shader *shader)
    switch (shader->info.stage) {
    case MESA_SHADER_VERTEX:
       P_IND(ctx, "%s out = {};\n", VERTEX_OUTPUT_TYPE);
+      /* The clip coordinate is four components whatever the shader writes,
+       * and a zero w is degenerate rather than merely undefined, so give the
+       * components no store reaches the identity value instead of zero.
+       */
+      if (shader->info.outputs_written & BITFIELD64_BIT(VARYING_SLOT_POS))
+         P_IND(ctx, "out.position = float4(0.0, 0.0, 0.0, 1.0);\n");
       break;
    case MESA_SHADER_FRAGMENT:
       P_IND(ctx, "%s out = {};\n", FRAGMENT_OUTPUT_TYPE);
