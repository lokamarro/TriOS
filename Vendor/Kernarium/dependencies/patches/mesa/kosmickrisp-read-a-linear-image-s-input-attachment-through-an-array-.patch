diff --git a/src/kosmickrisp/vulkan/tests/test_linear_input_attachment.m b/src/kosmickrisp/vulkan/tests/test_linear_input_attachment.m
new file mode 100644
index 0000000000000000000000000000000000000000..5caaab5ce96053206073d4228a5734fbf4b8667c
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_linear_input_attachment.m
@@ -0,0 +1,376 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Android's swapchain offers VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT on every
+ * surface and Unity creates its swapchain with it. Venus imports each of
+ * those native buffers as a DRM_FORMAT_MOD_LINEAR image, so a modifier image
+ * has to be creatable as an input attachment, and the input attachment has to
+ * read the texels the image holds. Metal makes only a 2D texture of a buffer,
+ * so the image stays 2D and every attachment view carries a 2D array view of
+ * it, which is what an input attachment is read through. */
+#define VK_NO_PROTOTYPES
+#include "kosmickrisp/vulkan/kk_image.h"
+#include "kosmickrisp/vulkan/kk_image_view.h"
+
+#include "drm-uapi/drm_fourcc.h"
+
+#include <Foundation/Foundation.h>
+#include <Metal/Metal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+#define CHECK(x)                                                               \
+   do {                                                                        \
+      if (!(x)) {                                                              \
+         fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x);               \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+#define CHECK_VK(x) CHECK((x) == VK_SUCCESS)
+#define LOAD_I(name)                                                           \
+   PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name);       \
+   CHECK(name)
+#define LOAD_D(name)                                                           \
+   PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name);           \
+   CHECK(name)
+
+enum { WIDTH = 64, HEIGHT = 32 };
+
+/* TRANSFER_SRC | TRANSFER_DST | COLOR_ATTACHMENT | INPUT_ATTACHMENT, the
+ * usage Unity's Android swapchain images are created with. */
+static const VkImageUsageFlags swapchain_usage =
+   VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+   VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT;
+
+static const uint8_t clear_texel[4] = {51, 102, 153, 255};
+
+struct context {
+   VkInstance instance;
+   VkPhysicalDevice physical;
+   VkDevice device;
+   VkQueue queue;
+   VkCommandPool pool;
+   PFN_vkGetDeviceProcAddr get_device_proc;
+   VkPhysicalDeviceMemoryProperties memory;
+};
+
+static uint32_t
+memory_type(const struct context *ctx, uint32_t bits)
+{
+   for (uint32_t i = 0; i < ctx->memory.memoryTypeCount; i++) {
+      if ((bits & (1u << i)) &&
+          (ctx->memory.memoryTypes[i].propertyFlags &
+           VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT))
+         return i;
+   }
+   abort();
+}
+
+static VkResult
+query(const struct context *ctx, VkImageTiling tiling, VkImageUsageFlags usage)
+{
+   VkInstance instance = ctx->instance;
+   LOAD_I(vkGetPhysicalDeviceImageFormatProperties2);
+   const VkPhysicalDeviceImageDrmFormatModifierInfoEXT modifier = {
+      .sType =
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_DRM_FORMAT_MODIFIER_INFO_EXT,
+      .drmFormatModifier = DRM_FORMAT_MOD_LINEAR,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   const VkPhysicalDeviceImageFormatInfo2 info = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2,
+      .pNext = tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT ? &modifier
+                                                                 : NULL,
+      .format = VK_FORMAT_R8G8B8A8_UNORM,
+      .type = VK_IMAGE_TYPE_2D,
+      .tiling = tiling,
+      .usage = usage,
+   };
+   VkImageFormatProperties2 props = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2,
+   };
+   return vkGetPhysicalDeviceImageFormatProperties2(ctx->physical, &info,
+                                                    &props);
+}
+
+static VkImage
+create_image(const struct context *ctx, const void *modifier_info)
+{
+   VkDevice device = ctx->device;
+   PFN_vkGetDeviceProcAddr vkGetDeviceProcAddr = ctx->get_device_proc;
+   LOAD_D(vkCreateImage);
+   const VkImageCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .pNext = modifier_info,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = VK_FORMAT_R8G8B8A8_UNORM,
+      .extent = {WIDTH, HEIGHT, 1},
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+      .usage = swapchain_usage,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+   };
+   VkImage image = VK_NULL_HANDLE;
+   CHECK_VK(vkCreateImage(device, &info, NULL, &image));
+   return image;
+}
+
+/* Clear the image through Vulkan, then read it back through each view's
+ * input attachment texture. */
+static void
+check_image(const struct context *ctx, VkImage image, const char *what)
+{
+   VkDevice device = ctx->device;
+   PFN_vkGetDeviceProcAddr vkGetDeviceProcAddr = ctx->get_device_proc;
+   LOAD_D(vkGetImageMemoryRequirements);
+   LOAD_D(vkAllocateMemory);
+   LOAD_D(vkBindImageMemory);
+   LOAD_D(vkCreateImageView);
+   LOAD_D(vkDestroyImageView);
+   LOAD_D(vkDestroyImage);
+   LOAD_D(vkFreeMemory);
+   LOAD_D(vkAllocateCommandBuffers);
+   LOAD_D(vkFreeCommandBuffers);
+   LOAD_D(vkBeginCommandBuffer);
+   LOAD_D(vkEndCommandBuffer);
+   LOAD_D(vkCmdPipelineBarrier);
+   LOAD_D(vkCmdClearColorImage);
+   LOAD_D(vkQueueSubmit);
+   LOAD_D(vkQueueWaitIdle);
+
+   VkMemoryRequirements req;
+   vkGetImageMemoryRequirements(device, image, &req);
+   const VkMemoryAllocateInfo alloc = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = req.size,
+      .memoryTypeIndex = memory_type(ctx, req.memoryTypeBits),
+   };
+   VkDeviceMemory memory;
+   CHECK_VK(vkAllocateMemory(device, &alloc, NULL, &memory));
+   CHECK_VK(vkBindImageMemory(device, image, memory, 0));
+
+   const struct kk_image *kk_img = kk_image_from_handle(image);
+   id<MTLTexture> base = (id<MTLTexture>)kk_img->planes[0].mtl_handle;
+   CHECK(base != nil);
+   CHECK(base.textureType == MTLTextureType2D);
+   CHECK(base.buffer != nil);
+
+   const VkCommandBufferAllocateInfo cmd_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = ctx->pool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   VkCommandBuffer cmd;
+   CHECK_VK(vkAllocateCommandBuffers(device, &cmd_info, &cmd));
+   const VkCommandBufferBeginInfo begin = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+   };
+   CHECK_VK(vkBeginCommandBuffer(cmd, &begin));
+   const VkImageSubresourceRange range = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0,
+                                          1};
+   const VkImageMemoryBarrier to_dst = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+      .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+      .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = image,
+      .subresourceRange = range,
+   };
+   vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1,
+                        &to_dst);
+   const VkClearColorValue color = {
+      .float32 = {clear_texel[0] / 255.0f, clear_texel[1] / 255.0f,
+                  clear_texel[2] / 255.0f, 1.0f},
+   };
+   vkCmdClearColorImage(cmd, image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                        &color, 1, &range);
+   const VkImageMemoryBarrier to_read = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_INPUT_ATTACHMENT_READ_BIT,
+      .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+      .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = image,
+      .subresourceRange = range,
+   };
+   vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                        VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, NULL, 0,
+                        NULL, 1, &to_read);
+   CHECK_VK(vkEndCommandBuffer(cmd));
+   const VkSubmitInfo submit = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &cmd,
+   };
+   CHECK_VK(vkQueueSubmit(ctx->queue, 1, &submit, VK_NULL_HANDLE));
+   CHECK_VK(vkQueueWaitIdle(ctx->queue));
+   vkFreeCommandBuffers(device, ctx->pool, 1, &cmd);
+
+   /* A 2D view and a one-layer 2D array view both read their input
+    * attachment through a 2D array texture over the image's own buffer. */
+   const VkImageViewType view_types[] = {VK_IMAGE_VIEW_TYPE_2D,
+                                         VK_IMAGE_VIEW_TYPE_2D_ARRAY};
+   for (unsigned i = 0; i < 2u; i++) {
+      const VkImageViewCreateInfo view_info = {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+         .image = image,
+         .viewType = view_types[i],
+         .format = VK_FORMAT_R8G8B8A8_UNORM,
+         .subresourceRange = range,
+      };
+      VkImageView view;
+      CHECK_VK(vkCreateImageView(device, &view_info, NULL, &view));
+      const struct kk_image_view *kk_view = kk_image_view_from_handle(view);
+      id<MTLTexture> input = (id<MTLTexture>)kk_view->planes[0].mtl_handle_input;
+      CHECK(input != nil);
+      CHECK(kk_view->planes[0].input_gpu_resource_id != 0);
+      CHECK(input.textureType == MTLTextureType2DArray);
+      CHECK(input.arrayLength == 1);
+      CHECK(input.parentTexture == base);
+
+      uint8_t texels[HEIGHT][WIDTH][4];
+      memset(texels, 0, sizeof(texels));
+      [input getBytes:texels
+            bytesPerRow:WIDTH * 4
+          bytesPerImage:WIDTH * HEIGHT * 4
+             fromRegion:MTLRegionMake2D(0, 0, WIDTH, HEIGHT)
+            mipmapLevel:0
+                  slice:0];
+      unsigned mismatches = 0;
+      for (unsigned y = 0; y < HEIGHT; y++) {
+         for (unsigned x = 0; x < WIDTH; x++)
+            mismatches += memcmp(texels[y][x], clear_texel, 4) != 0;
+      }
+      printf("%s view type %u: input texture 2D array over the image, "
+             "%u mismatching texels\n",
+             what, (unsigned)view_types[i], mismatches);
+      CHECK(mismatches == 0);
+      vkDestroyImageView(device, view, NULL);
+   }
+
+   vkDestroyImage(device, image, NULL);
+   vkFreeMemory(device, memory, NULL);
+}
+
+int
+main(void)
+{
+   @autoreleasepool {
+      struct context ctx = {0};
+      const VkApplicationInfo app = {
+         .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+         .apiVersion = VK_API_VERSION_1_3,
+      };
+      const VkInstanceCreateInfo instance_info = {
+         .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+         .pApplicationInfo = &app,
+      };
+      VkInstance instance = VK_NULL_HANDLE;
+      LOAD_I(vkCreateInstance);
+      CHECK_VK(vkCreateInstance(&instance_info, NULL, &instance));
+      ctx.instance = instance;
+      LOAD_I(vkEnumeratePhysicalDevices);
+      LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+      LOAD_I(vkCreateDevice);
+      LOAD_I(vkDestroyInstance);
+      LOAD_I(vkGetDeviceProcAddr);
+      uint32_t count = 1;
+      CHECK(vkEnumeratePhysicalDevices(instance, &count, &ctx.physical) >= 0);
+      CHECK(count == 1);
+      vkGetPhysicalDeviceMemoryProperties(ctx.physical, &ctx.memory);
+
+      /* The image format query answers what vkCreateImage accepts: a
+       * modifier image holds the input attachment, plain linear tiling still
+       * does not. */
+      CHECK_VK(query(&ctx, VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+                     swapchain_usage));
+      CHECK(query(&ctx, VK_IMAGE_TILING_LINEAR,
+                  VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT) ==
+            VK_ERROR_FORMAT_NOT_SUPPORTED);
+
+      const float priority = 1.0f;
+      const VkDeviceQueueCreateInfo queue_info = {
+         .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+         .queueFamilyIndex = 0,
+         .queueCount = 1,
+         .pQueuePriorities = &priority,
+      };
+      const char *extensions[] = {VK_EXT_IMAGE_DRM_FORMAT_MODIFIER_EXTENSION_NAME};
+      const VkDeviceCreateInfo device_info = {
+         .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+         .queueCreateInfoCount = 1,
+         .pQueueCreateInfos = &queue_info,
+         .enabledExtensionCount = 1,
+         .ppEnabledExtensionNames = extensions,
+      };
+      VkDevice device = VK_NULL_HANDLE;
+      CHECK_VK(vkCreateDevice(ctx.physical, &device_info, NULL, &device));
+      ctx.device = device;
+      ctx.get_device_proc = vkGetDeviceProcAddr;
+      LOAD_D(vkGetDeviceQueue);
+      LOAD_D(vkCreateCommandPool);
+      LOAD_D(vkDestroyCommandPool);
+      LOAD_D(vkGetImageSubresourceLayout);
+      LOAD_D(vkDestroyImage);
+      LOAD_D(vkDestroyDevice);
+      vkGetDeviceQueue(device, 0, 0, &ctx.queue);
+      const VkCommandPoolCreateInfo pool_info = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+         .queueFamilyIndex = 0,
+      };
+      CHECK_VK(vkCreateCommandPool(device, &pool_info, NULL, &ctx.pool));
+
+      /* Wayland-style: the driver picks from a modifier list. */
+      const uint64_t linear = DRM_FORMAT_MOD_LINEAR;
+      const VkImageDrmFormatModifierListCreateInfoEXT list = {
+         .sType =
+            VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT,
+         .drmFormatModifierCount = 1,
+         .pDrmFormatModifiers = &linear,
+      };
+      VkImage listed = create_image(&ctx, &list);
+
+      /* Android-style: the importer names the layout gralloc gave the
+       * buffer, which is the layout this driver lays out itself. */
+      const VkImageSubresource plane0 = {
+         .aspectMask = VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT,
+      };
+      VkSubresourceLayout layout;
+      vkGetImageSubresourceLayout(device, listed, &plane0, &layout);
+      const VkSubresourceLayout given = {
+         .offset = 0,
+         .rowPitch = layout.rowPitch,
+      };
+      const VkImageDrmFormatModifierExplicitCreateInfoEXT explicit_layout = {
+         .sType =
+            VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT,
+         .drmFormatModifier = DRM_FORMAT_MOD_LINEAR,
+         .drmFormatModifierPlaneCount = 1,
+         .pPlaneLayouts = &given,
+      };
+      VkImage explicit_image = create_image(&ctx, &explicit_layout);
+
+      check_image(&ctx, listed, "modifier list");
+      check_image(&ctx, explicit_image, "explicit layout");
+
+      vkDestroyCommandPool(device, ctx.pool, NULL);
+      vkDestroyDevice(device, NULL);
+      vkDestroyInstance(instance, NULL);
+   }
+   return 0;
+}
