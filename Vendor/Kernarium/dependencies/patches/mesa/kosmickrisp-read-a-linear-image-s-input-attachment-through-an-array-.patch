+/* Android's swapchain offers VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT on every
+ * surface, and Unity asks for it, so an imported native buffer -- always a
+ * modifier image here -- has to hold an input attachment too. Such an image
+ * stays a 2D texture, the only type Metal makes of a buffer, and its input
+ * attachment is read through a 2D array view of it instead. */
+static void
+check_a_modifier_image_can_be_an_input_attachment(void)
+{
+   assert(!kk_linear_layout_refuses_usage(
+      VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+      VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT));
+
+   /* The usage Unity creates its Android swapchain with. */
+   assert(!kk_linear_layout_refuses_usage(
+      VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+      VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+         VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+         VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT));
+
+   assert(!kk_input_attachment_makes_array_texture(
+      VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT));
+   assert(!kk_input_attachment_makes_array_texture(VK_IMAGE_TILING_LINEAR));
+   assert(kk_input_attachment_makes_array_texture(VK_IMAGE_TILING_OPTIMAL));
+}
