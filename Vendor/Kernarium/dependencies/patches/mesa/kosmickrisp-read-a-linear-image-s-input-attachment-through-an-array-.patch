diff --git a/src/kosmickrisp/vulkan/kk_image.c b/src/kosmickrisp/vulkan/kk_image.c
index 72b1f4c24d3a54cddfdc590480a53cc9bc1fbdbe..fc528f1c46a09eb46b9933603782e2f4ff5f1fd7 100644
--- a/src/kosmickrisp/vulkan/kk_image.c
+++ b/src/kosmickrisp/vulkan/kk_image.c
@@ -374,11 +374,10 @@ kk_GetPhysicalDeviceImageFormatProperties2(
    if (linear_layout && pImageFormatInfo->type == VK_IMAGE_TYPE_3D)
       return VK_ERROR_FORMAT_NOT_SUPPORTED;
 
-   /* A linear layout renders, but only as a plain 2D texture: this driver
-    * binds an input attachment as a 2D array, which Metal refuses to make out
-    * of a buffer. kk_linear_layout.h owns which attachment usages survive
-    * that, and a modifier image keeps the colour attachment a swapchain image
-    * is created with. */
+   /* A linear layout renders, but only as a plain 2D texture, and Metal has
+    * no linear depth or stencil texture. kk_linear_layout.h owns which
+    * attachment usages survive that: a modifier image keeps the colour and
+    * input attachment a swapchain image is created with. */
    if (kk_linear_layout_refuses_usage(tiling, pImageFormatInfo->usage))
       return VK_ERROR_FORMAT_NOT_SUPPORTED;
 
diff --git a/src/kosmickrisp/vulkan/kk_image_layout.c b/src/kosmickrisp/vulkan/kk_image_layout.c
index 0e47357795bd7bbfe499f30c19f55ff977afacad..18932806d63262425bbf82c4e4fbd0dc5e6def75 100644
--- a/src/kosmickrisp/vulkan/kk_image_layout.c
+++ b/src/kosmickrisp/vulkan/kk_image_layout.c
@@ -24,9 +24,11 @@ vk_image_to_mtl_texture_type(const struct vk_image *image)
    switch (image->image_type) {
    case VK_IMAGE_TYPE_1D:
    case VK_IMAGE_TYPE_2D:
-      /* We require input attachments to be arrays */
+      /* Input attachments are read as arrays. A linear layout, which Metal
+       * only makes a 2D texture of, is read through a 2D array view. */
       if (array_layers > 1 ||
-          (image->usage & VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT))
+          ((image->usage & VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT) &&
+           kk_input_attachment_makes_array_texture(image->tiling)))
          return samples > 1u ? MTL_TEXTURE_TYPE_2D_ARRAY_MULTISAMPLE
                              : MTL_TEXTURE_TYPE_2D_ARRAY;
       return samples > 1u ? MTL_TEXTURE_TYPE_2D_MULTISAMPLE
@@ -266,9 +268,10 @@ kk_image_layout_init(const struct kk_device *dev, const struct vk_image *image,
 
    /* A linear texture is a texture over a MTLBuffer, and Metal answers any
     * type but MTLTextureType2D for one with an assertion that ends the
-    * process. The image format query already refuses the usages that would
-    * ask for another type; this is what stops a descriptor Metal cannot
-    * represent even when nothing consulted that query. */
+    * process. The image format query already refuses what would ask for
+    * another type, such as more than one layer; this is what stops a
+    * descriptor Metal cannot represent even when nothing consulted that
+    * query. */
    if (layout->linear && !kk_linear_layout_type_is_creatable(layout->type))
       return VK_ERROR_INITIALIZATION_FAILED;
 
diff --git a/src/kosmickrisp/vulkan/kk_image_view.c b/src/kosmickrisp/vulkan/kk_image_view.c
index ed1661f14380b8ffe27ffce5c03ff20f26e58216..682a65f74e339a2e50409a9c6e7f924a5b270070 100644
--- a/src/kosmickrisp/vulkan/kk_image_view.c
+++ b/src/kosmickrisp/vulkan/kk_image_view.c
@@ -232,9 +232,13 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
 
       if (view->vk.usage & (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
                             VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)) {
+         /* A linear layout's own texture is 2D whatever the view, so even a
+          * 2D array view of one needs a 2D array texture to be read as an
+          * input attachment through. */
          bool requires_type_change =
             view_layout.view_type != VK_IMAGE_VIEW_TYPE_3D &&
-            view_layout.view_type != VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+            (view_layout.view_type != VK_IMAGE_VIEW_TYPE_2D_ARRAY ||
+             plane->layout.linear);
          bool requires_format_change = view->vk.format != image->vk.format;
          VkImageViewType original_type = view_layout.view_type;
 
diff --git a/src/kosmickrisp/vulkan/kk_linear_layout.h b/src/kosmickrisp/vulkan/kk_linear_layout.h
index 3e3033f8b37b45eb83f5ea105cdf492cfd04ea46..239139bb548cce76edb35a79b7420a5f0157dcd6 100644
--- a/src/kosmickrisp/vulkan/kk_linear_layout.h
+++ b/src/kosmickrisp/vulkan/kk_linear_layout.h
@@ -18,14 +18,20 @@
  * Such a texture renders: Metal accepts MTLTextureUsageRenderTarget on it,
  * and this driver already asks for one whenever a linear image is a transfer
  * destination. What Metal refuses, by an assertion that ends the process, is
- * a linear texture of any type but MTLTextureType2D -- and this driver binds
- * every input attachment as a 2D array.
+ * a linear texture of any type but MTLTextureType2D.
  *
- * A modifier image is therefore offered as a colour attachment, because a
- * Wayland swapchain image is exactly that and common WSI has no fallback when
- * no modifier can hold one, while plain linear tiling keeps the capabilities
- * it has always had. Both refuse an input attachment, and neither has a
- * depth or stencil texture in Metal at all.
+ * This driver reads every input attachment as a 2D array. An optimal image
+ * that can be one is created as a 2D array texture outright; a linear layout
+ * stays a 2D texture and is read through a 2D array view of it, which Metal
+ * does make of a texture over a buffer. An input attachment therefore goes
+ * wherever a colour attachment goes -- Vulkan requires that of any format
+ * with the colour attachment feature, and Android's swapchain offers both.
+ *
+ * A modifier image is offered as a colour and input attachment, because a
+ * Wayland or Android swapchain image is exactly that and common WSI has no
+ * fallback when no modifier can hold one, while plain linear tiling keeps
+ * the capabilities it has always had. Neither has a depth or stencil texture
+ * in Metal at all.
  */
 static inline bool
 kk_tiling_is_linear_layout(VkImageTiling tiling)
@@ -49,13 +55,20 @@ kk_linear_layout_refuses_usage(VkImageTiling tiling, VkImageUsageFlags usage)
    if (usage & VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)
       return true;
 
-   if (usage & VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT)
-      return true;
-
-   return (usage & VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) &&
+   return (usage & (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                    VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT)) &&
           !kk_linear_layout_renders(tiling);
 }
 
+/* Whether an input attachment makes the image's own texture a 2D array. A
+ * linear layout cannot be one, so its input attachment is read through the
+ * 2D array view every attachment view of it carries instead. */
+static inline bool
+kk_input_attachment_makes_array_texture(VkImageTiling tiling)
+{
+   return !kk_tiling_is_linear_layout(tiling);
+}
+
 /* The one Metal texture type a linear layout can have. A descriptor Metal
  * cannot represent has to become a Vulkan error before it reaches Metal. */
 static inline bool
