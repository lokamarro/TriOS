+                                   VK_DEVICE_ADDRESS_BINDING_TYPE_UNBIND_EXT);
+
    kk_image_finish(dev, image, pAllocator);
    vk_free2(&dev->vk.alloc, pAllocator, image);
 }
@@ -1018,6 +1027,22 @@ kk_image_plane_create_texture(struct kk_image_plane *plane,
                                           mem_offset_B);
 }
 
+/* Each plane is reported when it is bound, so a disjoint image's planes,
+ * bound one call at a time, are each reported once. */
+static void
+kk_image_plane_report_address_binding(struct kk_device *dev,
+                                      const struct kk_image *image,
+                                      const struct kk_image_plane *plane,
+                                      VkDeviceAddressBindingTypeEXT type)
+{
+   if (plane->addr == 0u)
+      return;
+
+   vk_address_binding_report(dev->vk.physical->instance,
+                             &((struct kk_image *)image)->vk.base, plane->addr,
+                             plane->layout.size_B, type);
+}
+
 static VkResult
 kk_image_plane_bind(struct kk_device *dev, struct kk_image *image,
                     struct kk_image_plane *plane, struct kk_device_memory *mem,
@@ -1071,9 +1096,23 @@ kk_image_plane_bind(struct kk_device *dev, struct kk_image *image,
 
    *offset_B += plane_size_B;
 
+   kk_image_plane_report_address_binding(dev, image, plane,
+                                         VK_DEVICE_ADDRESS_BINDING_TYPE_BIND_EXT);
    return VK_SUCCESS;
 }
 
+static void
+kk_image_report_address_binding(struct kk_device *dev,
+                                const struct kk_image *image,
+                                VkDeviceAddressBindingTypeEXT type)
+{
+   /* An image occupies one range per plane, and a disjoint image's planes can
+    * come from different allocations, so each is reported on its own. */
+   for (uint8_t plane = 0u; plane < image->plane_count; ++plane)
+      kk_image_plane_report_address_binding(dev, image, &image->planes[plane],
+                                            type);
+}
+
 static VkResult
 kk_bind_image_memory(struct kk_device *dev, const VkBindImageMemoryInfo *info)
 {
@@ -1107,6 +1146,8 @@ kk_bind_image_memory(struct kk_device *dev, const VkBindImageMemoryInfo *info)
             ? mtl_retain(swapchain_plane->mtl_handle_array)
             : NULL;
       plane->addr = swapchain_plane->addr;
+      kk_image_plane_report_address_binding(
+         dev, image, plane, VK_DEVICE_ADDRESS_BINDING_TYPE_BIND_EXT);
 
       return VK_SUCCESS;
    }
