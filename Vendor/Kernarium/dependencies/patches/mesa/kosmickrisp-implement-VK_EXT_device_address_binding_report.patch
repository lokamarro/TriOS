diff --git a/src/kosmickrisp/vulkan/tests/test_address_binding_planes.c b/src/kosmickrisp/vulkan/tests/test_address_binding_planes.c
new file mode 100644
index 0000000000000000000000000000000000000000..11fa8afe051813bd62fed18c76ba58935a7a20ce
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_address_binding_planes.c
@@ -0,0 +1,245 @@
+/* SPDX-License-Identifier: MIT */
+
+/* VK_EXT_device_address_binding_report lets a tool pair each range the driver
+ * binds with the unbind that releases it.  A disjoint image binds one plane
+ * per VkBindImageMemoryInfo, so each bind must report that plane alone: a
+ * report of the whole image would announce the earlier plane a second time,
+ * and the tool would see more binds than the image's destruction unbinds. */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan_core.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x); abort(); } } while (0)
+#define LOAD_I(name) PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name); CHECK(name)
+#define LOAD_D(name) PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name); CHECK(name)
+
+#define MAX_REPORTS 16u
+
+struct report {
+   uint64_t address;
+   uint64_t size;
+   VkDeviceAddressBindingTypeEXT type;
+};
+
+static struct {
+   uint64_t image;
+   unsigned count;
+   struct report reports[MAX_REPORTS];
+} watched;
+
+static VKAPI_ATTR VkBool32 VKAPI_CALL
+on_message(VkDebugUtilsMessageSeverityFlagBitsEXT severity,
+           VkDebugUtilsMessageTypeFlagsEXT types,
+           const VkDebugUtilsMessengerCallbackDataEXT *data, void *user)
+{
+   (void)severity;
+   (void)user;
+   if (!(types & VK_DEBUG_UTILS_MESSAGE_TYPE_DEVICE_ADDRESS_BINDING_BIT_EXT))
+      return VK_FALSE;
+   if (watched.image == 0u || data->objectCount != 1u ||
+       data->pObjects[0].objectType != VK_OBJECT_TYPE_IMAGE ||
+       data->pObjects[0].objectHandle != watched.image)
+      return VK_FALSE;
+   for (const VkBaseInStructure *next = data->pNext; next; next = next->pNext) {
+      if (next->sType !=
+          VK_STRUCTURE_TYPE_DEVICE_ADDRESS_BINDING_CALLBACK_DATA_EXT)
+         continue;
+      const VkDeviceAddressBindingCallbackDataEXT *binding =
+         (const VkDeviceAddressBindingCallbackDataEXT *)next;
+      CHECK(watched.count < MAX_REPORTS);
+      watched.reports[watched.count++] = (struct report){
+         .address = binding->baseAddress,
+         .size = binding->size,
+         .type = binding->bindingType,
+      };
+   }
+   return VK_FALSE;
+}
+
+static unsigned
+count_reports(VkDeviceAddressBindingTypeEXT type, uint64_t address)
+{
+   unsigned count = 0u;
+   for (unsigned i = 0u; i < watched.count; i++) {
+      if (watched.reports[i].type == type &&
+          (address == 0u || watched.reports[i].address == address))
+         count++;
+   }
+   return count;
+}
+
+int
+main(void)
+{
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+                            .apiVersion = VK_API_VERSION_1_3};
+   const char *instance_extensions[] = {VK_EXT_DEBUG_UTILS_EXTENSION_NAME};
+   VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+      .enabledExtensionCount = 1,
+      .ppEnabledExtensionNames = instance_extensions,
+   };
+   CHECK(vkCreateInstance(&instance_info, NULL, &instance) == VK_SUCCESS);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkCreateDebugUtilsMessengerEXT);
+   LOAD_I(vkDestroyDebugUtilsMessengerEXT);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceFormatProperties);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+
+   VkDebugUtilsMessengerCreateInfoEXT messenger_info = {
+      .sType = VK_STRUCTURE_TYPE_DEBUG_UTILS_MESSENGER_CREATE_INFO_EXT,
+      .messageSeverity = VK_DEBUG_UTILS_MESSAGE_SEVERITY_INFO_BIT_EXT,
+      .messageType = VK_DEBUG_UTILS_MESSAGE_TYPE_DEVICE_ADDRESS_BINDING_BIT_EXT,
+      .pfnUserCallback = on_message,
+   };
+   VkDebugUtilsMessengerEXT messenger = VK_NULL_HANDLE;
+   CHECK(vkCreateDebugUtilsMessengerEXT(instance, &messenger_info, NULL,
+                                        &messenger) == VK_SUCCESS);
+
+   uint32_t count = 1;
+   VkPhysicalDevice physical = VK_NULL_HANDLE;
+   VkResult enumerated =
+      vkEnumeratePhysicalDevices(instance, &count, &physical);
+   CHECK((enumerated == VK_SUCCESS || enumerated == VK_INCOMPLETE) && count);
+
+   const VkFormat format = VK_FORMAT_G8_B8R8_2PLANE_420_UNORM;
+   VkFormatProperties format_properties;
+   vkGetPhysicalDeviceFormatProperties(physical, format, &format_properties);
+   CHECK(format_properties.optimalTilingFeatures &
+         VK_FORMAT_FEATURE_DISJOINT_BIT);
+
+   const float priority = 1.0f;
+   VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   VkPhysicalDeviceAddressBindingReportFeaturesEXT report_features = {
+      .sType =
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ADDRESS_BINDING_REPORT_FEATURES_EXT,
+      .reportAddressBinding = VK_TRUE,
+   };
+   const char *device_extensions[] = {
+      VK_EXT_DEVICE_ADDRESS_BINDING_REPORT_EXTENSION_NAME,
+   };
+   VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .pNext = &report_features,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+      .enabledExtensionCount = 1,
+      .ppEnabledExtensionNames = device_extensions,
+   };
+   VkDevice device = VK_NULL_HANDLE;
+   CHECK(vkCreateDevice(physical, &device_info, NULL, &device) == VK_SUCCESS);
+   LOAD_D(vkDestroyDevice);
+   LOAD_D(vkCreateImage);
+   LOAD_D(vkDestroyImage);
+   LOAD_D(vkGetImageMemoryRequirements2);
+   LOAD_D(vkAllocateMemory);
+   LOAD_D(vkFreeMemory);
+   LOAD_D(vkBindImageMemory2);
+
+   VkImageCreateInfo image_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .flags = VK_IMAGE_CREATE_DISJOINT_BIT,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = format,
+      .extent = {64, 64, 1},
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+   };
+   VkImage image = VK_NULL_HANDLE;
+   CHECK(vkCreateImage(device, &image_info, NULL, &image) == VK_SUCCESS);
+   watched.image = (uint64_t)(uintptr_t)image;
+
+   VkPhysicalDeviceMemoryProperties memory_properties;
+   vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+   const VkImageAspectFlagBits aspects[2] = {VK_IMAGE_ASPECT_PLANE_0_BIT,
+                                             VK_IMAGE_ASPECT_PLANE_1_BIT};
+   VkDeviceMemory memory[2] = {VK_NULL_HANDLE, VK_NULL_HANDLE};
+   uint64_t bound[2] = {0u, 0u};
+   for (unsigned plane = 0u; plane < 2u; plane++) {
+      VkImagePlaneMemoryRequirementsInfo plane_requirements = {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_PLANE_MEMORY_REQUIREMENTS_INFO,
+         .planeAspect = aspects[plane],
+      };
+      VkImageMemoryRequirementsInfo2 requirements_info = {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2,
+         .pNext = &plane_requirements,
+         .image = image,
+      };
+      VkMemoryRequirements2 requirements = {
+         .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2,
+      };
+      vkGetImageMemoryRequirements2(device, &requirements_info, &requirements);
+      uint32_t type = 0u;
+      while (type < memory_properties.memoryTypeCount &&
+             !(requirements.memoryRequirements.memoryTypeBits & (1u << type)))
+         type++;
+      CHECK(type < memory_properties.memoryTypeCount);
+      VkMemoryAllocateInfo allocate_info = {
+         .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+         .allocationSize = requirements.memoryRequirements.size,
+         .memoryTypeIndex = type,
+      };
+      CHECK(vkAllocateMemory(device, &allocate_info, NULL, &memory[plane]) ==
+            VK_SUCCESS);
+
+      /* One plane per bind, as a disjoint image allows. */
+      VkBindImagePlaneMemoryInfo plane_bind = {
+         .sType = VK_STRUCTURE_TYPE_BIND_IMAGE_PLANE_MEMORY_INFO,
+         .planeAspect = aspects[plane],
+      };
+      VkBindImageMemoryInfo bind = {
+         .sType = VK_STRUCTURE_TYPE_BIND_IMAGE_MEMORY_INFO,
+         .pNext = &plane_bind,
+         .image = image,
+         .memory = memory[plane],
+      };
+      const unsigned before = watched.count;
+      CHECK(vkBindImageMemory2(device, 1, &bind) == VK_SUCCESS);
+      fprintf(stderr, "plane %u bind: %u address reports\n", plane,
+              watched.count - before);
+      CHECK(watched.count == before + 1u);
+      CHECK(watched.reports[before].type ==
+            VK_DEVICE_ADDRESS_BINDING_TYPE_BIND_EXT);
+      CHECK(watched.reports[before].address != 0u);
+      CHECK(watched.reports[before].size != 0u);
+      bound[plane] = watched.reports[before].address;
+   }
+   CHECK(bound[0] != bound[1]);
+
+   /* Destruction unbinds exactly the ranges the binds announced. */
+   vkDestroyImage(device, image, NULL);
+   CHECK(count_reports(VK_DEVICE_ADDRESS_BINDING_TYPE_UNBIND_EXT, 0u) == 2u);
+   for (unsigned plane = 0u; plane < 2u; plane++) {
+      CHECK(count_reports(VK_DEVICE_ADDRESS_BINDING_TYPE_BIND_EXT,
+                          bound[plane]) == 1u);
+      CHECK(count_reports(VK_DEVICE_ADDRESS_BINDING_TYPE_UNBIND_EXT,
+                          bound[plane]) == 1u);
+   }
+   watched.image = 0u;
+
+   for (unsigned plane = 0u; plane < 2u; plane++)
+      vkFreeMemory(device, memory[plane], NULL);
+   vkDestroyDevice(device, NULL);
+   vkDestroyDebugUtilsMessengerEXT(instance, messenger, NULL);
+   vkDestroyInstance(instance, NULL);
+   printf("each disjoint plane is reported bound once and unbound once\n");
+   return 0;
+}
