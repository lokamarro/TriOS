+   uint32_t polygon_point_topology;
+   uint32_t polygon_point_provoking_last;
 };
 
 struct kk_attachment {
diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index 14072e3a1b40f33249f5e55ca8b2ec6c9ca0a404..cdb8b61b952a68484a1803cc2462c9d820c635ff 100644
