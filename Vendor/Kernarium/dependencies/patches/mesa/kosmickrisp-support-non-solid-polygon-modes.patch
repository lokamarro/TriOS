+struct kk_polygon_point_output {
+   nir_alu_type type;
+   uint8_t components;
+   uint8_t component_mask;
+};
+
+static bool
+kk_collect_polygon_point_output(nir_builder *b, nir_intrinsic_instr *intr,
+                                void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_store_output)
+      return false;
+
+   assert(nir_src_is_const(intr->src[1]) && "no indirect vertex outputs");
+
+   nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+   unsigned slot = sem.location + nir_src_as_uint(intr->src[1]);
+   struct kk_polygon_point_output *outputs = data;
+   struct kk_polygon_point_output *output = &outputs[slot];
+   nir_alu_type type = nir_intrinsic_src_type(intr);
+
+   if (output->type == nir_type_invalid)
+      output->type = type;
+   else
+      assert(output->type == type);
+
+   unsigned component = nir_intrinsic_component(intr);
+   uint8_t mask = nir_intrinsic_write_mask(intr) << component;
+   output->component_mask |= mask;
+   output->components = MAX2(output->components, util_last_bit(mask));
+   return false;
+}
+
+static nir_def *
+kk_load_polygon_point_per_draw(nir_builder *b, uint32_t offset,
+                               unsigned bit_size)
+{
+   nir_def *per_draw = nir_load_per_draw_ptr_kk(b, 1, 64);
+   nir_def *addr = nir_iadd_imm(b, per_draw, offset);
+   return nir_load_global_constant(b, 1, bit_size, addr,
+                                   .align_mul = bit_size / 8,
+                                   .align_offset = 0);
+}
+
+static nir_def *
+kk_load_polygon_point_output(nir_builder *b, nir_def *vertex_params,
+                             uint64_t outputs, nir_def *vertex,
+                             unsigned location, unsigned component,
+                             unsigned bit_size)
+{
+   nir_def *addr = poly_vertex_output_address(
+      b, vertex_params, nir_imm_int64(b, outputs), vertex,
+      nir_imm_int(b, location));
+   addr = nir_iadd_imm(b, addr, component * sizeof(uint32_t));
+
+   /* Runtime-sized per-vertex records are device data, not uniform constant
+    * blocks. Keep their loads in the device address space through MSL. */
+   return nir_load_global(b, 1, bit_size, addr,
+                          .align_mul = sizeof(uint32_t), .align_offset = 0);
+}
+
+static nir_def *
+kk_polygon_point_is_culled(nir_builder *b, nir_def *positions[3])
+{
+   nir_def *dir = nir_fdot(
+      b,
+      nir_cross4(b, nir_fsub(b, positions[1], positions[0]),
+                 nir_fsub(b, positions[2], positions[0])),
+      nir_imm_vec4(b, 0.0, 0.0, -1.0, 0.0));
+   /* kk_lower_hw_vs flips Y when translating Vulkan clip coordinates to
+    * Metal.  Account for that transform before comparing the primitive's
+    * framebuffer-space winding against VkFrontFace. */
+   nir_def *is_ccw = nir_fge_imm(b, dir, 0.0f);
+
+   nir_def *front_face = kk_load_polygon_point_per_draw(
+      b, offsetof(struct kk_per_draw_data, polygon_point_front_face), 32);
+   nir_def *front_is_ccw =
+      nir_ieq_imm(b, front_face, VK_FRONT_FACE_COUNTER_CLOCKWISE);
+   nir_def *is_front = nir_ieq(b, is_ccw, front_is_ccw);
+
+   nir_def *cull_mode = kk_load_polygon_point_per_draw(
+      b, offsetof(struct kk_per_draw_data, polygon_point_cull_mode), 32);
+   nir_def *cull_front = nir_ine_imm(
+      b, nir_iand_imm(b, cull_mode, VK_CULL_MODE_FRONT_BIT), 0);
+   nir_def *cull_back = nir_ine_imm(
+      b, nir_iand_imm(b, cull_mode, VK_CULL_MODE_BACK_BIT), 0);
+
+   return nir_ior(b, nir_iand(b, is_front, cull_front),
+                  nir_iand(b, nir_inot(b, is_front), cull_back));
+}
