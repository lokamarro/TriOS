 struct kk_vs_key {
    bool is_points;
+   bool polygon_point_emulation;
    struct vk_vertex_input_state vi;
 };
 
+static bool
+kk_vk_prim_is_triangles(VkPrimitiveTopology topology)
+{
+   return u_reduced_prim(vk_topology_to_mesa(topology)) ==
+          MESA_PRIM_TRIANGLES;
+}
+
+static bool
+kk_needs_polygon_point_emulation(
+   const struct vk_graphics_pipeline_state *state)
+{
+   if (state->rs->polygon_mode != VK_POLYGON_MODE_POINT ||
+       !kk_vk_prim_is_triangles(state->ia->primitive_topology))
+      return false;
+
+   return BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_CULL_MODE) ||
+          state->rs->cull_mode != VK_CULL_MODE_NONE;
+}
+
 static void
 kk_populate_vs_key(struct kk_vs_key *key,
                    const struct vk_graphics_pipeline_state *state)
 {
    memset(key, 0, sizeof(*key));
    key->is_points =
-      (state->ia->primitive_topology == VK_PRIMITIVE_TOPOLOGY_POINT_LIST);
+      state->ia->primitive_topology == VK_PRIMITIVE_TOPOLOGY_POINT_LIST ||
+      (state->rs->polygon_mode == VK_POLYGON_MODE_POINT &&
+       kk_vk_prim_is_triangles(state->ia->primitive_topology));
+   key->polygon_point_emulation = kk_needs_polygon_point_emulation(state);
    key->vi = *state->vi;
 }
 
@@ -335,8 +359,12 @@ kk_lower_hw_vs(nir_shader *nir, const struct vk_graphics_pipeline_state *state)
 {
    bool is_point =
