diff --git a/src/kosmickrisp/libkk/kk_geometry.cl b/src/kosmickrisp/libkk/kk_geometry.cl
index b240bf2fb5e52f9e273a8fd1e5fbf8144ecf82bf..8b7d61657f05ecebb1566ac59bd81642ab1a2480 100644
--- a/src/kosmickrisp/libkk/kk_geometry.cl
+++ b/src/kosmickrisp/libkk/kk_geometry.cl
@@ -10,6 +10,45 @@
 #include "poly/geometry.h"
 #include "poly/tessellator.h"
 
+KERNEL(1)
+libkk_polygon_point_setup_indirect(
+   global struct poly_heap *heap, global struct poly_vertex_params *vp,
+   constant uint32_t *in_draw, global uint32_t *out_draw,
+   uint64_t index_buffer, uint32_t index_buffer_range_el,
+   uint32_t index_size_B, uint64_t vertex_outputs, uint32_t mode)
+{
+   uint32_t count = in_draw[0];
+   uint32_t instance_count = in_draw[1];
+   uint32_t output_size =
+      poly_tcs_in_size(count * instance_count, vertex_outputs);
+
+   vp->output_buffer = (uintptr_t)poly_heap_alloc(heap, output_size);
+   vp->outputs = vertex_outputs;
+   vp->verts_per_instance = count;
+
+   /* MTLDispatchThreadsIndirectArguments is threadsPerGrid followed by
+    * threadsPerThreadgroup.  An exact thread grid avoids both padding work and
+    * out-of-range software vertex shader invocations. */
+   vp->grid[0] = count;
+   vp->grid[1] = instance_count;
+   vp->grid[2] = 1;
+   vp->grid[3] = 64;
+   vp->grid[4] = 1;
+   vp->grid[5] = 1;
+
+   if (index_size_B) {
+      uint32_t first_index = in_draw[2];
+      vp->index_buffer = index_buffer + (first_index * index_size_B);
+      vp->index_buffer_range_el =
+         poly_index_buffer_range_el(index_buffer_range_el, first_index);
+   }
+
+   out_draw[0] = u_decomposed_prims_for_vertices(mode, count) * 3;
+   out_draw[1] = instance_count;
+   out_draw[2] = 0;
+   out_draw[3] = in_draw[index_size_B ? 4 : 3];
+}
+
 KERNEL(1024)
 libkk_prefix_sum_tess(global struct poly_tess_params *p)
 {
