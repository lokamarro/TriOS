+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -1228,6 +1228,14 @@ kk_flush_dynamic_state(struct kk_cmd_buffer *cmd)
       }
    }
 
+   if (IS_DIRTY(RS_POLYGON_MODE)) {
+      enum mtl_triangle_fill_mode fill_mode =
+         dyn->rs.polygon_mode == VK_POLYGON_MODE_LINE
+            ? MTL_TRIANGLE_FILL_MODE_LINES
+            : MTL_TRIANGLE_FILL_MODE_FILL;
+      mtl_set_triangle_fill_mode(enc, fill_mode);
+   }
+
    /* We enable raster discard by setting scissor to size (0, 0) */
    if (!(dyn->rs.rasterizer_discard_enable || gfx->is_cull_front_and_back) &&
        (IS_DIRTY(VP_VIEWPORT_COUNT) || IS_DIRTY(VP_VIEWPORTS) ||
@@ -1497,13 +1505,20 @@ mesa_prim_to_mtl_primitive_type(enum mesa_prim prim)
    }
 }
 
+static bool
+is_polygon_primitive(enum mesa_prim prim)
+{
+   return u_reduced_prim(prim) == MESA_PRIM_TRIANGLES;
+}
+
 static uint32_t
 build_per_draw_upload_mask(struct kk_cmd_buffer *cmd)
 {
    uint32_t mask = 0;
 
    struct kk_shader *vertex = cmd->state.shaders[MESA_SHADER_VERTEX];
-   if (vertex && vertex->info.uses_per_draw_data) {
+   if (vertex && (vertex->info.uses_per_draw_data ||
+                  vertex->info.vs.polygon_point_emulation)) {
       mask |= BITFIELD_BIT(MESA_SHADER_VERTEX);
    }
 
@@ -1730,18 +1745,27 @@ upload_base_instance(struct kk_cmd_buffer *cmd, const struct kk_draw_data *data)
  * values not present in Metal such as drawID. */
 static void
 kk_upload_per_draw_data(struct kk_cmd_buffer *cmd, uint32_t upload_mask,
-                        uint32_t draw_id, const struct kk_draw_data *draw)
+                        uint32_t draw_id, const struct kk_draw_data *draw,
+                        enum mesa_prim prim)
 {
    struct kk_graphics_state *gfx = &cmd->state.gfx;
    gfx->per_draw_data.draw_id = draw_id;
 
-   /* Prepare emulation data for tessellation. */
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
    bool tess = upload_mask & BITFIELD_BIT(MESA_SHADER_TESS_EVAL);
-   if (tess) {
+   bool polygon_points = vs && vs->info.vs.polygon_point_emulation;
+
+   /* Prepare the software vertex stage used by tessellation and culled
+    * polygon-point draws. */
+   if (tess || polygon_points) {
       gfx->per_draw_data.index_size = draw->index.el_size_B;
       gfx->per_draw_data.base_vertex_addr = upload_base_vertex(cmd, draw);
       gfx->per_draw_data.base_instance_addr = upload_base_instance(cmd, draw);
       gfx->per_draw_data.vertex_params = kk_upload_vertex_params(cmd, draw);
+   }
+
+   /* Prepare emulation data for tessellation. */
+   if (tess) {
       struct kk_ptr tess_args =
          kk_pool_alloc(cmd, sizeof(struct poly_tess_params), 4);
       gfx->per_draw_data.tess_params = tess_args.gpu;
@@ -1750,6 +1774,17 @@ kk_upload_per_draw_data(struct kk_cmd_buffer *cmd, uint32_t upload_mask,
       }
    }
 
+   if (polygon_points) {
+      const struct vk_dynamic_graphics_state *dyn =
+         &cmd->vk.dynamic_graphics_state;
+      gfx->per_draw_data.polygon_point_cull_mode = dyn->rs.cull_mode;
+      gfx->per_draw_data.polygon_point_front_face = dyn->rs.front_face;
+      gfx->per_draw_data.polygon_point_topology = prim;
+      gfx->per_draw_data.polygon_point_provoking_last =
+         dyn->rs.provoking_vertex ==
+         VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT;
+   }
+
    struct kk_ptr shader_data_gpu =
       kk_pool_upload(cmd, &gfx->per_draw_data, sizeof(gfx->per_draw_data), 8u);
    if (unlikely(!shader_data_gpu.gpu))
@@ -1860,6 +1895,66 @@ kk_launch_tess(struct kk_cmd_buffer *cmd, struct kk_draw_data draw)
    return draw;
 }
 
+static struct kk_draw_data
+kk_launch_polygon_points(struct kk_cmd_buffer *cmd, struct kk_draw_data draw,
+                         enum mesa_prim prim)
+{
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   bool indirect = kk_grid_is_indirect(draw.grid);
+
+   if (indirect) {
+      struct kk_ptr out_draw =
+         kk_pool_alloc(cmd, sizeof(VkDrawIndirectCommand), 4);
+      if (unlikely(!out_draw.gpu))
+         return (struct kk_draw_data){.grid = kk_grid_1d(0)};
+
+      struct libkk_polygon_point_setup_indirect_args args = {
+         .heap = kk_heap(cmd),
+         .vp = gfx->per_draw_data.vertex_params,
+         .in_draw = draw.grid.addr,
+         .out_draw = out_draw.gpu,
+         .index_buffer = draw.index.gpu.addr,
+         .index_buffer_range_el =
+            draw.index.el_size_B
+               ? draw.index.gpu.range / draw.index.el_size_B
+               : 0,
+         .index_size_B = draw.index.el_size_B,
+         .vertex_outputs = vs->info.vs.outputs_written,
+         .mode = prim,
+      };
+
+      libkk_polygon_point_setup_indirect_struct(cmd, kk_grid_1d(1), true,
+                                                args);
+      draw.grid = kk_grid_indirect(out_draw.gpu);
+   }
+
+   mtl_compute_encoder *enc = cs_get_compute(cmd, true);
+   mtl_compute_pipeline_state *pipeline = vs->pipeline.gfx.pre_render[0];
+   struct mtl_size local_size = {64, 1, 1};
+
+   mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH,
+                                    MTL_STAGE_DISPATCH);
+   mtl_compute_set_pipeline_state(enc, pipeline);
+   if (indirect) {
+      uint64_t grid_addr =
+         gfx->per_draw_data.vertex_params +
+         offsetof(struct poly_vertex_params, grid);
+      mtl_dispatch_threads_with_indirect_buffer(enc, grid_addr);
+   } else {
+      kk_dispatch_compute(enc, kk_grid_2d(draw.grid.size.x, draw.grid.size.y),
+                          local_size);
+      draw.grid.size.x =
+         u_decomposed_prims_for_vertices(prim, draw.grid.size.x) * 3;
+   }
+
+   draw.index.gpu = (struct kk_addr_range){0};
+   draw.index.el_size_B = 0;
+   draw.vertex_offset = 0;
+   draw.primitive_type = MTL_PRIMITIVE_TYPE_POINT;
+   return draw;
+}
+
 /* Get modifiable per draw data. */
 static struct kk_draw_data
 build_draw_data(struct kk_cmd_buffer *cmd, struct kk_draw_command *data,
@@ -1912,13 +2007,22 @@ kk_draw(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
       return;
 
    bool tess = cmd->state.shaders[MESA_SHADER_TESS_EVAL];
+   const bool polygon_as_points =
+      cmd->vk.dynamic_graphics_state.rs.polygon_mode == VK_POLYGON_MODE_POINT;
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   const bool emulate_polygon_points =
+      !tess && polygon_as_points && vs->info.vs.polygon_point_emulation;
 
    /* Unroll geometry. Skip draw if we fail. No need to unroll if tessellation
     * is present since it also handles unrolling. */
-   bool requires_unroll = !tess && (data->prim == MESA_PRIM_TRIANGLE_FAN ||
-                                    requires_index_promotion(data) ||
-                                    requires_unroll_robustness(cmd, data) ||
-                                    requires_unroll_restart(cmd, data));
+   bool requires_unroll =
+      !tess &&
+      ((!emulate_polygon_points && data->prim == MESA_PRIM_TRIANGLE_FAN) ||
+       (!emulate_polygon_points && polygon_as_points &&
+        is_polygon_primitive(data->prim) &&
+        data->prim != MESA_PRIM_TRIANGLES) ||
+       requires_index_promotion(data) || requires_unroll_robustness(cmd, data) ||
+       requires_unroll_restart(cmd, data));
    if (requires_unroll && !kk_unroll_geometry(cmd, data))
       return;
 
@@ -1926,10 +2030,19 @@ kk_draw(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
       struct kk_draw_data draw_data = build_draw_data(cmd, data, i);
 
       if (data->upload_mask)
-         kk_upload_per_draw_data(cmd, data->upload_mask, i, &draw_data);
+         kk_upload_per_draw_data(cmd, data->upload_mask, i, &draw_data,
+                                 data->prim);
 
       if (tess)
          draw_data = kk_launch_tess(cmd, draw_data);
+      else if (emulate_polygon_points)
+         draw_data = kk_launch_polygon_points(cmd, draw_data, data->prim);
+
+      const enum mesa_prim raster_prim = tess ? cmd->state.gfx.tess.prim
+                                               : data->prim;
+      if (polygon_as_points && is_polygon_primitive(raster_prim))
+         draw_data.primitive_type = MTL_PRIMITIVE_TYPE_POINT;
+
       kk_dispatch_draw(cmd, draw_data);
    }
 }
