    tex->sampler_dim = nir_intrinsic_image_dim(intr);
 
+   /* The descriptor of a cube storage image holds a 2D array view, which
+    * every access reads through the 2D array type, so its size query does
+    * too. Metal answers a query through a cube type only by chance, and its
+    * shader validation answers zero, which also failed the bounds check of
+    * every atomic. */
+   if (tex->sampler_dim == GLSL_SAMPLER_DIM_CUBE)
+      lower_cube_load_handle_to_2d_array(intr->src[0].ssa);
+
    tex->src[0] =
       nir_tex_src_for_ssa(nir_tex_src_texture_handle, intr->src[0].ssa);
 
