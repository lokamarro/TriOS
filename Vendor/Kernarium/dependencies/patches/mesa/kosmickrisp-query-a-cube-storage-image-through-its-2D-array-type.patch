 }
 
+static void lower_cube_load_handle_to_2d_array(nir_def *handle);
+
 static nir_def *
 txs_for_image(nir_builder *b, nir_intrinsic_instr *intr,
               unsigned num_components, unsigned bit_size, bool query_samples)
@@ -366,6 +368,14 @@ txs_for_image(nir_builder *b, nir_intrinsic_instr *intr,
