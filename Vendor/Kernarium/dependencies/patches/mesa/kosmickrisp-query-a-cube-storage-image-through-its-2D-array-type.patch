--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/validated_cube_storage_shaders/query.comp
@@ -0,0 +1,32 @@
+#version 450
+/* SPDX-License-Identifier: MIT */
+
+/* Atomics and size queries on a cube and a cube map array storage image, the
+ * shape of KHR-GLES31.core.shader_image_load_store.basic-allTargets-atomicCS
+ * and KHR-GLES31.core.texture_cube_map_array.texture_size_compute_sh. */
+layout(local_size_x = 1) in;
+layout(set = 0, binding = 0, r32i) uniform coherent iimageCube cube;
+layout(set = 0, binding = 1, r32i) uniform coherent iimageCubeArray cube_array;
+layout(set = 0, binding = 2, std430) buffer Result {
+   int v[12];
+} result;
+
+void main(void)
+{
+   imageAtomicExchange(cube, ivec3(1, 1, 2), 0);
+   result.v[0] = imageAtomicAdd(cube, ivec3(1, 1, 2), 5);
+   result.v[1] = imageAtomicMin(cube, ivec3(1, 1, 2), 3);
+   result.v[2] = imageAtomicAdd(cube, ivec3(1, 1, 2), 0);
+   imageAtomicExchange(cube_array, ivec3(1, 1, 8), 0);
+   result.v[3] = imageAtomicAdd(cube_array, ivec3(1, 1, 8), 5);
+   result.v[4] = imageAtomicMin(cube_array, ivec3(1, 1, 8), 3);
+   result.v[5] = imageAtomicAdd(cube_array, ivec3(1, 1, 8), 0);
+   ivec2 cube_size = imageSize(cube);
+   ivec3 cube_array_size = imageSize(cube_array);
+   result.v[6] = cube_size.x;
+   result.v[7] = cube_size.y;
+   result.v[8] = cube_array_size.x;
+   result.v[9] = cube_array_size.y;
+   result.v[10] = cube_array_size.z;
+   result.v[11] = 1;
+}
