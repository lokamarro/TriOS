diff --git a/src/kosmickrisp/vulkan/tests/test_validated_cube_storage.cpp b/src/kosmickrisp/vulkan/tests/test_validated_cube_storage.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2ce5d811fe0a90285f83b13c909b8aa5f4918224
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_validated_cube_storage.cpp
@@ -0,0 +1,239 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* A cube storage image is a 2D array view of its image, and a shader has to
+ * read its descriptor through the 2D array type. Read through a cube type,
+ * a size query answers right only by chance, and under Metal's shader
+ * validation it answers zero, which also fails the bounds check in front of
+ * every image atomic: KHR-GLES31.core.shader_image_load_store's atomic cases
+ * and texture_cube_map_array.texture_size_compute_sh failed so. One compute
+ * invocation here runs atomics and size queries on a cube and a cube map
+ * array storage image, and every result must be right. The test runs with
+ * MTL_SHADER_VALIDATION=1.
+ *
+ * usage: test_kosmickrisp_validated_cube_storage */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "kk_test.h"
+
+static const uint32_t query_comp[] =
+#include "validated_cube_storage_shaders/query.comp.h"
+;
+
+int main(int argc, char **argv)
+{
+   (void)argv;
+   require(argc == 1, "unknown argument");
+   if (!getenv("MTL_SHADER_VALIDATION"))
+      std::printf("note: MTL_SHADER_VALIDATION is not set, so a query "
+                  "through the wrong type would still pass\n");
+
+   kk_test_device t;
+   kk_test_create_instance(&t, "validated-cube-storage");
+   VkPhysicalDeviceFeatures features{};
+   features.imageCubeArray = VK_TRUE;
+   kk_test_create_device(&t, nullptr, &features, 0, nullptr);
+   KK_LOAD_DEVICE_FUNCTIONS(t);
+   LOAD_D(vkCreateDescriptorSetLayout);
+   LOAD_D(vkDestroyDescriptorSetLayout);
+   LOAD_D(vkCreateDescriptorPool);
+   LOAD_D(vkDestroyDescriptorPool);
+   LOAD_D(vkAllocateDescriptorSets);
+   LOAD_D(vkUpdateDescriptorSets);
+   LOAD_D(vkCmdBindDescriptorSets);
+   LOAD_D(vkCreateComputePipelines);
+   LOAD_D(vkCmdDispatch);
+
+   const uint32_t words = 12u;
+   VkBuffer result_buffer;
+   VkDeviceMemory result_memory;
+   int32_t *result = nullptr;
+   kk_test_buffer(&t, words * sizeof(int32_t),
+                  VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, KK_TEST_HOST_MEMORY,
+                  &result_buffer, &result_memory,
+                  reinterpret_cast<void **>(&result));
+   for (uint32_t i = 0; i < words; ++i)
+      result[i] = -1;
+
+   /* A cube of 4x4 faces and a cube map array of two such cubes. */
+   const uint32_t layers[2] = {6u, 12u};
+   const VkImageViewType view_types[2] = {VK_IMAGE_VIEW_TYPE_CUBE,
+                                          VK_IMAGE_VIEW_TYPE_CUBE_ARRAY};
+   VkImage images[2];
+   VkDeviceMemory image_memory[2];
+   VkImageView views[2];
+   for (int i = 0; i < 2; ++i) {
+      VkImageCreateInfo info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+      info.flags = VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT;
+      info.imageType = VK_IMAGE_TYPE_2D;
+      info.format = VK_FORMAT_R32_SINT;
+      info.extent = {4, 4, 1};
+      info.mipLevels = 1;
+      info.arrayLayers = layers[i];
+      info.samples = VK_SAMPLE_COUNT_1_BIT;
+      info.usage = VK_IMAGE_USAGE_STORAGE_BIT;
+      VkResult r = vkCreateImage(device, &info, nullptr, &images[i]);
+      require(r == VK_SUCCESS, "create image", r);
+      image_memory[i] = kk_test_image_memory(
+         &t, images[i], VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+      views[i] = kk_test_image_view(&t, images[i], view_types[i],
+                                    VK_FORMAT_R32_SINT,
+                                    VK_IMAGE_ASPECT_COLOR_BIT, 0, layers[i]);
+   }
+
+   VkDescriptorSetLayoutBinding bindings[3]{};
+   for (uint32_t i = 0; i < 3; ++i) {
+      bindings[i].binding = i;
+      bindings[i].descriptorType = i < 2 ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE
+                                         : VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+      bindings[i].descriptorCount = 1;
+      bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+   }
+   VkDescriptorSetLayoutCreateInfo set_layout_info{
+      VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+   set_layout_info.bindingCount = 3;
+   set_layout_info.pBindings = bindings;
+   VkDescriptorSetLayout set_layout;
+   VkResult r = vkCreateDescriptorSetLayout(device, &set_layout_info, nullptr,
+                                            &set_layout);
+   require(r == VK_SUCCESS, "create set layout", r);
+   const VkDescriptorPoolSize pool_sizes[2] = {
+      {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 2},
+      {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1}};
+   VkDescriptorPoolCreateInfo pool_info{
+      VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+   pool_info.maxSets = 1;
+   pool_info.poolSizeCount = 2;
+   pool_info.pPoolSizes = pool_sizes;
+   VkDescriptorPool descriptor_pool;
+   r = vkCreateDescriptorPool(device, &pool_info, nullptr, &descriptor_pool);
+   require(r == VK_SUCCESS, "create descriptor pool", r);
+   VkDescriptorSetAllocateInfo set_info{
+      VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+   set_info.descriptorPool = descriptor_pool;
+   set_info.descriptorSetCount = 1;
+   set_info.pSetLayouts = &set_layout;
+   VkDescriptorSet set;
+   r = vkAllocateDescriptorSets(device, &set_info, &set);
+   require(r == VK_SUCCESS, "allocate descriptor set", r);
+   const VkDescriptorImageInfo image_infos[2] = {
+      {VK_NULL_HANDLE, views[0], VK_IMAGE_LAYOUT_GENERAL},
+      {VK_NULL_HANDLE, views[1], VK_IMAGE_LAYOUT_GENERAL}};
+   const VkDescriptorBufferInfo buffer_info{result_buffer, 0, VK_WHOLE_SIZE};
+   VkWriteDescriptorSet writes[3]{};
+   for (uint32_t i = 0; i < 3; ++i) {
+      writes[i] = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+      writes[i].dstSet = set;
+      writes[i].dstBinding = i;
+      writes[i].descriptorCount = 1;
+      writes[i].descriptorType = bindings[i].descriptorType;
+      if (i < 2)
+         writes[i].pImageInfo = &image_infos[i];
+      else
+         writes[i].pBufferInfo = &buffer_info;
+   }
+   vkUpdateDescriptorSets(device, 3, writes, 0, nullptr);
+
+   VkPipelineLayoutCreateInfo layout_info{
+      VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+   layout_info.setLayoutCount = 1;
+   layout_info.pSetLayouts = &set_layout;
+   VkPipelineLayout layout;
+   r = vkCreatePipelineLayout(device, &layout_info, nullptr, &layout);
+   require(r == VK_SUCCESS, "create layout", r);
+   VkShaderModule module =
+      kk_test_shader_module(&t, query_comp, sizeof(query_comp));
+   VkComputePipelineCreateInfo pipeline_info{
+      VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+   pipeline_info.stage = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};
+   pipeline_info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+   pipeline_info.stage.module = module;
+   pipeline_info.stage.pName = "main";
+   pipeline_info.layout = layout;
+   VkPipeline pipeline;
+   r = vkCreateComputePipelines(device, VK_NULL_HANDLE, 1, &pipeline_info,
+                                nullptr, &pipeline);
+   require(r == VK_SUCCESS, "create pipeline", r);
+
+   VkCommandPool pool;
+   VkCommandBuffer command;
+   kk_test_command_buffer(&t, 0, &pool, &command);
+   VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+   begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+   r = vkBeginCommandBuffer(command, &begin);
+   require(r == VK_SUCCESS, "begin command", r);
+   VkImageMemoryBarrier barriers[2]{};
+   for (int i = 0; i < 2; ++i) {
+      barriers[i] = {VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+      barriers[i].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barriers[i].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barriers[i].oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+      barriers[i].newLayout = VK_IMAGE_LAYOUT_GENERAL;
+      barriers[i].dstAccessMask =
+         VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+      barriers[i].image = images[i];
+      barriers[i].subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0,
+                                      VK_REMAINING_ARRAY_LAYERS};
+   }
+   vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 0, nullptr, 0,
+                        nullptr, 2, barriers);
+   vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+   vkCmdBindDescriptorSets(command, VK_PIPELINE_BIND_POINT_COMPUTE, layout, 0,
+                           1, &set, 0, nullptr);
+   vkCmdDispatch(command, 1, 1, 1);
+   VkMemoryBarrier to_host{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+   to_host.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+   to_host.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+   vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                        VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &to_host, 0, nullptr,
+                        0, nullptr);
+   r = vkEndCommandBuffer(command);
+   require(r == VK_SUCCESS, "end command", r);
+   r = kk_test_submit_and_wait(&t, command, 20ull * 1000 * 1000 * 1000);
+   require(r == VK_SUCCESS, "submit", r);
+
+   /* Each atomic returns what the one before it left: add 5 to 0, min 3
+    * against 5, add 0 to 3. The sizes count whole cubes. */
+   const int32_t expected[12] = {0, 5, 3, 0, 5, 3, 4, 4, 4, 4, 2, 1};
+   const char *const names[12] = {
+      "cube add",          "cube min",         "cube add 0",
+      "cube array add",    "cube array min",   "cube array add 0",
+      "cube width",        "cube height",      "cube array width",
+      "cube array height", "cube array cubes", "end of the shader"};
+   uint32_t wrong = 0;
+   for (uint32_t i = 0; i < words; ++i) {
+      if (result[i] != expected[i]) {
+         std::fprintf(stderr, "%s is %d, not %d\n", names[i], result[i],
+                      expected[i]);
+         ++wrong;
+      }
+   }
+   std::printf("validated cube storage: %u of %u results wrong\n", wrong,
+               words);
+   require(wrong == 0, "every atomic and size query on a cube image");
+
+   vkDestroyCommandPool(device, pool, nullptr);
+   vkDestroyPipeline(device, pipeline, nullptr);
+   vkDestroyShaderModule(device, module, nullptr);
+   vkDestroyPipelineLayout(device, layout, nullptr);
+   vkDestroyDescriptorPool(device, descriptor_pool, nullptr);
+   vkDestroyDescriptorSetLayout(device, set_layout, nullptr);
+   for (int i = 0; i < 2; ++i) {
+      vkDestroyImageView(device, views[i], nullptr);
+      vkDestroyImage(device, images[i], nullptr);
+      vkFreeMemory(device, image_memory[i], nullptr);
+   }
+   vkUnmapMemory(device, result_memory);
+   vkDestroyBuffer(device, result_buffer, nullptr);
+   vkFreeMemory(device, result_memory, nullptr);
+   kk_test_destroy(&t);
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/validated_cube_storage_shaders/query.comp b/src/kosmickrisp/vulkan/tests/validated_cube_storage_shaders/query.comp
