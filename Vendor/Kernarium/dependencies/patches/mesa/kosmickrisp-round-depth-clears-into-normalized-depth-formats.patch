From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 12 Sep 2026 02:35:49 +0900
Subject: [PATCH] kosmickrisp: round depth clears into normalized depth formats

Round a render pass clear depth to the attachment's representable value
before handing it to Metal, and offset it into the middle of that texel's
interval.

Metal converts MTLRenderPassDepthAttachmentDescriptor.clearDepth into a
Depth16Unorm attachment by truncating rather than rounding, so a clear
value that names an exact texel loses its last step: clearing a
D16_UNORM image to 1/65535 stores 0, to 2/65535 stores 1, and so on
wherever the float product lands just below the integer. Vulkan defines
the conversion as the nearest representable value, and the rasterizer's
own depth writes already round that way, so the same clear through
vkCmdClearAttachments and through the load action disagreed.

KHR-GL46.clear_tex_image.gl_clear_tex_image_format_GL_DEPTH_COMPONENT_
internalFormat_GL_DEPTH_COMPONENT16_type_GL_UNSIGNED_SHORT_pixelSize_1_
texLevel_4 fills a D16 level with raw 1 and clears it with the same
value, then reads 0 back. Depth formats Metal stores as floats are
unaffected and keep their exact value.
---
 src/kosmickrisp/vulkan/kk_cmd_draw.c | 33 +++++++++++++++++++++++++++-
 1 file changed, 32 insertions(+), 1 deletion(-)

diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index ade9af72b2a3a5b5b1b0a0cda03cee0ce6ca8016..65ae10b92fb28c8464cf5362b5dcc33e4f8619e2 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -25,6 +25,8 @@
 #include "kosmickrisp/libkk/kk_geometry.h"
 #include "kosmickrisp/libkk/kk_tessellator.h"
 
+#include "util/u_math.h"
+
 #include "poly/geometry.h"
 #include "poly/tessellator.h"
 
@@ -192,6 +194,32 @@ vk_clear_color_value_to_mtl_clear_color(union VkClearColorValue color,
    return swizzled_color;
 }
 
+/* Metal converts a render pass clear depth into a normalized-integer depth
+ * attachment by truncating, so a value that names an exact texel, such as the
+ * 1/65535 a D16_UNORM texture round trips, lands one step below it. Vulkan
+ * asks for the nearest representable value instead. Round here and bias the
+ * result into the middle of the target interval so both a truncating and a
+ * rounding conversion reproduce the value the application asked for. Depth
+ * formats Metal stores as floats keep their exact value. */
+static double
+kk_mtl_clear_depth(enum pipe_format format, float depth)
+{
+   const struct util_format_description *description =
+      util_format_description(format);
+   const struct util_format_channel_description *channel =
+      &description->channel[0];
+
+   if (!util_format_has_depth(description) ||
+       channel->type != UTIL_FORMAT_TYPE_UNSIGNED || !channel->normalized ||
+       channel->size == 0u || channel->size >= 32u)
+      return depth;
+
+   const double scale = (double)BITFIELD64_MASK(channel->size);
+   const double texel = floor(CLAMP((double)depth, 0.0, 1.0) * scale + 0.5);
+
+   return MIN2((texel + 0.25) / scale, 1.0);
+}
+
 static void
 kk_set_color_attachments(mtl_render_pass_descriptor *pass_descriptor,
                          struct kk_rendering_state *render,
@@ -258,7 +286,10 @@ kk_set_depth_stencil_attachments(
        * action does not clear the attachment. */
       if (render->depth_att.load_op == VK_ATTACHMENT_LOAD_OP_CLEAR)
          mtl_render_pass_attachment_descriptor_set_clear_depth(
-            depth_descriptor, render->depth_att.clear_value.depthStencil.depth);
+            depth_descriptor,
+            kk_mtl_clear_depth(
+               iview->planes[0].format,
+               render->depth_att.clear_value.depthStencil.depth));
    }
 
    mtl_render_pass_attachment_descriptor *stencil_descriptor =
