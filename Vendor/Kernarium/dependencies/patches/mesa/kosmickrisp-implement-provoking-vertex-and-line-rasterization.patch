+/* Allocate the record buffer for a TES/GS/XFB raster-value producer.  A
+ * second setup kernel runs after that producer and installs the decomposed
+ * line-list index stream without reallocating or copying these records. */
+KERNEL(1)
+libkk_line_materialize_setup_indirect(
+   global struct poly_heap *heap, global struct poly_vertex_params *vp,
+   constant uint32_t *in_draw, uint64_t index_buffer,
+   uint32_t index_buffer_range_el, uint32_t index_size_B,
+   uint64_t vertex_outputs)
+{
+   uint32_t count = in_draw[0];
+   uint32_t instance_count = in_draw[1];
+   uint32_t records, output_slots, output_size;
+   if (!poly_u32_checked_mul(count, instance_count, &records) ||
+       !poly_u32_checked_mul(records, popcount(vertex_outputs),
+                             &output_slots) ||
+       !poly_u32_checked_mul(output_slots, 4u * sizeof(uint32_t),
+                             &output_size) ||
+       !poly_heap_size_can_align(output_size)) {
+      libkk_suppress_line_work(vp, NULL);
+      return;
+   }
+
+   uint32_t output_offs;
+   if (!poly_heap_try_alloc_offs(heap, output_size, &output_offs)) {
+      libkk_suppress_line_work(vp, NULL);
+      return;
+   }
