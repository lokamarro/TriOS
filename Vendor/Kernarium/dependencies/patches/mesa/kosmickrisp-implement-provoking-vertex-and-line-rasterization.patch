+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include "compiler/shader_enums.h"
+#include "poly/geometry.h"
+#include "vk_graphics_state.h"
+
+static inline uint32_t
+kk_line_view_count(uint32_t view_mask)
+{
+   return MAX2(util_bitcount(view_mask), 1u);
+}
+
+/* The pipeline state hash is computed before GS/TES NIR is available.  Keep
+ * raster choices in its identity even when input assembly is not the class
+ * which reaches the rasterizer.  Ignored dynamic create values must not split
+ * otherwise identical cache entries. */
+struct kk_line_raster_key {
+   uint8_t polygon_mode;
+   uint8_t provoking_vertex;
+   uint8_t line_mode;
+   bool dynamic_polygon_mode;
+   bool dynamic_provoking_vertex;
+   bool dynamic_line_mode;
+   bool dynamic_stipple_enable;
+   bool stipple_enable;
+   bool dynamic_topology;
+};
+
+static inline struct kk_line_raster_key
+kk_line_raster_key(const struct vk_graphics_pipeline_state *state)
+{
+   const bool polygon =
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_POLYGON_MODE);
+   const bool provoking =
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_PROVOKING_VERTEX);
+   const bool line =
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_LINE_MODE);
+   const bool stipple =
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_LINE_STIPPLE_ENABLE);
+
+   return (struct kk_line_raster_key){
+      .polygon_mode = polygon ? VK_POLYGON_MODE_FILL : state->rs->polygon_mode,
+      .provoking_vertex = provoking
+                             ? VK_PROVOKING_VERTEX_MODE_FIRST_VERTEX_EXT
+                             : state->rs->provoking_vertex,
+      .line_mode = line ? VK_LINE_RASTERIZATION_MODE_DEFAULT_KHR
+                        : state->rs->line.mode,
+      .dynamic_polygon_mode = polygon,
+      .dynamic_provoking_vertex = provoking,
+      .dynamic_line_mode = line,
+      .dynamic_stipple_enable = stipple,
+      .stipple_enable = !stipple && state->rs->line.stipple.enable,
+      .dynamic_topology =
+         BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_IA_PRIMITIVE_TOPOLOGY),
+   };
+}
+
+static inline uint32_t
+kk_line_raster_sample_count(enum mesa_prim raster_primitive,
+                            VkPolygonMode polygon_mode,
+                            VkLineRasterizationModeKHR line_mode,
+                            uint32_t samples)
+{
+   const enum mesa_prim reduced = u_reduced_prim(raster_primitive);
+   const bool lines = reduced == MESA_PRIM_LINES ||
+                      (reduced == MESA_PRIM_TRIANGLES &&
+                       polygon_mode == VK_POLYGON_MODE_LINE);
+   return lines && line_mode == VK_LINE_RASTERIZATION_MODE_BRESENHAM_KHR &&
+                samples > 1
+             ? samples
+             : 0;
+}
+
+static inline bool
+kk_line_vertex_output_size(uint32_t vertices, uint32_t instances,
+                           uint32_t output_slots, uint32_t *size_B)
+{
+   uint32_t records, components;
+   return poly_u32_checked_mul(vertices, instances, &records) &&
+          poly_u32_checked_mul(records, output_slots, &components) &&
+          poly_u32_checked_mul(components, 4u * sizeof(uint32_t), size_B);
+}
+
+static inline bool
+kk_line_phase_buffer_size(enum mesa_prim topology, uint32_t vertices,
+                          uint32_t instances, uint32_t lines_per_primitive,
+                          uint32_t *size_B)
+{
+   uint32_t lines, phases;
+   uint32_t primitives =
+      poly_decomposed_prims_for_vertices_u32(topology, vertices);
+   return poly_u32_checked_mul(primitives, lines_per_primitive, &lines) &&
+          poly_u32_checked_mul(lines, instances, &phases) &&
+          poly_u32_checked_mul(phases, sizeof(float), size_B);
+}
+
+static inline bool
+kk_line_raster_vertex_count(enum mesa_prim topology, uint32_t vertices,
+                            uint32_t lines_per_primitive,
+                            uint32_t vertices_per_line, uint32_t *count)
+{
+   uint32_t lines;
+   uint32_t primitives =
+      poly_decomposed_prims_for_vertices_u32(topology, vertices);
+   return poly_u32_checked_mul(primitives, lines_per_primitive, &lines) &&
+          poly_u32_checked_mul(lines, vertices_per_line, count);
+}
+
+static inline bool
+kk_line_allocation_succeeded(uint32_t size_B, uint64_t address)
+{
+   return size_B == 0 || address != 0;
+}
+
+static inline bool
+kk_line_raster_needs_materialization(bool tessellation,
+                                     bool geometry_shader,
+                                     bool transform_feedback)
+{
+   return tessellation || geometry_shader || transform_feedback;
+}
+
+static inline bool
+kk_smooth_line_modulates_output(unsigned location, unsigned index,
+                                bool floating_point)
+{
+   /* Smooth-line coverage is a fragment operation on Location 0, Index 0.
+    * It must not alter secondary blend sources, other render targets, or
+    * integer outputs. */
+   return location == FRAG_RESULT_DATA0 && index == 0 && floating_point;
+}
+
+static inline bool
+kk_line_stipple_is_continuous(enum mesa_prim topology,
+                              uint64_t run_starts_addr)
+{
+   return topology == MESA_PRIM_LINE_STRIP || topology == MESA_PRIM_LINE_LOOP ||
+          topology == MESA_PRIM_LINE_STRIP_ADJACENCY || run_starts_addr != 0;
+}
+
+static inline bool
+kk_line_stipple_prefix_required(bool pipeline_has_stipple,
+                                bool stipple_enabled,
+                                enum mesa_prim topology,
+                                uint64_t run_starts_addr)
+{
+   return pipeline_has_stipple && stipple_enabled &&
+          kk_line_stipple_is_continuous(topology, run_starts_addr);
+}
+
+static inline bool
+kk_vk_topology_is_line_class(VkPrimitiveTopology topology)
+{
+   switch (topology) {
+   case VK_PRIMITIVE_TOPOLOGY_LINE_LIST:
+   case VK_PRIMITIVE_TOPOLOGY_LINE_STRIP:
+   case VK_PRIMITIVE_TOPOLOGY_LINE_LIST_WITH_ADJACENCY:
+   case VK_PRIMITIVE_TOPOLOGY_LINE_STRIP_WITH_ADJACENCY:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static inline bool
+kk_vk_topology_is_triangle_class(VkPrimitiveTopology topology)
+{
+   switch (topology) {
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST:
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP:
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN:
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST_WITH_ADJACENCY:
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP_WITH_ADJACENCY:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static inline VkPrimitiveTopology
+kk_vk_topology_class(VkPrimitiveTopology topology)
+{
+   if (kk_vk_topology_is_line_class(topology))
+      return VK_PRIMITIVE_TOPOLOGY_LINE_LIST;
+   if (kk_vk_topology_is_triangle_class(topology))
+      return VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+   return topology;
+}
+
+static inline bool
+kk_line_raster_polygon_edges(const struct vk_graphics_pipeline_state *state)
+{
+   return kk_vk_topology_is_triangle_class(state->ia->primitive_topology) &&
+          state->rs->polygon_mode == VK_POLYGON_MODE_LINE;
+}
+
+static inline bool
