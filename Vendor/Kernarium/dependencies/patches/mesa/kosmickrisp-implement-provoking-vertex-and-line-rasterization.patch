+ */
+
+#include "poly/nir/poly_nir.h"
+
+#include "compiler/nir/nir_builder.h"
+#include "util/ralloc.h"
+
+#include <assert.h>
+#include <stdlib.h>
+
+static void
+check_complete_primitive_passthrough(enum mesa_prim prim)
+{
+   size_t key_size = poly_passthrough_gs_key_size(1);
+   struct poly_passthrough_gs_key *key = calloc(1, key_size);
+   assert(key);
+
+   key->outputs = VARYING_BIT_POS;
+   key->output_types[VARYING_SLOT_POS] = nir_type_float32;
+   key->output_components[VARYING_SLOT_POS] = 4;
+   key->xfb_stride[0] = 4;
+   key->prim = prim;
+   key->xfb_info.buffers_written = 1;
+   key->xfb_info.streams_written = 1;
+   key->xfb_info.buffers[0] = (nir_xfb_buffer_info){
+      .stride = 16,
+      .varying_count = 1,
+   };
+   key->xfb_info.output_count = 1;
+   key->xfb_info.outputs[0] = (nir_xfb_output_info){
+      .buffer = 0,
+      .location = VARYING_SLOT_POS,
+      .component_mask = 0xf,
+   };
+
+   const nir_shader_compiler_options options = {0};
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_GEOMETRY, &options, "complete_primitive_passthrough");
+   poly_nir_passthrough_gs(&b, key);
+
+   nir_shader *count = NULL;
+   nir_shader *raster = NULL;
+   nir_shader *pre_gs = NULL;
+   struct poly_gs_info info = {0};
+   poly_nir_lower_gs(b.shader, &count, &raster, &pre_gs, &info, true);
+
+   assert(count == NULL);
+   assert(!info.prefix_sum);
+   assert(info.count_words == 0);
+   assert(info.shape == POLY_GS_SHAPE_STATIC_PER_INSTANCE);
+   assert(info.mode == u_reduced_prim(prim));
+   assert(info.max_indices == mesa_vertices_per_prim(u_reduced_prim(prim)));
+
+   ralloc_free(raster);
+   ralloc_free(pre_gs);
+   ralloc_free(b.shader);
+   free(key);
+}
+
+int
+main(void)
+{
+   check_complete_primitive_passthrough(MESA_PRIM_POINTS);
+   check_complete_primitive_passthrough(MESA_PRIM_LINES);
+   check_complete_primitive_passthrough(MESA_PRIM_LINES_ADJACENCY);
+   check_complete_primitive_passthrough(MESA_PRIM_TRIANGLES);
+   check_complete_primitive_passthrough(MESA_PRIM_TRIANGLES_ADJACENCY);
+   return 0;
+}
