+       !poly_u32_checked_mul(records, popcount(vertex_outputs),
+                             &output_slots) ||
+       !poly_u32_checked_mul(output_slots, 4u * sizeof(uint32_t),
+                             output_size) ||
+       !poly_u32_checked_mul(primitive_count, lines_per_primitive, &lines) ||
+       !poly_u32_checked_mul(lines, vertices_per_line, out_vertices))
+      return false;
+
+   *phase_size = 0;
+   if (continuous &&
+       (!poly_u32_checked_mul(lines, instance_count, &phase_count) ||
+        !poly_u32_checked_mul(phase_count, sizeof(float), phase_size)))
+      return false;
+
+   return poly_u32_checked_add(*output_size, *phase_size, &allocation) &&
+          poly_heap_size_can_align(allocation);
+}
