+static bool
+kk_lower_xfb_passthrough_input(nir_builder *b, nir_intrinsic_instr *intr,
+                                void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_per_vertex_input)
+      return false;
+
+   const enum mesa_prim primitive = *(const enum mesa_prim *)data;
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *geometry_params = nir_load_geometry_param_buffer_poly(b);
+   nir_def *nr = nir_load_global_constant(
+      b, 1, 32,
+      nir_iadd_imm(b, geometry_params,
+                    offsetof(struct poly_geometry_params, grid[0])),
+      .align_mul = 4);
+   nir_def *vertex = kk_xfb_input_vertex(
+      b, primitive, nir_load_input_topology_poly(b), nir_load_primitive_id(b),
+      intr->src[0].ssa, nr, nir_ieq_imm(b, nir_load_provoking_last(b), 0));
+   nir_def *vertex_params = nir_load_vertex_param_buffer_poly(b);
+   vertex = nir_iadd(b, vertex,
+                     nir_imul(b, nir_load_instance_id(b),
+                               poly_input_vertices(b, vertex_params)));
+   nir_def *value = poly_load_per_vertex_input(b, intr, vertex);
+   nir_def_replace(&intr->def, value);
+   return true;
+}
