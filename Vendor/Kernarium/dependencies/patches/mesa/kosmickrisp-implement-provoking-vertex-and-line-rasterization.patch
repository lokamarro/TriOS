 {
    nir_def *per_draw = nir_load_per_draw_ptr_kk(b, 1, 64);
    nir_def *byte_offset = nir_imul_imm(
       b, viewport,
-      sizeof(((struct kk_per_draw_data *)0)->rectangular_line_viewports[0]));
+      sizeof(((struct kk_per_draw_data *)0)->line_raster_viewports[0]));
