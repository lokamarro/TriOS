+static nir_def *
+kk_line_raster_vertex(nir_builder *b, nir_def *topology, nir_def *primitive,
+                      nir_def *endpoint, nir_def *primitive_count)
+{
+   nir_def *vertex = poly_vertex_id_for_line_class(
+      b, topology, primitive, endpoint, primitive_count);
+   nir_def *list_adj = nir_iadd(
+      b, nir_imul_imm(b, primitive, 4), nir_iadd_imm(b, endpoint, 1));
+   nir_def *strip_adj =
+      nir_iadd_imm(b, nir_iadd(b, primitive, endpoint), 1);
+
+   vertex = nir_bcsel(
+      b, nir_ieq_imm(b, topology, MESA_PRIM_LINES_ADJACENCY), list_adj,
+      vertex);
+   return nir_bcsel(
+      b, nir_ieq_imm(b, topology, MESA_PRIM_LINE_STRIP_ADJACENCY),
+      strip_adj, vertex);
+}
+
+static nir_def *
+kk_load_line_raster_position(nir_builder *b, nir_def *vertex_params,
+                             uint64_t outputs, nir_def *vertex)
+{
+   nir_def *components[4];
+   for (unsigned c = 0; c < ARRAY_SIZE(components); ++c) {
+      components[c] = kk_load_polygon_point_output(
+         b, vertex_params, outputs, vertex, VARYING_SLOT_POS, c, 32);
+   }
+   return nir_vec(b, components, ARRAY_SIZE(components));
+}
+
+static nir_def *
+kk_line_raster_record(nir_builder *b, nir_def *vertex_params,
+                      nir_def *vertices_per_instance, nir_def *instance,
+                      nir_def *vertex, bool materialized)
+{
+   nir_def *instance_base = nir_imul(b, instance, vertices_per_instance);
+   if (!materialized)
+      return nir_iadd(b, instance_base, vertex);
+
+   nir_def *index_size = poly_index_size(b, vertex_params);
+   nir_def *mapped = vertex;
+   nir_push_if(b, nir_ine_imm(b, index_size, 0));
+   nir_def *loaded = poly_load_index_buffer(b, vertex_params, vertex,
+                                            index_size);
+   nir_pop_if(b, NULL);
+   mapped = nir_if_phi(b, loaded, mapped);
+
+   nir_def *source_count_addr = nir_iadd_imm(
+      b, vertex_params,
+      offsetof(struct poly_vertex_params, line_source_verts_per_instance));
+   nir_def *source_count = nir_load_global_constant(
+      b, 1, 32, source_count_addr, .align_mul = 4, .align_offset = 0);
+   return nir_iadd(b, nir_imul(b, instance, source_count), mapped);
+}
+
+static nir_def *
+kk_line_raster_viewport_for_vertex(nir_builder *b, nir_def *vertex_params,
+                                   uint64_t outputs, nir_def *vertex)
+{
+   if (!(outputs & VARYING_BIT_VIEWPORT))
+      return nir_imm_int(b, 0);
+
+   nir_def *viewport = kk_load_polygon_point_output(
+      b, vertex_params, outputs, vertex, VARYING_SLOT_VIEWPORT, 0, 32);
+   return nir_umin_imm(b, viewport, KK_MAX_VIEWPORTS - 1);
+}
+
+static nir_def *
+kk_line_raster_length(nir_builder *b, nir_def *positions[2],
+                      nir_def *viewport_data, bool euclidean)
+{
+   nir_def *half_extent = nir_trim_vector(b, viewport_data, 2);
+   nir_def *ndc[2];
+   for (unsigned v = 0; v < ARRAY_SIZE(ndc); ++v) {
+      ndc[v] = nir_fmul(
+         b, nir_trim_vector(b, positions[v], 2),
+         nir_frcp(b, nir_channel(b, positions[v], 3)));
+   }
+
+   nir_def *delta =
+      nir_fmul(b, nir_fsub(b, ndc[1], ndc[0]), half_extent);
+   if (euclidean)
+      return nir_fsqrt(b, nir_fdot(b, delta, delta));
+
+   nir_def *absolute = nir_fabs(b, delta);
+   return nir_fmax(b, nir_channel(b, absolute, 0),
+                   nir_channel(b, absolute, 1));
+}
+
+static nir_def *
+kk_line_primitive_count(nir_builder *b, nir_def *topology, nir_def *vertices)
+{
+   nir_def *list = nir_udiv_imm(b, vertices, 2);
+   nir_def *list_adj = nir_udiv_imm(b, vertices, 4);
+   nir_def *strip = nir_bcsel(b, nir_uge_imm(b, vertices, 2),
+                              nir_iadd_imm(b, vertices, -1),
+                              nir_imm_int(b, 0));
+   nir_def *strip_adj = nir_bcsel(b, nir_uge_imm(b, vertices, 4),
+                                  nir_iadd_imm(b, vertices, -3),
+                                  nir_imm_int(b, 0));
+   nir_def *loop = nir_bcsel(b, nir_uge_imm(b, vertices, 2), vertices,
+                             nir_imm_int(b, 0));
+
+   nir_def *count = nir_bcsel(
+      b, nir_ieq_imm(b, topology, MESA_PRIM_LINE_STRIP), strip, list);
+   count = nir_bcsel(b, nir_ieq_imm(b, topology, MESA_PRIM_LINE_LOOP), loop,
+                     count);
+   count = nir_bcsel(
+      b, nir_ieq_imm(b, topology, MESA_PRIM_LINES_ADJACENCY), list_adj,
+      count);
+   return nir_bcsel(
+      b, nir_ieq_imm(b, topology, MESA_PRIM_LINE_STRIP_ADJACENCY),
+      strip_adj, count);
+}
+
+static nir_def *
+kk_triangle_primitive_count(nir_builder *b, nir_def *topology,
+                            nir_def *vertices)
+{
+   nir_def *list = nir_udiv_imm(b, vertices, 3);
+   nir_def *list_adj = nir_udiv_imm(b, vertices, 6);
+   nir_def *strip = nir_bcsel(b, nir_uge_imm(b, vertices, 3),
+                              nir_iadd_imm(b, vertices, -2),
+                              nir_imm_int(b, 0));
+   nir_def *strip_adj = nir_bcsel(
+      b, nir_uge_imm(b, vertices, 6),
+      nir_udiv_imm(b, nir_iadd_imm(b, vertices, -4), 2),
+      nir_imm_int(b, 0));
+   nir_def *count = nir_bcsel(
+      b, nir_ieq_imm(b, topology, MESA_PRIM_TRIANGLE_STRIP), strip, list);
+   count = nir_bcsel(b,
+                     nir_ieq_imm(b, topology, MESA_PRIM_TRIANGLE_FAN),
+                     strip, count);
+   count = nir_bcsel(
+      b, nir_ieq_imm(b, topology, MESA_PRIM_TRIANGLES_ADJACENCY),
+      list_adj, count);
+   return nir_bcsel(
+      b, nir_ieq_imm(b, topology, MESA_PRIM_TRIANGLE_STRIP_ADJACENCY),
+      strip_adj, count);
+}
+
+static nir_def *
+kk_raster_line_count(nir_builder *b, nir_def *topology, nir_def *vertices,
+                     bool polygon_edges)
+{
+   nir_def *primitives =
+      polygon_edges ? kk_triangle_primitive_count(b, topology, vertices)
+                    : kk_line_primitive_count(b, topology, vertices);
+   return polygon_edges ? nir_imul_imm(b, primitives, 3) : primitives;
+}
+
+static nir_def *
+kk_load_line_vertex_params(nir_builder *b)
+{
+   return kk_load_polygon_point_per_draw(
+      b, offsetof(struct kk_per_draw_data, line_vertex_params), 64);
+}
+
+static nir_def *
+kk_line_materialize_vertex(nir_builder *b, nir_def *vertex_params,
+                           nir_def *vertex)
+{
+   nir_def *index_size = poly_index_size(b, vertex_params);
+   nir_def *indexed = vertex;
+   nir_push_if(b, nir_ine_imm(b, index_size, 0));
+   nir_def *loaded =
+      poly_load_index_buffer(b, vertex_params, vertex, index_size);
+   nir_pop_if(b, NULL);
+   return nir_if_phi(b, loaded, indexed);
+}
+
+static bool
+kk_lower_line_materialize_instr(nir_builder *b, nir_intrinsic_instr *intr,
+                                void *data)
+{
+   nir_shader *nir = data;
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *vertex_params = kk_load_line_vertex_params(b);
+   nir_def *global_id = nir_load_global_invocation_id(b, 32);
+   nir_def *vertex = nir_channel(b, global_id, 0);
+   nir_def *instance = nir_channel(b, global_id, 1);
+
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_vertex_id: {
+      nir_def *indexed =
+         kk_line_materialize_vertex(b, vertex_params, vertex);
+      nir_def_replace(&intr->def, indexed);
+      return true;
+   }
+
+   case nir_intrinsic_load_vertex_id_zero_base:
+      nir_def_replace(&intr->def, vertex);
+      return true;
+
+   case nir_intrinsic_load_instance_id:
+      nir_def_replace(&intr->def, instance);
+      return true;
+
+   case nir_intrinsic_store_output: {
+      nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+      nir_def *location = nir_iadd_imm(b, intr->src[1].ssa, sem.location);
+      nir_def *vertices_per_instance =
+         poly_input_vertices(b, vertex_params);
+      nir_def *linear = nir_iadd(
+         b, nir_imul(b, instance, vertices_per_instance), vertex);
+      nir_def *addr = poly_vertex_output_address(
+         b, vertex_params, nir_imm_int64(b, nir->info.outputs_written),
+         linear, location);
+      addr = nir_iadd_imm(b, addr,
+                          nir_intrinsic_component(intr) * sizeof(uint32_t));
+      nir_store_global(b, intr->src[0].ssa, addr,
+                       .write_mask = nir_intrinsic_write_mask(intr),
+                       .align_mul = sizeof(uint32_t), .align_offset = 0);
+      nir_instr_remove(&intr->instr);
+      return true;
+   }
+
+   default:
+      return false;
+   }
+}
+
+/* Generated TES/GS raster streams use the all-ones index as an internal
+ * restart/padding sentinel.  The compact materializer dispatches over source
+ * index positions, so reject those positions before executing any cloned
+ * application or XFB side effect. */
+static void
+kk_guard_line_materialize_restart(nir_shader *nir)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+   nir_def *vertex_params = kk_load_line_vertex_params(&b);
+   nir_def *vertex = nir_channel(
+      &b, nir_load_global_invocation_id(&b, 32), 0);
+   nir_def *index_size = poly_index_size(&b, vertex_params);
+
+   nir_push_if(&b, nir_ine_imm(&b, index_size, 0));
+   nir_def *index =
+      poly_load_index_buffer(&b, vertex_params, vertex, index_size);
+   nir_def *restart = nir_bcsel(
+      &b, nir_ieq_imm(&b, index_size, 1), nir_imm_int(&b, UINT8_MAX),
+      nir_bcsel(&b, nir_ieq_imm(&b, index_size, 2),
+                nir_imm_int(&b, UINT16_MAX),
+                nir_imm_int(&b, UINT32_MAX)));
+   nir_push_if(&b, nir_ieq(&b, index, restart));
+   nir_jump(&b, nir_jump_return);
+   nir_pop_if(&b, NULL);
+   nir_pop_if(&b, NULL);
+}
+
+/* Evaluate each final raster output once into a compact record buffer for
+ * generated line expansion.  A memory-writing GS has already produced its
+ * application values once; this stage consumes them and performs XFB stores
+ * before raster-only index decomposition duplicates shared endpoints. */
+static nir_shader *
+kk_create_line_materialize_shader(const nir_shader *source)
+{
+   nir_shader *nir = nir_shader_clone(NULL, source);
+   if (nir->info.stage == MESA_SHADER_TESS_EVAL)
+      NIR_PASS(_, nir, poly_nir_lower_tes, false);
+
+   NIR_PASS(_, nir, nir_shader_intrinsics_pass,
+            kk_lower_line_materialize_instr, nir_metadata_control_flow, nir);
+   kk_guard_line_materialize_restart(nir);
+   NIR_PASS(_, nir, nir_lower_returns);
+   nir->info.stage = MESA_SHADER_COMPUTE;
+   memset(&nir->info.cs, 0, sizeof(nir->info.cs));
+   nir->info.workgroup_size[0] = 64;
+   nir->info.workgroup_size[1] = 1;
+   nir->info.workgroup_size[2] = 1;
+   nir->xfb_info = NULL;
+   nir_shader_gather_info(nir, nir_shader_get_entrypoint(nir));
+   return nir;
+}
+
+static nir_def *
+kk_load_line_stipple_phase(nir_builder *b, nir_def *vertex_params,
+                           nir_def *primitive_count, nir_def *instance,
+                           nir_def *primitive)
+{
+   nir_def *pointer_addr = nir_iadd_imm(
+      b, vertex_params, offsetof(struct poly_vertex_params,
+                                 line_stipple_phases));
+   nir_def *phases = nir_load_global_constant(
+      b, 1, 64, pointer_addr, .align_mul = 8, .align_offset = 0);
+   nir_def *phase = nir_imm_float(b, 0.0f);
+   nir_push_if(b, nir_ine_imm(b, phases, 0));
+   nir_def *index =
+      nir_iadd(b, nir_imul(b, instance, primitive_count), primitive);
+   nir_def *addr =
+      nir_iadd(b, phases,
+               nir_u2u64(b, nir_imul_imm(b, index, sizeof(float))));
+   nir_def *loaded = nir_load_global_constant(
+      b, 1, 32, addr, .align_mul = 4, .align_offset = 0);
+   nir_pop_if(b, NULL);
+   return nir_if_phi(b, loaded, phase);
+}
+
+/* Build one linear GPU scan per strip instance.  The final raster vertex
+ * shader then performs an O(1) phase lookup for every emitted line vertex,
+ * avoiding the quadratic prefix rescan that is especially costly on long
+ * CAD-style line strips. */
+static nir_shader *
+kk_create_line_stipple_prefix_shader(const nir_shader *vs, bool euclidean,
+                                     bool polygon_edges, bool materialized,
+                                     uint32_t view_count)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_COMPUTE, vs->options, "line_stipple_prefix");
+   nir_shader *nir = b.shader;
+   nir->info.workgroup_size[0] = 1;
+   nir->info.workgroup_size[1] = 1;
+   nir->info.workgroup_size[2] = 1;
+
+   nir_def *vertex_params = kk_load_polygon_point_per_draw(
+      &b, offsetof(struct kk_per_draw_data, line_vertex_params), 64);
+   nir_def *topology = kk_load_polygon_point_per_draw(
+      &b, offsetof(struct kk_per_draw_data, line_raster_topology), 32);
+   nir_def *vertices_per_instance = poly_input_vertices(&b, vertex_params);
+   nir_def *primitive_count = kk_raster_line_count(
+      &b, topology, vertices_per_instance, polygon_edges);
+   nir_def *instance =
+      nir_channel(&b, nir_load_global_invocation_id(&b, 32), 0);
+   if (view_count > 1) {
+      nir_def *view =
+         nir_channel(&b, nir_load_global_invocation_id(&b, 32), 2);
+      instance = nir_iadd(&b, nir_imul_imm(&b, instance, view_count), view);
+   }
+
+   nir_def *pointer_addr = nir_iadd_imm(
+      &b, vertex_params, offsetof(struct poly_vertex_params,
+                                  line_stipple_phases));
+   nir_def *phases = nir_load_global_constant(
+      &b, 1, 64, pointer_addr, .align_mul = 8, .align_offset = 0);
+   nir_def *run_starts_addr = nir_iadd_imm(
+      &b, vertex_params, offsetof(struct poly_vertex_params, line_run_starts));
+   nir_def *run_starts = nir_load_global_constant(
+      &b, 1, 64, run_starts_addr, .align_mul = 8, .align_offset = 0);
+   nir_def *has_run_starts = nir_ine_imm(&b, run_starts, 0);
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_variable *cursor =
+      nir_local_variable_create(impl, glsl_uint_type(), "line_cursor");
+   nir_variable *phase =
+      nir_local_variable_create(impl, glsl_float_type(), "line_phase");
+   nir_store_var(&b, cursor, nir_imm_int(&b, 0), 1);
+   nir_store_var(&b, phase, nir_imm_float(&b, 0.0f), 1);
+
+   nir_push_if(&b, nir_ine_imm(&b, phases, 0));
+   nir_push_loop(&b);
+   nir_def *p = nir_load_var(&b, cursor);
+   nir_break_if(&b, nir_uge(&b, p, primitive_count));
+
+   nir_push_if(&b, has_run_starts);
+   nir_def *run_addr = nir_iadd(
+      &b, run_starts,
+      nir_u2u64(&b, nir_imul_imm(&b, p, sizeof(uint32_t))));
+   nir_def *run_start = nir_load_global_constant(
+      &b, 1, 32, run_addr, .align_mul = 4, .align_offset = 0);
+   nir_push_if(&b, nir_ieq(&b, run_start, p));
+   nir_store_var(&b, phase, nir_imm_float(&b, 0.0f), 1);
+   nir_pop_if(&b, NULL);
+   nir_pop_if(&b, NULL);
+
+   nir_def *phase_index =
+      nir_iadd(&b, nir_imul(&b, instance, primitive_count), p);
+   nir_def *phase_addr = nir_iadd(
+      &b, phases,
+      nir_u2u64(&b, nir_imul_imm(&b, phase_index, sizeof(float))));
+   nir_store_global(&b, nir_load_var(&b, phase), phase_addr,
+                    .write_mask = 1, .align_mul = 4);
+
+   nir_def *line_vertices[2];
+   nir_def *positions[2];
+   for (unsigned v = 0; v < ARRAY_SIZE(line_vertices); ++v) {
+      line_vertices[v] = kk_line_raster_vertex(
+         &b, topology, p, nir_imm_int(&b, v), primitive_count);
+      line_vertices[v] = nir_umin(
+         &b, line_vertices[v],
+         nir_iadd_imm(&b, vertices_per_instance, -1));
+      line_vertices[v] = kk_line_raster_record(
+         &b, vertex_params, vertices_per_instance, instance,
+         line_vertices[v], materialized);
+      positions[v] = kk_load_line_raster_position(
+         &b, vertex_params, vs->info.outputs_written, line_vertices[v]);
+   }
