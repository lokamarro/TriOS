+static unsigned
+count_atomics(nir_shader *shader)
+{
+   unsigned count = 0;
+   if (!shader)
+      return 0;
+
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_intrinsic &&
+                nir_instr_as_intrinsic(instr)->intrinsic ==
+                   nir_intrinsic_global_atomic &&
+                nir_src_is_const(nir_instr_as_intrinsic(instr)->src[0]) &&
+                nir_src_as_uint(nir_instr_as_intrinsic(instr)->src[0]) ==
+                   0x1000)
+               count++;
+         }
+      }
+   }
+   return count;
+}
+
+static void
+check_geometry_side_effects(bool multiple_strips, bool xfb, bool atomic_result,
+                            bool no_output)
+{
+   const nir_shader_compiler_options options = {0};
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_GEOMETRY, &options, "geometry_side_effects");
+   nir_shader *gs = b.shader;
+   gs->info.gs.input_primitive = MESA_PRIM_POINTS;
+   gs->info.gs.output_primitive = MESA_PRIM_LINE_STRIP;
+   gs->info.gs.vertices_in = 1;
+   gs->info.gs.vertices_out = 6;
+   gs->info.gs.invocations = 1;
+   gs->info.gs.active_stream_mask = 1;
+   gs->info.outputs_written = VARYING_BIT_POS;
+   gs->info.writes_memory = true;
+
+   if (xfb) {
+      gs->xfb_info = rzalloc_size(gs, nir_xfb_info_size(1));
+      gs->xfb_info->buffers_written = 1;
+      gs->xfb_info->streams_written = 1;
+      gs->xfb_info->buffers[0] = (nir_xfb_buffer_info){
+         .stride = 16,
+         .varying_count = 1,
+      };
+      gs->xfb_info->output_count = 1;
+      gs->xfb_info->outputs[0] = (nir_xfb_output_info){
+         .buffer = 0,
+         .location = VARYING_SLOT_POS,
+         .component_mask = 0xf,
+      };
+   }
+
+   nir_def *previous = nir_global_atomic(
+      &b, 32, nir_imm_int64(&b, 0x1000), nir_imm_int(&b, 1),
+      .atomic_op = nir_atomic_op_iadd);
+   nir_def *zero = nir_imm_int(&b, 0);
+   if (atomic_result)
+      nir_push_if(&b, nir_ieq_imm(&b, previous, 0));
+
+   unsigned strips = no_output ? 0 : (multiple_strips ? 2 : 1);
+   for (unsigned strip = 0; strip < strips; strip++) {
+      for (unsigned vertex = 0; vertex < 3; vertex++) {
+         nir_store_output(
+            &b, nir_imm_vec4(&b, vertex * 0.1f, strip * 0.1f, 0.5f, 1.0f),
+            zero, .write_mask = 0xf, .src_type = nir_type_float32,
+            .io_semantics.location = VARYING_SLOT_POS);
+         nir_emit_vertex(&b, 0);
+      }
+      nir_end_primitive(&b, 0);
+   }
+
+   if (atomic_result)
+      nir_pop_if(&b, NULL);
+
+   nir_shader *count = NULL, *raster = NULL, *pre_gs = NULL;
+   struct poly_gs_info info = {0};
+   poly_nir_lower_gs_materialized(gs, &count, &raster, &pre_gs, &info);
+
+   /* Only the compute invocation may execute application atomics.  The
+    * emitted-vertex consumer and count/prefix helpers must be side-effect
+    * free with respect to application storage. */
+   assert(count_atomics(gs) == 1);
+   assert(count_atomics(count) == 0);
+   assert(count_atomics(raster) == 0);
+   assert(count == NULL);
+   assert(info.output_vertices == 6);
+   assert(info.output_vertex_stride == (no_output ? 16 : 32));
+   if (no_output)
+      assert(info.max_indices == 0);
+
+   nir_validate_shader(gs, "materialized GS producer");
+   nir_validate_shader(raster, "materialized GS consumer");
+
+   ralloc_free(count);
+   ralloc_free(raster);
+   ralloc_free(pre_gs);
+   ralloc_free(gs);
+}
+
+int
+main(void)
+{
+   uint32_t size_B;
+   assert(poly_gs_output_buffer_size(2, 6, 32, &size_B));
+   assert(size_B == 384);
+   assert(!poly_gs_output_buffer_size(UINT32_MAX, 6, 32, &size_B));
+   for (unsigned flags = 0; flags < 16; flags++)
+      check_geometry_side_effects(flags & 1, flags & 2, flags & 4, flags & 8);
+   return 0;
+}
