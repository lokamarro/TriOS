+         return nir->info.gs.output_primitive;
+      if (nir->info.stage == MESA_SHADER_TESS_EVAL) {
+         primitive = nir->info.tess.point_mode ? MESA_PRIM_POINTS
+                     : nir->info.tess._primitive_mode == TESS_PRIMITIVE_ISOLINES
+                        ? MESA_PRIM_LINES
+                        : MESA_PRIM_TRIANGLES;
+      }
+   }
+   return primitive;
