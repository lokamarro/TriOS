diff --git a/src/kosmickrisp/vulkan/tests/test_geometry_draw_size.cpp b/src/kosmickrisp/vulkan/tests/test_geometry_draw_size.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3369fcf62e9e12eaa307f030c4eb68342cd9d8f3
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_geometry_draw_size.cpp
@@ -0,0 +1,342 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* A direct draw with a geometry shader sizes the geometry stage's output
+ * index buffer at recording time: max_vertices indices for every input
+ * primitive.  Vulkan puts no bound on a non-indexed draw's vertex count, so a
+ * large enough draw makes that size overflow the 32 bits the upload allocator
+ * and the GPU address it in.  The draw must then fail the command buffer
+ * instead of handing the geometry stage a truncated buffer to write gigabytes
+ * past.  The test only records: submitting the unfixed case would corrupt
+ * GPU memory.
+ */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+static void require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (!ok) {
+      std::fprintf(stderr, "%s: %d\n", operation, value);
+      std::exit(1);
+   }
+}
+
+template <typename T> static T load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+#define LOAD_D(name)                                                             \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+
+static const uint32_t vertex_spirv[] =
+#include "geometry_draw_size_shaders/points.vert.h"
+;
+static const uint32_t geometry_spirv[] =
+#include "geometry_draw_size_shaders/dynamic_points.geom.h"
+;
+static const uint32_t fragment_spirv[] =
+#include "geometry_draw_size_shaders/green.frag.h"
+;
+
+/* dynamic_points.geom emits up to 256 points, so it needs 256 four-byte
+ * indices per point drawn: 2^22 points already need 2^32 bytes. */
+static constexpr uint32_t max_vertices = 256;
+static constexpr uint32_t first_overflowing_draw =
+   uint32_t((UINT64_C(1) << 32) / (max_vertices * sizeof(uint32_t)));
+
+int main()
+{
+   std::setvbuf(stdout, nullptr, _IONBF, 0);
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+   app.pApplicationName = "geometry-draw-size";
+   app.apiVersion = VK_API_VERSION_1_3;
+   VkInstanceCreateInfo instance_info{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+   instance_info.pApplicationInfo = &app;
+   auto result = vkCreateInstance(&instance_info, nullptr, &instance);
+   require(result == VK_SUCCESS, "create instance", result);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceFeatures);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   uint32_t physical_count = 1;
+   VkPhysicalDevice physical = VK_NULL_HANDLE;
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, &physical);
+   require((result == VK_SUCCESS || result == VK_INCOMPLETE) && physical_count,
+           "physical device", result);
+
+   VkPhysicalDeviceFeatures features{};
+   vkGetPhysicalDeviceFeatures(physical, &features);
+   require(features.geometryShader, "geometry shaders");
+   uint32_t queue_count = 0;
+   vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, nullptr);
+   std::vector<VkQueueFamilyProperties> queues(queue_count);
+   vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count,
+                                            queues.data());
+   uint32_t queue = 0;
+   while (queue < queue_count &&
+          !(queues[queue].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+      ++queue;
+   require(queue < queue_count, "graphics queue");
+   float priority = 1.0f;
+   VkDeviceQueueCreateInfo queue_info{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+   queue_info.queueFamilyIndex = queue;
+   queue_info.queueCount = 1;
+   queue_info.pQueuePriorities = &priority;
+   VkPhysicalDeviceFeatures enabled{};
+   enabled.geometryShader = VK_TRUE;
+   VkPhysicalDeviceVulkan13Features features13{
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+   features13.dynamicRendering = VK_TRUE;
+   VkDeviceCreateInfo device_info{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+   device_info.pNext = &features13;
+   device_info.queueCreateInfoCount = 1;
+   device_info.pQueueCreateInfos = &queue_info;
+   device_info.pEnabledFeatures = &enabled;
+   VkDevice device = VK_NULL_HANDLE;
+   result = vkCreateDevice(physical, &device_info, nullptr, &device);
+   require(result == VK_SUCCESS, "create device", result);
+   LOAD_D(vkDestroyDevice);
+   LOAD_D(vkCreateShaderModule);
+   LOAD_D(vkDestroyShaderModule);
+   LOAD_D(vkCreatePipelineLayout);
+   LOAD_D(vkDestroyPipelineLayout);
+   LOAD_D(vkCreateGraphicsPipelines);
+   LOAD_D(vkDestroyPipeline);
+   LOAD_D(vkCreateCommandPool);
+   LOAD_D(vkDestroyCommandPool);
+   LOAD_D(vkAllocateCommandBuffers);
+   LOAD_D(vkResetCommandBuffer);
+   LOAD_D(vkBeginCommandBuffer);
+   LOAD_D(vkEndCommandBuffer);
+   LOAD_D(vkCmdBeginRendering);
+   LOAD_D(vkCmdEndRendering);
+   LOAD_D(vkCmdBindPipeline);
+   LOAD_D(vkCmdSetViewport);
+   LOAD_D(vkCmdSetScissor);
+   LOAD_D(vkCmdDraw);
+   LOAD_D(vkCreateImage);
+   LOAD_D(vkDestroyImage);
+   LOAD_D(vkCreateImageView);
+   LOAD_D(vkDestroyImageView);
+   LOAD_D(vkGetImageMemoryRequirements);
+   LOAD_D(vkAllocateMemory);
+   LOAD_D(vkFreeMemory);
+   LOAD_D(vkBindImageMemory);
+
+   constexpr uint32_t extent = 8;
+   constexpr VkFormat color_format = VK_FORMAT_R8G8B8A8_UNORM;
+   VkImageCreateInfo image_info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+   image_info.imageType = VK_IMAGE_TYPE_2D;
+   image_info.format = color_format;
+   image_info.extent = {extent, extent, 1};
+   image_info.mipLevels = 1;
+   image_info.arrayLayers = 1;
+   image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+   image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+   image_info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+   VkImage image = VK_NULL_HANDLE;
+   result = vkCreateImage(device, &image_info, nullptr, &image);
+   require(result == VK_SUCCESS, "create image", result);
+   VkMemoryRequirements requirements{};
+   vkGetImageMemoryRequirements(device, image, &requirements);
+   VkPhysicalDeviceMemoryProperties memory_properties{};
+   vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+   uint32_t type = 0;
+   while (type < memory_properties.memoryTypeCount &&
+          !(requirements.memoryTypeBits & (1u << type)))
+      ++type;
+   require(type < memory_properties.memoryTypeCount, "memory type");
+   VkMemoryAllocateInfo memory_info{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+   memory_info.allocationSize = requirements.size;
+   memory_info.memoryTypeIndex = type;
+   VkDeviceMemory memory = VK_NULL_HANDLE;
+   result = vkAllocateMemory(device, &memory_info, nullptr, &memory);
+   require(result == VK_SUCCESS, "allocate image", result);
+   result = vkBindImageMemory(device, image, memory, 0);
+   require(result == VK_SUCCESS, "bind image", result);
+   VkImageViewCreateInfo view_info{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+   view_info.image = image;
+   view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+   view_info.format = color_format;
+   view_info.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+   VkImageView view = VK_NULL_HANDLE;
+   result = vkCreateImageView(device, &view_info, nullptr, &view);
+   require(result == VK_SUCCESS, "create view", result);
+
+   auto make_module = [&](const uint32_t *code, size_t size) {
+      VkShaderModuleCreateInfo module_info{
+         VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+      module_info.codeSize = size;
+      module_info.pCode = code;
+      VkShaderModule module = VK_NULL_HANDLE;
+      result = vkCreateShaderModule(device, &module_info, nullptr, &module);
+      require(result == VK_SUCCESS, "create module", result);
+      return module;
+   };
+   VkShaderModule modules[3] = {
+      make_module(vertex_spirv, sizeof(vertex_spirv)),
+      make_module(geometry_spirv, sizeof(geometry_spirv)),
+      make_module(fragment_spirv, sizeof(fragment_spirv)),
+   };
+   const VkShaderStageFlagBits stage_bits[3] = {
+      VK_SHADER_STAGE_VERTEX_BIT,
+      VK_SHADER_STAGE_GEOMETRY_BIT,
+      VK_SHADER_STAGE_FRAGMENT_BIT,
+   };
+   VkPipelineShaderStageCreateInfo stages[3]{};
+   for (unsigned i = 0; i < 3; ++i) {
+      stages[i].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stages[i].stage = stage_bits[i];
+      stages[i].module = modules[i];
+      stages[i].pName = "main";
+   }
+
+   VkPipelineLayoutCreateInfo layout_info{
+      VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+   VkPipelineLayout layout = VK_NULL_HANDLE;
+   result = vkCreatePipelineLayout(device, &layout_info, nullptr, &layout);
+   require(result == VK_SUCCESS, "create layout", result);
+
+   VkPipelineVertexInputStateCreateInfo vertex_input{
+      VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+   VkPipelineInputAssemblyStateCreateInfo assembly{
+      VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+   assembly.topology = VK_PRIMITIVE_TOPOLOGY_POINT_LIST;
+   VkPipelineViewportStateCreateInfo viewport_state{
+      VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+   viewport_state.viewportCount = 1;
+   viewport_state.scissorCount = 1;
+   VkPipelineRasterizationStateCreateInfo raster{
+      VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+   raster.polygonMode = VK_POLYGON_MODE_FILL;
+   raster.cullMode = VK_CULL_MODE_NONE;
+   raster.lineWidth = 1.0f;
+   VkPipelineMultisampleStateCreateInfo multisample{
+      VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+   multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+   VkPipelineColorBlendAttachmentState blend_attachment{};
+   blend_attachment.colorWriteMask = 0xf;
+   VkPipelineColorBlendStateCreateInfo blend{
+      VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+   blend.attachmentCount = 1;
+   blend.pAttachments = &blend_attachment;
+   const VkDynamicState dynamic_states[] = {VK_DYNAMIC_STATE_VIEWPORT,
+                                            VK_DYNAMIC_STATE_SCISSOR};
+   VkPipelineDynamicStateCreateInfo dynamic{
+      VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+   dynamic.dynamicStateCount = 2;
+   dynamic.pDynamicStates = dynamic_states;
+   VkPipelineRenderingCreateInfo rendering_info{
+      VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+   rendering_info.colorAttachmentCount = 1;
+   rendering_info.pColorAttachmentFormats = &color_format;
+   VkGraphicsPipelineCreateInfo pipeline_info{
+      VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+   pipeline_info.pNext = &rendering_info;
+   pipeline_info.stageCount = 3;
+   pipeline_info.pStages = stages;
+   pipeline_info.pVertexInputState = &vertex_input;
+   pipeline_info.pInputAssemblyState = &assembly;
+   pipeline_info.pViewportState = &viewport_state;
+   pipeline_info.pRasterizationState = &raster;
+   pipeline_info.pMultisampleState = &multisample;
+   pipeline_info.pColorBlendState = &blend;
+   pipeline_info.pDynamicState = &dynamic;
+   pipeline_info.layout = layout;
+   VkPipeline pipeline = VK_NULL_HANDLE;
+   result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &pipeline_info,
+                                      nullptr, &pipeline);
+   require(result == VK_SUCCESS, "create pipeline", result);
+
+   VkCommandPoolCreateInfo pool_info{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+   pool_info.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+   pool_info.queueFamilyIndex = queue;
+   VkCommandPool pool = VK_NULL_HANDLE;
+   result = vkCreateCommandPool(device, &pool_info, nullptr, &pool);
+   require(result == VK_SUCCESS, "create command pool", result);
+   VkCommandBufferAllocateInfo allocate{
+      VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+   allocate.commandPool = pool;
+   allocate.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+   allocate.commandBufferCount = 1;
+   VkCommandBuffer command = VK_NULL_HANDLE;
+   result = vkAllocateCommandBuffers(device, &allocate, &command);
+   require(result == VK_SUCCESS, "allocate command buffer", result);
+
+   /* Records one draw of `points` points and returns what ending the
+    * recording reports. */
+   auto record = [&](uint32_t points) {
+      result = vkResetCommandBuffer(command, 0);
+      require(result == VK_SUCCESS, "reset command buffer", result);
+      VkCommandBufferBeginInfo begin{
+         VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+      begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+      result = vkBeginCommandBuffer(command, &begin);
+      require(result == VK_SUCCESS, "begin command buffer", result);
+      VkRenderingAttachmentInfo attachment{
+         VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+      attachment.imageView = view;
+      attachment.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      attachment.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+      attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+      VkRenderingInfo rendering{VK_STRUCTURE_TYPE_RENDERING_INFO};
+      rendering.renderArea = {{0, 0}, {extent, extent}};
+      rendering.layerCount = 1;
+      rendering.colorAttachmentCount = 1;
+      rendering.pColorAttachments = &attachment;
+      vkCmdBeginRendering(command, &rendering);
+      vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+      const VkViewport viewport{0.0f, 0.0f, float(extent), float(extent),
+                                0.0f, 1.0f};
+      const VkRect2D scissor{{0, 0}, {extent, extent}};
+      vkCmdSetViewport(command, 0, 1, &viewport);
+      vkCmdSetScissor(command, 0, 1, &scissor);
+      vkCmdDraw(command, points, 1, 0, 0);
+      vkCmdEndRendering(command);
+      return vkEndCommandBuffer(command);
+   };
+
+   result = record(3);
+   require(result == VK_SUCCESS, "record a small geometry draw", result);
+   result = record(first_overflowing_draw);
+   require(result == VK_ERROR_OUT_OF_DEVICE_MEMORY,
+           "record a draw whose index buffer needs 2^32 bytes", result);
+   result = record(first_overflowing_draw + 1u);
+   require(result == VK_ERROR_OUT_OF_DEVICE_MEMORY,
+           "record a draw whose index buffer needs more than 2^32 bytes",
+           result);
+   result = record(3);
+   require(result == VK_SUCCESS, "record a small draw after a refused one",
+           result);
+
+   vkDestroyCommandPool(device, pool, nullptr);
+   vkDestroyPipeline(device, pipeline, nullptr);
+   vkDestroyPipelineLayout(device, layout, nullptr);
+   for (VkShaderModule module : modules)
+      vkDestroyShaderModule(device, module, nullptr);
+   vkDestroyImageView(device, view, nullptr);
+   vkDestroyImage(device, image, nullptr);
+   vkFreeMemory(device, memory, nullptr);
+   vkDestroyDevice(device, nullptr);
+   vkDestroyInstance(instance, nullptr);
+   std::printf("oversized geometry-shader draws fail their command buffer\n");
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_heap_overflow_gpu.c b/src/kosmickrisp/vulkan/tests/test_heap_overflow_gpu.c
new file mode 100644
index 0000000000000000000000000000000000000000..587401849fb8378a8d39b01553f487b6367e21d3
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_heap_overflow_gpu.c
@@ -0,0 +1,506 @@
+/* SPDX-License-Identifier: MIT */
+
+/* Launch the production unroll and setup kernels on a heap too small for
+ * their draws. A refused heap reservation must leave every stage after it
+ * with nothing to do. A shader-side abort() ends only the invocation that
+ * calls it, so a kernel that aborted instead would leave the words it had not
+ * written yet - the canaries below - for the stages that read them, and the
+ * other invocations of an unroll group would go on with a pointer the
+ * aborted one never published. */
+#include "kosmickrisp/vulkan/kk_cmd_buffer.h"
+#include "kosmickrisp/vulkan/kk_device.h"
+#include "kosmickrisp/vulkan/kk_entrypoints.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(condition)                                                       \
+   do {                                                                        \
+      if (!(condition)) {                                                      \
+         fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__,      \
+                 #condition);                                                  \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+
+#define VK_CHECK(expr)                                                         \
+   do {                                                                        \
+      VkResult result_ = (expr);                                               \
+      if (result_ != VK_SUCCESS) {                                             \
+         fprintf(stderr, "%s:%d: %s = %d\n", __FILE__, __LINE__, #expr,        \
+                 result_);                                                     \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+
+enum { HEAP_SIZE = 4096, HEAP_BOTTOM = 16, CANARY = 0xa5a5a5a5 };
+
+struct context {
+   VkDevice device;
+   VkQueue queue;
+   VkCommandPool pool;
+   VkCommandBuffer command;
+   const struct vk_device_dispatch_table *api;
+};
+
+static struct kk_cmd_buffer *
+begin(struct context *ctx)
+{
+   VK_CHECK(ctx->api->ResetCommandPool(ctx->device, ctx->pool, 0));
+   const VkCommandBufferBeginInfo info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+   };
+   VK_CHECK(ctx->api->BeginCommandBuffer(ctx->command, &info));
+   return kk_cmd_buffer_from_handle(ctx->command);
+}
+
+static void
+submit(struct context *ctx)
+{
+   VK_CHECK(ctx->api->EndCommandBuffer(ctx->command));
+   const VkSubmitInfo info = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &ctx->command,
+   };
+   VK_CHECK(ctx->api->QueueSubmit(ctx->queue, 1, &info, VK_NULL_HANDLE));
+   VK_CHECK(ctx->api->QueueWaitIdle(ctx->queue));
+}
+
+/* A heap header over HEAP_SIZE bytes of pool memory that claims `size` bytes,
+ * the first `bottom` of them in use. */
+static struct kk_ptr
+heap_claiming(struct kk_cmd_buffer *cmd, uint32_t bottom, uint32_t size)
+{
+   struct kk_ptr storage = kk_pool_alloc(cmd, HEAP_SIZE, 16);
+   CHECK(storage.gpu);
+   const struct poly_heap data = {
+      .base = storage.gpu,
+      .bottom = bottom,
+      .size = size,
+   };
+   struct kk_ptr header = kk_pool_upload(cmd, &data, sizeof(data), 4);
+   CHECK(header.cpu);
+   return header;
+}
+
+/* A HEAP_SIZE heap in pool memory, the first HEAP_BOTTOM bytes in use. */
+static struct kk_ptr
+heap(struct kk_cmd_buffer *cmd)
+{
+   return heap_claiming(cmd, HEAP_BOTTOM, HEAP_SIZE);
+}
+
+static struct kk_ptr
+canaries(struct kk_cmd_buffer *cmd, uint32_t words)
+{
+   struct kk_ptr ptr = kk_pool_alloc(cmd, words * sizeof(uint32_t), 8);
+   CHECK(ptr.cpu);
+   memset(ptr.cpu, 0xa5, words * sizeof(uint32_t));
+   return ptr;
+}
+
+static bool
+all_zero(const uint32_t *words, uint32_t count)
+{
+   for (uint32_t i = 0; i < count; i++) {
+      if (words[i])
+         return false;
+   }
+   return true;
+}
+
+struct unroll_case {
+   const char *name;
+   enum mesa_prim mode;
+   bool line_runs;
+   uint32_t vertices[2];
+   uint32_t draws, unrolled;
+};
+
+/* Unroll non-indexed fans or strips. Each draw's words and a guard after the
+ * last must show whether it was unrolled whole or emptied. */
+static void
+check_unroll(struct context *ctx, const struct unroll_case *test)
+{
+   struct kk_cmd_buffer *cmd = begin(ctx);
+   struct kk_ptr heap_ptr = heap(cmd);
+   const uint32_t out_stride = test->line_runs ? 8 : 5;
+   uint32_t in_words[2][4];
+   for (uint32_t i = 0; i < test->draws; i++) {
+      in_words[i][0] = test->vertices[i];
+      in_words[i][1] = 2 + i;
+      in_words[i][2] = 7 + i;
+      in_words[i][3] = 3 + i;
+   }
+   struct kk_ptr in_draw = kk_pool_upload(cmd, in_words, sizeof(in_words), 4);
+   struct kk_ptr out_draw = canaries(cmd, test->draws * out_stride + 1);
+   CHECK(in_draw.cpu);
+   const struct libkk_unroll_geometry_args args = {
+      .heap = heap_ptr.gpu,
+      .in_draw = in_draw.gpu,
+      .out_draw = out_draw.gpu,
+      .in_draw_stride_el = 4,
+      .out_draw_stride_el = out_stride,
+      .restart_index = UINT32_MAX,
+      .out_el_size_B = 4,
+      .emit_line_runs = test->line_runs,
+      .mode = test->mode,
+   };
+   libkk_unroll_geometry_struct(cmd, kk_grid_1d(1024 * test->draws), true,
+                                args);
+   submit(ctx);
+
+   const uint32_t per_prim = mesa_vertices_per_prim(u_decomposed_prim(test->mode));
+   const uint32_t *out = out_draw.cpu;
+   const struct poly_heap *actual_heap = heap_ptr.cpu;
+   uint32_t unrolled = 0;
+   for (uint32_t i = 0; i < test->draws; i++) {
+      const uint32_t *words = out + i * out_stride;
+      const uint32_t indices =
+         u_decomposed_prims_for_vertices(test->mode, test->vertices[i]) *
+         per_prim;
+      const uint32_t size_B = indices * 4 + (test->line_runs
+         ? u_decomposed_prims_for_vertices(test->mode, test->vertices[i]) * 4
+         : 0);
+      /* Reservations may land in either order, so a draw that fits on its
+       * own is either whole or emptied; the count below says which. */
+      if (!all_zero(words, out_stride)) {
+         CHECK(size_B < HEAP_SIZE - HEAP_BOTTOM);
+         CHECK(words[0] == indices && words[1] == 2 + i &&
+               words[3] == 7 + i && words[4] == 3 + i);
+         const uint32_t offset_B = words[2] * 4;
+         CHECK(offset_B >= HEAP_BOTTOM &&
+               offset_B + size_B <= actual_heap->bottom &&
+               offset_B + size_B <= HEAP_SIZE);
+         if (test->line_runs) {
+            const uint64_t runs = *(const uint64_t *)&words[6];
+            CHECK(words[5] == 0 &&
+                  runs == actual_heap->base + offset_B + indices * 4);
+         }
+         unrolled++;
+      }
+   }
+   CHECK(unrolled == test->unrolled);
+   CHECK(out[test->draws * out_stride] == CANARY);
+   printf("unroll PASS %s (%u of %u draws unrolled)\n", test->name, unrolled,
+          test->draws);
+}
+
+struct gs_case {
+   const char *name;
+   uint32_t vertices;
+   uint32_t output_vertices, stride;
+   bool fits;
+};
+
+static void
+check_gs(struct context *ctx, const struct gs_case *test)
+{
+   struct kk_cmd_buffer *cmd = begin(ctx);
+   const uint32_t local[3] = {64, 1, 1};
+   struct poly_vertex_params vertex;
+   struct poly_geometry_params geometry;
+   poly_vertex_params_init(&vertex, 1, local);
+   poly_geometry_params_init(&geometry, MESA_PRIM_POINTS, local);
+   geometry.output_vertex_stride = test->stride;
+   geometry.output_vertices = test->output_vertices;
+   struct kk_ptr vp = kk_pool_upload(cmd, &vertex, sizeof(vertex), 8);
+   struct kk_ptr gp = kk_pool_upload(cmd, &geometry, sizeof(geometry), 8);
+   const uint32_t draw_words[4] = {test->vertices, 1, 0, 0};
+   struct kk_ptr draw = kk_pool_upload(cmd, draw_words, sizeof(draw_words), 4);
+   struct kk_ptr groups = canaries(cmd, 3);
+   struct kk_ptr heap_ptr = heap(cmd);
+   CHECK(vp.cpu && gp.cpu && draw.cpu);
+   const struct libkk_gs_setup_indirect_args args = {
+      .draw = draw.gpu,
+      .vp = vp.gpu,
+      .p = gp.gpu,
+      .heap = heap_ptr.gpu,
+      .vertex_outputs = 1,
+      .prim = MESA_PRIM_POINTS,
+      .shape = POLY_GS_SHAPE_STATIC_PER_INSTANCE,
+      .gs_group_grid = groups.gpu,
+   };
+   libkk_gs_setup_indirect_struct(cmd, kk_grid_1d(1), true, args);
+   submit(ctx);
+
+   const struct poly_vertex_params *actual_vp = vp.cpu;
+   const struct poly_geometry_params *actual_gp = gp.cpu;
+   const uint32_t *actual_groups = groups.cpu;
+   if (test->fits) {
+      CHECK(actual_vp->grid[0] == test->vertices &&
+            actual_gp->grid[0] == test->vertices);
+      CHECK(actual_vp->output_buffer && actual_gp->output_vertex_buffer);
+      CHECK(actual_groups[0] == DIV_ROUND_UP(test->vertices, 64));
+   } else {
+      CHECK(all_zero(actual_vp->grid, 6) &&
+            all_zero(actual_vp->line_stipple_grid, 6) &&
+            all_zero(actual_gp->grid, 6) && all_zero(actual_groups, 3));
+      const struct poly_indirect_draw empty = {0};
+      CHECK(memcmp(&actual_gp->draw, &empty, sizeof(empty)) == 0);
+      CHECK(actual_vp->output_buffer == 0 && actual_gp->input_primitives == 0 &&
+            actual_gp->output_vertex_buffer == 0);
+   }
+   printf("geometry setup PASS %s\n", test->name);
+}
+
+enum line_kernel { LINE_RECTANGULAR, LINE_MATERIALIZE, LINE_RASTER };
+
+struct line_case {
+   const char *name;
+   enum line_kernel kernel;
+   uint32_t vertices, aux_stride;
+   bool fits;
+};
+
+static void
+check_line(struct context *ctx, const struct line_case *test)
+{
+   struct kk_cmd_buffer *cmd = begin(ctx);
+   const uint32_t local[3] = {64, 1, 1};
+   struct poly_vertex_params vertex;
+   poly_vertex_params_init(&vertex, 1, local);
+   /* Stale sizes from an earlier draw, which a refused setup must clear. The
+    * third grid word is the view count the host publishes. */
+   vertex.grid[0] = vertex.grid[1] = 9;
+   vertex.line_stipple_grid[0] = 9;
+   /* The raster setup follows a materializing producer. */
+   const uint64_t producer_output = 0x100000;
+   if (test->kernel == LINE_RASTER)
+      vertex.output_buffer = producer_output;
+   struct kk_ptr vp = kk_pool_upload(cmd, &vertex, sizeof(vertex), 8);
+   const uint32_t draw_words[5] = {test->vertices, 1, 0, 0, 0};
+   struct kk_ptr draw = kk_pool_upload(cmd, draw_words, sizeof(draw_words), 4);
+   struct kk_ptr out_draw = canaries(cmd, 4);
+   struct kk_ptr heap_ptr = heap(cmd);
+   CHECK(vp.cpu && draw.cpu);
+   switch (test->kernel) {
+   case LINE_RECTANGULAR: {
+      const struct libkk_rectangular_line_setup_indirect_args args = {
+         .heap = heap_ptr.gpu,
+         .vp = vp.gpu,
+         .in_draw = draw.gpu,
+         .out_draw = out_draw.gpu,
+         .vertex_outputs = 1,
+         .mode = MESA_PRIM_LINES,
+         .vertices_per_line = 6,
+         .lines_per_primitive = 1,
+         .line_aux_stride = test->aux_stride,
+      };
+      libkk_rectangular_line_setup_indirect_struct(cmd, kk_grid_1d(1), true,
+                                                   args);
+      break;
+   }
+   case LINE_MATERIALIZE: {
+      const struct libkk_line_materialize_setup_indirect_args args = {
+         .heap = heap_ptr.gpu,
+         .vp = vp.gpu,
+         .in_draw = draw.gpu,
+         .vertex_outputs = 1,
+      };
+      libkk_line_materialize_setup_indirect_struct(cmd, kk_grid_1d(1), true,
+                                                   args);
+      break;
+   }
+   case LINE_RASTER: {
+      const struct libkk_line_raster_setup_indirect_args args = {
+         .heap = heap_ptr.gpu,
+         .vp = vp.gpu,
+         .in_draw = draw.gpu,
+         .out_draw = out_draw.gpu,
+         .mode = MESA_PRIM_LINES,
+         .vertices_per_line = 6,
+         .lines_per_primitive = 1,
+         .line_aux_stride = test->aux_stride,
+      };
+      libkk_line_raster_setup_indirect_struct(cmd, kk_grid_1d(1), true,
+                                              args);
+      break;
+   }
+   }
+   submit(ctx);
+
+   const struct poly_vertex_params *actual = vp.cpu;
+   const uint32_t *out = out_draw.cpu;
+   const bool writes_draw = test->kernel != LINE_MATERIALIZE;
+   if (test->fits) {
+      if (test->kernel == LINE_RASTER) {
+         CHECK(actual->output_buffer == producer_output &&
+               actual->line_stipple_phases &&
+               actual->line_stipple_grid[0] == 1);
+      } else {
+         CHECK(actual->output_buffer && actual->grid[0] == test->vertices);
+      }
+      if (writes_draw)
+         CHECK(out[0] == test->vertices / 2 * 6 && out[1] == 1);
+   } else {
+      CHECK(all_zero(actual->grid, 6) &&
+            all_zero(actual->line_stipple_grid, 6));
+      CHECK(actual->output_buffer == 0 && actual->line_stipple_phases == 0 &&
+            actual->verts_per_instance == 0);
+      if (writes_draw)
+         CHECK(all_zero(out, 4));
+   }
+   if (!writes_draw)
+      CHECK(out[0] == CANARY);
+   printf("line setup PASS %s\n", test->name);
+}
+
+/* A refused reservation must leave the heap's bottom where it was. The heap
+ * here claims 0xf0000000 bytes with only 16 of them free, and the first
+ * rectangular line setup asks for 0x10000010, which reaches exactly 2^32 from
+ * that bottom. An allocator that added a reservation before refusing it
+ * carried the 32-bit bottom around to zero, and then granted the second
+ * setup's 32 bytes at offset zero, over space still in use. The claimed space
+ * is never written: a line setup only records where its buffers are.
+ *
+ *
+ * Both refusals add the 0x10000010 and 32 bytes they asked for, in 16-byte
+ * units, to the sizes the segment was refused, which start at refused_units.
+ * When those wrap past 2^32, what the heap needed saturates. */
+static void
+check_wrap(struct context *ctx, const char *name, uint32_t refused_units,
+           uint32_t needed_units)
+{
+   const uint32_t size = 0xf0000000u, bottom = size - 16u;
+   const uint32_t vertices[2] = {(1u << 24) + 1u, 2u};
+   struct kk_cmd_buffer *cmd = begin(ctx);
+   struct kk_ptr heap_ptr = heap_claiming(cmd, bottom, size);
+   ((struct poly_heap *)heap_ptr.cpu)->segment_refused_units = refused_units;
+   const uint32_t local[3] = {64, 1, 1};
+   struct kk_ptr vps[2], out_draws[2];
+   for (unsigned i = 0; i < 2; i++) {
+      struct poly_vertex_params vertex;
+      poly_vertex_params_init(&vertex, 1, local);
+      vertex.grid[0] = vertex.grid[1] = 9;
+      vps[i] = kk_pool_upload(cmd, &vertex, sizeof(vertex), 8);
+      const uint32_t draw_words[5] = {vertices[i], 1, 0, 0, 0};
+      struct kk_ptr draw =
+         kk_pool_upload(cmd, draw_words, sizeof(draw_words), 4);
+      out_draws[i] = canaries(cmd, 4);
+      CHECK(vps[i].cpu && draw.cpu);
+      const struct libkk_rectangular_line_setup_indirect_args args = {
+         .heap = heap_ptr.gpu,
+         .vp = vps[i].gpu,
+         .in_draw = draw.gpu,
+         .out_draw = out_draws[i].gpu,
+         .vertex_outputs = 1,
+         .mode = MESA_PRIM_LINES,
+         .vertices_per_line = 6,
+         .lines_per_primitive = 1,
+      };
+      libkk_rectangular_line_setup_indirect_struct(cmd, kk_grid_1d(1), true,
+                                                   args);
+   }
+   submit(ctx);
+
+   for (unsigned i = 0; i < 2; i++) {
+      const struct poly_vertex_params *actual = vps[i].cpu;
+      CHECK(actual->output_buffer == 0 && all_zero(actual->grid, 6));
+      CHECK(all_zero(out_draws[i].cpu, 4));
+   }
+   const struct poly_heap *after = heap_ptr.cpu;
+   CHECK(after->bottom == bottom && after->refusals == 2u);
+   CHECK(after->segment_refused_units == refused_units + 0x1000001u + 2u);
+   CHECK(after->needed_units == needed_units);
+   printf("heap wrap PASS %s\n", name);
+}
+
+int
+main(void)
+{
+   const VkApplicationInfo app = {
+      .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+      .apiVersion = VK_API_VERSION_1_3,
+   };
+   const VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   VkInstance instance;
+   VK_CHECK(kk_CreateInstance(&instance_info, NULL, &instance));
+   PFN_vkEnumeratePhysicalDevices enumerate =
+      (PFN_vkEnumeratePhysicalDevices)kk_GetInstanceProcAddr(
+         instance, "vkEnumeratePhysicalDevices");
+   uint32_t count = 1;
+   VkPhysicalDevice physical;
+   VK_CHECK(enumerate(instance, &count, &physical));
+   CHECK(count == 1);
+   const float priority = 1;
+   const VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   const VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+   };
+   struct context ctx = {0};
+   VK_CHECK(kk_CreateDevice(physical, &device_info, NULL, &ctx.device));
+   ctx.api = &kk_device_from_handle(ctx.device)->exposed_dispatch_table;
+   ctx.api->GetDeviceQueue(ctx.device, 0, 0, &ctx.queue);
+   const VkCommandPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .queueFamilyIndex = 0,
+   };
+   VK_CHECK(ctx.api->CreateCommandPool(ctx.device, &pool_info, NULL,
+                                       &ctx.pool));
+   const VkCommandBufferAllocateInfo allocation = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = ctx.pool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   VK_CHECK(ctx.api->AllocateCommandBuffers(ctx.device, &allocation,
+                                            &ctx.command));
+
+   /* A fan of n vertices unrolls to 3(n - 2) indices; a strip with runs to
+    * 2(n - 1) indices and n - 1 run starts. The heap holds 4080 bytes. */
+   const struct unroll_case unrolls[] = {
+      {"fan-fits", MESA_PRIM_TRIANGLE_FAN, false, {5}, 1, 1},
+      {"strip-runs-fit", MESA_PRIM_LINE_STRIP, true, {5}, 1, 1},
+      {"fan-overflows", MESA_PRIM_TRIANGLE_FAN, false, {3000}, 1, 0},
+      {"strip-runs-overflow", MESA_PRIM_LINE_STRIP, true, {1000}, 1, 0},
+      {"second-fan-overflows", MESA_PRIM_TRIANGLE_FAN, false, {5, 3000}, 2, 1},
+      /* Each fits alone; whichever reserves second is refused. */
+      {"fans-overflow-together", MESA_PRIM_TRIANGLE_FAN, false, {200, 250}, 2,
+       1},
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(unrolls); i++)
+      check_unroll(&ctx, &unrolls[i]);
+
+   /* A point is 16 bytes of vertex output; each GS output vertex is stride
+    * bytes. */
+   const struct gs_case geometries[] = {
+      {"fits", 10, 4, 16, true},
+      {"vertex-buffer-overflows", 1000, 1, 16, false},
+      {"output-buffer-overflows", 10, 64, 16, false},
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(geometries); i++)
+      check_gs(&ctx, &geometries[i]);
+
+   /* 16 bytes of output per vertex and aux_stride bytes per line. */
+   const struct line_case lines[] = {
+      {"rectangular-fits", LINE_RECTANGULAR, 10, 4, true},
+      {"rectangular-overflows", LINE_RECTANGULAR, 300, 4, false},
+      {"materialize-fits", LINE_MATERIALIZE, 10, 0, true},
+      {"materialize-overflows", LINE_MATERIALIZE, 300, 0, false},
+      {"raster-fits", LINE_RASTER, 10, 4, true},
+      {"raster-phases-overflow", LINE_RASTER, 1000, 16, false},
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(lines); i++)
+      check_line(&ctx, &lines[i]);
+
+   check_wrap(&ctx, "counts", 0u, 0u);
+   check_wrap(&ctx, "saturates", 0xffffff00u, 0xffffffffu);
+
+   ctx.api->DestroyCommandPool(ctx.device, ctx.pool, NULL);
+   ctx.api->DestroyDevice(ctx.device, NULL);
+   kk_DestroyInstance(instance, NULL);
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_line_raster.c b/src/kosmickrisp/vulkan/tests/test_line_raster.c
new file mode 100644
index 0000000000000000000000000000000000000000..d6623ec16599645d82d95e0bb6b0f1311952c342
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_line_raster.c
@@ -0,0 +1,292 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kosmickrisp/vulkan/kk_line_raster.h"
+
+#include <assert.h>
+#include <limits.h>
+#include <string.h>
+
+static struct vk_graphics_pipeline_state
+make_state(struct vk_input_assembly_state *ia,
+           struct vk_rasterization_state *rs, VkPrimitiveTopology topology,
+           VkPolygonMode polygon_mode, VkLineRasterizationModeKHR line_mode,
+           bool stipple)
+{
+   *ia = (struct vk_input_assembly_state){
+      .primitive_topology = topology,
+   };
+   *rs = (struct vk_rasterization_state){
+      .polygon_mode = polygon_mode,
+      .line = {
+         .mode = line_mode,
+         .stipple = {
+            .enable = stipple,
+            .factor = 1,
+            .pattern = UINT16_MAX,
+         },
+      },
+   };
+
+   return (struct vk_graphics_pipeline_state){
+      .ia = ia,
+      .rs = rs,
+   };
+}
+
+static void
+check(VkPrimitiveTopology topology, VkPolygonMode polygon_mode,
+      VkLineRasterizationModeKHR line_mode, bool stipple,
+      bool expected_emulation, bool expected_triangles,
+      bool expected_polygon_edges)
+{
+   struct vk_input_assembly_state ia;
+   struct vk_rasterization_state rs;
+   struct vk_graphics_pipeline_state state =
+      make_state(&ia, &rs, topology, polygon_mode, line_mode, stipple);
+
+   assert(kk_needs_line_raster_emulation(&state) == expected_emulation);
+   assert(kk_line_raster_uses_triangles(&state) == expected_triangles);
+   assert(kk_line_raster_polygon_edges(&state) == expected_polygon_edges);
+}
+
+int
+main(void)
+{
+   /* The same GS/TES modules can rasterize lines even with triangle or patch
+    * input.  Their FIRST/LAST and FILL/LINE cache identities must differ. */
+   const VkPrimitiveTopology generated_inputs[] = {
+      VK_PRIMITIVE_TOPOLOGY_POINT_LIST,
+      VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
+      VK_PRIMITIVE_TOPOLOGY_PATCH_LIST,
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(generated_inputs); i++) {
+      struct vk_input_assembly_state ia;
+      struct vk_rasterization_state rs;
+      struct vk_graphics_pipeline_state state = make_state(
+         &ia, &rs, generated_inputs[i], VK_POLYGON_MODE_FILL,
+         VK_LINE_RASTERIZATION_MODE_BRESENHAM_KHR, false);
+      const struct kk_line_raster_key first = kk_line_raster_key(&state);
+      rs.provoking_vertex = VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT;
+      const struct kk_line_raster_key last = kk_line_raster_key(&state);
+      assert(memcmp(&first, &last, sizeof(first)) != 0);
+
+      rs.provoking_vertex = VK_PROVOKING_VERTEX_MODE_FIRST_VERTEX_EXT;
+      rs.polygon_mode = VK_POLYGON_MODE_LINE;
+      const struct kk_line_raster_key polygon = kk_line_raster_key(&state);
+      assert(memcmp(&first, &polygon, sizeof(first)) != 0);
+
+      BITSET_SET(state.dynamic, MESA_VK_DYNAMIC_RS_PROVOKING_VERTEX);
+      BITSET_SET(state.dynamic, MESA_VK_DYNAMIC_RS_LINE_STIPPLE_ENABLE);
+      const struct kk_line_raster_key dynamic = kk_line_raster_key(&state);
+      rs.provoking_vertex = VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT;
+      rs.line.stipple.enable = true;
+      const struct kk_line_raster_key ignored = kk_line_raster_key(&state);
+      assert(memcmp(&dynamic, &ignored, sizeof(dynamic)) == 0);
+   }
+
+   /* Final GS/TES/XFB line output and polygon edges share the center-sample
+    * rule.  Input assembly and the generated triangle implementation do not
+    * determine whether the API rasterizer receives lines. */
+   assert(kk_line_raster_sample_count(
+             MESA_PRIM_LINES, VK_POLYGON_MODE_FILL,
+             VK_LINE_RASTERIZATION_MODE_BRESENHAM_KHR, 4) == 4);
+   assert(kk_line_raster_sample_count(
+             MESA_PRIM_LINE_STRIP, VK_POLYGON_MODE_POINT,
+             VK_LINE_RASTERIZATION_MODE_BRESENHAM_KHR, 8) == 8);
+   assert(kk_line_raster_sample_count(
+             MESA_PRIM_TRIANGLES, VK_POLYGON_MODE_LINE,
+             VK_LINE_RASTERIZATION_MODE_BRESENHAM_KHR, 4) == 4);
+   assert(kk_line_raster_sample_count(
+             MESA_PRIM_TRIANGLES, VK_POLYGON_MODE_FILL,
+             VK_LINE_RASTERIZATION_MODE_BRESENHAM_KHR, 4) == 0);
+   assert(kk_line_raster_sample_count(
+             MESA_PRIM_POINTS, VK_POLYGON_MODE_LINE,
+             VK_LINE_RASTERIZATION_MODE_BRESENHAM_KHR, 4) == 0);
+   assert(kk_line_raster_sample_count(
+             MESA_PRIM_LINES, VK_POLYGON_MODE_FILL,
+             VK_LINE_RASTERIZATION_MODE_BRESENHAM_KHR, 1) == 0);
+   assert(kk_line_raster_sample_count(
+             MESA_PRIM_TRIANGLES, VK_POLYGON_MODE_LINE,
+             VK_LINE_RASTERIZATION_MODE_RECTANGULAR_KHR, 4) == 0);
+
+   const uint32_t parity_counts[] = {
+      0, 1, 2, 3, 4, 5, 6, 7, 8, 127, INT_MAX,
+   };
+   for (enum mesa_prim prim = 0; prim < MESA_PRIM_COUNT; prim++) {
+      for (unsigned i = 0; i < ARRAY_SIZE(parity_counts); i++) {
+         assert(poly_decomposed_prims_for_vertices_u32(
+                   prim, parity_counts[i]) ==
+                u_decomposed_prims_for_vertices(prim, parity_counts[i]));
+      }
+   }
+   assert(poly_decomposed_prims_for_vertices_u32(MESA_PRIM_UNKNOWN, 2) == 0);
+   assert(poly_decomposed_prims_for_vertices_u32(MESA_PRIM_UNKNOWN, 3) == 1);
+   assert(poly_decomposed_prims_for_vertices_u32(MESA_PRIM_POINTS,
+                                                  UINT32_MAX) == UINT32_MAX);
+   assert(poly_decomposed_prims_for_vertices_u32(MESA_PRIM_LINES,
+                                                  UINT32_MAX) ==
+          UINT32_MAX / 2);
+   assert(poly_decomposed_prims_for_vertices_u32(MESA_PRIM_TRIANGLE_STRIP,
+                                                  UINT32_MAX) ==
+          UINT32_MAX - 2);
+   assert(poly_decomposed_prims_for_vertices_u32(MESA_PRIM_POLYGON,
+                                                  UINT32_MAX) == 1);
+
+   assert(poly_heap_size_can_align(0xfffffff0u));
+   assert(!poly_heap_size_can_align(0xfffffff1u));
+   assert(poly_unroll_output_index(7, 8192, true) == 7);
+   assert(poly_unroll_output_index(7, 8192, false) == 8192);
+   assert(poly_unroll_output_index(11, UINT32_MAX, true) == 11);
+
+   uint32_t size_B;
+   assert(kk_line_view_count(0) == 1);
+   assert(kk_line_view_count(1) == 1);
+   assert(kk_line_view_count(8) == 1);
+   assert(kk_line_view_count(5) == 2);
+   assert(kk_line_view_count(UINT32_MAX) == 32);
+   uint32_t view_instances;
+   assert(poly_u32_checked_mul(3, kk_line_view_count(5), &view_instances));
+   assert(kk_line_vertex_output_size(9, view_instances, 2, &size_B));
+   assert(size_B == 9 * 3 * 2 * 2 * 16);
+   assert(!poly_u32_checked_mul(UINT32_MAX, kk_line_view_count(5),
+                                &view_instances));
+   assert(kk_line_vertex_output_size(9, 3, 2, &size_B));
+   assert(size_B == 9 * 3 * 2 * 16);
+   assert(!kk_line_vertex_output_size(UINT32_MAX, 2, 1, &size_B));
+   assert(kk_line_phase_buffer_size(MESA_PRIM_TRIANGLES, 12, 2, 3,
+                                    &size_B));
+   assert(size_B == 12 * 2 * sizeof(float));
+   assert(!kk_line_phase_buffer_size(MESA_PRIM_TRIANGLES, UINT32_MAX,
+                                     UINT32_MAX, 3, &size_B));
+   uint32_t vertex_count;
+   assert(kk_line_raster_vertex_count(MESA_PRIM_TRIANGLES, 12, 3, 6,
+                                      &vertex_count));
+   assert(vertex_count == 72);
+   assert(!kk_line_raster_vertex_count(MESA_PRIM_TRIANGLE_STRIP,
+                                       UINT32_MAX, 3, 6, &vertex_count));
+
+   assert(kk_smooth_line_modulates_output(FRAG_RESULT_DATA0, 0, true));
+   assert(!kk_smooth_line_modulates_output(FRAG_RESULT_DATA1, 0, true));
+   assert(!kk_smooth_line_modulates_output(FRAG_RESULT_DATA0, 1, true));
+   assert(!kk_smooth_line_modulates_output(FRAG_RESULT_DATA0, 0, false));
+
+   assert(kk_vk_topology_class(VK_PRIMITIVE_TOPOLOGY_LINE_STRIP) ==
+          VK_PRIMITIVE_TOPOLOGY_LINE_LIST);
+   assert(kk_vk_topology_class(
+             VK_PRIMITIVE_TOPOLOGY_LINE_LIST_WITH_ADJACENCY) ==
+          VK_PRIMITIVE_TOPOLOGY_LINE_LIST);
+   assert(kk_vk_topology_class(
+             VK_PRIMITIVE_TOPOLOGY_LINE_STRIP_WITH_ADJACENCY) ==
+          VK_PRIMITIVE_TOPOLOGY_LINE_LIST);
+   assert(kk_vk_topology_class(VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN) ==
+          VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST);
+   assert(kk_vk_topology_class(
+             VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP_WITH_ADJACENCY) ==
+          VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST);
+   assert(kk_vk_topology_class(VK_PRIMITIVE_TOPOLOGY_POINT_LIST) ==
+          VK_PRIMITIVE_TOPOLOGY_POINT_LIST);
+   assert(kk_vk_topology_class(VK_PRIMITIVE_TOPOLOGY_PATCH_LIST) ==
+          VK_PRIMITIVE_TOPOLOGY_PATCH_LIST);
+
+   /* Metal natively handles narrow non-adjacency default/Bresenham lines. */
+   check(VK_PRIMITIVE_TOPOLOGY_LINE_LIST, VK_POLYGON_MODE_FILL,
+         VK_LINE_RASTERIZATION_MODE_DEFAULT_KHR, false, false, false, false);
+   check(VK_PRIMITIVE_TOPOLOGY_LINE_STRIP_WITH_ADJACENCY,
+         VK_POLYGON_MODE_FILL, VK_LINE_RASTERIZATION_MODE_BRESENHAM_KHR,
+         false, true, false, false);
+   check(VK_PRIMITIVE_TOPOLOGY_LINE_LIST_WITH_ADJACENCY,
+         VK_POLYGON_MODE_FILL, VK_LINE_RASTERIZATION_MODE_DEFAULT_KHR,
+         false, true, false, false);
+
+   /* A generated line stage selects flat values from the last endpoint. */
+   struct vk_input_assembly_state ia;
+   struct vk_rasterization_state rs;
+   struct vk_graphics_pipeline_state state =
+      make_state(&ia, &rs, VK_PRIMITIVE_TOPOLOGY_LINE_LIST,
+                 VK_POLYGON_MODE_FILL,
+                 VK_LINE_RASTERIZATION_MODE_DEFAULT_KHR, false);
+   rs.provoking_vertex = VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT;
+   assert(kk_needs_line_raster_emulation(&state));
+   assert(!kk_line_raster_uses_triangles(&state));
+
+   state = make_state(&ia, &rs, VK_PRIMITIVE_TOPOLOGY_LINE_STRIP,
+                      VK_POLYGON_MODE_FILL,
+                      VK_LINE_RASTERIZATION_MODE_DEFAULT_KHR, false);
+   BITSET_SET(state.dynamic, MESA_VK_DYNAMIC_RS_PROVOKING_VERTEX);
+   assert(kk_needs_line_raster_emulation(&state));
+   assert(!kk_line_raster_uses_triangles(&state));
+   assert(kk_line_raster_has_native_variant(&state, MESA_PRIM_LINES, false));
+   assert(!kk_line_raster_select_generated(MESA_PRIM_LINE_STRIP, &rs));
+   rs.provoking_vertex = VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT;
+   assert(kk_line_raster_has_native_variant(&state, MESA_PRIM_LINES, false));
+   assert(kk_line_raster_select_generated(MESA_PRIM_LINE_STRIP, &rs));
+   rs.provoking_vertex = VK_PROVOKING_VERTEX_MODE_FIRST_VERTEX_EXT;
+   assert(kk_line_raster_select_generated(MESA_PRIM_LINES_ADJACENCY, &rs));
+   assert(!kk_line_raster_has_native_variant(&state, MESA_PRIM_TRIANGLES,
+                                             true));
+
+   /* Rectangular and smooth coverage uses the generated triangle stage. */
+   check(VK_PRIMITIVE_TOPOLOGY_LINE_STRIP, VK_POLYGON_MODE_FILL,
+         VK_LINE_RASTERIZATION_MODE_RECTANGULAR_KHR, false, true, true,
+         false);
+   check(VK_PRIMITIVE_TOPOLOGY_LINE_LIST_WITH_ADJACENCY,
+         VK_POLYGON_MODE_FILL,
+         VK_LINE_RASTERIZATION_MODE_RECTANGULAR_SMOOTH_KHR, false, true,
+         true, false);
+
+   /* Stipple alone retains Metal line rasterization and masks in the FS. */
+   check(VK_PRIMITIVE_TOPOLOGY_LINE_LIST, VK_POLYGON_MODE_FILL,
+         VK_LINE_RASTERIZATION_MODE_DEFAULT_KHR, true, true, false, false);
+   check(VK_PRIMITIVE_TOPOLOGY_LINE_STRIP, VK_POLYGON_MODE_FILL,
+         VK_LINE_RASTERIZATION_MODE_BRESENHAM_KHR, true, true, false, false);
+   check(VK_PRIMITIVE_TOPOLOGY_LINE_LIST, VK_POLYGON_MODE_FILL,
+         VK_LINE_RASTERIZATION_MODE_RECTANGULAR_KHR, true, true, true,
+         false);
+
+   /* Triangle polygon edges only need generation for non-native line modes. */
+   check(VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST, VK_POLYGON_MODE_LINE,
+         VK_LINE_RASTERIZATION_MODE_DEFAULT_KHR, false, false, false, true);
+   check(VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP, VK_POLYGON_MODE_LINE,
+         VK_LINE_RASTERIZATION_MODE_RECTANGULAR_SMOOTH_KHR, false, true,
+         true, true);
+   check(VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN, VK_POLYGON_MODE_LINE,
+         VK_LINE_RASTERIZATION_MODE_DEFAULT_KHR, true, true, false, true);
+
+   /* Points and filled triangles never enter the line path. */
+   check(VK_PRIMITIVE_TOPOLOGY_POINT_LIST, VK_POLYGON_MODE_FILL,
+         VK_LINE_RASTERIZATION_MODE_RECTANGULAR_KHR, true, false, true,
+         false);
+   check(VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST, VK_POLYGON_MODE_FILL,
+         VK_LINE_RASTERIZATION_MODE_RECTANGULAR_SMOOTH_KHR, true, false,
+         true, false);
+
+   /* Dynamic stipple enable reserves the generated path at compile time. */
+   state =
+      make_state(&ia, &rs, VK_PRIMITIVE_TOPOLOGY_LINE_LIST,
+                 VK_POLYGON_MODE_FILL,
+                 VK_LINE_RASTERIZATION_MODE_DEFAULT_KHR, false);
+   BITSET_SET(state.dynamic, MESA_VK_DYNAMIC_RS_LINE_STIPPLE_ENABLE);
+   assert(kk_needs_line_raster_emulation(&state));
+   assert(!kk_line_raster_uses_triangles(&state));
+   assert(kk_line_raster_has_native_variant(&state, MESA_PRIM_LINES, true));
+   assert(!kk_line_raster_select_generated(MESA_PRIM_LINES, &rs));
+   rs.line.stipple.enable = true;
+   assert(kk_line_raster_has_native_variant(&state, MESA_PRIM_LINES, true));
+   assert(kk_line_raster_select_generated(MESA_PRIM_LINES, &rs));
+   rs.provoking_vertex = VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT;
+   assert(!kk_line_raster_has_native_variant(&state, MESA_PRIM_LINES, true));
+   rs.provoking_vertex = VK_PROVOKING_VERTEX_MODE_FIRST_VERTEX_EXT;
+   rs.line.mode = VK_LINE_RASTERIZATION_MODE_RECTANGULAR_KHR;
+   assert(!kk_line_raster_has_native_variant(&state, MESA_PRIM_LINES, true));
+   assert(!kk_line_stipple_prefix_required(true, false,
+                                           MESA_PRIM_LINE_STRIP, 0));
+   assert(kk_line_stipple_prefix_required(true, true,
+                                          MESA_PRIM_LINE_STRIP, 0));
+   assert(!kk_line_stipple_prefix_required(false, true,
+                                           MESA_PRIM_LINE_STRIP, 0));
+
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_line_raster_cache.cpp b/src/kosmickrisp/vulkan/tests/test_line_raster_cache.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cbffca7a551e4d65ffb0a28555fc6d83c9dc9bbc
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_line_raster_cache.cpp
@@ -0,0 +1,879 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+#include "line_raster_cache_state.h"
+
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <span>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+static void require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (ok)
+      return;
+   std::fprintf(stderr, "%s: %d\n", operation, value);
+   std::exit(1);
+}
+
+template <typename T> static T load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+
+static const uint32_t vertex_spirv[] =
+#include "line_raster_shaders/cache.vert.h"
+;
+static const uint32_t fragment_spirv[] =
+#include "line_raster_shaders/cache.frag.h"
+;
+static const uint32_t gs_lines_spirv[] =
+#include "line_raster_shaders/lines.geom.h"
+;
+static const uint32_t gs_triangles_spirv[] =
+#include "line_raster_shaders/triangles.geom.h"
+;
