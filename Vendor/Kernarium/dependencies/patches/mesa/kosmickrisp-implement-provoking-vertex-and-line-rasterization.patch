diff --git a/src/kosmickrisp/vulkan/tests/line_raster_cache_state.m b/src/kosmickrisp/vulkan/tests/line_raster_cache_state.m
new file mode 100644
index 0000000000000000000000000000000000000000..95aabcce87405e0b317affd38c61c981e18fa416
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/line_raster_cache_state.m
@@ -0,0 +1,103 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "line_raster_cache_state.h"
+#include "kosmickrisp/vulkan/kk_cmd_buffer.h"
+#include <Metal/MTL4RenderPass.h>
+
+const struct kk_shader *
+kk_test_bound_vertex_shader(VkCommandBuffer command)
+{
+   const struct kk_cmd_buffer *cmd = kk_cmd_buffer_from_handle(command);
+   return cmd->state.gfx.bound_shaders[MESA_SHADER_VERTEX];
+}
+
+const struct kk_shader *
+kk_test_vertex_shader(VkPipeline pipeline)
+{
+   struct vk_shader *shader = vk_pipeline_get_shader(
+      vk_pipeline_from_handle(pipeline), MESA_SHADER_VERTEX);
+   assert(shader != NULL);
+   return container_of(shader, struct kk_shader, vk);
+}
+
+void
+kk_test_assert_deferred_pipeline(VkPipeline pipeline)
+{
+   const struct kk_shader *owner = kk_test_vertex_shader(pipeline);
+   assert(owner->info.deferred);
+   assert(!owner->info.vs.line_variant_stages);
+   assert(!owner->pipeline.gfx.render);
+}
+
+void
+kk_test_assert_static_pipeline(VkPipeline pipeline, bool generated)
+{
+   const struct kk_shader *vs = kk_test_vertex_shader(pipeline);
+   assert(vs->info.vs.line_variant_stages == 0);
+   assert(vs->info.vs.line_raster_emulation == generated);
+}
+
+void
+kk_test_assert_line_owner(const struct kk_shader *owner, bool plain)
+{
+   assert(!owner->info.vs.line_raster_emulation);
+   assert(owner->info.vs.line_variant_stages != 0);
+   const struct kk_shader *generated =
+      owner->line_variant_shaders[MESA_SHADER_VERTEX];
+   assert(generated != NULL && generated->info.vs.line_raster_emulation);
+   assert(generated->info.vs.line_raster_stipple);
+   assert(generated->info.vs.line_variant_stages == 0);
+   if (plain)
+      assert(owner->pipeline.gfx.pre_render_count == 0);
+}
+
+void
+kk_test_assert_raster_samples(VkPipeline pipeline, uint32_t samples)
+{
+   const struct kk_shader *owner = kk_test_vertex_shader(pipeline);
+   assert(owner->info.vs.sample_count == samples);
+   const struct kk_shader *generated =
+      owner->line_variant_shaders[MESA_SHADER_VERTEX];
+   if (generated)
+      assert(generated->info.vs.sample_count == samples);
+}
+
+void
+kk_test_assert_line_variant(VkCommandBuffer command,
+                             const struct kk_shader *owner, bool generated,
+                             uint32_t samples)
+{
+   const struct kk_cmd_buffer *cmd = kk_cmd_buffer_from_handle(command);
+   assert(cmd->state.gfx.bound_shaders[MESA_SHADER_VERTEX] == owner);
+   for (unsigned stage = MESA_SHADER_VERTEX; stage <= MESA_SHADER_FRAGMENT;
+        stage++) {
+      if (!(owner->info.vs.line_variant_stages & BITFIELD_BIT(stage))) {
+         assert(cmd->state.gfx.bound_shaders[stage] == NULL);
+         assert(cmd->state.shaders[stage] == NULL);
+         continue;
+      }
+      const struct kk_shader *expected =
+         generated ? owner->line_variant_shaders[stage]
+                   : cmd->state.gfx.bound_shaders[stage];
+      assert(cmd->state.shaders[stage] == expected);
+   }
+   assert(cmd->state.gfx.render.bresenham_samples == samples);
+   if (samples) {
+      MTL4RenderPassDescriptor *descriptor =
+         (MTL4RenderPassDescriptor *)cmd->state.gfx.render_pass_descriptor;
+      MTLSamplePosition positions[KK_MAX_SAMPLES];
+      assert([descriptor getSamplePositions:positions count:samples] ==
+             samples);
+      for (unsigned i = 0; i < samples; i++) {
+         const VkSampleLocationEXT expected =
+            cmd->state.gfx.render.sample_locations_enable
+               ? cmd->state.gfx.render.sample_locations[i]
+               : (VkSampleLocationEXT){0.5f, 0.5f};
+         assert(positions[i].x == expected.x);
+         assert(positions[i].y == expected.y);
+      }
+   }
+}
