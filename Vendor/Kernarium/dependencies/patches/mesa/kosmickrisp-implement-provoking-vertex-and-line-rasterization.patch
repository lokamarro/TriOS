+            result = vkCreateGraphicsPipelines(device, cache, 1, &depth_info, nullptr,
+                                               &depth_pipeline);
+            require(result == VK_PIPELINE_COMPILE_REQUIRED, "no-FS depth cache miss", result);
+            depth_info.flags = 0;
+            result = vkCreateGraphicsPipelines(device, cache, 1, &depth_info, nullptr,
+                                               &depth_pipeline);
+            require(result == VK_SUCCESS, "no-FS depth-only compile", result);
+            kk_test_assert_raster_samples(depth_pipeline, 4);
+            vkDestroyPipeline(device, depth_pipeline, nullptr);
+            depth_info.pMultisampleState = &plain_ms;
+            depth_info.flags = VK_PIPELINE_CREATE_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT;
+            result = vkCreateGraphicsPipelines(device, cache, 1, &depth_info, nullptr,
+                                               &depth_pipeline);
+            require(result == VK_PIPELINE_COMPILE_REQUIRED, "no-FS depth sample cache miss", result);
+
+            auto discard_rs = rs;
+            discard_rs.pNext = nullptr;
+            discard_rs.rasterizerDiscardEnable = VK_TRUE;
+            auto discard_info = pipeline_info;
+            discard_info.pNext = nullptr;
+            discard_info.pRasterizationState = &discard_rs;
+            discard_info.pMultisampleState = nullptr;
+            discard_info.pColorBlendState = nullptr;
+            discard_info.pDepthStencilState = nullptr;
+            discard_info.pViewportState = nullptr;
+            discard_info.pDynamicState = nullptr;
+            discard_info.flags = 0;
+            VkPipeline discard_pipeline = VK_NULL_HANDLE;
+            result = vkCreateGraphicsPipelines(device, cache, 1, &discard_info, nullptr,
+                                               &discard_pipeline);
+            require(result == VK_SUCCESS, "no-FS static discard compile", result);
+            kk_test_assert_static_pipeline(discard_pipeline, false);
+            vkDestroyPipeline(device, discard_pipeline, nullptr);
+            discard_info.flags = VK_PIPELINE_CREATE_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT;
+            result = vkCreateGraphicsPipelines(device, cache, 1, &discard_info, nullptr,
+                                               &discard_pipeline);
+            require(result == VK_SUCCESS, "no-FS static discard cache hit", result);
+            vkDestroyPipeline(device, discard_pipeline, nullptr);
+
+            /* This library has no input assembly or fragment-output state.
+             * Its NIR must stay deferred, with no eager raster variants. */
+            VkGraphicsPipelineLibraryCreateInfoEXT subset{
+               VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_LIBRARY_CREATE_INFO_EXT};
+            subset.pNext = &rendering;
+            subset.flags = VK_GRAPHICS_PIPELINE_LIBRARY_PRE_RASTERIZATION_SHADERS_BIT_EXT;
+            auto pre_info = pipeline_info;
+            pre_info.pNext = &subset;
+            pre_info.pVertexInputState = nullptr;
+            pre_info.pInputAssemblyState = nullptr;
+            pre_info.pMultisampleState = nullptr;
+            pre_info.pColorBlendState = nullptr;
+            pre_info.pDepthStencilState = nullptr;
+            pre_info.flags = VK_PIPELINE_CREATE_LIBRARY_BIT_KHR;
+            VkPipeline pre_library = VK_NULL_HANDLE;
+            result = vkCreateGraphicsPipelines(device, cache, 1, &pre_info, nullptr, &pre_library);
+            require(result == VK_SUCCESS, "deferred pre-raster library", result);
+            kk_test_assert_deferred_pipeline(pre_library);
+            vkDestroyPipeline(device, pre_library, nullptr);
+         }
+
+         for (unsigned reload = 0; reload < 2; ++reload) {
+            const kk_shader *owner = kk_test_vertex_shader(pipeline);
+            kk_test_assert_raster_samples(pipeline, 4);
+            kk_test_assert_line_owner(owner, !gs && !tess && !xfb);
+
+            VkCommandPoolCreateInfo pool_info{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+            pool_info.queueFamilyIndex = queue;
+            VkCommandPool pool = VK_NULL_HANDLE;
+            result = vkCreateCommandPool(device, &pool_info, nullptr, &pool);
+            require(result == VK_SUCCESS, "command pool", result);
+            VkBuffer capture = VK_NULL_HANDLE;
+            VkDeviceMemory capture_memory = VK_NULL_HANDLE;
+            float *capture_map = nullptr;
+            std::vector<float> expected_capture;
+            if (xfb) {
+               VkBufferCreateInfo buffer_info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+               buffer_info.size = 4096;
+               buffer_info.usage = VK_BUFFER_USAGE_TRANSFORM_FEEDBACK_BUFFER_BIT_EXT;
+               result = vkCreateBuffer(device, &buffer_info, nullptr, &capture);
+               require(result == VK_SUCCESS, "XFB capture buffer", result);
+               VkMemoryRequirements requirements{};
+               vkGetBufferMemoryRequirements(device, capture, &requirements);
+               VkPhysicalDeviceMemoryProperties memory_properties{};
+               vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+               uint32_t memory_type = 0;
+               const VkMemoryPropertyFlags properties =
+                  VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+               while (memory_type < memory_properties.memoryTypeCount &&
+                      (!(requirements.memoryTypeBits & (1u << memory_type)) ||
+                       (memory_properties.memoryTypes[memory_type].propertyFlags & properties) != properties))
+                  memory_type++;
+               require(memory_type < memory_properties.memoryTypeCount, "host-coherent XFB memory");
+               VkMemoryAllocateInfo memory_info{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+               memory_info.allocationSize = requirements.size;
+               memory_info.memoryTypeIndex = memory_type;
+               result = vkAllocateMemory(device, &memory_info, nullptr, &capture_memory);
+               require(result == VK_SUCCESS, "XFB capture allocation", result);
+               result = vkBindBufferMemory(device, capture, capture_memory, 0);
+               require(result == VK_SUCCESS, "XFB capture binding", result);
+               result = vkMapMemory(device, capture_memory, 0, VK_WHOLE_SIZE, 0,
+                                    reinterpret_cast<void **>(&capture_map));
+               require(result == VK_SUCCESS, "XFB capture mapping", result);
+               for (unsigned i = 0; i < 1024; i++)
+                  capture_map[i] = -1000.0f;
+            }
+            VkCommandBufferAllocateInfo allocate{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+            allocate.commandPool = pool;
+            allocate.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+            allocate.commandBufferCount = 1;
+            VkCommandBuffer command = VK_NULL_HANDLE;
+            result = vkAllocateCommandBuffers(device, &allocate, &command);
+            require(result == VK_SUCCESS, "command allocation", result);
+            VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+            begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+            result = vkBeginCommandBuffer(command, &begin);
+            require(result == VK_SUCCESS, "command begin", result);
+            VkRenderingInfo render{VK_STRUCTURE_TYPE_RENDERING_INFO};
+            render.renderArea.extent = {8, 8};
+            render.layerCount = 1;
+            vkCmdBeginRendering(command, &render);
+            vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+            const VkViewport viewport{0, 0, 8, 8, 0, 1};
+            const VkRect2D scissor{{0, 0}, {8, 8}};
+            const VkSampleLocationEXT locations[] = {
+               {0.125f, 0.125f}, {0.375f, 0.375f},
+               {0.625f, 0.625f}, {0.875f, 0.875f}};
+            VkSampleLocationsInfoEXT location_info{VK_STRUCTURE_TYPE_SAMPLE_LOCATIONS_INFO_EXT};
+            location_info.sampleLocationsPerPixel = VK_SAMPLE_COUNT_4_BIT;
+            location_info.sampleLocationGridSize = {1, 1};
+            location_info.sampleLocationsCount = 4;
+            location_info.pSampleLocations = locations;
+            vkCmdSetViewport(command, 0, 1, &viewport);
+            vkCmdSetScissor(command, 0, 1, &scissor);
+            for (unsigned draw = 0; draw < (scenario == 0 || xfb ? 8 : 5); ++draw) {
+               const bool adjacency = draw == 5 || draw == 6;
+               vkCmdSetPrimitiveTopology(command,
+                  draw == 5 ? VK_PRIMITIVE_TOPOLOGY_LINE_LIST_WITH_ADJACENCY
+                  : draw == 6 ? VK_PRIMITIVE_TOPOLOGY_LINE_STRIP_WITH_ADJACENCY
+                              : static_cast<VkPrimitiveTopology>(ia.topology));
+               vkCmdSetProvokingVertexModeEXT(command, draw == 1
+                  ? VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT : VK_PROVOKING_VERTEX_MODE_FIRST_VERTEX_EXT);
+               vkCmdSetLineStippleEnableEXT(command, draw == 3);
+               vkCmdSetSampleLocationsEXT(command, &location_info);
+               vkCmdSetSampleLocationsEnableEXT(command, draw == 1 || draw == 2);
+               if (xfb) {
+                  const VkDeviceSize offset = expected_capture.size() * sizeof(float);
+                  const VkDeviceSize size = 4096 - offset;
+                  vkCmdBindTransformFeedbackBuffersEXT(command, 0, 1, &capture, &offset, &size);
+                  vkCmdBeginTransformFeedbackEXT(command, 0, 0, nullptr, nullptr);
+                  const unsigned vertices[] = {
+                     adjacency ? 1u : 0u, adjacency ? 2u : 1u, 2u, 3u};
+                  for (unsigned i = 0; i < (draw == 6 ? 4 : 2); i++) {
+                     expected_capture.push_back(float(vertices[i]) - 1.0f);
+                     expected_capture.push_back(0.0f);
+                     expected_capture.push_back(0.5f);
+                     expected_capture.push_back(1.0f);
+                  }
+               }
+               vkCmdDraw(command, adjacency ? 5 : gs || tess ? 3 : 2, 1, 0, 0);
+               if (xfb)
+                  vkCmdEndTransformFeedbackEXT(command, 0, 0, nullptr, nullptr);
+               kk_test_assert_line_variant(command, owner,
+                                            draw == 1 || draw == 3 || adjacency,
+                                            4);
+            }
+
+            /* Null app stages and generated FS state must not survive a
+             * GS/TES -> ordinary VS -> GS/TES pipeline transition. */
+            const auto bind_draw = [&](VkCommandBuffer cmd, VkPipeline pipe,
+                                       const kk_shader *vs, VkPrimitiveTopology topology,
+                                       bool last, uint32_t samples = 4) {
+               vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pipe);
+               vkCmdSetViewport(cmd, 0, 1, &viewport);
+               vkCmdSetScissor(cmd, 0, 1, &scissor);
+               vkCmdSetPrimitiveTopology(cmd, topology);
+               vkCmdSetProvokingVertexModeEXT(cmd, last
+                  ? VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT
+                  : VK_PROVOKING_VERTEX_MODE_FIRST_VERTEX_EXT);
+               vkCmdSetLineStippleEnableEXT(cmd, VK_FALSE);
+               vkCmdSetSampleLocationsEXT(cmd, &location_info);
+               vkCmdSetSampleLocationsEnableEXT(cmd, VK_FALSE);
+               vkCmdDraw(cmd, topology == VK_PRIMITIVE_TOPOLOGY_LINE_LIST ? 2 : 3, 1, 0, 0);
+               if (cmd == command)
+                  kk_test_assert_line_variant(cmd, vs, last, samples);
+            };
+            bind_draw(command, plain, plain_owner, plain_ia.topology, false);
+            bind_draw(command, plain, plain_owner, plain_ia.topology, true);
+            bind_draw(command, plain_two_samples, two_sample_owner,
+                       plain_ia.topology, false, 2);
+            bind_draw(command, plain_two_samples, two_sample_owner,
+                       plain_ia.topology, true, 2);
+            bind_draw(command, pipeline, owner, ia.topology, false);
+            bind_draw(command, pipeline, owner, ia.topology, true);
+            vkCmdEndRendering(command);
+
+            /* Compute binding is separate from graphics ownership. */
+            vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_COMPUTE, compute);
+            vkCmdDispatch(command, 1, 1, 1);
+            kk_test_assert_line_variant(command, owner, true, 0);
+            vkCmdBeginRendering(command, &render);
+            vkCmdSetProvokingVertexModeEXT(command, VK_PROVOKING_VERTEX_MODE_FIRST_VERTEX_EXT);
+            vkCmdDraw(command, gs || tess ? 3 : 2, 1, 0, 0);
+            kk_test_assert_line_variant(command, owner, false, 4);
+            vkCmdEndRendering(command);
+
+            /* Secondary command buffers are replayed into the primary. */
+            allocate.level = VK_COMMAND_BUFFER_LEVEL_SECONDARY;
+            VkCommandBuffer secondary = VK_NULL_HANDLE;
+            result = vkAllocateCommandBuffers(device, &allocate, &secondary);
+            require(result == VK_SUCCESS, "secondary allocation", result);
+            VkCommandBufferInheritanceInfo inheritance{
+               VK_STRUCTURE_TYPE_COMMAND_BUFFER_INHERITANCE_INFO};
+            begin.pInheritanceInfo = &inheritance;
+            result = vkBeginCommandBuffer(secondary, &begin);
+            require(result == VK_SUCCESS, "secondary begin", result);
+            vkCmdBeginRendering(secondary, &render);
+            bind_draw(secondary, pipeline, owner, ia.topology, true);
+            vkCmdEndRendering(secondary);
+            result = vkEndCommandBuffer(secondary);
+            require(result == VK_SUCCESS, "secondary end", result);
+            vkCmdExecuteCommands(command, 1, &secondary);
+            kk_test_assert_line_variant(command, owner, true, 0);
+            vkCmdBeginRendering(command, &render);
+            bind_draw(command, plain, plain_owner, plain_ia.topology, false);
+            bind_draw(command, pipeline, owner, ia.topology, false);
+            vkCmdEndRendering(command);
+            if (xfb) {
+               VkMemoryBarrier barrier{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+               barrier.srcAccessMask = VK_ACCESS_TRANSFORM_FEEDBACK_WRITE_BIT_EXT;
+               barrier.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+               vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TRANSFORM_FEEDBACK_BIT_EXT,
+                                    VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &barrier,
+                                    0, nullptr, 0, nullptr);
+            }
+            result = vkEndCommandBuffer(command);
+            require(result == VK_SUCCESS, "command end", result);
+            VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+            submit.commandBufferCount = 1;
+            submit.pCommandBuffers = &command;
+            result = vkQueueSubmit(device_queue, 1, &submit, VK_NULL_HANDLE);
+            require(result == VK_SUCCESS, "command submit", result);
+            result = vkQueueWaitIdle(device_queue);
+            require(result == VK_SUCCESS, "command completion", result);
+            if (xfb) {
+               for (unsigned i = 0; i < expected_capture.size(); i++) {
+                  if (capture_map[i] != expected_capture[i])
+                     std::fprintf(stderr, "XFB[%u]=%f expected=%f\n", i,
+                                  capture_map[i], expected_capture[i]);
+                  require(capture_map[i] == expected_capture[i], "XFB dynamic adjacency capture");
+               }
+               require(capture_map[expected_capture.size()] == -1000.0f,
+                       "XFB capture bound");
+               vkUnmapMemory(device, capture_memory);
+               vkDestroyBuffer(device, capture, nullptr);
+               vkFreeMemory(device, capture_memory, nullptr);
+            }
+            std::printf("dynamic scenario=%u reload=%u passed\n", scenario, reload);
+            vkDestroyCommandPool(device, pool, nullptr);
+            vkDestroyPipeline(device, pipeline, nullptr);
+            if (reload == 0) {
+               size_t size = 0;
+               result = vkGetPipelineCacheData(device, cache, &size, nullptr);
+               require(result == VK_SUCCESS, "dynamic cache size", result);
+               std::vector<uint8_t> bytes(size);
+               result = vkGetPipelineCacheData(device, cache, &size, bytes.data());
+               require(result == VK_SUCCESS, "dynamic cache serialization", result);
+               vkDestroyPipelineCache(device, cache, nullptr);
+               cache_info.initialDataSize = size;
+               cache_info.pInitialData = bytes.data();
+               result = vkCreatePipelineCache(device, &cache_info, nullptr, &cache);
+               require(result == VK_SUCCESS, "dynamic cache reload", result);
+               result = vkCreateGraphicsPipelines(device, cache, 1, &pipeline_info, nullptr, &pipeline);
+               require(result == VK_SUCCESS, "dynamic cached pipeline", result);
+            }
+         }
+
+         /* GPL libraries serialize deferred NIR.  Final executable pairs are
+          * cached for the device lifetime and reconstructed only on a cold
+          * final link, not while creating a partial library or drawing. */
+         std::vector<uint8_t> library_bytes;
+         const kk_shader *linked_owner = nullptr;
+         for (unsigned reload = 0; reload < 2; reload++) {
+            VkPipelineCacheCreateInfo library_cache_info{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+            library_cache_info.initialDataSize = library_bytes.size();
+            library_cache_info.pInitialData = library_bytes.data();
+            VkPipelineCache library_cache = VK_NULL_HANDLE;
+            result = vkCreatePipelineCache(device, &library_cache_info, nullptr, &library_cache);
+            require(result == VK_SUCCESS, "GPL cache", result);
+            VkGraphicsPipelineLibraryCreateInfoEXT subsets{
+               VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_LIBRARY_CREATE_INFO_EXT};
+            subsets.pNext = &rendering;
+            subsets.flags = VK_GRAPHICS_PIPELINE_LIBRARY_VERTEX_INPUT_INTERFACE_BIT_EXT |
+                            VK_GRAPHICS_PIPELINE_LIBRARY_PRE_RASTERIZATION_SHADERS_BIT_EXT |
+                            VK_GRAPHICS_PIPELINE_LIBRARY_FRAGMENT_SHADER_BIT_EXT |
+                            VK_GRAPHICS_PIPELINE_LIBRARY_FRAGMENT_OUTPUT_INTERFACE_BIT_EXT;
+            auto library_info = pipeline_info;
+            auto library_ia = ia;
+            if (reload && !gs && !tess)
+               library_ia.topology = VK_PRIMITIVE_TOPOLOGY_LINE_STRIP_WITH_ADJACENCY;
+            library_info.pInputAssemblyState = &library_ia;
+            library_info.pNext = &subsets;
+            library_info.flags = VK_PIPELINE_CREATE_LIBRARY_BIT_KHR;
+            if (reload)
+               library_info.flags |= VK_PIPELINE_CREATE_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT;
+            VkPipeline library = VK_NULL_HANDLE;
+            result = vkCreateGraphicsPipelines(device, library_cache, 1, &library_info,
+                                               nullptr, &library);
+            require(result == VK_SUCCESS, "GPL deferred library", result);
+            kk_test_assert_deferred_pipeline(library);
+
+            VkPipelineLibraryCreateInfoKHR libraries{VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR};
+            libraries.libraryCount = 1;
+            libraries.pLibraries = &library;
+            VkGraphicsPipelineCreateInfo final_info{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+            final_info.pNext = &libraries;
+            final_info.layout = layout;
+            final_info.flags = VK_PIPELINE_CREATE_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT;
+            VkPipeline final_pipeline = VK_NULL_HANDLE;
+            result = vkCreateGraphicsPipelines(device, library_cache, 1, &final_info,
+                                               nullptr, &final_pipeline);
+            require(result == (reload ? VK_SUCCESS : VK_PIPELINE_COMPILE_REQUIRED),
+                    "GPL final cache result", result);
+            if (!reload) {
+               final_info.flags = 0;
+               result = vkCreateGraphicsPipelines(device, library_cache, 1, &final_info,
+                                                  nullptr, &final_pipeline);
+               require(result == VK_SUCCESS, "GPL final pair compile", result);
+               final_info.flags = VK_PIPELINE_CREATE_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT;
+               VkPipeline warm = VK_NULL_HANDLE;
+               result = vkCreateGraphicsPipelines(device, library_cache, 1, &final_info,
+                                                  nullptr, &warm);
+               require(result == VK_SUCCESS, "GPL warm final cache", result);
+               vkDestroyPipeline(device, warm, nullptr);
+            }
+
+            VkCommandPoolCreateInfo pool_info{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+            pool_info.queueFamilyIndex = queue;
+            VkCommandPool pool = VK_NULL_HANDLE;
+            result = vkCreateCommandPool(device, &pool_info, nullptr, &pool);
+            require(result == VK_SUCCESS, "GPL command pool", result);
+            VkCommandBufferAllocateInfo allocate{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+            allocate.commandPool = pool;
+            allocate.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+            allocate.commandBufferCount = 1;
+            VkCommandBuffer command = VK_NULL_HANDLE;
+            result = vkAllocateCommandBuffers(device, &allocate, &command);
+            require(result == VK_SUCCESS, "GPL command allocation", result);
+            VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+            begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+            result = vkBeginCommandBuffer(command, &begin);
+            require(result == VK_SUCCESS, "GPL command begin", result);
+            VkRenderingInfo render{VK_STRUCTURE_TYPE_RENDERING_INFO};
+            render.renderArea.extent = {8, 8};
+            render.layerCount = 1;
+            vkCmdBeginRendering(command, &render);
+            vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, final_pipeline);
+            const kk_shader *owner = kk_test_bound_vertex_shader(command);
+            kk_test_assert_line_owner(owner, !gs && !tess && !xfb);
+            if (reload)
+               require(owner == linked_owner, "GPL final pair lifetime");
+            linked_owner = owner;
+            const VkViewport viewport{0, 0, 8, 8, 0, 1};
+            const VkRect2D scissor{{0, 0}, {8, 8}};
+            vkCmdSetViewport(command, 0, 1, &viewport);
+            vkCmdSetScissor(command, 0, 1, &scissor);
+            vkCmdSetPrimitiveTopology(command, ia.topology);
+            vkCmdSetSampleLocationsEnableEXT(command, VK_FALSE);
+            for (unsigned draw = 0; draw < 3; draw++) {
+               vkCmdSetProvokingVertexModeEXT(command, draw == 1
+                  ? VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT
+                  : VK_PROVOKING_VERTEX_MODE_FIRST_VERTEX_EXT);
+               vkCmdSetLineStippleEnableEXT(command, draw == 1);
+               vkCmdDraw(command, gs || tess ? 3 : 2, 1, 0, 0);
+               kk_test_assert_line_variant(command, owner, draw == 1, 4);
+            }
+            vkCmdEndRendering(command);
+            result = vkEndCommandBuffer(command);
+            require(result == VK_SUCCESS, "GPL command end", result);
+            VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+            submit.commandBufferCount = 1;
+            submit.pCommandBuffers = &command;
+            result = vkQueueSubmit(device_queue, 1, &submit, VK_NULL_HANDLE);
+            require(result == VK_SUCCESS, "GPL command submit", result);
+            result = vkQueueWaitIdle(device_queue);
+            require(result == VK_SUCCESS, "GPL command completion", result);
+            vkDestroyCommandPool(device, pool, nullptr);
+            vkDestroyPipeline(device, final_pipeline, nullptr);
+            vkDestroyPipeline(device, library, nullptr);
+            size_t size = 0;
+            result = vkGetPipelineCacheData(device, library_cache, &size, nullptr);
+            require(result == VK_SUCCESS, "GPL cache size", result);
+            library_bytes.resize(size);
+            result = vkGetPipelineCacheData(device, library_cache, &size, library_bytes.data());
+            require(result == VK_SUCCESS, "GPL deferred cache serialization", result);
+            vkDestroyPipelineCache(device, library_cache, nullptr);
+            std::printf("GPL scenario=%u reload=%u passed\n", scenario, reload);
+         }
+         vkDestroyPipeline(device, plain_two_samples, nullptr);
+         vkDestroyPipeline(device, plain, nullptr);
+         vkDestroyPipelineCache(device, cache, nullptr);
+      }
+      for (auto module : modules)
+         vkDestroyShaderModule(device, module, nullptr);
+      vkDestroyPipeline(device, compute, nullptr);
+      vkDestroyPipelineLayout(device, layout, nullptr);
+      vkDestroyDevice(device, nullptr);
+   }
+   vkDestroyInstance(instance, nullptr);
+   std::puts("line-raster cache regression passed");
+}
