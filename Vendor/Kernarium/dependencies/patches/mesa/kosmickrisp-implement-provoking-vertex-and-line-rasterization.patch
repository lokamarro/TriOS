+static bool
+kk_lower_smooth_line_store(nir_builder *b, nir_intrinsic_instr *intr,
+                           void *data)
+{
+   struct kk_smooth_line_store_state *state = data;
+   nir_def *value;
+   unsigned component;
+   unsigned write_mask;
+   unsigned src_index;
+   unsigned location;
+   unsigned index;
+   bool floating_point;
+
+   if (intr->intrinsic == nir_intrinsic_store_deref) {
+      nir_deref_instr *deref = nir_src_as_deref(intr->src[0]);
+      nir_variable *var = nir_deref_instr_get_variable(deref);
+      if (!var || var->data.mode != nir_var_shader_out)
+         return false;
+
+      location = var->data.location;
+      index = var->data.index;
+      floating_point = !glsl_type_is_integer(var->type);
+      component = var->data.location_frac;
+      write_mask = nir_intrinsic_write_mask(intr);
+      src_index = 1;
+   } else if (intr->intrinsic == nir_intrinsic_store_output) {
+      nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+      location = sem.location;
+      index = sem.dual_source_blend_index;
+      floating_point =
+         nir_alu_type_get_base_type(nir_intrinsic_src_type(intr)) ==
+         nir_type_float;
+      component = nir_intrinsic_component(intr);
+      write_mask = nir_intrinsic_write_mask(intr);
+      src_index = 0;
+   } else {
+      return false;
+   }
+
+   if (!kk_smooth_line_modulates_output(location, index, floating_point) ||
+       !(write_mask & BITFIELD_BIT(3 - component)))
+      return false;
+
+   value = intr->src[src_index].ssa;
+   unsigned alpha_component = 3 - component;
+   if (alpha_component >= value->num_components)
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *alpha = nir_fmul(b, nir_channel(b, value, alpha_component),
+                             state->coverage);
+   nir_def *covered = value->num_components == 1
+                         ? alpha
+                         : nir_vector_insert_imm(b, value, alpha,
+                                                 alpha_component);
+   nir_src_rewrite(&intr->src[src_index], covered);
+   return true;
+}
+
+/* Apply line coverage before ordinary fragment work.  Stipple is an early
+ * terminate, so discarded samples cannot execute application side effects.
+ * Smooth coverage modulates the source alpha before blend lowering. */
+static void
+kk_lower_line_fs(nir_shader *fs, bool smooth, bool stipple,
+                 bool polygon_edges, bool multisample)
+{
+   if (!smooth && !stipple && !polygon_edges)
+      return;
+
+   nir_builder b =
+      nir_builder_at(nir_before_impl(nir_shader_get_entrypoint(fs)));
+   nir_def *baryc =
+      multisample
+         ? nir_load_barycentric_sample(
+              &b, 32, .interp_mode = INTERP_MODE_NOPERSPECTIVE)
+         : nir_load_barycentric_pixel(
+              &b, 32, .interp_mode = INTERP_MODE_NOPERSPECTIVE);
+   nir_def *line = nir_load_interpolated_input(
+      &b, 4, 32, baryc, nir_imm_int(&b, 0), .base = 0,
+      .dest_type = nir_type_float32,
+      .io_semantics = (nir_io_semantics){
+         .location = VARYING_SLOT_VIEWPORT_MASK,
+         .num_slots = 1,
+      });
+
+   fs->info.inputs_read |= BITFIELD64_BIT(VARYING_SLOT_VIEWPORT_MASK);
+   fs->info.linear_varyings |= BITFIELD64_BIT(VARYING_SLOT_VIEWPORT_MASK);
+
+   if (polygon_edges) {
+      nir_terminate_if(&b, nir_fneu_imm(&b, nir_channel(&b, line, 3), 0.0f));
+      fs->info.fs.uses_discard = true;
+   }
+
+   if (stipple) {
+      nir_def *enabled = kk_load_polygon_point_per_draw(
+         &b, offsetof(struct kk_per_draw_data, line_stipple_enable), 32);
+      nir_def *factor = kk_load_polygon_point_per_draw(
+         &b, offsetof(struct kk_per_draw_data, line_stipple_factor), 32);
+      nir_def *pattern = kk_load_polygon_point_per_draw(
+         &b, offsetof(struct kk_per_draw_data, line_stipple_pattern), 32);
+      factor = nir_umax_imm(&b, factor, 1);
+
+      nir_def *phase = nir_channel(&b, line, 2);
+      nir_def *bit_index = nir_iand_imm(
+         &b, nir_f2u32(&b, nir_fdiv(&b, phase, nir_u2f32(&b, factor))), 15);
+      nir_def *bit = nir_iand_imm(&b, nir_ushr(&b, pattern, bit_index), 1);
+      nir_terminate_if(
+         &b, nir_iand(&b, nir_ine_imm(&b, enabled, 0),
+                      nir_ieq_imm(&b, bit, 0)));
+      fs->info.fs.uses_discard = true;
+   }
+
+   if (smooth) {
+      nir_def *coverage = nir_fsat(
+         &b, nir_fsub(&b,
+                      nir_fadd_imm(&b, nir_channel(&b, line, 1), 0.5f),
+                      nir_fabs(&b, nir_channel(&b, line, 0))));
+      struct kk_smooth_line_store_state state = {.coverage = coverage};
+      nir_shader_intrinsics_pass(fs, kk_lower_smooth_line_store,
+                                 nir_metadata_control_flow, &state);
+   }
+}
