+/* Appends a driver-generated stage to the pipeline's shader list and returns
+ * its index.  Every generated stage takes the same preparation once its
+ * creator has built it: the poly lowering when the creator emits poly
+ * intrinsics, Metal's workarounds, and the driver's IO and descriptor lowering
+ * against the application stage it stands in for.  A NULL lower_as skips that
+ * last step for NIR whose application stage was already lowered. */
+static uint32_t
+kk_append_generated_stage(struct kk_device *dev, nir_shader **nir_shaders,
+                          uint32_t *total_shaders, nir_shader *nir,
+                          bool lower_poly,
+                          const struct vk_shader_compile_info *lower_as,
+                          const struct vk_graphics_pipeline_state *state)
+{
+   if (lower_poly)
+      NIR_PASS(_, nir, kk_nir_lower_poly);
+   msl_preprocess_nir_workarounds(nir, dev->disabled_workarounds);
+   if (lower_as) {
+      kk_lower_nir(dev, nir, false, lower_as->robustness,
+                   lower_as->set_layout_count, lower_as->set_layouts, state);
+   }
+   nir_shaders[*total_shaders] = nir;
+   return (*total_shaders)++;
+}
