+static bool
+kk_lower_xfb_raster_flat_store(nir_builder *b, nir_intrinsic_instr *intr,
+                               void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_store_output)
+      return false;
+
+   assert(nir_src_is_const(intr->src[1]) && "no indirect raster outputs");
+   const nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+   const unsigned location = sem.location + nir_src_as_uint(intr->src[1]);
+   const struct kk_xfb_raster_flat_state *state = data;
+   if (!(state->flat_outputs & BITFIELD64_BIT(location)))
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *old = intr->src[0].ssa;
+   nir_def *components[NIR_MAX_VEC_COMPONENTS];
+   const unsigned first_component = nir_intrinsic_component(intr);
+   for (unsigned c = 0; c < old->num_components; ++c) {
+      components[c] = kk_load_polygon_point_output(
+         b, state->vertex_params, state->outputs, state->provoking_vertex,
+         location, first_component + c, old->bit_size);
+   }
+
+   nir_src_rewrite(&intr->src[0],
+                   nir_vec(b, components, old->num_components));
+   return true;
+}
