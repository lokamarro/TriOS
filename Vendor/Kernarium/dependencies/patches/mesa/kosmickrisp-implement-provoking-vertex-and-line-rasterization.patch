+static inline bool
+libkk_line_output_sizes(uint32_t count, uint32_t instance_count,
+                        uint64_t vertex_outputs, uint32_t mode,
+                        uint32_t lines_per_primitive,
+                        uint32_t vertices_per_line, bool continuous,
