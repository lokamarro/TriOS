+void kk_test_assert_deferred_pipeline(VkPipeline pipeline);
+void kk_test_assert_static_pipeline(VkPipeline pipeline, bool generated);
+void kk_test_assert_line_owner(const struct kk_shader *owner, bool plain);
+void kk_test_assert_raster_samples(VkPipeline pipeline, uint32_t samples);
