@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: MIT */
+#version 450
+layout(points) in;
+layout(points, max_vertices = 256) out;
+
+/* How many points this emits depends on the primitive, so the geometry
+ * stage cannot use a static topology and writes an index buffer holding
+ * max_vertices entries for every input primitive. */
+void main()
+{
+   for (int i = 0; i < 256; ++i) {
+      if (i > gl_PrimitiveIDIn % 3)
+         break;
+      gl_Position = gl_in[0].gl_Position;
+      gl_PointSize = 1.0;
+      EmitVertex();
+   }
+}
