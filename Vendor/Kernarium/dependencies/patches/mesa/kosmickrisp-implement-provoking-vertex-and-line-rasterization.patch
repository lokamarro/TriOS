+{
+   return state->rs->line.mode == VK_LINE_RASTERIZATION_MODE_RECTANGULAR_KHR ||
+          state->rs->line.mode ==
+             VK_LINE_RASTERIZATION_MODE_RECTANGULAR_SMOOTH_KHR;
+}
+
+/* Metal rasterizes a default or Bresenham line natively only with first-vertex
+ * flat varyings, no stipple and no adjacency.  Anything else goes through the
+ * generated GPU line stage, which forwards flat values from the requested
+ * endpoint without changing the line's coverage and strips adjacency vertices
+ * before rasterization when no API geometry shader consumes them.  This is the
+ * choice for one concrete rasterization state. */
+static inline bool
+kk_line_rs_needs_generated_raster(bool adjacency,
+                                  const struct vk_rasterization_state *rs)
+{
+   return adjacency ||
+          rs->provoking_vertex == VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT ||
+          rs->line.stipple.enable;
+}
+
+/* A pipeline provides the generated line stage when any state it can execute
+ * needs it: rectangular coverage always does, and a dynamic provoking vertex or
+ * stipple enable can select it at draw time.  Pipeline keys and shader
+ * compilation both decide through this rule and differ only in where they read
+ * adjacency. */
+static inline bool
+kk_line_state_needs_generated_raster(
+   bool adjacency, const struct vk_graphics_pipeline_state *state)
+{
+   return kk_line_rs_needs_generated_raster(adjacency, state->rs) ||
+          kk_line_raster_uses_triangles(state) ||
+          BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_PROVOKING_VERTEX) ||
+          BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_LINE_STIPPLE_ENABLE);
+}
+
+static inline bool
+kk_needs_line_raster_emulation(
+   const struct vk_graphics_pipeline_state *state)
+{
+   if (!kk_vk_topology_is_line_class(state->ia->primitive_topology) &&
+       !kk_line_raster_polygon_edges(state))
+      return false;
+
+   /* The key is built before geometry and tessellation stages are known, so
+    * adjacency comes from input assembly.  Routing it through the generated
+    * stage also avoids inserting an index-unroll dispatch between pipelines in
+    * an active render pass. */
+   return kk_line_state_needs_generated_raster(
+      state->ia->primitive_topology ==
+            VK_PRIMITIVE_TOPOLOGY_LINE_LIST_WITH_ADJACENCY ||
+         state->ia->primitive_topology ==
+            VK_PRIMITIVE_TOPOLOGY_LINE_STRIP_WITH_ADJACENCY,
+      state);
+}
+
+static inline bool
+kk_line_raster_has_native_variant(
+   const struct vk_graphics_pipeline_state *state,
+   enum mesa_prim raster_primitive, bool fixed_raster_primitive)
+{
+   const enum mesa_prim reduced = u_reduced_prim(raster_primitive);
+   if (reduced != MESA_PRIM_LINES &&
+       !(reduced == MESA_PRIM_TRIANGLES &&
+         state->rs->polygon_mode == VK_POLYGON_MODE_LINE))
+      return false;
+
+   const bool dynamic_provoking =
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_PROVOKING_VERTEX);
+   const bool dynamic_stipple =
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_RS_LINE_STIPPLE_ENABLE);
+   const bool dynamic_topology =
+      !fixed_raster_primitive &&
+      BITSET_TEST(state->dynamic, MESA_VK_DYNAMIC_IA_PRIMITIVE_TOPOLOGY);
+
+   /* Static rectangular/smooth coverage, LAST, stipple, and adjacency have
+    * no native execution state.  Only reachable alternatives are compiled. */
+   return (dynamic_provoking || dynamic_stipple || dynamic_topology) &&
+          !kk_line_raster_uses_triangles(state) &&
+          (dynamic_provoking || state->rs->provoking_vertex ==
+                                    VK_PROVOKING_VERTEX_MODE_FIRST_VERTEX_EXT) &&
+          (dynamic_stipple || !state->rs->line.stipple.enable) &&
+          (dynamic_topology || !mesa_prim_has_adjacency(raster_primitive));
+}
+
+static inline bool
+kk_line_raster_select_generated(enum mesa_prim raster_primitive,
+                                const struct vk_rasterization_state *rs)
+{
+   return kk_line_rs_needs_generated_raster(
+      mesa_prim_has_adjacency(raster_primitive), rs);
+}
