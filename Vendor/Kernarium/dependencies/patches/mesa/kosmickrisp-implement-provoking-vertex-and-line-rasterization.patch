@@ -0,0 +1,7 @@
+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+cd -- "$(dirname -- "$0")"
+for shader in cache.vert xfb.vert cache.frag cache.comp lines.geom triangles.geom cache.tesc lines.tese triangles.tese; do
