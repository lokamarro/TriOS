+/* Synthetic XFB geometry must cover every topology in its Vulkan class.
+ * Adjacency is dynamic even though ordinary API GS input arity is fixed by
+ * the shader.  Apply this mapping only to the synthetic pass-through stage. */
+static nir_def *
+kk_xfb_input_vertex(nir_builder *b, enum mesa_prim primitive,
+                    nir_def *topology, nir_def *prim, nir_def *corner,
+                    nir_def *nr, nir_def *flatshade_first)
+{
+   switch (u_reduced_prim(primitive)) {
+   case MESA_PRIM_LINES: {
+      nir_def *adjacent = nir_ior(
+         b, nir_ieq_imm(b, topology, MESA_PRIM_LINES_ADJACENCY),
+         nir_ieq_imm(b, topology, MESA_PRIM_LINE_STRIP_ADJACENCY));
+      return nir_bcsel(
+         b, adjacent,
+         poly_vertex_id_for_line_adj_class(
+            b, topology, prim, nir_iadd_imm(b, corner, 1)),
+         poly_vertex_id_for_line_class(b, topology, prim, corner, nr));
+   }
+   case MESA_PRIM_TRIANGLES: {
+      nir_def *adjacent = nir_ior(
+         b, nir_ieq_imm(b, topology, MESA_PRIM_TRIANGLES_ADJACENCY),
+         nir_ieq_imm(b, topology, MESA_PRIM_TRIANGLE_STRIP_ADJACENCY));
+      return nir_bcsel(
+         b, adjacent,
+         poly_vertex_id_for_tri_adj_class(
+            b, topology, prim, nir_imul_imm(b, corner, 2), nr,
+            flatshade_first),
+         poly_vertex_id_for_tri_class(b, topology, prim, corner,
+                                      flatshade_first));
+   }
+   default:
+      return prim;
+   }
+}
