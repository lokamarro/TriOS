diff --git a/src/kosmickrisp/vulkan/kk_descriptor_set.c b/src/kosmickrisp/vulkan/kk_descriptor_set.c
index 570d4eeb85b00255b32632b1dcb6fa836268a387..df5a21d42cfd861cab2da0b9fd114a29926bda4e 100644
--- a/src/kosmickrisp/vulkan/kk_descriptor_set.c
+++ b/src/kosmickrisp/vulkan/kk_descriptor_set.c
@@ -60,6 +60,9 @@ get_sampled_image_view_desc(VkDescriptorType descriptor_type,
    struct kk_sampled_image_descriptor desc[3] = {};
    uint8_t plane_count = 1;
 
+   for (uint8_t plane = 0; plane < ARRAY_SIZE(desc); plane++)
+      desc[plane].clamp_0_sampler_index_or_negative = -1;
+
    if (descriptor_type != VK_DESCRIPTOR_TYPE_SAMPLER && info &&
        info->imageView != VK_NULL_HANDLE) {
       VK_FROM_HANDLE(kk_image_view, view, info->imageView);
@@ -82,7 +85,10 @@ get_sampled_image_view_desc(VkDescriptorType descriptor_type,
        descriptor_type == VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER) {
       VK_FROM_HANDLE(kk_sampler, sampler, info->sampler);
 
-      plane_count = MAX2(plane_count, sampler->plane_count);
+      if (sampler->has_border)
+         assert(plane_count == 1);
+      else
+         plane_count = MAX2(plane_count, sampler->plane_count);
 
       for (uint8_t plane = 0; plane < plane_count; plane++) {
          /* We need to replicate the last sampler plane out to all image
@@ -96,6 +102,17 @@ get_sampled_image_view_desc(VkDescriptorType descriptor_type,
          desc[plane].lod_min_fp16 = sampler->lod_min_fp16;
          desc[plane].lod_max_fp16 = sampler->lod_max_fp16;
       }
+
+      if (sampler->has_border) {
+         assert(sampler->plane_count == 2);
+         desc[0].clamp_0_sampler_index_or_negative = kk_pack_border_emulation(
+            sampler->planes[1].hw->index, sampler->border_compare_op);
+
+         static_assert(sizeof(desc[0].border) == sizeof(sampler->custom_border),
+                       "fixed format");
+         memcpy(desc[0].border, sampler->custom_border.uint32,
+                sizeof(sampler->custom_border));
+      }
    }
 
    assert(sizeof(desc[0]) * plane_count <= dst_size);
diff --git a/src/kosmickrisp/vulkan/kk_descriptor_types.h b/src/kosmickrisp/vulkan/kk_descriptor_types.h
index 5296366c8c68455cc055e906b500f84d6714c048..8cd9f485f258d52cd8d57e3ae50b52b6eaebd156 100644
--- a/src/kosmickrisp/vulkan/kk_descriptor_types.h
+++ b/src/kosmickrisp/vulkan/kk_descriptor_types.h
@@ -16,7 +16,11 @@ struct kk_sampled_image_descriptor {
    uint16_t lod_bias_fp16;
    uint16_t lod_min_fp16;
    uint16_t lod_max_fp16;
-   uint32_t has_border;
+   /* Negative for an ordinary sampler. Otherwise the low bits are the sampler
+    * index for the transparent-black half of custom-border emulation and the
+    * high bits carry the sampler's compare operation, which a depth-compare
+    * sample needs in order to evaluate the emulated border itself. */
+   int32_t clamp_0_sampler_index_or_negative;
    uint32_t pad_to_64_bits;
    uint32_t border[4];
    uint64_t pad_to_power_2[3];
@@ -42,4 +46,36 @@ struct kk_buffer_address {
 static_assert(sizeof(struct kk_buffer_address) == 16,
               "kk_buffer_address has no holes");
 
+#define KK_BORDER_SAMPLER_INDEX_BITS 16u
+#define KK_BORDER_SAMPLER_INDEX_MASK BITFIELD_MASK(KK_BORDER_SAMPLER_INDEX_BITS)
+#define KK_BORDER_COMPARE_OP_SHIFT KK_BORDER_SAMPLER_INDEX_BITS
+#define KK_BORDER_COMPARE_OP_MASK 7u
+
+/* VkCompareOp is a three-bit mask of the orderings that pass. */
+#define KK_COMPARE_LESS 1u
+#define KK_COMPARE_EQUAL 2u
+#define KK_COMPARE_GREATER 4u
+
+static_assert(VK_COMPARE_OP_NEVER == 0, "compare operations are an ordering mask");
+static_assert(VK_COMPARE_OP_LESS == KK_COMPARE_LESS, "ordering mask");
+static_assert(VK_COMPARE_OP_EQUAL == KK_COMPARE_EQUAL, "ordering mask");
+static_assert(VK_COMPARE_OP_LESS_OR_EQUAL == (KK_COMPARE_LESS | KK_COMPARE_EQUAL),
+              "ordering mask");
+static_assert(VK_COMPARE_OP_GREATER == KK_COMPARE_GREATER, "ordering mask");
+static_assert(VK_COMPARE_OP_NOT_EQUAL == (KK_COMPARE_LESS | KK_COMPARE_GREATER),
+              "ordering mask");
+static_assert(VK_COMPARE_OP_GREATER_OR_EQUAL ==
+                 (KK_COMPARE_EQUAL | KK_COMPARE_GREATER),
+              "ordering mask");
+static_assert(VK_COMPARE_OP_ALWAYS == KK_BORDER_COMPARE_OP_MASK, "ordering mask");
+
+static inline int32_t
+kk_pack_border_emulation(uint32_t sampler_index, VkCompareOp compare_op)
+{
+   assert(sampler_index <= KK_BORDER_SAMPLER_INDEX_MASK);
+   assert((uint32_t)compare_op <= KK_BORDER_COMPARE_OP_MASK);
+   return (int32_t)(sampler_index |
+                    ((uint32_t)compare_op << KK_BORDER_COMPARE_OP_SHIFT));
+}
+
 #endif /* KK_DESCRIPTOR_TYPES */
diff --git a/src/kosmickrisp/vulkan/kk_nir_lower_custom_border.c b/src/kosmickrisp/vulkan/kk_nir_lower_custom_border.c
new file mode 100644
index 0000000000000000000000000000000000000000..179808d489c6f9f1bc56624023e13ed79fb5c204
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_nir_lower_custom_border.c
@@ -0,0 +1,217 @@
+/*
+ * Copyright 2025 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Metal samplers only offer transparent black, opaque black and opaque white
+ * borders, so an arbitrary Vulkan border colour is reconstructed in the
+ * shader from two samples of the same footprint: one taken with the white
+ * border and one with the transparent-black border.
+ */
+
+#include "kk_shader.h"
+
+#include "kk_descriptor_types.h"
+
+#include "nir_builder.h"
+#include "nir_builtin_builder.h"
+
+static nir_def *
+query_custom_border(nir_builder *b, nir_tex_instr *tex)
+{
+   return nir_build_texture_query(b, tex, nir_texop_custom_border_color_agx, 4,
+                                  tex->dest_type, false, false);
+}
+
+static nir_def *
+has_custom_border(nir_builder *b, nir_tex_instr *tex)
+{
+   return nir_build_texture_query(b, tex, nir_texop_has_custom_border_color_agx,
+                                  1, nir_type_bool1, false, false);
+}
+
+nir_def *
+kk_nir_border_compare_op(nir_builder *b, nir_def *packed)
+{
+   return nir_iand_imm(
+      b, nir_ushr_imm(b, packed, KK_BORDER_COMPARE_OP_SHIFT),
+      KK_BORDER_COMPARE_OP_MASK);
+}
+
+/* The raw sampler descriptor carries the packed border word in its third
+ * dword.  Keep the has-custom-border query boolean and extract the integer
+ * compare operation from the descriptor instead.
+ */
+static nir_def *
+query_border_compare_op(nir_builder *b, nir_tex_instr *tex)
+{
+   nir_def *descriptor = nir_build_texture_query(
+      b, tex, nir_texop_sampler_descriptor_amd, 4, nir_type_uint32,
+      false, false);
+   return kk_nir_border_compare_op(b, nir_channel(b, descriptor, 2));
+}
+
+/* VkCompareOp is a three-bit mask of the orderings that pass, so the dynamic
+ * operation costs three comparisons rather than a switch. */
+nir_def *
+kk_nir_border_compare(nir_builder *b, nir_def *op, nir_def *reference,
+                      nir_def *value)
+{
+   nir_def *passes = nir_iand(
+      b, nir_ine_imm(b, nir_iand_imm(b, op, KK_COMPARE_LESS), 0),
+      nir_flt(b, reference, value));
+
+   passes = nir_ior(
+      b, passes,
+      nir_iand(b, nir_ine_imm(b, nir_iand_imm(b, op, KK_COMPARE_EQUAL), 0),
+               nir_feq(b, reference, value)));
+
+   passes = nir_ior(
+      b, passes,
+      nir_iand(b, nir_ine_imm(b, nir_iand_imm(b, op, KK_COMPARE_GREATER), 0),
+               nir_flt(b, value, reference)));
+
+   return nir_b2fN(b, passes, reference->bit_size);
+}
+
+/* Metal only offers a 0.0 and a 1.0 border, so the emulation recovers the
+ * border's filter weight from two probes taken at a reference value those two
+ * borders answer differently.  Every operation except the constant ones has
+ * such a reference. */
+nir_def *
+kk_nir_border_probe_reference(nir_builder *b, nir_def *op, unsigned bit_size)
+{
+   nir_def *equality =
+      nir_ior(b, nir_ieq_imm(b, op, VK_COMPARE_OP_EQUAL),
+              nir_ieq_imm(b, op, VK_COMPARE_OP_NOT_EQUAL));
+   return nir_bcsel(b, equality, nir_imm_floatN_t(b, 0.0, bit_size),
+                    nir_imm_floatN_t(b, 0.5, bit_size));
+}
+
+static nir_tex_instr *
+clone_probe(nir_builder *b, nir_tex_instr *tex, nir_def *reference,
+            bool clamp_to_0)
+{
+   nir_instr *instr = nir_instr_clone(b->shader, &tex->instr);
+   nir_builder_instr_insert(b, instr);
+
+   nir_tex_instr *probe = nir_instr_as_tex(instr);
+   if (clamp_to_0)
+      probe->backend_flags |= KK_TEXTURE_FLAG_CLAMP_TO_0;
+
+   if (reference) {
+      const int index = nir_tex_instr_src_index(probe, nir_tex_src_comparator);
+      assert(index >= 0);
+      nir_src_rewrite(&probe->src[index].src, reference);
+   }
+
+   return probe;
+}
+
+static nir_def *
+lower_color_border(nir_builder *b, nir_tex_instr *tex, nir_def *clamp_to_1)
+{
+   nir_tex_instr *probe = clone_probe(b, tex, NULL, true);
+   nir_def *clamp_to_0 = &probe->def;
+
+   nir_def *border = query_custom_border(b, probe);
+   if (tex->op == nir_texop_tg4)
+      border = nir_replicate(b, nir_channel(b, border, tex->component), 4);
+
+   if (nir_alu_type_get_base_type(tex->dest_type) == nir_type_float &&
+       tex->op != nir_texop_tg4) {
+      b->shader->info.flrp_lowered = false;
+      return nir_flrp(b, clamp_to_0, clamp_to_1, border);
+   }
+
+   return nir_bcsel(b, nir_ieq(b, clamp_to_0, clamp_to_1), clamp_to_0, border);
+}
+
+/* A depth-compare sample returns the comparison, not the texel, so the border
+ * colour cannot simply be blended in.  The result is the weighted sum of the
+ * per-texel comparisons, which is linear in the border's filter weight:
+ *
+ *    result = interior + weight * compare(reference, border)
+ *
+ * Two extra probes taken at a reference value that the 0.0 and 1.0 Metal
+ * borders answer differently recover that weight, because their interior
+ * contributions are identical and cancel.  The white-border sample already
+ * taken then supplies the interior term.
+ */
+static nir_def *
+lower_shadow_border(nir_builder *b, nir_tex_instr *tex, nir_def *clamp_to_1)
+{
+   nir_def *reference = nir_get_tex_src(tex, nir_tex_src_comparator);
+   assert(reference);
+
+   nir_def *op = query_border_compare_op(b, tex);
+   nir_def *border = nir_channel(b, query_custom_border(b, tex), 0);
+   if (border->bit_size != reference->bit_size) {
+      border = nir_convert_to_bit_size(b, border, nir_type_float,
+                                       reference->bit_size);
+   }
+
+   nir_def *probe_reference =
+      kk_nir_border_probe_reference(b, op, reference->bit_size);
+
+   nir_def *white = &clone_probe(b, tex, probe_reference, false)->def;
+   nir_def *black = &clone_probe(b, tex, probe_reference, true)->def;
+   nir_def *weight = nir_fabs(b, nir_fsub(b, white, black));
+
+   nir_def *emulated = kk_nir_border_compare(b, op, reference, border);
+   nir_def *opaque_white = kk_nir_border_compare(
+      b, op, reference, nir_imm_floatN_t(b, 1.0, reference->bit_size));
+   nir_def *delta = nir_fsub(b, emulated, opaque_white);
+   if (delta->bit_size != clamp_to_1->bit_size) {
+      delta = nir_convert_to_bit_size(b, delta, nir_type_float,
+                                      clamp_to_1->bit_size);
+   }
+
+   return nir_fadd(
+      b, clamp_to_1,
+      nir_fmul(b, weight,
+               nir_replicate(b, delta, clamp_to_1->num_components)));
+}
+
+static bool
+lower_custom_border(nir_builder *b, nir_tex_instr *tex, UNUSED void *data)
+{
+   if (!nir_tex_instr_need_sampler(tex) || nir_tex_instr_is_query(tex))
+      return false;
+
+   /* A sparse result appends a residency code that this reconstruction would
+    * corrupt.  KosmicKrisp does not expose sparse residency. */
+   if (tex->is_sparse)
+      return false;
+
+   /* Reconstructing a depth comparison needs the reference value, which a
+    * legacy shadow sample keeps inside its coordinate.  SPIR-V only produces
+    * the separate comparator. */
+   if (tex->is_shadow &&
+       nir_tex_instr_src_index(tex, nir_tex_src_comparator) < 0)
+      return false;
+
+   b->cursor = nir_after_instr(&tex->instr);
+   nir_def *has_custom = has_custom_border(b, tex);
+
+   nir_instr *orig = nir_instr_clone(b->shader, &tex->instr);
+   nir_builder_instr_insert(b, orig);
+   nir_def *clamp_to_1 = &nir_instr_as_tex(orig)->def;
+
+   nir_push_if(b, has_custom);
+   nir_def *replaced = tex->is_shadow
+                          ? lower_shadow_border(b, tex, clamp_to_1)
+                          : lower_color_border(b, tex, clamp_to_1);
+   nir_pop_if(b, NULL);
+
+   nir_def *phi = nir_if_phi(b, replaced, clamp_to_1);
+   nir_def_replace(&tex->def, phi);
+   return true;
+}
+
+bool
+kk_nir_lower_custom_border(nir_shader *nir)
+{
+   return nir_shader_tex_pass(nir, lower_custom_border, nir_metadata_none,
+                              NULL);
+}
