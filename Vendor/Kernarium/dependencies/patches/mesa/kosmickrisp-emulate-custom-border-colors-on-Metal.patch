       unsigned offs = offsetof(struct kk_sampled_image_descriptor, border);
@@ -569,9 +579,20 @@ lower_tex(nir_builder *b, nir_tex_instr *tex,
       unsigned offs =
          offsetof(struct kk_sampled_image_descriptor, sampler_index);
 
+      const bool clamp_to_0 =
+         tex->backend_flags & KK_TEXTURE_FLAG_CLAMP_TO_0;
