From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 19 Sep 2026 11:42:25 +0900
Subject: [PATCH] kosmickrisp: never wait forever for a query a failure
 destroyed

A query becomes available through a GPU write inside a submitted command
buffer. When Metal fails that submission the write is destroyed, and no
report ever names the query: the queue reports submissions, not the
memory they were going to touch. vkGetQueryPoolResults with
VK_QUERY_RESULT_WAIT_BIT then polled forever, which is how one killed
submission froze a Vulkan CTS fraction inside
query_pool.statistics_query with the guest silent and nothing left to
time out.

A queue that has failed therefore bounds the wait, and one that has not
still waits as long as the submission takes. The wait uses the timeline
recovery's bound, which moves to kk_queue.h as KK_LOST_WORK_TIMEOUT_NS
with its one justification: it is over two orders of magnitude above any
submission that completes on the tightest device this driver targets, so
it cannot fire on a healthy submission. Past it the call reports
VK_ERROR_DEVICE_LOST for that query rather than holding its caller, which
is what Vulkan offers for a result the implementation cannot produce.

The queue records whether it has ever failed separately from the failure
count the signal recovery uses, because that count is cleared when a
retired queue is replaced while a write the old queue destroyed stays
destroyed.
---
 src/kosmickrisp/vulkan/kk_query_pool.c | 31 ++++++++++++++++++++++++--
 src/kosmickrisp/vulkan/kk_queue.c      | 15 +++++++++++++
 src/kosmickrisp/vulkan/kk_queue.h      | 22 ++++++++++++++++++
 src/kosmickrisp/vulkan/kk_sync.c       | 15 +++++--------
 4 files changed, 71 insertions(+), 12 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_query_pool.c b/src/kosmickrisp/vulkan/kk_query_pool.c
index 2320bb72690547cf5ccb617b527dd29ba5ba437e..82cb7d5501a5fa0ef3d90107bf1fa8d76e7947ca 100644
--- a/src/kosmickrisp/vulkan/kk_query_pool.c
+++ b/src/kosmickrisp/vulkan/kk_query_pool.c
@@ -16,9 +16,15 @@
 #include "kk_entrypoints.h"
 #include "kk_physical_device.h"
 #include "kk_query_table.h"
+#include "kk_queue.h"
 
 #include "kosmickrisp/bridge/mtl_bridge.h"
 
+#include "util/os_time.h"
+
+#include <inttypes.h>
+#include <stdio.h>
+
 struct kk_query_report {
    uint64_t value;
 };
@@ -658,8 +664,15 @@ static VkResult
 kk_query_wait_for_available(struct kk_device *dev, struct kk_query_pool *pool,
                             uint32_t query)
 {
-   /* WAIT has no timeout. The queue's native completion handler reports an
-    * actual device failure; a slow submission must not manufacture one. */
+   /* WAIT has no timeout of its own. The queue's native completion handler
+    * reports an actual device failure; a slow submission must not manufacture
+    * one. What it cannot report is a GPU write it destroyed: a query becomes
+    * available through a write inside a submitted command buffer, and no
+    * report names the query that write was for. So a queue that has failed
+    * bounds the wait by KK_LOST_WORK_TIMEOUT_NS, and a queue that has not
+    * waits as long as it takes. */
+   uint64_t unavailable_since = 0u;
+
    for (;;) {
       if (kk_query_is_available(dev, pool, query))
          return VK_SUCCESS;
@@ -668,6 +681,20 @@ kk_query_wait_for_available(struct kk_device *dev, struct kk_query_pool *pool,
       if (status != VK_SUCCESS)
          return status;
 
+      if (dev->has_queue && kk_queue_has_failed(&dev->queue)) {
+         uint64_t now = os_time_get_nano();
+         if (unavailable_since == 0u) {
+            unavailable_since = now;
+         } else if (now - unavailable_since >= KK_LOST_WORK_TIMEOUT_NS) {
+            fprintf(stderr,
+                    "KosmicKrisp gave up on a query a failed Metal submission "
+                    "never made available after %" PRIu64
+                    " s, so its caller is not held forever\n",
+                    KK_LOST_WORK_TIMEOUT_NS / 1000000000ull);
+            return VK_ERROR_DEVICE_LOST;
+         }
+      }
+
       os_time_sleep(50);
    }
 }
diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index 73bd1f010677394f5421bc268fe49771d124ea14..9ff92971b59aab4a60b927275f1ec28ce50bb46d 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -120,6 +120,20 @@ kk_queue_signals_make_good(struct kk_queue_feedback *feedback,
    return made_good;
 }
 
+bool
+kk_queue_has_failed(struct kk_queue *queue)
+{
+   struct kk_queue_feedback *feedback = queue->feedback;
+   if (!feedback)
+      return false;
+
+   simple_mtx_lock(&feedback->signal_mutex);
+   bool failed = feedback->ever_failed;
+   simple_mtx_unlock(&feedback->signal_mutex);
+
+   return failed;
+}
+
 /* Metal reports a failure against one submission, but the work it kills
  * behind that submission does not always arrive as a report of its own. A
  * signal enqueued after the reported one can therefore go missing with
@@ -350,6 +364,7 @@ commit_callback(struct mtl_feedback_data *data)
       /* Survived or not, a failed queue runs nothing more that can be
        * trusted. */
       ++feedback->failures;
+      feedback->ever_failed = true;
       made_good = kk_queue_signals_make_good_locked(
          feedback, lost ? UINT64_MAX : submission->serial);
    } else if (feedback->failures > 0u) {
diff --git a/src/kosmickrisp/vulkan/kk_queue.h b/src/kosmickrisp/vulkan/kk_queue.h
index 015e724e083ea39ca33200b0f709dca558b12d2e..c9cce94231c0b907df59c535ba5859968b60b00a 100644
--- a/src/kosmickrisp/vulkan/kk_queue.h
+++ b/src/kosmickrisp/vulkan/kk_queue.h
@@ -52,6 +52,10 @@ struct kk_queue_feedback {
     * any failure, survived or not, also retires the native queue: the report
     * counts it, the submit thread acts on it and clears the count. */
    uint32_t failures;
+   /* Whether Metal has ever failed a submission on this device's queue.
+    * Unlike failures, this is never cleared: a GPU write destroyed by a
+    * failure stays destroyed after the queue that lost it is retired. */
+   bool ever_failed;
 };
 
 /* Per-submission feedback payload. Metal reports a failure against one
@@ -89,6 +93,24 @@ kk_queue_device(struct kk_queue *queue)
 uint64_t kk_queue_complete_owed_signals(struct kk_queue *queue,
                                         mtl_shared_event *event);
 
+/* Whether Metal has ever failed a submission on this queue.
+ *
+ * A failure destroys the work the submission had not run, including GPU writes
+ * a caller is waiting to observe directly in memory rather than through a
+ * timeline. Such a caller cannot be told the write is gone - nothing names it -
+ * so it needs this to know that waiting longer cannot produce it. */
+bool kk_queue_has_failed(struct kk_queue *queue);
+
+/* How long a waiter gives work a failed queue still owes it - a timeline
+ * signal (kk_sync.c) or a query's availability write (kk_query_pool.c) -
+ * before it treats that work as destroyed. The bound is over two orders of
+ * magnitude above any submission that runs to completion on the tightest
+ * device this driver targets, whose GPU stops a command buffer after tens of
+ * milliseconds, so work a healthy submission is still on its way to finishing
+ * is never given up on, and it costs nothing on a queue that has never
+ * failed. */
+#define KK_LOST_WORK_TIMEOUT_NS (10ull * 1000000000ull)
+
 VkResult kk_queue_init(struct kk_device *dev, struct kk_queue *queue,
                        const VkDeviceQueueCreateInfo *pCreateInfo,
                        uint32_t index_in_family);
diff --git a/src/kosmickrisp/vulkan/kk_sync.c b/src/kosmickrisp/vulkan/kk_sync.c
index 2f8f5f8c79d08865c8c32ade36d906d428900614..0effa2e9054d3a8f979b4d24f488751529f89505 100644
--- a/src/kosmickrisp/vulkan/kk_sync.c
+++ b/src/kosmickrisp/vulkan/kk_sync.c
@@ -107,14 +107,9 @@ kk_timeline_get_value(struct vk_device *device, struct vk_sync *sync,
  * completes and nothing else notices. A caller waiting on that value is the
  * last thing left that can, because it is the one holding the evidence: the
  * queue accepted a signal for the value and has not delivered it. Waiting
- * longer cannot help, since the signal is not coming, so past this bound the
- * wait completes what the queue owes it and says so.
- *
- * The bound is two orders of magnitude over any submission that runs to
- * completion on the tightest device this driver targets, whose GPU stops a
- * command buffer after tens of milliseconds, and it costs nothing at all on a
- * queue that has never failed. */
-static const uint64_t kk_lost_signal_timeout_ns = 10ull * 1000000000ull;
+ * longer cannot help, since the signal is not coming, so past
+ * KK_LOST_WORK_TIMEOUT_NS the wait completes what the queue owes it and says
+ * so. */
 
 static void
 kk_timeline_recover_lost_signal(struct kk_device *dev,
@@ -145,7 +140,7 @@ kk_timeline_recover_lost_signal(struct kk_device *dev,
    if (timeline->overdue_since == 0u || timeline->stalled_value != signaled) {
       timeline->stalled_value = signaled;
       timeline->overdue_since = now;
-   } else if (now - timeline->overdue_since >= kk_lost_signal_timeout_ns) {
+   } else if (now - timeline->overdue_since >= KK_LOST_WORK_TIMEOUT_NS) {
       timeline->overdue_since = 0u;
       expired = true;
    }
@@ -160,7 +155,7 @@ kk_timeline_recover_lost_signal(struct kk_device *dev,
               "KosmicKrisp completed a timeline signal the queue accepted and "
               "never delivered: value %" PRIu64 ", waited on for %" PRIu64
               " s\n",
-              completed, kk_lost_signal_timeout_ns / 1000000000ull);
+              completed, KK_LOST_WORK_TIMEOUT_NS / 1000000000ull);
    }
 }
 
