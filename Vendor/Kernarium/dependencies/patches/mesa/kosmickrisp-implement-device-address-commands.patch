diff --git a/src/kosmickrisp/vulkan/tests/test_device_address.c b/src/kosmickrisp/vulkan/tests/test_device_address.c
new file mode 100644
index 0000000000000000000000000000000000000000..e263e4acc75cc79c1041d2163e93f7d7b9e5e085
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_device_address.c
@@ -0,0 +1,48 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kosmickrisp/vulkan/kk_device_address.h"
+
+#include <assert.h>
+#include <stdint.h>
+
+int
+main(void)
+{
+   const uint64_t allocation = 0x1000;
+   const uint64_t allocation_size = 0x100;
+
+   assert(kk_device_address_range_contains(allocation, allocation_size,
+                                           allocation, allocation_size));
+   assert(kk_device_address_range_contains(allocation, allocation_size,
+                                           allocation + 0x40, 0x20));
+   assert(!kk_device_address_range_contains(allocation, allocation_size,
+                                            allocation - 1, 1));
+   assert(!kk_device_address_range_contains(allocation, allocation_size,
+                                            allocation + allocation_size, 1));
+   assert(!kk_device_address_range_contains(allocation, allocation_size,
+                                            allocation + 0x80, 0x81));
+
+   /* An empty range is contained at any address up to and including the end
+    * of an allocation. The null range is not inside any allocation: accepting
+    * it is its caller's decision.
+    */
+   assert(!kk_device_address_range_contains(allocation, allocation_size, 0, 0));
+   assert(kk_device_address_range_contains(allocation, allocation_size,
+                                           allocation + allocation_size, 0));
+   assert(!kk_device_address_range_contains(allocation, allocation_size,
+                                            allocation + allocation_size + 1,
+                                            0));
+
+   /* All arithmetic must remain bounded even near the address-space limit. */
+   assert(kk_device_address_range_contains(UINT64_MAX - 0xff, 0x100,
+                                           UINT64_MAX - 0x7f, 0x80));
+   assert(!kk_device_address_range_contains(UINT64_MAX - 0xff, 0x100,
+                                            UINT64_MAX - 0x7f, 0x81));
+   assert(!kk_device_address_range_contains(UINT64_MAX - 0xff, 0x100,
+                                            0x10, 0x10));
+
+   return 0;
+}
