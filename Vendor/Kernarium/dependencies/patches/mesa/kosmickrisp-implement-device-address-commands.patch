diff --git a/src/kosmickrisp/vulkan/kk_device_address.h b/src/kosmickrisp/vulkan/kk_device_address.h
new file mode 100644
index 0000000000000000000000000000000000000000..e5c4fc12b96525c2d58f8d6daeda9e8efe68ad86
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_device_address.h
@@ -0,0 +1,28 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef KK_DEVICE_ADDRESS_H
+#define KK_DEVICE_ADDRESS_H 1
+
+#include <vulkan/vulkan_core.h>
+
+#include <stdbool.h>
+#include <stdint.h>
+
+static inline bool
+kk_device_address_range_contains(uint64_t allocation_address,
+                                 uint64_t allocation_size,
+                                 VkDeviceAddress address, VkDeviceSize size)
+{
+   if (size == 0)
+      return address >= allocation_address &&
+             address - allocation_address <= allocation_size;
+
+   return address >= allocation_address &&
+          address - allocation_address < allocation_size &&
+          size <= allocation_size - (address - allocation_address);
+}
+
+#endif /* KK_DEVICE_ADDRESS_H */
diff --git a/src/kosmickrisp/vulkan/kk_device_memory.c b/src/kosmickrisp/vulkan/kk_device_memory.c
index 0e11cc2479bc913a8d1fe5e108c65e5871bbf510..a52d77379217813115cd017439af5e2f0f5c1544 100644
--- a/src/kosmickrisp/vulkan/kk_device_memory.c
+++ b/src/kosmickrisp/vulkan/kk_device_memory.c
@@ -147,6 +147,10 @@ kk_AllocateMemory(VkDevice device, const VkMemoryAllocateInfo *pAllocateInfo,
          goto fail_alloc;
    }
 
+   simple_mtx_lock(&dev->address_space.mutex);
+   list_addtail(&mem->address_space_link, &dev->address_space.allocations);
+   simple_mtx_unlock(&dev->address_space.mutex);
+
    *pMem = kk_device_memory_to_handle(mem);
 
    return VK_SUCCESS;
@@ -166,11 +170,42 @@ kk_FreeMemory(VkDevice device, VkDeviceMemory _mem,
    if (!mem)
       return;
 
+   simple_mtx_lock(&dev->address_space.mutex);
+   list_del(&mem->address_space_link);
+   simple_mtx_unlock(&dev->address_space.mutex);
+
    kk_destroy_bo(dev, mem->bo);
 
    vk_device_memory_destroy(&dev->vk, pAllocator, &mem->vk);
 }
 
+bool
+kk_device_resolve_address(struct kk_device *dev,
+                          VkDeviceAddressRangeKHR range,
+                          struct kk_device_address *resolved)
+{
+   *resolved = (struct kk_device_address){0};
+
+   if (range.size == 0 && range.address == 0)
+      return true;
+
+   simple_mtx_lock(&dev->address_space.mutex);
+   list_for_each_entry(struct kk_device_memory, mem,
+                       &dev->address_space.allocations, address_space_link) {
+      if (!kk_device_address_range_contains(mem->bo->gpu, mem->vk.size,
+                                            range.address, range.size))
+         continue;
+
+      resolved->buffer = mem->bo->map;
+      resolved->offset = range.address - mem->bo->gpu;
+      simple_mtx_unlock(&dev->address_space.mutex);
+      return true;
+   }
+   simple_mtx_unlock(&dev->address_space.mutex);
+
+   return false;
+}
