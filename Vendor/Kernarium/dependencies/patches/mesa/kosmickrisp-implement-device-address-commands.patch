+VKAPI_ATTR void VKAPI_CALL
+kk_CmdCopyMemoryKHR(VkCommandBuffer commandBuffer,
+                    const VkCopyDeviceMemoryInfoKHR *pCopyMemoryInfo)
+{
+   if (!pCopyMemoryInfo)
+      return;
+
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   mtl_compute_encoder *encoder = cs_get_compute(cmd, true);
+
+   for (uint32_t i = 0; i < pCopyMemoryInfo->regionCount; i++) {
+      const VkDeviceMemoryCopyKHR *region = &pCopyMemoryInfo->pRegions[i];
+      if (region->srcRange.size == 0)
+         continue;
+
+      struct kk_device_address src, dst;
+
+      if (!kk_cmd_resolve_address(cmd, region->srcRange, &src) ||
+          !kk_cmd_resolve_address(cmd, region->dstRange, &dst))
+         return;
+
+      mtl_copy_from_buffer_to_buffer(encoder, src.buffer, src.offset,
+                                     dst.buffer, dst.offset,
+                                     region->srcRange.size);
+   }
+}
+
 struct kk_buffer_image_copy_info {
    struct mtl_buffer_image_copy mtl_data;
    size_t buffer_slice_size_B;
@@ -145,6 +173,146 @@ kk_CmdCopyImageToBuffer2(VkCommandBuffer commandBuffer,
    }
 }
 
+static VkBufferImageCopy2
+kk_memory_image_copy_region(const VkDeviceMemoryImageCopyKHR *region)
+{
+   return (VkBufferImageCopy2){
+      .sType = VK_STRUCTURE_TYPE_BUFFER_IMAGE_COPY_2,
+      .bufferRowLength = region->addressRowLength,
+      .bufferImageHeight = region->addressImageHeight,
+      .imageSubresource = region->imageSubresource,
+      .imageOffset = region->imageOffset,
+      .imageExtent = region->imageExtent,
+   };
+}
+
+/* A copy between device memory and an image, in the direction to_image
+ * names.  Inlined so that each entry point keeps its own loop with the
+ * direction folded away. */
+static ALWAYS_INLINE void
+kk_cmd_copy_memory_image(VkCommandBuffer commandBuffer,
+                         const VkCopyDeviceMemoryImageInfoKHR *pCopyMemoryInfo,
+                         bool to_image)
+{
+   if (!pCopyMemoryInfo)
+      return;
+
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(kk_image, image, pCopyMemoryInfo->image);
+   mtl_compute_encoder *encoder = cs_get_compute(cmd, true);
+
+   for (uint32_t r = 0; r < pCopyMemoryInfo->regionCount; r++) {
+      const VkDeviceMemoryImageCopyKHR *region =
+         &pCopyMemoryInfo->pRegions[r];
+      struct kk_device_address address;
+      if (!kk_cmd_resolve_address(cmd, region->addressRange, &address))
+         return;
+
+      const VkBufferImageCopy2 buffer_region =
+         kk_memory_image_copy_region(region);
+      const uint8_t plane_index = kk_image_memory_aspects_to_plane(
+         image, region->imageSubresource.aspectMask);
+      struct kk_image_plane *plane = &image->planes[plane_index];
+      struct kk_buffer_image_copy_info info =
+         vk_buffer_image_copy_to_mtl_buffer_image_copy(&buffer_region, plane);
+      info.mtl_data.buffer = address.buffer;
+      info.mtl_data.image = plane->mtl_handle;
+      size_t buffer_offset = address.offset;
+
+      kk_foreach_slice(slice, image, imageSubresource)
+      {
+         info.mtl_data.image_slice = slice;
+         info.mtl_data.buffer_offset_B = buffer_offset;
+         if (to_image)
+            mtl_copy_from_buffer_to_texture(encoder, &info.mtl_data);
+         else
+            mtl_copy_from_texture_to_buffer(encoder, &info.mtl_data);
+         buffer_offset += info.buffer_slice_size_B;
+      }
+   }
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdCopyMemoryToImageKHR(
+   VkCommandBuffer commandBuffer,
+   const VkCopyDeviceMemoryImageInfoKHR *pCopyMemoryInfo)
+{
+   kk_cmd_copy_memory_image(commandBuffer, pCopyMemoryInfo, true);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdCopyImageToMemoryKHR(
+   VkCommandBuffer commandBuffer,
+   const VkCopyDeviceMemoryImageInfoKHR *pCopyMemoryInfo)
+{
+   kk_cmd_copy_memory_image(commandBuffer, pCopyMemoryInfo, false);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdUpdateMemoryKHR(VkCommandBuffer commandBuffer,
+                      const VkDeviceAddressRangeKHR *pDstRange,
+                      UNUSED VkAddressCommandFlagsKHR dstFlags,
+                      VkDeviceSize dataSize, const void *pData)
+{
+   if (dataSize == 0)
+      return;
+
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_device_address dst;
+   if (!kk_cmd_resolve_address(cmd, *pDstRange, &dst))
+      return;
+
+   assert(dataSize <= UINT32_MAX);
+   struct kk_ptr src =
+      kk_pool_upload(cmd, pData, dataSize, sizeof(uint32_t));
+   if (!src.gpu)
+      return;
+
+   mtl_compute_encoder *encoder = cs_get_compute(cmd, true);
+   mtl_copy_from_buffer_to_buffer(encoder, src.buffer, src.offset, dst.buffer,
+                                  dst.offset, dataSize);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdFillMemoryKHR(VkCommandBuffer commandBuffer,
+                    const VkDeviceAddressRangeKHR *pDstRange,
+                    UNUSED VkAddressCommandFlagsKHR dstFlags, uint32_t data)
+{
+   if (pDstRange->size == 0)
+      return;
+
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_device_address dst;
+   if (!kk_cmd_resolve_address(cmd, *pDstRange, &dst))
+      return;
+
+   mtl_compute_encoder *encoder = cs_get_compute(cmd, true);
+   const uint8_t byte = data;
+   if (data == byte * 0x01010101u) {
+      mtl_fill_buffer(encoder, dst.buffer, dst.offset, pDstRange->size, byte);
+      return;
+   }
+
+   struct kk_ptr pattern =
+      kk_pool_upload(cmd, &data, sizeof(data), sizeof(data));
+   if (!pattern.gpu)
+      return;
+
+   mtl_copy_from_buffer_to_buffer(encoder, pattern.buffer, pattern.offset,
+                                  dst.buffer, dst.offset, sizeof(data));
+
+   VkDeviceSize filled = sizeof(data);
+   while (filled < pDstRange->size) {
+      mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_BLIT,
+                                       MTL_STAGE_BLIT);
+      const VkDeviceSize copy_size = MIN2(filled, pDstRange->size - filled);
+      mtl_copy_from_buffer_to_buffer(encoder, dst.buffer, dst.offset,
+                                     dst.buffer, dst.offset + filled,
+                                     copy_size);
+      filled += copy_size;
+   }
+}
+
 /* Copies images by doing a texture->buffer->texture transfer. Returns the new
  * buffer offset for subsequent copies. */
