From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 5 Sep 2026 01:03:38 +0900
Subject: [PATCH] kosmickrisp: support incremental present

---
 src/kosmickrisp/vulkan/kk_physical_device.c | 1 +
 src/vulkan/wsi/wsi_common_metal.c           | 6 ++++++
 2 files changed, 7 insertions(+)

diff --git a/src/kosmickrisp/vulkan/kk_physical_device.c b/src/kosmickrisp/vulkan/kk_physical_device.c
index 073e9adb13971b84a3f97b15d987b57d9998bd8f..3b6abef5623321c2b01e71da3b36abcf613c8111 100644
--- a/src/kosmickrisp/vulkan/kk_physical_device.c
+++ b/src/kosmickrisp/vulkan/kk_physical_device.c
@@ -150,6 +150,7 @@ kk_get_device_extensions(const struct kk_instance *instance,
       .KHR_shader_subgroup_uniform_control_flow = true,
       .KHR_shader_untyped_pointers = true,
 #ifdef KK_USE_WSI_PLATFORM
+      .KHR_incremental_present = true,
       .KHR_swapchain = true,
       .KHR_swapchain_maintenance1 = true,
       .KHR_swapchain_mutable_format = true,
diff --git a/src/vulkan/wsi/wsi_common_metal.c b/src/vulkan/wsi/wsi_common_metal.c
index 4fae98800c86997b61affbdfb80db4ef0431b918..0a186282b1a1bee4087ce7a622a84224966943f7 100644
--- a/src/vulkan/wsi/wsi_common_metal.c
+++ b/src/vulkan/wsi/wsi_common_metal.c
@@ -574,6 +574,12 @@ wsi_metal_swapchain_queue_present(struct wsi_swapchain *wsi_chain,
 
    struct wsi_metal_image *image = &chain->images[image_index];
 
+   /* VkPresentRegionKHR is an optimization hint.  A newly acquired Metal
+    * drawable has no preserved contents, so the non-software path must keep
+    * its single full-surface GPU copy rather than add staging or another copy.
+    */
+   (void)damage;
+
    if (wsi_chain->wsi->sw) {
       wsi_metal_layer_blit_and_present(chain->blit_context,
          &image->drawable,
