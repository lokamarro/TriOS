From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 20 Sep 2026 01:05:11 +0900
Subject: [PATCH] kosmickrisp: keep a transform feedback store inside the bound
 buffer

A transform feedback store is addressed by a vertex index the pre-GS
program derives from the bound buffer's capacity, its byte counter and
the output layout.  The counter is application state -- it is copied in
from a counter buffer the application supplies and it survives across
draws -- so every term of that derivation is reachable from a guest, and
the store itself had no bound of its own.

Recompute each store's extent and compare it against the range that was
actually bound.  A write that would leave that range is dropped instead
of reaching memory the driver was never given.
---
 src/kosmickrisp/vulkan/kk_shader.c |  4 +++-
 src/poly/nir/poly_nir.h            |  3 +++
 src/poly/nir/poly_nir_lower_gs.c   | 37 ++++++++++++++++++++++++++++--
 3 files changed, 41 insertions(+), 3 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
index a21e498b39e07ad0a3421107cda0654de53990db..0c7f83164d674f34a3394e8010f1b39a9681d34d 100644
--- a/src/kosmickrisp/vulkan/kk_shader.c
+++ b/src/kosmickrisp/vulkan/kk_shader.c
@@ -3941,7 +3941,9 @@ kk_create_tes_transform_feedback_raster(
          &b, gp, index, nir_imm_int(&b, output.buffer),
          nir_imm_int(&b, xfb->buffers[output.buffer].stride),
          nir_imm_int(&b, output.offset));
-      nir_store_global(&b, nir_channels(&b, value, output.component_mask), addr);
+      poly_nir_xfb_store(&b, output.buffer, addr,
+                         nir_channels(&b, value, output.component_mask),
+                         util_bitcount(output.component_mask) * 4);
    }
    nir_pop_if(&b, NULL);
 
diff --git a/src/poly/nir/poly_nir.h b/src/poly/nir/poly_nir.h
index 60d646511a1fa45d44b1d62614234165a4b28ec9..817d8cc95077d4d2db10a762e7dd328e2aead7fb 100644
--- a/src/poly/nir/poly_nir.h
+++ b/src/poly/nir/poly_nir.h
@@ -108,4 +108,7 @@ poly_passthrough_gs_key_size(uint16_t output_count)
 }
 
 
+void poly_nir_xfb_store(struct nir_builder *b, unsigned buffer,
+                        nir_def *addr, nir_def *value, unsigned bytes);
+
 void poly_nir_passthrough_gs(struct nir_builder *b, const void *key_);
diff --git a/src/poly/nir/poly_nir_lower_gs.c b/src/poly/nir/poly_nir_lower_gs.c
index 0fe3140aada6c0e518104dfabde1d64448042a62..98a3f81f38dd91745535a561ae6a247a66b795b1 100644
--- a/src/poly/nir/poly_nir_lower_gs.c
+++ b/src/poly/nir/poly_nir_lower_gs.c
@@ -214,6 +214,37 @@ load_geometry_param_offset(nir_builder *b, uint32_t offset, uint8_t bytes)
       b, offsetof(struct poly_geometry_params, field),                         \
       sizeof(((struct poly_geometry_params *)0)->field))
 
+/* A transform feedback store is addressed by a vertex index the pre-GS program
+ * derives from the bound buffer's capacity, its byte counter and the output
+ * layout. The counter is application state: it is copied in from a counter
+ * buffer the application supplies and it survives across draws, so every term
+ * of that derivation is reachable from a guest. Recompute the store's own
+ * extent here and compare it against the range that was actually bound, so no
+ * arithmetic upstream of the store can put a write outside the memory the
+ * application gave the driver.
+ */
+void
+poly_nir_xfb_store(nir_builder *b, unsigned buffer, nir_def *addr,
+                   nir_def *value, unsigned bytes)
+{
+   nir_def *base = load_geometry_param_offset(
+      b, offsetof(struct poly_geometry_params, xfb_base_original[buffer]),
+      sizeof(((struct poly_geometry_params *)0)->xfb_base_original[0]));
+   nir_def *size = load_geometry_param_offset(
+      b, offsetof(struct poly_geometry_params, xfb_size[buffer]),
+      sizeof(((struct poly_geometry_params *)0)->xfb_size[0]));
+
+   nir_def *offset = nir_isub(b, addr, base);
+   nir_def *in_bounds =
+      nir_iand(b, nir_uge(b, addr, base),
+               nir_uge(b, nir_u2u64(b, size),
+                       nir_iadd_imm(b, offset, bytes)));
+
+   nir_push_if(b, in_bounds);
+   nir_store_global(b, value, addr);
+   nir_pop_if(b, NULL);
+}
+
 /* Helpers for lowering I/O to variables */
 struct lower_output_to_var_slot {
    nir_variable *output_var;
@@ -979,8 +1010,10 @@ create_gs_rast_shader(const nir_shader *gs, const struct lower_gs_state *state)
                   nir_imm_int(b, buffer), nir_imm_int(b, stride),
                   nir_imm_int(b, output.offset));
 
-               nir_store_global(
-                  b, nir_channels(b, value, output.component_mask), addr);
+               poly_nir_xfb_store(
+                  b, buffer, addr,
+                  nir_channels(b, value, output.component_mask),
+                  util_bitcount(output.component_mask) * 4);
             }
             nir_pop_if(b, NULL);
             nir_pop_if(b, NULL);
