          /* or if has more than just vbo binds and is not a gfx stage */
           (res->vbo_bind_count != bind_count0 && !is_shader_pipline_stage(pipeline)))
          /* sync on next draw */
-         _mesa_set_add(ctx->need_barriers[0], res);
