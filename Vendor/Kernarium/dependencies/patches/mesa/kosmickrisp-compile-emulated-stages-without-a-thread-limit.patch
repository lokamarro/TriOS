+set -eu
+cd -- "$(dirname -- "$0")"
+for shader in passthrough.vert passthrough.tesc tris.tese quads.tese \
+              isolines.tese triangles.geom lines.geom passthrough.frag; do
+   glslc -O --target-env=vulkan1.3 -mfmt=c "$shader" -o "$shader.h"
+done
diff --git a/src/kosmickrisp/vulkan/tests/tess_passthrough_shaders/isolines.tese b/src/kosmickrisp/vulkan/tests/tess_passthrough_shaders/isolines.tese
