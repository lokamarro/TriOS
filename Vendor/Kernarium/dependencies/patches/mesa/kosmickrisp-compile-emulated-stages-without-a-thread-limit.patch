index 0000000000000000000000000000000000000000..42c39ed415de939574b42c410651c197058877ae
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/tess_passthrough_shaders/isolines.tese
@@ -0,0 +1,29 @@
+#version 450
+/* SPDX-License-Identifier: MIT */
+layout(isolines) in;
+
+in gl_PerVertex {
+   vec4 gl_Position;
+} gl_in[gl_MaxPatchVertices];
+
+out gl_PerVertex {
+   vec4 gl_Position;
+};
+
+layout(location = 0) in vec4 v_patch_color[];
+layout(location = 0) out vec4 v_evaluated_color;
+
+void main(void)
+{
+   vec2 normalizedCoord = (gl_TessCoord.xy * 2.0 - vec2(1.0));
+   vec2 normalizedWeights =
+      normalizedCoord * (vec2(1.0) - 0.3 * cos(normalizedCoord.yx * 1.57));
+   vec2 weights = normalizedWeights * 0.5 + vec2(0.5);
+   vec2 cweights = gl_TessCoord.xy;
+   gl_Position = mix(mix(gl_in[0].gl_Position, gl_in[1].gl_Position, weights.y),
+                     mix(gl_in[2].gl_Position, gl_in[3].gl_Position, weights.y),
+                     weights.x);
+   v_evaluated_color =
+      mix(mix(v_patch_color[0], v_patch_color[1], cweights.y),
+          mix(v_patch_color[2], v_patch_color[3], cweights.y), cweights.x);
+}
