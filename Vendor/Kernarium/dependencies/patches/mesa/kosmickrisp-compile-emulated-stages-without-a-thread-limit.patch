+#version 450
+/* SPDX-License-Identifier: MIT */
+layout(vertices = 4) out;
+
+layout(constant_id = 0) const float u_tess_level = 14.0;
+layout(constant_id = 1) const float u_outer0 = 0.0;
+
+in gl_PerVertex {
+   vec4 gl_Position;
+} gl_in[gl_MaxPatchVertices];
+
+out gl_PerVertex {
+   vec4 gl_Position;
+} gl_out[];
+
+layout(location = 0) in vec4 v_vertex_color[];
+layout(location = 0) out vec4 v_patch_color[];
+
+void main(void)
+{
+   gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;
+   v_patch_color[gl_InvocationID] = v_vertex_color[gl_InvocationID];
+
+   gl_TessLevelOuter[0] = u_outer0 > 0.0 ? u_outer0 : u_tess_level;
+   gl_TessLevelOuter[1] = u_tess_level;
+   gl_TessLevelOuter[2] = u_tess_level;
+   gl_TessLevelOuter[3] = u_tess_level;
+   gl_TessLevelInner[0] = u_tess_level;
+   gl_TessLevelInner[1] = u_tess_level;
+}
