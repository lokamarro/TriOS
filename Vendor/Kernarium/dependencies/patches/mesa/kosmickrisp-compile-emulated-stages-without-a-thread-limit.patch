diff --git a/src/kosmickrisp/vulkan/tests/tes_sampler_shaders/dynamic.tese b/src/kosmickrisp/vulkan/tests/tes_sampler_shaders/dynamic.tese
new file mode 100644
index 0000000000000000000000000000000000000000..61854566af82d3b9941827f657804799f2d8bc0e
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/tes_sampler_shaders/dynamic.tese
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: MIT
+#version 450
+layout(isolines, equal_spacing) in;
+
+layout(set = 0, binding = 0) uniform samplerCubeArray textures[8];
+
+/* The dEQP dynamically uniform variant reads every lookup index from the
+ * executor's input record, so the descriptor address is computed from a
+ * storage buffer load rather than from a constant. */
+struct Inputs {
+   vec4 coords;
+   ivec4 indices;
+};
+
+struct Outputs {
+   vec4 out0;
+   vec4 out1;
+   vec4 out2;
+   vec4 out3;
+};
+
+layout(set = 0, binding = 2, std430) buffer InBuffer { Inputs inputs[]; };
+layout(set = 0, binding = 3, std430) buffer OutBuffer { Outputs outputs[]; };
+
+void main()
+{
+   gl_Position = vec4(gl_TessCoord.x, 0.0, 0.0, 1.0);
+   uint invocationId = uint(gl_PrimitiveID) * 2u + (gl_TessCoord.x > 0.5 ? 1u : 0u);
+   vec4 coords = inputs[invocationId].coords;
+   ivec4 index = inputs[invocationId].indices;
+   vec4 value0 = texture(textures[index[0]], coords);
+   vec4 value1 = texture(textures[index[1]], coords);
+   vec4 value2 = texture(textures[index[2]], coords);
+   vec4 value3 = texture(textures[index[3]], coords);
+   outputs[invocationId].out0 = value0;
+   outputs[invocationId].out1 = value1;
+   outputs[invocationId].out2 = value2;
+   outputs[invocationId].out3 = value3;
+}
