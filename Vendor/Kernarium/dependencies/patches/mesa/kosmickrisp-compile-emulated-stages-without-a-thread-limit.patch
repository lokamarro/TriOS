+/* dEQP's position-deviation comparison: a pixel passes when some pixel within
+ * the deviation window of the other image matches it within the threshold. */
+static uint32_t compare_images(const uint8_t *without, const uint8_t *with,
+                               uint32_t threshold, int deviation)
+{
+   auto matches = [&](const uint8_t *a, const uint8_t *b) {
+      for (uint32_t c = 0; c < 3; ++c) {
+         if (uint32_t(std::abs(int(a[c]) - int(b[c]))) > threshold)
+            return false;
+      }
+      return true;
+   };
+   auto found_near = [&](const uint8_t *value, const uint8_t *image, int x,
+                         int y) {
+      for (int dy = -deviation; dy <= deviation; ++dy) {
+         for (int dx = -deviation; dx <= deviation; ++dx) {
+            const int nx = x + dx;
+            const int ny = y + dy;
+            if (nx < 0 || ny < 0 || nx >= int(kExtent) || ny >= int(kExtent))
+               continue;
+            if (matches(value, image + (size_t(ny) * kExtent + nx) * 4))
+               return true;
+         }
+      }
+      return false;
+   };
+
+   uint32_t failing = 0;
+   for (int y = 0; y < int(kExtent); ++y) {
+      for (int x = 0; x < int(kExtent); ++x) {
+         const size_t offset = (size_t(y) * kExtent + x) * 4;
+         if (matches(without + offset, with + offset))
+            continue;
+         if (found_near(without + offset, with, x, y) &&
+             found_near(with + offset, without, x, y))
+            continue;
+         ++failing;
+      }
+   }
+   return failing;
+}
+
+static void report_difference(const char *domain, const uint8_t *without,
+                              const uint8_t *with)
+{
+   uint32_t max_difference = 0;
+   uint64_t sum_without = 0;
+   uint64_t sum_with = 0;
+   uint32_t covered_without = 0;
+   uint32_t covered_with = 0;
+   for (size_t pixel = 0; pixel < size_t(kExtent) * kExtent; ++pixel) {
+      for (uint32_t c = 0; c < 3; ++c) {
+         const int a = without[pixel * 4 + c];
+         const int b = with[pixel * 4 + c];
+         max_difference = std::max(max_difference, uint32_t(std::abs(a - b)));
+         sum_without += uint64_t(a);
+         sum_with += uint64_t(b);
+      }
+      if (without[pixel * 4] || without[pixel * 4 + 1] || without[pixel * 4 + 2])
+         ++covered_without;
+      if (with[pixel * 4] || with[pixel * 4 + 1] || with[pixel * 4 + 2])
+         ++covered_with;
+   }
+   std::printf("%s: max channel difference %u, covered %u without / %u with, "
+               "channel sums %llu without / %llu with\n",
+               domain, max_difference, covered_without, covered_with,
+               (unsigned long long)sum_without, (unsigned long long)sum_with);
+
+   /* A coarse map keeps a structural difference (seams, missing rows) legible
+    * in the test log without shipping image data. */
+   for (uint32_t block_y = 0; block_y < kExtent; block_y += 8) {
+      char row[kExtent / 8 + 1];
+      uint32_t column = 0;
+      for (uint32_t block_x = 0; block_x < kExtent; block_x += 8, ++column) {
+         int worst = 0;
+         for (uint32_t y = block_y; y < block_y + 8; ++y) {
+            for (uint32_t x = block_x; x < block_x + 8; ++x) {
+               const size_t offset = (size_t(y) * kExtent + x) * 4;
+               for (uint32_t c = 0; c < 3; ++c) {
+                  worst = std::max(worst, std::abs(int(without[offset + c]) -
+                                                   int(with[offset + c])));
+               }
+            }
+         }
+         row[column] = worst == 0 ? '.' : worst <= 8 ? '-' : worst <= 32 ? '+' : '#';
+      }
+      row[column] = '\0';
+      std::printf("  %s\n", row);
+   }
+}
