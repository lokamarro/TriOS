@@ -3463,10 +3463,32 @@ get_empty_nir(struct kk_device *dev, mesa_shader_stage stage,
    return nir;
 }
 
+/* KK_WORKAROUND_16
+ *
+ * The stages a graphics pipeline emulates in compute inline the whole
+ * application shader, and their threadgroup size is a driver constant rather
+ * than something the application asked for.  Metal miscompiles such a kernel
+ * when it is also promised a small threadgroup: values read past the first
+ * few threads of the dispatch come back as zeros.  Compile them without a
+ * thread limit instead; only the application's own compute shaders keep the
+ * size they declare.
+ */
+static uint32_t
+kk_compute_pipeline_thread_limit(const struct kk_device *device,
+                                 uint32_t local_size_threads,
+                                 bool emulated_stage)
+{
+   if (!emulated_stage ||
+       (device->disabled_workarounds & BITFIELD64_BIT(16)))
+      return local_size_threads;
+
+   return 0u;
+}
+
 static VkResult
 kk_compile_compute_pipeline(struct kk_device *device,
                             const struct msl_compile_data *data,
-                            uint32_t local_size_threads,
+                            uint32_t local_size_threads, bool emulated_stage,
                             mtl_compute_pipeline_state **pipe)
 {
    mtl_library *library = mtl_new_library(
@@ -3478,7 +3500,9 @@ kk_compile_compute_pipeline(struct kk_device *device,
    mtl_function_descriptor *function =
       mtl_new_library_function_descriptor(library, data->entrypoint_name);
    mtl_compute_pipeline_state *pipeline = mtl_new_compute_pipeline_state(
-      device->mtl_compiler_handle, function, local_size_threads);
+      device->mtl_compiler_handle, function,
+      kk_compute_pipeline_thread_limit(device, local_size_threads,
+                                       emulated_stage));
    mtl_release(function);
    mtl_release(library);
 
@@ -3871,7 +3895,7 @@ kk_compile_graphics_pipeline(struct kk_device *device, struct kk_shader *vs)
             ? vs->info.vs.tess_local_thread_size
             : 64u;
       result = kk_compile_compute_pipeline(device, &vs->msl_data[vs_stage],
-                                           local_thread_size,
+                                           local_thread_size, true,
                                            &pipe->gfx.pre_render[i]);
 
       if (result != VK_SUCCESS)
@@ -3881,7 +3905,7 @@ kk_compile_graphics_pipeline(struct kk_device *device, struct kk_shader *vs)
 
    if (vs->info.vs.transform_feedback_emulation) {
       result = kk_compile_compute_pipeline(
-         device, &vs->transform_feedback_pre_gs_msl, 1,
+         device, &vs->transform_feedback_pre_gs_msl, 1, true,
          &pipe->gfx.transform_feedback_pre_gs);
       if (result != VK_SUCCESS)
          return VK_ERROR_INVALID_SHADER_NV;
@@ -3889,7 +3913,7 @@ kk_compile_graphics_pipeline(struct kk_device *device, struct kk_shader *vs)
 
    if (vs->info.vs.line_raster_materialize) {
       result = kk_compile_compute_pipeline(
-         device, &vs->line_raster_materialize_msl, 64,
+         device, &vs->line_raster_materialize_msl, 64, true,
          &pipe->gfx.line_raster_materialize);
       if (result != VK_SUCCESS)
          return VK_ERROR_INVALID_SHADER_NV;
@@ -3897,7 +3921,7 @@ kk_compile_graphics_pipeline(struct kk_device *device, struct kk_shader *vs)
 
    if (vs->info.vs.line_raster_stipple || vs->info.vs.line_raster_procedural) {
       result = kk_compile_compute_pipeline(
-         device, &vs->line_stipple_prefix_msl, 1,
+         device, &vs->line_stipple_prefix_msl, 1, true,
          &pipe->gfx.line_stipple_prefix);
       if (result != VK_SUCCESS)
          return VK_ERROR_INVALID_SHADER_NV;
@@ -3905,21 +3929,22 @@ kk_compile_graphics_pipeline(struct kk_device *device, struct kk_shader *vs)
 
    if (vs->info.vs.geometry_shader_emulation) {
       result = kk_compile_compute_pipeline(device, &vs->geometry_main_msl, 64,
-                                           &pipe->gfx.geometry_main);
+                                           true, &pipe->gfx.geometry_main);
       if (result != VK_SUCCESS)
          return VK_ERROR_INVALID_SHADER_NV;
 
       if (vs->info.vs.geometry.count_words > 0 &&
           !vs->info.vs.geometry.output_vertex_stride) {
          result = kk_compile_compute_pipeline(
-            device, &vs->geometry_count_msl, 64,
+            device, &vs->geometry_count_msl, 64, true,
             &pipe->gfx.geometry_count);
          if (result != VK_SUCCESS)
             return VK_ERROR_INVALID_SHADER_NV;
       }
 
       result = kk_compile_compute_pipeline(device, &vs->geometry_pre_gs_msl,
-                                           1, &pipe->gfx.geometry_pre_gs);
+                                           1, true,
+                                           &pipe->gfx.geometry_pre_gs);
       if (result != VK_SUCCESS)
          return VK_ERROR_INVALID_SHADER_NV;
    }
@@ -4677,7 +4702,8 @@ kk_compile_shaders_single(struct vk_device *device, uint32_t shader_count,
                                     s->info.cs.local_size.z;
       result =
          kk_compile_compute_pipeline(dev, &s->msl_data[MESA_SHADER_COMPUTE],
-                                     local_size_threads, &s->pipeline.cs);
+                                     local_size_threads, false,
+                                     &s->pipeline.cs);
    } else {
       uint32_t skipped_shaders = 0;
       if (transform_feedback_pre_gs_shader != UINT32_MAX)
@@ -5843,7 +5869,7 @@ kk_deserialize_shader_impl(struct vk_device *vk_dev, struct blob_reader *blob,
                                     shader->info.cs.local_size.z;
       result = kk_compile_compute_pipeline(
          dev, &shader->msl_data[MESA_SHADER_COMPUTE], local_size_threads,
-         &shader->pipeline.cs);
+         false, &shader->pipeline.cs);
    } else if (info.stage == MESA_SHADER_VERTEX) {
       result = kk_compile_graphics_pipeline(dev, shader);
    }
