   test(
     'kosmickrisp_pipeline_statistics',
     executable(
diff --git a/src/kosmickrisp/vulkan/tests/test_msl_temporaries.c b/src/kosmickrisp/vulkan/tests/test_msl_temporaries.c
new file mode 100644
index 0000000000000000000000000000000000000000..0f65860e7d4baf25aa0379875e18fe7c902e71db
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_msl_temporaries.c
@@ -0,0 +1,223 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* MSL has no SSA form, so every value is declared at function scope and then
+ * assigned where its instruction sits.  The declarations must not carry an
+ * initializer: the shader leaves SSA form with phi webs only, so a temporary
+ * is always assigned before it can be read, and a dead store per name costs
+ * Metal's out-of-process compiler dearly once a shader has tens of thousands
+ * of them.  Registers are the exception - a phi web can be read on a path
+ * that has not written it - so those keep their zero.
+ */
+
+#include "compiler/glsl_types.h"
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+#include "kosmickrisp/compiler/nir_to_msl.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(condition)                                                     \
+   do {                                                                      \
+      if (!(condition)) {                                                    \
+         fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__,    \
+                 #condition);                                                \
+         abort();                                                            \
+      }                                                                      \
+   } while (0)
+
+/* A fragment shader with a counted loop, so the translation produces both
+ * plain temporaries and the registers a phi web lowers to. */
+static nir_shader *
+build_accumulating_fs(void)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_FRAGMENT, &kk_nir_options, "msl temporary declarations");
+   nir_shader *nir = b.shader;
+   nir->info.io_lowered = true;
+
+   nir_variable *total =
+      nir_local_variable_create(b.impl, glsl_float_type(), "total");
+   nir_variable *index =
+      nir_local_variable_create(b.impl, glsl_uint_type(), "index");
+   nir_store_var(&b, total, nir_imm_float(&b, 0.0f), 0x1);
+   nir_store_var(&b, index, nir_imm_int(&b, 0), 0x1);
+
+   nir_def *coord = nir_trim_vector(&b, nir_load_frag_coord(&b), 2);
+
+   nir_push_loop(&b);
+   {
+      nir_def *i = nir_load_var(&b, index);
+      nir_push_if(&b, nir_uge_imm(&b, i, 4));
+      {
+         nir_jump(&b, nir_jump_break);
+      }
+      nir_pop_if(&b, NULL);
+
+      nir_def *scale = nir_u2f32(&b, i);
+      nir_def *term = nir_fadd(&b, nir_fmul(&b, nir_channel(&b, coord, 0), scale),
+                               nir_channel(&b, coord, 1));
+      nir_store_var(&b, total, nir_fadd(&b, nir_load_var(&b, total), term),
+                    0x1);
+      nir_store_var(&b, index, nir_iadd_imm(&b, i, 1), 0x1);
+   }
+   nir_pop_loop(&b, NULL);
+
+   nir_def *result = nir_vec4(&b, nir_load_var(&b, total),
+                              nir_imm_float(&b, 1.0f),
+                              nir_imm_float(&b, 0.0f),
+                              nir_imm_float(&b, 1.0f));
+   nir_store_output(&b, result, nir_imm_int(&b, 0), .base = 0, .range = 1,
+                    .component = 0, .src_type = nir_type_float32,
+                    .io_semantics.location = FRAG_RESULT_DATA0,
+                    .io_semantics.num_slots = 1);
+   nir->info.outputs_written |= BITFIELD64_BIT(FRAG_RESULT_DATA0);
+
+   nir_validate_shader(nir, "msl temporary declarations");
+   return nir;
+}
+
+struct name {
+   char text[32];
+   bool assigned;
+};
+
+struct scan {
+   struct name *names;
+   unsigned count, capacity;
+   unsigned initialized_temporaries;
+   unsigned initialized_registers;
+   unsigned declared_registers;
+};
+
+static struct name *
+intern(struct scan *scan, const char *text)
+{
+   for (unsigned i = 0; i < scan->count; i++) {
+      if (strcmp(scan->names[i].text, text) == 0)
+         return &scan->names[i];
+   }
+   if (scan->count == scan->capacity) {
+      scan->capacity = scan->capacity ? scan->capacity * 2 : 64;
+      scan->names = realloc(scan->names, scan->capacity * sizeof(*scan->names));
+      CHECK(scan->names != NULL);
+   }
+   struct name *entry = &scan->names[scan->count++];
+   CHECK(strlen(text) < sizeof(entry->text));
+   strcpy(entry->text, text);
+   entry->assigned = false;
+   return entry;
+}
+
+/* Copy the identifier starting at @cursor, or return NULL when it is not a
+ * "t<number>" / "r<number>" name. */
+static const char *
+value_name(const char *cursor, char *out, size_t out_size)
+{
+   if (*cursor != 't' && *cursor != 'r')
+      return NULL;
+   size_t length = 1;
+   while (cursor[length] >= '0' && cursor[length] <= '9')
+      length++;
+   if (length == 1 || length >= out_size)
+      return NULL;
+   memcpy(out, cursor, length);
+   out[length] = '\0';
+   return cursor + length;
+}
+
+static void
+scan_msl(const char *msl, struct scan *scan)
+{
+   memset(scan, 0, sizeof(*scan));
+
+   for (const char *line = msl; *line;) {
+      const char *end = strchr(line, '\n');
+      const size_t length = end ? (size_t)(end - line) : strlen(line);
+      char buffer[512];
+      const size_t copied = length < sizeof(buffer) - 1 ? length
+                                                        : sizeof(buffer) - 1;
+      memcpy(buffer, line, copied);
+      buffer[copied] = '\0';
+      line = end ? end + 1 : line + length;
+
+      const char *cursor = buffer;
+      while (*cursor == ' ')
+         cursor++;
+
+      /* "<type> <name>..." is a declaration; "<name>..." is an assignment. */
+      const char *space = strchr(cursor, ' ');
+      char text[32];
+      if (space != NULL && value_name(space + 1, text, sizeof(text)) != NULL) {
+         const char *rest = space + 1 + strlen(text);
+         const bool initialized = rest[0] == ' ' && rest[1] == '=';
+         if (text[0] == 'r') {
+            scan->declared_registers++;
+            scan->initialized_registers += initialized;
+         } else {
+            scan->initialized_temporaries += initialized;
+         }
+         intern(scan, text);
+         continue;
+      }
+
+      const char *rest = value_name(cursor, text, sizeof(text));
+      if (rest == NULL)
+         continue;
+      while (*rest == '.' || (*rest >= 'w' && *rest <= 'z') || *rest == ' ')
+         rest++;
+      if (*rest == '=' && rest[1] != '=')
+         intern(scan, text)->assigned = true;
+   }
+}
+
+int
+main(void)
+{
+   glsl_type_singleton_init_or_ref();
+
+   nir_shader *nir = build_accumulating_fs();
+   msl_optimize_nir(nir);
+   nir_shader_gather_info(nir, nir_shader_get_entrypoint(nir));
+   BITSET_CLEAR(nir->info.system_values_read, SYSTEM_VALUE_FRAG_COORD);
+
+   struct nir_to_msl_options options = {0};
+   char *msl = nir_to_msl(nir, &options);
+   CHECK(msl != NULL);
+
+   struct scan scan;
+   scan_msl(msl, &scan);
+
+   /* The shader has to be large enough for the checks below to mean
+    * something, and the loop has to have produced a phi web. */
+   CHECK(scan.count > 8);
+   CHECK(scan.declared_registers > 0);
+
+   /* No temporary carries a dead initializer, and every one of them is
+    * assigned, which is what makes the initializer dead. */
+   CHECK(scan.initialized_temporaries == 0);
+   CHECK(scan.initialized_registers == scan.declared_registers);
+
+   for (unsigned i = 0; i < scan.count; i++) {
+      if (scan.names[i].text[0] == 'r')
+         continue;
+      if (!scan.names[i].assigned) {
+         fprintf(stderr, "temporary %s is never assigned\n",
+                 scan.names[i].text);
+         abort();
+      }
+   }
+
+   printf("msl temporaries PASS %u values, %u registers\n", scan.count,
+          scan.declared_registers);
+
+   free(scan.names);
+   ralloc_free(msl);
+   ralloc_free(nir);
+   glsl_type_singleton_decref();
+   return 0;
+}
