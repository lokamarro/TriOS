 src/kosmickrisp/compiler/nir_to_msl.c         |  13 +-
 src/kosmickrisp/vulkan/meson.build            |  14 ++
 .../vulkan/tests/test_msl_temporaries.c       | 223 ++++++++++++++++++
 5 files changed, 246 insertions(+), 11 deletions(-)
 create mode 100644 src/kosmickrisp/vulkan/tests/test_msl_temporaries.c

diff --git a/src/kosmickrisp/compiler/msl_private.h b/src/kosmickrisp/compiler/msl_private.h
index 6d57f2760f2dc66d246d44aa756759282d6cf323..00577811fdf4a55067d9a8effc891bb269da6650 100644
--- a/src/kosmickrisp/compiler/msl_private.h
+++ b/src/kosmickrisp/compiler/msl_private.h
@@ -81,7 +81,6 @@ uint32_t msl_output_num_components(struct nir_to_msl_ctx *ctx,
                                    uint32_t location);
 
