diff --git a/src/kosmickrisp/compiler/nir_to_msl.c b/src/kosmickrisp/compiler/nir_to_msl.c
index cd62fbda0a3c61f641210a44f9869917c468df83..76b3cc9740463a32d5b4dc1ebad096a7bc09fc05 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.c
+++ b/src/kosmickrisp/compiler/nir_to_msl.c
@@ -2533,6 +2533,14 @@ msl_gather_info(struct nir_to_msl_ctx *ctx, struct nir_to_msl_options *options)
    }
 }
 
+/* Every value below holds an SSA definition: the shader leaves SSA form with
+ * phi webs only, so each name is assigned by its own instruction before any
+ * use can read it.  Declaring them at function scope only widens their C
+ * scope to match the NIR dominance they already have, so no initializer is
+ * needed - and a shader with tens of thousands of temporaries pays for one
+ * dead store per name in Metal's compiler, which is the difference between a
+ * large shader compiling and the out-of-process compiler being interrupted.
+ */
 static void
 predeclare_ssa_values(struct nir_to_msl_ctx *ctx, nir_function_impl *impl)
 {
@@ -2568,10 +2576,7 @@ predeclare_ssa_values(struct nir_to_msl_ctx *ctx, nir_function_impl *impl)
             const char *type = msl_type_for_def(ctx->types, def);
             if (!type)
                continue;
-            if (msl_def_is_sampler(ctx, def)) {
-               P_IND(ctx, "%s t%u;\n", type, def->index);
-            } else
-               P_IND(ctx, "%s t%u = %s(0);\n", type, def->index, type);
+            P_IND(ctx, "%s t%u;\n", type, def->index);
          }
       }
    }
diff --git a/src/kosmickrisp/vulkan/meson.build b/src/kosmickrisp/vulkan/meson.build
index fba8ae283dc86e6832c30a7c1326b1030c0b4d4e..8355b907eb513a899339c7aa4e6c144a194dbbc8 100644
