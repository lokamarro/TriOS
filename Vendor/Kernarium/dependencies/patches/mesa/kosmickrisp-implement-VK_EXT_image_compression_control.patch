diff --git a/src/kosmickrisp/vulkan/tests/test_image_compression_chain.c b/src/kosmickrisp/vulkan/tests/test_image_compression_chain.c
new file mode 100644
index 0000000000000000000000000000000000000000..90aeec8925caa42e1a9eecdf15a9c477c539f4ed
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_image_compression_chain.c
@@ -0,0 +1,147 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* A VkImageCompressionPropertiesEXT is one link of the caller's output chain.
+ * Answering it must fill in the two flags and leave sType and pNext alone, or
+ * the query cuts the chain and every structure behind it goes unanswered. */
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x); abort(); } } while (0)
+#define LOAD_I(name) PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name); CHECK(name)
+#define LOAD_D(name) PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name); CHECK(name)
+
+static void
+check_answer(const VkImageCompressionPropertiesEXT *props, const void *next)
+{
+   CHECK(props->sType == VK_STRUCTURE_TYPE_IMAGE_COMPRESSION_PROPERTIES_EXT);
+   CHECK(props->pNext == next);
+   CHECK(props->imageCompressionFlags == VK_IMAGE_COMPRESSION_DISABLED_EXT);
+   CHECK(props->imageCompressionFixedRateFlags ==
+         VK_IMAGE_COMPRESSION_FIXED_RATE_NONE_EXT);
+}
+
+int
+main(void)
+{
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+                            .apiVersion = VK_API_VERSION_1_3};
+   VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   CHECK(vkCreateInstance(&instance_info, NULL, &instance) == VK_SUCCESS);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceImageFormatProperties2);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   uint32_t count = 1;
+   VkPhysicalDevice physical = VK_NULL_HANDLE;
+   CHECK(vkEnumeratePhysicalDevices(instance, &count, &physical) == VK_SUCCESS);
+   CHECK(count == 1);
+
+   /* The format query walks the output chain, so a cut chain also leaves the
+    * structure behind the compression properties unvisited. */
+   VkSamplerYcbcrConversionImageFormatProperties behind = {
+      .sType =
+         VK_STRUCTURE_TYPE_SAMPLER_YCBCR_CONVERSION_IMAGE_FORMAT_PROPERTIES,
+      .combinedImageSamplerDescriptorCount = 0xdeadu,
+   };
+   VkImageCompressionPropertiesEXT compression = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_COMPRESSION_PROPERTIES_EXT,
+      .pNext = &behind,
+   };
+   VkImageFormatProperties2 format_props = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2,
+      .pNext = &compression,
+   };
+   VkPhysicalDeviceImageFormatInfo2 format_info = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2,
+      .format = VK_FORMAT_R8G8B8A8_UNORM,
+      .type = VK_IMAGE_TYPE_2D,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage = VK_IMAGE_USAGE_SAMPLED_BIT,
+   };
+   CHECK(vkGetPhysicalDeviceImageFormatProperties2(physical, &format_info,
+                                                   &format_props) ==
+         VK_SUCCESS);
+   check_answer(&compression, &behind);
+   CHECK(behind.combinedImageSamplerDescriptorCount == 1u);
+
+   VkPhysicalDeviceImageCompressionControlFeaturesEXT compression_feature = {
+      .sType =
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_COMPRESSION_CONTROL_FEATURES_EXT,
+      .imageCompressionControl = VK_TRUE,
+   };
+   const char *extensions[] = {VK_EXT_IMAGE_COMPRESSION_CONTROL_EXTENSION_NAME};
+   float priority = 1.0f;
+   VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .pNext = &compression_feature,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+      .enabledExtensionCount = 1,
+      .ppEnabledExtensionNames = extensions,
+   };
+   VkDevice device = VK_NULL_HANDLE;
+   CHECK(vkCreateDevice(physical, &device_info, NULL, &device) == VK_SUCCESS);
+   LOAD_D(vkDestroyDevice);
+   LOAD_D(vkCreateImage);
+   LOAD_D(vkDestroyImage);
+   LOAD_D(vkGetImageSubresourceLayout2EXT);
+
+   VkImageCreateInfo image_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = VK_FORMAT_R8G8B8A8_UNORM,
+      .extent = {16, 16, 1},
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_LINEAR,
+      .usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   VkImage image = VK_NULL_HANDLE;
+   CHECK(vkCreateImage(device, &image_info, NULL, &image) == VK_SUCCESS);
+
+   /* The layout query finds each output by type, so the only thing a cut
+    * chain leaves behind here is the caller's own pNext overwritten. */
+   VkSubresourceHostMemcpySizeEXT memcpy_size = {
+      .sType = VK_STRUCTURE_TYPE_SUBRESOURCE_HOST_MEMCPY_SIZE_EXT,
+   };
+   compression = (VkImageCompressionPropertiesEXT){
+      .sType = VK_STRUCTURE_TYPE_IMAGE_COMPRESSION_PROPERTIES_EXT,
+      .pNext = &memcpy_size,
+   };
+   VkSubresourceLayout2EXT layout = {
+      .sType = VK_STRUCTURE_TYPE_SUBRESOURCE_LAYOUT_2_EXT,
+      .pNext = &compression,
+   };
+   VkImageSubresource2EXT subresource = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_SUBRESOURCE_2_EXT,
+      .imageSubresource = {.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT},
+   };
+   vkGetImageSubresourceLayout2EXT(device, image, &subresource, &layout);
+   check_answer(&compression, &memcpy_size);
+
+   vkDestroyImage(device, image, NULL);
+   vkDestroyDevice(device, NULL);
+   vkDestroyInstance(instance, NULL);
+   printf("image compression properties keep the caller's output chain\n");
+   return 0;
+}
