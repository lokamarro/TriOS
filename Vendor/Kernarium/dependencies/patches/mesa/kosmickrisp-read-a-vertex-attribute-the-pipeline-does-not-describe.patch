diff --git a/src/kosmickrisp/vulkan/tests/test_unbound_vertex_attribute.c b/src/kosmickrisp/vulkan/tests/test_unbound_vertex_attribute.c
new file mode 100644
index 0000000000000000000000000000000000000000..14107118f0fd473c67bdad2b25a3aba13b55e43e
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_unbound_vertex_attribute.c
@@ -0,0 +1,148 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* A vertex shader may declare an input that the vertex-input state does not
+ * describe.  Vulkan does not make that an error: the read returns the device's
+ * default vertex attribute value, which this driver reports as
+ * VK_DEFAULT_VERTEX_ATTRIBUTE_VALUE_ZERO_ZERO_ZERO_ONE_KHR.  Neither fetch
+ * path can express such an attribute - Metal rejects a pipeline whose shader
+ * declares an [[attribute(n)]] its vertex descriptor does not carry, and the
+ * lowered fetch has no format to decode - so the read is resolved before
+ * either of them runs, and the attribute leaves the shader's interface.
+ */
+
+#include "kosmickrisp/vulkan/kk_nir_lower_vbo.h"
+
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+
+#include <assert.h>
+
+#define UNBOUND_LOCATION 1
+
+static nir_builder
+build_shader(unsigned num_components, unsigned component,
+             nir_alu_type dest_type)
+{
+   static const nir_shader_compiler_options options = {0};
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_VERTEX, &options, "unbound vertex attribute test");
+   b.shader->info.io_lowered = true;
+
+   nir_def *value = nir_load_input(
+      &b, num_components, nir_alu_type_get_type_size(dest_type),
+      nir_imm_int(&b, 0), .base = UNBOUND_LOCATION, .range = 1,
+      .component = component, .dest_type = dest_type,
+      .io_semantics = (nir_io_semantics) {
+         .location = VERT_ATTRIB_GENERIC0 + UNBOUND_LOCATION,
+         .num_slots = 1,
+      });
+   nir_store_global(&b, value, nir_imm_int64(&b, 0x1000),
+                    .align_mul = sizeof(uint32_t));
+   b.shader->info.inputs_read =
+      BITFIELD64_BIT(VERT_ATTRIB_GENERIC0 + UNBOUND_LOCATION);
+
+   return b;
+}
+
+static unsigned
+count_input_loads(nir_shader *shader)
+{
+   unsigned loads = 0;
+
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_intrinsic &&
+                nir_instr_as_intrinsic(instr)->intrinsic ==
+                   nir_intrinsic_load_input)
+               loads++;
+         }
+      }
+   }
+
+   return loads;
+}
+
+static nir_intrinsic_instr *
+find_store_global(nir_shader *shader)
+{
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_intrinsic &&
+                nir_instr_as_intrinsic(instr)->intrinsic ==
+                   nir_intrinsic_store_global)
+               return nir_instr_as_intrinsic(instr);
+         }
+      }
+   }
+
+   return NULL;
+}
+
+/* The undescribed read becomes the default value, and the attribute is gone
+ * from the interface the two fetch paths describe. */
+static void
+check_default_value(unsigned num_components, unsigned component,
+                    nir_alu_type dest_type, const uint32_t *expected)
+{
+   nir_builder b = build_shader(num_components, component, dest_type);
+
+   assert(kk_nir_lower_unbound_vbo(b.shader, BITFIELD_BIT(0)));
+   nir_validate_shader(b.shader, "after unbound vertex attribute lowering");
+
+   assert(b.shader->info.inputs_read == 0);
+   assert(count_input_loads(b.shader) == 0);
+
+   nir_intrinsic_instr *store = find_store_global(b.shader);
+   assert(store != NULL);
+
+   nir_const_value *value = nir_src_as_const_value(store->src[0]);
+   assert(value != NULL);
+   for (unsigned i = 0; i < num_components; ++i)
+      assert(value[i].u32 == expected[i]);
+
+   ralloc_free(b.shader);
+}
+
+/* An attribute the state does describe is left for the fetch path to read. */
+static void
+check_described_attribute_is_untouched(void)
+{
+   nir_builder b = build_shader(4, 0, nir_type_float32);
+
+   assert(!kk_nir_lower_unbound_vbo(b.shader,
+                                    BITFIELD_BIT(UNBOUND_LOCATION)));
+   assert(b.shader->info.inputs_read ==
+          BITFIELD64_BIT(VERT_ATTRIB_GENERIC0 + UNBOUND_LOCATION));
+   assert(count_input_loads(b.shader) == 1);
+
+   ralloc_free(b.shader);
+}
+
+int
+main(void)
+{
+   static const uint32_t float_vec4[] = {0u, 0u, 0u, 0x3f800000u};
+   static const uint32_t integer_vec4[] = {0u, 0u, 0u, 1u};
+   static const uint32_t leading_xyz[] = {0u, 0u, 0u};
+   static const uint32_t float_w[] = {0x3f800000u};
+   static const uint32_t integer_w[] = {1u};
+
+   /* x, y and z read zero and w reads one, in the shader's own type. */
+   check_default_value(4, 0, nir_type_float32, float_vec4);
+   check_default_value(4, 0, nir_type_uint32, integer_vec4);
+   check_default_value(4, 0, nir_type_int32, integer_vec4);
+
+   /* A component offset names the attribute's own channels, so a load that
+    * starts at w reads one and one that stops short of it does not. */
+   check_default_value(3, 0, nir_type_float32, leading_xyz);
+   check_default_value(1, 3, nir_type_float32, float_w);
+   check_default_value(1, 3, nir_type_uint32, integer_w);
+
+   check_described_attribute_is_untouched();
+   return 0;
+}
