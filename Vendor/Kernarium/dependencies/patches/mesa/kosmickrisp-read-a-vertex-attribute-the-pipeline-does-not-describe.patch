 src/kosmickrisp/vulkan/kk_nir_lower_vbo.h     |   2 +
 src/kosmickrisp/vulkan/kk_shader.c            |  12 ++
 src/kosmickrisp/vulkan/meson.build            |  20 +++
 .../tests/test_unbound_vertex_attribute.c     | 148 ++++++++++++++++++
 5 files changed, 253 insertions(+)
 create mode 100644 src/kosmickrisp/vulkan/tests/test_unbound_vertex_attribute.c

diff --git a/src/kosmickrisp/vulkan/kk_nir_lower_vbo.c b/src/kosmickrisp/vulkan/kk_nir_lower_vbo.c
index 1217364bde7fbf302095e86e77e62ed1aa453959..fee8437fdc2cf9ec49f74905646d2789dfa95e80 100644
--- a/src/kosmickrisp/vulkan/kk_nir_lower_vbo.c
+++ b/src/kosmickrisp/vulkan/kk_nir_lower_vbo.c
@@ -146,6 +146,77 @@ load_unaligned_components(nir_builder *b, nir_def *base,
    return nir_vec(b, components, num_components);
 }
 
+/* Vulkan lets a vertex shader declare an input that the vertex-input state
+ * leaves undescribed.  Reading it is not an error: the value is the
+ * implementation's default vertex attribute value, which VK_KHR_maintenance9
+ * makes observable as VkPhysicalDeviceMaintenance9PropertiesKHR::
+ * defaultVertexAttributeValue, and this device reports
+ * VK_DEFAULT_VERTEX_ATTRIBUTE_VALUE_ZERO_ZERO_ZERO_ONE_KHR.
+ *
+ * Neither fetch path can express an undescribed attribute.  Metal's own fetch
+ * needs a vertex-descriptor entry for every [[attribute(n)]] the MSL declares
+ * and rejects the whole pipeline without one - "Vertex attribute
+ * attribute_1(1) is missing from the vertex descriptor", surfaced as
+ * VK_ERROR_INVALID_SHADER_NV - while the lowered fetch has no format to decode
+ * and no buffer to decode it from.  Resolve the read to the default value
+ * before either path sees it, which also drops the attribute from the
+ * interface the two of them describe.
+ */
+static bool
+lower_unbound_attrib(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_input)
+      return false;
+
+   const uint32_t attributes_valid = *(const uint32_t *)data;
+   nir_src *offset_src = nir_get_io_offset_src(intr);
+   assert(nir_src_is_const(*offset_src) && "no attribute indirects");
+
+   const unsigned location = nir_intrinsic_io_semantics(intr).location +
+                             nir_src_as_uint(*offset_src) -
+                             VERT_ATTRIB_GENERIC0;
+   if (location < KK_MAX_ATTRIBS &&
+       (attributes_valid & BITFIELD_BIT(location)))
+      return false;
+
+   const nir_alu_type type =
+      nir_alu_type_get_base_type(nir_intrinsic_dest_type(intr));
+   const unsigned component = nir_intrinsic_component(intr);
+   const unsigned bit_size = intr->def.bit_size;
+
+   nir_const_value values[NIR_MAX_VEC_COMPONENTS] = {0};
+   for (unsigned i = 0; i < intr->def.num_components; ++i) {
+      if (component + i != 3u)
+         values[i] = nir_const_value_for_raw_uint(0u, bit_size);
+      else if (type == nir_type_float)
+         values[i] = nir_const_value_for_float(1.0, bit_size);
+      else
+         values[i] = nir_const_value_for_int(1, bit_size);
+   }
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def_replace(
+      &intr->def,
+      nir_build_imm(b, intr->def.num_components, bit_size, values));
+   return true;
+}
+
+bool
+kk_nir_lower_unbound_vbo(nir_shader *nir, uint32_t attributes_valid)
+{
+   assert(nir->info.stage == MESA_SHADER_VERTEX);
+
+   const uint64_t described =
+      (uint64_t)attributes_valid << VERT_ATTRIB_GENERIC0;
+   if (!(nir->info.inputs_read & ~described))
+      return false;
+
+   bool progress = nir_shader_intrinsics_pass(
+      nir, lower_unbound_attrib, nir_metadata_control_flow, &attributes_valid);
+   nir->info.inputs_read &= described;
+   return progress;
+}
+
 static bool
 pass(struct nir_builder *b, nir_intrinsic_instr *intr, void *data)
 {
diff --git a/src/kosmickrisp/vulkan/kk_nir_lower_vbo.h b/src/kosmickrisp/vulkan/kk_nir_lower_vbo.h
index 7cb1ed3d6b09257d160faf1dc5949eef4c358415..ee5af3521b809c3823b7040f5fcf75fa6591d0b6 100644
--- a/src/kosmickrisp/vulkan/kk_nir_lower_vbo.h
+++ b/src/kosmickrisp/vulkan/kk_nir_lower_vbo.h
@@ -38,6 +38,8 @@ struct kk_attribute {
 bool kk_nir_lower_vbo(nir_shader *shader, struct kk_attribute *attribs,
                       bool robustness2, bool byte_strides);
 
+bool kk_nir_lower_unbound_vbo(nir_shader *shader, uint32_t attributes_valid);
+
 bool kk_vbo_supports_format(enum pipe_format format);
 
 unsigned kk_vbo_interchange_alignment(enum pipe_format format);
diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
index ec257e243bb6952916866aed58acbc95615386e4..17fa07010f1e2ce21974d0d7cdb07f28529b0b27 100644
--- a/src/kosmickrisp/vulkan/kk_shader.c
+++ b/src/kosmickrisp/vulkan/kk_shader.c
@@ -1658,6 +1658,18 @@ kk_compile_shader_as(struct kk_device *dev, nir_shader *nir,
       const bool emulated_vs =
          nir->info.next_stage == MESA_SHADER_TESS_CTRL || force_sw_vs;
 
+      /* An input the vertex-input state does not describe reads the device's
+       * default vertex attribute value, not an error.  Resolve those reads
+       * before either fetch path runs: Metal's fetch rejects a pipeline whose
+       * shader declares an attribute its vertex descriptor does not, and the
+       * lowered fetch has no format to decode. */
+      bool unbound_attribs = false;
+      if (state != NULL && state->vi != NULL)
+         NIR_PASS(unbound_attribs, nir, kk_nir_lower_unbound_vbo,
+                  state->vi->attributes_valid);
+      if (unbound_attribs)
+         shader->info.vs.attribs_read = kk_gather_vs_attribs_read(nir);
+
       /* VBO lowering needs to go here otherwise, the linking step removes all
        * inputs since we read vertex attributes from UBOs. */
       if (!emulated_vs &&
diff --git a/src/kosmickrisp/vulkan/meson.build b/src/kosmickrisp/vulkan/meson.build
index 099a3a803a0f2fcbbc6923587954a60dcbc16236..82f92a89697e3f4238726d2cd378897c98848f4a 100644
--- a/src/kosmickrisp/vulkan/meson.build
+++ b/src/kosmickrisp/vulkan/meson.build
