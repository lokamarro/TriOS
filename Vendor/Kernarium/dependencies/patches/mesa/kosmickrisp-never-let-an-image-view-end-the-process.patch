From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 26 Sep 2026 16:59:49 +0900
Subject: [PATCH] kosmickrisp: never let an image view end the process

Metal answers a texture view it cannot make with an assertion that
aborts the process: a view type the source texture cannot be viewed as,
or levels and slices it does not have. The view type and subresource
range of every Vulkan image view come from the application, and a Venus
guest's reach the host driver unchecked, so one invalid view ended the
emulator. 3DMark Wild Life Extreme sends a 3D view of a 2D image on its
second run in one process.

mtl_new_texture_view_with() now refuses such a view with NULL instead
of reaching Metal, and kk_image_view_init() checks every texture it
creates, and a missing base texture, and fails with
VK_ERROR_OUT_OF_DEVICE_MEMORY. A 3D view of a non-3D image is made as
the 2D (or 2D array) texture it is, because Venus creates views without
waiting for the result and a refusal would surface later as a lost
device. Metal's pixel-format compatibility is still left to Metal, and
a cube view's faces need not be square: the chroma planes of a 4:2:2
cube image are not, and Metal views them.

kosmickrisp_invalid_view_type aborts with that assertion before this
change and passes after it. It asks the bridge for each impossible view
directly, so it runs in the assertion-enabled regression suite; the
same views through vkCreateImageView are invalid usage the common
runtime asserts on, so those cases run only in a build without
assertions, as the driver ships.
---
 src/kosmickrisp/bridge/mtl_texture.m          |  68 ++++
 src/kosmickrisp/vulkan/kk_image_view.c        |  50 ++-
 src/kosmickrisp/vulkan/meson.build            |  20 ++
 .../vulkan/tests/test_invalid_view_type.c     | 327 ++++++++++++++++++
 4 files changed, 460 insertions(+), 5 deletions(-)
 create mode 100644 src/kosmickrisp/vulkan/tests/test_invalid_view_type.c

diff --git a/src/kosmickrisp/bridge/mtl_texture.m b/src/kosmickrisp/bridge/mtl_texture.m
index 496ce143324596b2d1616ed0b0a6a36eac2057f5..e44a8309fab17e73f55b7c478fb45f407aa04ae1 100644
--- a/src/kosmickrisp/bridge/mtl_texture.m
+++ b/src/kosmickrisp/bridge/mtl_texture.m
@@ -64,6 +64,70 @@
    return map[swizzle];
 }
 
+/* Metal answers a texture view it cannot make, whether of a type the source
+ * cannot be viewed as or of levels and slices the source does not have, with
+ * an assertion that ends the process. Every one of these comes from the
+ * application, so such a view has to become a failure the caller reports
+ * instead. Only the pixel format is left to Metal. */
+static bool
+mtl_texture_view_is_creatable(id<MTLTexture> tex, MTLTextureType type,
+                              NSRange levels, NSRange slices)
+{
+   if (tex == nil)
+      return false;
+
+   const MTLTextureType source = tex.textureType;
+   bool compatible;
+   switch (source) {
+   case MTLTextureType1D:
+   case MTLTextureType1DArray:
+      compatible = type == MTLTextureType1D || type == MTLTextureType1DArray;
+      break;
+   case MTLTextureType2D:
+      compatible = type == MTLTextureType2D || type == MTLTextureType2DArray;
+      break;
+   case MTLTextureType2DArray:
+   case MTLTextureTypeCube:
+   case MTLTextureTypeCubeArray:
+      compatible = type == MTLTextureType2D || type == MTLTextureType2DArray ||
+                   type == MTLTextureTypeCube ||
+                   type == MTLTextureTypeCubeArray;
+      break;
+   case MTLTextureType2DMultisample:
+   case MTLTextureType2DMultisampleArray:
+      compatible = type == MTLTextureType2DMultisample ||
+                   type == MTLTextureType2DMultisampleArray;
+      break;
+   default:
+      compatible = type == source;
+      break;
+   }
+   if (!compatible)
+      return false;
+
+   NSUInteger source_slices = tex.arrayLength;
+   if (source == MTLTextureTypeCube || source == MTLTextureTypeCubeArray)
+      source_slices *= 6u;
+
+   if (levels.length == 0u || levels.location >= tex.mipmapLevelCount ||
+       levels.length > tex.mipmapLevelCount - levels.location)
+      return false;
+   if (slices.length == 0u || slices.location >= source_slices ||
+       slices.length > source_slices - slices.location)
+      return false;
+
+   /* A cube view's faces need not be square: a 4:2:2 cube image's chroma
+    * planes are twice as tall as they are wide, and Metal views them as
+    * cubes. */
+   if (type == MTLTextureTypeCube || type == MTLTextureTypeCubeArray) {
+      if (slices.length % 6u != 0u ||
+          (type == MTLTextureTypeCube && slices.length != 6u))
+         return false;
+   }
+
+   return true;
+}
+
 mtl_texture *
 mtl_new_texture_view_with(mtl_texture *texture, const struct kk_view_layout *layout)
 {
@@ -72,6 +136,8 @@
       MTLTextureType type = mtl_texture_view_type(layout->view_type, layout->sample_count_sa);
       NSRange levels = NSMakeRange(layout->base_level, layout->num_levels);
       NSRange slices = NSMakeRange(layout->base_array_layer, layout->array_len);
+      if (!mtl_texture_view_is_creatable(tex, type, levels, slices))
+         return NULL;
       MTLTextureSwizzleChannels swizzle = MTLTextureSwizzleChannelsMake(mtl_texture_swizzle(layout->swizzle.red),
                                                                         mtl_texture_swizzle(layout->swizzle.green),
                                                                         mtl_texture_swizzle(layout->swizzle.blue),
@@ -88,6 +154,8 @@
       MTLTextureType type = mtl_texture_view_type(layout->view_type, layout->sample_count_sa);
       NSRange levels = NSMakeRange(layout->base_level, layout->num_levels);
       NSRange slices = NSMakeRange(layout->base_array_layer, layout->array_len);
+      if (!mtl_texture_view_is_creatable(tex, type, levels, slices))
+         return NULL;
       return [tex newTextureViewWithPixelFormat:layout->format.mtl textureType:type levels:levels slices:slices];
    }
 }
diff --git a/src/kosmickrisp/vulkan/kk_image_view.c b/src/kosmickrisp/vulkan/kk_image_view.c
index 682a65f74e339a2e50409a9c6e7f924a5b270070..2839fb35f7ebd2f921f2e3d318d71694e74fdcb0 100644
--- a/src/kosmickrisp/vulkan/kk_image_view.c
+++ b/src/kosmickrisp/vulkan/kk_image_view.c
@@ -49,6 +49,22 @@ remove_1d_view_types(enum VkImageViewType type)
    return type;
 }
 
+/* A 3D view of an image that is not 3D is invalid usage, and no Metal
+ * texture view can express it. Venus creates image views without waiting for
+ * the result, so refusing the view would only resurface later as a lost
+ * device. The view is made of the image as the 2D texture it is instead. */
+static enum VkImageViewType
+kk_image_view_metal_type(const struct kk_image *image,
+                         const struct kk_image_view *view)
+{
+   const enum VkImageViewType type = remove_1d_view_types(view->vk.view_type);
+   if (type == VK_IMAGE_VIEW_TYPE_3D &&
+       image->vk.image_type != VK_IMAGE_TYPE_3D)
+      return view->vk.layer_count > 1 ? VK_IMAGE_VIEW_TYPE_2D_ARRAY
+                                      : VK_IMAGE_VIEW_TYPE_2D;
+   return type;
+}
+
 VkResult
 kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
                    const VkImageViewCreateInfo *pCreateInfo)
@@ -105,7 +121,7 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
       assert(supported_format);
 
       struct kk_view_layout view_layout = {
-         .view_type = remove_1d_view_types(view->vk.view_type),
+         .view_type = kk_image_view_metal_type(image, view),
          .sample_count_sa = plane->layout.sample_count_sa,
          .format = {.pipe = p_format,
                     .mtl = supported_format->mtl_pixel_format},
@@ -162,6 +178,11 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
             mtl_handle = image->planes[image_plane].mtl_handle_array;
       }
 
+      /* An unbound image has no texture, and neither has the 2D array alias
+       * of a 3D image created without 2D array compatibility. */
+      if (mtl_handle == NULL)
+         goto fail_no_texture;
+
       /* Block texel view requires subresource aliasing. We do it here to avoid
        * having to create a texture for every possible subresource up-front */
       if (util_format_is_compressed(plane->layout.format.pipe) &&
@@ -182,6 +203,8 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
 
          mtl_handle = kk_image_plane_create_texture(plane, &subres_layout,
                                                     subres_offset_B);
+         if (mtl_handle == NULL)
+            goto fail_view;
          view->planes[view_plane].mtl_handle_subres = mtl_handle;
 
          /* Adjust for new base texture pointing to subresource */
@@ -196,6 +219,8 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
            (VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT))) {
          view->planes[view_plane].mtl_handle_sampled =
             mtl_new_texture_view_with(mtl_handle, &view_layout);
+         if (!view->planes[view_plane].mtl_handle_sampled)
+            goto fail_view;
          view->planes[view_plane].sampled_gpu_resource_id =
             mtl_texture_get_gpu_resource_id(
                view->planes[view_plane].mtl_handle_sampled);
@@ -207,10 +232,8 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
             array_layout.view_type = VK_IMAGE_VIEW_TYPE_2D_ARRAY;
             view->planes[view_plane].mtl_handle_cube_array =
                mtl_new_texture_view_with(mtl_handle, &array_layout);
-            if (!view->planes[view_plane].mtl_handle_cube_array) {
-               kk_image_view_finish(dev, view);
-               return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
-            }
+            if (!view->planes[view_plane].mtl_handle_cube_array)
+               goto fail_view;
             view->planes[view_plane].cube_array_gpu_resource_id =
                mtl_texture_get_gpu_resource_id(
                   view->planes[view_plane].mtl_handle_cube_array);
@@ -225,6 +248,8 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
 
          view->planes[view_plane].mtl_handle_storage =
             mtl_new_texture_view_with(mtl_handle, &view_layout);
+         if (!view->planes[view_plane].mtl_handle_storage)
+            goto fail_view;
          view->planes[view_plane].storage_gpu_resource_id =
             mtl_texture_get_gpu_resource_id(
                view->planes[view_plane].mtl_handle_storage);
@@ -254,6 +279,8 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
                                        : original_type;
             view->planes[view_plane].mtl_handle_input =
                mtl_new_texture_view_with(mtl_handle, &view_layout);
+            if (!view->planes[view_plane].mtl_handle_input)
+               goto fail_view;
          } else
             view->planes[view_plane].mtl_handle_input = mtl_retain(mtl_handle);
          if (view->planes[view_plane].mtl_handle_input)
@@ -288,10 +315,23 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
                renders_as_3d ? image->planes[image_plane].mtl_handle
                              : mtl_handle);
          }
+         if (!view->planes[view_plane].mtl_handle_render)
+            goto fail_view;
       }
    }
 
    return VK_SUCCESS;
+
+fail_no_texture:
+   kk_image_view_finish(dev, view);
+   return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                    "no Metal texture to take a view of");
+
+fail_view:
+   kk_image_view_finish(dev, view);
+   return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                    "Metal cannot make a view of type %d of this image",
+                    (int)pCreateInfo->viewType);
 }
 
 void
