+
 #define KK_CMD_BO_SIZE     (1024 * 128)
 #define KK_CMD_POOL_BO_MAX 32
 
@@ -26,6 +28,13 @@ struct kk_cmd_bo {
 struct kk_cmd_pool {
    struct vk_command_pool vk;
 
+   /* Guards free_bos and num_free_bos. The application synchronizes a pool
