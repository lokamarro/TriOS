diff --git a/src/kosmickrisp/vulkan/kk_cmd_pool.c b/src/kosmickrisp/vulkan/kk_cmd_pool.c
index e505acdf6e537df2696af29175c119482401bbfe..eba1f8d6aa08ad965775fef2332f0ed45f4d23bb 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_pool.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_pool.c
@@ -45,24 +45,28 @@ kk_cmd_bo_destroy(struct kk_cmd_pool *pool, struct kk_cmd_bo *bo)
 static void
 kk_cmd_pool_destroy_bos(struct kk_cmd_pool *pool)
 {
+   simple_mtx_lock(&pool->bo_mutex);
    list_for_each_entry_safe(struct kk_cmd_bo, bo, &pool->free_bos, link)
       kk_cmd_bo_destroy(pool, bo);
 
    list_inithead(&pool->free_bos);
    pool->num_free_bos = 0;
+   simple_mtx_unlock(&pool->bo_mutex);
 }
 
 VkResult
 kk_cmd_pool_alloc_bo(struct kk_cmd_pool *pool, struct kk_cmd_bo **bo_out)
 {
    struct kk_cmd_bo *bo = NULL;
+   simple_mtx_lock(&pool->bo_mutex);
    if (!list_is_empty(&pool->free_bos)) {
       bo = list_first_entry(&pool->free_bos, struct kk_cmd_bo, link);
       pool->num_free_bos--;
+      list_del(&bo->link);
    }
+   simple_mtx_unlock(&pool->bo_mutex);
 
    if (bo) {
-      list_del(&bo->link);
       *bo_out = bo;
       return VK_SUCCESS;
    }
@@ -73,6 +77,7 @@ kk_cmd_pool_alloc_bo(struct kk_cmd_pool *pool, struct kk_cmd_bo **bo_out)
 void
 kk_cmd_pool_free_bo_list(struct kk_cmd_pool *pool, struct list_head *bos)
 {
+   simple_mtx_lock(&pool->bo_mutex);
    list_for_each_entry_safe(struct kk_cmd_bo, bo, bos, link) {
       list_del(&bo->link);
       if (pool->num_free_bos >= KK_CMD_POOL_BO_MAX) {
@@ -82,6 +87,7 @@ kk_cmd_pool_free_bo_list(struct kk_cmd_pool *pool, struct list_head *bos)
          pool->num_free_bos++;
       }
    }
+   simple_mtx_unlock(&pool->bo_mutex);
 }
 
 VKAPI_ATTR VkResult VKAPI_CALL
@@ -105,6 +111,7 @@ kk_CreateCommandPool(VkDevice _device,
       return result;
    }
 
+   simple_mtx_init(&pool->bo_mutex, mtx_plain);
    list_inithead(&pool->free_bos);
    pool->num_free_bos = 0;
 
@@ -125,6 +132,7 @@ kk_DestroyCommandPool(VkDevice _device, VkCommandPool commandPool,
 
    vk_command_pool_finish(&pool->vk);
    kk_cmd_pool_destroy_bos(pool);
+   simple_mtx_destroy(&pool->bo_mutex);
    vk_free2(&device->vk.alloc, pAllocator, pool);
 }
 
