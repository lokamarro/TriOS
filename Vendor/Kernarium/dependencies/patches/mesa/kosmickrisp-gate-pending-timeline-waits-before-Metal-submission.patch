diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index 64922e8a766daa526a11d61d096fcf78d71b248e..4a7026def9df81ec12bbb7678d56165c5c284d02 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -223,6 +223,14 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
       struct vk_sync_signal *signal = &submit->signals[i];
       struct kk_sync_timeline *sync =
          container_of(signal->sync, struct kk_sync_timeline, base);
+      /* Later waits on this value are pending and need no CPU gating: any
+       * native work they order behind it comes from a later submission to
+       * this device's one queue, which runs only after this one has enqueued
+       * the signal. Publish that before the enqueue, because Metal can deliver
+       * the signal at once and whoever sees it delivered may destroy the sync
+       * straight away, as vkQueueWaitIdle does with its own. Nothing may touch
+       * the sync once its signal is enqueued. */
+      kk_timeline_mark_pending(signal->sync, signal->signal_value);
       mtl_signal_event(queue->mtl_handle, sync->mtl_handle,
                        signal->signal_value);
    }
@@ -295,6 +303,9 @@ kk_queue_init(struct kk_device *dev, struct kk_queue *queue,
 void
 kk_queue_finish(struct kk_device *dev, struct kk_queue *queue)
 {
+   /* Drain and join the submit worker before releasing its native resources. */
+   vk_queue_finish(&queue->vk);
+
    simple_mtx_lock(&queue->feedback->mutex);
    queue->feedback->device = NULL;
    simple_mtx_unlock(&queue->feedback->mutex);
@@ -304,5 +315,4 @@ kk_queue_finish(struct kk_device *dev, struct kk_queue *queue)
    mtl_command_queue_remove_residency_set(queue->mtl_handle,
                                           dev->residency_set.handle);
    mtl_release(queue->mtl_handle);
-   vk_queue_finish(&queue->vk);
 }
diff --git a/src/kosmickrisp/vulkan/kk_sync.c b/src/kosmickrisp/vulkan/kk_sync.c
index f44200c379e50a828161b257313a2e7a2c5a42e6..e0377497850cb629abde25478d077d1101528b33 100644
--- a/src/kosmickrisp/vulkan/kk_sync.c
+++ b/src/kosmickrisp/vulkan/kk_sync.c
@@ -7,6 +7,11 @@
 #include "kk_sync.h"
 
 #include "kk_device.h"
+#include "vk_sync_binary.h"
+
+#include "vk_util.h"
+
+#include "util/u_atomic.h"
 
 #include "kosmickrisp/bridge/mtl_bridge.h"
 
@@ -20,6 +25,8 @@ kk_timeline_init(struct vk_device *device, struct vk_sync *sync,
    struct kk_device *dev = container_of(device, struct kk_device, vk);
    timeline->mtl_handle = mtl_new_shared_event(dev->mtl_handle);
    mtl_shared_event_set_signaled_value(timeline->mtl_handle, initial_value);
+   timeline->pending_value = initial_value;
+   timeline->moved_from = NULL;
 
    return VK_SUCCESS;
 }
@@ -39,9 +46,33 @@ kk_timeline_signal(struct vk_device *device, struct vk_sync *sync,
    struct kk_sync_timeline *timeline =
       container_of(sync, struct kk_sync_timeline, base);
    mtl_shared_event_set_signaled_value(timeline->mtl_handle, value);
+   kk_timeline_mark_pending(sync, value);
    return VK_SUCCESS;
 }
 
+/* Record that a signal operation for this value has been performed on the CPU
+ * or taken by the queue for its Metal timeline, so an observer that sees the
+ * value also sees a signal ordered ahead of any work it submits next. A CPU
+ * signal publishes it after the signal itself. The queue publishes it just
+ * before the enqueue, which orders the same because every later submission to
+ * the device's one queue runs after it, and which it must do because the
+ * enqueued signal can be delivered and its sync destroyed at once. */
+void
+kk_timeline_mark_pending(struct vk_sync *sync, uint64_t value)
+{
+   struct kk_sync_timeline *timeline =
+      container_of(sync, struct kk_sync_timeline, base);
+
+   uint64_t pending = p_atomic_read(&timeline->pending_value);
+   while (value > pending) {
+      uint64_t seen =
+         p_atomic_cmpxchg(&timeline->pending_value, pending, value);
+      if (seen == pending)
+         return;
+      pending = seen;
+   }
+}
+
 static VkResult
 kk_timeline_get_value(struct vk_device *device, struct vk_sync *sync,
                       uint64_t *value)
@@ -60,34 +91,166 @@ kk_timeline_wait(struct vk_device *device, struct vk_sync *sync,
    struct kk_sync_timeline *timeline =
       container_of(sync, struct kk_sync_timeline, base);
 
-   /* abs_timeout_ns is the point in time when we should stop waiting, not the
-    * absolute time in ns. Therefore, we need to compute the delta from now to
-    * when we should stop waiting and convert to ms for Metal to be happy
-    * (Similar to what dzn does).
-    */
-   uint64_t timeout_ms = 0u;
-   if (abs_timeout_ns == OS_TIMEOUT_INFINITE) {
-      timeout_ms = OS_TIMEOUT_INFINITE;
-   } else {
-      uint64_t cur_time = os_time_get_nano();
-      uint64_t rel_timeout_ns =
-         abs_timeout_ns > cur_time ? abs_timeout_ns - cur_time : 0;
-
-      timeout_ms =
-         (rel_timeout_ns / 1000000) + (rel_timeout_ns % 1000000 ? 1 : 0);
+   for (;;) {
+      if (vk_device_is_lost_no_report(device))
+         return VK_ERROR_DEVICE_LOST;
+
+      /* The common runtime uses VK_SYNC_WAIT_PENDING to learn whether a
+       * signal operation has been submitted, never to wait for one to
+       * complete: it decides there whether a queue needs its assisted
+       * submission worker, and it blocks indefinitely on that answer while
+       * moving binary semaphore payloads. A value already enqueued on the
+       * queue's Metal timeline satisfies it, because every native wait this
+       * caller enqueues next is ordered behind that signal. Waiting for
+       * completion instead would hold the caller of vkQueueSubmit for the
+       * whole GPU dependency and would keep the worker enabled for the life
+       * of the device. */
+      if ((wait_flags & VK_SYNC_WAIT_PENDING) &&
+          p_atomic_read(&timeline->pending_value) >= wait_value)
+         return VK_SUCCESS;
+
+      /* Metal takes relative milliseconds; Vulkan provides an absolute
+       * nanosecond deadline. Recompute after every pending-wait slice. */
+      uint64_t timeout_ms;
+      if (abs_timeout_ns == OS_TIMEOUT_INFINITE) {
+         timeout_ms = OS_TIMEOUT_INFINITE;
+      } else {
+         uint64_t now = os_time_get_nano();
+         uint64_t remaining_ns =
+            abs_timeout_ns > now ? abs_timeout_ns - now : 0;
+         timeout_ms = remaining_ns / 1000000 +
+                      (remaining_ns % 1000000 ? 1 : 0);
+      }
+
+      /* Both the submit worker and QueueWaitIdle can wait indefinitely.
+       * Periodically observe device loss without changing their deadline. */
+      timeout_ms = MIN2(timeout_ms, 100);
+      int completed = mtl_shared_event_wait_until_signaled_value(
+         timeline->mtl_handle, wait_value, timeout_ms);
+      if (vk_device_is_lost_no_report(device))
+         return VK_ERROR_DEVICE_LOST;
+      if (completed)
+         return VK_SUCCESS;
+      if (abs_timeout_ns != OS_TIMEOUT_INFINITE &&
+          os_time_get_nano() >= abs_timeout_ns)
+         return VK_TIMEOUT;
+   }
+}
+
+static VkResult
+kk_sync_binary_take_payload(struct vk_device *device, struct vk_sync *dst_sync,
+                            struct vk_sync *src_sync)
+{
+   struct vk_sync_binary *dst = vk_sync_as_binary(dst_sync);
+   struct vk_sync_binary *src = vk_sync_as_binary(src_sync);
+   assert(dst && src);
+   struct kk_sync_timeline *dst_timeline =
+      container_of(&dst->timeline, struct kk_sync_timeline, base);
+   struct kk_sync_timeline *src_timeline =
+      container_of(&src->timeline, struct kk_sync_timeline, base);
+
+   /* Move only the Metal payload and its current point, never the common sync
+    * headers. Reset the recycled destination payload for future source use. */
+   SWAP(dst_timeline->mtl_handle, src_timeline->mtl_handle);
+   SWAP(dst_timeline->pending_value, src_timeline->pending_value);
+   SWAP(dst->next_point, src->next_point);
+   return vk_sync_reset(device, src_sync);
+}
+
+/* A threaded queue moves a permanent binary payload into a temporary inside
+ * vkQueueSubmit, but the signal that payload waits for may still sit in the
+ * submit worker, which unwraps it against whatever payload the semaphore holds
+ * when it gets there. Moving at once would hand that signal the fresh payload
+ * and leave the wait on a point nothing signals, until Metal abandons the
+ * native wait seconds later. Waiting in vkQueueSubmit for the worker to reach
+ * the signal is no answer either, because it can sit behind a batch only the
+ * caller can release. So the temporary only records its source here, and the
+ * worker completes the move in kk_sync_binary_wait_many() when it reaches the
+ * wait: every signal submitted before the wait has been unwrapped by then, and
+ * the wait itself is unwrapped only after. The source outlives the record,
+ * because a semaphore may not be destroyed before every batch waiting on it
+ * has completed (VUID-vkDestroySemaphore-semaphore-01137). An unthreaded queue
+ * has run every signal already, so its move is made at once. */
+VkResult
+kk_sync_binary_move(struct vk_device *device, struct vk_sync *dst_sync,
+                    struct vk_sync *src_sync)
+{
+   struct kk_device *dev = container_of(device, struct kk_device, vk);
+   if (dev->queue.vk.submit.mode != VK_QUEUE_SUBMIT_MODE_THREADED)
+      return kk_sync_binary_take_payload(device, dst_sync, src_sync);
+
+   struct vk_sync_binary *dst = vk_sync_as_binary(dst_sync);
+   assert(dst && vk_sync_as_binary(src_sync));
+   struct kk_sync_timeline *dst_timeline =
+      container_of(&dst->timeline, struct kk_sync_timeline, base);
+   assert(dst_timeline->moved_from == NULL);
+   dst_timeline->moved_from = src_sync;
+   return VK_SUCCESS;
+}
+
+/* A binary semaphore wait is always pending. VUID-vkQueueSubmit-
+ * pWaitSemaphores-03238 requires its signal operation to have been submitted
+ * for execution first, and this device runs one queue in order, so whatever
+ * orders native work behind the answer, the submit worker or an unthreaded
+ * submission, reaches the wait only after the signal; a move made on the
+ * answer waits for the worker too (kk_sync_binary_move). Reporting completion
+ * instead would make vkQueueSubmit wait for the GPU whenever one batch consumes
+ * another batch's semaphore. */
+VkResult
+kk_sync_binary_wait_many(struct vk_device *device, uint32_t wait_count,
+                         const struct vk_sync_wait *waits,
+                         enum vk_sync_wait_flags wait_flags,
+                         uint64_t abs_timeout_ns)
+{
+   for (uint32_t i = 0; i < wait_count; i++) {
+      struct vk_sync_binary *binary = vk_sync_as_binary(waits[i].sync);
+      assert(binary);
+      struct kk_sync_timeline *timeline =
+         container_of(&binary->timeline, struct kk_sync_timeline, base);
+      struct vk_sync *source = timeline->moved_from;
+      if (source == NULL)
+         continue;
+      timeline->moved_from = NULL;
+      VkResult result =
+         kk_sync_binary_take_payload(device, waits[i].sync, source);
+      if (result != VK_SUCCESS)
+         return result;
    }
-   int completed = mtl_shared_event_wait_until_signaled_value(
-      timeline->mtl_handle, wait_value, timeout_ms);
 
-   return completed != 0 ? VK_SUCCESS : VK_TIMEOUT;
+   if (wait_flags & VK_SYNC_WAIT_PENDING)
+      return VK_SUCCESS;
+
+   if (wait_count == 0)
+      return VK_SUCCESS;
+
+   STACK_ARRAY(struct vk_sync_wait, points, wait_count);
+   for (uint32_t i = 0; i < wait_count; i++) {
+      struct vk_sync_binary *binary = vk_sync_as_binary(waits[i].sync);
+      assert(binary);
+      points[i] = (struct vk_sync_wait){
+         .sync = &binary->timeline,
+         .stage_mask = waits[i].stage_mask,
+         .wait_value = binary->next_point,
+      };
+   }
+   VkResult result =
+      vk_sync_wait_many(device, wait_count, points, wait_flags,
+                        abs_timeout_ns);
+   STACK_ARRAY_FINISH(points);
+   return result;
 }
 
 const struct vk_sync_type kk_sync_type = {
    .size = sizeof(struct kk_sync_timeline),
+   /* Metal GPU event waits cannot remain pending indefinitely. Assisted
+    * submission waits on the CPU for a time point whose signal has not been
+    * submitted yet, and only then enqueues native work. A point whose signal
+    * is already enqueued needs no CPU wait: it satisfies VK_SYNC_WAIT_PENDING
+    * through kk_timeline_mark_pending, and Metal orders the native wait
+    * behind it. */
    .features = VK_SYNC_FEATURE_TIMELINE | VK_SYNC_FEATURE_GPU_WAIT |
                VK_SYNC_FEATURE_CPU_WAIT | VK_SYNC_FEATURE_CPU_SIGNAL |
-               VK_SYNC_FEATURE_WAIT_PENDING |
-               VK_SYNC_FEATURE_WAIT_BEFORE_SIGNAL,
+               VK_SYNC_FEATURE_WAIT_PENDING,
    .init = kk_timeline_init,
    .finish = kk_timeline_finish,
    .signal = kk_timeline_signal,
