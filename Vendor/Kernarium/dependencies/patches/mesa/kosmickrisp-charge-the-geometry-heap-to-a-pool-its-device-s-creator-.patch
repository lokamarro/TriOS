index 0000000000000000000000000000000000000000..d53a32784c40172e8d95777ef3e033f88f8e11b4
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_device_memory_pool.h
@@ -0,0 +1,54 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+/* A device-memory pool the creator of a KosmicKrisp device shares with it.
+ *
+ * Chained to VkDeviceCreateInfo, it makes the device charge the memory it
+ * allocates for itself, which no application allocation accounts for, to a
+ * pool that its creator charges its own allocations to as well, so that
+ * together they stay within the pool's limit. Before such an allocation the
+ * device reserves its size, and a refused reservation means the device does
+ * without that memory. The device releases the reservation once the
+ * allocation exists, when the pool's usage counts it, or has failed.
+ *
+ * The device charges its geometry heap this way. A heap it creates or grows
+ * takes at most half of the pool's headroom, and one that no recording holds
+ * is freed when the headroom has fallen below half its size. A device
+ * created without a pool bounds its heap by a fixed size instead.
+ *
+ * The callbacks may be called from any thread, with device locks held, so
+ * they must not call back into the device. The structure is copied when the
+ * device is created; pUserData must outlive the device. */
+
+#pragma once
+
+#include <vulkan/vulkan_core.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* In the VK_EXT_memory_budget namespace, at an offset the extension does not
+ * use, following Mesa's internal structures. */
+#define VK_STRUCTURE_TYPE_DEVICE_MEMORY_POOL_CREATE_INFO_KK                    \
+   ((VkStructureType)1000237900)
+
+typedef struct VkDeviceMemoryPoolCreateInfoKK {
+   VkStructureType sType;
+   const void *pNext;
+   void *pUserData;
+   /* Charges size bytes to the pool, or returns VK_FALSE and charges nothing
+    * when the pool cannot hold them. */
+   VkBool32(VKAPI_PTR *pfnReserve)(void *pUserData, VkDeviceSize size);
