+/* Frees the device's heap when it is charged to a pool whose headroom has
+ * fallen below half its size, it grew past the starting size and no
+ * recording holds it. The next draw that needs a heap creates one. A heap is
+ * created at no more than half the headroom, so a steady workload finds the
+ * pool with as much room left as its heap holds and keeps it. */
+static void
+kk_heap_return_idle(struct kk_device *dev)
+{
+   if (!kk_heap_pooled(dev) ||
+       p_atomic_read(&dev->heap_live_B) <= dev->heap_start_B)
+      return;
+
+   struct kk_geometry_heap *idle = NULL;
+   simple_mtx_lock(&dev->heap_lock);
+   struct kk_geometry_heap *heap = dev->heap;
+   if (heap != NULL && heap->refcount == 1 &&
+       heap->bo->size_B > dev->heap_start_B &&
+       dev->memory_pool.pfnHeadroom(dev->memory_pool.pUserData) <
+          heap->bo->size_B / 2u) {
+      kk_heap_observe_locked(dev, heap);
+      heap->refcount = 0;
+      idle = heap;
+      dev->heap = NULL;
+      dev->heap_attempted = false;
+   }
+   simple_mtx_unlock(&dev->heap_lock);
+
+   if (idle != NULL)
+      kk_geometry_heap_free(dev, idle);
+}
+
