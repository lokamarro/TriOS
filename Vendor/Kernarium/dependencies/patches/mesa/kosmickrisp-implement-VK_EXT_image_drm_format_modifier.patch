       .EXT_memory_budget = true,
diff --git a/src/kosmickrisp/vulkan/meson.build b/src/kosmickrisp/vulkan/meson.build
index 0fa84eb69971ae2cdb2cd7bd3f1c85d5e56f9834..2b05f2e146f9f6a5c6b64c3121d1ff7c9bf7d1b9 100644
--- a/src/kosmickrisp/vulkan/meson.build
+++ b/src/kosmickrisp/vulkan/meson.build
@@ -946,6 +946,16 @@ if with_tests
     suite : ['kosmickrisp'],
   )
 
+  test(
+    'kosmickrisp_linear_layout',
+    executable(
+      'test_kosmickrisp_linear_layout',
+      files('tests/test_linear_layout.c'),
+      include_directories : [inc_include, inc_src],
+    ),
+    suite : ['kosmickrisp'],
+  )
+
   test(
     'kosmickrisp_depth_clip',
     executable(
diff --git a/src/kosmickrisp/vulkan/tests/test_linear_layout.c b/src/kosmickrisp/vulkan/tests/test_linear_layout.c
new file mode 100644
index 0000000000000000000000000000000000000000..7e2bfa65cdce9a797663cc6a0901b5538278a764
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_linear_layout.c
@@ -0,0 +1,92 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kosmickrisp/vulkan/kk_linear_layout.h"
+
+#include <assert.h>
+
+/* A Wayland swapchain image is a colour attachment, and common WSI asks this
+ * driver about one modifier at a time: it filters the modifier list with
+ * vkGetPhysicalDeviceImageFormatProperties2 and, when nothing survives, it
+ * has no fallback and fails vkCreateSwapchainKHR with
+ * VK_ERROR_OUT_OF_HOST_MEMORY -- which dEQP records as a ResourceError that
+ * ends the whole CTS session. The one modifier this driver offers therefore
+ * has to hold a colour attachment. */
+static void
+check_a_modifier_image_can_be_a_colour_attachment(void)
+{
+   assert(!kk_linear_layout_refuses_usage(
+      VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+      VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT));
+
+   /* The rest of a swapchain image's usual usage. */
+   assert(!kk_linear_layout_refuses_usage(
+      VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+      VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+         VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+         VK_IMAGE_USAGE_STORAGE_BIT));
+}
+
+/* Metal makes a linear texture out of a MTLBuffer and refuses any type but
+ * MTLTextureType2D for one, by an assertion that ends the host process. This
+ * driver binds every input attachment as a 2D array, so a linear layout can
+ * never carry one; Metal has no linear depth or stencil texture at all. */
+static void
+check_a_linear_layout_refuses_what_metal_cannot_represent(void)
+{
+   const VkImageTiling linear_layouts[] = {
+      VK_IMAGE_TILING_LINEAR,
+      VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+   };
+
+   for (unsigned i = 0; i < 2u; i++) {
+      assert(kk_tiling_is_linear_layout(linear_layouts[i]));
+      assert(kk_linear_layout_refuses_usage(
+         linear_layouts[i], VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT));
+      assert(kk_linear_layout_refuses_usage(
+         linear_layouts[i], VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                               VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT));
+      assert(kk_linear_layout_refuses_usage(
+         linear_layouts[i], VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT));
+   }
+
+   assert(!kk_linear_layout_type_is_creatable(MTL_TEXTURE_TYPE_2D_ARRAY));
+   assert(!kk_linear_layout_type_is_creatable(MTL_TEXTURE_TYPE_2D_MULTISAMPLE));
+   assert(!kk_linear_layout_type_is_creatable(MTL_TEXTURE_TYPE_3D));
+   assert(kk_linear_layout_type_is_creatable(MTL_TEXTURE_TYPE_2D));
+}
+
+/* Plain linear tiling keeps the capabilities it has always had: a colour
+ * attachment there would have to answer for an input attachment too, because
+ * nothing narrows what an application may create with a format that reports
+ * VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT. */
+static void
+check_plain_linear_tiling_is_unchanged(void)
+{
+   assert(!kk_linear_layout_renders(VK_IMAGE_TILING_LINEAR));
+   assert(kk_linear_layout_refuses_usage(VK_IMAGE_TILING_LINEAR,
+                                         VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT));
+}
+
+/* Optimal tiling is not a linear layout and none of this applies to it. */
+static void
+check_optimal_tiling_is_never_refused(void)
+{
+   assert(!kk_tiling_is_linear_layout(VK_IMAGE_TILING_OPTIMAL));
+   assert(!kk_linear_layout_refuses_usage(
+      VK_IMAGE_TILING_OPTIMAL, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                                  VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT |
+                                  VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT));
+}
+
+int
+main(void)
+{
+   check_a_modifier_image_can_be_a_colour_attachment();
+   check_a_linear_layout_refuses_what_metal_cannot_represent();
+   check_plain_linear_tiling_is_unchanged();
+   check_optimal_tiling_is_never_refused();
+   return 0;
+}
