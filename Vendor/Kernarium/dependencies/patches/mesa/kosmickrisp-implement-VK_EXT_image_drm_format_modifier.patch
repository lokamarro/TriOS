diff --git a/src/kosmickrisp/vulkan/kk_linear_layout.h b/src/kosmickrisp/vulkan/kk_linear_layout.h
new file mode 100644
index 0000000000000000000000000000000000000000..3e3033f8b37b45eb83f5ea105cdf492cfd04ea46
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_linear_layout.h
@@ -0,0 +1,67 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef KK_LINEAR_LAYOUT_H
+#define KK_LINEAR_LAYOUT_H 1
+
+#include "kosmickrisp/bridge/mtl_types.h"
+
+#include <vulkan/vulkan_core.h>
+
+#include <stdbool.h>
+
+/* Metal lays out both VK_IMAGE_TILING_LINEAR and this driver's only DRM
+ * format modifier, DRM_FORMAT_MOD_LINEAR, as a texture over a MTLBuffer.
+ *
+ * Such a texture renders: Metal accepts MTLTextureUsageRenderTarget on it,
+ * and this driver already asks for one whenever a linear image is a transfer
+ * destination. What Metal refuses, by an assertion that ends the process, is
+ * a linear texture of any type but MTLTextureType2D -- and this driver binds
+ * every input attachment as a 2D array.
+ *
+ * A modifier image is therefore offered as a colour attachment, because a
+ * Wayland swapchain image is exactly that and common WSI has no fallback when
+ * no modifier can hold one, while plain linear tiling keeps the capabilities
+ * it has always had. Both refuse an input attachment, and neither has a
+ * depth or stencil texture in Metal at all.
+ */
+static inline bool
+kk_tiling_is_linear_layout(VkImageTiling tiling)
+{
+   return tiling == VK_IMAGE_TILING_LINEAR ||
+          tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+}
+
+static inline bool
+kk_linear_layout_renders(VkImageTiling tiling)
+{
+   return tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+}
+
+static inline bool
+kk_linear_layout_refuses_usage(VkImageTiling tiling, VkImageUsageFlags usage)
+{
+   if (!kk_tiling_is_linear_layout(tiling))
+      return false;
+
+   if (usage & VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)
+      return true;
+
+   if (usage & VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT)
+      return true;
+
+   return (usage & VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT) &&
+          !kk_linear_layout_renders(tiling);
+}
+
+/* The one Metal texture type a linear layout can have. A descriptor Metal
+ * cannot represent has to become a Vulkan error before it reaches Metal. */
+static inline bool
+kk_linear_layout_type_is_creatable(enum mtl_texture_type type)
+{
+   return type == MTL_TEXTURE_TYPE_2D;
+}
+
+#endif /* KK_LINEAR_LAYOUT_H */
