From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Wed, 4 Nov 2026 05:22:08 +0900
Subject: [PATCH] zink: make a shader set's default pipeline library once

A shader set's pipeline libraries live in a screen-wide cache that outlives
the per-context programs linking the set, and the set compares only the
optimal key. The link-time precompile added its default-key library without
looking, so each later context that linked the same shaders replaced the
entry and orphaned the earlier library, its pipeline and its compiled
shaders, for the life of the screen. Search the set first.
---
 src/gallium/drivers/zink/zink_program.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/gallium/drivers/zink/zink_program.c b/src/gallium/drivers/zink/zink_program.c
index afcd0f99143e3bd6923de4124780180e290419d7..7e9b92b2eae5c656664f91471dc05f6c4d61e378 100644
--- a/src/gallium/drivers/zink/zink_program.c
+++ b/src/gallium/drivers/zink/zink_program.c
@@ -2662,6 +2662,8 @@ zink_create_pipeline_lib(struct zink_screen *screen, struct zink_gfx_program *pr
    assert(is_mesh || gkey->optimal_key);
    for (unsigned i = 0; i < MESA_SHADER_MESH_STAGES; i++)
       gkey->modules[i] = prog->objs[i].mod;
+   /* callers search first: an equal entry would be replaced and leaked */
+   assert(!_mesa_set_search(&prog->libs->libs, gkey));
    gkey->pipeline = zink_create_gfx_pipeline_library(screen, prog);
    _mesa_set_add(&prog->libs->libs, gkey);
    return gkey;
@@ -2708,7 +2710,13 @@ gfx_program_precompile_job(void *data, void *gdata, int thread_index)
    zink_screen_get_pipeline_cache(screen, &prog->base, true);
    if (!screen->info.have_EXT_shader_object) {
       simple_mtx_lock(&prog->libs->lock);
-      zink_create_pipeline_lib(screen, prog, &state);
+      /* the shader set's libraries outlive its programs, and a set is linked
+       * once per context: make its default library only once
+       */
+      uint32_t optimal_key = prog->shaders[MESA_SHADER_VERTEX] ?
+                             state.optimal_key : state.mesh_optimal_key;
+      if (!_mesa_set_search(&prog->libs->libs, &optimal_key))
+         zink_create_pipeline_lib(screen, prog, &state);
       simple_mtx_unlock(&prog->libs->lock);
    }
    prog->base.precompile_done = true;
