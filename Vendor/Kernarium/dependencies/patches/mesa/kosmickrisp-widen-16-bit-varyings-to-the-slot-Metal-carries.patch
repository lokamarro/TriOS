new file mode 100644
index 0000000000000000000000000000000000000000..40657bb5c97b94f09a55ee066a6d7a4875db0b52
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_16bit_varying_io.c
@@ -0,0 +1,304 @@
+/*
