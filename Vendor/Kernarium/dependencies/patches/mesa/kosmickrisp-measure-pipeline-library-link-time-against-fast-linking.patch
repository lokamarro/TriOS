+#version 460
+/* SPDX-License-Identifier: MIT */
+/* A specialization constant keeps each pre-rasterization library's shader
+ * distinct, so no link can be served from a cache of an earlier one. */
+layout (constant_id = 0) const int seed = 0;
+vec2 triangle[3] = vec2[](vec2(-1.0, -1.0), vec2(3.0, -1.0), vec2(-1.0, 3.0));
+layout (location = 0) in vec4 attribute0;
+void main (void) {
+    gl_Position = vec4(triangle[gl_VertexIndex % 3] + float(seed) * 1e-6, 0.5,
+                       1.0) + attribute0 * 1e-6;
+}
