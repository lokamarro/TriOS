diff --git a/src/kosmickrisp/vulkan/tests/test_pipeline_library_link_time.cpp b/src/kosmickrisp/vulkan/tests/test_pipeline_library_link_time.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ffe76ccc62ca7db5f7d4831fe8b108c8c95f5d1f
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_pipeline_library_link_time.cpp
@@ -0,0 +1,397 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* VK_EXT_graphics_pipeline_library promises that linking libraries without
+ * VK_PIPELINE_CREATE_LINK_TIME_OPTIMIZATION_BIT_EXT is cheap next to building
+ * the libraries themselves.  This builds the eight libraries of the
+ * conformance test's link-time comparison - two vertex-input, two
+ * pre-rasterization, two fragment-shader and two fragment-output - links all
+ * sixteen combinations, and reports the cost of each link against the cost of
+ * creating the two libraries that carry its shaders.  It also reports what
+ * the driver advertises through graphicsPipelineLibraryFastLinking, so a run
+ * says both what the driver claims and what it delivers.
+ *
+ * KosmicKrisp answers that property with false.  Metal compiles a complete
+ * program: an MTLLibrary is built from the whole MSL text of a stage and an
+ * MTLRenderPipelineState from the functions of every stage at once, with no
+ * object that holds one separately compiled stage for a later link.  The text
+ * of a stage is not available before the link either, because Metal has no
+ * fixed-function vertex fetch, so the vertex shader carries the attribute
+ * loads built from the vertex-input state, and the fragment shader carries
+ * the blend, write mask and logic op built from the colour-blend state; both
+ * belong to libraries other than the one holding the shader.  Linking is
+ * therefore the first moment either stage can be compiled at all, and this
+ * program fails only if a driver claims fast linking it does not deliver.
+ */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+extern "C" PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+
+static void require(bool ok, const char *operation, VkResult value = VK_SUCCESS)
+{
+   if (!ok) {
+      std::fprintf(stderr, "%s: %d\n", operation, value);
+      std::exit(1);
+   }
+}
+
+template <typename T> static T load(VkInstance instance, const char *name)
+{
+   auto function = reinterpret_cast<T>(vkGetInstanceProcAddr(instance, name));
+   require(function != nullptr, name);
+   return function;
+}
+
+#define LOAD_I(name) auto name = load<PFN_##name>(instance, #name)
+#define LOAD_D(name)                                                             \
+   auto name = reinterpret_cast<PFN_##name>(vkGetDeviceProcAddr(device, #name)); \
+   require(name != nullptr, #name)
+
+static const uint32_t vertex_spirv[] =
+#include "pipeline_library_shaders/gpl.vert.h"
+;
+static const uint32_t fragment_spirv[] =
+#include "pipeline_library_shaders/gpl.frag.h"
+;
+
+/* The conformance test reports a quality warning above this ratio, and a
+ * driver that advertises fast linking has to stay under it. */
+static constexpr double kRatioLimit = 10.0;
+
+using Clock = std::chrono::steady_clock;
+static double ms_since(Clock::time_point start)
+{
+   return std::chrono::duration<double, std::milli>(Clock::now() - start).count();
+}
+
+int main()
+{
+   std::setvbuf(stdout, nullptr, _IONBF, 0);
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+   app.pApplicationName = "pipeline-library-link-time";
+   app.apiVersion = VK_API_VERSION_1_3;
+   VkInstanceCreateInfo instance_info{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+   instance_info.pApplicationInfo = &app;
+   auto result = vkCreateInstance(&instance_info, nullptr, &instance);
+   require(result == VK_SUCCESS, "create instance", result);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceProperties2);
+   LOAD_I(vkGetPhysicalDeviceQueueFamilyProperties);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+
+   uint32_t physical_count = 0;
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, nullptr);
+   require(result == VK_SUCCESS && physical_count, "physical device count", result);
+   std::vector<VkPhysicalDevice> physicals(physical_count);
+   result = vkEnumeratePhysicalDevices(instance, &physical_count, physicals.data());
+   require(result == VK_SUCCESS, "physical devices", result);
+
+   constexpr VkFormat color_format = VK_FORMAT_R8G8B8A8_UNORM;
+   int failures = 0;
+
+   for (VkPhysicalDevice physical : physicals) {
+      VkPhysicalDeviceGraphicsPipelineLibraryPropertiesEXT gpl_properties{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_GRAPHICS_PIPELINE_LIBRARY_PROPERTIES_EXT};
+      VkPhysicalDeviceProperties2 properties2{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2};
+      properties2.pNext = &gpl_properties;
+      vkGetPhysicalDeviceProperties2(physical, &properties2);
+
+      uint32_t queue_count = 0;
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, nullptr);
+      std::vector<VkQueueFamilyProperties> queues(queue_count);
+      vkGetPhysicalDeviceQueueFamilyProperties(physical, &queue_count, queues.data());
+      uint32_t queue = 0;
+      while (queue < queue_count && !(queues[queue].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+         ++queue;
+      require(queue < queue_count, "graphics queue");
+      float priority = 1.0f;
+      VkDeviceQueueCreateInfo queue_info{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+      queue_info.queueFamilyIndex = queue;
+      queue_info.queueCount = 1;
+      queue_info.pQueuePriorities = &priority;
+      VkPhysicalDeviceGraphicsPipelineLibraryFeaturesEXT gpl_features{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_GRAPHICS_PIPELINE_LIBRARY_FEATURES_EXT};
+      gpl_features.graphicsPipelineLibrary = VK_TRUE;
+      VkPhysicalDeviceVulkan13Features features13{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+      features13.dynamicRendering = VK_TRUE;
+      features13.pNext = &gpl_features;
+      VkPhysicalDeviceFeatures2 features{
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+      features.pNext = &features13;
+      const char *const device_extensions[] = {
+         VK_KHR_PIPELINE_LIBRARY_EXTENSION_NAME,
+         VK_EXT_GRAPHICS_PIPELINE_LIBRARY_EXTENSION_NAME,
+      };
+      VkDeviceCreateInfo device_info{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+      device_info.pNext = &features;
+      device_info.queueCreateInfoCount = 1;
+      device_info.pQueueCreateInfos = &queue_info;
+      device_info.enabledExtensionCount = 2;
+      device_info.ppEnabledExtensionNames = device_extensions;
+      VkDevice device = VK_NULL_HANDLE;
+      result = vkCreateDevice(physical, &device_info, nullptr, &device);
+      require(result == VK_SUCCESS, "create device", result);
+
+      LOAD_D(vkDestroyDevice);
+      LOAD_D(vkCreateShaderModule);
+      LOAD_D(vkDestroyShaderModule);
+      LOAD_D(vkCreatePipelineLayout);
+      LOAD_D(vkDestroyPipelineLayout);
+      LOAD_D(vkCreateGraphicsPipelines);
+      LOAD_D(vkDestroyPipeline);
+
+      auto make_module = [&](const uint32_t *code, size_t size) {
+         VkShaderModuleCreateInfo module_info{
+            VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+         module_info.codeSize = size;
+         module_info.pCode = code;
+         VkShaderModule module = VK_NULL_HANDLE;
+         result = vkCreateShaderModule(device, &module_info, nullptr, &module);
+         require(result == VK_SUCCESS, "create shader module", result);
+         return module;
+      };
+      VkShaderModule vertex = make_module(vertex_spirv, sizeof(vertex_spirv));
+      VkShaderModule fragment = make_module(fragment_spirv, sizeof(fragment_spirv));
+
+      VkPipelineLayoutCreateInfo layout_info{
+         VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+      VkPipelineLayout layout = VK_NULL_HANDLE;
+      result = vkCreatePipelineLayout(device, &layout_info, nullptr, &layout);
+      require(result == VK_SUCCESS, "create layout", result);
+
+      VkPipelineRenderingCreateInfo rendering{
+         VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+      rendering.colorAttachmentCount = 1;
+      rendering.pColorAttachmentFormats = &color_format;
+
+      /* Each library carries a distinct constant so that no two of the
+       * sixteen links can share a compilation. */
+      const int32_t vertex_seeds[2] = {1, 2};
+      const int32_t fragment_seeds[2] = {3, 4};
+      VkSpecializationMapEntry entry{0, 0, sizeof(int32_t)};
+
+      VkPipeline libraries[8] = {};
+      double creation_ms[8] = {};
+
+      auto create_library = [&](uint32_t index,
+                                VkGraphicsPipelineLibraryFlagsEXT flags,
+                                const VkGraphicsPipelineCreateInfo &base) {
+         VkGraphicsPipelineLibraryCreateInfoEXT library_info{
+            VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_LIBRARY_CREATE_INFO_EXT};
+         library_info.flags = flags;
+         VkGraphicsPipelineCreateInfo info = base;
+         library_info.pNext = base.pNext;
+         info.pNext = &library_info;
+         info.flags |= VK_PIPELINE_CREATE_LIBRARY_BIT_KHR;
+         info.layout = layout;
+         const auto start = Clock::now();
+         result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &info,
+                                            nullptr, &libraries[index]);
+         creation_ms[index] = ms_since(start);
+         require(result == VK_SUCCESS, "create library", result);
+      };
+
+      /* Vertex input interface */
+      VkVertexInputBindingDescription binding{0, 16,
+                                              VK_VERTEX_INPUT_RATE_VERTEX};
+      VkVertexInputAttributeDescription attribute{
+         0, 0, VK_FORMAT_R32G32B32A32_SFLOAT, 0};
+      VkPipelineVertexInputStateCreateInfo vertex_input{
+         VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+      vertex_input.vertexBindingDescriptionCount = 1;
+      vertex_input.pVertexBindingDescriptions = &binding;
+      vertex_input.vertexAttributeDescriptionCount = 1;
+      vertex_input.pVertexAttributeDescriptions = &attribute;
+      VkPipelineInputAssemblyStateCreateInfo assembly[2]{};
+      for (uint32_t i = 0; i < 2; ++i) {
+         assembly[i].sType =
+            VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
+         assembly[i].topology = i == 0 ? VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP
+                                       : VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+      }
+      for (uint32_t i = 0; i < 2; ++i) {
+         VkGraphicsPipelineCreateInfo info{
+            VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+         info.pVertexInputState = &vertex_input;
+         info.pInputAssemblyState = &assembly[i];
+         create_library(i,
+                        VK_GRAPHICS_PIPELINE_LIBRARY_VERTEX_INPUT_INTERFACE_BIT_EXT,
+                        info);
+      }
+
+      /* Pre-rasterization shaders */
+      VkViewport viewport{0.0f, 0.0f, 32.0f, 32.0f, 0.0f, 1.0f};
+      VkRect2D scissor{{0, 0}, {32, 32}};
+      VkPipelineViewportStateCreateInfo viewport_state{
+         VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+      viewport_state.viewportCount = 1;
+      viewport_state.pViewports = &viewport;
+      viewport_state.scissorCount = 1;
+      viewport_state.pScissors = &scissor;
+      VkPipelineRasterizationStateCreateInfo rasterization[2]{};
+      VkSpecializationInfo vertex_spec[2]{};
+      VkPipelineShaderStageCreateInfo vertex_stage[2]{};
+      for (uint32_t i = 0; i < 2; ++i) {
+         rasterization[i].sType =
+            VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
+         rasterization[i].polygonMode =
+            i == 0 ? VK_POLYGON_MODE_FILL : VK_POLYGON_MODE_LINE;
+         rasterization[i].cullMode = VK_CULL_MODE_NONE;
+         rasterization[i].frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+         rasterization[i].lineWidth = 1.0f;
+         vertex_spec[i] = {1, &entry, sizeof(int32_t), &vertex_seeds[i]};
+         vertex_stage[i].sType =
+            VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+         vertex_stage[i].stage = VK_SHADER_STAGE_VERTEX_BIT;
+         vertex_stage[i].module = vertex;
+         vertex_stage[i].pName = "main";
+         vertex_stage[i].pSpecializationInfo = &vertex_spec[i];
+
+         VkGraphicsPipelineCreateInfo info{
+            VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+         info.pNext = &rendering;
+         info.stageCount = 1;
+         info.pStages = &vertex_stage[i];
+         info.pViewportState = &viewport_state;
+         info.pRasterizationState = &rasterization[i];
+         create_library(
+            2 + i, VK_GRAPHICS_PIPELINE_LIBRARY_PRE_RASTERIZATION_SHADERS_BIT_EXT,
+            info);
+      }
+
+      /* Fragment shader */
+      VkPipelineMultisampleStateCreateInfo multisample{
+         VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+      multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+      VkPipelineDepthStencilStateCreateInfo depth_stencil{
+         VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+      depth_stencil.maxDepthBounds = 1.0f;
+      VkSpecializationInfo fragment_spec[2]{};
+      VkPipelineShaderStageCreateInfo fragment_stage[2]{};
+      for (uint32_t i = 0; i < 2; ++i) {
+         fragment_spec[i] = {1, &entry, sizeof(int32_t), &fragment_seeds[i]};
+         fragment_stage[i].sType =
+            VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+         fragment_stage[i].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+         fragment_stage[i].module = fragment;
+         fragment_stage[i].pName = "main";
+         fragment_stage[i].pSpecializationInfo = &fragment_spec[i];
+
+         VkGraphicsPipelineCreateInfo info{
+            VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+         info.pNext = &rendering;
+         info.stageCount = 1;
+         info.pStages = &fragment_stage[i];
+         info.pMultisampleState = &multisample;
+         info.pDepthStencilState = &depth_stencil;
+         create_library(
+            4 + i, VK_GRAPHICS_PIPELINE_LIBRARY_FRAGMENT_SHADER_BIT_EXT, info);
+      }
+
+      /* Fragment output interface */
+      VkPipelineColorBlendAttachmentState blend_attachment[2]{};
+      VkPipelineColorBlendStateCreateInfo blend[2]{};
+      for (uint32_t i = 0; i < 2; ++i) {
+         blend_attachment[i].colorWriteMask =
+            i == 0 ? (VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT |
+                      VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT)
+                   : (VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_A_BIT);
+         blend[i].sType =
+            VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
+         blend[i].attachmentCount = 1;
+         blend[i].pAttachments = &blend_attachment[i];
+
+         VkGraphicsPipelineCreateInfo info{
+            VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+         info.pNext = &rendering;
+         info.pMultisampleState = &multisample;
+         info.pColorBlendState = &blend[i];
+         create_library(
+            6 + i,
+            VK_GRAPHICS_PIPELINE_LIBRARY_FRAGMENT_OUTPUT_INTERFACE_BIT_EXT,
+            info);
+      }
+
+      std::printf("%s\n", properties2.properties.deviceName);
+      std::printf("  graphicsPipelineLibraryFastLinking = %s\n",
+                  gpl_properties.graphicsPipelineLibraryFastLinking ? "true"
+                                                                    : "false");
+      for (uint32_t i = 0; i < 8; ++i)
+         std::printf("  library %u creation %8.3f ms\n", i, creation_ms[i]);
+
+      double worst_ratio = 0.0;
+      for (uint32_t i = 0; i < 16; ++i) {
+         const uint32_t vertex_input_index = i % 2;
+         const uint32_t pre_raster_index = (i / 2) % 2;
+         const uint32_t fragment_index = (i / 4) % 2;
+         const uint32_t output_index = (i / 8) % 2;
+         VkPipeline to_link[4] = {
+            libraries[vertex_input_index],
+            libraries[2 + pre_raster_index],
+            libraries[4 + fragment_index],
+            libraries[6 + output_index],
+         };
+         VkPipelineLibraryCreateInfoKHR link{
+            VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR};
+         link.libraryCount = 4;
+         link.pLibraries = to_link;
+         VkGraphicsPipelineCreateInfo info{
+            VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+         info.pNext = &link;
+         info.layout = layout;
+         VkPipeline pipeline = VK_NULL_HANDLE;
+         const auto start = Clock::now();
+         result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &info,
+                                            nullptr, &pipeline);
+         const double link_ms = ms_since(start);
+         require(result == VK_SUCCESS, "link pipeline", result);
+         vkDestroyPipeline(device, pipeline, nullptr);
+
+         const double shader_libraries_ms =
+            creation_ms[2 + pre_raster_index] + creation_ms[4 + fragment_index];
+         const double ratio = link_ms / shader_libraries_ms;
+         if (ratio > worst_ratio)
+            worst_ratio = ratio;
+         std::printf("  link %2u  %8.3f ms  vs shader libraries %8.3f ms  "
+                     "ratio %7.2f%s\n",
+                     i, link_ms, shader_libraries_ms, ratio,
+                     ratio > kRatioLimit ? "  TOO SLOW" : "");
+      }
+      std::printf("  worst ratio %.2f (limit %.0f)\n", worst_ratio, kRatioLimit);
+      if (gpl_properties.graphicsPipelineLibraryFastLinking &&
+          worst_ratio > kRatioLimit) {
+         std::fprintf(stderr,
+                      "a driver that advertises graphicsPipelineLibraryFastLinking "
+                      "must not spend more than %.0f times the creation of the "
+                      "libraries carrying its shaders on a link; worst ratio was "
+                      "%.2f\n",
+                      kRatioLimit, worst_ratio);
+         ++failures;
+      }
+
+      for (VkPipeline library : libraries)
+         vkDestroyPipeline(device, library, nullptr);
+      vkDestroyPipelineLayout(device, layout, nullptr);
+      vkDestroyShaderModule(device, vertex, nullptr);
+      vkDestroyShaderModule(device, fragment, nullptr);
+      vkDestroyDevice(device, nullptr);
+   }
+
+   vkDestroyInstance(instance, nullptr);
+   return failures ? 1 : 0;
+}
