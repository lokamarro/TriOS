From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 26 Sep 2026 23:33:37 +0900
Subject: [PATCH] kosmickrisp: release a destroyed allocation from residency at
 once

A residency set holds every allocation of its last commit, and removing
an allocation takes effect only at the next commit. The device set is
committed only when work is submitted, so memory freed after a submission
had made it resident stayed allocated until the device's next
submission. A client that frees and reallocates without submitting, or
never submits again, accumulated the freed memory.

Commit the set whenever an allocation leaves it. Vulkan requires the work
that uses an object to finish before the object is destroyed, so the
commit cannot take residency from pending work.

That commit and the release after it run on the freeing thread, beside
the queue commits of the submitting thread. Metal reads the residency
sets of a queue while it commits to it, and the methods of a set are not
thread-safe: under Metal's GPU validation the queue commit walks every
heap of the device set, so a heap removed and released meanwhile was
freed under the walk, and every validated run of
KHR-GLES31.core.texture_cube_map_array.sampling crashed in
HeapUsageTable::processHeapEntry. Commit to a queue under the lock that
every write to the set holds. A write then waits for at most the commit
in flight, so a freed allocation still stops counting against the device
when vkFreeMemory returns. Staging writes for the committing thread
instead cost that thread 40% of its submissions under a storm of
allocations, where the lock costs the allocating thread a third of its
allocations and the submitting thread nothing.

test_residency_commit_race allocates and frees memory on one thread
while another submits, under shader validation; without the lock it
crashes almost every run.
---
 src/kosmickrisp/vulkan/kk_device.c            |  47 +++-
 src/kosmickrisp/vulkan/kk_device.h            |   5 +
 src/kosmickrisp/vulkan/kk_queue.c             |   6 +-
 src/kosmickrisp/vulkan/meson.build            |  37 +++
 .../tests/test_residency_commit_race.cpp      | 257 ++++++++++++++++++
 .../vulkan/tests/test_residency_release.m     | 117 ++++++++
 6 files changed, 460 insertions(+), 9 deletions(-)
 create mode 100644 src/kosmickrisp/vulkan/tests/test_residency_commit_race.cpp
 create mode 100644 src/kosmickrisp/vulkan/tests/test_residency_release.m

diff --git a/src/kosmickrisp/vulkan/kk_device.c b/src/kosmickrisp/vulkan/kk_device.c
index 83ccc40a2920313e3978351cc724e76cd4f49e37..17247a46280e67677483b64f9ab04ba98ce526fa 100644
--- a/src/kosmickrisp/vulkan/kk_device.c
+++ b/src/kosmickrisp/vulkan/kk_device.c
@@ -554,14 +554,30 @@ kk_device_add_heap_to_residency_set(struct kk_device *dev, mtl_heap *heap)
    simple_mtx_unlock(&dev->residency_set.mutex);
 }
 
-void
-kk_device_remove_heap_from_residency_set(struct kk_device *dev, mtl_heap *heap)
+/* A residency set holds every allocation of its last commit, and a removal
+ * takes effect only at the next commit. The device set is otherwise committed
+ * only when work is submitted, so a destroyed allocation that a submission
+ * once made resident would stay allocated until the device's next submission,
+ * which may never come. Commit the removal at once. Vulkan requires work that
+ * uses an object to finish before the object is destroyed, so this cannot take
+ * residency from pending work.
+ */
+static void
+kk_device_remove_from_residency_set(struct kk_device *dev,
+                                    mtl_allocation *allocation)
 {
    simple_mtx_lock(&dev->residency_set.mutex);
-   mtl_residency_set_remove_allocation(dev->residency_set.handle, heap);
+   mtl_residency_set_remove_allocation(dev->residency_set.handle, allocation);
+   mtl_residency_set_commit(dev->residency_set.handle);
    simple_mtx_unlock(&dev->residency_set.mutex);
 }
 
+void
+kk_device_remove_heap_from_residency_set(struct kk_device *dev, mtl_heap *heap)
+{
+   kk_device_remove_from_residency_set(dev, heap);
+}
+
 void
 kk_device_add_buffer_to_residency_set(struct kk_device *dev, mtl_buffer *buffer)
 {
@@ -574,9 +590,7 @@ void
 kk_device_remove_buffer_from_residency_set(struct kk_device *dev,
                                            mtl_buffer *buffer)
 {
-   simple_mtx_lock(&dev->residency_set.mutex);
-   mtl_residency_set_remove_allocation(dev->residency_set.handle, buffer);
-   simple_mtx_unlock(&dev->residency_set.mutex);
+   kk_device_remove_from_residency_set(dev, buffer);
 }
 
 void
@@ -590,9 +604,28 @@ kk_device_add_texture_to_residency_set(struct kk_device *dev, mtl_texture *textu
 void
 kk_device_remove_texture_from_residency_set(struct kk_device *dev,
                                             mtl_texture *texture)
+{
+   kk_device_remove_from_residency_set(dev, texture);
+}
+
+/* Metal attaches the residency sets of a queue to the work committed to it,
+ * reading them during the commit, and the methods of a set are not
+ * thread-safe. Under Metal's GPU validation the commit also walks every heap
+ * of the device set, and a heap another thread removed and released during
+ * that walk was freed under it. Every write to the device set holds its
+ * mutex, so a commit holding it too keeps every write out of the commit, and
+ * the commit only ever sees heaps that are still alive. A write waits for at
+ * most the commit in flight, which keeps a freed allocation from counting
+ * against the device once vkFreeMemory returns. No feedback handler takes the
+ * mutex, so one Metal dispatches before commit returns cannot deadlock
+ * against it. */
+void
+kk_device_commit_to_queue(struct kk_device *dev, mtl_command_queue *queue,
+                          mtl_command_buffer **command_buffers, uint32_t count,
+                          mtl_commit_options *options)
 {
    simple_mtx_lock(&dev->residency_set.mutex);
-   mtl_residency_set_remove_allocation(dev->residency_set.handle, texture);
+   mtl_command_queue_commit(queue, command_buffers, count, options);
    simple_mtx_unlock(&dev->residency_set.mutex);
 }
 
diff --git a/src/kosmickrisp/vulkan/kk_device.h b/src/kosmickrisp/vulkan/kk_device.h
index b6abffab30bf792984aa9890ae4d44b0abf3ba76..e726ab2ed10d6d309944ffe67f53eca7fec883cc 100644
--- a/src/kosmickrisp/vulkan/kk_device.h
+++ b/src/kosmickrisp/vulkan/kk_device.h
@@ -221,6 +221,11 @@ void kk_device_add_texture_to_residency_set(struct kk_device *dev,
 void kk_device_remove_texture_from_residency_set(struct kk_device *dev,
                                                 mtl_texture *texture);
 void kk_device_make_resources_resident(struct kk_device *dev);
+/* Commits to a queue the device set is attached to, never while the set is
+ * being written. */
+void kk_device_commit_to_queue(struct kk_device *dev, mtl_command_queue *queue,
+                               mtl_command_buffer **command_buffers,
+                               uint32_t count, mtl_commit_options *options);
 
 /* Required to create a sampler */
 mtl_sampler *kk_sampler_create(struct kk_device *dev,
diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index d595b8a606cdcd547dd3c8b75fc9e40aedfd27d9..ed0a65c9d0fa19e8a439d473f052b2d6362998f1 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -508,7 +508,8 @@ kk_queue_probe(struct kk_queue *queue)
                                            storage);
    mtl_commit_options_add_feedback_handler(options, queue->feedback_callback,
                                            submission);
-   mtl_command_queue_commit(queue->mtl_handle, &command_buffer, 1, options);
+   kk_device_commit_to_queue(dev, queue->mtl_handle, &command_buffer, 1,
+                             options);
    mtl_release(options);
    probed = true;
 
@@ -680,7 +681,8 @@ kk_queue_submit_locked(struct kk_queue *queue, struct vk_queue_submit *submit)
          }
          mtl_commit_options_add_feedback_handler(
             options, queue->feedback_callback, submission);
-         mtl_command_queue_commit(queue->mtl_handle, cmds, count, options);
+         kk_device_commit_to_queue(dev, queue->mtl_handle, cmds, count,
+                                   options);
          mtl_release(options);
          if (recording)
             kk_completed_recording_unref(recording);
