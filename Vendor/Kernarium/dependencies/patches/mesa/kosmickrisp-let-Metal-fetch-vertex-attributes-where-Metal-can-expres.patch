+#version 450
+/* The same single attribute as fetch_single.vert, at the highest location
+ * maxVertexInputAttributes allows.  MSL numbers an [[attribute(n)]] from zero
+ * to thirty, so location 31 has no Metal attribute to name it and the pipeline
+ * has to keep the shader-lowered fetch. */
+layout(location = 31) in uvec2 in_index;
+layout(location = 0) out vec4 out_value;
+void main()
+{
+   const vec2 corner[3] =
+      vec2[3](vec2(-1.0, -1.0), vec2(3.0, -1.0), vec2(-1.0, 3.0));
+   gl_Position = vec4(corner[gl_VertexIndex], 0.0, 1.0);
+   out_value = vec4(float(in_index.x) / 255.0, float(in_index.y) / 255.0, 0.0,
+                    1.0);
+}
