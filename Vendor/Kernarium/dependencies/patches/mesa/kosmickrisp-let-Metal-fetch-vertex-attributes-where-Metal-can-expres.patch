+      {
+         require(properties.limits.maxVertexInputAttributes >= 32u,
+                 "maxVertexInputAttributes");
+         module_info.codeSize = sizeof(vertex_high_location_spirv);
+         module_info.pCode = vertex_high_location_spirv;
+         VkShaderModule high_location_module = VK_NULL_HANDLE;
+         require(vkCreateShaderModule(device, &module_info, nullptr,
+                                      &high_location_module) == VK_SUCCESS,
+                 "vkCreateShaderModule high location");
+
+         const uint8_t high_location_data[3][4] = {
+            {kIndex[0], kIndex[1], 0u, 0u},
+            {kIndex[0], kIndex[1], 0u, 0u},
+            {kIndex[0], kIndex[1], 0u, 0u},
+         };
+         VkBuffer high_location_buffer = VK_NULL_HANDLE;
+         VkDeviceMemory high_location_memory = VK_NULL_HANDLE;
+         void *high_location_map = nullptr;
+         make_buffer(sizeof(high_location_data),
+                     VK_BUFFER_USAGE_VERTEX_BUFFER_BIT, &high_location_buffer,
+                     &high_location_memory, &high_location_map);
+         std::memcpy(high_location_map, high_location_data,
+                     sizeof(high_location_data));
+
+         VkPipelineShaderStageCreateInfo high_location_stages[2] = {stages[0],
+                                                                    stages[1]};
+         high_location_stages[0].module = high_location_module;
+         const VkVertexInputBindingDescription high_location_binding = {
+            0u, 4u, VK_VERTEX_INPUT_RATE_VERTEX};
+         /* The shader declares this location; see fetch_high_location.vert. */
+         const VkVertexInputAttributeDescription high_location_attribute = {
+            31u, 0u, VK_FORMAT_R8G8_UINT, 0u};
+         VkPipelineVertexInputStateCreateInfo high_location_input{
+            VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+         high_location_input.vertexBindingDescriptionCount = 1;
+         high_location_input.pVertexBindingDescriptions =
+            &high_location_binding;
+         high_location_input.vertexAttributeDescriptionCount = 1;
+         high_location_input.pVertexAttributeDescriptions =
+            &high_location_attribute;
+
+         VkGraphicsPipelineCreateInfo high_location_info = pipeline_info;
+         high_location_info.pStages = high_location_stages;
+         high_location_info.pVertexInputState = &high_location_input;
+         VkPipeline high_location_pipeline = VK_NULL_HANDLE;
+         require(vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
+                                           &high_location_info, nullptr,
+                                           &high_location_pipeline) ==
+                    VK_SUCCESS,
+                 "vkCreateGraphicsPipelines high location");
+
+         require(vkBeginCommandBuffer(command, &begin) == VK_SUCCESS,
+                 "vkBeginCommandBuffer high location");
+         vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                              VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, 0,
+                              0, nullptr, 0, nullptr, 1, &to_colour);
+         vkCmdBeginRendering(command, &rendering_info);
+         vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS,
+                           high_location_pipeline);
+         const VkDeviceSize high_location_offset = 0u;
+         vkCmdBindVertexBuffers(command, 0, 1, &high_location_buffer,
+                                &high_location_offset);
+         vkCmdDraw(command, 3, 1, 0, 0);
+         vkCmdEndRendering(command);
+         vkCmdPipelineBarrier(command,
+                              VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                              VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0,
+                              nullptr, 1, &to_source);
+         vkCmdCopyImageToBuffer(command, image,
+                                VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, readback,
+                                1, &copy);
+         require(vkEndCommandBuffer(command) == VK_SUCCESS,
+                 "vkEndCommandBuffer high location");
+         require(vkQueueSubmit(queue, 1, &submit, VK_NULL_HANDLE) == VK_SUCCESS,
+                 "vkQueueSubmit high location");
+         require(vkQueueWaitIdle(queue) == VK_SUCCESS,
+                 "vkQueueWaitIdle high location");
+
+         const float high_location_expected[4] = {kIndex[0] / 255.0f,
+                                                  kIndex[1] / 255.0f, 0.0f,
+                                                  1.0f};
+         int high_location_failures = 0;
+         for (uint32_t p = 0; p < kExtent * kExtent; ++p) {
+            for (uint32_t c = 0; c < 4; ++c) {
+               const float got = pixels[p * 4u + c] / 255.0f;
+               if (std::fabs(got - high_location_expected[c]) > 1.5f / 255.0f) {
+                  std::fprintf(stderr,
+                               "high location: pixel %u channel %u is %.4f, "
+                               "expected %.4f\n",
+                               p, c, got, high_location_expected[c]);
+                  ++high_location_failures;
+               }
+            }
+         }
+         std::printf("  attribute at the last vertex input location       "
+                     "        %s\n",
+                     high_location_failures == 0 ? "ok" : "WRONG");
+         failures += high_location_failures;
+
+         vkDestroyPipeline(device, high_location_pipeline, nullptr);
+         vkDestroyShaderModule(device, high_location_module, nullptr);
+         vkDestroyBuffer(device, high_location_buffer, nullptr);
+         vkFreeMemory(device, high_location_memory, nullptr);
+      }
+      /* KosmicKrisp precompiles bounded raster variants for point and line
+       * rasterization, and generates their fragment stages.  Those generated
+       * shaders are linked against the same vertex stage, so they have to
+       * agree with a vertex function that takes its attributes through
+       * [[stage_in]] rather than reading them itself. */
+      {
+         struct RasterCase {
+            const char *name;
+            VkPrimitiveTopology topology;
+            VkPolygonMode polygon_mode;
+         };
+         static const RasterCase raster_cases[] = {
+            {"point list", VK_PRIMITIVE_TOPOLOGY_POINT_LIST,
+             VK_POLYGON_MODE_FILL},
+            {"line list", VK_PRIMITIVE_TOPOLOGY_LINE_LIST,
+             VK_POLYGON_MODE_FILL},
+            {"polygon mode point", VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
+             VK_POLYGON_MODE_POINT},
+            {"polygon mode line", VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
+             VK_POLYGON_MODE_LINE},
+         };
+         for (const RasterCase &raster : raster_cases) {
+            VkPipelineInputAssemblyStateCreateInfo raster_assembly =
+               input_assembly;
+            raster_assembly.topology = raster.topology;
+            VkPipelineRasterizationStateCreateInfo raster_state = rasterization;
+            raster_state.polygonMode = raster.polygon_mode;
+
+            VkPipelineShaderStageCreateInfo raster_stages[2] = {stages[0],
+                                                                stages[1]};
+            raster_stages[0].module = single_module_kept;
+            const VkVertexInputBindingDescription raster_binding = {
+               0u, 4u, VK_VERTEX_INPUT_RATE_VERTEX};
+            const VkVertexInputAttributeDescription raster_attribute = {
+               5u, 0u, VK_FORMAT_R8G8_UINT, 0u};
+            VkPipelineVertexInputStateCreateInfo raster_input{
+               VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+            raster_input.vertexBindingDescriptionCount = 1;
+            raster_input.pVertexBindingDescriptions = &raster_binding;
+            raster_input.vertexAttributeDescriptionCount = 1;
+            raster_input.pVertexAttributeDescriptions = &raster_attribute;
+
+            VkGraphicsPipelineCreateInfo raster_info = pipeline_info;
+            raster_info.pStages = raster_stages;
+            raster_info.pVertexInputState = &raster_input;
+            raster_info.pInputAssemblyState = &raster_assembly;
+            raster_info.pRasterizationState = &raster_state;
+            VkPipeline raster_pipeline = VK_NULL_HANDLE;
+            const VkResult created = vkCreateGraphicsPipelines(
+               device, VK_NULL_HANDLE, 1, &raster_info, nullptr,
+               &raster_pipeline);
+            if (created != VK_SUCCESS) {
+               std::fprintf(stderr, "%s: vkCreateGraphicsPipelines %d\n",
+                            raster.name, created);
+               std::printf("  raster variant: %-26s WRONG\n", raster.name);
+               ++failures;
+               continue;
+            }
+            std::printf("  raster variant: %-26s ok\n", raster.name);
+            vkDestroyPipeline(device, raster_pipeline, nullptr);
+         }
+      }
+
+      vkDestroyShaderModule(device, single_module_kept, nullptr);
+
+      vkDestroyPipeline(device, pipeline, nullptr);
+      vkDestroyImageView(device, view, nullptr);
+      vkDestroyImage(device, image, nullptr);
+      vkFreeMemory(device, image_memory, nullptr);
+      vkDestroyBuffer(device, readback, nullptr);
+      vkFreeMemory(device, readback_memory, nullptr);
+      vkDestroyBuffer(device, vertex_buffer, nullptr);
+      vkFreeMemory(device, vertex_memory, nullptr);
+      vkDestroyBuffer(device, instance_buffer, nullptr);
+      vkFreeMemory(device, instance_memory, nullptr);
+      vkDestroyCommandPool(device, pool, nullptr);
+      vkDestroyPipelineLayout(device, layout, nullptr);
+      vkDestroyShaderModule(device, fragment_module, nullptr);
+      vkDestroyShaderModule(device, vertex_module, nullptr);
+      vkDestroyDevice(device, nullptr);
+
+      vkDestroyInstance(instance, nullptr);
+      return failures == 0 ? 0 : 1;
+   }
+}
