+/* Metal's own vertex fetch.  An attribute names the buffer binding it reads
+ * through, and that binding's layout carries the stride and the step, so the
+ * vertex shader keeps a plain [[stage_in]] argument and stays independent of
+ * the vertex-input state. */
+void mtl_render_pipeline_descriptor_set_vertex_attribute(
+   mtl_render_pipeline_descriptor *descriptor, uint32_t attribute,
+   enum mtl_vertex_format format, uint32_t offset, uint32_t buffer_index);
+
+void mtl_render_pipeline_descriptor_set_vertex_layout(
+   mtl_render_pipeline_descriptor *descriptor, uint32_t buffer_index,
+   uint32_t stride, enum mtl_vertex_step_function step, uint32_t step_rate);
+
 /* Metal's fixed-function blend for one colour attachment.  A pipeline whose
  * blend state Metal cannot express keeps kk_lower_fs_blend instead, so the
  * factors and operations reaching here are always ones Metal has. */
diff --git a/src/kosmickrisp/bridge/mtl_compiler.m b/src/kosmickrisp/bridge/mtl_compiler.m
index 6730f8af364c6ca79be47d39b9ddf9e29d6c0d48..def3b7f6a0708a677444b963341c64ba1c0ac709 100644
