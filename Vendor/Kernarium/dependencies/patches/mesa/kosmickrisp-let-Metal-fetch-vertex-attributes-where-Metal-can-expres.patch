+      return false;
+
+   if (KK_DEBUG(FORCE_ROBUSTNESS))
+      return false;
+
+   static const enum mesa_vk_dynamic_graphics_state baked[] = {
+      MESA_VK_DYNAMIC_VI,
+      MESA_VK_DYNAMIC_VI_BINDINGS_VALID,
+      MESA_VK_DYNAMIC_VI_BINDING_STRIDES,
+   };
+   for (uint32_t i = 0; i < ARRAY_SIZE(baked); ++i) {
+      if (BITSET_TEST(state->dynamic, baked[i]))
+         return false;
+   }
+
+   static_assert(KK_MAX_NATIVE_VERTEX_ATTRIBS <= KK_MAX_ATTRIBS,
+                 "Metal cannot name more attributes than Vulkan has");
+
+   u_foreach_bit(i, state->vi->attributes_valid) {
+      const struct vk_vertex_attribute_state *attr = &state->vi->attributes[i];
+      if (!(state->vi->bindings_valid & BITFIELD_BIT(attr->binding)))
+         return false;
+      const struct vk_vertex_binding_state *binding =
+         &state->vi->bindings[attr->binding];
