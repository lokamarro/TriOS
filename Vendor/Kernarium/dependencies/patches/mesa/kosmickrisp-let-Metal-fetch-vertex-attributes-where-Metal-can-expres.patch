+/* Generate the struct definition for the vertex shader input argument.  It
+ * exists only while the vertex shader still reads its attributes, which is to
+ * say while KosmicKrisp left the fetch to Metal's own MTLVertexDescriptor;
+ * kk_lower_vs_vbo turns every load_input into a buffer load and leaves
+ * inputs_read empty, and an emulated vertex stage is a compute shader by the
+ * time it reaches here, so neither grows a [[stage_in]] argument.
+ *
+ * Every attribute is declared with four components.  Metal fills the channels
+ * a narrower vertex format does not supply with (0, 0, 0, 1), which is exactly
+ * what Vulkan requires of an attribute the shader reads wider than the format.
+ */
+static void
+vs_input_block(nir_shader *shader, struct nir_to_msl_ctx *ctx)
+{
+   P(ctx, "struct VertexIn {\n");
+   ctx->indentlevel++;
+   u_foreach_bit64(location, shader->info.inputs_read) {
+      assert(location >= VERT_ATTRIB_GENERIC0 && "not a Vulkan attribute");
+      const unsigned attribute = location - VERT_ATTRIB_GENERIC0;
+      const char *type = alu_type_to_string(ctx->inputs_info[location].type);
+      P_IND(ctx, "%s4 attribute_%u [[attribute(%u)]];\n", type, attribute,
+            attribute);
+   }
+   ctx->indentlevel--;
+   P(ctx, "};\n");
+}
+
 /* Generate the struct definition for the fragment shader input argument */
 static void
 fs_input_block(nir_shader *shader, struct nir_to_msl_ctx *ctx)
@@ -457,6 +484,8 @@ msl_emit_io_blocks(struct nir_to_msl_ctx *ctx, nir_shader *shader)
 {
    switch (ctx->shader->info.stage) {
    case MESA_SHADER_VERTEX:
+      if (shader->info.inputs_read)
+         vs_input_block(shader, ctx);
       vs_output_block(shader, ctx);
       break;
    case MESA_SHADER_FRAGMENT:
@@ -529,6 +558,10 @@ msl_input_name(struct nir_to_msl_ctx *ctx, unsigned location,
 {
    P(ctx, "in.");
    switch (ctx->shader->info.stage) {
+   case MESA_SHADER_VERTEX:
+      assert(location >= VERT_ATTRIB_GENERIC0 && "not a Vulkan attribute");
+      P(ctx, "attribute_%u", location - VERT_ATTRIB_GENERIC0);
+      break;
    case MESA_SHADER_FRAGMENT:
       varying_slot_name(ctx, location, component);
       break;
@@ -540,8 +573,11 @@ msl_input_name(struct nir_to_msl_ctx *ctx, unsigned location,
 uint32_t
 msl_input_num_components(struct nir_to_msl_ctx *ctx, uint32_t location)
 {
-   if (ctx->shader->info.stage == MESA_SHADER_FRAGMENT &&
-       VARYING_SLOT_INFO[location].scalarized)
+   /* vs_input_block declares every attribute as a four-component vector. */
+   if (ctx->shader->info.stage == MESA_SHADER_VERTEX)
+      return 4;
+   else if (ctx->shader->info.stage == MESA_SHADER_FRAGMENT &&
+            VARYING_SLOT_INFO[location].scalarized)
       return 1;
    else
       return ctx->inputs_info[location].num_components;
diff --git a/src/kosmickrisp/compiler/nir_to_msl.c b/src/kosmickrisp/compiler/nir_to_msl.c
index b09a76d3b6220a88cddf39dbc0ce44978b1d4625..d77537c3ea6bf584640b043f0b0d553d144e35ad 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.c
+++ b/src/kosmickrisp/compiler/nir_to_msl.c
@@ -217,6 +217,12 @@ static void
 emit_inputs(struct nir_to_msl_ctx *ctx, nir_shader *shader)
 {
    switch (shader->info.stage) {
+   case MESA_SHADER_VERTEX:
+      /* Only while Metal's own vertex descriptor does the fetch; see
+       * vs_input_block. */
+      if (shader->info.inputs_read)
+         P_IND(ctx, "VertexIn in [[stage_in]],\n");
+      break;
    case MESA_SHADER_FRAGMENT:
       P_IND(ctx, "FragmentIn in [[stage_in]],\n");
       break;
diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.c b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
index ddd8da4fe0b709afab3950c38f12d55c4b3b8ff4..fcb0582b3f6092b1eeec6b2d258a5e2b47c4a770 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
@@ -170,7 +170,17 @@ kk_create_cmd_buffer(struct vk_command_pool *vk_pool,
    {
       mtl_argument_table_descriptor *desc = mtl_new_argument_table_descriptor();
       /* Root at 0, samplers at 1 and per draw data at 2 */
-      mtl_set_max_buffer_binding_count(desc, 3u);
+      /* Metal caps the table at KK_MAX_ARGUMENT_TABLE_BUFFERS binds, so ask
+       * for exactly that: the three fixed slots and, above them, one slot for
+       * every vertex buffer Metal's own fetch is allowed to read.  A binding
+       * past those keeps the shader-lowered fetch and needs no slot here; see
+       * kk_vertex_input_is_metal_expressible. */
+      static_assert(KK_VERTEX_BUFFER_BINDING_BASE + KK_MAX_NATIVE_VBUFS <=
+                       KK_MAX_ARGUMENT_TABLE_BUFFERS,
+                    "argument table must stay inside Metal's bind limit");
+      static_assert(KK_MAX_NATIVE_VBUFS <= KK_MAX_VBUFS,
+                    "Metal cannot fetch from more bindings than Vulkan has");
+      mtl_set_max_buffer_binding_count(desc, KK_MAX_ARGUMENT_TABLE_BUFFERS);
       cmd->argument_table = mtl_new_argument_table(dev->mtl_handle, desc);
       mtl_set_address(cmd->argument_table, dev->samplers.table.bo->gpu, 1u);
       mtl_release(desc);
