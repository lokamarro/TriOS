+      /* The MSL backend names an attribute after its Vulkan location, and MSL
+       * runs out of [[attribute(n)]] indices before Vulkan runs out of
+       * locations: asking for one past the end fails to compile with
+       * "'attribute' attribute parameter is out of bounds". */
+      if (i >= KK_MAX_NATIVE_VERTEX_ATTRIBS)
+         return false;
