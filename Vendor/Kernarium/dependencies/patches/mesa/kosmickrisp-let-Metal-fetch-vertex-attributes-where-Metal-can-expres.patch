+            MTL_VERTEX_STEP_FUNCTION_PER_INSTANCE;
+         info->vs.vertex_layouts[attr->binding].step_rate = binding->divisor;
+      }
+      info->vs.vertex_buffers_used |= BITFIELD_BIT(attr->binding);
+   }
