index 0000000000000000000000000000000000000000..76575497bbfece9a6c206c54556233547420e34b
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/metal_vertex_fetch_shaders/fetch_single.vert
@@ -0,0 +1,16 @@
+#version 450
+/* One attribute and nothing else, the shape dEQP's vertex_input
+ * single_attribute cases use: the position comes from the vertex index.  Its
+ * location is deliberately not zero, because the MSL backend names an
+ * attribute after its Vulkan location and the vertex descriptor has to be
+ * filled at that same index rather than at a compacted one. */
+layout(location = 5) in uvec2 in_index;
+layout(location = 0) out vec4 out_value;
+void main()
+{
+   const vec2 corner[3] =
+      vec2[3](vec2(-1.0, -1.0), vec2(3.0, -1.0), vec2(-1.0, 3.0));
+   gl_Position = vec4(corner[gl_VertexIndex], 0.0, 1.0);
+   out_value = vec4(float(in_index.x) / 255.0, float(in_index.y) / 255.0, 0.0,
+                    1.0);
+}
