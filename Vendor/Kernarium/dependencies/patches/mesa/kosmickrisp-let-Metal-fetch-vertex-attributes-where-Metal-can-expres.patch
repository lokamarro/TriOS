diff --git a/src/kosmickrisp/vulkan/tests/metal_vertex_fetch_shaders/fetch.vert b/src/kosmickrisp/vulkan/tests/metal_vertex_fetch_shaders/fetch.vert
new file mode 100644
index 0000000000000000000000000000000000000000..b47798091faf30d8c64a8b6dda1dc079ba30c68d
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/metal_vertex_fetch_shaders/fetch.vert
@@ -0,0 +1,18 @@
+#version 450
+/* One interleaved per-vertex buffer carrying three different formats, and a
+ * separate per-instance buffer, so one draw exercises float32, 8-bit and
+ * 16-bit normalized fetch, two bindings, and the instance step function. */
+layout(location = 0) in vec2 in_position;
+layout(location = 1) in vec4 in_colour;
+layout(location = 2) in vec2 in_uv;
+layout(location = 3) in float in_scale;
+/* An integer attribute whose Metal vertex format is narrower than the uvec2
+ * the shader declares, which is what dEQP's single_attribute uint cases use. */
+layout(location = 4) in uvec2 in_index;
+layout(location = 0) out vec4 out_value;
+void main()
+{
+   gl_Position =
+      vec4(in_position.x, in_position.y + float(gl_InstanceIndex), 0.0, 1.0);
+   out_value = vec4(in_colour.r, in_uv.x, in_scale, float(in_index.x) / 255.0);
+}
