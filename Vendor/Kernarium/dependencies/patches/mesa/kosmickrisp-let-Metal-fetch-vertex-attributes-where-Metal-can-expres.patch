+      /* Metal's fetch reads the buffer bound at KK_VERTEX_BUFFER_BINDING_BASE
+       * plus the Vulkan binding, and the argument table has no slot there for
+       * a binding past KK_MAX_NATIVE_VBUFS.  Metal rejects the descriptor
+       * outright - "buffer index (34) must be < 31" - rather than clamping. */
+      if (attr->binding >= KK_MAX_NATIVE_VBUFS)
