+/* SPDX-License-Identifier: MIT */
+
+/* The disk cache publishes an entry by renaming its temporary file onto the
+ * final name. Linked into disk_cache_tmp_test, this definition takes the
+ * place of the C library's for the cache code, so that the test can stop a
+ * writer there: its temporary file is complete and still open, the last
+ * moment at which anything the writer held on it is still held. */
+
+#include <fcntl.h>
+#include <stdio.h>
+
+#include "disk_cache_tmp_rename.h"
+
+static disk_cache_test_rename_hook rename_hook;
+
+void
+disk_cache_test_set_rename_hook(disk_cache_test_rename_hook hook)
+{
+   __atomic_store_n(&rename_hook, hook, __ATOMIC_SEQ_CST);
+}
+
+int
+rename(const char *from, const char *to)
+{
+   disk_cache_test_rename_hook hook =
+      __atomic_load_n(&rename_hook, __ATOMIC_SEQ_CST);
+
+   if (hook)
+      hook(from, to);
+
+   return renameat(AT_FDCWD, from, AT_FDCWD, to);
+}
