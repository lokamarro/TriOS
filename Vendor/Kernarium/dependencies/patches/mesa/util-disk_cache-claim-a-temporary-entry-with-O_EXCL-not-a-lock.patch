-    * it. If the flock fails, then another process still has the file
-    * open with the flock held. So just let that file be responsible
-    * for writing the file.
-    */
-#ifdef HAVE_FLOCK
-   int err = flock(fd, LOCK_EX | LOCK_NB);
-#else
-   struct flock lock = {
-      .l_start = 0,
-      .l_len = 0, /* entire file */
-      .l_type = F_WRLCK,
-      .l_whence = SEEK_SET
-   };
-   int err = fcntl(fd, F_SETLK, &lock);
-#endif
-   if (err == -1)
-      goto done;
-
-   /* Now that we have the lock on the open temporary file, we can
-    * check to see if the destination file already exists. If so,
-    * another process won the race between when we saw that the file
-    * didn't exist and now. In this case, we don't do anything more,
-    * (to ensure the size accounting of the cache doesn't get off).
+   /* Now that we own the temporary file, we can check to see if the
+    * destination file already exists. If so, another process won the
+    * race between when we saw that the file didn't exist and now. In this
+    * case, we don't do anything more, (to ensure the size accounting of
+    * the cache doesn't get off).
     */
    fd_final = open(filename, O_RDONLY | O_CLOEXEC);
    if (fd_final != -1) {
@@ -943,9 +944,6 @@ disk_cache_write_item_to_disk(struct disk_cache_put_job *dc_job,
  done:
    if (fd_final != -1)
       close(fd_final);
-   /* This close finally releases the flock, (now that the final file
-    * has been renamed into place and the size has been added).
-    */
    if (fd != -1)
       close(fd);
