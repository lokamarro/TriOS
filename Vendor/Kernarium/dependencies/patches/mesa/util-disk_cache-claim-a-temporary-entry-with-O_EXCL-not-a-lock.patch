    return false;
 }
 
+/* Create the temporary file of an entry for writing. Fails with EEXIST
+ * while another writer has it. A file old enough to be a dead writer's is
+ * removed first, so that it blocks its entry only for a while.
+ */
+static int
+disk_cache_open_tmp_file(const char *filename_tmp)
+{
+   const int flags = O_WRONLY | O_CLOEXEC | O_CREAT | O_EXCL;
+   int fd = open(filename_tmp, flags, 0644);
+
+   if (fd == -1 && errno == EEXIST) {
+      struct stat sb;
+      if (stat(filename_tmp, &sb) == 0 &&
+          time(NULL) - sb.st_mtime > DISK_CACHE_STALE_TMP_AGE) {
+         unlink(filename_tmp);
+         fd = open(filename_tmp, flags, 0644);
+      }
+   }
+
+   return fd;
+}
