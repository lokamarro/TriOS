@@ -861,7 +873,15 @@ disk_cache_write_item_to_disk(struct disk_cache_put_job *dc_job,
    if (asprintf(&filename_tmp, "%s.tmp", filename) == -1)
       goto done;
 
-   fd = open(filename_tmp, O_WRONLY | O_CLOEXEC | O_CREAT, 0644);
+   /* Whoever creates the temporary file owns the write of this entry. If
+    * it already exists, another thread or process is writing the entry, so
+    * just let that file be responsible for writing the file. The claim is
+    * the exclusive creation, not a lock on the open file, so that a writer
+    * that is stopped or killed halfway holds nothing but its own entry,
+    * and every path below ends with the temporary file renamed or
+    * unlinked.
+    */
+   fd = disk_cache_open_tmp_file(filename_tmp);
 
    /* Make the two-character subdirectory within the cache as needed. */
    if (fd == -1) {
@@ -870,35 +890,16 @@ disk_cache_write_item_to_disk(struct disk_cache_put_job *dc_job,
 
       make_cache_file_directory(dc_job->cache, dc_job->key);
 
-      fd = open(filename_tmp, O_WRONLY | O_CLOEXEC | O_CREAT, 0644);
+      fd = disk_cache_open_tmp_file(filename_tmp);
       if (fd == -1)
          goto done;
    }
 
