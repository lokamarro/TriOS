diff --git a/src/kosmickrisp/vulkan/tests/test_owed_signal_bound.c b/src/kosmickrisp/vulkan/tests/test_owed_signal_bound.c
new file mode 100644
index 0000000000000000000000000000000000000000..f84ec379cc28bce08e1d250428757959cb480d76
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_owed_signal_bound.c
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: MIT */
+
+/* The queue keeps a record of every signal it hands to Metal until the event
+ * reaches its value, so it can raise the ones a failed submission destroys.
+ * A submit with no command buffers still enqueues its signals but commits
+ * nothing, so no completion prunes the list after it.  A guest that polls with
+ * fence- or semaphore-only submits must not grow the list, and the Metal
+ * events it retains, for as long as no command buffer completes. */
+
+#define VK_NO_PROTOTYPES
+#include "kk_device.h"
+#include "kk_queue.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x); abort(); } } while (0)
+#define LOAD_I(name) PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name); CHECK(name)
+#define LOAD_D(name) PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name); CHECK(name)
+
+#define SIGNALS 1000u
+
+int
+main(void)
+{
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+                            .apiVersion = VK_API_VERSION_1_3};
+   VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   CHECK(vkCreateInstance(&instance_info, NULL, &instance) == VK_SUCCESS);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   uint32_t count = 1;
+   VkPhysicalDevice physical = VK_NULL_HANDLE;
+   VkResult enumerated =
+      vkEnumeratePhysicalDevices(instance, &count, &physical);
+   CHECK((enumerated == VK_SUCCESS || enumerated == VK_INCOMPLETE) && count);
+   float priority = 1.0f;
+   VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   VkPhysicalDeviceVulkan12Features features = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES,
+      .timelineSemaphore = VK_TRUE,
+   };
+   VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .pNext = &features,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+   };
+   VkDevice device = VK_NULL_HANDLE;
+   CHECK(vkCreateDevice(physical, &device_info, NULL, &device) == VK_SUCCESS);
+   LOAD_D(vkDestroyDevice);
+   LOAD_D(vkGetDeviceQueue);
+   LOAD_D(vkCreateSemaphore);
+   LOAD_D(vkDestroySemaphore);
+   LOAD_D(vkWaitSemaphores);
+   LOAD_D(vkQueueSubmit);
+   VkQueue queue = VK_NULL_HANDLE;
+   vkGetDeviceQueue(device, 0, 0, &queue);
+
+   VkSemaphoreTypeCreateInfo semaphore_type = {
+      .sType = VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO,
+      .semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE,
+   };
+   VkSemaphoreCreateInfo semaphore_info = {
+      .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO,
+      .pNext = &semaphore_type,
+   };
+   VkSemaphore semaphore = VK_NULL_HANDLE;
+   CHECK(vkCreateSemaphore(device, &semaphore_info, NULL, &semaphore) ==
+         VK_SUCCESS);
+
+   /* Signal-only submits, each waited for, so every event has reached its
+    * value by the time the next signal is recorded. */
+   for (uint64_t value = 1; value <= SIGNALS; value++) {
+      VkTimelineSemaphoreSubmitInfo timeline = {
+         .sType = VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO,
+         .signalSemaphoreValueCount = 1,
+         .pSignalSemaphoreValues = &value,
+      };
+      VkSubmitInfo submit = {
+         .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+         .pNext = &timeline,
+         .signalSemaphoreCount = 1,
+         .pSignalSemaphores = &semaphore,
+      };
+      CHECK(vkQueueSubmit(queue, 1, &submit, VK_NULL_HANDLE) == VK_SUCCESS);
+      VkSemaphoreWaitInfo wait = {
+         .sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO,
+         .semaphoreCount = 1,
+         .pSemaphores = &semaphore,
+         .pValues = &value,
+      };
+      CHECK(vkWaitSemaphores(device, &wait, 10000000000ull) == VK_SUCCESS);
+   }
+
+   /* Only the last record can still be listed: nothing had pruned it yet. */
+   struct kk_queue_feedback *feedback =
+      kk_device_from_handle(device)->queue.feedback;
+   simple_mtx_lock(&feedback->signal_mutex);
+   unsigned listed =
+      util_dynarray_num_elements(&feedback->signals, struct kk_queue_signal);
+   simple_mtx_unlock(&feedback->signal_mutex);
+   fprintf(stderr, "%u owed-signal records after %u signal-only submits\n",
+           listed, SIGNALS);
+   CHECK(listed <= 1u);
+
+   vkDestroySemaphore(device, semaphore, NULL);
+   vkDestroyDevice(device, NULL);
+   vkDestroyInstance(instance, NULL);
+   printf("signal-only submits keep only their outstanding signals\n");
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_signal_lifetime.m b/src/kosmickrisp/vulkan/tests/test_signal_lifetime.m
new file mode 100644
index 0000000000000000000000000000000000000000..ce20df8e1d3777075cbb5f19014cd3e27843650f
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_signal_lifetime.m
@@ -0,0 +1,299 @@
+/* SPDX-License-Identifier: MIT */
+
+/* Whoever sees a signal delivered may destroy the fence or semaphore that
+ * carried it at once: an application may destroy a fence it has read as
+ * signaled, and vkQueueWaitIdle destroys its own sync as soon as its wait
+ * returns. With the assisted submission worker, the worker can still be inside
+ * the driver's submit when that happens, so the driver must take everything it
+ * needs from a signal's sync before handing the signal to Metal.
+ *
+ * The window after the enqueue is a few instructions wide, so the test widens
+ * it. It interposes the Metal queue's signalEvent:value: to hold the submitting
+ * thread once Metal has the signal, and destroys each fence and semaphore as
+ * soon as it reads it signaled. Those objects come from an allocator that
+ * poisons freed memory and never hands it out again, so a driver that reads
+ * one after the enqueue dereferences a poisoned event pointer instead of stale
+ * data or a newer object that reused the memory. */
+
+#define VK_NO_PROTOTYPES
+#include "vk_queue.h"
+
+#include <Metal/Metal.h>
+#include <malloc/malloc.h>
+#include <objc/runtime.h>
+
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x); abort(); } } while (0)
+#define LOAD_I(name) PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name); CHECK(name)
+#define LOAD_D(name) PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name); CHECK(name)
+
+/* How long an interposed signal holds the submitting thread once Metal has
+ * the signal: far longer than Metal takes to deliver a signal on an idle
+ * queue, so the destroy lands inside the hold. */
+static const uint64_t hold_ns = 20ull * 1000000ull;
+static const uint64_t observe_timeout_ns = 10ull * 1000000000ull;
+static const unsigned rounds = 8u;
+
+typedef void (*signal_event_fn)(id, SEL, id, uint64_t);
+static signal_event_fn original_signal_event;
+static atomic_bool hold_signals;
+static atomic_bool holding;
+static atomic_uint held;
+
+static uint64_t
+now_ns(void)
+{
+   return clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+}
+
+static void
+held_signal_event(id queue, SEL selector, id event, uint64_t value)
+{
+   original_signal_event(queue, selector, event, value);
+   if (!atomic_load(&hold_signals))
+      return;
+   atomic_store(&holding, true);
+   atomic_fetch_add(&held, 1u);
+   struct timespec rest = {0, (long)hold_ns};
+   while (nanosleep(&rest, &rest) != 0)
+      ;
+   atomic_store(&holding, false);
+}
+
+/* The pattern is not an Objective-C tagged pointer, so retaining or releasing
+ * a poisoned event faults rather than being ignored. */
+static void *VKAPI_PTR
+quarantine_alloc(void *data, size_t size, size_t alignment,
+                 VkSystemAllocationScope scope)
+{
+   (void)data; (void)scope;
+   void *p = NULL;
+   if (posix_memalign(&p, alignment < sizeof(void *) ? sizeof(void *) : alignment,
+                      size) != 0)
+      return NULL;
+   return p;
+}
+
+static void VKAPI_PTR
+quarantine_free(void *data, void *p)
+{
+   (void)data;
+   if (p)
+      memset(p, 0x55, malloc_size(p));
+}
+
+static void *VKAPI_PTR
+quarantine_realloc(void *data, void *old, size_t size, size_t alignment,
+                   VkSystemAllocationScope scope)
+{
+   if (!size) {
+      quarantine_free(data, old);
+      return NULL;
+   }
+   void *p = quarantine_alloc(data, size, alignment, scope);
+   if (p && old) {
+      size_t kept = malloc_size(old);
+      memcpy(p, old, kept < size ? kept : size);
+      quarantine_free(data, old);
+   }
+   return p;
+}
+
+static const VkAllocationCallbacks quarantine = {
+   .pfnAllocation = quarantine_alloc,
+   .pfnReallocation = quarantine_realloc,
+   .pfnFree = quarantine_free,
+};
+
+static void
+interpose_queue_signal(void)
+{
+   @autoreleasepool {
+      id<MTLDevice> mtl = MTLCreateSystemDefaultDevice();
+      CHECK(mtl);
+      id<MTL4CommandQueue> probe = [mtl newMTL4CommandQueue];
+      CHECK(probe);
+      Method method = class_getInstanceMethod(object_getClass(probe),
+                                              @selector(signalEvent:value:));
+      CHECK(method);
+      original_signal_event = (signal_event_fn)method_getImplementation(method);
+      method_setImplementation(method, (IMP)held_signal_event);
+      [probe release];
+      [mtl release];
+   }
+}
+
+int
+main(void)
+{
+   setvbuf(stdout, NULL, _IONBF, 0);
+   interpose_queue_signal();
+
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app = {
+      .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+      .pApplicationName = "signal-lifetime",
+      .apiVersion = VK_API_VERSION_1_3,
+   };
+   VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   CHECK(vkCreateInstance(&instance_info, NULL, &instance) == VK_SUCCESS);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+
+   uint32_t physical_count = 1;
+   VkPhysicalDevice physical = VK_NULL_HANDLE;
+   VkResult result = vkEnumeratePhysicalDevices(instance, &physical_count,
+                                                &physical);
+   CHECK((result == VK_SUCCESS || result == VK_INCOMPLETE) && physical);
+
+   float priority = 1.0f;
+   VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   VkPhysicalDeviceVulkan12Features features12 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES,
+      .timelineSemaphore = VK_TRUE,
+   };
+   VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .pNext = &features12,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+   };
+   VkDevice device = VK_NULL_HANDLE;
+   CHECK(vkCreateDevice(physical, &device_info, NULL, &device) == VK_SUCCESS);
+
+   LOAD_D(vkDestroyDevice);
+   LOAD_D(vkGetDeviceQueue);
+   LOAD_D(vkCreateSemaphore);
+   LOAD_D(vkDestroySemaphore);
+   LOAD_D(vkSignalSemaphore);
+   LOAD_D(vkGetSemaphoreCounterValue);
+   LOAD_D(vkCreateFence);
+   LOAD_D(vkDestroyFence);
+   LOAD_D(vkGetFenceStatus);
+   LOAD_D(vkQueueSubmit);
+   LOAD_D(vkQueueWaitIdle);
+
+   VkQueue queue = VK_NULL_HANDLE;
+   vkGetDeviceQueue(device, 0, 0, &queue);
+
+   VkSemaphoreTypeCreateInfo timeline_type = {
+      .sType = VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO,
+      .semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE,
+   };
+   VkSemaphoreCreateInfo timeline_info = {
+      .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO,
+      .pNext = &timeline_type,
+   };
+   VkPipelineStageFlags top = VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT;
+
+   /* A wait only the host can release turns the submission worker on, and it
+    * stays on for the life of the device. */
+   VkSemaphore gate = VK_NULL_HANDLE;
+   CHECK(vkCreateSemaphore(device, &timeline_info, NULL, &gate) == VK_SUCCESS);
+   uint64_t gate_value = 1;
+   VkTimelineSemaphoreSubmitInfo gate_values = {
+      .sType = VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO,
+      .waitSemaphoreValueCount = 1,
+      .pWaitSemaphoreValues = &gate_value,
+   };
+   VkSubmitInfo gated = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .pNext = &gate_values,
+      .waitSemaphoreCount = 1,
+      .pWaitSemaphores = &gate,
+      .pWaitDstStageMask = &top,
+   };
+   CHECK(vkQueueSubmit(queue, 1, &gated, VK_NULL_HANDLE) == VK_SUCCESS);
+   VkSemaphoreSignalInfo release = {
+      .sType = VK_STRUCTURE_TYPE_SEMAPHORE_SIGNAL_INFO,
+      .semaphore = gate,
+      .value = 1,
+   };
+   CHECK(vkSignalSemaphore(device, &release) == VK_SUCCESS);
+   CHECK(vkQueueWaitIdle(queue) == VK_SUCCESS);
+   vkDestroySemaphore(device, gate, NULL);
+   {
+      VK_FROM_HANDLE(vk_queue, runtime_queue, queue);
+      CHECK(runtime_queue->submit.mode == VK_QUEUE_SUBMIT_MODE_THREADED);
+   }
+
+   atomic_store(&hold_signals, true);
+   unsigned inside = 0u;
+   for (unsigned round = 0u; round < rounds; ++round) {
+      /* A binary payload, which vkQueueWaitIdle's own sync also uses. */
+      VkFenceCreateInfo fence_info = {
+         .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+      };
+      VkFence fence = VK_NULL_HANDLE;
+      CHECK(vkCreateFence(device, &fence_info, &quarantine, &fence) ==
+            VK_SUCCESS);
+      CHECK(vkQueueSubmit(queue, 0, NULL, fence) == VK_SUCCESS);
+      const uint64_t fence_deadline = now_ns() + observe_timeout_ns;
+      while ((result = vkGetFenceStatus(device, fence)) == VK_NOT_READY)
+         CHECK(now_ns() < fence_deadline);
+      CHECK(result == VK_SUCCESS);
+      vkDestroyFence(device, fence, &quarantine);
+      inside += atomic_load(&holding);
+      /* The worker reaches this submit only after leaving the last one. */
+      CHECK(vkQueueWaitIdle(queue) == VK_SUCCESS);
+
+      /* A timeline payload. */
+      VkSemaphore timeline = VK_NULL_HANDLE;
+      CHECK(vkCreateSemaphore(device, &timeline_info, &quarantine,
+                              &timeline) == VK_SUCCESS);
+      uint64_t signal_value = 1;
+      VkTimelineSemaphoreSubmitInfo signal_values = {
+         .sType = VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO,
+         .signalSemaphoreValueCount = 1,
+         .pSignalSemaphoreValues = &signal_value,
+      };
+      VkSubmitInfo signal = {
+         .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+         .pNext = &signal_values,
+         .signalSemaphoreCount = 1,
+         .pSignalSemaphores = &timeline,
+      };
+      CHECK(vkQueueSubmit(queue, 1, &signal, VK_NULL_HANDLE) == VK_SUCCESS);
+      const uint64_t timeline_deadline = now_ns() + observe_timeout_ns;
+      uint64_t value = 0;
+      while (vkGetSemaphoreCounterValue(device, timeline, &value) ==
+                VK_SUCCESS &&
+             value < signal_value)
+         CHECK(now_ns() < timeline_deadline);
+      CHECK(value == signal_value);
+      vkDestroySemaphore(device, timeline, &quarantine);
+      inside += atomic_load(&holding);
+      CHECK(vkQueueWaitIdle(queue) == VK_SUCCESS);
+   }
+   atomic_store(&hold_signals, false);
+
+   /* Otherwise the interposer never ran, or no destroy landed inside a hold,
+    * and a pass would prove nothing. */
+   CHECK(atomic_load(&held) > 0u);
+   CHECK(inside > 0u);
+   printf("signal lifetime: %u of %u syncs destroyed while the submit worker "
+          "was still inside the submit that signaled them\n",
+          inside, 2u * rounds);
+
+   vkDestroyDevice(device, NULL);
+   vkDestroyInstance(instance, NULL);
+   return 0;
+}
