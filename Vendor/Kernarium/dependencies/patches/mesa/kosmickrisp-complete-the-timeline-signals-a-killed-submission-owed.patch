diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index 4a7026def9df81ec12bbb7678d56165c5c284d02..507b0b8e22f2e1bf30335d7abeee9a60441a0b04 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -21,35 +21,276 @@
 
 #include <stdio.h>
 
+/* Drop every record Metal has already made good, so the list holds only
+ * signals still owed. */
+static void
+kk_queue_signals_prune_locked(struct kk_queue_feedback *feedback)
+{
+   struct kk_queue_signal *records = util_dynarray_begin(&feedback->signals);
+   uint32_t count =
+      util_dynarray_num_elements(&feedback->signals, struct kk_queue_signal);
+   uint32_t kept = 0u;
+
+   for (uint32_t i = 0u; i < count; ++i) {
+      if (mtl_shared_event_get_signaled_value(records[i].event) >=
+          records[i].value)
+         mtl_release(records[i].event);
+      else
+         records[kept++] = records[i];
+   }
+   feedback->signals.size = kept * sizeof(struct kk_queue_signal);
+}
+
+/* Metal discards a queue-level signal that sits behind a submission it kills,
+ * along with the killed submission's own signal. Nothing ever raises those
+ * events again, so every waiter on them - in this process, and through the
+ * guest protocol this driver serves, in another one - would block forever.
+ * Raise them here instead.
+ *
+ * Only signals ordered behind the failing submission are owed. Anything
+ * enqueued after it belongs to work the queue is still running, and raising
+ * that early would tell a waiter its results are ready while the GPU is still
+ * writing them. A failure that took those out too reports itself separately
+ * and makes its own signals good.
+ *
+ * A native event value is set rather than advanced, and Metal sets it too,
+ * with nothing ordering its store against this one. So an event is raised at
+ * most once per sweep, straight to the highest value owed on it, and not at
+ * all while it still has a signal to come from work that is still running:
+ * Metal can deliver that signal between the read and the store here, and the
+ * store would then move the timeline backwards. Such an event is left to the
+ * sweep that runs once the queue has reported everything it was given, when
+ * nothing on it can signal any more, or to the waiter's bound. A record whose
+ * event has already passed its value is not raised either. */
+static unsigned
+kk_queue_signals_make_good(struct kk_queue_feedback *feedback,
+                           uint64_t through_serial)
+{
+   unsigned made_good = 0u;
+
+   simple_mtx_lock(&feedback->signal_mutex);
+   kk_queue_signals_prune_locked(feedback);
+   struct kk_queue_signal *records = util_dynarray_begin(&feedback->signals);
+   uint32_t count =
+      util_dynarray_num_elements(&feedback->signals, struct kk_queue_signal);
+
+   for (uint32_t i = 0u; i < count; ++i) {
+      if (records[i].serial > through_serial)
+         continue;
+
+      /* Decide each event at its oldest owed record. */
+      bool decided = false, pending = false;
+      uint64_t owed = records[i].value;
+      for (uint32_t j = 0u; j < count && !decided && !pending; ++j) {
+         if (j == i || records[j].event != records[i].event)
+            continue;
+         if (records[j].serial > through_serial)
+            pending = true;
+         else if (j < i)
+            decided = true;
+         else
+            owed = MAX2(owed, records[j].value);
+      }
+      if (decided || pending)
+         continue;
+
+      const uint64_t reached =
+         mtl_shared_event_get_signaled_value(records[i].event);
+      if (reached >= owed)
+         continue;
+      mtl_shared_event_set_signaled_value(records[i].event, owed);
+      for (uint32_t j = i; j < count; ++j) {
+         if (records[j].event == records[i].event && records[j].value > reached)
+            ++made_good;
+      }
+   }
+   kk_queue_signals_prune_locked(feedback);
+   simple_mtx_unlock(&feedback->signal_mutex);
+
+   return made_good;
+}
+
+/* Metal reports a failure against one submission, but the work it kills
+ * behind that submission does not always arrive as a report of its own. A
+ * signal enqueued after the reported one can therefore go missing with
+ * nothing naming it, which leaves this the only way to find it: it is the
+ * value the queue accepted and has not delivered. */
+uint64_t
+kk_queue_complete_owed_signals(struct kk_queue *queue, mtl_shared_event *event)
+{
+   struct kk_queue_feedback *feedback = queue->feedback;
+   if (!feedback)
+      return 0u;
+
+   uint64_t owed = 0u;
+
+   simple_mtx_lock(&feedback->signal_mutex);
+   if (feedback->failures > 0u) {
+      util_dynarray_foreach(&feedback->signals, struct kk_queue_signal,
+                            record) {
+         if (record->event == event && record->value > owed)
+            owed = record->value;
+      }
+      if (owed > mtl_shared_event_get_signaled_value(event))
+         mtl_shared_event_set_signaled_value(event, owed);
+      else
+         owed = 0u;
+      kk_queue_signals_prune_locked(feedback);
+   }
+   simple_mtx_unlock(&feedback->signal_mutex);
+
+   return owed;
+}
+
+static void
+kk_queue_signals_retire(struct kk_queue_feedback *feedback)
+{
+   simple_mtx_lock(&feedback->signal_mutex);
+   kk_queue_signals_prune_locked(feedback);
+   simple_mtx_unlock(&feedback->signal_mutex);
+}
+
 static void
 kk_queue_feedback_unref(struct kk_queue_feedback *feedback)
 {
    if (p_atomic_dec_zero(&feedback->refcount)) {
+      util_dynarray_foreach(&feedback->signals, struct kk_queue_signal, record)
+         mtl_release(record->event);
+      util_dynarray_fini(&feedback->signals);
       mtl_release(feedback->queue);
+      simple_mtx_destroy(&feedback->signal_mutex);
       simple_mtx_destroy(&feedback->mutex);
       free(feedback);
    }
 }
 
+/* Reserve the serial of the submission about to be committed. One queue
+ * submits from one thread, so the order these are handed out is the order
+ * Metal receives the work. */
+static uint64_t
+kk_queue_reserve_serial(struct kk_queue_feedback *feedback)
+{
+   simple_mtx_lock(&feedback->signal_mutex);
+   uint64_t serial = ++feedback->last_serial;
+   simple_mtx_unlock(&feedback->signal_mutex);
+   return serial;
+}
+
+/* Record a signal now enqueued behind every submission committed so far. A
+ * submit that commits nothing still enqueues its signals behind the previous
+ * submission, which is what the unchanged serial says.
+ *
+ * Such a submit also schedules no completion, and a completion is what prunes
+ * the list of a healthy queue, so a stream of signal-only submits would grow
+ * it, and the events it retains, without bound. Pruning here keeps it to the
+ * signals still outstanding. */
+static void
+kk_queue_record_signal(struct kk_queue_feedback *feedback,
+                       mtl_shared_event *event, uint64_t value)
+{
+   simple_mtx_lock(&feedback->signal_mutex);
+   kk_queue_signals_prune_locked(feedback);
+   struct kk_queue_signal *record =
+      util_dynarray_grow(&feedback->signals, struct kk_queue_signal, 1);
+   if (record) {
+      *record = (struct kk_queue_signal){
+         .event = mtl_retain(event),
+         .value = value,
+         .serial = feedback->last_serial,
+      };
+   }
+   simple_mtx_unlock(&feedback->signal_mutex);
+}
+
+/* Once every submission has reported there is nothing left to deliver a
+ * signal, whichever submission was carrying it, so anything still short of
+ * its value was discarded. This is what resolves the casualties a failure
+ * does not name, and it resolves them as the failure is reported rather than
+ * leaving a waiter to time them out: a queue that has gone quiet reports
+ * nothing further to act on.
+ *
+ * A signal is enqueued after the submissions it follows, and Metal can report
+ * one of those before the commit call even returns, so the report that empties
+ * the queue may run before the record it would have resolved exists. Both
+ * sides therefore check, and whichever happens second does the work. */
+static void
+kk_queue_resolve_if_drained(struct kk_queue_feedback *feedback)
+{
+   simple_mtx_lock(&feedback->signal_mutex);
+   bool drained = feedback->failures > 0u &&
+                  feedback->reported == feedback->last_serial;
+   simple_mtx_unlock(&feedback->signal_mutex);
+
+   if (drained)
+      kk_queue_signals_make_good(feedback, UINT64_MAX);
+}
+
+static struct kk_queue_submission *
+kk_queue_submission_new(struct kk_queue_feedback *feedback, uint64_t serial)
+{
+   struct kk_queue_submission *submission = malloc(sizeof(*submission));
+   if (!submission)
+      return NULL;
+
+   submission->feedback = kk_queue_feedback_ref(feedback);
+   submission->serial = serial;
+   return submission;
+}
+
 static void
 commit_callback(struct mtl_feedback_data *data)
 {
-   struct kk_queue_feedback *feedback = data->user_data;
+   struct kk_queue_submission *submission = data->user_data;
+   struct kk_queue_feedback *feedback = submission->feedback;
+
+   /* A serial is reserved immediately before its commit, so a submission the
+    * queue is still holding always keeps this below last_serial. */
+   simple_mtx_lock(&feedback->signal_mutex);
+   ++feedback->reported;
+   simple_mtx_unlock(&feedback->signal_mutex);
+
    if (data->error != MTL_COMMAND_QUEUE_ERROR_NONE) {
       char report[KK_QUEUE_ERROR_REPORT_SIZE];
       kk_queue_error_describe(report, sizeof(report), data);
       fprintf(stderr, "KosmicKrisp %s\n", report);
 
+      /* A lost queue owes every signal it still holds, because it runs
+       * nothing further. A survivable failure owes only the signals ordered
+       * behind the submission it names. */
+      bool lost = kk_queue_error_is_device_lost(data);
+      simple_mtx_lock(&feedback->signal_mutex);
+      ++feedback->failures;
+      simple_mtx_unlock(&feedback->signal_mutex);
+      unsigned made_good = kk_queue_signals_make_good(
+         feedback, lost ? UINT64_MAX : submission->serial);
+      if (made_good)
+         fprintf(stderr,
+                 "KosmicKrisp completed %u timeline signal%s the failed "
+                 "submission owed, so its waiters do not block forever\n",
+                 made_good, made_good == 1u ? "" : "s");
+
       /* Device teardown clears this pointer under the same lock. Never carry
        * a Vulkan pointer outside the lock into an asynchronous callback. */
-      if (kk_queue_error_is_device_lost(data)) {
+      if (lost) {
          simple_mtx_lock(&feedback->mutex);
          if (feedback->device)
             vk_device_set_lost(&feedback->device->vk, "Metal %s", report);
          simple_mtx_unlock(&feedback->mutex);
       }
+   } else if (p_atomic_read(&feedback->failures) > 0u) {
+      /* This queue processes what it is given in order, so a completion also
+       * proves it went past every signal enqueued before this submission.
+       * One of those still short of its value was discarded rather than run,
+       * which is how the work killed behind a reported failure gets resolved
+       * without a report of its own. */
+      kk_queue_signals_make_good(feedback, submission->serial - 1u);
+   } else {
+      /* A completion proves every signal ordered ahead of it has run. */
+      kk_queue_signals_retire(feedback);
    }
 
+   kk_queue_resolve_if_drained(feedback);
+
    if (feedback->submit_timing) {
       /* These host-second timestamps cover the entire committed Metal batch.
        * The immutable identifier remains usable after Vulkan device teardown. */
@@ -58,6 +299,7 @@ commit_callback(struct mtl_feedback_data *data)
               (void *)feedback->device_id, data->gpu_start, data->gpu_end,
               (unsigned)data->error);
    }
+   free(submission);
    kk_queue_feedback_unref(feedback);
 }
 
@@ -190,12 +432,26 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
             return vk_queue_set_lost(&queue->vk,
                                      "Failed to allocate Metal commit options");
 
+         /* One queue submits from one thread and nothing else reserves a
+          * serial, so this submission's number is still the one Metal is
+          * about to receive. A failure reported against it then names
+          * exactly the signals ordered behind it. */
+         struct kk_queue_submission *submission = kk_queue_submission_new(
+            queue->feedback, kk_queue_reserve_serial(queue->feedback));
+         if (!submission) {
+            mtl_release(options);
+            return vk_queue_set_lost(&queue->vk,
+                                     "Failed to allocate Metal submission feedback");
+         }
+
          struct kk_completed_recording *recording = NULL;
          if (cmd_buffer->one_time_submit) {
             recording = kk_detach_completed_recording(cmd_buffer,
                                                       queue->mtl_handle);
             if (!recording) {
                mtl_release(options);
+               kk_queue_feedback_unref(submission->feedback);
+               free(submission);
                return vk_queue_set_lost(&queue->vk,
                                         "Failed to allocate Metal completion storage");
             }
@@ -203,8 +459,7 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
                options, kk_completed_recording_callback, recording);
          }
          mtl_commit_options_add_feedback_handler(
-            options, queue->feedback_callback,
-            kk_queue_feedback_ref(queue->feedback));
+            options, queue->feedback_callback, submission);
          mtl_command_queue_commit(queue->mtl_handle, cmds, count, options);
          mtl_release(options);
          if (recording)
@@ -223,6 +478,12 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
       struct vk_sync_signal *signal = &submit->signals[i];
       struct kk_sync_timeline *sync =
          container_of(signal->sync, struct kk_sync_timeline, base);
+      /* Metal owes this value once it has the signal, and drops what it owes
+       * behind a submission it kills, so the queue keeps the debt until the
+       * event reaches it. The record takes its own reference to the event
+       * before the enqueue, for the reason below. */
+      kk_queue_record_signal(queue->feedback, sync->mtl_handle,
+                             signal->signal_value);
       /* Later waits on this value are pending and need no CPU gating: any
        * native work they order behind it comes from a later submission to
        * this device's one queue, which runs only after this one has enqueued
@@ -235,6 +496,11 @@ kk_queue_submit(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
                        signal->signal_value);
    }
 
+   /* The records for this submit exist only now, so a report that emptied the
+    * queue while it was being built could not have resolved them. */
+   if (submit->signal_count)
+      kk_queue_resolve_if_drained(queue->feedback);
+
    return VK_SUCCESS;
 }
 
@@ -278,6 +544,8 @@ kk_queue_init(struct kk_device *dev, struct kk_queue *queue,
    }
    queue->feedback->refcount = 1;
    simple_mtx_init(&queue->feedback->mutex, mtx_plain);
+   simple_mtx_init(&queue->feedback->signal_mutex, mtx_plain);
+   util_dynarray_init(&queue->feedback->signals, NULL);
    queue->feedback->device = dev;
    queue->feedback->device_id = (uintptr_t)dev;
    queue->feedback->submit_timing = KK_DEBUG(SUBMIT_TIMING);
diff --git a/src/kosmickrisp/vulkan/kk_queue.h b/src/kosmickrisp/vulkan/kk_queue.h
index f35020cb5adbcbbe7d92e0a9b95963824629eabb..ae0a65d8b2223d23eaaf1be9c6c18b0459f004a7 100644
--- a/src/kosmickrisp/vulkan/kk_queue.h
+++ b/src/kosmickrisp/vulkan/kk_queue.h
@@ -14,6 +14,17 @@
 
 #include "vk_queue.h"
 #include "util/simple_mtx.h"
+#include "util/u_dynarray.h"
+
+/* A timeline signal this queue handed to Metal, and the submission it is
+ * ordered behind. The native event is referenced, not borrowed, and the
+ * reference is taken before the signal is enqueued: the vk_sync that carried
+ * the signal can be destroyed as soon as the signal is delivered. */
+struct kk_queue_signal {
+   mtl_shared_event *event;
+   uint64_t value;
+   uint64_t serial;
+};
 
 /* Feedback can run after Vulkan device teardown. Only access device while
  * holding mutex; device_id is an immutable identifier for independent logs. */
@@ -24,6 +35,28 @@ struct kk_queue_feedback {
    mtl_command_queue *queue;
    uintptr_t device_id;
    bool submit_timing;
+   /* Signals Metal has not made good yet, oldest first, and the serial of the
+    * most recent submission. Guarded by signal_mutex, which is never held
+    * across mutex. */
+   simple_mtx_t signal_mutex;
+   uint64_t last_serial;
+   /* How many submissions have reported. Metal reports every submission it is
+    * given exactly once, so reaching last_serial means the queue holds
+    * nothing it has not answered for. */
+   uint64_t reported;
+   struct util_dynarray signals;
+   /* How many failures Metal has reported against this queue. A queue that
+    * has never failed owes nothing it has not delivered, so the recovery
+    * below stays out of the way until one does. */
+   uint32_t failures;
+};
+
+/* Per-submission feedback payload. Metal reports a failure against one
+ * submission, so the report has to carry that submission's serial to know
+ * which enqueued signals the failure destroyed. */
+struct kk_queue_submission {
+   struct kk_queue_feedback *feedback;
+   uint64_t serial;
 };
 
 static inline struct kk_queue_feedback *
@@ -46,6 +79,13 @@ kk_queue_device(struct kk_queue *queue)
    return (struct kk_device *)queue->vk.base.device;
 }
 
+/* Complete every signal this queue handed to Metal for this event and has not
+ * seen delivered, and answer with the value the event now holds, or zero when
+ * the queue owed nothing. Only a queue that has already failed owes anything:
+ * see kk_queue.c for why a signal can go missing without a report naming it. */
+uint64_t kk_queue_complete_owed_signals(struct kk_queue *queue,
+                                        mtl_shared_event *event);
+
 VkResult kk_queue_init(struct kk_device *dev, struct kk_queue *queue,
                        const VkDeviceQueueCreateInfo *pCreateInfo,
                        uint32_t index_in_family);
diff --git a/src/kosmickrisp/vulkan/kk_sync.c b/src/kosmickrisp/vulkan/kk_sync.c
index e0377497850cb629abde25478d077d1101528b33..2f8f5f8c79d08865c8c32ade36d906d428900614 100644
--- a/src/kosmickrisp/vulkan/kk_sync.c
+++ b/src/kosmickrisp/vulkan/kk_sync.c
@@ -11,8 +11,12 @@
 
 #include "vk_util.h"
 
+#include "util/os_time.h"
 #include "util/u_atomic.h"
 
+#include <inttypes.h>
