+++ b/src/kosmickrisp/vulkan/tests/texel_buffer_bounds_shaders/bounds.comp
@@ -0,0 +1,24 @@
+#version 450
+
+/* Read one texel through a storage and a uniform texel buffer view of the same
+ * range, then write it through the storage view. */
+layout(local_size_x = 1) in;
+
+layout(set = 0, binding = 0, r32ui) uniform uimageBuffer storage_view;
+layout(set = 0, binding = 1) uniform usamplerBuffer uniform_view;
+layout(set = 0, binding = 2, std430) buffer Result {
+   uint loaded;
+   uint fetched;
+} result;
+
+layout(push_constant) uniform Push {
+   int coord;
+   uint value;
+} push;
+
+void main()
+{
+   result.loaded = imageLoad(storage_view, push.coord).x;
+   result.fetched = texelFetch(uniform_view, push.coord).x;
+   imageStore(storage_view, push.coord, uvec4(push.value));
+}
