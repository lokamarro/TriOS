--- a/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
+++ b/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
@@ -384,6 +384,29 @@ load_resource_deref_desc(nir_builder *b, unsigned num_components,
                           offset_B, ctx);
 }
 
+/* A texel buffer's Metal texture starts up to one texture-buffer alignment
+ * before its view, so the view's texel i is the texture's texel
+ * i + texel_offset.  Metal bounds-checks against that texture, not the view,
+ * so a coordinate in [-texel_offset, -1] would reach the texels in front of
+ * the view.  Check the coordinate against the view before the shift instead:
+ * the unsigned compare also rejects every negative coordinate, and a rejected
+ * one becomes ~0, which lies outside any texture, so Metal reads zero and
+ * drops the write as robustBufferAccess2 requires.
+ */
+static nir_def *
+shift_texel_buffer_coord(nir_builder *b, nir_def *coord, nir_def *offset,
+                         nir_deref_instr *deref,
+                         const struct lower_descriptors_ctx *ctx)
+{
+   nir_def *element_count = load_resource_deref_desc(
+      b, 1, 32, deref,
+      offsetof(struct kk_texel_buffer_descriptor, element_count), ctx);
+   nir_def *x = nir_channel(b, coord, 0);
+   nir_def *shifted = nir_bcsel(b, nir_ult(b, x, element_count),
+                                nir_iadd(b, x, offset), nir_imm_int(b, -1));
+   return nir_vector_insert_imm(b, coord, shifted, 0);
+}
+
 static bool
 lower_image_intrin(nir_builder *b, nir_intrinsic_instr *intr,
                    const struct lower_descriptors_ctx *ctx)
@@ -391,9 +414,40 @@ lower_image_intrin(nir_builder *b, nir_intrinsic_instr *intr,
    b->cursor = nir_before_instr(&intr->instr);
    nir_deref_instr *deref = nir_src_as_deref(intr->src[0]);
 
+   if (nir_intrinsic_image_dim(intr) == GLSL_SAMPLER_DIM_BUF) {
+      if (intr->intrinsic == nir_intrinsic_image_deref_size) {
+         nir_def *element_count = load_resource_deref_desc(
+            b, 1, 32, deref,
+            offsetof(struct kk_texel_buffer_descriptor, element_count), ctx);
+         nir_def_rewrite_uses(&intr->def, element_count);
+         return true;
+      }
+
+      switch (intr->intrinsic) {
+      case nir_intrinsic_image_deref_load:
+      case nir_intrinsic_image_deref_sparse_load:
+      case nir_intrinsic_image_deref_store:
+      case nir_intrinsic_image_deref_atomic:
+      case nir_intrinsic_image_deref_atomic_swap: {
+         nir_def *texel_offset = load_resource_deref_desc(
+            b, 1, 32, deref,
+            offsetof(struct kk_texel_buffer_descriptor, texel_offset), ctx);
+         nir_src_rewrite(&intr->src[1],
+                         shift_texel_buffer_coord(b, intr->src[1].ssa,
+                                                  texel_offset, deref, ctx));
+         break;
+      }
+      default:
+         break;
+      }
+   }
+
    /* Reads and queries use the texture descriptor; writes and atomics PBE. */
-   unsigned offs =
-      offsetof(struct kk_storage_image_descriptor, image_gpu_resource_id);
+   unsigned offs = nir_intrinsic_image_dim(intr) == GLSL_SAMPLER_DIM_BUF
+                      ? offsetof(struct kk_texel_buffer_descriptor,
+                                 image_gpu_resource_id)
+                      : offsetof(struct kk_storage_image_descriptor,
+                                 image_gpu_resource_id);
 
    nir_def *resource_addr = load_resource_addr(b, 1, 64, deref, offs, ctx);
 
@@ -485,6 +539,30 @@ lower_tex(nir_builder *b, nir_tex_instr *tex,
    const uint64_t plane_offset_B =
       plane * sizeof(struct kk_sampled_image_descriptor);
 
+   nir_deref_instr *texture_deref =
+      nir_src_as_deref(nir_src_for_ssa(texture));
+   if (tex->sampler_dim == GLSL_SAMPLER_DIM_BUF) {
+      assert(plane == 0);
+      if (tex->op == nir_texop_txs) {
+         nir_def *element_count = load_resource_deref_desc(
+            b, 1, 32, texture_deref,
+            offsetof(struct kk_texel_buffer_descriptor, element_count), ctx);
+         nir_def_replace(&tex->def, element_count);
+         return true;
+      }
+
+      const int coord_src_idx =
+         nir_tex_instr_src_index(tex, nir_tex_src_coord);
+      assert(coord_src_idx >= 0);
+      nir_def *texel_offset = load_resource_deref_desc(
+         b, 1, 32, texture_deref,
+         offsetof(struct kk_texel_buffer_descriptor, texel_offset), ctx);
+      nir_src_rewrite(&tex->src[coord_src_idx].src,
+                      shift_texel_buffer_coord(
+                         b, tex->src[coord_src_idx].src.ssa, texel_offset,
+                         texture_deref, ctx));
+   }
+
    /* LOD bias is passed in the descriptor set, rather than embedded into
     * the sampler descriptor. There's no spot in the hardware descriptor,
     * plus this saves on precious sampler heap spots.
