diff --git a/src/kosmickrisp/vulkan/tests/test_texel_buffer_bounds.c b/src/kosmickrisp/vulkan/tests/test_texel_buffer_bounds.c
new file mode 100644
index 0000000000000000000000000000000000000000..d72b609cb40e747de87163e708bd5baa32b84e03
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_texel_buffer_bounds.c
@@ -0,0 +1,393 @@
+/* SPDX-License-Identifier: MIT */
+
+/* A texel buffer view may start at any texel, but a Metal texture buffer has
+ * to start at Metal's own alignment, so the driver describes a texture that
+ * starts that far before the view and shifts every coordinate forward.  Metal
+ * bounds-checks against its texture, not the view: without a check against
+ * the view, a coordinate just below zero lands on the texels in front of the
+ * view and reads or writes them, where robustBufferAccess2 promises a zero
+ * read and a dropped write.  A coordinate one past the view's end must behave
+ * the same, and one inside it must reach its texel. */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan_core.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern PFN_vkVoidFunction vkGetInstanceProcAddr(VkInstance, const char *);
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x); abort(); } } while (0)
+#define LOAD_I(name) PFN_##name name = (PFN_##name)vkGetInstanceProcAddr(instance, #name); CHECK(name)
+#define LOAD_D(name) PFN_##name name = (PFN_##name)vkGetDeviceProcAddr(device, #name); CHECK(name)
+
+static const uint32_t bounds_comp[] =
+#include "texel_buffer_bounds_shaders/bounds.comp.h"
+   ;
+
+#define WORDS          64u
+#define VIEW_FIRST     1u
+#define VIEW_ELEMENTS  16u
+#define STORED         0xdeadbeefu
+
+static uint32_t
+find_memory_type(const VkPhysicalDeviceMemoryProperties *properties,
+                 uint32_t type_bits, VkMemoryPropertyFlags flags)
+{
+   for (uint32_t i = 0; i < properties->memoryTypeCount; i++) {
+      if ((type_bits & (1u << i)) &&
+          (properties->memoryTypes[i].propertyFlags & flags) == flags)
+         return i;
+   }
+   CHECK(!"no memory type");
+   return 0;
+}
+
+static uint32_t
+original_word(uint32_t index)
+{
+   return 0xa0000000u | index;
+}
+
+int
+main(void)
+{
+   VkInstance instance = VK_NULL_HANDLE;
+   LOAD_I(vkCreateInstance);
+   VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+                            .apiVersion = VK_API_VERSION_1_3};
+   VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   CHECK(vkCreateInstance(&instance_info, NULL, &instance) == VK_SUCCESS);
+   LOAD_I(vkDestroyInstance);
+   LOAD_I(vkEnumeratePhysicalDevices);
+   LOAD_I(vkGetPhysicalDeviceMemoryProperties);
+   LOAD_I(vkGetPhysicalDeviceProperties2);
+   LOAD_I(vkCreateDevice);
+   LOAD_I(vkGetDeviceProcAddr);
+   uint32_t count = 1;
+   VkPhysicalDevice physical = VK_NULL_HANDLE;
+   VkResult enumerated =
+      vkEnumeratePhysicalDevices(instance, &count, &physical);
+   CHECK((enumerated == VK_SUCCESS || enumerated == VK_INCOMPLETE) && count);
+
+   /* The view starts one texel into the buffer, which only single-texel
+    * alignment allows, and which Metal's texture-buffer alignment does not. */
+   VkPhysicalDeviceTexelBufferAlignmentProperties alignment = {
+      .sType =
+         VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TEXEL_BUFFER_ALIGNMENT_PROPERTIES,
+   };
+   VkPhysicalDeviceProperties2 properties = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+      .pNext = &alignment,
+   };
+   vkGetPhysicalDeviceProperties2(physical, &properties);
+   CHECK(alignment.storageTexelBufferOffsetSingleTexelAlignment);
+   CHECK(alignment.uniformTexelBufferOffsetSingleTexelAlignment);
+
+   float priority = 1.0f;
+   VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   VkPhysicalDeviceRobustness2FeaturesEXT robustness2 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ROBUSTNESS_2_FEATURES_EXT,
+      .robustBufferAccess2 = VK_TRUE,
+   };
+   VkPhysicalDeviceFeatures features = {.robustBufferAccess = VK_TRUE};
+   const char *extensions[] = {VK_EXT_ROBUSTNESS_2_EXTENSION_NAME};
+   VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .pNext = &robustness2,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+      .enabledExtensionCount = 1,
+      .ppEnabledExtensionNames = extensions,
+      .pEnabledFeatures = &features,
+   };
+   VkDevice device = VK_NULL_HANDLE;
+   CHECK(vkCreateDevice(physical, &device_info, NULL, &device) == VK_SUCCESS);
+   LOAD_D(vkDestroyDevice);
+   LOAD_D(vkGetDeviceQueue);
+   LOAD_D(vkCreateBuffer);
+   LOAD_D(vkDestroyBuffer);
+   LOAD_D(vkGetBufferMemoryRequirements);
+   LOAD_D(vkAllocateMemory);
+   LOAD_D(vkFreeMemory);
+   LOAD_D(vkBindBufferMemory);
+   LOAD_D(vkMapMemory);
+   LOAD_D(vkCreateBufferView);
+   LOAD_D(vkDestroyBufferView);
+   LOAD_D(vkCreateShaderModule);
+   LOAD_D(vkDestroyShaderModule);
+   LOAD_D(vkCreateDescriptorSetLayout);
+   LOAD_D(vkDestroyDescriptorSetLayout);
+   LOAD_D(vkCreatePipelineLayout);
+   LOAD_D(vkDestroyPipelineLayout);
+   LOAD_D(vkCreateComputePipelines);
+   LOAD_D(vkDestroyPipeline);
+   LOAD_D(vkCreateDescriptorPool);
+   LOAD_D(vkDestroyDescriptorPool);
+   LOAD_D(vkAllocateDescriptorSets);
+   LOAD_D(vkUpdateDescriptorSets);
+   LOAD_D(vkCreateCommandPool);
+   LOAD_D(vkDestroyCommandPool);
+   LOAD_D(vkAllocateCommandBuffers);
+   LOAD_D(vkBeginCommandBuffer);
+   LOAD_D(vkEndCommandBuffer);
+   LOAD_D(vkCmdBindPipeline);
+   LOAD_D(vkCmdBindDescriptorSets);
+   LOAD_D(vkCmdPushConstants);
+   LOAD_D(vkCmdDispatch);
+   LOAD_D(vkQueueSubmit);
+   LOAD_D(vkQueueWaitIdle);
+   VkQueue queue = VK_NULL_HANDLE;
+   vkGetDeviceQueue(device, 0, 0, &queue);
+   VkPhysicalDeviceMemoryProperties memory_properties;
+   vkGetPhysicalDeviceMemoryProperties(physical, &memory_properties);
+
+   /* One host-visible allocation holds the texels at its start and the
+    * shader's results after them. */
+   VkBufferCreateInfo texel_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = WORDS * sizeof(uint32_t),
+      .usage = VK_BUFFER_USAGE_STORAGE_TEXEL_BUFFER_BIT |
+               VK_BUFFER_USAGE_UNIFORM_TEXEL_BUFFER_BIT,
+   };
+   VkBuffer texels = VK_NULL_HANDLE;
+   CHECK(vkCreateBuffer(device, &texel_info, NULL, &texels) == VK_SUCCESS);
+   VkBufferCreateInfo result_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = 2 * sizeof(uint32_t),
+      .usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+   };
+   VkBuffer results = VK_NULL_HANDLE;
+   CHECK(vkCreateBuffer(device, &result_info, NULL, &results) == VK_SUCCESS);
+   VkMemoryRequirements texel_requirements, result_requirements;
+   vkGetBufferMemoryRequirements(device, texels, &texel_requirements);
+   vkGetBufferMemoryRequirements(device, results, &result_requirements);
+   const VkDeviceSize result_offset =
+      (texel_requirements.size + result_requirements.alignment - 1) &
+      ~(result_requirements.alignment - 1);
+   VkMemoryAllocateInfo memory_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = result_offset + result_requirements.size,
+      .memoryTypeIndex = find_memory_type(
+         &memory_properties,
+         texel_requirements.memoryTypeBits & result_requirements.memoryTypeBits,
+         VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+            VK_MEMORY_PROPERTY_HOST_COHERENT_BIT),
+   };
+   VkDeviceMemory memory = VK_NULL_HANDLE;
+   CHECK(vkAllocateMemory(device, &memory_info, NULL, &memory) == VK_SUCCESS);
+   CHECK(vkBindBufferMemory(device, texels, memory, 0) == VK_SUCCESS);
+   CHECK(vkBindBufferMemory(device, results, memory, result_offset) ==
+         VK_SUCCESS);
+   void *mapped = NULL;
+   CHECK(vkMapMemory(device, memory, 0, VK_WHOLE_SIZE, 0, &mapped) ==
+         VK_SUCCESS);
+   volatile uint32_t *words = mapped;
+   volatile uint32_t *result = (volatile uint32_t *)((char *)mapped +
+                                                     result_offset);
+
+   VkBufferView views[2];
+   for (unsigned i = 0; i < 2; i++) {
+      VkBufferViewCreateInfo view_info = {
+         .sType = VK_STRUCTURE_TYPE_BUFFER_VIEW_CREATE_INFO,
+         .buffer = texels,
+         .format = VK_FORMAT_R32_UINT,
+         .offset = VIEW_FIRST * sizeof(uint32_t),
+         .range = VIEW_ELEMENTS * sizeof(uint32_t),
+      };
+      CHECK(vkCreateBufferView(device, &view_info, NULL, &views[i]) ==
+            VK_SUCCESS);
+   }
+
+   VkShaderModuleCreateInfo module_info = {
+      .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+      .codeSize = sizeof(bounds_comp),
+      .pCode = bounds_comp,
+   };
+   VkShaderModule module = VK_NULL_HANDLE;
+   CHECK(vkCreateShaderModule(device, &module_info, NULL, &module) ==
+         VK_SUCCESS);
+   const VkDescriptorSetLayoutBinding bindings[] = {
+      {0, VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER, 1,
+       VK_SHADER_STAGE_COMPUTE_BIT, NULL},
+      {1, VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER, 1,
+       VK_SHADER_STAGE_COMPUTE_BIT, NULL},
+      {2, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT,
+       NULL},
+   };
+   VkDescriptorSetLayoutCreateInfo set_layout_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+      .bindingCount = 3,
+      .pBindings = bindings,
+   };
+   VkDescriptorSetLayout set_layout = VK_NULL_HANDLE;
+   CHECK(vkCreateDescriptorSetLayout(device, &set_layout_info, NULL,
+                                     &set_layout) == VK_SUCCESS);
+   VkPushConstantRange push_range = {VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                     2 * sizeof(uint32_t)};
+   VkPipelineLayoutCreateInfo layout_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+      .setLayoutCount = 1,
+      .pSetLayouts = &set_layout,
+      .pushConstantRangeCount = 1,
+      .pPushConstantRanges = &push_range,
+   };
+   VkPipelineLayout pipeline_layout = VK_NULL_HANDLE;
+   CHECK(vkCreatePipelineLayout(device, &layout_info, NULL,
+                                &pipeline_layout) == VK_SUCCESS);
+   VkComputePipelineCreateInfo pipeline_info = {
+      .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+      .stage =
+         {
+            .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+            .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+            .module = module,
+            .pName = "main",
+         },
+      .layout = pipeline_layout,
+   };
+   VkPipeline pipeline = VK_NULL_HANDLE;
+   CHECK(vkCreateComputePipelines(device, VK_NULL_HANDLE, 1, &pipeline_info,
+                                  NULL, &pipeline) == VK_SUCCESS);
+
+   const VkDescriptorPoolSize pool_sizes[] = {
+      {VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER, 1},
+      {VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER, 1},
+      {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1},
+   };
+   VkDescriptorPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+      .maxSets = 1,
+      .poolSizeCount = 3,
+      .pPoolSizes = pool_sizes,
+   };
+   VkDescriptorPool descriptor_pool = VK_NULL_HANDLE;
+   CHECK(vkCreateDescriptorPool(device, &pool_info, NULL, &descriptor_pool) ==
+         VK_SUCCESS);
+   VkDescriptorSetAllocateInfo set_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+      .descriptorPool = descriptor_pool,
+      .descriptorSetCount = 1,
+      .pSetLayouts = &set_layout,
+   };
+   VkDescriptorSet set = VK_NULL_HANDLE;
+   CHECK(vkAllocateDescriptorSets(device, &set_info, &set) == VK_SUCCESS);
+   VkDescriptorBufferInfo result_desc = {results, 0, VK_WHOLE_SIZE};
+   const VkWriteDescriptorSet writes[] = {
+      {
+         .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+         .dstSet = set,
+         .dstBinding = 0,
+         .descriptorCount = 1,
+         .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER,
+         .pTexelBufferView = &views[0],
+      },
+      {
+         .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+         .dstSet = set,
+         .dstBinding = 1,
+         .descriptorCount = 1,
+         .descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER,
+         .pTexelBufferView = &views[1],
+      },
+      {
+         .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+         .dstSet = set,
+         .dstBinding = 2,
+         .descriptorCount = 1,
+         .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+         .pBufferInfo = &result_desc,
+      },
+   };
+   vkUpdateDescriptorSets(device, 3, writes, 0, NULL);
+
+   VkCommandPoolCreateInfo command_pool_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+      .queueFamilyIndex = 0,
+   };
+   VkCommandPool command_pool = VK_NULL_HANDLE;
+   CHECK(vkCreateCommandPool(device, &command_pool_info, NULL,
+                             &command_pool) == VK_SUCCESS);
+   VkCommandBufferAllocateInfo command_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = command_pool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   VkCommandBuffer command = VK_NULL_HANDLE;
+   CHECK(vkAllocateCommandBuffers(device, &command_info, &command) ==
+         VK_SUCCESS);
+
+   /* Just in front of the view, just past its end, and its first texel. */
+   const int32_t coords[] = {-1, (int32_t)VIEW_ELEMENTS, 0};
+   for (unsigned c = 0; c < 3; c++) {
+      for (uint32_t i = 0; i < WORDS; i++)
+         words[i] = original_word(i);
+      result[0] = result[1] = 0x55555555u;
+
+      VkCommandBufferBeginInfo begin = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+         .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+      };
+      CHECK(vkBeginCommandBuffer(command, &begin) == VK_SUCCESS);
+      vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+      vkCmdBindDescriptorSets(command, VK_PIPELINE_BIND_POINT_COMPUTE,
+                              pipeline_layout, 0, 1, &set, 0, NULL);
+      const uint32_t push[2] = {(uint32_t)coords[c], STORED};
+      vkCmdPushConstants(command, pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT,
+                         0, sizeof(push), push);
+      vkCmdDispatch(command, 1, 1, 1);
+      CHECK(vkEndCommandBuffer(command) == VK_SUCCESS);
+      VkSubmitInfo submit = {
+         .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+         .commandBufferCount = 1,
+         .pCommandBuffers = &command,
+      };
+      CHECK(vkQueueSubmit(queue, 1, &submit, VK_NULL_HANDLE) == VK_SUCCESS);
+      CHECK(vkQueueWaitIdle(queue) == VK_SUCCESS);
+
+      unsigned changed = 0;
+      for (uint32_t i = 0; i < WORDS; i++)
+         changed += words[i] != original_word(i);
+      fprintf(stderr,
+              "coord %d: loaded 0x%08x, fetched 0x%08x, %u word(s) changed\n",
+              coords[c], result[0], result[1], changed);
+      if (coords[c] < 0 || coords[c] >= (int32_t)VIEW_ELEMENTS) {
+         CHECK(result[0] == 0u);
+         CHECK(result[1] == 0u);
+         CHECK(changed == 0u);
+      } else {
+         const uint32_t word = VIEW_FIRST + (uint32_t)coords[c];
+         CHECK(result[0] == original_word(word));
+         CHECK(result[1] == original_word(word));
+         CHECK(words[word] == STORED);
+         CHECK(changed == 1u);
+      }
+   }
+
+   vkDestroyCommandPool(device, command_pool, NULL);
+   vkDestroyDescriptorPool(device, descriptor_pool, NULL);
+   vkDestroyPipeline(device, pipeline, NULL);
+   vkDestroyPipelineLayout(device, pipeline_layout, NULL);
+   vkDestroyDescriptorSetLayout(device, set_layout, NULL);
+   vkDestroyShaderModule(device, module, NULL);
+   for (unsigned i = 0; i < 2; i++)
+      vkDestroyBufferView(device, views[i], NULL);
+   vkDestroyBuffer(device, results, NULL);
+   vkDestroyBuffer(device, texels, NULL);
+   vkFreeMemory(device, memory, NULL);
+   vkDestroyDevice(device, NULL);
+   vkDestroyInstance(instance, NULL);
+   printf("a texel buffer access outside its view reads zero and writes "
+          "nothing\n");
+   return 0;
+}
