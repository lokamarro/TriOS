index 0000000000000000000000000000000000000000..baecf0a7d67c687ea881f1ef75861917f58cf3e3
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/texel_buffer_bounds_shaders/generate.sh
@@ -0,0 +1,5 @@
+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+cd -- "$(dirname -- "$0")"
+glslc -O --target-env=vulkan1.3 -mfmt=c bounds.comp -o bounds.comp.h
