--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.h
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.h
@@ -81,6 +81,12 @@ struct kk_per_draw_data {
    /* Address of tessellation param buffer if tessellation used, else 0 */
    uint64_t tess_params;
 
+   /* Transform-feedback geometry state consumed entirely on the GPU. */
+   uint64_t geometry_params;
+   uint64_t transform_feedback_query_sink;
+   uint32_t provoking_last;
+   uint32_t rasterization_stream;
+
    uint64_t base_vertex_addr;
    uint64_t base_instance_addr;
 
@@ -189,6 +195,20 @@ struct kk_graphics_state {
       enum mesa_prim prim;
    } tess;
 
+   /* Transform feedback is implemented with the shared poly GPU path.  The
+    * application vertex shader is only moved to compute for pipelines that
+    * actually contain XFB decorations; ordinary draws keep the native Metal
+    * vertex path. */
+   struct {
+      struct kk_addr_range buffers[POLY_MAX_SO_BUFFERS];
+      uint64_t offsets;
+      uint64_t query[POLY_MAX_VERTEX_STREAMS];
+      uint64_t sink;
+      uint32_t raster_vertex_count;
+      uint32_t raster_instance_count;
+      bool enabled;
+   } xfb;
+
    /* Needed by vk_command_buffer::dynamic_graphics_state */
    struct vk_vertex_input_state _dynamic_vi;
    struct vk_sample_locations_state _dynamic_sl;
diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index 783c5e30d13860a6e518f89b9b54d7c6be0a7eb1..8398a108ea820b45b02345f33c733b527744502f 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -1107,6 +1107,85 @@ kk_upload_vertex_params(struct kk_cmd_buffer *cmd,
    return kk_pool_upload(cmd, &params, sizeof(params), 8).gpu;
 }
 
+static uint64_t
+kk_transform_feedback_sink(struct kk_cmd_buffer *cmd)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   if (!gfx->xfb.sink) {
+      struct kk_ptr sink = kk_pool_alloc(cmd, 64, 8);
+      if (sink.gpu) {
+         memset(sink.cpu, 0, 64);
+         gfx->xfb.sink = sink.gpu;
+      }
+   }
+
+   return gfx->xfb.sink;
+}
+
+static uint64_t
+kk_transform_feedback_offsets(struct kk_cmd_buffer *cmd)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   if (!gfx->xfb.offsets) {
+      struct kk_ptr offsets =
+         kk_pool_alloc(cmd, POLY_MAX_SO_BUFFERS * sizeof(uint32_t), 4);
+      if (offsets.gpu) {
+         memset(offsets.cpu, 0,
+                POLY_MAX_SO_BUFFERS * sizeof(uint32_t));
+         gfx->xfb.offsets = offsets.gpu;
+      }
+   }
+
+   return gfx->xfb.offsets;
+}
+
+static uint64_t
+kk_upload_transform_feedback_params(struct kk_cmd_buffer *cmd,
+                                    const struct kk_draw_data *draw,
+                                    enum mesa_prim prim)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   const struct poly_gs_info *gsi = &vs->info.vs.transform_feedback;
+   const uint32_t wg_size[3] = {64, 1, 1};
+   uint64_t sink = kk_transform_feedback_sink(cmd);
+   uint64_t offsets = kk_transform_feedback_offsets(cmd);
+
+   if (!sink || !offsets)
+      return 0;
+
+   struct poly_geometry_params params;
+   poly_geometry_params_init(&params, prim, wg_size);
+
+   for (uint32_t i = 0; i < POLY_MAX_SO_BUFFERS; ++i) {
+      params.xfb_offs_ptrs[i] = offsets + i * sizeof(uint32_t);
+      if (gfx->xfb.enabled) {
+         params.xfb_base_original[i] = gfx->xfb.buffers[i].addr;
+         params.xfb_size[i] = MIN2(gfx->xfb.buffers[i].range, UINT32_MAX);
+      }
+   }
+
+   for (uint32_t i = 0; i < POLY_MAX_VERTEX_STREAMS; ++i) {
+      uint64_t query = gfx->xfb.query[i];
+      params.xfb_prims_generated_counter[i] = query ? query : sink;
+      params.prims_generated_counter[i] =
+         query ? query + sizeof(uint64_t) : sink;
+      params.xfb_overflow[i] = sink + 16;
+   }
+   params.xfb_any_overflow = sink + 20;
+
+   if (!kk_grid_is_indirect(draw->grid)) {
+      poly_geometry_params_set_draw(&params, prim, gsi->shape,
+                                    gsi->max_indices, draw->grid.size.x,
+                                    draw->grid.size.y);
+      gfx->xfb.raster_vertex_count = params.draw.vertex_count;
+      gfx->xfb.raster_instance_count = params.draw.instance_count;
+   }
+
+   gfx->per_draw_data.transform_feedback_query_sink = sink + 32;
+   return kk_pool_upload(cmd, &params, sizeof(params), 8).gpu;
+}
+
 static void
 kk_upload_tess_params(struct kk_cmd_buffer *cmd, struct poly_tess_params *out,
                       const struct kk_draw_data *draw)
@@ -1531,7 +1610,8 @@ build_per_draw_upload_mask(struct kk_cmd_buffer *cmd)
    struct kk_shader *vertex = cmd->state.shaders[MESA_SHADER_VERTEX];
    if (vertex && (vertex->info.uses_per_draw_data ||
                   vertex->info.vs.polygon_point_emulation ||
-                  vertex->info.vs.rectangular_line_emulation)) {
+                  vertex->info.vs.rectangular_line_emulation ||
+                  vertex->info.vs.transform_feedback_emulation)) {
       mask |= BITFIELD_BIT(MESA_SHADER_VERTEX);
    }
 
@@ -1768,16 +1848,27 @@ kk_upload_per_draw_data(struct kk_cmd_buffer *cmd, uint32_t upload_mask,
    bool tess = upload_mask & BITFIELD_BIT(MESA_SHADER_TESS_EVAL);
    bool polygon_points = vs && vs->info.vs.polygon_point_emulation;
    bool rectangular_lines = vs && vs->info.vs.rectangular_line_emulation;
+   bool transform_feedback =
+      vs && vs->info.vs.transform_feedback_emulation;
 
    /* Prepare the software vertex stage used by tessellation and culled
     * polygon-point draws. */
-   if (tess || polygon_points || rectangular_lines) {
+   if (tess || polygon_points || rectangular_lines || transform_feedback) {
       gfx->per_draw_data.index_size = draw->index.el_size_B;
       gfx->per_draw_data.base_vertex_addr = upload_base_vertex(cmd, draw);
       gfx->per_draw_data.base_instance_addr = upload_base_instance(cmd, draw);
       gfx->per_draw_data.vertex_params = kk_upload_vertex_params(cmd, draw);
    }
 
+   if (transform_feedback) {
+      gfx->per_draw_data.geometry_params =
+         kk_upload_transform_feedback_params(cmd, draw, prim);
+      gfx->per_draw_data.provoking_last =
+         cmd->vk.dynamic_graphics_state.rs.provoking_vertex ==
+         VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT;
+      gfx->per_draw_data.rasterization_stream = 0;
+   }
+
    /* Prepare emulation data for tessellation. */
    if (tess) {
       struct kk_ptr tess_args =
@@ -2055,6 +2146,83 @@ kk_launch_rectangular_lines(struct kk_cmd_buffer *cmd,
    return draw;
 }
 
+static struct kk_draw_data
+kk_launch_transform_feedback(struct kk_cmd_buffer *cmd,
+                             struct kk_draw_data draw, enum mesa_prim prim)
+{
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   const struct poly_gs_info *gsi = &vs->info.vs.transform_feedback;
+   bool indirect = kk_grid_is_indirect(draw.grid);
+
+   assert(!poly_gs_indexed(gsi->shape) &&
+          "the pass-through XFB shader must use a non-indexed raster draw");
+
+   if (indirect) {
+      struct libkk_gs_setup_indirect_args args = {
+         .index_buffer = draw.index.gpu.addr,
+         .draw = draw.grid.addr,
+         .vp = gfx->per_draw_data.vertex_params,
+         .p = gfx->per_draw_data.geometry_params,
+         .heap = kk_heap(cmd),
+         .vertex_outputs = vs->info.vs.outputs_written,
+         .index_size_B = draw.index.el_size_B,
+         .index_buffer_range_el =
+            draw.index.el_size_B
+               ? draw.index.gpu.range / draw.index.el_size_B
+               : 0,
+         .prim = prim,
+         .max_indices = gsi->max_indices,
+         .shape = gsi->shape,
+      };
+      libkk_gs_setup_indirect_struct(cmd, kk_grid_1d(1), true, args);
+   }
+
+   mtl_compute_encoder *enc = cs_get_compute(cmd, true);
+   mtl_compute_pipeline_state *vs_pipeline = vs->pipeline.gfx.pre_render[0];
+   struct mtl_size vs_local_size = {64, 1, 1};
+
+   mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH,
+                                    MTL_STAGE_DISPATCH);
+   mtl_compute_set_pipeline_state(enc, vs_pipeline);
+   if (indirect) {
+      uint64_t grid_addr =
+         gfx->per_draw_data.vertex_params +
+         offsetof(struct poly_vertex_params, grid);
+      mtl_dispatch_threads_with_indirect_buffer(enc, grid_addr);
+   } else {
+      kk_dispatch_compute(enc, kk_grid_2d(draw.grid.size.x, draw.grid.size.y),
+                          vs_local_size);
+   }
+
+   bool query_active = false;
+   for (uint32_t i = 0; i < POLY_MAX_VERTEX_STREAMS; ++i)
+      query_active |= gfx->xfb.query[i] != 0;
+
+   if (gfx->xfb.enabled || query_active) {
+      mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH,
+                                       MTL_STAGE_DISPATCH);
+      mtl_compute_set_pipeline_state(
+         enc, vs->pipeline.gfx.transform_feedback_pre_gs);
+      kk_dispatch_compute(enc, kk_grid_1d(1), (struct mtl_size){1, 1, 1});
+   }
+
+   if (indirect) {
+      draw.grid = kk_grid_indirect(
+         gfx->per_draw_data.geometry_params +
+         offsetof(struct poly_geometry_params, draw));
+   } else {
+      draw.grid = kk_grid_3d(gfx->xfb.raster_vertex_count,
+                             gfx->xfb.raster_instance_count, 0);
+   }
+
+   draw.index.gpu = (struct kk_addr_range){0};
+   draw.index.el_size_B = 0;
+   draw.vertex_offset = 0;
+   draw.primitive_type = mesa_prim_to_mtl_primitive_type(gsi->mode);
+   return draw;
+}
+
 /* Get modifiable per draw data. */
 static struct kk_draw_data
 build_draw_data(struct kk_cmd_buffer *cmd, struct kk_draw_command *data,
@@ -2114,12 +2282,15 @@ kk_draw(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
       !tess && polygon_as_points && vs->info.vs.polygon_point_emulation;
    const bool emulate_rectangular_lines =
       !tess && vs->info.vs.rectangular_line_emulation;
+   const bool emulate_transform_feedback =
+      !tess && vs->info.vs.transform_feedback_emulation;
 
    /* Unroll geometry. Skip draw if we fail. No need to unroll if tessellation
     * is present since it also handles unrolling. */
    bool requires_unroll =
       !tess &&
       ((!emulate_polygon_points && data->prim == MESA_PRIM_TRIANGLE_FAN) ||
+       (emulate_transform_feedback && data->restart) ||
        (!emulate_polygon_points && polygon_as_points &&
         is_polygon_primitive(data->prim) &&
         data->prim != MESA_PRIM_TRIANGLES) ||
@@ -2137,15 +2308,21 @@ kk_draw(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
 
       if (tess)
          draw_data = kk_launch_tess(cmd, draw_data);
+      else if (emulate_transform_feedback)
+         draw_data =
+            kk_launch_transform_feedback(cmd, draw_data, data->prim);
       else if (emulate_polygon_points)
          draw_data = kk_launch_polygon_points(cmd, draw_data, data->prim);
       else if (emulate_rectangular_lines)
          draw_data =
             kk_launch_rectangular_lines(cmd, draw_data, data->prim);
 
-      const enum mesa_prim raster_prim = tess ? cmd->state.gfx.tess.prim
-                                               : data->prim;
-      if (polygon_as_points && is_polygon_primitive(raster_prim))
+      const enum mesa_prim raster_prim =
+         tess ? cmd->state.gfx.tess.prim
+         : emulate_transform_feedback ? vs->info.vs.transform_feedback.mode
+                                      : data->prim;
+      if (!emulate_transform_feedback && polygon_as_points &&
+          is_polygon_primitive(raster_prim))
          draw_data.primitive_type = MTL_PRIMITIVE_TYPE_POINT;
 
       kk_dispatch_draw(cmd, draw_data);
@@ -2463,3 +2640,126 @@ kk_CmdDrawIndexedIndirectCount2KHR(VkCommandBuffer commandBuffer,
 
    kk_draw(cmd, &data);
 }
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBindTransformFeedbackBuffers2EXT(
+   VkCommandBuffer commandBuffer, uint32_t firstBinding,
+   uint32_t bindingCount,
+   const VkBindTransformFeedbackBuffer2InfoEXT *pBindingInfos)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   for (uint32_t i = 0; i < bindingCount; ++i) {
+      const VkDeviceAddressRangeKHR range = pBindingInfos[i].addressRange;
+      gfx->xfb.buffers[firstBinding + i] = (struct kk_addr_range){
+         .addr = range.address,
+         .range = range.size,
+      };
+   }
+}
+
+static void
+kk_begin_end_transform_feedback(
+   struct kk_cmd_buffer *cmd, uint32_t firstCounterRange,
+   uint32_t counterRangeCount,
+   const VkBindTransformFeedbackBuffer2InfoEXT *pCounterInfos, bool begin)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   uint64_t offsets = kk_transform_feedback_offsets(cmd);
+   if (!offsets)
+      return;
+
+   struct libkk_xfb_counter_copy copy = {0};
+   uint32_t copies = 0;
+
+   if (begin) {
+      for (uint32_t i = 0; i < POLY_MAX_SO_BUFFERS; ++i)
+         copy.dest[i] = offsets + i * sizeof(uint32_t);
+
+      for (uint32_t i = 0; pCounterInfos && i < counterRangeCount; ++i) {
+         uint32_t index = firstCounterRange + i;
+         copy.src[index] = pCounterInfos[i].addressRange.address;
+      }
+      copies = POLY_MAX_SO_BUFFERS;
+   } else {
+      for (uint32_t i = 0; pCounterInfos && i < counterRangeCount; ++i) {
+         uint64_t dst = pCounterInfos[i].addressRange.address;
+         if (!dst)
+            continue;
+
+         copy.dest[copies] = dst;
+         copy.src[copies] =
+            offsets + (firstCounterRange + i) * sizeof(uint32_t);
+         ++copies;
+      }
+   }
+
+   gfx->xfb.enabled = begin;
+   if (copies) {
+      struct kk_ptr copy_gpu = kk_pool_upload(cmd, &copy, sizeof(copy), 8);
+      if (copy_gpu.gpu)
+         libkk_copy_xfb_counters(cmd, kk_grid_1d(copies), true, copy_gpu.gpu);
+   }
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBeginTransformFeedback2EXT(
+   VkCommandBuffer commandBuffer, uint32_t firstCounterRange,
+   uint32_t counterRangeCount,
+   const VkBindTransformFeedbackBuffer2InfoEXT *pCounterInfos)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_begin_end_transform_feedback(cmd, firstCounterRange, counterRangeCount,
+                                   pCounterInfos, true);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdEndTransformFeedback2EXT(
+   VkCommandBuffer commandBuffer, uint32_t firstCounterRange,
+   uint32_t counterRangeCount,
+   const VkBindTransformFeedbackBuffer2InfoEXT *pCounterInfos)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_begin_end_transform_feedback(cmd, firstCounterRange, counterRangeCount,
+                                   pCounterInfos, false);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdDrawIndirectByteCount2EXT(
+   VkCommandBuffer commandBuffer, uint32_t instanceCount,
+   uint32_t firstInstance,
+   const VkBindTransformFeedbackBuffer2InfoEXT *pCounterInfo,
+   uint32_t counterOffset, uint32_t vertexStride)
+{
+   if (!instanceCount)
+      return;
+
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_ptr indirect =
+      kk_pool_alloc(cmd, sizeof(VkDrawIndirectCommand), 4);
+   if (!indirect.gpu)
