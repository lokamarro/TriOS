 }
 
+static bool
+kk_cf_list_has_loop(struct exec_list *list)
+{
+   foreach_list_typed(nir_cf_node, node, node, list) {
+      if (node->type == nir_cf_node_loop)
+         return true;
+      if (node->type == nir_cf_node_if) {
+         nir_if *nif = nir_cf_node_as_if(node);
+         if (kk_cf_list_has_loop(&nif->then_list) ||
+             kk_cf_list_has_loop(&nif->else_list))
+            return true;
+      }
+   }
+   return false;
+}
+
+/* KK_WORKAROUND_21 */
+bool
+kk_vertex_stage_runs_as_compute(const nir_shader *nir,
+                                uint64_t disabled_workarounds)
+{
+   if (disabled_workarounds & BITFIELD64_BIT(21))
+      return false;
+   if (nir->info.stage != MESA_SHADER_VERTEX &&
+       nir->info.stage != MESA_SHADER_TESS_EVAL)
+      return false;
+
+   bool loops = false, writes = false;
+   nir_foreach_function_impl(impl, (nir_shader *)nir) {
+      loops |= kk_cf_list_has_loop(&impl->body);
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_intrinsic &&
+                nir_intrinsic_writes_external_memory(
+                   nir_instr_as_intrinsic(instr)))
+               writes = true;
+         }
+      }
+   }
+   return loops && writes;
+}
