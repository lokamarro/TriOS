@@ -3631,8 +3631,16 @@ kk_launch_transform_feedback(struct kk_cmd_buffer *cmd,
       vs->pipeline.gfx.pre_render[tes ? 2 : 0];
    struct mtl_size vs_local_size = {64, 1, 1};
 
-   mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH,
-                                    MTL_STAGE_DISPATCH);
+   /* A stage KK_WORKAROUND_21 put here waits for nothing earlier in the
+    * encoder, so consecutive draws' stages overlap as Metal vertex functions
+    * would. What the GPU prepares for its draw comes from precompiled
+    * kernels, which end with a barrier; its records are a fresh allocation;
+    * and the application orders its own memory between draws with a
+    * pipeline barrier, which ends the pass. A barrier per draw serialized
+    * the draws at about 5 us each on an M1 Ultra. */
+   if (!vs->info.vs.vertex_compute)
+      mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH,
+                                       MTL_STAGE_DISPATCH);
    mtl_compute_set_pipeline_state(enc, vs_pipeline);
    if (indirect) {
       uint64_t grid_addr =
@@ -3995,9 +4003,13 @@ kk_draw_flushed(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
        requires_unroll_restart(cmd, data) || rewrite_direct_provoking ||
        (discard_adjacency && !emulate_line_raster));
    /* Every stage the driver emulates, and every unroll, allocates from the
-    * device heap. */
+    * device heap. A stage KK_WORKAROUND_21 runs as compute writes its records
+    * to the pool, and an indirect draw of it pins the heap where its setup
+    * reserves; pinning it here queued a heap reset, in a command buffer of
+    * its own after the pass, for every pass. */
    const bool needs_heap = requires_unroll || tess || emulate_geometry ||
-                           emulate_transform_feedback ||
+                           (emulate_transform_feedback &&
+                            !vs->info.vs.vertex_compute) ||
                            emulate_line_raster || emulate_polygon_points ||
                            materialize_line_raster;
    if (requires_unroll) {
