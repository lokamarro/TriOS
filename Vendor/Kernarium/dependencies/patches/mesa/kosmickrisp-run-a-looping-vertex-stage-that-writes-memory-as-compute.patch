diff --git a/src/kosmickrisp/vulkan/tests/vertex_compute_draws_shaders/tile.vert b/src/kosmickrisp/vulkan/tests/vertex_compute_draws_shaders/tile.vert
new file mode 100644
index 0000000000000000000000000000000000000000..b737af982e39966de7a9e9b23b003afa6596aede
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/vertex_compute_draws_shaders/tile.vert
@@ -0,0 +1,31 @@
+#version 450
+/* SPDX-License-Identifier: MIT */
+#extension GL_EXT_buffer_reference : require
+
+/* Draw d, named by its first instance, covers tile d of an 8x8 grid, and each
+ * of its six vertices writes a word of its own in a loop, so the driver runs
+ * the stage as compute (KK_WORKAROUND_21). */
+layout(buffer_reference, std430) buffer Words {
+   uint w[];
+};
+
+layout(push_constant) uniform Params {
+   Words words;
+   uint count;
+} pc;
+
+layout(location = 0) flat out uint tile;
+
+const vec2 corners[6] = vec2[](vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 1.0),
+                               vec2(1.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 1.0));
+
+void main(void)
+{
+   uint d = uint(gl_InstanceIndex);
+   uint v = uint(gl_VertexIndex);
+   for (uint i = 0u; i < pc.count; ++i)
+      pc.words.w[d * 6u + v] = d * 16u + v + i;
+   vec2 p = (vec2(d % 8u, d / 8u) + corners[v]) / 8.0;
+   gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+   tile = d;
+}
