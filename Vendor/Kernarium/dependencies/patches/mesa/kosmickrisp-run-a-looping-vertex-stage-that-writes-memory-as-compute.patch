diff --git a/src/kosmickrisp/vulkan/tests/test_long_vertex_invocation.cpp b/src/kosmickrisp/vulkan/tests/test_long_vertex_invocation.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..69892e9c0436b3df40ee8b4dd0a689d799e70236
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_long_vertex_invocation.cpp
@@ -0,0 +1,286 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* An Apple GPU kills a Metal vertex function invocation that runs for longer
+ * than about 10 ms, and reports the kill as a timeout; a compute thread runs
+ * for far longer.  See KK_WORKAROUND_21.  One vertex or tessellation
+ * evaluation invocation here runs a chain of dependent device-memory updates
+ * for well past that limit, and every word of the chain must land.
+ *
+ * usage: test_kosmickrisp_long_vertex_invocation vertex|discard|tess
+ *        [--count N] [--expect-loss]
+ * vertex draws one point, discard draws it with the rasterizer discarded and
+ * tess has the tessellation evaluation stage run the chain.  --expect-loss,
+ * with MESA_KK_DISABLE_WORKAROUNDS=21, instead requires the chain to be cut
+ * short or the submission to fail, which shows the limit the workaround
+ * avoids. */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+#include "kk_test.h"
+
+static const uint32_t store_loop_vert[] =
+#include "long_vertex_shaders/store_loop.vert.h"
+;
+static const uint32_t patch_vert[] =
+#include "long_vertex_shaders/patch.vert.h"
+;
+static const uint32_t patch_tesc[] =
+#include "long_vertex_shaders/patch.tesc.h"
+;
+static const uint32_t store_loop_tese[] =
+#include "long_vertex_shaders/store_loop.tese.h"
+;
+static const uint32_t color_frag[] =
+#include "long_vertex_shaders/color.frag.h"
+;
+
+struct params {
+   VkDeviceAddress words;
+   uint32_t count;
+   uint32_t mask;
+};
+
+int main(int argc, char **argv)
+{
+   require(argc >= 2, "usage: vertex|discard|tess [--count N] [--expect-loss]");
+   const std::string shape = argv[1];
+   const bool tess = shape == "tess";
+   const bool discard = shape == "discard";
+   require(tess || discard || shape == "vertex", "unknown shape");
+   /* About 50 ms of dependent updates on an M1 Ultra, five times the limit. */
+   uint32_t count = 1u << 17;
+   bool expect_loss = false;
+   for (int i = 2; i < argc; ++i) {
+      if (!strcmp(argv[i], "--count") && i + 1 < argc)
+         count = uint32_t(strtoul(argv[++i], nullptr, 0));
+      else if (!strcmp(argv[i], "--expect-loss"))
+         expect_loss = true;
+      else
+         require(false, "unknown argument");
+   }
+
+   kk_test_device t;
+   kk_test_create_instance(&t, "long-vertex-invocation");
+   VkPhysicalDeviceVulkan12Features features12{
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+   features12.bufferDeviceAddress = VK_TRUE;
+   VkPhysicalDeviceVulkan13Features features13{
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+   features13.pNext = &features12;
+   features13.dynamicRendering = VK_TRUE;
+   VkPhysicalDeviceFeatures features{};
+   features.vertexPipelineStoresAndAtomics = VK_TRUE;
+   features.tessellationShader = VK_TRUE;
+   features.shaderTessellationAndGeometryPointSize = VK_TRUE;
+   kk_test_create_device(&t, &features13, &features, 0, nullptr);
+   KK_LOAD_DEVICE_FUNCTIONS(t);
+   LOAD_D(vkGetBufferDeviceAddress);
+
+   constexpr uint32_t words = 4096;
+   VkBuffer buffer = VK_NULL_HANDLE;
+   VkDeviceMemory memory = VK_NULL_HANDLE;
+   uint32_t *mapped = nullptr;
+   VkMemoryAllocateFlagsInfo address_flags{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO};
+   address_flags.flags = VK_MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT;
+   VkBufferCreateInfo buffer_info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+   buffer_info.size = words * sizeof(uint32_t);
+   buffer_info.usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+                       VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT;
+   VkResult result = vkCreateBuffer(device, &buffer_info, nullptr, &buffer);
+   require(result == VK_SUCCESS, "create buffer", result);
+   VkMemoryRequirements requirements{};
+   vkGetBufferMemoryRequirements(device, buffer, &requirements);
+   VkMemoryAllocateInfo memory_info{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+   memory_info.pNext = &address_flags;
+   memory_info.allocationSize = requirements.size;
+   memory_info.memoryTypeIndex =
+      kk_test_memory_type(&t, requirements.memoryTypeBits, KK_TEST_HOST_MEMORY);
+   result = vkAllocateMemory(device, &memory_info, nullptr, &memory);
+   require(result == VK_SUCCESS, "allocate buffer", result);
+   result = vkBindBufferMemory(device, buffer, memory, 0);
+   require(result == VK_SUCCESS, "bind buffer", result);
+   result = vkMapMemory(device, memory, 0, VK_WHOLE_SIZE, 0,
+                        reinterpret_cast<void **>(&mapped));
+   require(result == VK_SUCCESS, "map buffer", result);
+   memset(mapped, 0, words * sizeof(uint32_t));
+   VkBufferDeviceAddressInfo address_info{VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO};
+   address_info.buffer = buffer;
+   const params push{vkGetBufferDeviceAddress(device, &address_info), count,
+                     words - 1u};
+
+   VkImageCreateInfo image_info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+   image_info.imageType = VK_IMAGE_TYPE_2D;
+   image_info.format = VK_FORMAT_R8G8B8A8_UNORM;
+   image_info.extent = {8, 8, 1};
+   image_info.mipLevels = 1;
+   image_info.arrayLayers = 1;
+   image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+   image_info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+   VkImage image = VK_NULL_HANDLE;
+   result = vkCreateImage(device, &image_info, nullptr, &image);
+   require(result == VK_SUCCESS, "create image", result);
+   VkDeviceMemory image_memory =
+      kk_test_image_memory(&t, image, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+   VkImageView view = kk_test_image_view(&t, image, VK_IMAGE_VIEW_TYPE_2D,
+                                         VK_FORMAT_R8G8B8A8_UNORM,
+                                         VK_IMAGE_ASPECT_COLOR_BIT, 0, 1);
+
+   const VkShaderStageFlags push_stages =
+      VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT;
+   const VkPushConstantRange push_range{push_stages, 0, sizeof(params)};
+   VkPipelineLayoutCreateInfo layout_info{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+   layout_info.pushConstantRangeCount = 1;
+   layout_info.pPushConstantRanges = &push_range;
+   VkPipelineLayout layout = VK_NULL_HANDLE;
+   result = vkCreatePipelineLayout(device, &layout_info, nullptr, &layout);
+   require(result == VK_SUCCESS, "create layout", result);
+
+   VkShaderModule modules[4]{};
+   VkPipelineShaderStageCreateInfo stages[4]{};
+   uint32_t stage_count = 0;
+   auto add_stage = [&](VkShaderStageFlagBits stage, const uint32_t *code,
+                        size_t size) {
+      modules[stage_count] = kk_test_shader_module(&t, code, size);
+      stages[stage_count] = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};
+      stages[stage_count].stage = stage;
+      stages[stage_count].module = modules[stage_count];
+      stages[stage_count].pName = "main";
+      ++stage_count;
+   };
+   if (tess) {
+      add_stage(VK_SHADER_STAGE_VERTEX_BIT, patch_vert, sizeof(patch_vert));
+      add_stage(VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT, patch_tesc,
+                sizeof(patch_tesc));
+      add_stage(VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT, store_loop_tese,
+                sizeof(store_loop_tese));
+   } else {
+      add_stage(VK_SHADER_STAGE_VERTEX_BIT, store_loop_vert,
+                sizeof(store_loop_vert));
+   }
+   add_stage(VK_SHADER_STAGE_FRAGMENT_BIT, color_frag, sizeof(color_frag));
+
+   VkPipelineVertexInputStateCreateInfo vi{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+   VkPipelineInputAssemblyStateCreateInfo ia{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+   ia.topology = tess ? VK_PRIMITIVE_TOPOLOGY_PATCH_LIST
+                      : VK_PRIMITIVE_TOPOLOGY_POINT_LIST;
+   VkPipelineTessellationStateCreateInfo ts{VK_STRUCTURE_TYPE_PIPELINE_TESSELLATION_STATE_CREATE_INFO};
+   ts.patchControlPoints = 3;
+   VkViewport viewport{0.0f, 0.0f, 8.0f, 8.0f, 0.0f, 1.0f};
+   VkRect2D scissor{{0, 0}, {8, 8}};
+   VkPipelineViewportStateCreateInfo vp{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+   vp.viewportCount = 1;
+   vp.pViewports = &viewport;
+   vp.scissorCount = 1;
+   vp.pScissors = &scissor;
+   VkPipelineRasterizationStateCreateInfo rs{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+   rs.rasterizerDiscardEnable = discard ? VK_TRUE : VK_FALSE;
+   rs.lineWidth = 1.0f;
+   VkPipelineMultisampleStateCreateInfo ms{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+   ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+   VkPipelineColorBlendAttachmentState blend_attachment{};
+   blend_attachment.colorWriteMask = 0xf;
+   VkPipelineColorBlendStateCreateInfo blend{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+   blend.attachmentCount = 1;
+   blend.pAttachments = &blend_attachment;
+   const VkFormat color_format = VK_FORMAT_R8G8B8A8_UNORM;
+   VkPipelineRenderingCreateInfo rendering{VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+   rendering.colorAttachmentCount = 1;
+   rendering.pColorAttachmentFormats = &color_format;
+   VkGraphicsPipelineCreateInfo pipeline_info{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+   pipeline_info.pNext = &rendering;
+   pipeline_info.stageCount = stage_count;
+   pipeline_info.pStages = stages;
+   pipeline_info.pVertexInputState = &vi;
+   pipeline_info.pInputAssemblyState = &ia;
+   pipeline_info.pTessellationState = tess ? &ts : nullptr;
+   pipeline_info.pViewportState = &vp;
+   pipeline_info.pRasterizationState = &rs;
+   pipeline_info.pMultisampleState = &ms;
+   pipeline_info.pColorBlendState = &blend;
+   pipeline_info.layout = layout;
+   VkPipeline pipeline = VK_NULL_HANDLE;
+   result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &pipeline_info,
+                                      nullptr, &pipeline);
+   require(result == VK_SUCCESS, "create pipeline", result);
+
+   VkCommandPool pool = VK_NULL_HANDLE;
+   VkCommandBuffer command = VK_NULL_HANDLE;
+   kk_test_command_buffer(&t, 0, &pool, &command);
+   VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+   begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+   result = vkBeginCommandBuffer(command, &begin);
+   require(result == VK_SUCCESS, "begin command", result);
+   VkImageMemoryBarrier to_attachment{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+   to_attachment.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+   to_attachment.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+   to_attachment.newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+   to_attachment.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+   to_attachment.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+   to_attachment.image = image;
+   to_attachment.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+   vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                        VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, 0, 0,
+                        nullptr, 0, nullptr, 1, &to_attachment);
+   VkRenderingAttachmentInfo color{VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+   color.imageView = view;
+   color.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+   color.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+   color.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+   VkRenderingInfo render{VK_STRUCTURE_TYPE_RENDERING_INFO};
+   render.renderArea.extent = {8, 8};
+   render.layerCount = 1;
+   render.colorAttachmentCount = 1;
+   render.pColorAttachments = &color;
+   vkCmdBeginRendering(command, &render);
+   vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+   vkCmdPushConstants(command, layout, push_stages, 0, sizeof(push), &push);
+   vkCmdDraw(command, tess ? 3 : 1, 1, 0, 0);
+   vkCmdEndRendering(command);
+   VkMemoryBarrier to_host{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+   to_host.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+   to_host.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+   vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_ALL_GRAPHICS_BIT,
+                        VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &to_host, 0, nullptr,
+                        0, nullptr);
+   result = vkEndCommandBuffer(command);
+   require(result == VK_SUCCESS, "end command", result);
+
+   const auto start = std::chrono::steady_clock::now();
+   result = kk_test_submit_and_wait(&t, command, 20ull * 1000 * 1000 * 1000);
+   const double wait_ms = std::chrono::duration<double, std::milli>(
+                        std::chrono::steady_clock::now() - start).count();
+   const uint32_t last = mapped[count & (words - 1u)];
+   const uint32_t before = mapped[(count - 1u) & (words - 1u)];
+   const bool complete = result == VK_SUCCESS && last == count &&
+                         before == count - 1u;
+   std::printf("%s: count=%u wait=%d %.1f ms last word %u (want %u) %s\n",
+               shape.c_str(), count, result, wait_ms, last, count,
+               complete ? "complete" : "cut short");
+   if (expect_loss)
+      require(!complete, "expected the GPU to cut the chain short");
+   else
+      require(complete, "every update of the chain landed");
+
+   vkDestroyCommandPool(device, pool, nullptr);
+   vkDestroyPipeline(device, pipeline, nullptr);
+   for (uint32_t i = 0; i < stage_count; ++i)
+      vkDestroyShaderModule(device, modules[i], nullptr);
+   vkDestroyPipelineLayout(device, layout, nullptr);
+   vkDestroyImageView(device, view, nullptr);
+   vkDestroyImage(device, image, nullptr);
+   vkFreeMemory(device, image_memory, nullptr);
+   vkUnmapMemory(device, memory);
+   vkDestroyBuffer(device, buffer, nullptr);
+   vkFreeMemory(device, memory, nullptr);
+   kk_test_destroy(&t);
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_vertex_compute_draws.cpp b/src/kosmickrisp/vulkan/tests/test_vertex_compute_draws.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ecc5c60a026a66b4de8af14fb1e0e9511e2d258d
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_vertex_compute_draws.cpp
@@ -0,0 +1,299 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Many draws of a vertex stage the driver runs as compute (KK_WORKAROUND_21)
+ * in one pass. The stages of consecutive draws may overlap, so each draw must
+ * still rasterize its own records and every store must land. Draw d covers
+ * tile d of an 8x8 grid, writes one word per vertex and colors its tile
+ * d + 1; the pass is submitted repeatedly with the words and the target
+ * cleared in between.
+ *
+ * usage: test_kosmickrisp_vertex_compute_draws [--count N] [--rounds N] */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "kk_test.h"
+
+static const uint32_t tile_vert[] =
+#include "vertex_compute_draws_shaders/tile.vert.h"
+;
+static const uint32_t tile_frag[] =
+#include "vertex_compute_draws_shaders/tile.frag.h"
+;
+
+struct params {
+   VkDeviceAddress words;
+   uint32_t count;
+};
+
+int main(int argc, char **argv)
+{
+   uint32_t count = 4u, rounds = 50u;
+   for (int i = 1; i < argc; ++i) {
+      if (!strcmp(argv[i], "--count") && i + 1 < argc)
+         count = uint32_t(strtoul(argv[++i], nullptr, 0));
+      else if (!strcmp(argv[i], "--rounds") && i + 1 < argc)
+         rounds = uint32_t(strtoul(argv[++i], nullptr, 0));
+      else
+         require(false, "unknown argument");
+   }
+   require(count > 0u, "--count must be positive");
+
+   kk_test_device t;
+   kk_test_create_instance(&t, "vertex-compute-draws");
+   VkPhysicalDeviceVulkan12Features features12{
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+   features12.bufferDeviceAddress = VK_TRUE;
+   VkPhysicalDeviceVulkan13Features features13{
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+   features13.pNext = &features12;
+   features13.dynamicRendering = VK_TRUE;
+   VkPhysicalDeviceFeatures features{};
+   features.vertexPipelineStoresAndAtomics = VK_TRUE;
+   kk_test_create_device(&t, &features13, &features, 0, nullptr);
+   KK_LOAD_DEVICE_FUNCTIONS(t);
+   LOAD_D(vkGetBufferDeviceAddress);
+   LOAD_D(vkCmdFillBuffer);
+
+   constexpr uint32_t tiles = 64u, vertices = 6u, size = 64u;
+   constexpr uint32_t words = tiles * vertices;
+   VkBuffer buffer = VK_NULL_HANDLE;
+   VkDeviceMemory memory = VK_NULL_HANDLE;
+   uint32_t *mapped = nullptr;
+   VkMemoryAllocateFlagsInfo address_flags{
+      VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO};
+   address_flags.flags = VK_MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT;
+   VkBufferCreateInfo buffer_info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+   buffer_info.size = words * sizeof(uint32_t);
+   buffer_info.usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+                       VK_BUFFER_USAGE_TRANSFER_DST_BIT |
+                       VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT;
+   VkResult result = vkCreateBuffer(device, &buffer_info, nullptr, &buffer);
+   require(result == VK_SUCCESS, "create buffer", result);
+   VkMemoryRequirements requirements{};
+   vkGetBufferMemoryRequirements(device, buffer, &requirements);
+   VkMemoryAllocateInfo memory_info{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+   memory_info.pNext = &address_flags;
+   memory_info.allocationSize = requirements.size;
+   memory_info.memoryTypeIndex = kk_test_memory_type(
+      &t, requirements.memoryTypeBits, KK_TEST_HOST_MEMORY);
+   result = vkAllocateMemory(device, &memory_info, nullptr, &memory);
+   require(result == VK_SUCCESS, "allocate buffer", result);
+   result = vkBindBufferMemory(device, buffer, memory, 0);
+   require(result == VK_SUCCESS, "bind buffer", result);
+   result = vkMapMemory(device, memory, 0, VK_WHOLE_SIZE, 0,
+                        reinterpret_cast<void **>(&mapped));
+   require(result == VK_SUCCESS, "map buffer", result);
+   VkBufferDeviceAddressInfo address_info{
+      VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO};
+   address_info.buffer = buffer;
+   const params push{vkGetBufferDeviceAddress(device, &address_info), count};
+
+   VkBuffer readback = VK_NULL_HANDLE;
+   VkDeviceMemory readback_memory = VK_NULL_HANDLE;
+   uint32_t *pixels = nullptr;
+   kk_test_buffer(&t, size * size * sizeof(uint32_t),
+                  VK_BUFFER_USAGE_TRANSFER_DST_BIT, KK_TEST_HOST_MEMORY,
+                  &readback, &readback_memory,
+                  reinterpret_cast<void **>(&pixels));
+
+   const VkFormat color_format = VK_FORMAT_R32_UINT;
+   VkImageCreateInfo image_info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+   image_info.imageType = VK_IMAGE_TYPE_2D;
+   image_info.format = color_format;
+   image_info.extent = {size, size, 1};
+   image_info.mipLevels = 1;
+   image_info.arrayLayers = 1;
+   image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+   image_info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                      VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+   VkImage image = VK_NULL_HANDLE;
+   result = vkCreateImage(device, &image_info, nullptr, &image);
+   require(result == VK_SUCCESS, "create image", result);
+   VkDeviceMemory image_memory =
+      kk_test_image_memory(&t, image, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+   VkImageView view = kk_test_image_view(&t, image, VK_IMAGE_VIEW_TYPE_2D,
+                                         color_format,
+                                         VK_IMAGE_ASPECT_COLOR_BIT, 0, 1);
+
+   const VkPushConstantRange push_range{VK_SHADER_STAGE_VERTEX_BIT, 0,
+                                        sizeof(params)};
+   VkPipelineLayoutCreateInfo layout_info{
+      VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+   layout_info.pushConstantRangeCount = 1;
+   layout_info.pPushConstantRanges = &push_range;
+   VkPipelineLayout layout = VK_NULL_HANDLE;
+   result = vkCreatePipelineLayout(device, &layout_info, nullptr, &layout);
+   require(result == VK_SUCCESS, "create layout", result);
+
+   VkShaderModule vs = kk_test_shader_module(&t, tile_vert, sizeof(tile_vert));
+   VkShaderModule fs = kk_test_shader_module(&t, tile_frag, sizeof(tile_frag));
+   VkPipelineShaderStageCreateInfo stages[2]{
+      {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO},
+      {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO}};
+   stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+   stages[0].module = vs;
+   stages[0].pName = "main";
+   stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+   stages[1].module = fs;
+   stages[1].pName = "main";
+   VkPipelineVertexInputStateCreateInfo vi{
+      VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+   VkPipelineInputAssemblyStateCreateInfo ia{
+      VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+   ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+   VkViewport viewport{0.0f, 0.0f, float(size), float(size), 0.0f, 1.0f};
+   VkRect2D scissor{{0, 0}, {size, size}};
+   VkPipelineViewportStateCreateInfo vp{
+      VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+   vp.viewportCount = 1;
+   vp.pViewports = &viewport;
+   vp.scissorCount = 1;
+   vp.pScissors = &scissor;
+   VkPipelineRasterizationStateCreateInfo rs{
+      VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+   rs.lineWidth = 1.0f;
+   VkPipelineMultisampleStateCreateInfo ms{
+      VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+   ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+   VkPipelineColorBlendAttachmentState blend_attachment{};
+   blend_attachment.colorWriteMask = 0xf;
+   VkPipelineColorBlendStateCreateInfo blend{
+      VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+   blend.attachmentCount = 1;
+   blend.pAttachments = &blend_attachment;
+   VkPipelineRenderingCreateInfo rendering{
+      VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+   rendering.colorAttachmentCount = 1;
+   rendering.pColorAttachmentFormats = &color_format;
+   VkGraphicsPipelineCreateInfo pipeline_info{
+      VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+   pipeline_info.pNext = &rendering;
+   pipeline_info.stageCount = 2;
+   pipeline_info.pStages = stages;
+   pipeline_info.pVertexInputState = &vi;
+   pipeline_info.pInputAssemblyState = &ia;
+   pipeline_info.pViewportState = &vp;
+   pipeline_info.pRasterizationState = &rs;
+   pipeline_info.pMultisampleState = &ms;
+   pipeline_info.pColorBlendState = &blend;
+   pipeline_info.layout = layout;
+   VkPipeline pipeline = VK_NULL_HANDLE;
+   result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
+                                      &pipeline_info, nullptr, &pipeline);
+   require(result == VK_SUCCESS, "create pipeline", result);
+
+   VkCommandPool pool = VK_NULL_HANDLE;
+   VkCommandBuffer command = VK_NULL_HANDLE;
+   kk_test_command_buffer(&t, 0, &pool, &command);
+   VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+   result = vkBeginCommandBuffer(command, &begin);
+   require(result == VK_SUCCESS, "begin command", result);
+   vkCmdFillBuffer(command, buffer, 0, VK_WHOLE_SIZE, 0u);
+   VkMemoryBarrier to_vertex{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+   to_vertex.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+   to_vertex.dstAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+   VkImageMemoryBarrier to_attachment{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+   to_attachment.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+   to_attachment.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+   to_attachment.newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+   to_attachment.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+   to_attachment.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+   to_attachment.image = image;
+   to_attachment.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+   vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                        VK_PIPELINE_STAGE_VERTEX_SHADER_BIT |
+                           VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                        0, 1, &to_vertex, 0, nullptr, 1, &to_attachment);
+   VkRenderingAttachmentInfo color{VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO};
+   color.imageView = view;
+   color.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+   color.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+   color.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+   VkRenderingInfo render{VK_STRUCTURE_TYPE_RENDERING_INFO};
+   render.renderArea.extent = {size, size};
+   render.layerCount = 1;
+   render.colorAttachmentCount = 1;
+   render.pColorAttachments = &color;
+   vkCmdBeginRendering(command, &render);
+   vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+   vkCmdPushConstants(command, layout, VK_SHADER_STAGE_VERTEX_BIT, 0,
+                      sizeof(push), &push);
+   for (uint32_t d = 0; d < tiles; ++d)
+      vkCmdDraw(command, vertices, 1, 0, d);
+   vkCmdEndRendering(command);
+   VkImageMemoryBarrier to_copy = to_attachment;
+   to_copy.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+   to_copy.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+   to_copy.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+   to_copy.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+   vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0,
+                        nullptr, 1, &to_copy);
+   VkBufferImageCopy copy{};
+   copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+   copy.imageExtent = {size, size, 1};
+   vkCmdCopyImageToBuffer(command, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                          readback, 1, &copy);
+   VkMemoryBarrier to_host{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+   to_host.srcAccessMask =
+      VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+   to_host.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+   vkCmdPipelineBarrier(command,
+                        VK_PIPELINE_STAGE_ALL_GRAPHICS_BIT |
+                           VK_PIPELINE_STAGE_TRANSFER_BIT,
+                        VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &to_host, 0, nullptr,
+                        0, nullptr);
+   result = vkEndCommandBuffer(command);
+   require(result == VK_SUCCESS, "end command", result);
+
+   uint32_t bad_words = 0, bad_tiles = 0;
+   for (uint32_t round = 0; round < rounds; ++round) {
+      memset(pixels, 0xff, size * size * sizeof(uint32_t));
+      result = kk_test_submit_and_wait(&t, command, 10ull * 1000 * 1000 * 1000);
+      require(result == VK_SUCCESS, "submit", result);
+      for (uint32_t d = 0; d < tiles; ++d) {
+         for (uint32_t v = 0; v < vertices; ++v) {
+            const uint32_t want = d * 16u + v + count - 1u;
+            if (mapped[d * vertices + v] != want && bad_words++ < 8)
+               std::fprintf(stderr, "round %u draw %u vertex %u: word %u, want %u\n",
+                            round, d, v, mapped[d * vertices + v], want);
+         }
+         /* The tile's center pixel. */
+         const uint32_t tile = size / 8u;
+         const uint32_t x = (d % 8u) * tile + tile / 2u;
+         const uint32_t y = (d / 8u) * tile + tile / 2u;
+         if (pixels[y * size + x] != d + 1u && bad_tiles++ < 8)
+            std::fprintf(stderr, "round %u tile %u: color %u, want %u\n", round,
+                         d, pixels[y * size + x], d + 1u);
+      }
+   }
+   std::printf("vertex compute draws: %u rounds of %u draws, %u bad words, "
+               "%u bad tiles\n",
+               rounds, tiles, bad_words, bad_tiles);
+   require(bad_words == 0 && bad_tiles == 0,
+           "every draw stored its words and rasterized its own tile");
+
+   vkDestroyCommandPool(device, pool, nullptr);
+   vkDestroyPipeline(device, pipeline, nullptr);
+   vkDestroyShaderModule(device, vs, nullptr);
+   vkDestroyShaderModule(device, fs, nullptr);
+   vkDestroyPipelineLayout(device, layout, nullptr);
+   vkDestroyImageView(device, view, nullptr);
+   vkDestroyImage(device, image, nullptr);
+   vkFreeMemory(device, image_memory, nullptr);
+   vkUnmapMemory(device, readback_memory);
+   vkDestroyBuffer(device, readback, nullptr);
+   vkFreeMemory(device, readback_memory, nullptr);
+   vkUnmapMemory(device, memory);
+   vkDestroyBuffer(device, buffer, nullptr);
+   vkFreeMemory(device, memory, nullptr);
+   kk_test_destroy(&t);
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_vertex_compute_routing.c b/src/kosmickrisp/vulkan/tests/test_vertex_compute_routing.c
new file mode 100644
index 0000000000000000000000000000000000000000..23605364502af32f0c21c88449fb9845071fe78b
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_vertex_compute_routing.c
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: MIT */
+
+/* Which stages the driver runs as compute so that one long invocation is not
+ * killed as a Metal vertex function: a vertex or tessellation evaluation
+ * stage that writes memory anywhere and contains a loop.  See
+ * KK_WORKAROUND_21. */
+
+#include "kosmickrisp/vulkan/kk_shader.h"
+
+#include "compiler/nir/nir_builder.h"
+#include "kosmickrisp/compiler/nir_to_msl.h"
+
+#include <stdio.h>
+
+#include "kk_test.h"
+
+enum body {
+   /* The store inside a loop. */
+   STORE_IN_LOOP,
+   /* A loop that only computes an output. */
+   LOOP_ONLY,
+   /* A store and no loop. */
+   STORE_ONLY,
+   /* A loop inside an if, and an image store after it. */
+   LOOP_IN_IF_IMAGE_STORE_AFTER,
+   /* An SSBO store inside a loop. */
+   SSBO_STORE_IN_LOOP,
+};
+
+static nir_shader *
+build(mesa_shader_stage stage, enum body body)
+{
+   nir_builder b =
+      nir_builder_init_simple_shader(stage, &kk_nir_options, "routing");
+   nir_variable *index =
+      nir_local_variable_create(b.impl, glsl_uint_type(), "index");
+   nir_store_var(&b, index, nir_imm_int(&b, 0), 0x1);
+   nir_def *count = nir_load_push_constant(&b, 1, 32, nir_imm_int(&b, 0),
+                                           .base = 0, .range = 4);
+   nir_def *address = nir_imm_int64(&b, 0x10000);
+
+   if (body == LOOP_IN_IF_IMAGE_STORE_AFTER)
+      nir_push_if(&b, nir_ine_imm(&b, count, 0));
+   if (body != STORE_ONLY) {
+      nir_push_loop(&b);
+      {
+         nir_def *i = nir_load_var(&b, index);
+         nir_push_if(&b, nir_uge(&b, i, count));
+         nir_jump(&b, nir_jump_break);
+         nir_pop_if(&b, NULL);
+         if (body == STORE_IN_LOOP)
+            nir_store_global(&b, i, address, .align_mul = 4);
+         if (body == SSBO_STORE_IN_LOOP)
+            nir_store_ssbo(&b, i, nir_imm_int(&b, 0), nir_imul_imm(&b, i, 4),
+                           .align_mul = 4);
+         nir_store_var(&b, index, nir_iadd_imm(&b, i, 1), 0x1);
+      }
+      nir_pop_loop(&b, NULL);
+   }
+   if (body == LOOP_IN_IF_IMAGE_STORE_AFTER) {
+      nir_pop_if(&b, NULL);
+      nir_def *handle = nir_imm_int64(&b, 0x20000);
+      nir_bindless_image_store(
+         &b, handle, nir_imm_ivec4(&b, 0, 0, 0, 0), nir_imm_int(&b, 0),
+         nir_imm_ivec4(&b, 1, 1, 1, 1), nir_imm_int(&b, 0),
+         .image_dim = GLSL_SAMPLER_DIM_2D, .format = PIPE_FORMAT_R32_UINT,
+         .src_type = nir_type_uint32);
+   }
+   if (body == STORE_ONLY)
+      nir_store_global(&b, count, address, .align_mul = 4);
+   return b.shader;
+}
+
+static bool
+routed(mesa_shader_stage stage, enum body body, uint64_t disabled)
+{
+   nir_shader *nir = build(stage, body);
+   bool result = kk_vertex_stage_runs_as_compute(nir, disabled);
+   ralloc_free(nir);
+   return result;
+}
+
+int
+main(void)
+{
+   glsl_type_singleton_init_or_ref();
+
+   CHECK(routed(MESA_SHADER_VERTEX, STORE_IN_LOOP, 0));
+   CHECK(routed(MESA_SHADER_VERTEX, LOOP_IN_IF_IMAGE_STORE_AFTER, 0));
+   CHECK(routed(MESA_SHADER_VERTEX, SSBO_STORE_IN_LOOP, 0));
+   CHECK(routed(MESA_SHADER_TESS_EVAL, STORE_IN_LOOP, 0));
+   CHECK(routed(MESA_SHADER_TESS_EVAL, SSBO_STORE_IN_LOOP, 0));
+
+   /* No side effect to lose, or no loop to run long. */
+   CHECK(!routed(MESA_SHADER_VERTEX, LOOP_ONLY, 0));
+   CHECK(!routed(MESA_SHADER_VERTEX, STORE_ONLY, 0));
+   CHECK(!routed(MESA_SHADER_TESS_EVAL, LOOP_ONLY, 0));
+
+   /* Stages that never run as the Metal vertex function. */
+   CHECK(!routed(MESA_SHADER_FRAGMENT, STORE_IN_LOOP, 0));
+   CHECK(!routed(MESA_SHADER_TESS_CTRL, STORE_IN_LOOP, 0));
+   CHECK(!routed(MESA_SHADER_GEOMETRY, STORE_IN_LOOP, 0));
+   CHECK(!routed(MESA_SHADER_COMPUTE, STORE_IN_LOOP, 0));
+
+   /* MESA_KK_DISABLE_WORKAROUNDS=21 leaves every stage where it was. */
+   CHECK(!routed(MESA_SHADER_VERTEX, STORE_IN_LOOP, BITFIELD64_BIT(21)));
+   CHECK(!routed(MESA_SHADER_TESS_EVAL, STORE_IN_LOOP, BITFIELD64_BIT(21)));
+
+   printf("vertex compute routing PASS\n");
+   glsl_type_singleton_decref();
+   return 0;
+}
