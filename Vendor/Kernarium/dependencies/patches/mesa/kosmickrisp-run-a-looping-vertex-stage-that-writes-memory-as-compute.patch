                           struct vk_shader_compile_info *infos,
@@ -4980,6 +5024,9 @@ kk_precompile_library_stages(struct kk_device *dev, uint32_t shader_count,
          return;
       if (infos[i].nir->xfb_info != NULL)
          return;
+      if (kk_vertex_stage_runs_as_compute(infos[i].nir,
+                                          dev->disabled_workarounds))
+         return;
       if (infos[i].stage == MESA_SHADER_VERTEX) {
          attribs_read = container_of(deferred[i], struct kk_shader, vk)
                            ->info.vs.attribs_read;
@@ -5193,6 +5240,7 @@ kk_compile_shaders_single(struct vk_device *device, uint32_t shader_count,
    /* Determine if the pipeline contains tessellation stages */
    bool tess = false;
    bool transform_feedback_emulation = false;
+   bool vertex_compute = false;
    uint32_t geometry_shader = UINT32_MAX;
    uint32_t tess_eval_shader = UINT32_MAX;
    for (uint32_t i = 0u; i < shader_count; ++i) {
@@ -5215,6 +5263,20 @@ kk_compile_shaders_single(struct vk_device *device, uint32_t shader_count,
       const nir_shader *producer = infos[xfb_shader].nir;
       transform_feedback_emulation = producer->xfb_info &&
                                      producer->xfb_info->output_count > 0;
+      /* KK_WORKAROUND_21: the transform feedback pass-through, with nothing
+       * to capture, runs the stage as compute and rasterizes its records. */
+      if (!transform_feedback_emulation && state != NULL &&
+          kk_vertex_stage_runs_as_compute(producer,
+                                          dev->disabled_workarounds)) {
+         transform_feedback_emulation = true;
+         vertex_compute = true;
+         if (KK_DEBUG(VERTEX_COMPUTE))
+            fprintf(stderr, "KosmicKrisp runs the %s stage as compute "
+                            "(KK_WORKAROUND_21)\n",
+                    producer->info.stage == MESA_SHADER_TESS_EVAL
+                       ? "tessellation evaluation"
+                       : "vertex");
+      }
    }
 
    const enum mesa_prim line_raster_prim =
@@ -5690,6 +5752,7 @@ kk_compile_shaders_single(struct vk_device *device, uint32_t shader_count,
 
       if (i == 0 && transform_feedback_emulation) {
          shaders[i]->info.vs.transform_feedback_emulation = true;
+         shaders[i]->info.vs.vertex_compute = vertex_compute;
          shaders[i]->info.vs.transform_feedback = transform_feedback_info;
       }
    }
