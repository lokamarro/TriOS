diff --git a/src/kosmickrisp/vulkan/tests/long_vertex_shaders/store_loop.tese b/src/kosmickrisp/vulkan/tests/long_vertex_shaders/store_loop.tese
new file mode 100644
index 0000000000000000000000000000000000000000..b06804101df83ea0d6afd8c6c4c620b1c756b65e
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/long_vertex_shaders/store_loop.tese
@@ -0,0 +1,28 @@
+#version 450
+/* SPDX-License-Identifier: MIT */
+#extension GL_EXT_buffer_reference : require
+layout(triangles, point_mode) in;
+
+/* The vertex shader's chain, run by the one evaluation at the patch's first
+ * corner. */
+layout(buffer_reference, std430) coherent buffer Words {
+   uint w[];
+};
+
+layout(push_constant) uniform Params {
+   Words words;
+   uint count;
+   uint mask;
+} pc;
+
+void main(void)
+{
+   if (gl_TessCoord.x == 1.0) {
+      for (uint i = 0u; i < pc.count; ++i)
+         pc.words.w[(i + 1u) & pc.mask] = pc.words.w[i & pc.mask] + 1u;
+   }
+   gl_Position = gl_TessCoord.x * gl_in[0].gl_Position +
+                 gl_TessCoord.y * gl_in[1].gl_Position +
+                 gl_TessCoord.z * gl_in[2].gl_Position;
+   gl_PointSize = 1.0;
+}
