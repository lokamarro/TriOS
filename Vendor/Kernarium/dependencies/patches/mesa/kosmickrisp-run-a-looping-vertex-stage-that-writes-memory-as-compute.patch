+#version 450
+/* SPDX-License-Identifier: MIT */
+#extension GL_EXT_buffer_reference : require
+
+/* One invocation runs a chain of dependent device-memory updates for as long
+ * as the push constant asks: each word is one more than the word before it. */
+layout(buffer_reference, std430) coherent buffer Words {
+   uint w[];
+};
+
+layout(push_constant) uniform Params {
+   Words words;
+   uint count;
+   uint mask;
+} pc;
+
+void main(void)
+{
+   if (gl_VertexIndex == 0) {
+      for (uint i = 0u; i < pc.count; ++i)
+         pc.words.w[(i + 1u) & pc.mask] = pc.words.w[i & pc.mask] + 1u;
+   }
+   gl_Position = vec4(0.0, 0.0, 0.0, 1.0);
+   gl_PointSize = 1.0;
+}
