@@ -1170,6 +1175,11 @@ kk_image_plane_bind(struct kk_device *dev, struct kk_image *image,
       }
    }
 
+   plane->validation_registered =
+      kk_device_add_texture_for_validation(dev, plane->mtl_handle);
+   if (plane->validation_registered)
+      kk_device_add_texture_for_validation(dev, plane->mtl_handle_array);
+
    kk_image_plane_report_address_binding(dev, image, plane,
                                          VK_DEVICE_ADDRESS_BINDING_TYPE_BIND_EXT);
    return VK_SUCCESS;
