--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/validated_image_shaders/copy.vert
@@ -0,0 +1,23 @@
+#version 450
+/* SPDX-License-Identifier: MIT */
+
+/* One vertex invocation copies a whole cube map array image texel by texel,
+ * the shape of KHR-GLES31.core.texture_cube_map_array.image_op_vertex_sh. */
+layout(set = 0, binding = 0, rgba32f) uniform readonly imageCubeArray src;
+layout(set = 0, binding = 1, rgba32f) uniform writeonly imageCubeArray dst;
+
+layout(push_constant) uniform Params {
+   ivec4 dim;
+} pc;
+
+void main(void)
+{
+   if (gl_VertexIndex == 0) {
+      for (int x = 0; x < pc.dim.x; ++x)
+         for (int y = 0; y < pc.dim.y; ++y)
+            for (int z = 0; z < pc.dim.z; ++z)
+               imageStore(dst, ivec3(x, y, z), imageLoad(src, ivec3(x, y, z)));
+   }
+   gl_Position = vec4(0.0, 0.0, 0.0, 1.0);
+   gl_PointSize = 1.0;
+}
