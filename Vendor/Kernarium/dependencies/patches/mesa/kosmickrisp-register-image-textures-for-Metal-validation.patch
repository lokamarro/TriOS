diff --git a/src/kosmickrisp/vulkan/tests/test_validated_image_access.cpp b/src/kosmickrisp/vulkan/tests/test_validated_image_access.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..aef49fc64408fdedaedf8a3fce641a557daa7e40
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_validated_image_access.cpp
@@ -0,0 +1,351 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Metal's shader validation checks every texture a command buffer reaches
+ * against the residency sets by itself, not by the heap it is placed in, and
+ * drops the accesses to one it does not find there. The driver registers the
+ * textures of images and views while validation wraps its device. One vertex
+ * invocation here copies a cube map array image texel by texel, as
+ * KHR-GLES31.core.texture_cube_map_array.image_op_vertex_sh does, and every
+ * texel must arrive. The test runs with MTL_SHADER_VALIDATION=1.
+ *
+ * usage: test_kosmickrisp_validated_image_access [--width N] [--cubes N] */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "kk_test.h"
+
+static const uint32_t copy_vert[] =
+#include "validated_image_shaders/copy.vert.h"
+;
+static const uint32_t color_frag[] =
+#include "validated_image_shaders/color.frag.h"
+;
+
+int main(int argc, char **argv)
+{
+   uint32_t width = 8u, cubes = 2u;
+   for (int i = 1; i < argc; ++i) {
+      if (!strcmp(argv[i], "--width") && i + 1 < argc)
+         width = uint32_t(strtoul(argv[++i], nullptr, 0));
+      else if (!strcmp(argv[i], "--cubes") && i + 1 < argc)
+         cubes = uint32_t(strtoul(argv[++i], nullptr, 0));
+      else
+         require(false, "unknown argument");
+   }
+   const uint32_t layers = 6u * cubes;
+   if (!getenv("MTL_SHADER_VALIDATION"))
+      std::printf("note: MTL_SHADER_VALIDATION is not set, so this run "
+                  "checks nothing the driver registers\n");
+
+   kk_test_device t;
+   kk_test_create_instance(&t, "validated-image-access");
+   VkPhysicalDeviceVulkan13Features features13{
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+   features13.dynamicRendering = VK_TRUE;
+   VkPhysicalDeviceFeatures features{};
+   features.vertexPipelineStoresAndAtomics = VK_TRUE;
+   features.imageCubeArray = VK_TRUE;
+   kk_test_create_device(&t, &features13, &features, 0, nullptr);
+   KK_LOAD_DEVICE_FUNCTIONS(t);
+   LOAD_D(vkCreateDescriptorSetLayout);
+   LOAD_D(vkDestroyDescriptorSetLayout);
+   LOAD_D(vkCreateDescriptorPool);
+   LOAD_D(vkDestroyDescriptorPool);
+   LOAD_D(vkAllocateDescriptorSets);
+   LOAD_D(vkUpdateDescriptorSets);
+   LOAD_D(vkCmdBindDescriptorSets);
+   LOAD_D(vkCmdCopyBufferToImage);
+
+   const VkDeviceSize bytes = VkDeviceSize(width) * width * layers * 16u;
+   VkBuffer upload, readback;
+   VkDeviceMemory upload_memory, readback_memory;
+   float *source = nullptr, *result = nullptr;
+   kk_test_buffer(&t, bytes, VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+                  KK_TEST_HOST_MEMORY, &upload, &upload_memory,
+                  reinterpret_cast<void **>(&source));
+   kk_test_buffer(&t, bytes, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
