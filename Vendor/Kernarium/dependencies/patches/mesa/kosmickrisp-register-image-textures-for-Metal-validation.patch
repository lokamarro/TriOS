       result = vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
       goto fail_linked_pipeline_cache;
@@ -610,17 +611,30 @@ kk_device_remove_buffer_from_residency_set(struct kk_device *dev,
    kk_device_remove_from_residency_set(dev, buffer);
 }
 
-void
-kk_device_add_texture_to_residency_set(struct kk_device *dev, mtl_texture *texture)
+/* Apple's residency sets make a heap they hold resident together with every
+ * resource placed in it, so the textures of images and views need no entry
+ * of their own. Metal's API and shader validation check each texture a
+ * command buffer reaches against the sets by itself, though, and shader
+ * validation drops the accesses to one it does not find there. Registering
+ * the textures of an image view costs about 1.4 us over its lifetime on an M1
+ * Ultra, a third of creating and destroying the view, so only a validated
+ * device pays it. */
+bool
+kk_device_add_texture_for_validation(struct kk_device *dev, mtl_texture *texture)
 {
+   if (!dev->residency_set.validated || texture == NULL)
+      return false;
+
    simple_mtx_lock(&dev->residency_set.mutex);
    mtl_residency_set_add_allocation(dev->residency_set.handle, texture);
    simple_mtx_unlock(&dev->residency_set.mutex);
+   return true;
 }
 
+/* Only for a texture kk_device_add_texture_for_validation registered. */
 void
-kk_device_remove_texture_from_residency_set(struct kk_device *dev,
-                                            mtl_texture *texture)
+kk_device_remove_texture_for_validation(struct kk_device *dev,
+                                        mtl_texture *texture)
 {
    kk_device_remove_from_residency_set(dev, texture);
 }
