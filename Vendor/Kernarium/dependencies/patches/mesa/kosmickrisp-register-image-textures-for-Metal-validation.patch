@@ -65,6 +65,47 @@ kk_image_view_metal_type(const struct kk_image *image,
    return type;
 }
 
+/* The handles of a view plane, in the order of its validation_registered
+ * bits. */
+static void
+kk_image_view_plane_handles(struct kk_image_view *view, uint8_t plane,
+                            mtl_texture **handles[6])
+{
+   handles[0] = &view->planes[plane].mtl_handle_sampled;
+   handles[1] = &view->planes[plane].mtl_handle_cube_array;
+   handles[2] = &view->planes[plane].mtl_handle_storage;
+   handles[3] = &view->planes[plane].mtl_handle_input;
+   handles[4] = &view->planes[plane].mtl_handle_render;
+   handles[5] = &view->planes[plane].mtl_handle_subres;
+}
+
+/* Registers the textures the view made itself, not those of its image, which
+ * the image registers, nor one it holds twice. */
+static void
+kk_image_view_register_for_validation(struct kk_device *dev,
+                                      const struct kk_image *image,
+                                      struct kk_image_view *view)
+{
+   if (!dev->residency_set.validated)
+      return;
+
+   for (uint8_t plane = 0; plane < view->plane_count; plane++) {
+      mtl_texture **handles[6];
+      kk_image_view_plane_handles(view, plane, handles);
+      for (unsigned i = 0; i < ARRAY_SIZE(handles); i++) {
+         mtl_texture *texture = *handles[i];
+         bool owned = texture != NULL;
+         for (uint8_t p = 0; owned && p < image->plane_count; p++)
+            owned = texture != image->planes[p].mtl_handle &&
+                    texture != image->planes[p].mtl_handle_array;
+         for (unsigned j = 0; owned && j < i; j++)
+            owned = texture != *handles[j];
+         if (owned && kk_device_add_texture_for_validation(dev, texture))
+            view->planes[plane].validation_registered |= BITFIELD_BIT(i);
+      }
+   }
+}
+
 VkResult
 kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
                    const VkImageViewCreateInfo *pCreateInfo)
@@ -330,6 +371,7 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
       }
    }
 
+   kk_image_view_register_for_validation(dev, image, view);
    return VK_SUCCESS;
 
 fail_no_texture:
@@ -348,6 +390,11 @@ void
 kk_image_view_finish(struct kk_device *dev, struct kk_image_view *view)
 {
    for (uint8_t plane = 0; plane < view->plane_count; plane++) {
+      mtl_texture **handles[6];
+      kk_image_view_plane_handles(view, plane, handles);
+      u_foreach_bit(i, view->planes[plane].validation_registered)
+         kk_device_remove_texture_for_validation(dev, *handles[i]);
+
       if (view->planes[plane].mtl_handle_sampled)
          mtl_release(view->planes[plane].mtl_handle_sampled);
 
