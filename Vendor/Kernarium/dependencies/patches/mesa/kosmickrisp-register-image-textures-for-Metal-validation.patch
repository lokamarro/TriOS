+/* The validation layers hand out a wrapper of the GPU's own device:
+ * MTLDebugDevice for API validation, with or without shader validation
+ * beneath it, and MTLGPUDebugDevice for shader validation alone. */
+bool
+mtl_device_is_validated(mtl_device *dev)
+{
+   @autoreleasepool {
+      NSString *name = NSStringFromClass([(id)dev class]);
+      return [name hasPrefix:@"MTLDebug"] || [name hasPrefix:@"MTLGPUDebug"];
+   }
+}
