From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 26 Sep 2026 22:03:28 +0900
Subject: [PATCH] libbpf: define legacy API names as wrapper functions

Mach-O has no alias attribute. Define btf__get_raw_data,
btf_ext__get_raw_data, libbpf_find_kernel_btf, bpf_map__get_pin_path,
bpf_program__get_type and bpf_program__get_expected_attach_type as wrappers
around their current names, so the library also builds on Darwin hosts.
---
 src/btf.c    | 17 ++++++++++++-----
 src/libbpf.c | 18 ++++++++++++------
 2 files changed, 24 insertions(+), 11 deletions(-)

diff --git a/src/btf.c b/src/btf.c
index 512b3962f75f8c502d4785b3edf0693da9a26ef0..a6b1f2c57003a655a9a45823cf57bd405e6e93e8 100644
--- a/src/btf.c
+++ b/src/btf.c
@@ -1928,8 +1928,10 @@ const void *btf__raw_data(const struct btf *btf_ro, __u32 *size)
 	return data;
 }
 
-__attribute__((alias("btf__raw_data")))
-const void *btf__get_raw_data(const struct btf *btf, __u32 *size);
+const void *btf__get_raw_data(const struct btf *btf, __u32 *size)
+{
+	return btf__raw_data(btf, size);
+}
 
 const char *btf__str_by_offset(const struct btf *btf, __u32 offset)
 {
@@ -4023,8 +4025,10 @@ const void *btf_ext__raw_data(const struct btf_ext *btf_ext, __u32 *size)
 	return data;
 }
 
-__attribute__((alias("btf_ext__raw_data")))
-const void *btf_ext__get_raw_data(const struct btf_ext *btf_ext, __u32 *size);
+const void *btf_ext__get_raw_data(const struct btf_ext *btf_ext, __u32 *size)
+{
+	return btf_ext__raw_data(btf_ext, size);
+}
 
 enum btf_endianness btf_ext__endianness(const struct btf_ext *btf_ext)
 {
@@ -6225,7 +6229,10 @@ struct btf *btf__load_vmlinux_btf(void)
 	return libbpf_err_ptr(-ESRCH);
 }
 
-struct btf *libbpf_find_kernel_btf(void) __attribute__((alias("btf__load_vmlinux_btf")));
+struct btf *libbpf_find_kernel_btf(void)
+{
+	return btf__load_vmlinux_btf();
+}
 
 struct btf *btf__load_module_btf(const char *module_name, struct btf *vmlinux_btf)
 {
diff --git a/src/libbpf.c b/src/libbpf.c
index fdd69aac39bdec6f8aae444b4975e11d9faa66ea..bebab3c0110da996af554b15b90d83206e0eef8c 100644
--- a/src/libbpf.c
+++ b/src/libbpf.c
@@ -9908,8 +9908,10 @@ int bpf_map__set_pin_path(struct bpf_map *map, const char *path)
 	return 0;
 }
 
-__alias(bpf_map__pin_path)
-const char *bpf_map__get_pin_path(const struct bpf_map *map);
+const char *bpf_map__get_pin_path(const struct bpf_map *map)
+{
+	return bpf_map__pin_path(map);
+}
 
 const char *bpf_map__pin_path(const struct bpf_map *map)
 {
@@ -10389,8 +10391,10 @@ int bpf_program__fd(const struct bpf_program *prog)
 	return prog->fd;
 }
 
-__alias(bpf_program__type)
-enum bpf_prog_type bpf_program__get_type(const struct bpf_program *prog);
+enum bpf_prog_type bpf_program__get_type(const struct bpf_program *prog)
+{
+	return bpf_program__type(prog);
+}
 
 enum bpf_prog_type bpf_program__type(const struct bpf_program *prog)
 {
@@ -10425,8 +10429,10 @@ int bpf_program__set_type(struct bpf_program *prog, enum bpf_prog_type type)
 	return 0;
 }
 
-__alias(bpf_program__expected_attach_type)
-enum bpf_attach_type bpf_program__get_expected_attach_type(const struct bpf_program *prog);
+enum bpf_attach_type bpf_program__get_expected_attach_type(const struct bpf_program *prog)
+{
+	return bpf_program__expected_attach_type(prog);
+}
 
 enum bpf_attach_type bpf_program__expected_attach_type(const struct bpf_program *prog)
 {
