From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 26 Sep 2026 22:04:07 +0900
Subject: [PATCH] Build the dwarves library and pahole on Darwin

<malloc.h> is a glibc header; the library files that pahole links and that
included it need only the <stdlib.h> declarations. BSD C libraries,
including Darwin's, declare an extern fls() in <strings.h>, which conflicts
with the static helper of the same name in dutil.h, so the helper is now
dwarves__fls().

The argp version-hook definition names its symbol with an assembler label.
Prefix it with __USER_LABEL_PREFIX__, so on Mach-O, where C symbols start
with an underscore, the definition still replaces argp's and --version
remains available.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 btf_loader.c |  1 -
 ctf_loader.c |  1 -
 dutil.h      | 26 ++++++++++++++++----------
 elf_symtab.c |  2 +-
 libctf.c     |  1 -
 5 files changed, 17 insertions(+), 14 deletions(-)

diff --git a/btf_loader.c b/btf_loader.c
index 66ffd1a0b5ad73a3f2c8f0e9409c094a1aa32b4e..0a3f9f3fdabd9cf2c5ac66b3f6ce86b512547787 100644
--- a/btf_loader.c
+++ b/btf_loader.c
@@ -16,7 +16,6 @@
 #include <unistd.h>
 #include <stdlib.h>
 #include <stddef.h>
-#include <malloc.h>
 #include <string.h>
 #include <limits.h>
 #include <libgen.h>
diff --git a/ctf_loader.c b/ctf_loader.c
index 39aef17893da5314b637a93fe156e12e9c80bf9b..680bce15ee714897bdfe405e9573f72bee1ec5b3 100644
--- a/ctf_loader.c
+++ b/ctf_loader.c
@@ -11,7 +11,6 @@
 #include <unistd.h>
 #include <stdlib.h>
 #include <stddef.h>
-#include <malloc.h>
 #include <string.h>
 #include <limits.h>
 #include <libgen.h>
diff --git a/dutil.h b/dutil.h
index 603556fa03085abf163d10fb4f1f4a2dac7466a3..890cf19de9e44205d1125c516012abbbe612afd6 100644
--- a/dutil.h
+++ b/dutil.h
@@ -52,13 +52,14 @@ static inline __attribute__((const)) bool is_power_of_2(unsigned long n)
 }
 
 /**
- * fls - find last (most-significant) bit set
+ * dwarves__fls - find last (most-significant) bit set
  * @x: the word to search
  *
- * This is defined the same way as ffs.
- * Note fls(0) = 0, fls(1) = 1, fls(0x80000000) = 32.
+ * This is defined the same way as ffs. It is not named fls because BSD C
+ * libraries, including Darwin's, declare an extern fls in <strings.h>.
+ * Note dwarves__fls(0) = 0, dwarves__fls(1) = 1, dwarves__fls(0x80000000) = 32.
  */
-static __always_inline int fls(int x)
+static __always_inline int dwarves__fls(int x)
 {
 	return x ? sizeof(x) * 8 - __builtin_clz(x) : 0;
 }
@@ -79,8 +80,8 @@ static __always_inline int fls64(uint64_t x)
 {
 	uint32_t h = x >> 32;
 	if (h)
-		return fls(h) + 32;
-	return fls(x);
+		return dwarves__fls(h) + 32;
+	return dwarves__fls(x);
 }
 #elif BITS_PER_LONG == 64
 /**
@@ -133,7 +134,7 @@ static __always_inline int fls64(uint64_t x)
 static inline unsigned fls_long(unsigned long l)
 {
 	if (sizeof(l) == 4)
-		return fls(l);
+		return dwarves__fls(l);
 	return fls64(l);
 }
 
@@ -149,13 +150,13 @@ unsigned long __roundup_pow_of_two(unsigned long n)
 /*
  * non-constant log of base 2 calculators
  * - the arch may override these in asm/bitops.h if they can be implemented
- *   more efficiently than using fls() and fls64()
+ *   more efficiently than using dwarves__fls() and fls64()
  * - the arch is not required to handle n==0 if implementing the fallback
  */
 static inline __attribute__((const))
 int __ilog2_u32(uint32_t n)
 {
-	return fls(n) - 1;
+	return dwarves__fls(n) - 1;
 }
 
 static inline __attribute__((const))
@@ -277,9 +278,14 @@ int ____ilog2_NaN(void);
    variables as non-const (which is correct in general).  But we can
    do better, it is not going to change.  So we want to move them into
    the .rodata section.  Define macros to do the trick.  */
+/* An assembler name must carry the platform's C symbol prefix, such as the
+   leading underscore of Mach-O, to override argp's own definition.  */
+#define ARGP_ASM_NAME__(prefix, name) #prefix name
+#define ARGP_ASM_NAME_(prefix, name) ARGP_ASM_NAME__(prefix, name)
+#define ARGP_ASM_NAME(name) ARGP_ASM_NAME_(__USER_LABEL_PREFIX__, name)
 #define ARGP_PROGRAM_VERSION_HOOK_DEF \
 	void (*const apvh) (FILE *, struct argp_state *) \
-	__asm ("argp_program_version_hook")
+	__asm (ARGP_ASM_NAME("argp_program_version_hook"))
 #define ARGP_PROGRAM_BUG_ADDRESS_DEF \
 	const char *const apba__ __asm ("argp_program_bug_address")
 
