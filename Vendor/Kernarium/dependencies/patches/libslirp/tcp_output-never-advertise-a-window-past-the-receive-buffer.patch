From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 29 Sep 2026 12:44:11 +0900
Subject: [PATCH] tcp_output: never advertise a window past the receive buffer

tcp_output() widened rcv_adv - rcv_nxt, an unsigned sequence
difference, to long when it kept the window from shrinking and when it
weighed a window update. The peer can legitimately move rcv_nxt past
rcv_adv: a FIN sent at a closed window is accepted, and so is a
one-octet window probe once space has opened without a window update.
On LP64 hosts the difference then becomes nearly 4 GiB, so libslirp
advertises a 64 KiB window over a full buffer, never moves rcv_adv
again, and advertises that wrong window for the rest of the
connection.

Treat an edge the peer has passed as a known window of zero, as
FreeBSD does.
---
 src/tcp_output.c | 20 +++++++++++++++++---
 1 file changed, 17 insertions(+), 3 deletions(-)

diff --git a/src/tcp_output.c b/src/tcp_output.c
index 77c1204a53fdcfd60784f5cb1e34f0c7bc37d51a..632d7d9900a8996ef7c08ccb53f4ec6ac2e00673 100644
--- a/src/tcp_output.c
+++ b/src/tcp_output.c
@@ -48,6 +48,20 @@ static const uint8_t tcp_outflags[TCP_NSTATES] = {
 #undef MAX_TCPOPTLEN
 #define MAX_TCPOPTLEN 32 /* max # bytes that go in options */
 
+/*
+ * The receive window the peer already knows: from rcv_nxt to rcv_adv, the
+ * right edge last advertised. The peer can move rcv_nxt past that edge, with
+ * a FIN at a closed window or a one-octet probe accepted into space that
+ * opened without a window update; it then knows no window at all. The
+ * unsigned sequence difference must not be widened to long, which on LP64
+ * turns a passed edge into a window of nearly 4 GiB.
+ */
+static long tcp_known_window(const struct tcpcb *tp)
+{
+    return SEQ_GT(tp->rcv_adv, tp->rcv_nxt) ? (long)(tp->rcv_adv - tp->rcv_nxt)
+                                            : 0;
+}
+
 /*
  * Tcp output routine: figure out what should be sent and send it.
  */
@@ -190,7 +204,7 @@ again:
          * TCP_MAXWIN << tp->rcv_scale.
          */
         long adv = MIN(win, (long)TCP_MAXWIN << tp->rcv_scale) -
-                   (tp->rcv_adv - tp->rcv_nxt);
+                   tcp_known_window(tp);
 
         if (adv >= (long)(2 * tp->t_maxseg))
             goto send;
@@ -362,8 +376,8 @@ send:
         win = 0;
     if (win > (long)TCP_MAXWIN << tp->rcv_scale)
         win = (long)TCP_MAXWIN << tp->rcv_scale;
-    if (win < (long)(tp->rcv_adv - tp->rcv_nxt))
-        win = (long)(tp->rcv_adv - tp->rcv_nxt);
+    if (win < tcp_known_window(tp))
+        win = tcp_known_window(tp);
     ti->ti_win = htons((uint16_t)(win >> tp->rcv_scale));
 
     if (SEQ_GT(tp->snd_up, tp->snd_una)) {
