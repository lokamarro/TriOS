From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 13 Aug 2026 00:30:00 +0900
Subject: [PATCH] ios: avoid unavailable process APIs

The iOS Simulator SDK exposes linkable compatibility symbols for pipe2 and
_NSGetEnviron even though neither API is available to an iOS application.
Do not let link-only feature probes select them for an iOS subsystem.  macOS
keeps its existing behavior.
---
 meson.build | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/meson.build b/meson.build
index efa7e89354ae45a1279068f1934efb8b38486d64..0836fe2214298527e550773b0eb851cc635ddab6 100644
--- a/meson.build
+++ b/meson.build
@@ -748,7 +748,6 @@ functions = [
   'memmem',
   'mmap',
   'newlocale',
-  'pipe2',
   'poll',
   'prlimit',
   'readlink',
@@ -777,9 +776,15 @@ functions = [
   'sysctlbyname',
 ]
 
+# The iOS SDK exposes a linkable pipe2 compatibility symbol without declaring
+# the API for applications.  Use the portable pipe/fcntl path on iOS.
+if not subsystem.startswith('ios')
+  functions += ['pipe2']
+endif
+
 # _NSGetEnviron is available on iOS too, but its usage gets apps rejected from
 # the app store since it's considered 'private API'
-if host_system == 'darwin'
+if host_system == 'darwin' and subsystem == 'macos'
   functions += ['_NSGetEnviron']
 endif
 
