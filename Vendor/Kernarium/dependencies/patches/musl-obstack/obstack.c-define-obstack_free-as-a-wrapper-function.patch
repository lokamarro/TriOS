From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 26 Sep 2026 22:03:13 +0900
Subject: [PATCH] obstack.c: define obstack_free as a wrapper function

The alias attribute is unavailable on Mach-O. A wrapper provides the same
function for callers that #undef the obstack_free macro or take its address.
---
 obstack.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/obstack.c b/obstack.c
index 1f2f4c70cbef8b48a9c7edbefc578ddfed09c3e9..bbf9e22ba28f170e934ddcc0b83fc47d81b43d72 100644
--- a/obstack.c
+++ b/obstack.c
@@ -294,7 +294,17 @@ _obstack_free (struct obstack *h, void *obj)
     abort ();
 }
 
-extern __typeof(_obstack_free) obstack_free __attribute__((alias("_obstack_free")));
+/* Callers that #undef the obstack_free macro, or take its address, need a
+   real function. A wrapper also links where the object format has no symbol
+   aliases, such as Mach-O.  */
+#undef obstack_free
+extern void obstack_free (struct obstack *h, void *obj);
+
+void
+obstack_free (struct obstack *h, void *obj)
+{
+  _obstack_free (h, obj);
+}
 
 _OBSTACK_SIZE_T
 _obstack_memory_used (struct obstack *h)
