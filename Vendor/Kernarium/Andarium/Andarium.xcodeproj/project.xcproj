{
  "default-configuration": "Release",
  "configurations": [
    { "name": "AppStore", "file": "Config/Signing.xcconfig" },
    { "name": "Debug", "file": "Config/Signing.xcconfig" },
    { "name": "Release", "file": "Config/Signing.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "AndariumCore",
    }, {
      "kind": "local",
      "path": "../GuestHost/Core",
    },
  ],
  "files": [
    { "kind": "folder", "path": "Andarium/Shared", "target-membership": [ "Andarium", "AndariumPreview" ] },
    { "kind": "folder", "path": "Andarium/Preview", "target-membership": [ "AndariumPreview" ] },
    { "kind": "folder", "path": "Andarium/Live", "target-membership": [ "Andarium" ] },
    { "kind": "folder", "path": "../GuestHost/Sources", "target-membership": [ "Andarium" ] },
    { "kind": "folder", "path": "AndariumTests", "target-membership": [ "AndariumTests" ] },
    {
      "kind": "group",
      "path": "Config",
      "children": [
        { "path": "Andarium.entitlements" },
        { "path": "Andarium-Bridging-Header.h" },
        { "path": "Info.plist" },
        { "path": "PrivacyInfo.xcprivacy", "target-membership": [ "Andarium/resources" ] },
        { "path": "../../GuestHost/Config/Signing.xcconfig" },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "../.build/kernarium-xcframeworks/KRuntime_Android_6_18_4K.xcframework", "target-membership": [ { "build-phase": "Andarium/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "../.build/kernarium-xcframeworks/MesaEGL.xcframework", "target-membership": [ { "build-phase": "Andarium/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "../.build/kernarium-xcframeworks/MesaGallium.xcframework", "target-membership": [ { "build-phase": "Andarium/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "../.build/kernarium-xcframeworks/KosmicKrisp.xcframework" },
        { "path": "../.build/kernarium-xcframeworks/LibZstd.xcframework", "target-membership": [ "Andarium/frameworks" ] },
      ],
    },
    { "path": "../.build/andarium-system", "target-membership": [ "Andarium/resources" ] },
    { "path": "AndariumCore" },
    { "path": "../GuestHost/Core" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Andarium.app", "id": "2B57E994CA98B64648047DE5", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/AndariumPreview.app", "id": "F7B7BE3141FE6623A0E4497E", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/AndariumTests.xctest", "id": "AE75CA0B879FBA6ECC773C6A", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Andarium",
      "id": "A10000000000000000000007",
      "product": "Products/Andarium.app",
      "product-type": "application",
      "build-phases": [
        {
          "kind": "script",
          "name": "Check Mac run location",
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "/usr/bin/env python3 -B \"$SRCROOT/../scripts/check-run-location.py\"\n",
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "script",
          "name": "Embed KosmicKrisp (device only)",
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "\"$SRCROOT/../Kernarium/scripts/embed-device-framework.sh\" \"$SRCROOT/../.build/kernarium-xcframeworks/KosmicKrisp.xcframework\"\n",
        }, {
          "kind": "script",
          "name": "Check embedded artifacts",
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "[ \"$CONFIGURATION\" = AppStore ] || exit 0",
            "/usr/bin/env python3 -B \"$SRCROOT/../scripts/check-embedded-artifacts.py\" --app \"$TARGET_BUILD_DIR/$WRAPPER_NAME\" --android-release --kernel android",
            "",
          ],
        }, {
          "kind": "script",
          "name": "Check App Store bundle",
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "[ \"$CONFIGURATION\" = AppStore ] || exit 0",
            "/usr/bin/env python3 -B \"$SRCROOT/scripts/check-app-store-bundle.py\" \"$TARGET_BUILD_DIR/$WRAPPER_NAME\"",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "product-name": "AndariumCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "GuestHostCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "DuskJade",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Config/Andarium.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "5",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "FRAMEWORK_SEARCH_PATHS": [
          "$(inherited)",
          "$(SRCROOT)/../.build/kernarium-xcframeworks",
        ],
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Andarium",
        "INFOPLIST_KEY_NSLocalNetworkUsageDescription": "Apps running in Andarium use this to connect to devices on your local network, such as printers, media servers and computers, and ADB over network uses it to let a computer on your network connect to Andarium. Internet access doesn't need it.",
        "INFOPLIST_KEY_NSMicrophoneUsageDescription": "Andarium records from the microphone only when you turn on Microphone, so that apps in the guest can use it.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "NO",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.imxieyi.andarium",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD[config=AppStore]": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD[config=Debug]": "YES",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD[config=Release]": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_OBJC_BRIDGING_HEADER": "Config/Andarium-Bridging-Header.h",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "AndariumTests",
      "id": "A10000000000000000000008",
      "product": "Products/AndariumTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Andarium",
      "dependencies": [
        "Andarium",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "AndariumCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "GuestHostCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "FRAMEWORK_SEARCH_PATHS": [
          "$(inherited)",
          "$(SRCROOT)/../.build/kernarium-xcframeworks",
        ],
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_NSPrincipalClass": "AndariumTestBundle",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.imxieyi.AndariumTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_OBJC_BRIDGING_HEADER": "AndariumTests/AndariumTests-Bridging-Header.h",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Andarium.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Andarium",
      },
    }, {
      "name": "AndariumPreview",
      "id": "A10000000000000000000006",
      "product": "Products/AndariumPreview.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "AndariumCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "GuestHostCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "DuskJade",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Andarium",
        "INFOPLIST_KEY_NSMicrophoneUsageDescription": "The Simulator preview asks for the microphone only when launched with -systemMicrophone YES, to show the permission flow.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "NO",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.imxieyi.AndariumPreview",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SUPPORTED_PLATFORMS": "iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=AppStore]": "dwarf-with-dsym",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_NS_ASSERTIONS[config=AppStore]": "NO",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "x86_64",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=AppStore]": [
      "UML_APP_STORE_APPLICATION=1",
      "$(inherited)",
    ],
    "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "iphoneos",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=AppStore]": "APP_STORE $(inherited)",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=AppStore]": "wholemodule",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "VALIDATE_PRODUCT[config=AppStore]": "YES",
    "VALIDATE_PRODUCT[config=Release]": "YES",
  },
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
