#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
set -eu
export PATH="${PATH}:/usr/games"
if [ -f /usr/share/uml-vulkan/guest-runtime.json ]; then
    export MESA_LOADER_DRIVER_OVERRIDE=zink
    export GALLIUM_DRIVER=zink
fi
# Chromium's only hardware video decode path on Linux is VA-API, and this
# image's backend for it is the Virtio video stateful decoder. Announce it only
# when both halves are present, because the client's own option must not be
# given when the decode attempt can only fail.
if [ -e /usr/lib/x86_64-linux-gnu/dri/uml_drv_video.so ] && [ -e /dev/video-dec0 ]; then
    export LIBVA_DRIVER_NAME=uml
    export LIBVA_DRIVERS_PATH=/usr/lib/x86_64-linux-gnu/dri
    export KERNARIUM_CEF_VAAPI=1
fi
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=gamescope
export XDG_SESSION_DESKTOP=gamescope
export STEAM_COMPAT_CLIENT_INSTALL_PATH="$HOME/.local/share/Steam"
exec dbus-run-session -- /usr/games/gamescope -e -- python3 -B /usr/local/libexec/kernarium-steam.py
