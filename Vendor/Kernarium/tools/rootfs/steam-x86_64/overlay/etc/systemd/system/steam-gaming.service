[Unit]
Description=Steam gaming session
After=systemd-user-sessions.service network.target kernarium-splash-stop.service
Wants=network.target
Requires=kernarium-splash-stop.service
RequiresMountsFor=/home/uml /var
Conflicts=getty@tty1.service

[Service]
User=uml
PAMName=login
# A TTY-owning PAM service is handed an ambient capability the session never
# needs, and bubblewrap refuses to build the Steam runtime container when the
# process it starts from holds capabilities without being setuid. The gaming
# session requires none, so the bounding set is emptied.
CapabilityBoundingSet=
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/home/uml
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStart=/usr/local/bin/steam-gaming-session
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
