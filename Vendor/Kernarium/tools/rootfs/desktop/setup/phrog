#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Desktop policy the Phrog source image (Debian with Phosh, greeted by greetd
# and Phrog) does not carry itself. The desktop image derivation runs it once
# in the extracted image. ../../README.md owns the contract.
set -eu

fail()
{
	echo "phrog setup: $*" >&2
	exit 1
}

[ -x /usr/bin/phosh-session ] || fail "the image has no Phosh session"
getent passwd _greetd >/dev/null || fail "the image has no greetd user"
user=$(getent passwd 1000 | cut -d: -f1)
[ -n "$user" ] || fail "the image has no user 1000"
usermod -a -G video,render,input "$user"

# Discard the image's fixed 720x1440 Virtual-1 override for both the Phrog
# greeter and the logged-in Phosh session. Phoc then uses the preferred
# physical-pixel mode and effective density from the Virtio-GPU EDID
# throughout.
install -d -m 0755 /etc/phrog /etc/phosh
for configuration in /etc/phrog/phoc.ini /etc/phosh/phoc.ini; do
	rm -f "$configuration"
	: > "$configuration"
	chmod 0644 "$configuration"
done

# The image owns its VT and serial getties and their login policy. It also
# enables the development phosh.service beside its display-manager alias,
# and the two are mutually exclusive; drop only that stale enablement, so
# graphical.target follows the stock display-manager -> greetd -> Phrog path.
rm -f /etc/systemd/system/graphical.target.wants/phosh.service
