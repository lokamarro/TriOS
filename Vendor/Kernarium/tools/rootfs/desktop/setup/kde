#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Desktop policy the unified KDE image (rootfs.erofs, or an ext4 derivative
# sealed from it) does not carry itself. The desktop image derivation runs it
# once in the extracted image to bake it in; for an image without it, the
# macOS KDE launcher installs this file as a payload and runs it as root on
# the disposable overlay before the display manager starts. ../../README.md
# owns the contract.
set -eu

getent passwd uml >/dev/null
usermod -a -G video,render,input uml
# /dev/tty0 is the active-VT alias, while tty1 is the VT SDDM initially claims
# before starting the Wayland session. A getty on either device can cancel
# display-manager activation or follow the compositor onto its VT. The
# attachable ttyS0 socket remains the interactive recovery console. On a
# running system the gettys also stop now; systemctl refuses --now in the
# chroot of an image derivation, where nothing runs.
if [ -d /run/systemd/system ]; then
    systemctl mask --now getty@tty0.service getty@tty1.service
else
    systemctl mask getty@tty0.service getty@tty1.service
fi

# install -d gives the requested owner only to the directories it names, so
# every parent below the home directory is named before its children. SDDM
# redirects the Wayland session's stderr into .local/share/sddm; without it
# the session runs with a broken stderr and loses every bring-up failure.
install -d -m 0755 -o uml -g uml \
    /home/uml/Desktop /home/uml/Documents /home/uml/Downloads \
    /home/uml/Music /home/uml/Pictures /home/uml/Public \
    /home/uml/Templates /home/uml/Videos /home/uml/.config \
    /home/uml/.local /home/uml/.local/share /home/uml/.local/share/Trash \
    /home/uml/.local/share/pki \
    /home/uml/.local/share/Trash/files \
    /home/uml/.local/share/Trash/info \
    /home/uml/.local/share/sddm
printf '%s\n' \
    'XDG_DESKTOP_DIR="$HOME/Desktop"' \
    'XDG_DOWNLOAD_DIR="$HOME/Downloads"' \
    'XDG_TEMPLATES_DIR="$HOME/Templates"' \
    'XDG_PUBLICSHARE_DIR="$HOME/Public"' \
    'XDG_DOCUMENTS_DIR="$HOME/Documents"' \
    'XDG_MUSIC_DIR="$HOME/Music"' \
    'XDG_PICTURES_DIR="$HOME/Pictures"' \
    'XDG_VIDEOS_DIR="$HOME/Videos"' \
    > /home/uml/.config/user-dirs.dirs
chown uml:uml /home/uml/.config/user-dirs.dirs

# KInfoCenter 6.3 counts Mesa's CPU-only Lavapipe Vulkan device as the guest
# GPU and labels an otherwise accelerated Virgl session "llvmpipe". Without
# that ICD it uses its OpenGL probe, which reports the renderer KWin and
# applications use.
rm -f /usr/share/vulkan/icd.d/lvp_icd.json

# The desktop:/ KIO worker crashes under UML. Keep Plasma's normal Folder View
# containment, but point it at the user's Desktop directory so it uses the
# stable local-file worker instead.
sed -i \
    's#<default>desktop:/</default>#<default>file:///home/uml/Desktop</default>#' \
    /usr/share/plasma/plasmoids/org.kde.desktopcontainment/contents/config/main.xml

install -d -m 0755 /etc/sddm.conf.d
printf '%s\n' '[Autologin]' 'User=uml' 'Session=plasma' 'Relogin=false' \
    > /etc/sddm.conf.d/uml-autologin.conf

# A benchmark must stay visible and continuously rendered after its warm-up,
# so the idle lock never replaces a long measurement with the lock screen.
printf '%s\n' '[Daemon]' 'Autolock=false' 'LockOnResume=false' 'Timeout=0' \
    > /home/uml/.config/kscreenlockerrc
chown uml:uml /home/uml/.config/kscreenlockerrc
