# The base archive never boots a guest by itself. Every launcher appends a
# per-run archive whose /init replaces this file, so reaching it means that
# archive is missing or could not be unpacked. Stop here, loudly, rather than
# guess at a root device: exiting PID 1 panics the kernel.
echo "UML_BOOT_BASE_ERROR:no per-run /init followed the base archive"
exit 1
