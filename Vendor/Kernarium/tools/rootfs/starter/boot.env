# Per-run boot parameters for a starter disk attached as ubd0: mount its sole
# ext4 partition read-write as the root, grow it first when a host tool has
# enlarged the disk, and enter the image's own init.
UML_BOOT_ROOT=/dev/ubda1
UML_BOOT_ROOT_TYPE=ext4
UML_BOOT_UPPER=none
UML_BOOT_GROW=1
