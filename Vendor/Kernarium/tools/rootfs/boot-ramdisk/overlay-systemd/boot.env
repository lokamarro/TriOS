# Boot parameters of tools/boot-overlay-systemd.sh: the EROFS image attached
# as ubd0 read-only beneath a tmpfs overlay, then the harness session.
UML_BOOT_ROOT=/dev/ubda
UML_BOOT_ROOT_TYPE=erofs
UML_BOOT_UPPER=tmpfs
UML_BOOT_ENTRY=/usr/local/libexec/uml-session
