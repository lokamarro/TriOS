+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+
+import contextlib
+import io
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import vn_protocol
+
+
+class ExplicitVulkanInputs(unittest.TestCase):
+    def test_registry_and_build_output_are_required(self):
+        for arguments in ([], ['--outdir', '/tmp'], ['--registry', '/tmp/vk.xml']):
+            with self.subTest(arguments=arguments), contextlib.redirect_stderr(io.StringIO()):
+                with self.assertRaises(SystemExit):
+                    vn_protocol.get_args(arguments)
+
+    def test_registry_must_exist_and_not_use_an_implicit_relative_path(self):
+        for registry in ('xmls/vk.xml', '/nonexistent-vulkan-registry/vk.xml'):
+            with self.subTest(registry=registry), contextlib.redirect_stderr(io.StringIO()):
+                with self.assertRaises(SystemExit):
+                    vn_protocol.get_args(['--outdir', '/tmp', '--registry', registry])
+
+    def test_generation_uses_only_the_explicit_registry(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            build = Path(temporary).resolve()
+            registry = build / 'selected-vk.xml'
+            registry.write_text('<registry/>')
+            args = vn_protocol.get_args(['--outdir', str(build), '--registry', str(registry)])
+            with patch.object(vn_protocol, 'get_args', return_value=args), \
+                    patch.object(vn_protocol.VkRegistry, 'parse', side_effect=RuntimeError('stop')) as parse:
+                with self.assertRaisesRegex(RuntimeError, 'stop'):
+                    vn_protocol.main()
+                _, private_xmls = vn_protocol.get_vk_xmls(args.srcdir)
+                parse.assert_called_once_with(registry, private_xmls)
+
+    def test_source_root_is_not_a_generated_output_directory(self):
+        registry = vn_protocol.VN_PROTOCOL_DIR / 'xmls/vk.xml'
+        with contextlib.redirect_stderr(io.StringIO()), self.assertRaises(SystemExit):
+            vn_protocol.get_args(['--outdir', str(vn_protocol.VN_PROTOCOL_DIR),
+                                  '--registry', str(registry)])
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/vkxml.py b/vkxml.py
index b3f22c1a890a62f28b72c65b88aac8d058e937a8..aaa1b39120974d57541983582d3d554f48f34825 100644
--- a/vkxml.py
+++ b/vkxml.py
@@ -1042,10 +1042,25 @@ class VkRegistry:
 
     def _parse_types(self, types_elem):
         """Parse <types>."""
-        types_elem[:] = sorted(
-            types_elem, key=lambda type_elem: 'alias' in type_elem.attrib, reverse=True
-        )
-        for type_elem in types_elem.iterfind('type'):
+        types = list(types_elem.iterfind('type'))
+        # A promoted alias can be referenced by an earlier structure, before
+        # either the alias or its canonical type is defined in the registry,
+        # and an alias can name another alias.  Resolving aliases in
+        # dependency order rather than merely before the other types keeps a
+        # pointer or array type pointing at the canonical object instead of a
+        # separate, never-initialized forward declaration.
+        aliases = {elem.attrib['name']: elem for elem in types
+                   if 'alias' in elem.attrib}
+        while aliases:
+            ready = [name for name, elem in aliases.items()
+                     if elem.attrib['alias'] not in aliases]
+            if not ready:
+                raise ValueError('cyclic Vulkan type aliases')
+            for name in ready:
+                VkType._parse_alias(aliases.pop(name), self.type_table)
+        for type_elem in types:
+            if 'alias' in type_elem.attrib:
+                continue
             VkType.parse_type(type_elem, self.type_table)
 
     def _parse_enums(self, enums_elem):
