diff --git a/tests/test_vkxml.py b/tests/test_vkxml.py
new file mode 100644
index 0000000000000000000000000000000000000000..f1bdf769111db32fd49ec5dbff7ffbbc85374561
--- /dev/null
+++ b/tests/test_vkxml.py
@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+
+from pathlib import Path
+import hashlib
+import sys
+import unittest
+import xml.etree.ElementTree as ET
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from vkxml import VkRegistry, VkType
+
+
+class RegistryAliases(unittest.TestCase):
+    def parse(self, text):
+        registry = VkRegistry()
+        registry._parse_types(ET.fromstring(text))
+        return registry.type_table
+
+    def test_forward_alias_keeps_canonical_pointer_and_value_types(self):
+        types = self.parse('''<types>
+          <type category="struct" name="VkContainer">
+            <member><type>VkRangeEXT</type><name>range</name></member>
+            <member>const <type>VkRangeEXT</type>*<name>pRange</name></member>
+          </type>
+          <type category="struct" name="VkRangeKHR">
+            <member><type>uint64_t</type><name>address</name></member>
+          </type>
+          <type category="struct" name="VkRangeEXT" alias="VkRangeKHR"/>
+        </types>''')
+        canonical = types['VkRangeKHR']
+        self.assertIs(types['VkRangeEXT'], canonical)
+        self.assertEqual(canonical.category, VkType.STRUCT)
+        self.assertEqual(canonical.aliases, ['VkRangeEXT'])
+        for member in types['VkContainer'].variables:
+            self.assertIs(member.ty.base, canonical)
+
+    def test_alias_chain_is_independent_of_definition_order(self):
+        types = self.parse('''<types>
+          <type category="struct" name="VkAliasA" alias="VkAliasB"/>
+          <type category="struct" name="VkCanonical">
+            <member><type>uint64_t</type><name>address</name></member>
+          </type>
+          <type category="struct" name="VkAliasB" alias="VkCanonical"/>
+        </types>''')
+        self.assertIs(types['VkAliasA'], types['VkCanonical'])
+        self.assertIs(types['VkAliasB'], types['VkCanonical'])
+
+    def test_alias_cycle_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, 'cyclic'):
+            self.parse('''<types>
+              <type category="struct" name="VkAliasA" alias="VkAliasB"/>
+              <type category="struct" name="VkAliasB" alias="VkAliasA"/>
+            </types>''')
+
+
+class CommandIdentity(unittest.TestCase):
+    def test_existing_command_ids_and_aliases_are_unchanged(self):
+        source = Path(__file__).resolve().parents[1]
+        registry = ET.parse(source / 'xmls/VK_EXT_command_serialization.xml')
+        commands = {elem.attrib['name']: elem.attrib for elem in
+                    registry.findall('.//enums[@name="VkCommandTypeEXT"]/enum')}
+
+        def value(name, seen=()):
+            self.assertNotIn(name, seen)
+            command = commands[name]
+            if 'value' in command:
+                return int(command['value'], 0)
+            return value(command['alias'], (*seen, name))
+
+        # The existing 70991d4 command space is immutable. Extensions append
+        # new IDs; neither canonical IDs nor old aliases may change on wire.
+        old = [name for name in sorted(commands) if value(name) <= 345]
+        self.assertEqual(len(old), 448)
+        canonical = ''.join(name + '=' + commands[name].get(
+            'value', commands[name].get('alias', '')) + '\n' for name in old)
+        self.assertEqual(hashlib.sha256(canonical.encode()).hexdigest(),
+                         '199c9f7f53ab1c84b506f6619baed96d878a0659eef0cd7eeeba3f4fefb56a07')
+        identifiers = [value(name) for name, command in commands.items()
+                       if 'value' in command]
+        self.assertEqual(len(identifiers), len(set(identifiers)))
+
+
+if __name__ == '__main__':
+    unittest.main()
