  * SPDX-License-Identifier: MIT
  */
 
-int main(int argc, char **argv)
+#include <stdio.h>
+
+#include "test_stream.h"
+
+#define CHECK(cond) do { \
+    if (!(cond)) { \
+        fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #cond); \
+        return false; \
+    } \
+} while (0)
+
+static bool
+test_memory_barriers(bool with_flags3, bool with_ranges)
+{
+    const VkMemoryBarrierAccessFlags3KHR flags3 = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_ACCESS_FLAGS_3_KHR,
+        .srcAccessMask3 = VK_ACCESS_3_NONE_KHR,
+        .dstAccessMask3 = VK_ACCESS_3_NONE_KHR,
+    };
+    VkMemoryBarrier2 barriers[3];
+    for (unsigned i = 0; i < 3; i++) {
+        barriers[i] = (VkMemoryBarrier2) {
+            .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2,
+            .pNext = with_flags3 && i != 1 ? &flags3 : NULL,
+            .srcStageMask = VK_PIPELINE_STAGE_2_COPY_BIT,
+            .srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT,
+            .dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
+            .dstAccessMask = i == 1 ? VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT :
+                                    VK_ACCESS_2_SHADER_STORAGE_READ_BIT,
+        };
+    }
+    const VkMemoryRangeBarrierKHR range = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_RANGE_BARRIER_KHR,
+        .srcStageMask = VK_PIPELINE_STAGE_2_COPY_BIT,
+        .srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT,
+        .dstStageMask = VK_PIPELINE_STAGE_2_HOST_BIT,
+        .dstAccessMask = VK_ACCESS_2_HOST_READ_BIT,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .addressRange = { .address = UINT64_C(0x12345678000), .size = 4096 },
+    };
+    const VkMemoryRangeBarriersInfoKHR ranges = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_RANGE_BARRIERS_INFO_KHR,
+        .memoryRangeBarrierCount = 1,
+        .pMemoryRangeBarriers = &range,
+    };
+    const VkDependencyInfo input = {
+        .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+        .pNext = with_ranges ? &ranges : NULL,
+        .memoryBarrierCount = 3,
+        .pMemoryBarriers = barriers,
+    };
+    struct vn_test_stream stream;
+    struct vn_test_decoder storage;
+    VkDependencyInfo output;
+    CHECK(vn_test_encode_dependency(&input, &stream));
+    CHECK(vn_test_decode_dependency(&stream, &storage, &output));
+    CHECK(output.sType == input.sType);
+    CHECK(output.dependencyFlags == input.dependencyFlags);
+    CHECK(output.memoryBarrierCount == 3 && output.pMemoryBarriers);
+    CHECK(output.bufferMemoryBarrierCount == 0 && !output.pBufferMemoryBarriers);
+    CHECK(output.imageMemoryBarrierCount == 0 && !output.pImageMemoryBarriers);
+    for (unsigned i = 0; i < 3; i++) {
+        const VkMemoryBarrier2 *barrier = &output.pMemoryBarriers[i];
+        CHECK(barrier->sType == barriers[i].sType);
+        CHECK(barrier->srcStageMask == barriers[i].srcStageMask);
+        CHECK(barrier->srcAccessMask == barriers[i].srcAccessMask);
+        CHECK(barrier->dstStageMask == barriers[i].dstStageMask);
+        CHECK(barrier->dstAccessMask == barriers[i].dstAccessMask);
+        if (barriers[i].pNext) {
+            /* Even a zero-valued Flags3 node must survive the wire. */
+            const VkMemoryBarrierAccessFlags3KHR *out_flags = barrier->pNext;
+            CHECK(out_flags && out_flags->sType == flags3.sType);
+            CHECK(!out_flags->pNext);
+            CHECK(out_flags->srcAccessMask3 == flags3.srcAccessMask3);
+            CHECK(out_flags->dstAccessMask3 == flags3.dstAccessMask3);
+        } else {
+            CHECK(!barrier->pNext);
+        }
+    }
+    if (with_ranges) {
+        const VkMemoryRangeBarriersInfoKHR *out_ranges = output.pNext;
+        CHECK(out_ranges && out_ranges->sType == ranges.sType);
+        CHECK(!out_ranges->pNext && out_ranges->memoryRangeBarrierCount == 1);
+        CHECK(out_ranges->pMemoryRangeBarriers);
+        const VkMemoryRangeBarrierKHR *out_range = out_ranges->pMemoryRangeBarriers;
+        CHECK(out_range->sType == range.sType && !out_range->pNext);
+        CHECK(out_range->srcStageMask == range.srcStageMask);
+        CHECK(out_range->srcAccessMask == range.srcAccessMask);
+        CHECK(out_range->dstStageMask == range.dstStageMask);
+        CHECK(out_range->dstAccessMask == range.dstAccessMask);
+        CHECK(out_range->srcQueueFamilyIndex == range.srcQueueFamilyIndex);
+        CHECK(out_range->dstQueueFamilyIndex == range.dstQueueFamilyIndex);
+        CHECK(out_range->addressRange.address == range.addressRange.address);
+        CHECK(out_range->addressRange.size == range.addressRange.size);
+        CHECK(out_range->addressFlags == range.addressFlags);
+    } else {
+        CHECK(!output.pNext);
+    }
+
+    /* Exercise the bounded reader and temporary storage on every truncation. */
+    const size_t size = stream.size;
+    for (size_t i = 0; i < size; i++) {
+        stream.size = i;
+        CHECK(!vn_test_decode_dependency(&stream, &storage, &output));
+        CHECK(storage.fatal);
+    }
+    return true;
+}
+
+static bool
+test_root_chain_scope(void)
+{
+    VkMemoryBarrierAccessFlags3KHR flags3 = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_ACCESS_FLAGS_3_KHR,
+    };
+    VkMemoryRangeBarriersInfoKHR ranges = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_RANGE_BARRIERS_INFO_KHR,
+    };
+    VkDependencyInfo info = {
+        .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+        .pNext = &ranges,
+    };
+    struct vn_test_stream baseline, filtered;
+    CHECK(vn_test_encode_dependency(&info, &baseline));
+
+    /* Flags3 is not a legal sibling before or after the root RangeInfo. */
+    ranges.pNext = &flags3;
+    CHECK(vn_test_encode_dependency(&info, &filtered));
+    CHECK(filtered.size == baseline.size);
+    CHECK(!memcmp(filtered.data, baseline.data, baseline.size));
+    ranges.pNext = NULL;
+    flags3.pNext = &ranges;
+    info.pNext = &flags3;
+    CHECK(vn_test_encode_dependency(&info, &filtered));
+    CHECK(filtered.size == baseline.size);
+    CHECK(!memcmp(filtered.data, baseline.data, baseline.size));
+
+    for (unsigned after_range = 0; after_range < 2; after_range++) {
+        struct vn_test_decoder storage;
+        vn_test_encode_invalid_dependency_chain(&filtered, after_range);
+        CHECK(!filtered.fatal);
+        CHECK(!vn_test_decode_dependency_chain(&filtered, &storage));
+        CHECK(storage.fatal);
+    }
+    return true;
+}
+
+int main(void)
 {
-	return 0;
+    for (unsigned flags3 = 0; flags3 < 2; flags3++) {
+        for (unsigned ranges = 0; ranges < 2; ranges++) {
+            if (!test_memory_barriers(flags3, ranges))
+                return 1;
+        }
+    }
+    if (!test_root_chain_scope())
+        return 1;
+    puts("maintenance8 codec roundtrip and chain-scope checks passed");
+    return 0;
 }
