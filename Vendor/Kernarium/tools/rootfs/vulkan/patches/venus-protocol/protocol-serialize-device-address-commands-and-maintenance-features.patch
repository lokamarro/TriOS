diff --git a/tests/test_stream.h b/tests/test_stream.h
new file mode 100644
index 0000000000000000000000000000000000000000..6e321c6bbf8d3d0ed49f665771241078aef10088
--- /dev/null
+++ b/tests/test_stream.h
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: MIT */
+
+#ifndef VN_TEST_STREAM_H
+#define VN_TEST_STREAM_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <vulkan/vulkan.h>
+
+/* A bounded, test-only command stream and aligned decoder allocation pool. */
+struct vn_test_stream {
+    uint8_t data[4096];
+    size_t size;
+    bool fatal;
+};
+
+struct vn_test_decoder {
+    const struct vn_test_stream *stream;
+    size_t offset;
+    size_t temp_used;
+    bool fatal;
+    _Alignas(max_align_t) uint8_t temp[4096];
+};
+
+static inline void
+vn_test_write(struct vn_test_stream *stream, size_t size,
+              const void *val, size_t val_size)
+{
+    if (stream->fatal || val_size > size ||
+        size > sizeof(stream->data) - stream->size) {
+        stream->fatal = true;
+        return;
+    }
+    if (val_size)
+        memcpy(stream->data + stream->size, val, val_size);
+    memset(stream->data + stream->size + val_size, 0, size - val_size);
+    stream->size += size;
+}
+
+static inline void
+vn_test_read(struct vn_test_decoder *dec, size_t size,
+             void *val, size_t val_size, bool advance)
+{
+    if (dec->fatal || val_size > size ||
+        size > dec->stream->size - dec->offset) {
+        dec->fatal = true;
+        if (val_size)
+            memset(val, 0, val_size);
+        return;
+    }
+    if (val_size)
+        memcpy(val, dec->stream->data + dec->offset, val_size);
+    if (advance)
+        dec->offset += size;
+}
+
+static inline void *
+vn_test_alloc(struct vn_test_decoder *dec, size_t size)
+{
+    const size_t alignment = _Alignof(max_align_t);
+    const size_t offset = (dec->temp_used + alignment - 1) & ~(alignment - 1);
+    if (dec->fatal || offset > sizeof(dec->temp) ||
+        size > sizeof(dec->temp) - offset) {
+        dec->fatal = true;
+        return NULL;
+    }
+    dec->temp_used = offset + size;
+    return dec->temp + offset;
+}
+
+bool vn_test_encode_dependency(const VkDependencyInfo *info,
+                               struct vn_test_stream *stream);
+bool vn_test_decode_dependency(const struct vn_test_stream *stream,
+                               struct vn_test_decoder *storage,
+                               VkDependencyInfo *info);
+void vn_test_encode_invalid_dependency_chain(struct vn_test_stream *stream,
+                                             bool after_range_info);
+bool vn_test_decode_dependency_chain(const struct vn_test_stream *stream,
+                                     struct vn_test_decoder *storage);
+
+#endif /* VN_TEST_STREAM_H */
diff --git a/tests/test_vn_protocol.py b/tests/test_vn_protocol.py
new file mode 100644
index 0000000000000000000000000000000000000000..381630f2ed5490faee2a4e23bbb4de80687d8481
--- /dev/null
+++ b/tests/test_vn_protocol.py
@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+
+import argparse
+from pathlib import Path
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from vkxml import VkRegistry
+from vn_protocol import Gen, VN_PROTOCOL_DIR, get_vk_xmls
+
+
+class MemoryBarrierChains(unittest.TestCase):
+    registry_path = None
+
+    @classmethod
+    def setUpClass(cls):
+        if cls.registry_path is None:
+            raise ValueError('test requires an explicit --registry input')
+        _, private_xmls = get_vk_xmls(VN_PROTOCOL_DIR)
+        cls.registry = VkRegistry.parse(cls.registry_path, private_xmls)
+        cls.generators = [Gen(is_driver, cls.registry)
+                          for is_driver in (True, False)]
+
+    def test_contextual_memory_barrier_child(self):
+        for generator in self.generators:
+            with self.subTest(driver=generator.is_driver):
+                barrier = generator.reg.type_table['VkMemoryBarrier2']
+                children, skipped = generator.get_chain(barrier)
+                self.assertEqual([ty.name for ty in children],
+                                 ['VkMemoryBarrierAccessFlags3KHR'])
+                self.assertEqual(skipped, [])
+
+    def test_root_chain_does_not_gain_transitive_children(self):
+        for generator in self.generators:
+            with self.subTest(driver=generator.is_driver):
+                dependency = generator.reg.type_table['VkDependencyInfo']
+                children, skipped = generator.get_chain(dependency)
+                self.assertEqual([ty.name for ty in children],
+                                 ['VkMemoryRangeBarriersInfoKHR'])
+                self.assertEqual(skipped, [])
+
+    def test_fixup_does_not_mutate_imported_registry(self):
+        barrier = self.registry.type_table['VkMemoryBarrier2']
+        self.assertEqual(barrier.p_next, [])
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--registry', required=True, type=Path)
+    options, unittest_arguments = parser.parse_known_args()
+    MemoryBarrierChains.registry_path = options.registry
+    unittest.main(argv=[sys.argv[0], *unittest_arguments])
