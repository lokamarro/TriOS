diff --git a/tests/driver.c b/tests/driver.c
index 92b9d958c49a74bbc25f3fec01d47dfe73d61263..ce7375c77531d36e83d351ed249ef873c7aefb67 100644
--- a/tests/driver.c
+++ b/tests/driver.c
@@ -4,3 +4,41 @@
  */
 
 #include "vn_protocol_driver.h"
+
+bool
+vn_test_encode_dependency(const VkDependencyInfo *info, struct vn_test_stream *stream)
+{
+    *stream = (struct vn_test_stream){ 0 };
+    struct vn_cs_encoder enc = { .stream = stream };
+    const size_t size = vn_sizeof_VkDependencyInfo(info);
+    if (!vn_cs_encoder_reserve(&enc, size))
+        return false;
+    vn_encode_VkDependencyInfo(&enc, info);
+    return !stream->fatal && stream->size == size;
+}
+
+void
+vn_test_encode_invalid_dependency_chain(struct vn_test_stream *stream,
+                                        bool after_range_info)
+{
+    const VkMemoryRangeBarriersInfoKHR range_info = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_RANGE_BARRIERS_INFO_KHR,
+    };
+    const VkMemoryBarrierAccessFlags3KHR flags3 = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_ACCESS_FLAGS_3_KHR,
+    };
+    *stream = (struct vn_test_stream){ 0 };
+    struct vn_cs_encoder enc = { .stream = stream };
+
+    /* Deliberately inject an invalid wire sibling, bypassing root filtering. */
+    if (after_range_info) {
+        vn_encode_simple_pointer(&enc, &range_info);
+        vn_encode_VkStructureType(&enc, &range_info.sType);
+    }
+    vn_encode_simple_pointer(&enc, &flags3);
+    vn_encode_VkStructureType(&enc, &flags3.sType);
+    vn_encode_simple_pointer(&enc, NULL);
+    vn_encode_VkMemoryBarrierAccessFlags3KHR_self(&enc, &flags3);
+    if (after_range_info)
+        vn_encode_VkMemoryRangeBarriersInfoKHR_self(&enc, &range_info);
+}
