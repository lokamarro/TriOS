From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 14 Sep 2026 14:04:48 +0900
Subject: [PATCH] protocol: measure a renderer reply that carries a blob beside
 a structure

A command that returns a blob is decoded with running reply-size accounting,
because the renderer has to reserve the reply before it knows what the driver
will produce. That accounting calls vn_sizeof on every out variable, but the
renderer template emits vn_sizeof only for scalars and enumerations: every
other reply it sends is measured by the encoder as it goes, so a structure
never needed one.

No command in the protocol had both a blob and a structure among its out
variables until VK_KHR_pipeline_binary, whose vkGetPipelineBinaryDataKHR
returns the binary data beside a VkPipelineBinaryKeyKHR. Generating it emits a
call to vn_sizeof_VkPipelineBinaryKeyKHR that nothing defines, and the renderer
headers do not compile.

Mark the non-blob out variables of a blob-returning command as needing
vn_sizeof and emit it for them, and emit the scalar array sizeof helpers the
renderer was likewise missing while the driver already had them. Both are the
renderer catching up with the driver's own template rather than a new
serialization rule, and neither changes any existing generated byte: with no
such command listed, the only new code is five scalar array helpers.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 templates/renderer_commands.h | 5 +++++
 templates/renderer_types.h    | 2 ++
 vn_protocol.py                | 9 +++++++++
 3 files changed, 16 insertions(+)

diff --git a/templates/renderer_commands.h b/templates/renderer_commands.h
index 396e02c27f8e23125ccf30bf8450e2fa318718ea..aa0be8246f63bb0bb77d569ee54a8b30483e1896 100644
--- a/templates/renderer_commands.h
+++ b/templates/renderer_commands.h
@@ -108,6 +108,11 @@ static inline void vn_dispatch_${ty.name}(struct vn_dispatch_context *ctx, VkCom
 % for ty in STRUCT_TYPES:
 /* ${types.vn_type_descriptive_name(ty)} */
 
+%   if 'need_sizeof' in ty.attrs:
+${types.vn_sizeof_type_helpers(ty)}\
+${types.vn_sizeof_type(ty)}
+%   endif
+\
 %   if 'need_encode' in ty.attrs:
 ${types.vn_encode_type_helpers(ty)}\
 ${types.vn_encode_type(ty)}
diff --git a/templates/renderer_types.h b/templates/renderer_types.h
index 174046f2146b3ec47af302c9e2f4ee26295262af..f07683b095095b0d703600ddf354f5cb29f6b8d3 100644
--- a/templates/renderer_types.h
+++ b/templates/renderer_types.h
@@ -22,6 +22,7 @@ ${types.vn_sizeof_type(ty)}
 ${types.vn_encode_type(ty)}
 ${types.vn_decode_type(ty)}
 %   if 'need_array' in ty.attrs:
+${scalar.vn_sizeof_scalar_array(ty)}
 ${scalar.vn_encode_scalar_array(ty)}
 ${scalar.vn_decode_scalar_array(ty)}
 %   endif
@@ -39,6 +40,7 @@ ${types.vn_sizeof_type(ty)}
 ${types.vn_encode_type(ty)}
 ${types.vn_decode_type(ty)}
 %   if 'need_array' in ty.attrs:
+${scalar.vn_sizeof_scalar_array(ty)}
 ${scalar.vn_encode_scalar_array(ty)}
 ${scalar.vn_decode_scalar_array(ty)}
 %   endif
diff --git a/vn_protocol.py b/vn_protocol.py
index 4f8554b0eab9eee63500254b7eb0c336e5b8f722..b909948e3c69e405b7b583c9858e1b1bbff03de9 100755
--- a/vn_protocol.py
+++ b/vn_protocol.py
@@ -348,6 +348,15 @@ class Gen:
                 if ignore.struct == ty.name and ignore.var == var.name:
                     var.attrs['condition'] = ignore.condition
 
+        # A command that returns a blob has to account for its reply size
+        # while it decodes, so the renderer needs vn_sizeof for the command's
+        # other out variables.  The renderer otherwise emits vn_sizeof only
+        # for scalars, because every other reply is measured by the encoder.
+        if not self.is_driver and 'need_blob_encode' in ty.attrs:
+            for var in ty.variables:
+                if 'var_out' in var.attrs and not var.is_blob():
+                    var.ty.set_attribute('need_sizeof', True)
+
         if ty.ret:
             if ty.ret.ty.is_pointer() or ty.ret.ty.is_static_array():
                 ty.ret.ty.base.attrs['need_array'] = True
