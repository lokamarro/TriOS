 tests/main.c                          | 76 +++++++++++++++++++++++++++
 tests/renderer.c                      | 12 +++++
 tests/test_stream.h                   |  5 ++
 tests/test_vn_protocol.py             | 24 ++++++++-
 vn_protocol.py                        | 26 +++++++++
 xmls/VK_EXT_command_serialization.xml |  7 +++
 7 files changed, 161 insertions(+), 2 deletions(-)

diff --git a/tests/driver.c b/tests/driver.c
index ce7375c77531d36e83d351ed249ef873c7aefb67..4f5fda1199303ae2aed5f4ec7b5158444181b77b 100644
--- a/tests/driver.c
+++ b/tests/driver.c
@@ -42,3 +42,16 @@ vn_test_encode_invalid_dependency_chain(struct vn_test_stream *stream,
     if (after_range_info)
         vn_encode_VkMemoryRangeBarriersInfoKHR_self(&enc, &range_info);
 }
+
+bool
+vn_test_encode_pipeline_create_info(const VkPipelineCreateInfoKHR *info,
+                                    struct vn_test_stream *stream)
+{
+    *stream = (struct vn_test_stream){ 0 };
+    struct vn_cs_encoder enc = { .stream = stream };
+    const size_t size = vn_sizeof_VkPipelineCreateInfoKHR(info);
+    if (!vn_cs_encoder_reserve(&enc, size))
+        return false;
+    vn_encode_VkPipelineCreateInfoKHR(&enc, info);
+    return !stream->fatal && stream->size == size;
+}
diff --git a/tests/main.c b/tests/main.c
index bd8881f278c70372ebbe4e54a66d17fc26a3d97a..08fc4293750376d0f5fe9d03fbe974bb479860c8 100644
--- a/tests/main.c
+++ b/tests/main.c
@@ -151,6 +151,80 @@ test_root_chain_scope(void)
     return true;
 }
 
+static bool
+test_pipeline_create_info_chain(void)
+{
+    /* A pipeline key names the pipeline the caller describes, and the caller
+     * describes it by chaining a pipeline create info onto the key request.
+     * vk.xml declares no structextends for that chain, so it exists only
+     * because the generator is told about it. */
+    const VkFormat color_format = VK_FORMAT_R8G8B8A8_UNORM;
+    const VkPipelineRenderingCreateInfo rendering = {
+        .sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO,
+        .viewMask = 0x3,
+        .colorAttachmentCount = 1,
+        .pColorAttachmentFormats = &color_format,
+        .depthAttachmentFormat = VK_FORMAT_D32_SFLOAT,
+        .stencilAttachmentFormat = VK_FORMAT_UNDEFINED,
+    };
+    const VkPipelineInputAssemblyStateCreateInfo input_assembly = {
+        .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+        .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP,
+        .primitiveRestartEnable = VK_TRUE,
+    };
+    VkGraphicsPipelineCreateInfo graphics = {
+        .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO,
+        .pNext = &rendering,
+        .flags = VK_PIPELINE_CREATE_DISABLE_OPTIMIZATION_BIT,
+        .pInputAssemblyState = &input_assembly,
+        .subpass = 2,
+        .basePipelineIndex = -1,
+    };
+    const VkPipelineCreateInfoKHR input = {
+        .sType = VK_STRUCTURE_TYPE_PIPELINE_CREATE_INFO_KHR,
+        .pNext = &graphics,
+    };
+    struct vn_test_stream stream;
+    struct vn_test_decoder storage;
+    VkPipelineCreateInfoKHR output;
+    CHECK(vn_test_encode_pipeline_create_info(&input, &stream));
+    CHECK(vn_test_decode_pipeline_create_info(&stream, &storage, &output));
+    CHECK(output.sType == input.sType);
+
+    const VkGraphicsPipelineCreateInfo *out_graphics = output.pNext;
+    CHECK(out_graphics && out_graphics->sType == graphics.sType);
+    CHECK(out_graphics->flags == graphics.flags);
+    CHECK(out_graphics->stageCount == 0 && !out_graphics->pStages);
+    CHECK(out_graphics->subpass == graphics.subpass);
+    CHECK(out_graphics->basePipelineIndex == graphics.basePipelineIndex);
+    CHECK(out_graphics->pInputAssemblyState);
+    CHECK(out_graphics->pInputAssemblyState->topology == input_assembly.topology);
+    CHECK(out_graphics->pInputAssemblyState->primitiveRestartEnable ==
+          input_assembly.primitiveRestartEnable);
+    CHECK(!out_graphics->pVertexInputState && !out_graphics->pViewportState);
+
+    /* The chained create info keeps its own chain, which a flat encoding
+     * carries as a sibling of the create info itself. */
+    const VkPipelineRenderingCreateInfo *out_rendering = out_graphics->pNext;
+    CHECK(out_rendering && out_rendering->sType == rendering.sType);
+    CHECK(!out_rendering->pNext);
+    CHECK(out_rendering->viewMask == rendering.viewMask);
+    CHECK(out_rendering->colorAttachmentCount == 1);
+    CHECK(out_rendering->pColorAttachmentFormats);
+    CHECK(out_rendering->pColorAttachmentFormats[0] == color_format);
+    CHECK(out_rendering->depthAttachmentFormat == rendering.depthAttachmentFormat);
+    CHECK(out_rendering->stencilAttachmentFormat == rendering.stencilAttachmentFormat);
+
+    /* Exercise the bounded reader and temporary storage on every truncation. */
+    const size_t size = stream.size;
+    for (size_t i = 0; i < size; i++) {
+        stream.size = i;
+        CHECK(!vn_test_decode_pipeline_create_info(&stream, &storage, &output));
+        CHECK(storage.fatal);
+    }
+    return true;
+}
+
 int main(void)
 {
     for (unsigned flags3 = 0; flags3 < 2; flags3++) {
@@ -161,6 +235,8 @@ int main(void)
     }
     if (!test_root_chain_scope())
         return 1;
+    if (!test_pipeline_create_info_chain())
+        return 1;
     puts("maintenance8 codec roundtrip and chain-scope checks passed");
     return 0;
 }
diff --git a/tests/renderer.c b/tests/renderer.c
index bb3814dd64891c7644be8ac59d4dde18a618eff0..81bf5dae549565d585ae76ad975e387832ad655a 100644
--- a/tests/renderer.c
+++ b/tests/renderer.c
@@ -25,3 +25,15 @@ vn_test_decode_dependency_chain(const struct vn_test_stream *stream,
     vn_decode_VkDependencyInfo_pnext_temp((struct vn_cs_decoder *)&dec);
     return !storage->fatal && storage->offset == stream->size;
 }
+
+bool
+vn_test_decode_pipeline_create_info(const struct vn_test_stream *stream,
+                                    struct vn_test_decoder *storage,
+                                    VkPipelineCreateInfoKHR *info)
+{
+    *storage = (struct vn_test_decoder){ .stream = stream };
+    *info = (VkPipelineCreateInfoKHR){ 0 };
+    struct vkr_cs_decoder dec = { .storage = storage };
+    vn_decode_VkPipelineCreateInfoKHR_temp((struct vn_cs_decoder *)&dec, info);
+    return !storage->fatal && storage->offset == stream->size;
+}
diff --git a/tests/test_stream.h b/tests/test_stream.h
index 6e321c6bbf8d3d0ed49f665771241078aef10088..0521f459ea4aff02f59667eb67128d78315e5f54 100644
--- a/tests/test_stream.h
+++ b/tests/test_stream.h
@@ -78,6 +78,11 @@ bool vn_test_decode_dependency(const struct vn_test_stream *stream,
                                VkDependencyInfo *info);
 void vn_test_encode_invalid_dependency_chain(struct vn_test_stream *stream,
                                              bool after_range_info);
+bool vn_test_encode_pipeline_create_info(const VkPipelineCreateInfoKHR *info,
+                                        struct vn_test_stream *stream);
+bool vn_test_decode_pipeline_create_info(const struct vn_test_stream *stream,
+                                         struct vn_test_decoder *storage,
+                                         VkPipelineCreateInfoKHR *info);
 bool vn_test_decode_dependency_chain(const struct vn_test_stream *stream,
                                      struct vn_test_decoder *storage);
 
diff --git a/tests/test_vn_protocol.py b/tests/test_vn_protocol.py
index 381630f2ed5490faee2a4e23bbb4de80687d8481..81fc1f8a198d6fd11204ac7b1974764a07755b43 100644
--- a/tests/test_vn_protocol.py
+++ b/tests/test_vn_protocol.py
@@ -11,7 +11,7 @@ from vkxml import VkRegistry
 from vn_protocol import Gen, VN_PROTOCOL_DIR, get_vk_xmls
 
 
-class MemoryBarrierChains(unittest.TestCase):
+class ProtocolChains(unittest.TestCase):
     registry_path = None
 
     @classmethod
@@ -45,10 +45,30 @@ class MemoryBarrierChains(unittest.TestCase):
         barrier = self.registry.type_table['VkMemoryBarrier2']
         self.assertEqual(barrier.p_next, [])
 
+    def test_pipeline_create_info_carries_the_pipeline(self):
+        for generator in self.generators:
+            with self.subTest(driver=generator.is_driver):
+                info = generator.reg.type_table['VkPipelineCreateInfoKHR']
+                children, skipped = generator.get_chain(info)
+                names = [ty.name for ty in children]
+                self.assertEqual(skipped, [])
+                for create_info in ['VkGraphicsPipelineCreateInfo',
+                                    'VkComputePipelineCreateInfo',
+                                    'VkRayTracingPipelineCreateInfoKHR']:
+                    self.assertIn(create_info, names)
+                # Each create info's own chain travels in the same flat chain,
+                # so a structure that extends one of them is a sibling here.
+                self.assertIn('VkPipelineRenderingCreateInfo', names)
+                self.assertIn('VkPipelineBinaryInfoKHR', names)
+
+    def test_pipeline_create_info_chain_is_not_in_the_registry(self):
+        info = self.registry.type_table['VkPipelineCreateInfoKHR']
+        self.assertEqual(info.p_next, [])
+
 
 if __name__ == '__main__':
     parser = argparse.ArgumentParser()
     parser.add_argument('--registry', required=True, type=Path)
     options, unittest_arguments = parser.parse_known_args()
-    MemoryBarrierChains.registry_path = options.registry
+    ProtocolChains.registry_path = options.registry
     unittest.main(argv=[sys.argv[0], *unittest_arguments])
diff --git a/vn_protocol.py b/vn_protocol.py
index b909948e3c69e405b7b583c9858e1b1bbff03de9..d22e068ce091dc4b0a08c6a3e113dabeaf9b46c9 100755
--- a/vn_protocol.py
+++ b/vn_protocol.py
@@ -133,6 +133,7 @@ VK_XML_EXTENSION_LIST = [
     'VK_KHR_maintenance9',
     'VK_KHR_maintenance10',
     'VK_KHR_maintenance11',
+    'VK_KHR_pipeline_binary',
     'VK_KHR_pipeline_library',
     'VK_KHR_ray_query',
     'VK_KHR_ray_tracing_maintenance1',
@@ -380,6 +381,27 @@ class Gen:
         if flags3 not in barrier.p_next:
             barrier.p_next.append(flags3)
 
+        # A pipeline key and a pipeline binary are derived from the pipeline
+        # creation structure the caller chains onto VkPipelineCreateInfoKHR.
+        # That structure is a pipeline create info in its own right, so vk.xml
+        # gives it no structextends="VkPipelineCreateInfoKHR" and the chain
+        # would always be encoded empty: the renderer would hand its driver a
+        # create info describing nothing, and every key would name the device
+        # rather than the pipeline the caller asked about.  A chain is encoded
+        # flat, each node's own pNext through the chain codec of the structure
+        # the chain belongs to, so the structures that extend a pipeline create
+        # info have to join the same chain or they would be dropped with it.
+        pipeline_create_info = self.reg.type_table['VkPipelineCreateInfoKHR']
+        for name in ['VkGraphicsPipelineCreateInfo',
+                     'VkComputePipelineCreateInfo',
+                     'VkRayTracingPipelineCreateInfoKHR']:
+            create_info = self.reg.type_table.get(name)
+            if create_info is None:
+                continue
+            for child in [create_info] + create_info.p_next:
+                if child not in pipeline_create_info.p_next:
+                    pipeline_create_info.p_next.append(child)
+
         for ty in self.reg.type_table.values():
             if ty.category == ty.COMMAND:
                 ty.attrs['c_type'] = 'VK_COMMAND_TYPE_' + ty.name + '_EXT'
@@ -1602,9 +1624,13 @@ class GenStructsAndCommands:
         'pipeline': [
             'CreateComputePipeline',
             'CreateGraphicsPipeline',
+            'CreatePipelineBinaries',
             'CreateRayTracingPipeline',
             'DestroyPipeline',
+            'GetPipelineBinaryData',
+            'GetPipelineKey',
             'GetRayTracing',
+            'ReleaseCapturedPipelineData',
         ],
         'pipeline_layout': [
             'CreatePipelineLayout',
