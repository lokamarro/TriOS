From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 5 Sep 2026 06:27:17 -0400
Subject: [PATCH] Check for compute queue support

Backport upstream commit 5e8b107ad4461730c208c4cc69f08a965c70ceea. Skip compute-only fill and update cases when the physical device exposes no exclusive compute queue, rather than attempting to submit through a null queue.
---
 .../modules/vulkan/api/vktApiFillBufferTests.cpp         | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/external/vulkancts/modules/vulkan/api/vktApiFillBufferTests.cpp b/external/vulkancts/modules/vulkan/api/vktApiFillBufferTests.cpp
index 6c6b7c39ba1fddeccae99dda76b434b63f000dad..803d0acc29884fafcf88a940981ae794a83bb9a8 100644
--- a/external/vulkancts/modules/vulkan/api/vktApiFillBufferTests.cpp
+++ b/external/vulkancts/modules/vulkan/api/vktApiFillBufferTests.cpp
@@ -404,6 +404,9 @@ public:
 
     void checkSupport(Context &context) const override
     {
+        if ((m_params.queueType == QueueType::COMPUTE_ONLY) && (context.getComputeQueueFamilyIndex() == -1))
+            TCU_THROW(NotSupportedError, "Exclusive compute queue not supported.");
+
         if (m_params.useDeviceAddressCommands)
         {
             context.requireDeviceFunctionality("VK_KHR_device_address_commands");
@@ -643,6 +646,9 @@ public:
 
     virtual void checkSupport(Context &context) const
     {
+        if ((m_params.queueType == QueueType::COMPUTE_ONLY) && (context.getComputeQueueFamilyIndex() == -1))
+            TCU_THROW(NotSupportedError, "Exclusive compute queue not supported.");
+
         if (m_params.useDeviceAddressCommands)
             context.requireDeviceFunctionality("VK_KHR_device_address_commands");
     }
@@ -757,6 +763,9 @@ public:
 
     virtual void checkSupport(Context &context) const
     {
+        if ((m_params.queueType == QueueType::COMPUTE_ONLY) && (context.getComputeQueueFamilyIndex() == -1))
+            TCU_THROW(NotSupportedError, "Exclusive compute queue not supported.");
+
         if (m_params.useDeviceAddressCommands)
             context.requireDeviceFunctionality("VK_KHR_device_address_commands");
     }
