@@ -307,7 +306,7 @@ vn_pipeline_layout_destroy(struct vn_device *dev,
       vn_pipeline_layout_to_handle(pipeline_layout), NULL);
 
    vn_object_base_fini(&pipeline_layout->base);
-   vk_free(alloc, pipeline_layout);
+   vn_refcounted_object_free(&pipeline_layout->allocator, pipeline_layout);
 }
 
 static inline struct vn_pipeline_layout *
@@ -333,14 +332,16 @@ vn_CreatePipelineLayout(VkDevice device,
                         VkPipelineLayout *pPipelineLayout)
 {
    struct vn_device *dev = vn_device_from_handle(device);
-   /* ignore pAllocator as the pipeline layout is reference-counted */
-   const VkAllocationCallbacks *alloc = &dev->base.vk.alloc;
 
-   struct vn_pipeline_layout *layout =
-      vk_zalloc(alloc, sizeof(*layout), VN_DEFAULT_ALIGN,
-                VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   /* served by the creating command's callbacks, with the device scope a
+    * reference-counted lifetime needs
+    */
+   VkAllocationCallbacks kept;
+   struct vn_pipeline_layout *layout = vn_refcounted_object_zalloc(
+      &dev->base.vk.alloc, pAllocator, sizeof(*layout), &kept);
    if (!layout)
       return vn_error(dev->instance, VK_ERROR_OUT_OF_HOST_MEMORY);
+   layout->allocator = kept;
 
    vn_object_base_init(&layout->base, VK_OBJECT_TYPE_PIPELINE_LAYOUT,
                        &dev->base);
