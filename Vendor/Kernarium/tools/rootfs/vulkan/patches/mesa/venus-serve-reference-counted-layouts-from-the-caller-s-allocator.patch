diff --git a/src/virtio/vulkan/vn_object_alloc.h b/src/virtio/vulkan/vn_object_alloc.h
new file mode 100644
index 0000000000000000000000000000000000000000..d068b8dd261b6d299ec37283f16813ad912b2b15
--- /dev/null
+++ b/src/virtio/vulkan/vn_object_alloc.h
@@ -0,0 +1,73 @@
+/*
+ * Copyright 2026
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VN_OBJECT_ALLOC_H
+#define VN_OBJECT_ALLOC_H
+
+#include <string.h>
+#include <vulkan/vulkan_core.h>
+
+/* Descriptor set layouts and pipeline layouts are reference counted, because
+ * the specification lets an application destroy one while descriptor sets,
+ * pipelines, update templates and recorded push descriptors still describe
+ * themselves with it.  Venus therefore keeps the layout, and its renderer
+ * object, until its last internal reference goes away.
+ *
+ * A reference-counted object still belongs to the allocator its creator
+ * provided.  Vulkan asks an implementation to serve every host allocation an
+ * object needs from that object's callbacks, and the object management CTS
+ * observes it: a layout created while every callback fails must fail with
+ * VK_ERROR_OUT_OF_HOST_MEMORY rather than quietly allocate elsewhere.
+ *
+ * Keep the callbacks that provided the storage inside the object and return
+ * the storage to them, so the allocation a creator paid for is the allocation
+ * that is released.  The storage is requested with device scope, which is what
+ * an extended lifetime is: the object may outlive its destroy command, and an
+ * application's device-scoped arena outlives every object in the device.  The
+ * callbacks a destroy command carries are compatible with the ones its create
+ * command carried, so either set can release the storage; the kept set is the
+ * one that is still known when the last reference goes away.
+ */
+
+#define VN_OBJECT_ALLOC_ALIGN 8
+
+/* Allocate zeroed storage for a reference-counted object from the callbacks
+ * the creating command carried, falling back to the device's own callbacks.
+ * On success *kept receives the callbacks that served the allocation, for the
+ * object to store and hand back to vn_refcounted_object_free.
+ */
+static inline void *
+vn_refcounted_object_zalloc(const VkAllocationCallbacks *device_alloc,
+                            const VkAllocationCallbacks *object_alloc,
+                            size_t size,
+                            VkAllocationCallbacks *kept)
+{
+   const VkAllocationCallbacks *alloc =
+      object_alloc ? object_alloc : device_alloc;
+   void *object =
+      alloc->pfnAllocation(alloc->pUserData, size, VN_OBJECT_ALLOC_ALIGN,
+                           VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (!object)
+      return NULL;
+
+   memset(object, 0, size);
+   *kept = *alloc;
+
+   return object;
+}
+
+/* Release storage vn_refcounted_object_zalloc served.  The kept callbacks
+ * live inside the object being released, so read them out first.
+ */
+static inline void
+vn_refcounted_object_free(const VkAllocationCallbacks *kept, void *object)
+{
+   const VkAllocationCallbacks alloc = *kept;
+
+   if (object)
+      alloc.pfnFree(alloc.pUserData, object);
+}
+
+#endif /* VN_OBJECT_ALLOC_H */
