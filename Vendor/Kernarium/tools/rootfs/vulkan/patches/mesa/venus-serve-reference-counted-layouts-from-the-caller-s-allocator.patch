diff --git a/src/virtio/vulkan/tests/vn_object_alloc_test.c b/src/virtio/vulkan/tests/vn_object_alloc_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..c7d7e3d6b24b56e80b5ee3f9029995361fa763be
--- /dev/null
+++ b/src/virtio/vulkan/tests/vn_object_alloc_test.c
@@ -0,0 +1,167 @@
+/*
+ * Copyright 2026
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "../vn_object_alloc.h"
+
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(expr)                                                          \
+   do {                                                                      \
+      if (!(expr)) {                                                         \
+         fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #expr);          \
+         return 1;                                                           \
+      }                                                                      \
+   } while (0)
+
+struct test_allocator {
+   unsigned allocations;
+   unsigned frees;
+   size_t last_size;
+   size_t last_alignment;
+   VkSystemAllocationScope last_scope;
+   bool fail;
+};
+
+static VKAPI_ATTR void *VKAPI_CALL
+test_allocation(void *user_data,
+                size_t size,
+                size_t alignment,
+                VkSystemAllocationScope scope)
+{
+   struct test_allocator *allocator = user_data;
+
+   allocator->allocations++;
+   allocator->last_size = size;
+   allocator->last_alignment = alignment;
+   allocator->last_scope = scope;
+
+   if (allocator->fail)
+      return NULL;
+
+   /* the caller zeroes what it is handed, so hand back dirty storage */
+   void *memory = malloc(size);
+   if (memory)
+      memset(memory, 0x5a, size);
+
+   return memory;
+}
+
+static VKAPI_ATTR void *VKAPI_CALL
+test_reallocation(void *user_data,
+                  void *original,
+                  size_t size,
+                  size_t alignment,
+                  VkSystemAllocationScope scope)
+{
+   (void)user_data;
+   (void)original;
+   (void)size;
+   (void)alignment;
+   (void)scope;
+
+   /* reference-counted objects never grow */
+   abort();
+}
+
+static VKAPI_ATTR void VKAPI_CALL
+test_free(void *user_data, void *memory)
+{
+   struct test_allocator *allocator = user_data;
+
+   allocator->frees++;
+   free(memory);
+}
+
+static VkAllocationCallbacks
+test_callbacks(struct test_allocator *allocator)
+{
+   return (VkAllocationCallbacks){
+      .pUserData = allocator,
+      .pfnAllocation = test_allocation,
+      .pfnReallocation = test_reallocation,
+      .pfnFree = test_free,
+   };
+}
+
+/* an object shaped like the reference-counted layouts: it stores the
+ * callbacks that served it and is released through them
+ */
+struct test_object {
+   VkAllocationCallbacks allocator;
+   uint32_t payload[4];
+};
+
+int
+main(void)
+{
+   struct test_allocator device = {0};
+   struct test_allocator object = {0};
+   const VkAllocationCallbacks device_callbacks = test_callbacks(&device);
+   const VkAllocationCallbacks object_callbacks = test_callbacks(&object);
+   VkAllocationCallbacks kept = {0};
+
+   /* a command that carries callbacks is served by them, with the device
+    * scope a reference-counted lifetime needs, and never reaches the
+    * device's own allocator
+    */
+   struct test_object *owned = vn_refcounted_object_zalloc(
+      &device_callbacks, &object_callbacks, sizeof(*owned), &kept);
+   CHECK(owned);
+   CHECK(object.allocations == 1);
+   CHECK(device.allocations == 0);
+   CHECK(object.last_size == sizeof(*owned));
+   CHECK(object.last_alignment == VN_OBJECT_ALLOC_ALIGN);
+   CHECK(object.last_scope == VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   CHECK(kept.pUserData == &object);
+   CHECK(kept.pfnAllocation == test_allocation);
+   CHECK(kept.pfnFree == test_free);
+   for (unsigned i = 0; i < 4; i++)
+      CHECK(owned->payload[i] == 0);
+
+   /* the object keeps the callbacks that served it, inside the storage they
+    * served, and the storage goes back to them
+    */
+   owned->allocator = kept;
+   vn_refcounted_object_free(&owned->allocator, owned);
+   CHECK(object.frees == 1);
+   CHECK(device.frees == 0);
+
+   /* a command with no callbacks falls back to the device's own */
+   struct test_object *shared = vn_refcounted_object_zalloc(
+      &device_callbacks, NULL, sizeof(*shared), &kept);
+   CHECK(shared);
+   CHECK(device.allocations == 1);
+   CHECK(object.allocations == 1);
+   CHECK(kept.pUserData == &device);
+   shared->allocator = kept;
+   vn_refcounted_object_free(&shared->allocator, shared);
+   CHECK(device.frees == 1);
+   CHECK(object.frees == 1);
+
+   /* callbacks that refuse the allocation fail the object; the device's own
+    * allocator must not quietly serve it instead
+    */
+   object.fail = true;
+   CHECK(!vn_refcounted_object_zalloc(&device_callbacks, &object_callbacks,
+                                      sizeof(*owned), &kept));
+   CHECK(object.allocations == 2);
+   CHECK(device.allocations == 1);
+   CHECK(object.frees == 1);
+   CHECK(device.frees == 1);
+
+   /* a failed creation has nothing to release */
+   vn_refcounted_object_free(&device_callbacks, NULL);
+   CHECK(device.frees == 1);
+
+   /* device callbacks that refuse an allocation fail it too */
+   device.fail = true;
+   CHECK(!vn_refcounted_object_zalloc(&device_callbacks, NULL,
+                                      sizeof(*shared), &kept));
+   CHECK(device.allocations == 2);
+
+   return 0;
+}
