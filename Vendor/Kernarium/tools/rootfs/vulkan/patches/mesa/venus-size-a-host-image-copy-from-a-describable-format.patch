From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 7 Sep 2026 21:33:52 +0900
Subject: [PATCH] venus: size a host image copy from a describable format

vn_get_copy_size() takes the texel block size from
vk_format_get_blocksize(), which describes a Vulkan format through its
gallium pipe format and answers one byte for a format gallium has no entry
for instead of reporting that it cannot describe it.

VK_FORMAT_R12X4G12X4B12X4A12X4_UNORM_4PACK16 is such a format.  Its ten-bit
sibling is mapped and this one is not, so a 240x240 host image copy asked
the renderer for 57600 bytes where the copy writes 460800.  The renderer
points the driver at that reply blob in guest-visible shared memory, so the
driver wrote 403200 bytes past its end, which landed on an unmapped page,
a read-only page, or live memory depending on the allocator.

Answer the size the specification defines for the formats gallium cannot
describe, and report the rest as unknown so the copy is refused rather than
under-sized.
---
 src/virtio/vulkan/vn_host_copy.c | 37 +++++++++++++++++++++++++++++++-
 1 file changed, 36 insertions(+), 1 deletion(-)

diff --git a/src/virtio/vulkan/vn_host_copy.c b/src/virtio/vulkan/vn_host_copy.c
index d83b72a1c83212a08abad01ac24725c4efc58386..9df4cbf0d5ff03e8bd5a928f95a0503148b0f6ac 100644
--- a/src/virtio/vulkan/vn_host_copy.c
+++ b/src/virtio/vulkan/vn_host_copy.c
@@ -107,6 +107,32 @@ vn_get_memcpy_size(VkDevice dev_handle,
    return total_size;
 }
 
+/* vk_format_get_blocksize() describes a Vulkan format through its gallium pipe
+ * format, and answers one byte for a format gallium has no entry for rather
+ * than reporting that it cannot describe it.
+ * VK_FORMAT_R12X4G12X4B12X4A12X4_UNORM_4PACK16 is such a format: its ten-bit
+ * sibling is mapped and this one is not, so a host copy sized through it asked
+ * the renderer for an eighth of the bytes the copy actually writes, and the
+ * renderer handed the driver a reply blob that small.  Answer the size the
+ * Vulkan specification defines for the formats gallium cannot describe, and
+ * report the rest as unknown so a copy is refused instead of under-sized.
+ */
+static uint32_t
+vn_host_copy_blocksize(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_R12X4G12X4B12X4A12X4_UNORM_4PACK16:
+      return 8;
+   default:
+      break;
+   }
+
+   if (vk_format_to_pipe_format(format) == PIPE_FORMAT_NONE)
+      return 0;
+
+   return vk_format_get_blocksize(format);
+}
+
 static size_t
 vn_get_copy_size(VkImage img_handle,
                  const VkImageSubresourceLayers *subres_layers,
@@ -133,7 +159,10 @@ vn_get_copy_size(VkImage img_handle,
    const uint32_t height = mem_img_height ?: img_extent.height;
    const uint32_t bw = vk_format_get_blockwidth(format);
    const uint32_t bh = vk_format_get_blockheight(format);
-   const uint32_t bs = vk_format_get_blocksize(format);
+   const uint32_t bs = vn_host_copy_blocksize(format);
+
+   if (!bs)
+      return 0;
 
    /* Per spec: Copying Data Between Buffers and Images */
    const size_t row_extent = DIV_ROUND_UP(width, bw) * bs;
@@ -173,6 +202,9 @@ vn_CopyImageToMemory(VkDevice device,
                                regions[i].memoryImageHeight,
                                regions[i].imageExtent);
 
+      if (!data_size)
+         return vn_error(dev->instance, VK_ERROR_FORMAT_NOT_SUPPORTED);
+
       VkImageLayout src_layout = info->srcImageLayout;
       if (VN_PRESENT_SRC_INTERNAL_LAYOUT != VK_IMAGE_LAYOUT_PRESENT_SRC_KHR &&
           src_layout == VK_IMAGE_LAYOUT_PRESENT_SRC_KHR)
@@ -225,6 +257,9 @@ vn_CopyMemoryToImage(VkDevice device,
                                regions[i].memoryImageHeight,
                                regions[i].imageExtent);
 
+      if (!data_size)
+         return vn_error(dev->instance, VK_ERROR_FORMAT_NOT_SUPPORTED);
+
       local_regions[i] = (VkMemoryToImageCopyMESA){
          .sType = VK_STRUCTURE_TYPE_MEMORY_TO_IMAGE_COPY_MESA,
          .dataSize = data_size,
