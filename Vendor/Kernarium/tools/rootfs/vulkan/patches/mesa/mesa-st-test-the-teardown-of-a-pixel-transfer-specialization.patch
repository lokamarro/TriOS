diff --git a/src/mesa/state_tracker/tests/st_pbo_compute_deinit.cpp b/src/mesa/state_tracker/tests/st_pbo_compute_deinit.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..273919a67986391cb3ac9ef4b7869d5cb88a72ed
--- /dev/null
+++ b/src/mesa/state_tracker/tests/st_pbo_compute_deinit.cpp
@@ -0,0 +1,159 @@
+/* SPDX-License-Identifier: MIT */
+
+#include "pipe/p_context.h"
+#include "pipe/p_screen.h"
+#include "state_tracker/st_context.h"
+#include "state_tracker/st_pbo_compute.h"
+#include "util/hash_table.h"
+#include "util/ralloc.h"
+#include "util/set.h"
+#include "util/u_queue.h"
+
+extern "C" {
+#include "state_tracker/st_pbo.h"
+}
+
+#include <gtest/gtest.h>
+#include <algorithm>
+#include <cstdlib>
+#include <type_traits>
+#include <vector>
+
+namespace {
+
+struct recording_context {
+   pipe_context base = {};
+   std::vector<void *> deleted;
+};
+static_assert(std::is_standard_layout_v<recording_context>);
+
+void
+record_delete_compute_state(struct pipe_context *pipe, void *state)
+{
+   auto *driver = reinterpret_cast<recording_context *>(pipe);
+   driver->deleted.push_back(state);
+}
+
+void
+unexpected_job(struct pipe_screen *, void *, struct util_queue_fence *,
+               pipe_driver_thread_func, pipe_driver_thread_func, const size_t)
+{
+   ADD_FAILURE() << "teardown must not queue driver-thread work";
+}
+
+uint32_t
+hash_spec(const void *key)
+{
+   return _mesa_hash_pointer(key);
+}
+
+bool
+equals_spec(const void *a, const void *b)
+{
+   return a == b;
+}
+
+class pbo_compute_deinit : public ::testing::Test {
+protected:
+   void SetUp() override
+   {
+      /* st_context is large and only a few fields matter here. */
+      st = static_cast<struct st_context *>(calloc(1, sizeof(struct st_context)));
+      ASSERT_NE(st, nullptr);
+      screen.driver_thread_add_job = unexpected_job;
+      driver.base.delete_compute_state = record_delete_compute_state;
+      st->screen = &screen;
+      st->pipe = &driver.base;
+      st->pbo.shaders = _mesa_hash_table_create_u32_keys(NULL);
+      ASSERT_NE(st->pbo.shaders, nullptr);
+   }
+
+   void TearDown() override { free(st); }
+
+   /* Mirrors add_async_data(): one conversion shader whose specializations
+    * live in a set keyed by the specialization itself.
+    */
+   struct pbo_async_data *add_async(uint32_t key)
+   {
+      auto *async = static_cast<struct pbo_async_data *>(
+         calloc(1, sizeof(struct pbo_async_data)));
+      async->st = st;
+      util_queue_fence_init(&async->fence);
+      _mesa_set_init(&async->specialized, NULL, hash_spec, equals_spec);
+      _mesa_hash_table_insert(st->pbo.shaders, (void *)(uintptr_t)key, async);
+      return async;
+   }
+
+   /* Mirrors add_spec_data() plus create_spec_shader_async(): the driver
+    * thread clones the NIR and sets created; the compute state is only
+    * compiled by a later download.
+    */
+   struct pbo_spec_async_data *add_spec(struct pbo_async_data *async, bool created,
+                                        void *cs)
+   {
+      auto *spec = static_cast<struct pbo_spec_async_data *>(
+         calloc(1, sizeof(struct pbo_spec_async_data)));
+      util_queue_fence_init(&spec->fence);
+      spec->created = created;
+      spec->cs = cs;
+      if (created && !cs) {
+         /* the clone the driver thread produced, still uncompiled */
+         spec->nir = static_cast<struct nir_shader *>(ralloc_context(NULL));
+      }
+      _mesa_set_add(&async->specialized, spec);
+      return spec;
+   }
+
+   pipe_screen screen = {};
+   recording_context driver;
+   struct st_context *st = nullptr;
+};
+
+/* A specialization whose NIR clone exists but whose compute state was never
+ * compiled must not be handed to the driver: pipe_context::delete_compute_state
+ * takes a live shader handle, and every driver dereferences it immediately.
+ */
+TEST_F(pbo_compute_deinit, uncompiled_specialization_is_not_deleted)
+{
+   struct pbo_async_data *async = add_async(1);
+   add_spec(async, true, nullptr);
+
+   st_pbo_compute_deinit(st);
+
+   EXPECT_TRUE(driver.deleted.empty());
+}
+
+/* A specialization queued on the driver thread but not yet cloned owns
+ * nothing of its own, and equally has no compute state to delete.
+ */
+TEST_F(pbo_compute_deinit, pending_specialization_is_not_deleted)
+{
+   struct pbo_async_data *async = add_async(1);
+   add_spec(async, false, nullptr);
+
+   st_pbo_compute_deinit(st);
+
+   EXPECT_TRUE(driver.deleted.empty());
+}
+
+/* Compiled shaders are still released, both the generic one and the
+ * specializations.
+ */
+TEST_F(pbo_compute_deinit, compiled_shaders_are_deleted)
+{
+   struct pbo_async_data *async = add_async(1);
+   int generic = 0, specialized = 0;
+   async->cs = reinterpret_cast<struct pipe_shader_state *>(&generic);
+   add_spec(async, true, &specialized);
+   add_spec(async, true, nullptr);
+
+   st_pbo_compute_deinit(st);
+
+   ASSERT_EQ(driver.deleted.size(), 2u);
+   EXPECT_NE(std::find(driver.deleted.begin(), driver.deleted.end(), &generic),
+             driver.deleted.end());
+   EXPECT_NE(std::find(driver.deleted.begin(), driver.deleted.end(), &specialized),
+             driver.deleted.end());
+}
+
+} // namespace
