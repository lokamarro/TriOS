+#ifndef ST_PBO_COMPUTE_H
+#define ST_PBO_COMPUTE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "pipe/p_defines.h"
+#include "util/set.h"
+#include "util/u_queue.h"
+
+struct nir_shader;
+struct pipe_shader_state;
+struct st_context;
+
+/* One specialization of a pixel-transfer conversion shader.
+ *
+ * The specialized NIR is cloned on a driver thread, so `created` reports only
+ * that `nir` is this entry's own clone. The compute state is compiled later,
+ * on the next download that picks this specialization up, so `cs` stays NULL
+ * until then and is the only field that says whether one exists.
+ */
+struct pbo_spec_async_data {
+   uint32_t data[4]; //must be first
+   bool created;
+   unsigned uses;
+   struct util_queue_fence fence;
+   struct nir_shader *nir;
+   void *cs;
+};
+
+struct pbo_async_data {
+   struct st_context *st;
+   enum pipe_texture_target target;
+   unsigned num_components;
+   struct util_queue_fence fence;
+   struct nir_shader *nir;
+   struct nir_shader *copy; //immutable
+   struct pipe_shader_state *cs;
+   struct set specialized;
+};
+
+#endif /* ST_PBO_COMPUTE_H */
