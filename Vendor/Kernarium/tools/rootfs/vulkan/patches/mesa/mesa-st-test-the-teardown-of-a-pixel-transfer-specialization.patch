From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 7 Sep 2026 20:13:28 +0900
Subject: [PATCH] mesa/st: test the teardown of a pixel-transfer specialization

A specialized pixel-transfer conversion shader is prepared in two steps: a
driver thread clones the conversion NIR and inlines the specialization
constants into it, which sets `created`, and a later download of the same
shape compiles that clone into a compute state. Teardown read `created` as if
it also meant a compute state existed and handed `spec->cs` to
pipe_context::delete_compute_state, so a specialization whose clone finished
but which no later download picked up passed NULL to a hook that dereferences
its argument at once in every driver.

Mesa 26.2.6 carries the fix itself: teardown frees the clone when `created`
and deletes the compute state only when `spec->cs` is set. This topic keeps
what upstream lacks. The two structures move to a private header so
st_pbo_compute_deinit can be driven directly by a test, which covers an
uncompiled specialization, one still queued, and compiled shaders, which must
still be released.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/mesa/state_tracker/st_pbo_compute.c       |  21 +--
 src/mesa/state_tracker/st_pbo_compute.h       |  65 +++++++
 src/mesa/state_tracker/tests/meson.build      |  14 ++
 .../tests/st_pbo_compute_deinit.cpp           | 159 ++++++++++++++++++
 4 files changed, 239 insertions(+), 20 deletions(-)
 create mode 100644 src/mesa/state_tracker/st_pbo_compute.h
 create mode 100644 src/mesa/state_tracker/tests/st_pbo_compute_deinit.cpp

diff --git a/src/mesa/state_tracker/st_pbo_compute.c b/src/mesa/state_tracker/st_pbo_compute.c
index cfd14f0c010eae4977c1153097d4c7b0f4bcdb0f..7c9ea0938b44940d331121a51fc222eb9f512ca6 100644
--- a/src/mesa/state_tracker/st_pbo_compute.c
+++ b/src/mesa/state_tracker/st_pbo_compute.c
@@ -32,6 +32,7 @@
 #include "state_tracker/st_nir.h"
 #include "state_tracker/st_format.h"
 #include "state_tracker/st_pbo.h"
+#include "state_tracker/st_pbo_compute.h"
 #include "state_tracker/st_program.h"
 #include "state_tracker/st_texture.h"
 #include "compiler/nir/nir_builder.h"
@@ -43,26 +44,6 @@
 
 #define SPEC_USES_THRESHOLD 5
 
-struct pbo_spec_async_data {
-   uint32_t data[4]; //must be first
-   bool created;
-   unsigned uses;
-   struct util_queue_fence fence;
-   nir_shader *nir;
-   void *cs;
-};
-
-struct pbo_async_data {
-   struct st_context *st;
-   enum pipe_texture_target target;
-   unsigned num_components;
-   struct util_queue_fence fence;
-   nir_shader *nir;
-   nir_shader *copy; //immutable
-   struct pipe_shader_state *cs;
-   struct set specialized;
-};
-
 #define BGR_FORMAT(NAME) \
     {{ \
      [0] = PIPE_FORMAT_##NAME##_SNORM, \
diff --git a/src/mesa/state_tracker/st_pbo_compute.h b/src/mesa/state_tracker/st_pbo_compute.h
new file mode 100644
index 0000000000000000000000000000000000000000..926750a312c6e27a18e321d5dbd448664bcedcb7
--- /dev/null
+++ b/src/mesa/state_tracker/st_pbo_compute.h
@@ -0,0 +1,65 @@
