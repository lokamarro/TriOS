diff --git a/src/gallium/auxiliary/util/u_blitter_transfer_test.cpp b/src/gallium/auxiliary/util/u_blitter_transfer_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6ef00acfd41c911070b3a42dc58c9207104739b7
--- /dev/null
+++ b/src/gallium/auxiliary/util/u_blitter_transfer_test.cpp
@@ -0,0 +1,249 @@
+/* SPDX-License-Identifier: MIT */
+
+/* A pixel transfer saturates an integer into the destination range. The
+ * generated blit shader hands the sampled value to a colour attachment, which
+ * keeps only the destination's low bits, so only conversions that need no
+ * saturation survive a blit. Check that the reported conversions are exactly
+ * the ones a blit cannot carry.
+ */
+
+#include "compiler/nir/nir_builder.h"
+#include "util/format/u_format.h"
+#include "util/u_blit_shader_test.h"
+#include "util/u_simple_shaders.h"
+#include <vector>
+
+namespace {
+
+const struct util_format_channel_description &
+first_channel(const struct util_format_description *desc)
+{
+   return desc->channel[util_format_get_first_non_void_channel(desc->format)];
+}
+
+int64_t
+channel_min(const struct util_format_channel_description &channel)
+{
+   return channel.type == UTIL_FORMAT_TYPE_SIGNED ?
+      -(int64_t(1) << (channel.size - 1)) : 0;
+}
+
+int64_t
+channel_max(const struct util_format_channel_description &channel)
+{
+   return channel.type == UTIL_FORMAT_TYPE_SIGNED ?
+      (int64_t(1) << (channel.size - 1)) - 1 : (int64_t(1) << channel.size) - 1;
+}
+
+/* What GL stores: the source value saturated into the destination range. */
+int64_t
+saturate_to_channel(int64_t value, const struct util_format_channel_description &channel)
+{
+   return std::min(std::max(value, channel_min(channel)), channel_max(channel));
+}
+
+/* What a colour attachment stores: the low bits of the fragment's output. */
+int64_t
+attachment_store(uint32_t value, const struct util_format_channel_description &channel)
+{
+   const uint64_t kept = value & ((uint64_t(1) << channel.size) - 1);
+   if (channel.type == UTIL_FORMAT_TYPE_SIGNED &&
+       (kept >> (channel.size - 1)) & 1)
+      return int64_t(kept) - (int64_t(1) << channel.size);
+   return int64_t(kept);
+}
+
+struct conversion {
+   pipe_format src;
+   pipe_format dst;
+   const char *transfer;   /* the packed_pixels transfer it comes from */
+};
+
+/* Source and destination formats that KHR-GL46.packed_pixels asks for. */
+const conversion saturating[] = {
+   {PIPE_FORMAT_R8_UINT, PIPE_FORMAT_R8G8B8A8_SINT, "rgb8i from RED_INTEGER/UNSIGNED_BYTE"},
+   {PIPE_FORMAT_R16_UINT, PIPE_FORMAT_R8G8B8A8_SINT, "rgb8i from RED_INTEGER/UNSIGNED_SHORT"},
+   {PIPE_FORMAT_R32_UINT, PIPE_FORMAT_R8G8B8A8_SINT, "rgb8i from RED_INTEGER/UNSIGNED_INT"},
+   {PIPE_FORMAT_R16_SINT, PIPE_FORMAT_R8_UINT, "r8ui from RED_INTEGER/SHORT"},
+   {PIPE_FORMAT_R16G16_SINT, PIPE_FORMAT_R8G8B8A8_UINT, "rgba8ui from RG_INTEGER/SHORT"},
+   {PIPE_FORMAT_R32G32_UINT, PIPE_FORMAT_R8_SINT, "rg32ui read as RED_INTEGER/BYTE"},
+   {PIPE_FORMAT_R32G32B32A32_UINT, PIPE_FORMAT_R16_SINT, "r16i from RGBA_INTEGER/UNSIGNED_INT"},
+   {PIPE_FORMAT_R32G32B32A32_SINT, PIPE_FORMAT_R16_SINT, "rgb32i read as RED_INTEGER/SHORT"},
+   {PIPE_FORMAT_R8G8_SINT, PIPE_FORMAT_R10G10B10A2_UINT, "rgb10_a2ui from RG_INTEGER/BYTE"},
+};
+
+/* Transfers that need no saturation and must keep using a blit. */
+const conversion blittable[] = {
+   {PIPE_FORMAT_R8_SINT, PIPE_FORMAT_R8_SINT, "r8i staging copy"},
+   {PIPE_FORMAT_R8G8B8A8_UINT, PIPE_FORMAT_R8G8B8A8_UINT, "rgba8ui staging copy"},
+   {PIPE_FORMAT_R32G32_SINT, PIPE_FORMAT_R32G32_SINT, "rg32i staging copy"},
+};
+
+/* Transfers through a floating-point or normalized format keep their defined
+ * blit behaviour.
+ */
+const conversion unchanged[] = {
+   {PIPE_FORMAT_R8G8B8A8_UNORM, PIPE_FORMAT_R16G16B16A16_FLOAT, "rgba16f from RGBA/UNSIGNED_BYTE"},
+   {PIPE_FORMAT_R32_FLOAT, PIPE_FORMAT_R8G8B8A8_UNORM, "rgba8 from RED/FLOAT"},
+   {PIPE_FORMAT_Z24_UNORM_S8_UINT, PIPE_FORMAT_Z24_UNORM_S8_UINT, "depth24_stencil8 staging copy"},
+};
+
+class integer_transfer : public blit_shader_fixture {
+protected:
+   /* Run one source value through the generated blit shader and return what
+    * the destination attachment ends up holding.
+    */
+   void run(pipe_format src, pipe_format dst, int64_t value, int64_t result[4])
+   {
+      const struct util_format_description *src_desc = util_format_description(src);
+      const struct util_format_description *dst_desc = util_format_description(dst);
+      const tgsi_return_type stype = util_format_is_pure_sint(src) ?
+         TGSI_RETURN_TYPE_SINT : TGSI_RETURN_TYPE_UINT;
+      const tgsi_return_type dtype = util_format_is_pure_sint(dst) ?
+         TGSI_RETURN_TYPE_SINT : TGSI_RETURN_TYPE_UINT;
+
+      ralloc_free(shader);
+      shader = nullptr;
+      ASSERT_NE(util_make_fragment_tex_shader(&pipe, TGSI_TEXTURE_2D, stype, dtype,
+                                              true, false), nullptr);
+      ASSERT_NE(shader, nullptr);
+
+      /* Replace the sampled texel with the source value the texture holds. A
+       * sampler hands an integer texel over sign- or zero-extended.
+       */
+      const uint32_t payload = uint32_t(value & 0xffffffffu);
+      unsigned samples = 0;
+      nir_builder b = nir_builder_create(nir_shader_get_entrypoint(shader));
+      nir_foreach_block(block, b.impl) {
+         nir_foreach_instr_safe(instr, block) {
+            if (instr->type != nir_instr_type_tex)
+               continue;
+            nir_tex_instr *tex = nir_instr_as_tex(instr);
+            if (nir_tex_instr_is_query(tex))
+               continue;
+            ++samples;
+            b.cursor = nir_before_instr(instr);
+            nir_def *texel = nir_imm_ivec4(&b, payload, payload, payload, payload);
+            nir_def_rewrite_uses(&tex->def, texel);
+            nir_instr_remove(instr);
+         }
+      }
+      ASSERT_EQ(samples, 1u);
+
+      bool progress;
+      do {
+         progress = false;
+         NIR_PASS(progress, shader, nir_opt_copy_prop);
+         NIR_PASS(progress, shader, nir_opt_constant_folding);
+         NIR_PASS(progress, shader, nir_opt_dce);
+      } while (progress);
+
+      unsigned stores = 0;
+      nir_foreach_block(block, b.impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            auto *intr = nir_instr_as_intrinsic(instr);
+            nir_src *stored;
+            if (intr->intrinsic == nir_intrinsic_store_deref) {
+               if (nir_intrinsic_get_var(intr, 0)->data.mode != nir_var_shader_out)
+                  continue;
+               stored = &intr->src[1];
+            } else if (intr->intrinsic == nir_intrinsic_store_output) {
+               stored = &intr->src[0];
+            } else {
+               continue;
+            }
+            ++stores;
+            ASSERT_TRUE(nir_src_is_const(*stored));
+            const nir_const_value *values = nir_src_as_const_value(*stored);
+            for (unsigned c = 0; c < 4; ++c) {
+               result[c] = dst_desc->channel[c].size ?
+                  attachment_store(values[c].u32, dst_desc->channel[c]) : 0;
+            }
+         }
+      }
+      ASSERT_EQ(stores, 1u);
+      (void)src_desc;
+   }
+
+   /* Whether a blit reproduces the transfer for every representable source
+    * value the destination has to saturate.
+    */
+   bool blit_reproduces_transfer(pipe_format src, pipe_format dst)
+   {
+      const struct util_format_description *src_desc = util_format_description(src);
+      const struct util_format_description *dst_desc = util_format_description(dst);
+      const struct util_format_channel_description &src_channel = first_channel(src_desc);
+
+      /* The ends of the source range, plus every destination range boundary
+       * the source can step over.
+       */
+      std::vector<int64_t> values = {channel_min(src_channel), 0,
+                                     channel_max(src_channel)};
+      for (unsigned c = 0; c < 4; ++c) {
+         if (!dst_desc->channel[c].size)
+            continue;
+         for (int64_t past : {channel_max(dst_desc->channel[c]) + 1,
+                              channel_min(dst_desc->channel[c]) - 1}) {
+            if (past >= channel_min(src_channel) &&
+                past <= channel_max(src_channel))
+               values.push_back(past);
+         }
+      }
+
+      for (int64_t value : values) {
+         int64_t stored[4] = {};
+         run(src, dst, value, stored);
+         if (::testing::Test::HasFatalFailure())
+            return false;
+         for (unsigned c = 0; c < 4; ++c) {
+            if (!dst_desc->channel[c].size)
+               continue;
+            if (stored[c] != saturate_to_channel(value, dst_desc->channel[c]))
+               return false;
+         }
+      }
+      return true;
+   }
+};
+
+TEST_F(integer_transfer, blitted_conversions_are_exact)
+{
+   for (const auto &c : saturating) {
+      SCOPED_TRACE(c.transfer);
+      if (util_format_is_pure_integer_conversion(c.src, c.dst))
+         continue;   /* stored without a blit */
+      EXPECT_TRUE(blit_reproduces_transfer(c.src, c.dst))
+         << "a blit is used for a transfer it cannot carry";
+   }
+   for (const auto &c : blittable) {
+      SCOPED_TRACE(c.transfer);
+      ASSERT_FALSE(util_format_is_pure_integer_conversion(c.src, c.dst));
+      EXPECT_TRUE(blit_reproduces_transfer(c.src, c.dst));
+   }
+}
+
+TEST_F(integer_transfer, saturating_conversions_are_reported)
+{
+   for (const auto &c : saturating) {
+      SCOPED_TRACE(c.transfer);
+      EXPECT_TRUE(util_format_is_pure_integer_conversion(c.src, c.dst));
+      /* The report is worth making: the blit really does lose these. */
+      EXPECT_FALSE(blit_reproduces_transfer(c.src, c.dst));
+   }
+}
+
+TEST_F(integer_transfer, matching_and_non_integer_transfers_are_unchanged)
+{
+   for (const auto &c : blittable) {
+      SCOPED_TRACE(c.transfer);
+      EXPECT_FALSE(util_format_is_pure_integer_conversion(c.src, c.dst));
+   }
+   for (const auto &c : unchanged) {
+      SCOPED_TRACE(c.transfer);
+      EXPECT_FALSE(util_format_is_pure_integer_conversion(c.src, c.dst));
+   }
+}
+
+}  // namespace
