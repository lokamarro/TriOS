diff --git a/src/virtio/vulkan/vn_pipeline.c b/src/virtio/vulkan/vn_pipeline.c
index e4204caf371aba50b9029a12333c6290dfce3337..b07fe5ecde323cbf818470fedffbef076b2772d9 100644
--- a/src/virtio/vulkan/vn_pipeline.c
+++ b/src/virtio/vulkan/vn_pipeline.c
@@ -543,6 +543,168 @@ vn_MergePipelineCaches(VkDevice device,
    return VK_SUCCESS;
 }
 
+/* pipeline binary commands */
+
+static void
+vn_pipeline_binary_destroy(struct vn_device *dev,
+                           const VkAllocationCallbacks *alloc,
+                           VkPipelineBinaryKHR binary_handle,
+                           bool destroy_on_renderer)
+{
+   struct vn_pipeline_binary *binary =
+      vn_pipeline_binary_from_handle(binary_handle);
+   if (!binary)
+      return;
+
+   if (destroy_on_renderer) {
+      vn_async_vkDestroyPipelineBinaryKHR(
+         dev->primary_ring, vn_device_to_handle(dev), binary_handle, NULL);
+   }
+
+   vn_object_base_fini(&binary->base);
+   vk_free(alloc, binary);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+vn_CreatePipelineBinariesKHR(VkDevice device,
+                             const VkPipelineBinaryCreateInfoKHR *pCreateInfo,
+                             const VkAllocationCallbacks *pAllocator,
+                             VkPipelineBinaryHandlesInfoKHR *pBinaries)
+{
+   struct vn_device *dev = vn_device_from_handle(device);
+   const VkAllocationCallbacks *alloc =
+      pAllocator ? pAllocator : &dev->base.vk.alloc;
+
+   struct vn_ring *target_ring = vn_get_target_ring(dev);
+   if (!target_ring)
+      return vn_error(dev->instance, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   /* An application asks how many binaries a pipeline yields by offering no
+    * handle array at all. Such a query names no objects and creates none.
+    */
+   if (!pBinaries->pPipelineBinaries) {
+      const VkResult result = vn_call_vkCreatePipelineBinariesKHR(
+         target_ring, device, pCreateInfo, NULL, pBinaries);
+      return result < VK_SUCCESS ? vn_error(dev->instance, result) : result;
+   }
+
+   const uint32_t count = pBinaries->pipelineBinaryCount;
+
+   /* The renderer answers with the handles the host driver filled, which can
+    * be fewer than were offered, so keep our own list to release the objects
+    * it did not take.
+    */
+   VkPipelineBinaryKHR *handles =
+      vk_alloc(alloc, sizeof(*handles) * count, VN_DEFAULT_ALIGN,
+               VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+   if (!handles)
+      return vn_error(dev->instance, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   for (uint32_t i = 0; i < count; i++) {
+      struct vn_pipeline_binary *binary =
+         vk_zalloc(alloc, sizeof(*binary), VN_DEFAULT_ALIGN,
+                   VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+      if (!binary) {
+         for (uint32_t j = 0; j < i; j++)
+            vn_pipeline_binary_destroy(dev, alloc, handles[j], false);
+         vk_free(alloc, handles);
+         return vn_error(dev->instance, VK_ERROR_OUT_OF_HOST_MEMORY);
+      }
+
+      vn_object_base_init(&binary->base, VK_OBJECT_TYPE_PIPELINE_BINARY_KHR,
+                          &dev->base);
+      handles[i] = vn_pipeline_binary_to_handle(binary);
+      pBinaries->pPipelineBinaries[i] = handles[i];
+   }
+
+   const VkResult result = vn_call_vkCreatePipelineBinariesKHR(
+      target_ring, device, pCreateInfo, NULL, pBinaries);
+
+   /* On failure the renderer created nothing and reported no count, so every
+    * object goes back without a destroy crossing the ring.
+    */
+   const uint32_t created = result < VK_SUCCESS
+                               ? 0u
+                               : MIN2(count, pBinaries->pipelineBinaryCount);
+   for (uint32_t i = 0; i < count; i++) {
+      if (i < created && pBinaries->pPipelineBinaries[i] == handles[i])
+         continue;
+
+      vn_pipeline_binary_destroy(dev, alloc, handles[i], false);
+      if (i < created)
+         pBinaries->pPipelineBinaries[i] = VK_NULL_HANDLE;
+   }
+
+   if (result < VK_SUCCESS) {
+      pBinaries->pipelineBinaryCount = 0;
+      memset(pBinaries->pPipelineBinaries, 0,
+             sizeof(*pBinaries->pPipelineBinaries) * count);
+   }
+
+   vk_free(alloc, handles);
+
+   return result < VK_SUCCESS ? vn_error(dev->instance, result) : result;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+vn_DestroyPipelineBinaryKHR(VkDevice device,
+                            VkPipelineBinaryKHR pipelineBinary,
+                            const VkAllocationCallbacks *pAllocator)
+{
+   struct vn_device *dev = vn_device_from_handle(device);
+   const VkAllocationCallbacks *alloc =
+      pAllocator ? pAllocator : &dev->base.vk.alloc;
+
+   vn_pipeline_binary_destroy(dev, alloc, pipelineBinary, true);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+vn_GetPipelineKeyKHR(VkDevice device,
+                     const VkPipelineCreateInfoKHR *pPipelineCreateInfo,
+                     VkPipelineBinaryKeyKHR *pPipelineKey)
+{
+   struct vn_device *dev = vn_device_from_handle(device);
+
+   const VkResult result = vn_call_vkGetPipelineKeyKHR(
+      dev->primary_ring, device, pPipelineCreateInfo, pPipelineKey);
+
+   return result < VK_SUCCESS ? vn_error(dev->instance, result) : result;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+vn_GetPipelineBinaryDataKHR(VkDevice device,
+                            const VkPipelineBinaryDataInfoKHR *pInfo,
+                            VkPipelineBinaryKeyKHR *pPipelineBinaryKey,
+                            size_t *pPipelineBinaryDataSize,
+                            void *pPipelineBinaryData)
+{
+   struct vn_device *dev = vn_device_from_handle(device);
+
+   struct vn_ring *target_ring = vn_get_target_ring(dev);
+   if (!target_ring)
+      return vn_error(dev->instance, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   const VkResult result = vn_call_vkGetPipelineBinaryDataKHR(
+      target_ring, device, pInfo, pPipelineBinaryKey, pPipelineBinaryDataSize,
+      pPipelineBinaryData);
+
+   return result < VK_SUCCESS ? vn_error(dev->instance, result) : result;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+vn_ReleaseCapturedPipelineDataKHR(
+   VkDevice device,
+   const VkReleaseCapturedPipelineDataInfoKHR *pInfo,
+   const VkAllocationCallbacks *pAllocator)
+{
+   struct vn_device *dev = vn_device_from_handle(device);
+
+   vn_async_vkReleaseCapturedPipelineDataKHR(dev->primary_ring, device, pInfo,
+                                             NULL);
+
+   return VK_SUCCESS;
+}
+
 /* pipeline commands */
 
 static struct vn_graphics_pipeline *
