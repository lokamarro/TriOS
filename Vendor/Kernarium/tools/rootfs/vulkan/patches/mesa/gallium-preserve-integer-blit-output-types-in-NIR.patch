+/* SPDX-License-Identifier: MIT */
+
+/* A pipe screen and context for the tests of the generated blit shaders. The
+ * screen's fragment stage takes integers and one shader IR, and the fixture
+ * keeps the fragment shader the context is handed, as NIR.
+ */
+
+#ifndef U_BLIT_SHADER_TEST_H
+#define U_BLIT_SHADER_TEST_H
+
+#include "compiler/nir/nir.h"
+#include "nir/tgsi_to_nir.h"
+#include "pipe/p_context.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include <gtest/gtest.h>
+#include <utility>
+
+static inline pipe_caps
+blit_caps()
+{
+   pipe_caps caps = {};
+   caps.nir_samplers_as_deref = true;
+   caps.texrect = true;
+   return caps;
+}
+
+static inline pipe_shader_caps
+blit_shader_caps(unsigned stage, bool use_nir)
+{
+   pipe_shader_caps caps = {};
+   if (stage == MESA_SHADER_FRAGMENT) {
+      caps.integers = true;
+      caps.supported_irs = 1 << (use_nir ? PIPE_SHADER_IR_NIR : PIPE_SHADER_IR_TGSI);
+   }
+   return caps;
+}
+
+template<unsigned... Stages>
+static pipe_screen
+blit_screen(bool use_nir, std::integer_sequence<unsigned, Stages...>)
+{
+   return {.caps = blit_caps(),
+           .shader_caps = {blit_shader_caps(Stages, use_nir)...}};
+}
+
+using shader_stages = std::make_integer_sequence<unsigned, MESA_SHADER_MESH_STAGES>;
+
+class blit_shader_fixture : public ::testing::Test {
+protected:
+   pipe_screen screen = blit_screen(true, shader_stages{});
+   pipe_context pipe = {};
+   nir_shader_compiler_options options = {};
+   nir_shader *shader = nullptr;
+   pipe_shader_ir received_ir = PIPE_SHADER_IR_TGSI;
+
+   void SetUp() override
+   {
+      glsl_type_singleton_init_or_ref();
+      screen.nir_options[MESA_SHADER_FRAGMENT] = &options;
+      pipe.screen = &screen;
+      pipe.priv = this;
+      pipe.create_fs_state = [](pipe_context *ctx, const pipe_shader_state *state) -> void * {
+         auto *test = static_cast<blit_shader_fixture *>(ctx->priv);
+         test->received_ir = state->type;
+         test->shader = state->type == PIPE_SHADER_IR_NIR ? state->ir.nir :
+            tgsi_to_nir(state->tokens, ctx->screen, false);
+         return test->shader;
+      };
+   }
+
+   void TearDown() override
+   {
+      ralloc_free(shader);
+      glsl_type_singleton_decref();
+   }
+};
+
+#endif /* U_BLIT_SHADER_TEST_H */
