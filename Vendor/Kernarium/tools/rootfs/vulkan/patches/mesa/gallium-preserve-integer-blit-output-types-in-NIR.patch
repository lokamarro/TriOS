+static void *
+create_fs_with_color_type(struct pipe_context *pipe,
+                          const struct tgsi_token *tokens,
+                          nir_alu_type color_type)
+{
+   if (!tokens)
+      return NULL;
+
+   struct pipe_shader_state state = {0};
+   pipe_shader_state_from_tgsi(&state, tokens);
+   if ((color_type == nir_type_int32 || color_type == nir_type_uint32) &&
+       (pipe->screen->shader_caps[MESA_SHADER_FRAGMENT].supported_irs &
+        (1 << PIPE_SHADER_IR_NIR))) {
+      /* TGSI color outputs are untyped. Integer blits know their destination
+       * type, so retain it in NIR before a typed backend consumes the shader.
+       * The existing signedness clamp and payload bits remain unchanged.
+       */
+      state.type = PIPE_SHADER_IR_NIR;
+      state.ir.nir = tgsi_to_nir_typed_fs(tokens, pipe->screen, color_type);
+   }
+   return pipe->create_fs_state(pipe, &state);
+}
+
+static nir_alu_type
+color_return_type(enum tgsi_return_type type)
+{
+   if (type == TGSI_RETURN_TYPE_SINT)
+      return nir_type_int32;
+   if (type == TGSI_RETURN_TYPE_UINT)
+      return nir_type_uint32;
+   assert(type == TGSI_RETURN_TYPE_FLOAT);
+   return nir_type_float32;
+}
+
