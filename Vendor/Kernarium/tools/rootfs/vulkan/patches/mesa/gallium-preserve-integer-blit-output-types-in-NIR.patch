+static nir_shader *
+ttn_translate(const void *tgsi_tokens, struct pipe_screen *screen,
+              nir_alu_type color_type)
+{
+   struct ttn_compile *c = ttn_compile_init(tgsi_tokens, NULL, screen);
+   nir_shader *s = c->build.shader;
+
+   if (color_type != nir_type_invalid) {
+      assert(s->info.stage == MESA_SHADER_FRAGMENT);
+      assert(color_type == nir_type_int32 || color_type == nir_type_uint32 ||
+             color_type == nir_type_float32);
+      const enum glsl_base_type base =
+         nir_get_glsl_base_type_for_nir_type(color_type);
+      nir_foreach_variable_with_modes(var, s, nir_var_shader_out) {
+         if (var->data.location != FRAG_RESULT_COLOR &&
+             (var->data.location < FRAG_RESULT_DATA0 ||
+              var->data.location > FRAG_RESULT_DATA7))
+            continue;
+         const glsl_type *type = glsl_vector_type(
+            base, glsl_get_vector_elements(glsl_without_array(var->type)));
+         var->type = glsl_type_wrap_in_arrays(type, var->type);
+      }
+      nir_fixup_deref_types(s);
+      s->info.fs.untyped_color_outputs = false;
+   }
+
+   ttn_finalize_nir(c, screen);
+   ralloc_free(c);
+   return s;
+}
+
+struct nir_shader *
+tgsi_to_nir_typed_fs(const void *tgsi_tokens, struct pipe_screen *screen,
+                     nir_alu_type color_type)
+{
+   /* The caller's live shader cache includes the resulting typed NIR. Do not
+    * alias the ordinary TGSI disk-cache entry, whose color type is unknown.
+    */
+   assert(color_type != nir_type_invalid);
+   return ttn_translate(tgsi_tokens, screen, color_type);
+}
