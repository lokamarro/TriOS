diff --git a/src/gallium/auxiliary/util/u_simple_shaders_test.cpp b/src/gallium/auxiliary/util/u_simple_shaders_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..75f7e56bfaccab0eb016e7940e8b74a4c5d93903
--- /dev/null
+++ b/src/gallium/auxiliary/util/u_simple_shaders_test.cpp
@@ -0,0 +1,167 @@
+/* SPDX-License-Identifier: MIT */
+
+#include "compiler/nir/nir_builder.h"
+#include "util/u_blit_shader_test.h"
+#include "util/u_simple_shaders.h"
+
+class typed_blit : public blit_shader_fixture {
+protected:
+   void check(tgsi_return_type src_type, tgsi_return_type dst_type,
+              unsigned mode)
+   {
+      ralloc_free(shader);
+      shader = nullptr;
+      if (mode < 2) {
+         ASSERT_NE(util_make_fragment_tex_shader(&pipe, TGSI_TEXTURE_2D,
+                                                src_type, dst_type,
+                                                mode == 0, false), nullptr);
+      } else {
+         ASSERT_NE(util_make_fs_blit_msaa_color(&pipe, TGSI_TEXTURE_2D_MSAA,
+                                              src_type, dst_type,
+                                              mode == 3, true, false), nullptr);
+      }
+      ASSERT_NE(shader, nullptr);
+      EXPECT_EQ(received_ir, PIPE_SHADER_IR_NIR);
+      EXPECT_FALSE(shader->info.fs.untyped_color_outputs);
+      nir_validate_shader(shader, "typed integer blit");
+
+      unsigned outputs = 0;
+      nir_foreach_variable_with_modes(var, shader, nir_var_shader_out) {
+         ++outputs;
+         EXPECT_EQ(glsl_get_base_type(var->type),
+                   dst_type == TGSI_RETURN_TYPE_SINT ? GLSL_TYPE_INT : GLSL_TYPE_UINT);
+      }
+      ASSERT_EQ(outputs, 1u);
+
+      /* Replace only the sample result. Constant folding then checks the real
+       * generated signedness clamp and exact payload bits, not a host oracle
+       * substituted for the shader's arithmetic. */
+      const uint32_t input[4] = {0, 18, 0x7fffffff, 0xffffffff};
+      uint32_t expected[4] = {0, 18, 0x7fffffff, 0xffffffff};
+      if (src_type != dst_type)
+         expected[3] = src_type == TGSI_RETURN_TYPE_SINT ? 0 : 0x7fffffff;
+      unsigned samples = 0;
+      nir_builder b = nir_builder_create(nir_shader_get_entrypoint(shader));
+      nir_foreach_block(block, b.impl) {
+         nir_foreach_instr_safe(instr, block) {
+            if (instr->type != nir_instr_type_tex)
+               continue;
+            nir_tex_instr *tex = nir_instr_as_tex(instr);
+            if (nir_tex_instr_is_query(tex))
+               continue;
+            ++samples;
+            EXPECT_EQ(tex->dest_type, src_type == TGSI_RETURN_TYPE_SINT ?
+                      nir_type_int32 : nir_type_uint32);
+            b.cursor = nir_before_instr(instr);
+            nir_def *value = nir_imm_ivec4(&b, input[0], input[1], input[2], input[3]);
+            nir_def_rewrite_uses(&tex->def, value);
+            nir_instr_remove(instr);
+         }
+      }
+      ASSERT_EQ(samples, 1u);
+      bool progress;
+      do {
+         progress = false;
+         NIR_PASS(progress, shader, nir_opt_copy_prop);
+         NIR_PASS(progress, shader, nir_opt_constant_folding);
+         NIR_PASS(progress, shader, nir_opt_dce);
+      } while (progress);
+
+      unsigned stores = 0;
+      nir_foreach_block(block, b.impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            auto *intr = nir_instr_as_intrinsic(instr);
+            nir_src *value;
+            if (intr->intrinsic == nir_intrinsic_store_deref) {
+               auto *var = nir_intrinsic_get_var(intr, 0);
+               if (var->data.mode != nir_var_shader_out)
+                  continue;
+               value = &intr->src[1];
+            } else if (intr->intrinsic == nir_intrinsic_store_output) {
+               EXPECT_EQ(nir_intrinsic_src_type(intr),
+                         dst_type == TGSI_RETURN_TYPE_SINT ? nir_type_int32 : nir_type_uint32);
+               value = &intr->src[0];
+            } else {
+               continue;
+            }
+            ++stores;
+            ASSERT_TRUE(nir_src_is_const(*value));
+            const nir_const_value *values = nir_src_as_const_value(*value);
+            for (unsigned c = 0; c < 4; ++c)
+               EXPECT_EQ(values[c].u32, expected[c]) << "component=" << c;
+         }
+      }
+      EXPECT_EQ(stores, 1u);
+   }
+};
+
+TEST_F(typed_blit, integer_destinations)
+{
+   for (auto src : {TGSI_RETURN_TYPE_SINT, TGSI_RETURN_TYPE_UINT}) {
+      for (auto dst : {TGSI_RETURN_TYPE_SINT, TGSI_RETURN_TYPE_UINT}) {
+         for (unsigned mode = 0; mode < 4; ++mode) {
+            SCOPED_TRACE(::testing::Message() << "src=" << src << " dst=" << dst
+                                            << " mode=" << mode);
+            check(src, dst, mode);
+         }
+      }
+   }
+}
+
+TEST_F(typed_blit, tgsi_only_consumer)
+{
+   pipe_screen tgsi_screen = blit_screen(false, shader_stages{});
+   tgsi_screen.nir_options[MESA_SHADER_FRAGMENT] = &options;
+   pipe.screen = &tgsi_screen;
+   ASSERT_NE(util_make_fragment_tex_shader(&pipe, TGSI_TEXTURE_2D,
+                                          TGSI_RETURN_TYPE_SINT,
+                                          TGSI_RETURN_TYPE_UINT, true, false), nullptr);
+   EXPECT_EQ(received_ir, PIPE_SHADER_IR_TGSI);
+   EXPECT_TRUE(shader->info.fs.untyped_color_outputs);
+}
+
+TEST_F(typed_blit, types_precede_driver_io_lowering)
+{
+   screen.finalize_nir = [](pipe_screen *, nir_shader *nir, bool) {
+      nir_lower_io(nir, nir_var_shader_out, glsl_count_attribute_slots,
+                   static_cast<nir_lower_io_options>(0));
+   };
+   for (auto src : {TGSI_RETURN_TYPE_SINT, TGSI_RETURN_TYPE_UINT}) {
+      for (auto dst : {TGSI_RETURN_TYPE_SINT, TGSI_RETURN_TYPE_UINT}) {
+         for (unsigned mode = 0; mode < 4; ++mode) {
+            SCOPED_TRACE(::testing::Message() << "src=" << src << " dst=" << dst
+                                            << " mode=" << mode);
+            check(src, dst, mode);
+         }
+      }
+   }
+}
+
+TEST_F(typed_blit, float_and_depth_stencil_unchanged)
+{
+   ASSERT_NE(util_make_fragment_tex_shader(&pipe, TGSI_TEXTURE_2D,
+                                          TGSI_RETURN_TYPE_FLOAT,
+                                          TGSI_RETURN_TYPE_FLOAT, true, false), nullptr);
+   EXPECT_EQ(received_ir, PIPE_SHADER_IR_TGSI);
+   EXPECT_TRUE(shader->info.fs.untyped_color_outputs);
+   nir_foreach_variable_with_modes(var, shader, nir_var_shader_out)
+      EXPECT_EQ(glsl_get_base_type(var->type), GLSL_TYPE_FLOAT);
+   ralloc_free(shader);
+   shader = nullptr;
+
+   ASSERT_NE(util_make_fs_blit_msaa_depth(&pipe, TGSI_TEXTURE_2D_MSAA,
+                                        false, true, false), nullptr);
+   EXPECT_EQ(received_ir, PIPE_SHADER_IR_TGSI);
+   EXPECT_TRUE(shader->info.fs.untyped_color_outputs);
+   nir_validate_shader(shader, "unchanged depth blit");
+   ralloc_free(shader);
+   shader = nullptr;
+
+   ASSERT_NE(util_make_fs_blit_msaa_stencil(&pipe, TGSI_TEXTURE_2D_MSAA,
+                                          false, true, false), nullptr);
+   EXPECT_EQ(received_ir, PIPE_SHADER_IR_TGSI);
+   EXPECT_TRUE(shader->info.fs.untyped_color_outputs);
+   nir_validate_shader(shader, "unchanged stencil blit");
+}
