diff --git a/src/gallium/drivers/zink/zink_screen.h b/src/gallium/drivers/zink/zink_screen.h
index d0d502af8f2a99f50bf2e189b527fa5e57936452..83662746a7cf5b50e2eefb339a7baa388461d292 100644
--- a/src/gallium/drivers/zink/zink_screen.h
+++ b/src/gallium/drivers/zink/zink_screen.h
@@ -147,6 +147,32 @@ zink_driver_is_venus(const struct zink_screen *screen)
    return screen->info.driver_props.driverID == VK_DRIVER_ID_MESA_VENUS;
 }
 
+/* Venus shares an image with its renderer as a dma-buf that virtio-gpu
+ * exports and imports again.
+ */
+static inline bool
+zink_venus_shares_dmabuf(const struct zink_screen *screen)
+{
+   return zink_driver_is_venus(screen) &&
+          screen->info.have_KHR_external_memory_fd &&
+          screen->info.have_EXT_external_memory_dma_buf;
+}
+
+static inline bool
+zink_use_venus_implicit_dmabuf(const struct zink_screen *screen)
+{
+   return zink_venus_shares_dmabuf(screen) &&
+          !screen->info.have_EXT_image_drm_format_modifier;
+}
+
+static inline uint32_t
+zink_dmabuf_queue_family(const struct zink_screen *screen)
+{
+   return screen->info.have_EXT_queue_family_foreign
+             ? VK_QUEUE_FAMILY_FOREIGN_EXT
+             : VK_QUEUE_FAMILY_EXTERNAL;
+}
+
 void
 zink_screen_lock_context(struct zink_screen *screen);
 void
