       s->emici.pNext = ici->pNext;
       s->emici.handleTypes = alloc_info->export_types;
       assert(!(s->emici.handleTypes & VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT) ||
-             ici->tiling != VK_IMAGE_TILING_OPTIMAL);
+             ici->tiling != VK_IMAGE_TILING_OPTIMAL ||
