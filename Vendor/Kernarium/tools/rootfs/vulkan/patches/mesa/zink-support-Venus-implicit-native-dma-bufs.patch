diff --git a/src/virtio/vulkan/vn_wsi_drm.h b/src/virtio/vulkan/vn_wsi_drm.h
new file mode 100644
index 0000000000000000000000000000000000000000..1fc35f202bf11bc420253bf4d3bf049e7e06d741
--- /dev/null
+++ b/src/virtio/vulkan/vn_wsi_drm.h
@@ -0,0 +1,30 @@
+/*
+ * Copyright 2026
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VN_WSI_DRM_H
+#define VN_WSI_DRM_H
+
+#include <stdbool.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <vulkan/vulkan_core.h>
+
+static inline bool
+vn_wsi_drm_fd_matches_device(const VkPhysicalDeviceDrmPropertiesEXT *props,
+                            int fd)
+{
+   struct stat st;
+   if (fstat(fd, &st) || !S_ISCHR(st.st_mode))
+      return false;
+
+   const unsigned device_major = major(st.st_rdev);
+   const unsigned device_minor = minor(st.st_rdev);
+   return (props->hasPrimary && props->primaryMajor == device_major &&
+           props->primaryMinor == device_minor) ||
+          (props->hasRender && props->renderMajor == device_major &&
+           props->renderMinor == device_minor);
+}
+
+#endif /* VN_WSI_DRM_H */
diff --git a/src/virtio/vulkan/vn_wsi_native.h b/src/virtio/vulkan/vn_wsi_native.h
new file mode 100644
index 0000000000000000000000000000000000000000..4b234327e3f72ffe3ccb23e4ba5ae51e844d2fd8
--- /dev/null
+++ b/src/virtio/vulkan/vn_wsi_native.h
@@ -0,0 +1,118 @@
+/*
+ * Copyright 2026
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VN_WSI_NATIVE_H
+#define VN_WSI_NATIVE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <vulkan/vulkan_core.h>
+
+/* One native swapchain image is backed by one renderer blob resource, and a
+ * paired renderer bounds a single blob by its guest-visible blob window (one
+ * gibibyte).  That refusal is reported asynchronously, long after the guest
+ * kernel has answered the allocating ioctl, so an image the renderer declines
+ * would still be published to the window system as a dma-buf with no resource
+ * behind it and would wedge whichever compositor imports it.  Keep a native
+ * swapchain image inside a budget the renderer can always serve instead: the
+ * dimension bound keeps even an eight-byte envelope format at half the
+ * window, and the size bound covers the renderer's own image padding.  The
+ * budget applies to what a surface advertises as its maximum image extent; an
+ * ordinary image keeps the device's own maxImageDimension2D.
+ */
+#define VN_WSI_NATIVE_MAX_IMAGE_DIMENSION 8192u
+#define VN_WSI_NATIVE_MAX_IMAGE_SIZE (768ull * 1024ull * 1024ull)
+
+static inline bool
+vn_wsi_native_image_within_budget(const VkImageCreateInfo *info,
+                                  VkDeviceSize allocation_size)
+{
+   return info->extent.width <= VN_WSI_NATIVE_MAX_IMAGE_DIMENSION &&
+          info->extent.height <= VN_WSI_NATIVE_MAX_IMAGE_DIMENSION &&
+          allocation_size <= VN_WSI_NATIVE_MAX_IMAGE_SIZE;
+}
+
+/* Implicit native-heap imports preserve the opaque image layout.  The window
+ * system's legacy envelope nevertheless requires a logical row pitch and an
+ * allocation large enough for that envelope.  Both linux-dmabuf and DRI3
+ * bound the image's width, height and total allocation, and both carry the
+ * pitch itself as a 32-bit value.  A legacy DRI3 v1.0 pixmap request that
+ * cannot express a wide image's stride is a common-WSI limitation shared with
+ * its own prime images, so the envelope does not bound the pitch further.
+ * This is not a Vulkan linear subresource layout or a DRM format modifier.
+ */
+static inline bool
+vn_wsi_native_heap_row_pitch(const VkImageCreateInfo *info,
+                            VkDeviceSize allocation_size,
+                            uint32_t *row_pitch)
+{
+   if (info->imageType != VK_IMAGE_TYPE_2D ||
+       info->tiling != VK_IMAGE_TILING_OPTIMAL || info->extent.depth != 1 ||
+       info->mipLevels != 1 || info->arrayLayers != 1 ||
+       info->samples != VK_SAMPLE_COUNT_1_BIT ||
+       (info->flags & (VK_IMAGE_CREATE_DISJOINT_BIT |
+                       VK_IMAGE_CREATE_SPARSE_BINDING_BIT |
+                       VK_IMAGE_CREATE_SPARSE_RESIDENCY_BIT |
+                       VK_IMAGE_CREATE_SPARSE_ALIASED_BIT)) ||
+       !info->extent.width || !info->extent.height ||
+       info->extent.width > UINT16_MAX || info->extent.height > UINT16_MAX ||
+       allocation_size > UINT32_MAX)
+      return false;
+
+   /* Only the single-plane, uncompressed color formats used by native WSI
+    * have this envelope.  In particular, depth, block-compressed and YCbCr
+    * images must not acquire an invented layout through this helper.
+    */
+   uint32_t bytes_per_pixel;
+   switch (info->format) {
+   case VK_FORMAT_R5G6B5_UNORM_PACK16:
+   case VK_FORMAT_B5G6R5_UNORM_PACK16:
+      bytes_per_pixel = 2;
+      break;
+   case VK_FORMAT_R8G8B8A8_UNORM:
+   case VK_FORMAT_R8G8B8A8_SRGB:
+   case VK_FORMAT_B8G8R8A8_UNORM:
+   case VK_FORMAT_B8G8R8A8_SRGB:
+   case VK_FORMAT_A8B8G8R8_UNORM_PACK32:
+   case VK_FORMAT_A8B8G8R8_SRGB_PACK32:
+   case VK_FORMAT_A2R10G10B10_UNORM_PACK32:
+   case VK_FORMAT_A2B10G10R10_UNORM_PACK32:
+      bytes_per_pixel = 4;
+      break;
+   case VK_FORMAT_R16G16B16A16_UNORM:
+   case VK_FORMAT_R16G16B16A16_SFLOAT:
+      bytes_per_pixel = 8;
+      break;
+   default:
+      return false;
+   }
+
+   const uint64_t stride = (uint64_t)info->extent.width * bytes_per_pixel;
+   const uint64_t size = stride * info->extent.height;
+   if (size > allocation_size)
+      return false;
+
+   *row_pitch = (uint32_t)stride;
+   return true;
+}
+
+/* A dma-buf shared with DRM_FORMAT_MOD_INVALID names no layout, so its
+ * producer and every importer have to agree on one without it.  Guest Zink
+ * reads such an import as the optimal native heap image only while the
+ * renderer has no DRM format modifiers; once it has them, Zink shares every
+ * image as DRM_FORMAT_MOD_LINEAR and reads an implicit import as linear, as
+ * upstream Venus does.  Common WSI shares an optimal native heap image
+ * implicitly through its scanout path, so take that path exactly where Zink
+ * expects one, and otherwise leave common WSI on its explicit-modifier path
+ * or its linear prime blit.
+ */
+static inline bool
+vn_wsi_native_heap_scanout(bool supports_drm_format_modifier,
+                           bool renderer_supports_metal_heap)
+{
+   return renderer_supports_metal_heap && !supports_drm_format_modifier;
+}
+
+#endif /* VN_WSI_NATIVE_H */
