       }
    } else if (alloc_info->user_mem) {
@@ -1615,7 +1657,8 @@ create_image(struct zink_screen *screen, struct zink_resource_object *obj,
    VkFormat formats[4] = {VK_FORMAT_UNDEFINED};
    VkImageFormatListCreateInfo format_list;
