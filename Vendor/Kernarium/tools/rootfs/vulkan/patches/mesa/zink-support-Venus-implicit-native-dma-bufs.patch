    return usage;
@@ -809,7 +818,9 @@ found:
 }
 
 static void
-init_ici(struct zink_screen *screen, VkImageCreateInfo *ici, const struct pipe_resource *templ, unsigned bind, unsigned modifiers_count)
+init_ici(struct zink_screen *screen, VkImageCreateInfo *ici,
