+/* A resource with one of these binds leaves the driver as a dma-buf. */
+static inline bool
+zink_bind_shares_dmabuf(unsigned bind)
+{
+   return (bind & (PIPE_BIND_SHARED | ZINK_BIND_DMABUF)) != 0;
+}
