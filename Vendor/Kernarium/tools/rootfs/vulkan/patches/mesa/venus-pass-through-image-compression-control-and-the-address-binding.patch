From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 14 Sep 2026 14:37:27 +0900
Subject: [PATCH] venus: pass through image compression control and the address
 binding report

VK_EXT_image_compression_control, its swapchain companion and
VK_EXT_device_address_binding_report gained protocol support in the local
venus-protocol series. None of the three defines a command: the control an
application chains onto an image creation or a format query now crosses the
ring, and so do the compression properties the host answers with, so the
driver carries all three by naming them in the passthrough table and chaining
their feature structures onto the query it already makes.

reportAddressBinding is carried as the renderer answers it. The renderer's
driver raises a binding report for every allocation, buffer and image plane it
binds or releases, so the feature the guest advertises is the feature the
device behind it has, and a device that enables it gets a host device that
reports. What the guest cannot yet do is deliver such a report to an
application: a report is observable only as a VK_EXT_debug_utils messenger
callback, Venus answers that extension inside the guest, and the protocol
carries nothing from the renderer to a guest callback, so a report the
renderer's driver raises has no messenger listening and stops there.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/virtio/vulkan/vn_physical_device.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/virtio/vulkan/vn_physical_device.c b/src/virtio/vulkan/vn_physical_device.c
index 034b59b4dfb026e9f17de4704bdc26f9b3501ce1..b5be4de93f825391dfd457f5d5e94843fbb4fc49 100644
--- a/src/virtio/vulkan/vn_physical_device.c
+++ b/src/virtio/vulkan/vn_physical_device.c
@@ -211,6 +211,7 @@ vn_physical_device_init_features(struct vn_physical_device *physical_dev)
          workgroup_memory_explicit_layout;
 
       /* EXT */
+      VkPhysicalDeviceAddressBindingReportFeaturesEXT address_binding_report;
       VkPhysicalDeviceAttachmentFeedbackLoopDynamicStateFeaturesEXT
          attachment_feedback_loop_dynamic_state;
       VkPhysicalDeviceAttachmentFeedbackLoopLayoutFeaturesEXT
@@ -236,6 +237,10 @@ vn_physical_device_init_features(struct vn_physical_device *physical_dev)
       VkPhysicalDeviceGraphicsPipelineLibraryFeaturesEXT
          graphics_pipeline_library;
       VkPhysicalDeviceImage2DViewOf3DFeaturesEXT image_2d_view_of_3d;
+      VkPhysicalDeviceImageCompressionControlFeaturesEXT
+         image_compression_control;
+      VkPhysicalDeviceImageCompressionControlSwapchainFeaturesEXT
+         image_compression_control_swapchain;
       VkPhysicalDeviceImageSlicedViewOf3DFeaturesEXT image_sliced_view_of_3d;
       VkPhysicalDeviceImageViewMinLodFeaturesEXT image_view_min_lod;
       VkPhysicalDeviceLegacyDitheringFeaturesEXT legacy_dithering;
@@ -389,6 +394,7 @@ vn_physical_device_init_features(struct vn_physical_device *physical_dev)
    VN_ADD_PNEXT_EXT(feats2, WORKGROUP_MEMORY_EXPLICIT_LAYOUT_FEATURES_KHR, local_feats.workgroup_memory_explicit_layout, exts->KHR_workgroup_memory_explicit_layout);
 
    /* EXT */
+   VN_ADD_PNEXT_EXT(feats2, ADDRESS_BINDING_REPORT_FEATURES_EXT, local_feats.address_binding_report, exts->EXT_device_address_binding_report);
    VN_ADD_PNEXT_EXT(feats2, ATTACHMENT_FEEDBACK_LOOP_DYNAMIC_STATE_FEATURES_EXT, local_feats.attachment_feedback_loop_dynamic_state, exts->EXT_attachment_feedback_loop_dynamic_state);
    VN_ADD_PNEXT_EXT(feats2, ATTACHMENT_FEEDBACK_LOOP_LAYOUT_FEATURES_EXT, local_feats.attachment_feedback_loop_layout, exts->EXT_attachment_feedback_loop_layout);
    VN_ADD_PNEXT_EXT(feats2, BLEND_OPERATION_ADVANCED_FEATURES_EXT, local_feats.blend_operation_advanced, exts->EXT_blend_operation_advanced);
@@ -407,6 +413,8 @@ vn_physical_device_init_features(struct vn_physical_device *physical_dev)
    VN_ADD_PNEXT_EXT(feats2, FRAGMENT_SHADER_INTERLOCK_FEATURES_EXT, local_feats.fragment_shader_interlock, exts->EXT_fragment_shader_interlock);
    VN_ADD_PNEXT_EXT(feats2, GRAPHICS_PIPELINE_LIBRARY_FEATURES_EXT, local_feats.graphics_pipeline_library, exts->EXT_graphics_pipeline_library);
    VN_ADD_PNEXT_EXT(feats2, IMAGE_2D_VIEW_OF_3D_FEATURES_EXT, local_feats.image_2d_view_of_3d, exts->EXT_image_2d_view_of_3d);
+   VN_ADD_PNEXT_EXT(feats2, IMAGE_COMPRESSION_CONTROL_FEATURES_EXT, local_feats.image_compression_control, exts->EXT_image_compression_control);
+   VN_ADD_PNEXT_EXT(feats2, IMAGE_COMPRESSION_CONTROL_SWAPCHAIN_FEATURES_EXT, local_feats.image_compression_control_swapchain, exts->EXT_image_compression_control_swapchain);
    VN_ADD_PNEXT_EXT(feats2, IMAGE_SLICED_VIEW_OF_3D_FEATURES_EXT, local_feats.image_sliced_view_of_3d, exts->EXT_image_sliced_view_of_3d);
    VN_ADD_PNEXT_EXT(feats2, IMAGE_VIEW_MIN_LOD_FEATURES_EXT, local_feats.image_view_min_lod, exts->EXT_image_view_min_lod);
    VN_ADD_PNEXT_EXT(feats2, LEGACY_DITHERING_FEATURES_EXT, local_feats.legacy_dithering, exts->EXT_legacy_dithering);
@@ -1362,6 +1370,7 @@ vn_physical_device_get_passthrough_extensions(
       .EXT_depth_clip_enable = true,
       .EXT_depth_range_unrestricted = true,
       .EXT_descriptor_heap = !VN_DEBUG(NO_DESC_HEAP),
+      .EXT_device_address_binding_report = true,
       .EXT_extended_dynamic_state3 = true,
       .EXT_dynamic_rendering_unused_attachments = true,
       .EXT_external_memory_acquire_unmodified = true,
@@ -1371,6 +1380,8 @@ vn_physical_device_get_passthrough_extensions(
       .EXT_global_priority_query = true,
       .EXT_graphics_pipeline_library = !VN_DEBUG(NO_GPL),
       .EXT_image_2d_view_of_3d = true,
+      .EXT_image_compression_control = true,
+      .EXT_image_compression_control_swapchain = true,
 #if !DETECT_OS_WINDOWS
       .EXT_image_drm_format_modifier = true,
 #endif
