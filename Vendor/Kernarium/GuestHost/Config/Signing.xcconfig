//
// Code signing shared by Kernarium and Andarium. The team is the signer's
// own, so it is not tracked: set DEVELOPMENT_TEAM in the ignored
// Signing.local.xcconfig beside this file (see Signing.local.xcconfig.example).
// With no team, builds for the iOS Simulator work unsigned and a build for a
// device stops with Xcode's "requires a development team" error.

DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
