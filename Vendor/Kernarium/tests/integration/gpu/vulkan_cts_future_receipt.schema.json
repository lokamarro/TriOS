{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uml-darwin.invalid/schemas/vulkan-cts-receipt-v2.json",
  "title": "UML Darwin receipt-backed Venus/KosmicKrisp CTS derivative",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "claim_scope",
    "base_rootfs",
    "derivative",
    "protocol",
    "mesa",
    "vulkan_headers",
    "vulkan_loader",
    "cts",
    "toolchain",
    "install_closure",
    "mustpass",
    "runner_oracle",
    "exclusions",
    "base_packages",
    "guest_receipt"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "artifact": { "const": "uml-vulkan-rootfs" },
    "claim_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "downstream_guest_mesa", "formal_conformance", "purpose"],
      "properties": {
        "backend": { "const": "venus-kosmickrisp" },
        "downstream_guest_mesa": { "const": true },
        "formal_conformance": { "const": false },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "base_rootfs": { "$ref": "#/$defs/image" },
    "derivative": { "$ref": "#/$defs/image" },
    "protocol": {
      "allOf": [
        { "$ref": "#/$defs/patchedSource" },
        {
          "type": "object",
          "required": ["patched", "generation"],
          "properties": {
            "patched": { "const": true },
            "generation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["configure_argv", "registry_sha256", "driver_headers"],
              "properties": {
                "configure_argv": {
                  "type": "array",
                  "minItems": 6,
                  "maxItems": 6,
                  "prefixItems": [
                    { "const": "meson" },
                    { "const": "setup" },
                    { "$ref": "#/$defs/protocolInputPath" },
                    { "$ref": "#/$defs/protocolInputPath" },
                    { "enum": ["--wrap-mode=nofallback", "--wrap-mode=nodownload"] },
                    { "type": "string", "pattern": "^-Dvulkan-headers-dir=(/(?!\\.\\.?(?:/|$))[^/\\u0000]+)+$" }
                  ],
                  "items": false
                },
                "registry_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "driver_headers": {
                  "type": "object",
                  "minProperties": 38,
                  "maxProperties": 38,
                  "propertyNames": { "$ref": "#/$defs/protocolDriverHeader" },
                  "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              }
            }
          }
        }
      ]
    },
    "mesa": {
      "allOf": [
        { "$ref": "#/$defs/patchedSource" },
        {
          "type": "object",
          "required": ["release", "configure_argv", "build_targets", "install_prefix", "files", "reported_api_version", "portability_driver"],
          "properties": {
            "release": { "type": "string", "minLength": 1 },
            "configure_argv": { "$ref": "#/$defs/argv" },
            "build_targets": { "$ref": "#/$defs/argv" },
            "install_prefix": { "$ref": "#/$defs/absolutePath" },
            "files": { "$ref": "#/$defs/files" },
            "reported_api_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "portability_driver": { "const": false }
          }
        }
      ]
    },
    "vulkan_headers": {
      "allOf": [
        { "$ref": "#/$defs/source" },
        {
          "type": "object",
          "required": ["release", "release_ref", "release_object", "patched", "configure_argv", "build_targets", "installed_in_guest"],
          "properties": {
            "release": { "const": "vulkan-sdk-1.4.363.0" },
            "release_ref": { "const": "vulkan-sdk-1.4.363.0" },
            "release_object": { "$ref": "#/$defs/gitObject" },
            "patched": { "const": false },
            "configure_argv": { "$ref": "#/$defs/argv" },
            "build_targets": { "$ref": "#/$defs/argv" },
            "installed_in_guest": { "const": false }
          }
        }
      ]
    },
    "vulkan_loader": {
      "allOf": [
        { "$ref": "#/$defs/source" },
        {
          "type": "object",
          "required": ["release", "release_ref", "release_object", "patched", "configure_argv", "build_targets", "install_argv", "install_prefix", "runtime", "build_id", "soname", "symlinks", "reported_api_version"],
          "properties": {
            "release": { "const": "vulkan-sdk-1.4.363.0" },
            "release_ref": { "const": "vulkan-sdk-1.4.363.0" },
            "release_object": { "$ref": "#/$defs/gitObject" },
            "patched": { "const": false },
            "configure_argv": { "$ref": "#/$defs/argv" },
            "build_targets": { "$ref": "#/$defs/argv" },
            "install_argv": { "$ref": "#/$defs/argv" },
            "install_prefix": { "const": "/usr" },
            "runtime": { "$ref": "#/$defs/file" },
            "build_id": { "$ref": "#/$defs/hex" },
            "soname": { "const": "libvulkan.so.1" },
            "symlinks": {
              "type": "object",
              "minProperties": 2,
              "maxProperties": 2,
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "reported_api_version": { "const": "1.4.363" }
          }
        }
      ]
    },
    "cts": {
      "allOf": [
        { "$ref": "#/$defs/patchedSource" },
        {
          "type": "object",
          "required": ["release", "release_ref", "release_object", "patched", "configure_argv", "build_targets", "install_prefix", "executable", "resources", "build_id", "reported_cpu", "reported_release", "reported_target"],
          "properties": {
            "release": { "type": "string", "minLength": 1 },
            "release_ref": { "type": "string", "minLength": 1 },
            "release_object": { "$ref": "#/$defs/gitObject" },
            "patched": { "const": true },
            "configure_argv": { "$ref": "#/$defs/argv" },
            "build_targets": { "$ref": "#/$defs/argv" },
            "install_prefix": { "$ref": "#/$defs/absolutePath" },
            "executable": { "$ref": "#/$defs/file" },
            "resources": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/directory" }
            },
            "build_id": { "$ref": "#/$defs/hex" },
            "reported_cpu": { "const": "DE_CPU_ARM_64" },
            "reported_release": { "type": "string", "minLength": 1 },
            "reported_target": { "const": "Default" }
          }
        }
      ]
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container_or_vm", "os", "kernel", "compiler", "meson", "cmake", "ninja"],
      "properties": {
        "container_or_vm": { "const": "native-arm64-debian-vm" },
        "os": { "type": "string", "minLength": 1 },
        "kernel": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "meson": { "type": "string", "minLength": 1 },
        "cmake": { "type": "string", "minLength": 1 },
        "ninja": { "type": "string", "minLength": 1 }
      }
    },
    "install_closure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumer", "needed", "resolved_path", "file"],
        "properties": {
          "consumer": { "$ref": "#/$defs/absolutePath" },
          "needed": { "type": "string", "minLength": 1 },
          "resolved_path": { "$ref": "#/$defs/absolutePath" },
          "file": { "$ref": "#/$defs/file" }
        }
      }
    },
    "mustpass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top_level", "mandatory", "leaves", "leaf_count", "case_count", "unique_case_count", "duplicate_occurrence_count", "coverage_semantics"],
      "properties": {
        "top_level": { "$ref": "#/$defs/file" },
        "mandatory": { "$ref": "#/$defs/file" },
        "leaves": { "$ref": "#/$defs/files" },
        "leaf_count": { "type": "integer", "minimum": 1 },
        "case_count": { "type": "integer", "minimum": 1 },
        "unique_case_count": { "type": "integer", "minimum": 1 },
        "duplicate_occurrence_count": { "type": "integer", "minimum": 0 },
        "coverage_semantics": { "type": "string", "minLength": 1 }
      }
    },
    "runner_oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "successful", "always_failure", "qualification_authority"],
      "properties": {
        "file": { "$ref": "#/$defs/file" },
        "successful": { "$ref": "#/$defs/nonemptyStrings" },
        "always_failure": { "$ref": "#/$defs/nonemptyStrings" },
        "qualification_authority": { "const": false }
      }
    },
    "exclusions": {
      "type": "array",
      "items": { "$ref": "#/$defs/absolutePath" },
      "uniqueItems": true
    },
    "base_packages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "guest_receipt": { "$ref": "#/$defs/file" }
  },
  "$defs": {
    "protocolInputPath": {
      "type": "string",
      "pattern": "^(/(?!\\.\\.?(?:/|$))[^/\\u0000]+)+$"
    },
    "protocolDriverHeader": {
      "enum": [
        "vn_protocol_driver.h",
        "vn_protocol_driver_acceleration_structure.h",
        "vn_protocol_driver_buffer.h",
        "vn_protocol_driver_buffer_view.h",
        "vn_protocol_driver_command_buffer.h",
        "vn_protocol_driver_command_pool.h",
        "vn_protocol_driver_cs.h",
        "vn_protocol_driver_defines.h",
        "vn_protocol_driver_descriptor_heap.h",
        "vn_protocol_driver_descriptor_pool.h",
        "vn_protocol_driver_descriptor_set.h",
        "vn_protocol_driver_descriptor_set_layout.h",
        "vn_protocol_driver_descriptor_update_template.h",
        "vn_protocol_driver_device.h",
        "vn_protocol_driver_device_memory.h",
        "vn_protocol_driver_event.h",
        "vn_protocol_driver_fence.h",
        "vn_protocol_driver_framebuffer.h",
        "vn_protocol_driver_handles.h",
        "vn_protocol_driver_host_copy.h",
        "vn_protocol_driver_image.h",
        "vn_protocol_driver_image_view.h",
        "vn_protocol_driver_info.h",
        "vn_protocol_driver_instance.h",
        "vn_protocol_driver_pipeline.h",
        "vn_protocol_driver_pipeline_cache.h",
        "vn_protocol_driver_pipeline_layout.h",
        "vn_protocol_driver_private_data_slot.h",
        "vn_protocol_driver_query_pool.h",
        "vn_protocol_driver_queue.h",
        "vn_protocol_driver_render_pass.h",
        "vn_protocol_driver_sampler.h",
        "vn_protocol_driver_sampler_ycbcr_conversion.h",
        "vn_protocol_driver_semaphore.h",
        "vn_protocol_driver_shader_module.h",
        "vn_protocol_driver_structs.h",
        "vn_protocol_driver_transport.h",
        "vn_protocol_driver_types.h"
      ]
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)\\.\\.?/)[^\\u0000]*$"
    },
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hex": { "type": "string", "pattern": "^[0-9a-f]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    },
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_count", "total_bytes", "verified_against"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_count": { "type": "integer", "minimum": 1 },
        "total_bytes": { "type": "integer", "minimum": 1 },
        "verified_against": { "type": "string", "minLength": 1 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "filesystem", "size", "sha256", "filesystem_uuid", "read_only"],
      "properties": {
        "filename": { "type": "string", "pattern": "^[^/\\u0000]+$" },
        "filesystem": { "enum": ["erofs", "ext4"] },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "filesystem_uuid": { "type": "string", "minLength": 1 },
        "read_only": { "const": true }
      }
    },
    "source": {
      "type": "object",
      "required": ["repository", "base_commit", "base_tree"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://" },
        "base_commit": { "$ref": "#/$defs/gitObject" },
        "base_tree": { "$ref": "#/$defs/gitObject" }
      }
    },
    "patchedSource": {
      "allOf": [
        { "$ref": "#/$defs/source" },
        {
          "type": "object",
          "required": ["patched_tree"],
          "properties": {
            "patched_tree": { "$ref": "#/$defs/gitObject" }
          }
        }
      ]
    }
  }
}
