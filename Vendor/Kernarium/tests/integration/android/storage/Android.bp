// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Checks that Android reports the sizes of the mounted filesystems exactly
// (StorageManager and StorageStatsManager). It is a test of the framework's
// storage accounting, not a product package, and it is signed with the AOSP
// test key (the default certificate): it uses one hidden API, which the
// Andarium test enables for its run with `hidden_api_policy` instead of a
// platform signature.
android_test {
    name: "AndariumStorageTests",
    srcs: ["src/**/*.java"],
    static_libs: ["androidx.test.runner", "androidx.test.ext.junit"],
    platform_apis: true,
    test_suites: ["device-tests"],
}
