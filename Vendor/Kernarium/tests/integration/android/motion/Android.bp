// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Foreground client for sustained and interactive sensor checks. Shell UID
// subscriptions can be disabled when Android reports that UID idle.
android_app {
    name: "AndariumMotionProbe",
    manifest: "app/AndroidManifest.xml",
    srcs: ["app/src/**/*.java"],
    sdk_version: "current",
    optimize: { enabled: false },
}
