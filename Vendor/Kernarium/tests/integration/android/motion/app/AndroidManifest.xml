<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.example.andarium.motionprobe">
    <application android:label="Motion Probe" android:debuggable="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MotionActivity" android:exported="true"
            android:launchMode="singleTop" android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
