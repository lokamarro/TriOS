<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.example.andarium.webglprobe">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="WebGL Probe" android:debuggable="true"
        android:hardwareAccelerated="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".WebGLActivity" android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
