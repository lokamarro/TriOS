#version 450

layout(local_size_x = 64) in;
#if DATA_KIND == 0
layout(set = 0, binding = 0) uniform samplerBuffer source;
#elif DATA_KIND == 1
layout(set = 0, binding = 0) uniform isamplerBuffer source;
#else
layout(set = 0, binding = 0) uniform usamplerBuffer source;
#endif
layout(set = 0, binding = 1, std430) buffer Output {
    uvec4 values[];
} output_data;
layout(push_constant) uniform Parameters {
    uint count;
} parameters;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= parameters.count)
        return;
#if DATA_KIND == 0
    uvec4 value = floatBitsToUint(texelFetch(source, int(index)));
#else
    uvec4 value = uvec4(texelFetch(source, int(index)));
#endif
    output_data.values[index + 16] = value;
}
