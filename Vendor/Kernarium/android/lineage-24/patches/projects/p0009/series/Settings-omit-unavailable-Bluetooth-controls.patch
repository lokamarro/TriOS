                 com.android.settings.bluetooth.Utils.getLocalBluetoothManager(context);
-        mProfileManager = localBluetoothManager.getProfileManager();
-        mCachedDeviceManager = localBluetoothManager.getCachedDeviceManager();
+        // A device without a Bluetooth adapter has no manager and so no hearing aid profiles.
+        mProfileManager =
+                localBluetoothManager != null ? localBluetoothManager.getProfileManager() : null;
+        mCachedDeviceManager = localBluetoothManager != null
+                ? localBluetoothManager.getCachedDeviceManager() : null;
         mBluetoothAdapter = BluetoothAdapter.getDefaultAdapter();
     }
 
@@ -94,9 +97,13 @@ public class HearingAidHelper {
 
     /**
      * Checks if {@link BluetoothProfile#HEARING_AID} or {@link BluetoothProfile#HAP_CLIENT}
-     * is supported by checking system properties.
+     * is supported by checking system properties. A device without a profile manager, which is
+     * one without a Bluetooth adapter, supports neither.
      */
     public boolean isHearingAidSupported() {
+        if (mProfileManager == null) {
+            return false;
+        }
         return SystemProperties.getBoolean(ASHA_PROFILE_CENTRAL_PROPERTY, false)
                 || SystemProperties.getBoolean(HAP_PROFILE_CLIENT_PROPERTY, false);
     }
@@ -120,6 +127,10 @@ public class HearingAidHelper {
