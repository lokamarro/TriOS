From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 7 Nov 2026 11:10:37 +0000
Subject: [PATCH] Settings: omit pages for hardware the device lacks

The product advertises no telephony, biometric or USB hardware, but the
Settings activities for those pages stay registered, and each one that
is started without the hardware crashes on a null system service: the
telephony service, the carrier config manager, the face manager, the
fingerprint manager or the USB manager. Disable the mobile network,
APN, Wi-Fi calling disclaimer, face settings, fingerprint settings and
USB details activities, so the intents that name them stop resolving.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 AndroidManifest.xml | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index 6ebdb9d3789c1a7a06f95c51f72f9685e4a3c1cf..a2ab0e4b960eaeeb7711044a27f888bbee8c6824 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -315,6 +315,7 @@
 
         <activity
             android:name=".Settings$MobileNetworkActivity"
+            android:enabled="false"
             android:label="@string/network_settings_title"
             android:configChanges="orientation|screenSize|keyboardHidden"
             android:launchMode="singleTop"
@@ -756,6 +757,7 @@
         </activity>
 
         <activity android:name="Settings$ApnSettingsActivity"
+                android:enabled="false"
                 android:label="@string/apn_settings"
                 android:exported="true"
                 android:configChanges="orientation|keyboardHidden|screenSize">
@@ -806,6 +808,7 @@
         </activity-alias>
 
         <activity android:name="Settings$FaceSettingsActivity"
+            android:enabled="false"
             android:label="@string/security_settings_face_preference_title"
             android:exported="true"
             android:enableOnBackInvokedCallback="false"
@@ -835,6 +838,7 @@
         </activity>
 
         <activity android:name="Settings$FingerprintSettingsActivity"
+                  android:enabled="false"
                   android:label="@string/security_settings_fingerprint_preference_title"
                   android:exported="true"
                   android:enableOnBackInvokedCallback="false"
@@ -3671,6 +3675,7 @@
         </activity>
 
         <activity android:name=".Settings$UsbDetailsActivity"
+                  android:enabled="false"
                   android:excludeFromRecents="true"
                   android:permission="android.permission.MANAGE_USB"
                   android:exported="true">
@@ -5657,6 +5662,7 @@
 
         <activity
             android:name="Settings$WifiCallingDisclaimerActivity"
+            android:enabled="false"
             android:label="@string/wifi_calling_settings_title"
             android:exported="true"
             android:taskAffinity="com.android.settings">
