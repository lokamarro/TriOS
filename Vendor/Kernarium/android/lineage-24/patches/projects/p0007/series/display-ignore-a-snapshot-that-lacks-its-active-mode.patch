From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 18 Oct 2026 04:03:48 +0000
Subject: [PATCH] display: ignore a snapshot that lacks its active mode

SurfaceFlinger renumbers a display's modes each time the display
reconnects. When two reconnects follow each other quickly, DisplayManager
can handle the first hotplug after SurfaceFlinger has applied the second,
and the snapshot it reads names an active mode that its own list of
supported modes no longer has. LocalDisplayAdapter looked the active mode
up by ID and dereferenced the result, so the lookup's null crashed
system_server.

When a display that already has a state receives such a snapshot, keep
that state and report no mode change. The reconnect that is still to be
handled delivers a consistent snapshot. The first snapshot of a new
display is unchanged.
---
 .../server/display/LocalDisplayAdapter.java   | 11 ++++-
 .../display/LocalDisplayAdapterTest.java      | 43 +++++++++++++++++++
 2 files changed, 53 insertions(+), 1 deletion(-)

diff --git a/services/core/java/com/android/server/display/LocalDisplayAdapter.java b/services/core/java/com/android/server/display/LocalDisplayAdapter.java
index ae8e0148407423aadf21ac1037f736ad7469ffc6..1bd9a31fde3e5aead7a34e217a3c2a065c3e4e10 100644
--- a/services/core/java/com/android/server/display/LocalDisplayAdapter.java
+++ b/services/core/java/com/android/server/display/LocalDisplayAdapter.java
@@ -345,8 +345,17 @@ final class LocalDisplayAdapter extends DisplayAdapter {
             float renderFrameRate = dynamicInfo.renderFrameRate;
             boolean hasArrSupport = dynamicInfo.hasArrSupport;
 
+            SurfaceControl.DisplayMode activeSfDisplayMode =
+                    getModeById(displayModes, activeSfDisplayModeId);
+            if (activeSfDisplayMode == null && mActiveSfDisplayMode != null) {
+                // SurfaceFlinger renumbers its modes each time the display reconnects, and
+                // this snapshot names an active mode its own list lacks: it was taken
+                // between two reconnects. Keep the previous state; the reconnect still
+                // to be handled delivers a consistent snapshot.
+                return false;
+            }
             mSfDisplayModes = Arrays.copyOf(displayModes, displayModes.length);
-            mActiveSfDisplayMode = getModeById(displayModes, activeSfDisplayModeId);
+            mActiveSfDisplayMode = activeSfDisplayMode;
             mAppVsyncOffsetNanos = mActiveSfDisplayMode.appVsyncOffsetNanos;
             mPresentationDeadlineNanos = mActiveSfDisplayMode.presentationDeadlineNanos;
             SurfaceControl.DisplayMode preferredSfDisplayMode =
diff --git a/services/tests/displayservicetests/src/com/android/server/display/LocalDisplayAdapterTest.java b/services/tests/displayservicetests/src/com/android/server/display/LocalDisplayAdapterTest.java
index 14b5b1358ae5c2f6aa525dc58cf1c5f1e66a4454..bd34b98530bb41776ee082fac88a6650e979c2ed 100644
--- a/services/tests/displayservicetests/src/com/android/server/display/LocalDisplayAdapterTest.java
+++ b/services/tests/displayservicetests/src/com/android/server/display/LocalDisplayAdapterTest.java
@@ -499,6 +499,49 @@ public class LocalDisplayAdapterTest {
         Assert.assertEquals(99, supportedModes[0].getSfModeId());
     }
 
+    @Test
+    public void testSnapshotWithoutItsActiveMode_keepsThePreviousState()
+            throws InterruptedException {
+        SurfaceControl.DisplayMode displayMode = createFakeDisplayMode(0, 1920, 1080, 0);
+        FakeDisplay display = new FakeDisplay(PORT_A, new SurfaceControl.DisplayMode[]{displayMode},
+                0, 0);
+        setUpDisplay(display);
+        updateAvailableDisplays();
+        mAdapter.registerLocked();
+        waitForHandlerToComplete(mHandler, HANDLER_WAIT_MS);
+
+        DisplayDevice displayDevice = mListener.addedDisplays.get(0);
+        displayDevice.applyPendingDisplayDeviceInfoChangesLocked();
+        Display.Mode[] supportedModes = displayDevice.getDisplayDeviceInfoLocked().supportedModes;
+        Assert.assertEquals(1, supportedModes.length);
+        Assert.assertEquals(0, supportedModes[0].getSfModeId());
+
+        // SurfaceFlinger reconnected the display and renumbered its modes (0 -> 8), and a
+        // snapshot taken between two such reconnects still names the old active mode (7).
+        display.dynamicInfo.supportedDisplayModes =
+                new SurfaceControl.DisplayMode[]{createFakeDisplayMode(8, 1920, 1080, 0)};
+        display.dynamicInfo.activeDisplayModeId = 7;
+        setUpDisplay(display);
+        mInjector.getTransmitter().sendHotplug(display, true);
+        waitForHandlerToComplete(mHandler, HANDLER_WAIT_MS);
+
+        displayDevice.applyPendingDisplayDeviceInfoChangesLocked();
+        supportedModes = displayDevice.getDisplayDeviceInfoLocked().supportedModes;
+        Assert.assertEquals(1, supportedModes.length);
+        Assert.assertEquals(0, supportedModes[0].getSfModeId());
+
+        // The next snapshot is consistent and is applied.
+        display.dynamicInfo.activeDisplayModeId = 8;
+        setUpDisplay(display);
+        mInjector.getTransmitter().sendHotplug(display, true);
+        waitForHandlerToComplete(mHandler, HANDLER_WAIT_MS);
+
+        displayDevice.applyPendingDisplayDeviceInfoChangesLocked();
+        supportedModes = displayDevice.getDisplayDeviceInfoLocked().supportedModes;
+        Assert.assertEquals(1, supportedModes.length);
+        Assert.assertEquals(8, supportedModes[0].getSfModeId());
+    }
+
     /**
      * Confirm that all local displays are public when config_localPrivateDisplayPorts is empty.
      */
