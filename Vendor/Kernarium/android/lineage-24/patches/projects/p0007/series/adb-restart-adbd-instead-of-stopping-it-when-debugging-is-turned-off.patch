From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 3 Nov 2026 11:38:01 +0000
Subject: [PATCH] adb: restart adbd instead of stopping it when debugging is
 turned off

Stock AdbService stops adbd when USB debugging and wireless debugging
are both off. adbd is also the host application's channel, so it has to
keep running, serving the host's key whatever the setting.

It is restarted where stock stops it. Every session ends, as it does on
stock, so no session authorized while debugging was on survives the
toggle, and the new adbd refuses any key but the host's while debugging
is off. Turning debugging on starts adbd, which is already running.
---
 services/core/java/com/android/server/adb/AdbService.java | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/services/core/java/com/android/server/adb/AdbService.java b/services/core/java/com/android/server/adb/AdbService.java
index b03c920bffd4ff2ec36a9bf2ffa2ebdcf8865e7f..7795dc06cc06d935b06934d6fa359857ec51a300 100644
--- a/services/core/java/com/android/server/adb/AdbService.java
+++ b/services/core/java/com/android/server/adb/AdbService.java
@@ -406,7 +406,10 @@ public class AdbService extends IAdbManager.Stub {
 
     private void stopAdbd() {
         if (!mIsAdbUsbEnabled && !mIsAdbWifiEnabled) {
-            SystemProperties.set(CTL_STOP, ADBD);
+            // adbd is the host application's channel and has to keep running, so it is restarted
+            // where stock stops it. Every session ends, as it does on stock, and the new adbd
+            // refuses any key but the host's while debugging is off.
+            SystemProperties.set("ctl.restart", ADBD);
         }
     }
 
