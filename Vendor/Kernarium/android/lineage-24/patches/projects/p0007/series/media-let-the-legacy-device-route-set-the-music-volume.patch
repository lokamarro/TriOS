From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 27 Oct 2026 02:12:09 +0000
Subject: [PATCH] media: let the legacy device route set the music volume

DeviceRouteController falls back to LegacyDeviceRouteController when the
device has no Bluetooth adapter, and its setVolume did nothing, so a media
router client could never change the volume of the built-in speaker route.
Set the music stream volume as the system, as AudioManagerRouteController
does. The controller already reports the stream volume back through
updateVolume.
---
 .../media/LegacyDeviceRouteController.java    | 12 ++++++++++--
 .../LegacyDeviceRouteControllerTest.java      | 19 +++++++++++++++++++
 2 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/services/core/java/com/android/server/media/LegacyDeviceRouteController.java b/services/core/java/com/android/server/media/LegacyDeviceRouteController.java
index 800fee20db2469b442ae0f6e6f00ca3ad1552cd7..0749a96ff77e854fa6eb1a251a655cf8c8651f21 100644
--- a/services/core/java/com/android/server/media/LegacyDeviceRouteController.java
+++ b/services/core/java/com/android/server/media/LegacyDeviceRouteController.java
@@ -35,6 +35,7 @@ import android.media.IAudioRoutesObserver;
 import android.media.IAudioService;
 import android.media.MediaRoute2Info;
 import android.media.RoutingSessionInfo;
+import android.os.Binder;
 import android.os.RemoteException;
 import android.os.UserHandle;
 import android.util.Slog;
@@ -182,8 +183,15 @@ import java.util.Objects;
     }
 
     @Override
-    public synchronized void setVolume(long requestId, @NonNull String routeId, int volume) {
-        // Do nothing
+    public void setVolume(long requestId, @NonNull String routeId, int volume) {
+        // The request comes from a client of the media router, and the audio service checks its
+        // caller. updateVolume reports the change back when the music stream has taken it.
+        final long token = Binder.clearCallingIdentity();
+        try {
+            mAudioManager.setStreamVolume(AudioManager.STREAM_MUSIC, volume, 0);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
     }
 
     private MediaRoute2Info createRouteFromAudioInfo(@Nullable AudioRoutesInfo newRoutes) {
