From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 27 Aug 2026 19:06:43 +0000
Subject: [PATCH] audio: make assistant default configurable

---
 .../java/com/android/server/audio/AudioService.java   | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/services/core/java/com/android/server/audio/AudioService.java b/services/core/java/com/android/server/audio/AudioService.java
index 7f9555c7713cf23cfe9bf21a1ed0d0985b9bde2b..b8ed9206a81c23266170c49996278fc21767b0d2 100644
--- a/services/core/java/com/android/server/audio/AudioService.java
+++ b/services/core/java/com/android/server/audio/AudioService.java
@@ -1713,6 +1713,17 @@ public class AudioService extends IAudioService.Stub
             MIN_STREAM_VOLUME[AudioSystem.STREAM_ASSISTANT] = minAssistantVolume;
         }
 
+        int defaultAssistantVolume = SystemProperties.getInt(
+                "ro.config.assistant_vol_default", -1);
+        if (defaultAssistantVolume != -1
+                && defaultAssistantVolume <= MAX_STREAM_VOLUME[AudioSystem.STREAM_ASSISTANT]
+                && defaultAssistantVolume >= MIN_STREAM_VOLUME[AudioSystem.STREAM_ASSISTANT]) {
+            AudioSystem.DEFAULT_STREAM_VOLUME[AudioSystem.STREAM_ASSISTANT] =
+                    defaultAssistantVolume;
+        } else if (defaultAssistantVolume != -1) {
+            Log.e(TAG, "Invalid default assistant volume " + defaultAssistantVolume);
+        }
+
         // Read following properties to configure max volume (number of steps) and default volume
         //   for STREAM_NOTIFICATION and STREAM_RING:
         //      config_audio_notif_vol_default
