From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 24 Aug 2026 07:25:25 +0000
Subject: [PATCH] theming: break warm-boot wallpaper wait cycle

---
 .../theming/ThemeInitializationObserver.java       |  5 +++--
 .../theming/ThemeInitializationObserverTest.java   | 14 ++++++++++++++
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/services/core/java/com/android/server/theming/ThemeInitializationObserver.java b/services/core/java/com/android/server/theming/ThemeInitializationObserver.java
index d2815c8b8c589b24bf6207e361358e3f8ba58f17..ad3673be5b4affaababb54f392e56ad7b799e776 100644
--- a/services/core/java/com/android/server/theming/ThemeInitializationObserver.java
+++ b/services/core/java/com/android/server/theming/ThemeInitializationObserver.java
@@ -143,9 +143,10 @@ class ThemeInitializationObserver {
      */
     @RequiresPermission(Manifest.permission.SUBSCRIBE_TO_KEYGUARD_LOCKED_STATE)
     void onBootPhase(int phase) {
-        if (phase == SystemService.PHASE_BOOT_COMPLETED) {
+        if (phase == SystemService.PHASE_THIRD_PARTY_APPS_CAN_START) {
             if (mTriggered) return;
-            Slog.i(TAG, "Wallpaper colors not received by BOOT_COMPLETE. Forcing initialization.");
+            Slog.i(TAG, "Wallpaper colors not received before third-party apps can start. "
+                    + "Forcing initialization.");
             triggerInitialization(mEnvironment.getCurrentUserId());
         }
     }
diff --git a/services/tests/servicestests/src/com/android/server/theming/ThemeInitializationObserverTest.java b/services/tests/servicestests/src/com/android/server/theming/ThemeInitializationObserverTest.java
index a3ff79eee34e0bd548e8314f6d48601d7971eb4e..b484886d1a1c45b38f24d424a7681cca0da9ba20 100644
--- a/services/tests/servicestests/src/com/android/server/theming/ThemeInitializationObserverTest.java
+++ b/services/tests/servicestests/src/com/android/server/theming/ThemeInitializationObserverTest.java
@@ -41,6 +41,7 @@ import androidx.test.InstrumentationRegistry;
 import androidx.test.runner.AndroidJUnit4;
 
 import com.android.server.LocalServices;
+import com.android.server.SystemService;
 import com.android.server.pm.UserManagerInternal;
 import com.android.server.wallpaper.WallpaperManagerInternal;
 
@@ -129,6 +130,19 @@ public class ThemeInitializationObserverTest {
         verify(mMockImpl).initializeThemingSystem();
     }
 
+    @Test
+    public void testBootPhase_fallsBackBeforeBootCompletion() {
+        doReturn(true).when(mMockWallpaperManager).isWallpaperManagerAvailable();
+        mEvents.registerListeners();
+
+        mEvents.onBootPhase(SystemService.PHASE_ACTIVITY_MANAGER_READY);
+        verify(mMockImpl, never()).initializeThemingSystem();
+
+        mEvents.onBootPhase(SystemService.PHASE_THIRD_PARTY_APPS_CAN_START);
+
+        verify(mMockImpl).initializeThemingSystem();
+    }
+
     @Test
     public void testWallpaperChanged_triggersInit() {
         doReturn(true).when(mMockWallpaperManager).isWallpaperManagerAvailable();
