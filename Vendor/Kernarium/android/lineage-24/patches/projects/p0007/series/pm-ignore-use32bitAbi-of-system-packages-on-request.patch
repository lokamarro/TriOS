From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 23 Oct 2026 15:41:16 +0000
Subject: [PATCH] pm: ignore use32bitAbi of system packages on request

The WebView provider is a multiArch package that declares use32bitAbi. On a
device that runs both ABIs, that attribute makes armeabi-v7a its primary ABI,
so the WebView zygote and every renderer, including those of 64-bit
applications, become 32-bit processes.

Let a product set ro.config.ignore_use32bitabi=true to disregard the attribute
for system packages. The 64-bit ABI stays primary, and the 32-bit libraries
remain the secondary ABI for 32-bit applications.
---
 .../com/android/server/pm/PackageAbiHelperImpl.java | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/services/core/java/com/android/server/pm/PackageAbiHelperImpl.java b/services/core/java/com/android/server/pm/PackageAbiHelperImpl.java
index 639d02ca42b0d10447bba30b78fb32d1f12816ea..5ecb0025ee832c7768580d20299110528b2222d9 100644
--- a/services/core/java/com/android/server/pm/PackageAbiHelperImpl.java
+++ b/services/core/java/com/android/server/pm/PackageAbiHelperImpl.java
@@ -454,7 +454,7 @@ final class PackageAbiHelperImpl implements PackageAbiHelper {
                 if (abi32 >= 0) {
                     final String abi = supported32BitAbis[abi32];
                     if (abi64 >= 0) {
-                        if (pkg.is32BitAbiPreferred()) {
+                        if (pkg.is32BitAbiPreferred() && !ignoresUse32BitAbi(isSystemApp)) {
                             secondaryCpuAbi = primaryCpuAbi;
                             primaryCpuAbi = abi;
                         } else {
@@ -537,6 +537,17 @@ final class PackageAbiHelperImpl implements PackageAbiHelper {
                         isUpdatedSystemApp));
     }
 
+    /**
+     * Whether the use32bitAbi attribute of a system package is disregarded. A product that
+     * sets ro.config.ignore_use32bitabi keeps the 64-bit ABI primary for its multiArch
+     * system packages. The WebView provider declares use32bitAbi, which would otherwise
+     * make every WebView renderer a 32-bit process on a device that runs both ABIs; its
+     * 32-bit libraries still serve 32-bit applications as the secondary ABI.
+     */
+    private static boolean ignoresUse32BitAbi(boolean isSystemApp) {
+        return isSystemApp && SystemProperties.getBoolean("ro.config.ignore_use32bitabi", false);
+    }
+
     private boolean shouldExtractLibs(AndroidPackage pkg, boolean isSystemApp,
             boolean isUpdatedSystemApp) {
         // We shouldn't extract libs if the package is a library or if extractNativeLibs=false
