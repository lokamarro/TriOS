From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 28 Aug 2026 08:27:48 +0000
Subject: [PATCH] enable configurable developer defaults

---
 packages/SettingsProvider/res/values/defaults.xml              | 1 +
 .../src/com/android/providers/settings/DatabaseHelper.java     | 3 +++
 2 files changed, 4 insertions(+)

diff --git a/packages/SettingsProvider/res/values/defaults.xml b/packages/SettingsProvider/res/values/defaults.xml
index 580dce2c63b756f8fc8aec5fc08f70a2d61894a5..60a8478b62ea50b40e6702c8417f16effe8f73e6 100644
--- a/packages/SettingsProvider/res/values/defaults.xml
+++ b/packages/SettingsProvider/res/values/defaults.xml
@@ -43,6 +43,7 @@
     <bool name="def_install_non_market_apps">false</bool>
     <!-- 0 == off, 3 == on -->
     <integer name="def_location_mode">3</integer>
+    <bool name="def_development_settings_enabled">false</bool>
     <!-- 0 == off, 1 == on-->
     <integer name="def_paired_device_location_mode">1</integer>
     <bool name="assisted_gps_enabled">false</bool>
diff --git a/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java b/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
index dc2285f3eaee3351354f9d78e028aaa7dbc1285f..9e2077bd719b4836046033779d0f484bf9e5f043 100644
--- a/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
+++ b/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
@@ -2301,6 +2301,9 @@ class DatabaseHelper extends SQLiteOpenHelper {
             loadBooleanSetting(stmt, Settings.Global.ASSISTED_GPS_ENABLED,
                     R.bool.assisted_gps_enabled);
 
+            loadBooleanSetting(stmt, Settings.Global.DEVELOPMENT_SETTINGS_ENABLED,
+                    R.bool.def_development_settings_enabled);
+
             loadBooleanSetting(stmt, Settings.Global.AUTO_TIME,
                     R.bool.def_auto_time); // Sync time to NITZ
 
