From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 14 Sep 2026 09:59:08 +0000
Subject: [PATCH] report the real buffer layout on an upstream virtio-gpu

The virgl backend asks for a resource layout with the ChromeOS extended
resource info ioctl. The first plane stride of that reply shares a union
with the request type and with blob_mem, so a kernel that implements only
the upstream ioctl answers in that same word -- leaving the request type in
place for a classic resource, or writing the blob memory kind over it for a
blob -- and the driver reports one or two bytes as the row pitch. Mesa then
builds an explicit DRM format modifier layout from it and every image the
window system hands the Vulkan driver is rejected.

Only a reply that counts planes describes a layout, so key both call sites
on that, and fall back to the allocation recorded in the buffer handle when
the driver reports no stride at all: a caller that gets no stride cannot use
the buffer either way.
---
 cros_gralloc/gralloc0/gralloc0.cc | 12 +++++++++
 virtgpu_virgl.c                   | 43 ++++++++++++++++++++++++++-----
 2 files changed, 48 insertions(+), 7 deletions(-)

diff --git a/cros_gralloc/gralloc0/gralloc0.cc b/cros_gralloc/gralloc0/gralloc0.cc
index 8f97b2121150179e1218341d5fa52dc9e6407e8e..8c4bf45c5dfb29dedb418aeeac2e355ee29d2b04 100644
--- a/cros_gralloc/gralloc0/gralloc0.cc
+++ b/cros_gralloc/gralloc0/gralloc0.cc
@@ -350,6 +350,18 @@ static int gralloc0_perform(struct gralloc_module_t const *module, int op, ...)
 			info->stride[i] = strides[i];
 			info->offset[i] = offsets[i];
 		}
+
+		/*
+		 * A driver that cannot ask the host for a resource layout reports
+		 * none. The allocation recorded in the handle is the layout then,
+		 * and a caller that gets no stride at all cannot use the buffer.
+		 */
+		if (!info->stride[0]) {
+			for (uint32_t i = 0; i < hnd->num_planes; i++) {
+				info->stride[i] = hnd->strides[i];
+				info->offset[i] = hnd->offsets[i];
+			}
+		}
 		break;
 	case GRALLOC_DRM_GET_USAGE:
 		req_usage = va_arg(args, uint32_t);
diff --git a/virtgpu_virgl.c b/virtgpu_virgl.c
index 92f8c78ec243ad98095c61e44daede46e0732b59..17a70c5e44cf166ac08cae1cbd54103e3bed4f62 100644
--- a/virtgpu_virgl.c
+++ b/virtgpu_virgl.c
@@ -867,12 +867,17 @@ static int virgl_blob_get_host_format(struct driver *drv, struct bo_metadata *me
 		    lru_find(&priv->virgl_blob_metadata_cache, virgl_blob_metadata_eq, meta));
 
 		if (!entry) {
+			uint32_t local_strides[DRV_MAX_PLANES] = { 0 };
+			uint32_t local_offsets[DRV_MAX_PLANES] = { 0 };
+			uint32_t local_sizes[DRV_MAX_PLANES] = { 0 };
 			uint32_t total_size = 0;
 			for (int i = 0; i < num_planes; i++) {
-				uint32_t stride =
+				local_strides[i] =
 				    drv_stride_from_format(meta->format, meta->width, i);
-				total_size +=
-				    drv_size_from_format(meta->format, stride, meta->height, i);
+				local_sizes[i] = drv_size_from_format(
+				    meta->format, local_strides[i], meta->height, i);
+				local_offsets[i] = total_size;
+				total_size += local_sizes[i];
 			}
 
 			uint32_t handle;
@@ -903,19 +908,32 @@ static int virgl_blob_get_host_format(struct driver *drv, struct bo_metadata *me
 				return info_ret;
 			}
 
+			/*
+			 * The first plane stride shares a union with the request
+			 * type and with blob_mem, so a kernel that implements only
+			 * the upstream ioctl answers in that word and describes
+			 * nothing. Only a reply that counts planes describes a
+			 * layout; otherwise the layout this driver computed for the
+			 * probe allocation is the layout.
+			 */
+			const bool host_layout = info.num_planes != 0;
+
 			entry = calloc(1, sizeof(*entry));
 			entry->meta = *meta;
 
 			for (int i = 0; i < num_planes; i++) {
-				entry->meta.strides[i] = info.strides[i];
+				entry->meta.strides[i] =
+				    host_layout ? info.strides[i] : local_strides[i];
 				entry->meta.sizes[i] =
-				    info.strides[i] *
+				    entry->meta.strides[i] *
 				    drv_height_from_format(meta->format, meta->height, i);
-				entry->meta.offsets[i] = info.offsets[i];
+				entry->meta.offsets[i] =
+				    host_layout ? info.offsets[i] : local_offsets[i];
 			}
 			entry->meta.total_size =
 			    entry->meta.offsets[num_planes - 1] + entry->meta.sizes[num_planes - 1];
-			entry->meta.format_modifier = info.format_modifier;
+			entry->meta.format_modifier =
+			    host_layout ? info.format_modifier : DRM_FORMAT_MOD_LINEAR;
 
 			lru_insert(&priv->virgl_blob_metadata_cache, &entry->entry);
 		}
@@ -1358,6 +1376,17 @@ static int virgl_resource_info(struct bo *bo, uint32_t strides[DRV_MAX_PLANES],
 		return ret;
 	}
 
+	/*
+	 * The first plane stride shares a union with the request type and with
+	 * blob_mem, so a kernel that implements only the upstream resource info
+	 * ioctl answers in that word -- leaving the request type in place, or
+	 * writing a blob memory kind over it -- and carries no layout at all.
+	 * Reporting either as a stride would describe every buffer as a couple
+	 * of bytes per row. Only a reply that counts planes describes a layout.
+	 */
+	if (!res_info.num_planes)
+		return 0;
+
 	for (uint32_t plane = 0; plane < DRV_MAX_PLANES; plane++) {
 		/*
 		 * Currently, kernel v4.14 (Betty) doesn't have the extended resource info
