From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 26 Oct 2026 16:10:03 +0900
Subject: [PATCH] transfer a part of an emulated planar buffer from where it
 lies

A buffer the driver creates as an R8 image holds its planes as sub-images of
that image, and locking part of it transfers one box for each plane. The host
reads the box from the guest copy starting at the offset of the transfer, but
the offset was left at zero for every plane, so a locked rectangle that did not
start at the corner of the buffer took the bytes at the start of the buffer
instead of its own: the written part of a frame came back as the top left
corner of it, and the host picture changed with it.

Give each box the offset of its first byte, as a single-plane buffer already
does, for the flush and the invalidate alike.

The box of the chroma plane of an NV12 buffer was also placed as if the plane
had a row for each row of the picture: it started at the row of the rectangle
below the luma plane rather than at half of it, and its width could start in the
middle of a Cb and Cr pair. Place it by the rows and the pairs the rectangle
covers.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 virtgpu_virgl.c | 26 +++++++++++++++++++-------
 1 file changed, 19 insertions(+), 7 deletions(-)

diff --git a/virtgpu_virgl.c b/virtgpu_virgl.c
index 5300be66af74fd834fd411f3302036ee4306b783..aba55fe89e28d41c4c8511e82ba90b7380576f1e 100644
--- a/virtgpu_virgl.c
+++ b/virtgpu_virgl.c
@@ -290,11 +290,17 @@ static void virgl_get_emulated_transfers_params(const struct bo *bo,
 		xfer_params->xfer_boxes[0].width = transfer_box->width;
 		xfer_params->xfer_boxes[0].height = transfer_box->height;
 
-		// CbCr-plane (half resolution, interleaved, placed below Y-plane)
-		xfer_params->xfer_boxes[1].x = transfer_box->x;
-		xfer_params->xfer_boxes[1].y = transfer_box->y + y_plane_height;
-		xfer_params->xfer_boxes[1].width = transfer_box->width;
-		xfer_params->xfer_boxes[1].height = DIV_ROUND_UP(transfer_box->height, 2);
+		// CbCr-plane (half resolution, interleaved, placed below Y-plane): a row holds a
+		// Cb and a Cr sample for each pair of pixels, and there is one for each pair of rows
+		uint32_t chroma_x = transfer_box->x & ~1u;
+		uint32_t chroma_end = DIV_ROUND_UP(transfer_box->x + transfer_box->width, 2) * 2;
+		if (chroma_end > bo->meta.width)
+			chroma_end = bo->meta.width;
+		xfer_params->xfer_boxes[1].x = chroma_x;
+		xfer_params->xfer_boxes[1].y = y_plane_height + transfer_box->y / 2;
+		xfer_params->xfer_boxes[1].width = chroma_end - chroma_x;
+		xfer_params->xfer_boxes[1].height =
+		    DIV_ROUND_UP(transfer_box->y + transfer_box->height, 2) - transfer_box->y / 2;
 
 		break;
 	case DRM_FORMAT_YVU420:
@@ -1193,7 +1199,8 @@ static int virgl_bo_invalidate(struct bo *bo, struct mapping *mapping)
 			xfer.level = bo->meta.strides[0];
 	}
 
-	if (virgl_creates_natively(bo->drv, bo->meta.format, bo->meta.use_flags)) {
+	bool emulated = !virgl_creates_natively(bo->drv, bo->meta.format, bo->meta.use_flags);
+	if (!emulated) {
 		xfer_params.xfers_needed = 1;
 		xfer_params.xfer_boxes[0] = mapping->rect;
 	} else {
@@ -1209,6 +1216,8 @@ static int virgl_bo_invalidate(struct bo *bo, struct mapping *mapping)
 		xfer.box.w = xfer_params.xfer_boxes[i].width;
 		xfer.box.h = xfer_params.xfer_boxes[i].height;
 		xfer.box.d = 1;
+		if (emulated)
+			xfer.offset = (uint64_t)xfer.box.y * bo->meta.strides[0] + xfer.box.x;
 
 		ret = drmIoctl(bo->drv->fd, DRM_IOCTL_VIRTGPU_TRANSFER_FROM_HOST, &xfer);
 		if (ret) {
@@ -1269,7 +1278,8 @@ static int virgl_bo_flush(struct bo *bo, struct mapping *mapping)
 	if (priv->host_gbm_enabled)
 		xfer.level = bo->meta.strides[0];
 
-	if (virgl_creates_natively(bo->drv, bo->meta.format, bo->meta.use_flags)) {
+	bool emulated = !virgl_creates_natively(bo->drv, bo->meta.format, bo->meta.use_flags);
+	if (!emulated) {
 		xfer_params.xfers_needed = 1;
 		xfer_params.xfer_boxes[0] = mapping->rect;
 	} else {
@@ -1285,6 +1295,8 @@ static int virgl_bo_flush(struct bo *bo, struct mapping *mapping)
 		xfer.box.w = xfer_params.xfer_boxes[i].width;
 		xfer.box.h = xfer_params.xfer_boxes[i].height;
 		xfer.box.d = 1;
+		if (emulated)
+			xfer.offset = (uint64_t)xfer.box.y * bo->meta.strides[0] + xfer.box.x;
 
 		ret = drmIoctl(bo->drv->fd, DRM_IOCTL_VIRTGPU_TRANSFER_TO_HOST, &xfer);
 		if (ret) {
