From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Wed, 28 Oct 2026 10:38:48 +0900
Subject: [PATCH] v4l2: take the device's smallest picture and lowest bitrate

The encoder's picture size accepted anything from two samples, and the
bitrate range took the device's lowest value as it was. The host's
encoders make streams below 64 samples on a side, and below about
10 kbit/s at 64x64 in HEVC, that fail Android's quality bar (CTS
VideoEncoderMinMaxTest finds a PSNR under 20 dB).

The size range now starts at the smallest picture any profile lists,
and the bitrate range at the device's lowest value. Both are raised to a
floor of 64 samples and 20000 bit/s: the device lists the same floors,
and these only guard a host that lists less.
---
 components/EncodeInterface.cpp | 21 ++++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/components/EncodeInterface.cpp b/components/EncodeInterface.cpp
index 8a2b8b7df330d39eabc6928b7412ac5156a8bb86..430a91c7ace00084824b7cfb84a0cd8eecb87fda 100644
--- a/components/EncodeInterface.cpp
+++ b/components/EncodeInterface.cpp
@@ -9,6 +9,7 @@
 
 #include <inttypes.h>
 #include <algorithm>
+#include <limits>
 
 #include <C2PlatformSupport.h>
 #include <SimpleC2Interface.h>
@@ -42,6 +43,14 @@ constexpr uint32_t kDefaultBitrate = 64000;
 // TODO: increase this in the future for supporting higher level/resolution encoding.
 constexpr uint32_t kMaxBitrate = 50000000;
 
+// The smallest picture side and the lowest bitrate that the component takes, whatever the device
+// lists. The device lists the same floors (the platform's smallest picture and the bit rate
+// control's minimum) and the codec list publishes them, so these only guard a host that lists
+// less: below them the host's encoders make streams that fail Android's quality bar (a PSNR of
+// 20 dB at 48 pixels or fewer, and of an HEVC stream with inter frames at 64x64 below 10 kbit/s).
+constexpr int32_t kMinPictureSide = 64;
+constexpr uint32_t kMinBitrate = 20000;
+
 // The default quality of the constant quality bitrate mode, in the middle of the 1 to 100 range.
 constexpr uint32_t kDefaultQuality = 50;
 // The share of the bitrate that the base temporal layer gets when the client gives none.
@@ -494,6 +503,8 @@ void EncodeInterface::Initialize(const C2String& name, const SupportedCapabiliti
     // std::vector<unsigned int> required by the c2 framework below.
     std::vector<unsigned int> profiles;
     ui::Size maxSize;
+    // The smallest picture any profile takes, no smaller than the floor, and even as the size step is.
+    ui::Size minSize(std::numeric_limits<int32_t>::max(), std::numeric_limits<int32_t>::max());
     for (const auto& supportedProfile : caps.supportedProfiles) {
         if (!isValidProfileForCodec(caps.codec, supportedProfile.profile)) {
             continue;  // Ignore unrecognizable or unsupported profiles.
@@ -503,6 +514,10 @@ void EncodeInterface::Initialize(const C2String& name, const SupportedCapabiliti
         profiles.push_back(static_cast<unsigned int>(supportedProfile.profile));
         maxSize.setWidth(std::max(maxSize.width, supportedProfile.max_resolution.width));
         maxSize.setHeight(std::max(maxSize.height, supportedProfile.max_resolution.height));
+        const int minWidth = std::max(kMinPictureSide, (supportedProfile.min_resolution.width + 1) & ~1);
+        const int minHeight = std::max(kMinPictureSide, (supportedProfile.min_resolution.height + 1) & ~1);
+        minSize.setWidth(std::min(minSize.width, minWidth));
+        minSize.setHeight(std::min(minSize.height, minHeight));
     }
 
     if (profiles.empty()) {
@@ -522,8 +537,8 @@ void EncodeInterface::Initialize(const C2String& name, const SupportedCapabiliti
     addParameter(DefineParam(mInputVisibleSize, C2_PARAMKEY_PICTURE_SIZE)
                          .withDefault(new C2StreamPictureSizeInfo::input(0u, 320, 240))
                          .withFields({
-                                 C2F(mInputVisibleSize, width).inRange(2, maxSize.width, 2),
-                                 C2F(mInputVisibleSize, height).inRange(2, maxSize.height, 2),
+                                 C2F(mInputVisibleSize, width).inRange(minSize.width, maxSize.width, 2),
+                                 C2F(mInputVisibleSize, height).inRange(minSize.height, maxSize.height, 2),
                          })
                          .withSetter(SizeSetter)
                          .build());
@@ -537,7 +552,7 @@ void EncodeInterface::Initialize(const C2String& name, const SupportedCapabiliti
 
     // The bitrate range is the device's, or the one this component always offered.
     const uint32_t maxBitrate = caps.maxBitrate > 0 ? caps.maxBitrate : kMaxBitrate;
-    const uint32_t minBitrate = std::min(caps.minBitrate, kDefaultBitrate);
+    const uint32_t minBitrate = std::min(std::max(caps.minBitrate, kMinBitrate), kDefaultBitrate);
     addParameter(DefineParam(mBitrate, C2_PARAMKEY_BITRATE)
                          .withDefault(new C2StreamBitrateInfo::output(0u, kDefaultBitrate))
                          .withFields({C2F(mBitrate, value).inRange(minBitrate, maxBitrate)})
