From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 25 Oct 2026 06:41:00 +0900
Subject: [PATCH] service: join the camera group that owns the V4L2 nodes

A product that follows Cuttlefish gives /dev/video* to the camera group
(0660 system camera), and the service runs as media with only the mediadrm
and drmrpc groups, so it cannot open the video devices it scans. Add the
camera group to the service instead of changing the owner of the nodes.
---
 service/android.hardware.media.c2-service-v4l2.rc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/service/android.hardware.media.c2-service-v4l2.rc b/service/android.hardware.media.c2-service-v4l2.rc
index f42824b1c1104803f0fba522738c84c0b5f32347..7982e52e0a2d08b2e85848abad314fc81f9b278d 100644
--- a/service/android.hardware.media.c2-service-v4l2.rc
+++ b/service/android.hardware.media.c2-service-v4l2.rc
@@ -1,7 +1,7 @@
 service android-hardware-media-c2-v4l2-hal /vendor/bin/hw/android.hardware.media.c2-service-v4l2
     class hal
     user media
-    group mediadrm drmrpc
+    group mediadrm drmrpc camera
     ioprio rt 4
     task_profiles ProcessCapacityHigh
     setenv MESA_GLSL_CACHE_DISABLE 1
