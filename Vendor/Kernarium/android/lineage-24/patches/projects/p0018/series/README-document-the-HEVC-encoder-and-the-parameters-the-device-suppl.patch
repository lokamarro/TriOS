From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 25 Oct 2026 07:29:16 +0900
Subject: [PATCH] README: document the HEVC encoder and the parameters the
 device supplies

The encoder README listed three codecs, two bitrate modes and NV12 as the only
input. Describe the HEVC encoder, the parameters that exist when the encoder
device has the controls for them, and the input formats the encoder passes on.
---
 README.md | 76 +++++++++++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 66 insertions(+), 10 deletions(-)

diff --git a/README.md b/README.md
index 7b4455d2ecb4a864a87fd1f380ee0d24bbc0bef9..6afdbbb4a7532fbbe6a9c3b64eacc5b620ce1721 100644
--- a/README.md
+++ b/README.md
@@ -49,9 +49,13 @@ PRODUCT_COPY_FILES += \
 # Set the customized property of v4l2_codec2, including:
 # - The maximum concurrent instances for decoder/encoder.
 #   It should be the same as "concurrent-instances" at media_codec_c2.xml.
+# - The pixel rate the device sustains for all instances together, in luma
+#   samples per second. It should be the largest performance point that
+#   media_codec_c2.xml publishes. Omit it to report instances only.
 PRODUCT_PROPERTY_OVERRIDES += \
     ro.vendor.v4l2_codec2.decode_concurrent_instances=8 \
-    ro.vendor.v4l2_codec2.encode_concurrent_instances=8
