         // the Codec2 is more prone to timeout the component if one is not producing frames. This
diff --git a/components/include/v4l2_codec2/components/DecodeDelays.h b/components/include/v4l2_codec2/components/DecodeDelays.h
new file mode 100644
index 0000000000000000000000000000000000000000..c85aaf6ff515b3083fe4169280455c3ebc192a23
--- /dev/null
+++ b/components/include/v4l2_codec2/components/DecodeDelays.h
@@ -0,0 +1,68 @@
+// Copyright 2026 The Android Open Source Project
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef ANDROID_V4L2_CODEC2_COMPONENTS_DECODE_DELAYS_H
+#define ANDROID_V4L2_CODEC2_COMPONENTS_DECODE_DELAYS_H
+
+#include <cstdint>
+
+namespace android {
+
+// The output and pipeline delays of H.264 and HEVC, in frames. The codec2 framework sizes the
+// capture buffer queue from the output delay and the input buffer queue from the pipeline delay
+// (and the input delay, which is 0), each plus 4 of its own for smooth playback.
+//
+// A decoder that keeps the pictures it reorders in its capture buffers needs 16, the deepest
+// reordering a stream can have, as its output delay. This device reorders on the host, and its
+// capture buffers hold no pictures that wait for their display order, so the delays only keep the
+// framework feeding the decoder until the host releases a picture. The framework stops queuing
+// work once the works that wait for an output, with their input already released, reach the
+// pipeline delay plus the output delay plus 4, and the host releases a picture once more than the
+// stream's reorder depth R of them wait, so it needs R + 1 works queued: no stream stalls while
+// R <= the pipeline delay + the output delay + 3. R is at most 16 (the HEVC limit,
+// sps_max_num_reorder_pics, is 15; an H.264 stream without a bitstream restriction can reach 16),
+// which a sum of 13 covers. Only a work that is done can tell the framework another delay, and a
+// stream that needs the whole limit completes none before it has it, so the sum is the same for
+// every stream and set at the start.
+struct DecodeDelays {
+    uint32_t output;
+    uint32_t pipeline;
+};
+
+constexpr uint32_t kReorderingDelaySum = 13;
+
+// What the sum is spent on depends on what a capture buffer costs. A picture is held in the guest
+// and again on the host, so a capture buffer costs 23.7 MiB at 4K, 5.9 MiB at 1080p and 2.6 MiB at
+// 720p, where an input block costs 4, 2 and 1 MiB.
+//
+// A picture above 1080p takes an output delay of 4: 8 capture buffers and 13 input slots, 142 MiB
+// less than 14 capture buffers and 7 input slots at 4K. A 60 fps stream at 1080p or below is
+// bound by how many pictures the decoder can have in flight when the guest is busy (a 2 vCPU
+// guest, the minutes after a boot): 8 capture buffers decoded 10 to 13 percent fewer frames
+// there than 14 and 12 decoded as many as 14, so those pictures take an output delay of 8: 12
+// capture buffers and 9 input slots.
+constexpr DecodeDelays kLargePictureDelays = {4, 9};
+constexpr DecodeDelays kSmallPictureDelays = {8, 5};
+static_assert(kLargePictureDelays.output + kLargePictureDelays.pipeline == kReorderingDelaySum,
+              "a large picture must keep the stall limit");
+static_assert(kSmallPictureDelays.output + kSmallPictureDelays.pipeline == kReorderingDelaySum,
+              "a small picture must keep the stall limit");
+
+// The largest picture, in luma samples, that takes the small split: 1920x1088, the coded size of
+// 1080p.
+constexpr uint64_t kSmallPictureMaxLumaSamples = 1920ull * 1088ull;
+
+// The delays of an H.264 or HEVC stream configured for a picture of this size. Only the size the
+// client configures decides: the framework reads the delays once when it starts, and the picture
+// size the device later states for the stream changes neither the buffers it has sized nor the
+// limit, whichever side of the line it falls on.
+constexpr DecodeDelays getReorderingDelays(uint32_t width, uint32_t height) {
+    return static_cast<uint64_t>(width) * height <= kSmallPictureMaxLumaSamples
+                   ? kSmallPictureDelays
+                   : kLargePictureDelays;
+}
+
+}  // namespace android
+
+#endif  // ANDROID_V4L2_CODEC2_COMPONENTS_DECODE_DELAYS_H
