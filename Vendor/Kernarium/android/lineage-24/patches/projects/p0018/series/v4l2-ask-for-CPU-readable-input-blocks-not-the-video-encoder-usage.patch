From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 25 Oct 2026 18:37:21 +0900
Subject: [PATCH] v4l2: ask for CPU-readable input blocks, not the
 video-encoder usage

The component maps every input block it reads, to find the plane layout and
to convert a layout the device does not take. The framework refuses to map a
block that was not allocated for CPU access, and a producer allocates with the
usage the component declares, which was VIDEO_ENCODER alone: a Surface input
from GLES then delivered blocks the component could not lock, and encoding
failed on the first frame.

The same usage also made the allocation of a flexible YUV block fail on a
gralloc that has no such combination, which is the case when the GPU cannot
sample NV12, so a ByteBuffer input could not start at all. Declare CPU read
instead, as the software encoders do, and fetch the blocks of the format
converter with CPU access alone for the same reason. The coded-output blocks
keep the VIDEO_ENCODER usage they were already fetched with.
---
 common/FormatConverter.cpp                           | 12 +++++-------
 components/EncodeInterface.cpp                       | 10 ++++++----
 .../include/v4l2_codec2/components/EncodeInterface.h |  2 +-
 3 files changed, 12 insertions(+), 12 deletions(-)

diff --git a/common/FormatConverter.cpp b/common/FormatConverter.cpp
index 8a9787b4923d92b7767b56fbd06f060ba4807159..0a23bc929143e86dc0c924473e383c15527f6ce0 100644
--- a/common/FormatConverter.cpp
+++ b/common/FormatConverter.cpp
@@ -24,8 +24,6 @@
 
 #include <v4l2_codec2/common/VideoTypes.h>  // for HalPixelFormat
 
-using android::hardware::graphics::common::V1_0::BufferUsage;
-
 namespace android {
 
 namespace {
@@ -161,11 +159,11 @@ c2_status_t FormatConverter::allocateBuffers(uint32_t count) {
 
     for (uint32_t i = 0; i < count; i++) {
         std::shared_ptr<C2GraphicBlock> block;
-        status = pool->fetchGraphicBlock(mCodedSize.width, mCodedSize.height,
-                                         static_cast<uint32_t>(halFormat),
-                                         {(C2MemoryUsage::CPU_READ | C2MemoryUsage::CPU_WRITE),
-                                          static_cast<uint64_t>(BufferUsage::VIDEO_ENCODER)},
-                                         &block);
+        // The converter writes the frames and the encoder reads them through the CPU. The video
+        // encoder usage is left out because gralloc may have no YUV combination for it.
+        status = pool->fetchGraphicBlock(
+                mCodedSize.width, mCodedSize.height, static_cast<uint32_t>(halFormat),
+                C2MemoryUsage(C2MemoryUsage::CPU_READ | C2MemoryUsage::CPU_WRITE), &block);
         if (status != C2_OK) {
             ALOGE("Failed to fetch graphic block (error: %d)", status);
             return C2_NO_MEMORY;
diff --git a/components/EncodeInterface.cpp b/components/EncodeInterface.cpp
index f9aa39d12b60606992a510e4ee05ebc04ed1de9b..cd2a773bbd1cfdc9bc0bb0ef2a117fd574615ca7 100644
--- a/components/EncodeInterface.cpp
+++ b/components/EncodeInterface.cpp
@@ -12,7 +12,6 @@
 
 #include <C2PlatformSupport.h>
 #include <SimpleC2Interface.h>
-#include <android/hardware/graphics/common/1.0/types.h>
 #include <media/stagefright/MediaDefs.h>
 #include <utils/Log.h>
 
@@ -21,8 +20,6 @@
 #include <v4l2_codec2/common/HEVC.h>
 #include <v4l2_codec2/common/VideoTypes.h>
 
-using android::hardware::graphics::common::V1_0::BufferUsage;
-
 namespace android {
 
 namespace {
@@ -619,9 +616,14 @@ void EncodeInterface::Initialize(const C2String& name, const SupportedCapabiliti
                     .withConstValue(new C2StreamBufferTypeSetting::input(0u, C2BufferData::GRAPHIC))
                     .build());
 
+    // The component maps every input block it reads: to find the plane layout, and to convert a
+    // layout the device does not take. Producers allocate with the usage declared here, and the
+    // framework refuses to map a block that was not allocated for CPU access, so the usage is CPU
+    // read. VIDEO_ENCODER is left out because gralloc may have no flexible YUV combination for
+    // it, as on a host whose GPU cannot sample NV12, and then no input block can be allocated.
     addParameter(DefineParam(mInputMemoryUsage, C2_PARAMKEY_INPUT_STREAM_USAGE)
                          .withConstValue(new C2StreamUsageTuning::input(
-                                 0u, static_cast<uint64_t>(BufferUsage::VIDEO_ENCODER)))
+                                 0u, static_cast<uint64_t>(C2MemoryUsage::CPU_READ)))
                          .build());
 
     addParameter(
diff --git a/components/include/v4l2_codec2/components/EncodeInterface.h b/components/include/v4l2_codec2/components/EncodeInterface.h
index d26f533b70a03ef4c8561294e00b0e89c04f253e..2b404e5b7800a1ede9288af6e8b81fe957730277 100644
--- a/components/include/v4l2_codec2/components/EncodeInterface.h
+++ b/components/include/v4l2_codec2/components/EncodeInterface.h
@@ -125,7 +125,7 @@ protected:
     std::shared_ptr<C2ComponentKindSetting> mKind;
     // The input format kind; should be C2FormatVideo.
     std::shared_ptr<C2StreamBufferTypeSetting::input> mInputFormat;
-    // The memory usage flag of input buffer; should be BufferUsage::VIDEO_ENCODER.
+    // The memory usage flag of input buffer; should be C2MemoryUsage::CPU_READ.
     std::shared_ptr<C2StreamUsageTuning::input> mInputMemoryUsage;
     // The output format kind; should be C2FormatCompressed.
     std::shared_ptr<C2StreamBufferTypeSetting::output> mOutputFormat;
