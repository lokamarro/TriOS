From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 26 Oct 2026 08:28:27 +0900
Subject: [PATCH] v4l2: report the range a stream states without a colour
 description

The parsers of the sequence parameter set found the colour aspects of a
stream only when its VUI carried a colour description. A stream whose
VUI says the samples are full range but names no primaries, transfer or
matrix returned no aspects at all, so the decoder reported the default
limited range for it and a client that converted the picture clipped the
extremes.

The parsers now return the range whenever the VUI states a video signal
type, with the other three aspects unspecified when it gives no
description.
---
 common/H264NalParser.cpp | 8 +++++++-
 common/HEVCNalParser.cpp | 8 +++++++-
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/common/H264NalParser.cpp b/common/H264NalParser.cpp
index d2949c50d9c464999ce615f427cfbbf015f50c1f..f3ea712662bc470c8d70e646df1c3c1c118374e3 100644
--- a/common/H264NalParser.cpp
+++ b/common/H264NalParser.cpp
@@ -206,6 +206,12 @@ bool H264NalParser::findCodedColorAspects(ColorAspects* colorAspects) {
             if (!br.getBitsGraceful(1, &videoFullRangeFlag))
                 return false;  // VUI videoFullRangeFlag
             colorAspects->fullRange = videoFullRangeFlag;
+            // Without a colour description the primaries, transfer and matrix are unspecified (2),
+            // but the range is stated.
+            constexpr uint32_t kUnspecified = 2;
+            colorAspects->primaries = kUnspecified;
+            colorAspects->transfer = kUnspecified;
+            colorAspects->coeffs = kUnspecified;
             uint32_t color_description_present_flag;
             if (!br.getBitsGraceful(1, &color_description_present_flag))
                 return false;  // VUI color_description_present_flag
@@ -216,8 +222,8 @@ bool H264NalParser::findCodedColorAspects(ColorAspects* colorAspects) {
                     return false;  // VUI transfer_characteristics
                 if (!br.getBitsGraceful(8, &colorAspects->coeffs))
                     return false;  // VUI matrix_coefficients
-                return true;
             }
+            return true;
         }
     }
 
diff --git a/common/HEVCNalParser.cpp b/common/HEVCNalParser.cpp
index 89c67f7e06ba50b9a80e5ffb07cbe00a8d0fba96..a277da9098a1cfb29440d25527aca38430b7b014 100644
--- a/common/HEVCNalParser.cpp
+++ b/common/HEVCNalParser.cpp
@@ -345,6 +345,12 @@ bool HEVCNalParser::findCodedColorAspects(ColorAspects* colorAspects) {
             if (!br.getBitsGraceful(1, &videoFullRangeFlag))
                 return false;  // VUI videoFullRangeFlag
             colorAspects->fullRange = videoFullRangeFlag;
+            // Without a colour description the primaries, transfer and matrix are unspecified (2),
+            // but the range is stated.
+            constexpr uint32_t kUnspecified = 2;
+            colorAspects->primaries = kUnspecified;
+            colorAspects->transfer = kUnspecified;
+            colorAspects->coeffs = kUnspecified;
             uint32_t color_description_present_flag;
             if (!br.getBitsGraceful(1, &color_description_present_flag))
                 return false;  // VUI color_description_present_flag
@@ -355,8 +361,8 @@ bool HEVCNalParser::findCodedColorAspects(ColorAspects* colorAspects) {
                     return false;  // VUI transfer_characteristics
                 if (!br.getBitsGraceful(8, &colorAspects->coeffs))
                     return false;  // VUI matrix_coefficients
-                return true;
             }
+            return true;
         }
     }
 
