From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 26 Oct 2026 15:19:13 +0900
Subject: [PATCH] v4l2: pass the HLG transfer function to the encoder device

The encoder mapped the transfer functions the UAPI headers name and left
hybrid log-gamma at the default, so a stream the client described as HLG
reached the device without it and carried no transfer function in its
headers. The kernel of this project accepts HLG as xfer_func 8, which the copy
of the UAPI headers in Android does not name, so the component defines the
value and maps TRANSFER_HLG to it.
---
 v4l2/V4L2Device.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/v4l2/V4L2Device.cpp b/v4l2/V4L2Device.cpp
index 8a4b902b64d0d32e73f3ddbcafaa6974333173e3..0f9c4a19c2c8661ffa78b71a6810f64461448cd1 100644
--- a/v4l2/V4L2Device.cpp
+++ b/v4l2/V4L2Device.cpp
@@ -40,6 +40,12 @@
 #include <v4l2_codec2/common/Fourcc.h>
 #include <v4l2_codec2/common/VideoPixelFormat.h>
 
+// The kernel names the hybrid log-gamma transfer function after SMPTE ST 2084, as the 8 that the
+// V4L2 core accepts for xfer_func; the copy of the UAPI headers in Android does not.
+#ifndef V4L2_XFER_FUNC_HLG
+#define V4L2_XFER_FUNC_HLG 8
+#endif
+
 namespace android {
 
 bool isValidPixFmtForCodec(VideoCodec codec, uint32_t pixFmt) {
@@ -1948,6 +1954,9 @@ V4L2Colorimetry V4L2Device::c2ColorAspectsToV4L2Colorimetry(C2Color::range_t ran
     case C2Color::TRANSFER_ST2084:
         colorimetry.xferFunc = V4L2_XFER_FUNC_SMPTE2084;
         break;
+    case C2Color::TRANSFER_HLG:
+        colorimetry.xferFunc = V4L2_XFER_FUNC_HLG;
+        break;
     default:
         break;
     }
