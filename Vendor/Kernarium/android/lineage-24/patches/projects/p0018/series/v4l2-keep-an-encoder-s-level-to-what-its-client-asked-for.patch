+C2Config::level_t EncodeInterface::getEffectiveLevel() const {
+    const C2Config::level_t requested = getOutputLevel();
+    const ui::Size size = getInputVisibleSize();
+    C2Config::level_t needed = C2Config::LEVEL_UNUSED;
+    if (isHEVCProfile(getOutputProfile())) {
+        needed = lowestHEVCLevel(size, getFramerate(), getBitrate(), mOfferedLevels);
+    } else if (isH264Profile(getOutputProfile())) {
+        needed = lowestH264Level(getOutputProfile(), size, getFramerate(), getBitrate(),
+                                 mOfferedLevels);
+    }
+    return needed != C2Config::LEVEL_UNUSED && needed > requested ? needed : requested;
+}
+
+uint32_t EncodeInterface::getPeakBitrate() const {
+    const uint32_t bitrate = getBitrate();
+    uint64_t peak = static_cast<uint64_t>(bitrate) * VideoEncoder::kPeakBitrateMultiplier;
+
+    // A stream that states a level has to stay within the bitrate the level allows, or the device
+    // states a higher level than the client asked for.
+    const C2Config::level_t level = getEffectiveLevel();
+    uint64_t levelMaxBR = 0;
+    if (isHEVCProfile(getOutputProfile())) {
+        for (const HEVCLevelLimits& limit : kHEVCLimits) {
+            if (limit.level == level) levelMaxBR = limit.maxBR;
+        }
+    } else {
+        for (const H264LevelLimits& limit : kH264Limits) {
+            if (limit.level == level) {
+                levelMaxBR = h264ProfileMaxBitrate(getOutputProfile(), limit.maxBR);
+            }
+        }
+    }
+    if (levelMaxBR > 0) peak = std::min(peak, levelMaxBR);
+    return static_cast<uint32_t>(std::clamp<uint64_t>(peak, bitrate, UINT32_MAX));
+}
+
 uint32_t EncodeInterface::getMaxBFrames() const {
     if (!mGop) return 0;
 
