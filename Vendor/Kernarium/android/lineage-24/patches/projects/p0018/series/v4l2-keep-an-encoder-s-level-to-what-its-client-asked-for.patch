-C2Config::level_t EncodeInterface::lowestConfigLevel = C2Config::LEVEL_UNUSED;
+// Returns the highest bitrate |profile| may have at the H.264 level with |levelMaxBR| for its
+// Baseline, Main and Extended profiles (Table A-2).
+uint32_t h264ProfileMaxBitrate(C2Config::profile_t profile, uint32_t levelMaxBR) {
+    // The maximum bit rate for High Profile is 1.25 times that of the Base/Extended/Main
+    // Profiles, 3 times for Hi10P, and 4 times for Hi422P/Hi444PP.
+    if (profile >= C2Config::PROFILE_AVC_HIGH_422) return levelMaxBR * 4;
+    if (profile >= C2Config::PROFILE_AVC_HIGH_10) return levelMaxBR * 3;
+    if (profile >= C2Config::PROFILE_AVC_HIGH) return levelMaxBR * 5.0 / 4.0;
+    return levelMaxBR;
+}
+
+// Returns the lowest of the |offered| H.264 levels whose limits hold a stream of |profile|, |size|,
+// |frameRate| and |bitrate|, or LEVEL_UNUSED when none does.
+C2Config::level_t lowestH264Level(C2Config::profile_t profile, const ui::Size& size,
+                                  float frameRate, uint32_t bitrate,
+                                  const std::vector<C2Config::level_t>& offered) {
+    const uint64_t frameSize = static_cast<uint64_t>((size.width + 15) / 16) *
+                               static_cast<uint64_t>((size.height + 15) / 16);
+    const float macroblockRate = static_cast<float>(frameSize) * frameRate;
+    for (const H264LevelLimits& limit : kH264Limits) {
+        if (std::find(offered.begin(), offered.end(), limit.level) == offered.end()) continue;
+        if (frameSize <= limit.maxFS && macroblockRate <= limit.maxMBPS &&
+            bitrate <= h264ProfileMaxBitrate(profile, limit.maxBR)) {
+            return limit.level;
+        }
+    }
+    return C2Config::LEVEL_UNUSED;
+}
+
+// Returns the lowest of the |offered| HEVC levels whose Main tier limits hold a stream of |size|,
+// |frameRate| and |bitrate|, or LEVEL_UNUSED when none does.
+C2Config::level_t lowestHEVCLevel(const ui::Size& size, float frameRate, uint32_t bitrate,
+                                  const std::vector<C2Config::level_t>& offered) {
+    const uint64_t lumaPs = static_cast<uint64_t>(size.width) * static_cast<uint64_t>(size.height);
+    const double lumaSr = static_cast<double>(lumaPs) * frameRate;
+    for (const HEVCLevelLimits& limit : kHEVCLimits) {
+        if (std::find(offered.begin(), offered.end(), limit.level) == offered.end()) continue;
+        if (lumaPs <= limit.maxLumaPs && lumaSr <= limit.maxLumaSampleRate &&
+            bitrate <= limit.maxBR) {
+            return limit.level;
+        }
+    }
+    return C2Config::LEVEL_UNUSED;
+}
