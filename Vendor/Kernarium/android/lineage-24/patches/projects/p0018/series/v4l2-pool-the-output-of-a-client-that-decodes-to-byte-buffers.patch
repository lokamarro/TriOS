From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 26 Oct 2026 08:26:50 +0900
Subject: [PATCH] v4l2: pool the output of a client that decodes to byte
 buffers

CCodec creates a pooled output block pool only for the allocators in
debug.stagefright.c2-poolmask, which by default are ION and BUFFERQUEUE.
A client that decodes to byte buffers therefore configures the basic
graphic pool, whose blocks carry no pool data, and the frame pool, which
tells the blocks of its fixed set of capture buffers apart by that data,
dereferenced a null pointer and took the codec service down. With GRALLOC
in the mask the blocks are AIDL buffer pool blocks instead, which the
frame pool refused.

The component now pools the output itself when the client configured the
basic graphic pool, with a GRALLOC pool of its own, and the frame pool
names an AIDL buffer pool block by its pool id like a block of the HIDL
pool. Changing the global pool mask would have changed every software
codec as well.
---
 components/Android.bp          |  1 +
 components/DecodeComponent.cpp | 13 ++++++++++++-
 components/VideoFramePool.cpp  | 14 ++++++++++++++
 3 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/components/Android.bp b/components/Android.bp
index ecb5fed93f631654700b42fad1d3814308ea8637..e0062c9c06a2c527ef0455adc01e23e44531d3ab 100644
--- a/components/Android.bp
+++ b/components/Android.bp
@@ -41,6 +41,7 @@ cc_library {
         "libcutils",
         "liblog",
         "libsfplugin_ccodec_utils",
+        "libstagefright_aidl_bufferpool2",
         "libstagefright_bufferqueue_helper",
         "libstagefright_foundation",
         "libui",
diff --git a/components/DecodeComponent.cpp b/components/DecodeComponent.cpp
index 00880d7b53734db57c14ac963f7d71cedb51eccc..b21af2d52311e85ca4ede929440abf6260525ce7 100644
--- a/components/DecodeComponent.cpp
+++ b/components/DecodeComponent.cpp
@@ -198,7 +198,18 @@ std::unique_ptr<VideoFramePool> DecodeComponent::getVideoFramePool(const ui::Siz
     auto poolId = mIntfImpl->getBlockPoolId();
     ALOGI("Using C2BlockPool ID = %" PRIu64 " for allocating output buffers", poolId);
     std::shared_ptr<C2BlockPool> blockPool;
-    auto status = GetCodec2BlockPool(poolId, std::move(sharedThis), &blockPool);
+    c2_status_t status;
+    if (poolId == C2BlockPool::BASIC_GRAPHIC && !mIsSecure) {
+        // A basic graphic pool allocates a block for every fetch, with no pool data to tell the
+        // blocks apart, while the frame pool needs to know the same block when it comes back. A
+        // client that decodes to byte buffers leaves GRALLOC out of its pool mask and so
+        // configures this pool, so the component pools its output itself.
+        ALOGI("The client configured the basic graphic pool; pooling the output buffers instead");
+        status = CreateCodec2BlockPool(C2PlatformAllocatorStore::GRALLOC, std::move(sharedThis),
+                                       &blockPool);
+    } else {
+        status = GetCodec2BlockPool(poolId, std::move(sharedThis), &blockPool);
+    }
     if (status != C2_OK) {
         ALOGE("Graphic block allocator is invalid: %d", status);
         reportError(status);
diff --git a/components/VideoFramePool.cpp b/components/VideoFramePool.cpp
index ae5cd3408803ccbca4ff4ec1f5d816a063fd2411..6f61dd560cd95f6e824b0aa99b13c0e4d7bdc937 100644
--- a/components/VideoFramePool.cpp
+++ b/components/VideoFramePool.cpp
@@ -12,6 +12,7 @@
 
 #include <C2BlockInternal.h>
 #include <bufferpool/BufferPoolTypes.h>
+#include <bufferpool2/BufferPoolTypes.h>
 
 #include <android/hardware_buffer.h>
 #include <android/hardware/graphics/common/1.0/types.h>
@@ -74,6 +75,19 @@ std::optional<uint32_t> VideoFramePool::getBufferIdFromGraphicBlock(C2BlockPool&
     case V4L2AllocatorId::SECURE_LINEAR: {
         std::shared_ptr<_C2BlockPoolData> blockPoolData =
                 _C2BlockFactory::GetGraphicBlockPoolData(block);
+        if (!blockPoolData) {
+            ALOGE("Obtained C2GraphicBlock has no pool data.");
+            return std::nullopt;
+        }
+        if (blockPoolData->getType() == _C2BlockPoolData::TYPE_BUFFERPOOL2) {
+            // The AIDL Codec2 HAL pools its graphic blocks with the AIDL buffer pool.
+            std::shared_ptr<bufferpool2_BufferPoolData> aidlData;
+            if (!_C2BlockFactory::GetBufferPoolData(blockPoolData, &aidlData) || !aidlData) {
+                ALOGE("AIDL BufferPoolData unavailable in block.");
+                return std::nullopt;
+            }
+            return aidlData->mId;
+        }
         if (blockPoolData->getType() != _C2BlockPoolData::TYPE_BUFFERPOOL) {
             ALOGE("Obtained C2GraphicBlock is not bufferpool-backed.");
             return std::nullopt;
