 };
 
+using VideoPixelRateBudget = PixelRateBudget<kVideoPixelRateResourceId>;
+using VideoDecodePixelRateBudget = PixelRateBudget<kVideoDecodePixelRateResourceId>;
+
+// What one instance holds of a budget, from its start until it stops. The claim is given back with
+// the instance whichever way the instance ends.
+template <typename Budget>
+class PixelRateClaim {
+public:
+    PixelRateClaim() = default;
+    PixelRateClaim(const PixelRateClaim&) = delete;
+    PixelRateClaim& operator=(const PixelRateClaim&) = delete;
+    ~PixelRateClaim() { release(); }
+
+    // Takes |rate| of |capacity| if the budget allows; false if it does not.
+    bool claim(uint64_t rate, uint64_t capacity) {
+        if (!Budget::claim(rate, capacity)) return false;
+        mRate = rate;
+        mHeld = true;
+        return true;
+    }
+
+    // The instance needs |rate| from now on.
+    void change(uint64_t rate) {
+        if (!mHeld) return;
+        Budget::change(mRate, rate);
+        mRate = rate;
+    }
+
+    void release() {
+        if (!mHeld) return;
+        Budget::release(mRate);
+        mRate = 0;
+        mHeld = false;
+    }
+
+private:
+    uint64_t mRate = 0;
+    bool mHeld = false;
+};
