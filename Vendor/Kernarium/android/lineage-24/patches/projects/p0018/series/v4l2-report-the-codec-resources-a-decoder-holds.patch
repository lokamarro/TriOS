             .plus(info.F(info.v.level).validatePossible(info.v.level));
 }
 
+// static
+C2R DecodeInterface::OperatingRateSetter(bool /* mayBlock */, C2P<C2OperatingRateTuning>& me) {
+    // A negative rate is invalid; no rate is zero.
+    if (me.v.value < 0) me.set().value = 0;
+    return C2R::Ok();
+}
+
+// static
+C2R DecodeInterface::ResourcesNeededSetter(bool /* mayBlock */, C2P<C2ResourcesNeededTuning>& me,
+                                           const C2P<C2StreamPictureSizeInfo::output>& size,
+                                           const C2P<C2StreamFrameRateInfo::output>& frameRate,
+                                           const C2P<C2OperatingRateTuning>& operatingRate,
+                                           const C2P<C2RealTimePriorityTuning>& priority) {
+    // The instance takes the session it holds, whatever it decodes, and the pixel rate of its stream
+    // if it runs in real time. A priority below 0 asks the device for best effort at the rate the
+    // client hints, so such an instance takes whatever the real-time ones leave, and none of the
+    // capacity. A client that gives an operating rate means to feed the frames at that rate.
+    const bool realTime = priority.v.value >= 0;
+    const float rate = operatingRate.v.value > 0 ? operatingRate.v.value : frameRate.v.value;
+    if (me.v.flexCount() > 1 && me.v.m.values[1].id == kVideoDecodePixelRateResourceId) {
+        me.set().m.values[1].amount =
+                realTime ? videoPixelRateNeeded(size.v.width, size.v.height, rate) : 0;
+    }
+    return C2R::Ok();
+}
+
 // static
 C2R DecodeInterface::SizeSetter(bool /* mayBlock */,
                                 C2P<C2StreamPictureSizeInfo::output>& videoSize) {
@@ -148,6 +175,10 @@ DecodeInterface::DecodeInterface(const std::string& name,
     ALOGV("%s(%s)", __func__, name.c_str());
 
     setDerivedInstance(this);
+    mPixelRateCapacity = caps.pixelRateCapacity;
+
+    // The system resources are a struct that the reflector does not know yet.
+    helper->addStructDescriptors<C2SystemResourceStruct>();
 
     addParameter(DefineParam(mKind, C2_PARAMKEY_COMPONENT_KIND)
                          .withConstValue(new C2ComponentKindSetting(C2Component::KIND_DECODER))
@@ -373,12 +404,48 @@ DecodeInterface::DecodeInterface(const std::string& name,
                          .withDefault(new C2StreamPictureSizeInfo::output(
                                  0u, std::min(320, maxSize.width), std::min(240, maxSize.height)))
                          .withFields({
-                                 C2F(mSize, width).inRange(16, maxSize.width, 16),
-                                 C2F(mSize, height).inRange(16, maxSize.height, 16),
+                                 C2F(mSize, width).inRange(16, maxSize.width, 2),
+                                 C2F(mSize, height).inRange(16, maxSize.height, 2),
                          })
                          .withSetter(SizeSetter)
                          .build());
 
+    // The system resources of the instance, which the framework adds up with the capacity the store
+    // reports into the globally available resources. The pixel rate is among them only if the
+    // store has a pixel rate capacity to take it from.
+    addParameter(DefineParam(mFrameRate, C2_PARAMKEY_FRAME_RATE)
+                         .withDefault(new C2StreamFrameRateInfo::output(0u, 30.))
+                         .withFields({C2F(mFrameRate, value).greaterThan(0.)})
+                         .withSetter(Setter<decltype(*mFrameRate)>::StrictValueWithNoDeps)
+                         .build());
+
+    addParameter(DefineParam(mOperatingRate, C2_PARAMKEY_OPERATING_RATE)
+                         .withDefault(new C2OperatingRateTuning(0.f))
+                         .withFields({C2F(mOperatingRate, value).any()})
+                         .withSetter(OperatingRateSetter)
+                         .build());
+
+    addParameter(DefineParam(mRealTimePriority, C2_PARAMKEY_PRIORITY)
+                         .withDefault(new C2RealTimePriorityTuning(0))
+                         .withFields({C2F(mRealTimePriority, value).any()})
+                         .withSetter(Setter<decltype(*mRealTimePriority)>::NonStrictValueWithNoDeps)
+                         .build());
+
+    {
+        const std::vector<C2SystemResourceStruct> needed =
+                videoResourcesNeeded(320, 240, 0.f, true, caps.pixelRateCapacity > 0,
+                                     kVideoDecodePixelRateResourceId);
+        addParameter(DefineParam(mResourcesNeeded, C2_PARAMKEY_RESOURCES_NEEDED)
+                             .withDefault(C2ResourcesNeededTuning::AllocShared(needed.size(),
+                                                                               needed))
+                             .withFields({C2F(mResourcesNeeded, m.values[0].id).any(),
+                                          C2F(mResourcesNeeded, m.values[0].kind).any(),
+                                          C2F(mResourcesNeeded, m.values[0].amount).any()})
+                             .calculatedAs(ResourcesNeededSetter, mSize, mFrameRate, mOperatingRate,
+                                           mRealTimePriority)
+                             .build());
+    }
+
     addParameter(
             DefineParam(mMaxInputSize, C2_PARAMKEY_INPUT_MAX_BUFFER_SIZE)
                     .withDefault(new C2StreamMaxBufferSizeInfo::input(0u, kInputBufferSizeFor1080p))
@@ -483,6 +550,23 @@ DecodeInterface::DecodeInterface(const std::string& name,
     }
 }
 
+uint64_t DecodeInterface::getPixelRateNeeded() const {
+    Lock lock = this->lock();
+    for (size_t i = 0; i < mResourcesNeeded->flexCount(); ++i) {
+        const C2SystemResourceStruct& resource = mResourcesNeeded->m.values[i];
+        if (resource.id == kVideoDecodePixelRateResourceId) return resource.amount;
+    }
+    return 0;
+}
+
+c2_status_t DecodeInterface::updatePictureSize(uint32_t width, uint32_t height) {
+    constexpr uint32_t kStep = 2;
+    C2StreamPictureSizeInfo::output size(0u, (width + kStep - 1) / kStep * kStep,
+                                         (height + kStep - 1) / kStep * kStep);
+    std::vector<std::unique_ptr<C2SettingResult>> failures;
+    return config({&size}, C2_MAY_BLOCK, &failures);
+}
+
 size_t DecodeInterface::getInputBufferSize() const {
     return mMaxInputSize->value;
 }
