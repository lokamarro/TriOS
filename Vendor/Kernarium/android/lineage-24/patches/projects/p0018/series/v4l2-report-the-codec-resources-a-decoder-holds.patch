diff --git a/components/DecodeComponent.cpp b/components/DecodeComponent.cpp
index 91b51543ee69641efe888ce42f4e8eedbd072033..a428ce80628236b58204302899967be38c4eb758 100644
--- a/components/DecodeComponent.cpp
+++ b/components/DecodeComponent.cpp
@@ -155,8 +155,22 @@ c2_status_t DecodeComponent::start() {
         return C2_BAD_STATE;
     }
 
+    // The device decodes the real-time streams of its instances only up to the pixel rate it
+    // sustains, and the framework relies on a start to fail where the resources are used up.
+    const uint64_t pixelRate = mIntfImpl->getPixelRateNeeded();
+    if (!mPixelRate.claim(pixelRate, mIntfImpl->getPixelRateCapacity())) {
+        ALOGW("Not starting, the pixel rate %" PRIu64 " exceeds what the device has left",
+              pixelRate);
+        return C2_NO_MEMORY;
+    }
+    // The framework read the resources the instance needs when it configured the component.
+    mReportedPixelRateNeeded = pixelRate;
+    mDecodedWidth = 0;
+    mDecodedHeight = 0;
+
     if (!mDecoderThread.Start()) {
         ALOGE("Decoder thread failed to start.");
+        mPixelRate.release();
         return C2_CORRUPTED;
     }
     mDecoderTaskRunner = mDecoderThread.task_runner();
@@ -169,7 +183,11 @@ c2_status_t DecodeComponent::start() {
                                         ::base::Unretained(&status), ::base::Unretained(&done)));
     done.Wait();
 
-    if (status == C2_OK) mComponentState.store(ComponentState::RUNNING);
+    if (status == C2_OK) {
+        mComponentState.store(ComponentState::RUNNING);
+    } else {
+        mPixelRate.release();
+    }
     return status;
 }
 
@@ -241,6 +259,7 @@ c2_status_t DecodeComponent::stop() {
         mDecoderThread.Stop();
         mDecoderTaskRunner = nullptr;
     }
+    mPixelRate.release();
 
     mComponentState.store(ComponentState::STOPPED);
     return C2_OK;
@@ -277,6 +296,7 @@ c2_status_t DecodeComponent::release() {
         mDecoderThread.Stop();
         mDecoderTaskRunner = nullptr;
     }
+    mPixelRate.release();
 
     mComponentState.store(ComponentState::RELEASED);
     return C2_OK;
@@ -540,6 +560,16 @@ void DecodeComponent::onOutputFrameReady(std::unique_ptr<VideoFrame> frame) {
     C2Work* work = it->second.get();
 
     if (mFlushOutputToHost) frame->flushToHost();
+    // A stream that changes its size changes what the instance needs.
+    const Rect& visibleRect = frame->getVisibleRect();
+    const uint32_t decodedWidth = visibleRect.width();
+    const uint32_t decodedHeight = visibleRect.height();
+    if ((decodedWidth != mDecodedWidth || decodedHeight != mDecodedHeight) && decodedWidth > 0 &&
+        decodedHeight > 0) {
+        mDecodedWidth = decodedWidth;
+        mDecodedHeight = decodedHeight;
+        mIntfImpl->updatePictureSize(decodedWidth, decodedHeight);
+    }
     C2ConstGraphicBlock constBlock = std::move(frame)->getGraphicBlock();
     std::shared_ptr<C2Buffer> buffer = C2Buffer::CreateGraphicBuffer(std::move(constBlock));
     if (mPendingColorAspectsChange &&
@@ -552,6 +582,15 @@ void DecodeComponent::onOutputFrameReady(std::unique_ptr<VideoFrame> frame) {
     }
     work->worklets.front()->output.buffers.emplace_back(std::move(buffer));
 
+    // Tell the framework when the system resources the instance needs have changed, as they do when
+    // the client switches it between real time and not (the priority), or changes its rate.
+    const uint64_t pixelRateNeeded = mIntfImpl->getPixelRateNeeded();
+    if (pixelRateNeeded != mReportedPixelRateNeeded) {
+        work->worklets.front()->output.configUpdate.push_back(mIntfImpl->copyResourcesNeeded());
+        mReportedPixelRateNeeded = pixelRateNeeded;
+        mPixelRate.change(pixelRateNeeded);
+    }
+
     // Check no-show frame by timestamps for VP8/VP9 cases before reporting the current work.
     if (mIntfImpl->getVideoCodec() == VideoCodec::VP8 ||
         mIntfImpl->getVideoCodec() == VideoCodec::VP9) {
