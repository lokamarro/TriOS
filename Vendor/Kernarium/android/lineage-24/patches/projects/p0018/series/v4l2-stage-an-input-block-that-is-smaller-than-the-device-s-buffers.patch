     void processWork(const int32_t bitstreamId, const C2Work* work);
     void processWorkBuffer(const int32_t bitstreamId, const C2ConstLinearBlock& linearBlock);
+    // Copy |input| into a block of the size the device takes, for a client's block that is smaller.
+    bool stageInput(const C2ConstLinearBlock& input, C2ConstLinearBlock* staged);
 
     // Get the buffer pool.
     std::unique_ptr<VideoFramePool> getVideoFramePool(const ui::Size& size,
@@ -104,6 +106,8 @@ protected:
     std::shared_ptr<Listener> mListener;
 
     std::unique_ptr<VideoDecoder> mDecoder;
+    // The pool of the blocks a smaller input block of the client is staged in, created on first use.
+    std::shared_ptr<C2BlockPool> mInputStagingPool;
     // The queue of works that haven't processed and sent to |mDecoder|.
     std::queue<std::unique_ptr<C2Work>> mPendingWorks;
     // The works whose input buffers are sent to |mDecoder|. The key is the
