 .../v4l2_codec2/components/DecodeInterface.h  |  7 +++
 v4l2/V4L2DecodeComponent.cpp                  |  3 +-
 v4l2/V4L2Decoder.cpp                          | 51 ++++++++++++++++---
 v4l2/include/v4l2_codec2/v4l2/V4L2Decoder.h   | 14 +++--
 5 files changed, 82 insertions(+), 11 deletions(-)

