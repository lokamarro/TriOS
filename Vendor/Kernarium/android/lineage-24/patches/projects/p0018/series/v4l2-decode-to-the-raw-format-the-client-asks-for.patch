     return false;
 }
 
-bool V4L2Decoder::startOutputQueue(size_t minOutputBuffersCount, enum v4l2_memory memory) {
+bool V4L2Decoder::startOutputQueue(size_t minOutputBuffersCount, enum v4l2_memory memory,
+                                   bool streamKnown) {
     ALOGV("%s()", __func__);
     ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
 
@@ -307,7 +310,15 @@ bool V4L2Decoder::startOutputQueue(size_t minOutputBuffersCount, enum v4l2_memor
     }
 
     const ui::Size codedSize(format->fmt.pix_mp.width, format->fmt.pix_mp.height);
-    if (!setupOutputFormat(codedSize, format->fmt.pix_mp.pixelformat)) {
+    // Before the first picture is parsed there is no stream to ask a layout for: the initial
+    // buffers are 8-bit and take the device's own choice.
+    const uint32_t preferred = streamKnown ? preferredOutputFormat(format->fmt.pix_mp.pixelformat)
+                                           : format->fmt.pix_mp.pixelformat;
+    ALOGI("Output format: the device has %s, the client asked for %s: requesting %s",
+          fourccToString(format->fmt.pix_mp.pixelformat).c_str(),
+          mOutputFormat == HalPixelFormat::YCBCR_P010 ? "P010" : "8-bit",
+          fourccToString(preferred).c_str());
+    if (!setupOutputFormat(codedSize, preferred)) {
         return false;
     }
 
@@ -744,7 +755,7 @@ bool V4L2Decoder::changeResolution() {
         mInitialEosBuffer = nullptr;
     }
 
-    if (!startOutputQueue(mMinNumOutputBuffers, V4L2_MEMORY_DMABUF)) {
+    if (!startOutputQueue(mMinNumOutputBuffers, V4L2_MEMORY_DMABUF, true)) {
         ALOGE("Failed to start output queue during DRC.");
         return false;
     }
@@ -776,6 +787,32 @@ bool V4L2Decoder::changeResolution() {
     return true;
 }
 
+uint32_t V4L2Decoder::preferredOutputFormat(uint32_t deviceFormat) {
+    const std::vector<uint32_t> offered =
+            mDevice->enumerateSupportedPixelformats(V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+    const auto isOffered = [&offered](uint32_t pixfmt) {
+        return std::find(offered.begin(), offered.end(), pixfmt) != offered.end();
+    };
+
+    if (mOutputFormat == HalPixelFormat::YCBCR_P010) {
+        // A client that asked for P010 gets 10-bit samples whatever layout the device kept from
+        // an earlier choice. The device refuses P010 for a stream with 8-bit samples, and the
+        // caller then falls back to the layout the device offers.
+        return isOffered(Fourcc::P010) ? Fourcc::P010 : deviceFormat;
+    }
+
+    if (mOutputFormat != HalPixelFormat::YCBCR_420_888 || deviceFormat != Fourcc::P010) {
+        return deviceFormat;
+    }
+
+    // A client that did not ask for P010 gets 8-bit samples from a 10-bit stream when the device
+    // can convert them, as a software decoder does for a client that cannot take 10 bits.
+    for (const uint32_t pixfmt : {Fourcc::NM12, Fourcc::NV12}) {
+        if (isOffered(pixfmt)) return pixfmt;
+    }
+    return deviceFormat;
+}
