From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 27 Oct 2026 00:34:48 +0900
Subject: [PATCH] v4l2: take an IDR_N_LP picture as an HEVC random access point

The decoder waits for the resolution change event of an input that holds an
IDR picture, and it found one only by NAL unit type 19 (IDR_W_RADL). The host's
hardware encoder writes its IDR pictures as type 20 (IDR_N_LP), a picture with
no leading pictures, so a stream it coded was never known to carry one: the
decoder then went on without the event that sets up the capture queue, and a
drain that followed could finish before the first picture came out. Accept
both IDR types.
---
 common/HEVCNalParser.cpp                          | 2 +-
 common/include/v4l2_codec2/common/HEVCNalParser.h | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/common/HEVCNalParser.cpp b/common/HEVCNalParser.cpp
index a277da9098a1cfb29440d25527aca38430b7b014..e166daed30e050b5801d909d78a8e2c400a7a9b4 100644
--- a/common/HEVCNalParser.cpp
+++ b/common/HEVCNalParser.cpp
@@ -205,7 +205,7 @@ bool HEVCNalParser::locateSPS() {
 bool HEVCNalParser::locateIDR() {
     while (locateNextNal()) {
         if (length() == 0) continue;
-        if (type() != kIDRType) continue;
+        if (type() != kIDRType && type() != kIDRNLPType) continue;
         return true;
     }
 
diff --git a/common/include/v4l2_codec2/common/HEVCNalParser.h b/common/include/v4l2_codec2/common/HEVCNalParser.h
index 729ab656fae3d3ef289ff55102bed1cc2a7dcf60..9c9ba844719e1b296bb8cf478bb3451b6c3432c9 100644
--- a/common/include/v4l2_codec2/common/HEVCNalParser.h
+++ b/common/include/v4l2_codec2/common/HEVCNalParser.h
@@ -15,7 +15,8 @@ namespace android {
 class HEVCNalParser : public NalParser {
 public:
     // Type of a SPS NAL unit.
-    static constexpr uint8_t kIDRType = 19;  //IDR_W_RADL
+    static constexpr uint8_t kIDRType = 19;     // IDR_W_RADL
+    static constexpr uint8_t kIDRNLPType = 20;  // IDR_N_LP
     static constexpr uint8_t kVPSType = 32;
     static constexpr uint8_t kSPSType = 33;
     static constexpr uint8_t kPPSType = 34;
