 #include <C2Component.h>
@@ -115,6 +116,10 @@ protected:
     void onOutputBufferDone(size_t dataSize, int64_t timestamp, bool keyFrame,
                             std::unique_ptr<BitstreamBuffer> buffer);
 
+    // Called on the encoder thread when the encoder returns no data for a frame it was given. The
+    // frame was dropped, so its work item finishes without an output.
+    void onFrameDropped(int64_t timestamp);
+
     // Helper function to find a work item in the output work queue by index.
     C2Work* getWorkByIndex(uint64_t index);
     // Helper function to find a work item in the output work queue by timestamp.
@@ -192,6 +197,9 @@ protected:
     C2Config::level_t mOutputLevel = C2Config::LEVEL_UNUSED;
     // The pixel rate the instance needs, as the framework last learned it.
     uint64_t mReportedPixelRateNeeded = 0;
+    // The work items, by frame index, whose frame the encoder dropped and that await their turn to
+    // be reported.
+    std::unordered_set<uint64_t> mDroppedWork;
     // The pixel rate the instance holds of the device's, from its start until it stops.
     uint64_t mPixelRateClaimed = 0;
     bool mHoldsPixelRate = false;
