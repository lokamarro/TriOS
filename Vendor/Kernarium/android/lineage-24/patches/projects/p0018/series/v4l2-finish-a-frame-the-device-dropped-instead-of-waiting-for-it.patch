From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 26 Oct 2026 04:31:04 +0900
Subject: [PATCH] v4l2: finish a frame the device dropped instead of waiting
 for it

An encoder that holds the bitrate leaves frames out, and the device says
so: it returns the output buffer with the error flag and no data in place
of the frame's. The encoder discarded a buffer without data, so the work
item of the frame never got an output. Work finishes in the order of the
stream, so every item behind it waited for it too, and a client that waited
for the next output waited for good. A 4K stream at 256 kbit/s, which
VideoToolbox does not keep without leaving frames out, stopped after the
frame it dropped.

The encoder now reports a buffer that has the error flag and no data as a
dropped frame, and the component finishes the work item of the frame with
no output. The driver does not set the timestamp of a buffer it returns
with an error, so a timestamp that names none of the frames the device
holds stands for the oldest of them.
---
 components/EncodeComponent.cpp                | 43 ++++++++++++++++++-
 .../v4l2_codec2/components/EncodeComponent.h  |  8 ++++
 v4l2/V4L2Device.cpp                           |  7 +++
 v4l2/V4L2Encoder.cpp                          |  9 +++-
 v4l2/include/v4l2_codec2/v4l2/V4L2Device.h    |  2 +
 5 files changed, 66 insertions(+), 3 deletions(-)

diff --git a/components/EncodeComponent.cpp b/components/EncodeComponent.cpp
index acfdc6e5036804656fec84bf15b9a5c9cf46c1c5..5144a7a0320adea0517bb0c84aef26f39304ff23 100644
--- a/components/EncodeComponent.cpp
+++ b/components/EncodeComponent.cpp
@@ -890,6 +890,7 @@ void EncodeComponent::flush() {
         abortedWorkItems.push_back(std::move(work));
         mWorkQueue.pop_front();
     }
+    mDroppedWork.clear();
     if (!abortedWorkItems.empty()) {
         mListener->onWorkDone_nb(weak_from_this(), std::move(abortedWorkItems));
     }
@@ -958,6 +959,11 @@ void EncodeComponent::onOutputBufferDone(size_t dataSize, int64_t timestamp, boo
     ALOG_ASSERT(mEncoderTaskRunner->RunsTasksInCurrentSequence());
     ALOG_ASSERT(buffer->dmabuf);
 
+    if (dataSize == 0) {
+        onFrameDropped(timestamp);
+        return;
+    }
+
     C2ConstLinearBlock constBlock =
             buffer->dmabuf->share(buffer->dmabuf->offset(), dataSize, C2Fence());
 
@@ -1037,6 +1043,36 @@ void EncodeComponent::onOutputBufferDone(size_t dataSize, int64_t timestamp, boo
     reportFinishedWork();
 }
 
+void EncodeComponent::onFrameDropped(int64_t timestamp) {
+    ALOG_ASSERT(mEncoderTaskRunner->RunsTasksInCurrentSequence());
+
+    // The frames the encoder holds are those whose input it has taken and that have no output. The
+    // device returns the timestamp of the frame only if its driver sets one on a buffer it lost,
+    // so a timestamp that names none of them stands for the oldest.
+    C2Work* oldest = nullptr;
+    C2Work* named = nullptr;
+    for (const std::unique_ptr<C2Work>& work : mWorkQueue) {
+        if ((work->input.flags & C2FrameData::FLAG_END_OF_STREAM) || work->input.buffers.empty() ||
+            work->input.buffers.front() || !work->worklets.front()->output.buffers.empty() ||
+            mDroppedWork.count(work->input.ordinal.frameIndex.peeku())) {
+            continue;
+        }
+        if (!oldest) oldest = work.get();
+        if (!named && work->input.ordinal.timestamp.peeku() == static_cast<uint64_t>(timestamp)) {
+            named = work.get();
+        }
+    }
+    C2Work* dropped = named ? named : oldest;
+    if (!dropped) {
+        ALOGW("The device dropped a frame, but the encoder holds none");
+        return;
+    }
+
+    ALOGV("The frame at %" PRIu64 " was dropped", dropped->input.ordinal.timestamp.peeku());
+    mDroppedWork.insert(dropped->input.ordinal.frameIndex.peeku());
+    reportFinishedWork();
+}
+
 C2Work* EncodeComponent::getWorkByIndex(uint64_t index) {
     ALOGV("%s(): getting work item (index: %" PRIu64 ")", __func__, index);
     ALOG_ASSERT(mEncoderTaskRunner->RunsTasksInCurrentSequence());
@@ -1089,8 +1125,10 @@ bool EncodeComponent::isWorkDone(const C2Work& work) const {
         return false;
     }
 
-    // If the work item had an input buffer to be encoded, it should have an output buffer set.
-    if (!work.input.buffers.empty() && work.worklets.front()->output.buffers.empty()) {
+    // If the work item had an input buffer to be encoded, it should have an output buffer set,
+    // unless the encoder dropped the frame.
+    if (!work.input.buffers.empty() && work.worklets.front()->output.buffers.empty() &&
+        !mDroppedWork.count(work.input.ordinal.frameIndex.peeku())) {
         ALOGV("Output buffer associated with work item %" PRIu64 " not returned yet",
               work.input.ordinal.frameIndex.peeku());
         return false;
@@ -1125,6 +1163,7 @@ void EncodeComponent::reportWork(std::unique_ptr<C2Work> work) {
           work->input.ordinal.frameIndex.peekull(), work->input.ordinal.timestamp.peekull());
     ALOG_ASSERT(mEncoderTaskRunner->RunsTasksInCurrentSequence());
 
+    mDroppedWork.erase(work->input.ordinal.frameIndex.peeku());
     work->result = C2_OK;
     work->workletsProcessed = static_cast<uint32_t>(work->worklets.size());
 
