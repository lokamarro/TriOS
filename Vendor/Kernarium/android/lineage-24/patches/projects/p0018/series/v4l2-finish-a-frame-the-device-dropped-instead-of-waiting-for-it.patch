+++ b/v4l2/V4L2Device.cpp
@@ -647,6 +647,13 @@ bool V4L2ReadableBuffer::isKeyframe() const {
     return mBufferData->mV4l2Buffer.flags & V4L2_BUF_FLAG_KEYFRAME;
 }
 
+bool V4L2ReadableBuffer::hasError() const {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(mSequenceChecker);
+    ALOG_ASSERT(mBufferData);
+
+    return mBufferData->mV4l2Buffer.flags & V4L2_BUF_FLAG_ERROR;
+}
+
 struct timeval V4L2ReadableBuffer::getTimeStamp() const {
     DCHECK_CALLED_ON_VALID_SEQUENCE(mSequenceChecker);
     ALOG_ASSERT(mBufferData);
diff --git a/v4l2/V4L2Encoder.cpp b/v4l2/V4L2Encoder.cpp
index 773cb294a921b32da7bb96e79e56a1f9cfc1a607..48b0611c3cfa5bb0aafe6e2743bba4623738d0dc 100644
--- a/v4l2/V4L2Encoder.cpp
+++ b/v4l2/V4L2Encoder.cpp
@@ -1193,7 +1193,14 @@ bool V4L2Encoder::dequeueOutputBuffer() {
 
     std::unique_ptr<BitstreamBuffer> bitstreamBuffer =
             std::move(mOutputBuffers[buffer->bufferId()]);
-    if (encodedDataSize > 0) {
+    if (buffer->hasError() && !buffer->isLast()) {
+        // The device lost a frame, as a device does that holds the bitrate by leaving frames out.
+        // It returns a buffer with no data in place of the frame's, and tells the component with
+        // an empty output.
+        ALOGW("The device returned no data for a frame (timestamp: %" PRId64 ")",
+              timestamp.InMicroseconds());
+        mOutputBufferDoneCb.Run(0, timestamp.InMicroseconds(), false, std::move(bitstreamBuffer));
+    } else if (encodedDataSize > 0) {
         if (!mInjectParamsBeforeIDR) {
             // No need to inject SPS or PPS before IDR frames, we can just return the buffer as-is.
             mOutputBufferDoneCb.Run(encodedDataSize, timestamp.InMicroseconds(),
diff --git a/v4l2/include/v4l2_codec2/v4l2/V4L2Device.h b/v4l2/include/v4l2_codec2/v4l2/V4L2Device.h
index 68df33a3dd22c516bb9d4a5ede004269b41c4aae..b8b0075fb007404d8ca42befdaefccdd302ce3af 100644
--- a/v4l2/include/v4l2_codec2/v4l2/V4L2Device.h
+++ b/v4l2/include/v4l2_codec2/v4l2/V4L2Device.h
@@ -173,6 +173,8 @@ public:
     bool isLast() const;
     // Returns whether the V4L2_BUF_FLAG_KEYFRAME flag is set for this buffer.
     bool isKeyframe() const;
+    // Returns whether the V4L2_BUF_FLAG_ERROR flag is set for this buffer.
+    bool hasError() const;
     // Return the timestamp set by the driver on this buffer.
     struct timeval getTimeStamp() const;
     // Returns the number of planes in this buffer.
