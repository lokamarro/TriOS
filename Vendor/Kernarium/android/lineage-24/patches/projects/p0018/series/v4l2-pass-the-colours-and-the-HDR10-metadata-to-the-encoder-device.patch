+    // The raw formats of the frames: flexible YUV, and P010 when the device encodes Main 10, which
+    // is what makes the framework list the 10-bit colour formats.
+    std::vector<uint32_t> pixelFormats = {HAL_PIXEL_FORMAT_YCBCR_420_888};
+    if (std::any_of(caps.supportedProfiles.begin(), caps.supportedProfiles.end(),
+                    [](const SupportedProfile& profile) {
+                        return profile.profile == C2Config::PROFILE_HEVC_MAIN_10;
+                    })) {
+        pixelFormats.push_back(HAL_PIXEL_FORMAT_YCBCR_P010);
+    }
+    addParameter(DefineParam(mPixelFormat, C2_PARAMKEY_PIXEL_FORMAT)
+                         .withDefault(new C2StreamPixelFormatInfo::input(
+                                 0u, HAL_PIXEL_FORMAT_YCBCR_420_888))
+                         .withFields({C2F(mPixelFormat, value).oneOf(pixelFormats)})
+                         .withSetter(Setter<decltype(*mPixelFormat)>::NonStrictValueWithNoDeps)
+                         .build());
+
+    // The colours of the frames, which the stream describes the way the client does.
