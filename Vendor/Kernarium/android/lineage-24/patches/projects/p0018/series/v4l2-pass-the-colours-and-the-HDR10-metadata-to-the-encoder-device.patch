+// static
+V4L2Colorimetry V4L2Device::c2ColorAspectsToV4L2Colorimetry(C2Color::range_t range,
+                                                            C2Color::primaries_t primaries,
+                                                            C2Color::transfer_t transfer,
+                                                            C2Color::matrix_t matrix) {
+    V4L2Colorimetry colorimetry;
+
+    switch (primaries) {
+    case C2Color::PRIMARIES_BT709:
+        colorimetry.colorspace = V4L2_COLORSPACE_REC709;
+        break;
+    case C2Color::PRIMARIES_BT470_M:
+        colorimetry.colorspace = V4L2_COLORSPACE_470_SYSTEM_M;
+        break;
+    case C2Color::PRIMARIES_BT601_625:
+    case C2Color::PRIMARIES_EBU3213:
+        colorimetry.colorspace = V4L2_COLORSPACE_470_SYSTEM_BG;
+        break;
+    case C2Color::PRIMARIES_BT601_525:
+        colorimetry.colorspace = V4L2_COLORSPACE_SMPTE170M;
+        break;
+    case C2Color::PRIMARIES_BT2020:
+        colorimetry.colorspace = V4L2_COLORSPACE_BT2020;
+        break;
+    case C2Color::PRIMARIES_RP431:
+    case C2Color::PRIMARIES_EG432:
+        colorimetry.colorspace = V4L2_COLORSPACE_DCI_P3;
+        break;
+    default:
+        break;
+    }
+
+    switch (transfer) {
+    case C2Color::TRANSFER_LINEAR:
+        colorimetry.xferFunc = V4L2_XFER_FUNC_NONE;
+        break;
+    case C2Color::TRANSFER_SRGB:
+        colorimetry.xferFunc = V4L2_XFER_FUNC_SRGB;
+        break;
+    case C2Color::TRANSFER_170M:
+        colorimetry.xferFunc = V4L2_XFER_FUNC_709;
+        break;
+    case C2Color::TRANSFER_240M:
+        colorimetry.xferFunc = V4L2_XFER_FUNC_SMPTE240M;
+        break;
+    case C2Color::TRANSFER_ST2084:
+        colorimetry.xferFunc = V4L2_XFER_FUNC_SMPTE2084;
+        break;
+    default:
+        break;
+    }
+
+    switch (matrix) {
+    case C2Color::MATRIX_BT709:
+        colorimetry.ycbcrEnc = V4L2_YCBCR_ENC_709;
+        break;
+    case C2Color::MATRIX_BT601:
+    case C2Color::MATRIX_FCC47_73_682:
+        colorimetry.ycbcrEnc = V4L2_YCBCR_ENC_601;
+        break;
+    case C2Color::MATRIX_240M:
+        colorimetry.ycbcrEnc = V4L2_YCBCR_ENC_SMPTE240M;
+        break;
+    case C2Color::MATRIX_BT2020:
+        colorimetry.ycbcrEnc = V4L2_YCBCR_ENC_BT2020;
+        break;
+    case C2Color::MATRIX_BT2020_CONSTANT:
