+    case C2Config::PROFILE_HEVC_MAIN_10:
+        return V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_10;
+    default:
+        ALOGE("Add more cases as needed");
+        return -1;
+    }
+}
