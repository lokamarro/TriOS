+bool V4L2Encoder::configureHEVC(C2Config::profile_t outputProfile,
+                                std::optional<const uint8_t> outputHEVCLevel) {
+    // The device writes the VPS, SPS and PPS in front of each IDR unless it is told not to, so the
+    // stream needs no manual injection. Some devices expose the control to make that explicit.
+    mInjectParamsBeforeIDR = false;
+    if (mDevice->isCtrlExposed(V4L2_CID_MPEG_VIDEO_PREPEND_SPSPPS_TO_IDR)) {
+        if (!mDevice->setExtCtrls(V4L2_CTRL_CLASS_MPEG,
+                                  {V4L2ExtCtrl(V4L2_CID_MPEG_VIDEO_PREPEND_SPSPPS_TO_IDR, 1)})) {
+            ALOGE("Failed to configure device to prepend VPS, SPS and PPS to each IDR");
+            return false;
+        }
+    }
+
+    // Set the HEVC profile.
+    const int32_t profile = V4L2Device::c2ProfileToV4L2HEVCProfile(outputProfile);
+    if (profile < 0) {
+        ALOGE("Trying to set invalid HEVC profile");
+        return false;
+    }
+    if (!mDevice->setExtCtrls(V4L2_CTRL_CLASS_MPEG,
+                              {V4L2ExtCtrl(V4L2_CID_MPEG_VIDEO_HEVC_PROFILE, profile)})) {
+        ALOGE("Failed setting HEVC profile to %u", outputProfile);
+        return false;
+    }
+
+    // Each of the controls below is optional, so each is set on its own and a device without one
+    // of them does not keep the others from applying.
+    // Set the HEVC output level. Use Level 4.0 as fallback default. The level is a ceiling for a
+    // device that picks the level itself.
+    const int32_t level =
+            static_cast<int32_t>(outputHEVCLevel.value_or(V4L2_MPEG_VIDEO_HEVC_LEVEL_4));
+    if (!mDevice->setExtCtrls(V4L2_CTRL_CLASS_MPEG,
+                              {V4L2ExtCtrl(V4L2_CID_MPEG_VIDEO_HEVC_LEVEL, level)})) {
+        ALOGW("Failed setting HEVC level to %d", level);
+    }
+    mDevice->setExtCtrls(V4L2_CTRL_CLASS_MPEG,
+                         {V4L2ExtCtrl(V4L2_CID_MPEG_VIDEO_HEVC_TIER,
+                                      V4L2_MPEG_VIDEO_HEVC_TIER_MAIN)});
+    // No B-frames, for lowest decoding latency.
+    mDevice->setExtCtrls(V4L2_CTRL_CLASS_MPEG, {V4L2ExtCtrl(V4L2_CID_MPEG_VIDEO_B_FRAMES, 0)});
+    // Quantization parameter maximum value (for variable bitrate control).
+    mDevice->setExtCtrls(V4L2_CTRL_CLASS_MPEG, {V4L2ExtCtrl(V4L2_CID_MPEG_VIDEO_HEVC_MAX_QP, 51)});
+    // Ask not to put the parameter sets into separate bitstream buffers.
+    mDevice->setExtCtrls(V4L2_CTRL_CLASS_MPEG,
+                         {V4L2ExtCtrl(V4L2_CID_MPEG_VIDEO_HEADER_MODE,
+                                      V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME)});
+
+    return true;
+}
