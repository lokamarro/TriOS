+// Copyright 2026 The Android Open Source Project
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <v4l2_codec2/common/HEVC.h>
+
+#include <algorithm>
+#include <limits>
+
+#include <log/log.h>
+
+namespace android {
+
+uint32_t maxFramerateForLevelHEVC(C2Config::level_t level, const ui::Size& videoSize) {
+    uint32_t maxFramerate = std::numeric_limits<uint32_t>::max();
+
+    bool found = false;
+    for (const HEVCLevelLimits& limit : kHEVCLimits) {
+        if (limit.level != level) continue;
+
+        uint64_t lumaPs = static_cast<uint64_t>(videoSize.width) * videoSize.height;
+        if (lumaPs == 0) break;
+        maxFramerate = static_cast<uint32_t>(
+                std::min<uint64_t>(limit.maxLumaSampleRate / lumaPs,
+                                   std::numeric_limits<uint32_t>::max()));
+        found = true;
+        break;
+    }
+
+    if (!found) ALOGW("%s - failed to find matching HEVC level=%d", __func__, level);
+
+    return maxFramerate;
+}
+
+}  // namespace android
