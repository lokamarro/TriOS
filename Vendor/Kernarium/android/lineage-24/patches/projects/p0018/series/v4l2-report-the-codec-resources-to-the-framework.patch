     ALOGV("%s()", __func__);
 
@@ -246,8 +255,20 @@ c2_status_t EncodeComponent::start() {
         return C2_BAD_STATE;
     }
 
+    // The device serves the real-time streams of its instances only up to the pixel rate it
+    // sustains, and the framework relies on a start to fail where the resources are used up.
+    const uint64_t pixelRate = mInterface->getPixelRateNeeded();
+    if (!VideoPixelRateBudget::claim(pixelRate, mInterface->getPixelRateCapacity())) {
+        ALOGW("Not starting, the pixel rate %" PRIu64 " exceeds what the device has left",
+              pixelRate);
+        return C2_NO_MEMORY;
+    }
+    mPixelRateClaimed = pixelRate;
+    mHoldsPixelRate = true;
+
     if (!mEncoderThread.Start()) {
         ALOGE("Failed to start encoder thread");
+        releasePixelRate();
         return C2_CORRUPTED;
     }
     mEncoderTaskRunner = mEncoderThread.task_runner();
@@ -262,6 +283,7 @@ c2_status_t EncodeComponent::start() {
 
     if (!success) {
         ALOGE("Failed to initialize encoder");
+        releasePixelRate();
         return C2_CORRUPTED;
     }
 
@@ -281,6 +303,7 @@ c2_status_t EncodeComponent::stop() {
 
     // Return immediately if the component is already stopped.
     if (!mEncoderThread.IsRunning()) {
+        releasePixelRate();
         return C2_OK;
     }
 
@@ -290,6 +313,7 @@ c2_status_t EncodeComponent::stop() {
                                  ::base::BindOnce(&EncodeComponent::stopTask, mWeakThis, &done));
     done.Wait();
     mEncoderThread.Stop();
+    releasePixelRate();
 
     setComponentState(ComponentState::LOADED);
 
@@ -421,6 +445,8 @@ void EncodeComponent::startTask(bool* success, ::base::WaitableEvent* done) {
     ALOG_ASSERT(mEncoderTaskRunner->RunsTasksInCurrentSequence());
 
     *success = initializeEncoder();
+    // The framework read the resources the instance needs when it configured the component.
+    mReportedPixelRateNeeded = mInterface->getPixelRateNeeded();
     done->Signal();
 }
 
@@ -993,6 +1019,18 @@ void EncodeComponent::onOutputBufferDone(size_t dataSize, int64_t timestamp, boo
     }
     work->worklets.front()->output.buffers.emplace_back(std::move(linearBuffer));
 
+    // Tell the framework when the system resources the instance needs have changed, as they do when
+    // the client switches it between real time and not (the priority), or changes its rate.
+    const uint64_t pixelRateNeeded = mInterface->getPixelRateNeeded();
+    if (pixelRateNeeded != mReportedPixelRateNeeded) {
+        work->worklets.front()->output.configUpdate.push_back(mInterface->copyResourcesNeeded());
+        mReportedPixelRateNeeded = pixelRateNeeded;
+        if (mHoldsPixelRate) {
+            VideoPixelRateBudget::change(mPixelRateClaimed, pixelRateNeeded);
+            mPixelRateClaimed = pixelRateNeeded;
+        }
+    }
+
     // We can report the work item as completed if its associated input buffer has also been
     // released. As output buffers are not necessarily returned in order we might be able to return
     // multiple ready work items now.
