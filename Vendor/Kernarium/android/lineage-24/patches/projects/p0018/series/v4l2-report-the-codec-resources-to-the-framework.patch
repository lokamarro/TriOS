 }  // namespace
 
+// The interface through which a client reads the system resources of the store. Android derives
+// the globally available resources from the capacity and what the store excludes, less what every
+// codec instance reports it needs.
+class ComponentStore::ResourceInterface : public C2InterfaceHelper {
+public:
+    ResourceInterface(std::shared_ptr<C2ReflectorHelper> reflector, uint32_t instances,
+                      uint64_t pixelRate)
+          : C2InterfaceHelper(reflector) {
+        setDerivedInstance(this);
+
+        // The resources are a struct that the reflector does not know yet.
+        reflector->addStructDescriptors<C2SystemResourceStruct>();
+
+        std::vector<C2SystemResourceStruct> capacity;
+        std::vector<C2SystemResourceStruct> excluded;
+        if (instances > 0) {
+            capacity.emplace_back(kVideoInstancesResourceId, C2Config::CONST, instances);
+            excluded.emplace_back(kVideoInstancesResourceId, C2Config::CONST, 0);
+        }
+        if (pixelRate > 0) {
+            capacity.emplace_back(kVideoPixelRateResourceId, C2Config::CONST, pixelRate);
+            excluded.emplace_back(kVideoPixelRateResourceId, C2Config::CONST, 0);
+        }
+
+        // Nothing but the product changes what the device has, so the capacity is read-only. No
+        // other client of the device is excluded.
+        addParameter(DefineParam(mCapacity, C2_PARAMKEY_RESOURCES_CAPACITY)
+                             .withConstValue(
+                                     C2ResourcesCapacityTuning::AllocShared(capacity.size(),
+                                                                            capacity))
+                             .build());
+        addParameter(DefineParam(mExcluded, C2_PARAMKEY_RESOURCES_EXCLUDED)
+                             .withConstValue(
+                                     C2ResourcesExcludedTuning::AllocShared(excluded.size(),
+                                                                            excluded))
+                             .build());
+    }
+
+    // Whether the index is one of the parameters of this interface.
+    static bool isResource(C2Param::Index index) {
+        return index.type() == C2ResourcesCapacityTuning::PARAM_TYPE ||
+               index.type() == C2ResourcesExcludedTuning::PARAM_TYPE;
+    }
+
+private:
+    std::shared_ptr<C2ResourcesCapacityTuning> mCapacity;
+    std::shared_ptr<C2ResourcesExcludedTuning> mExcluded;
+};
+
 ComponentStore::ComponentStore(C2String storeName)
       : mStoreName(std::move(storeName)), mReflector(std::make_shared<C2ReflectorHelper>()) {
     ALOGV("%s()", __func__);
@@ -96,29 +146,53 @@ c2_status_t ComponentStore::copyBuffer(std::shared_ptr<C2GraphicBuffer> /* src *
 }
 
 c2_status_t ComponentStore::querySupportedParams_nb(
-        std::vector<std::shared_ptr<C2ParamDescriptor>>* const /* params */) const {
+        std::vector<std::shared_ptr<C2ParamDescriptor>>* const params) const {
+    if (mResources) return mResources->querySupportedParams(params);
     return C2_OK;
 }
 
 c2_status_t ComponentStore::query_sm(
         const std::vector<C2Param*>& stackParams,
         const std::vector<C2Param::Index>& heapParamIndices,
-        std::vector<std::unique_ptr<C2Param>>* const /* heapParams */) const {
-    // There are no supported config params.
-    return stackParams.empty() && heapParamIndices.empty() ? C2_OK : C2_BAD_INDEX;
+        std::vector<std::unique_ptr<C2Param>>* const heapParams) const {
+    // The only params are the system resources, if the store has any. Whatever else a client asks
+    // for is not supported, which the client relies on to learn what the store does not offer.
+    if (!mResources) return stackParams.empty() && heapParamIndices.empty() ? C2_OK : C2_BAD_INDEX;
+    bool unsupported = false;
+    for (const C2Param* param : stackParams) {
+        unsupported |= !param || !ResourceInterface::isResource(param->index());
+    }
+    for (const C2Param::Index index : heapParamIndices) {
+        unsupported |= !ResourceInterface::isResource(index);
+    }
+    const c2_status_t status =
+            mResources->query(stackParams, heapParamIndices, C2_MAY_BLOCK, heapParams);
+    return unsupported ? C2_BAD_INDEX : status;
 }
 
 c2_status_t ComponentStore::config_sm(
         const std::vector<C2Param*>& params,
-        std::vector<std::unique_ptr<C2SettingResult>>* const /* failures */) {
-    // There are no supported config params.
-    return params.empty() ? C2_OK : C2_BAD_INDEX;
+        std::vector<std::unique_ptr<C2SettingResult>>* const failures) {
+    // The system resources cannot be set, and nothing else is a param of the store.
+    if (!mResources || params.empty()) return params.empty() ? C2_OK : C2_BAD_INDEX;
+    bool unsupported = false;
+    for (const C2Param* param : params) {
+        unsupported |= !param || !ResourceInterface::isResource(param->index());
+    }
+    const c2_status_t status = mResources->config(params, C2_MAY_BLOCK, failures);
+    return unsupported ? C2_BAD_INDEX : status;
 }
 
 c2_status_t ComponentStore::querySupportedValues_sm(
         std::vector<C2FieldSupportedValuesQuery>& fields) const {
-    // There are no supported config params.
-    return fields.empty() ? C2_OK : C2_BAD_INDEX;
+    if (!mResources) return fields.empty() ? C2_OK : C2_BAD_INDEX;
+    const c2_status_t status = mResources->querySupportedValues(fields, C2_MAY_BLOCK);
+    // The helper reports a field that is not its own in the field's status, where a store reports
+    // it for the whole query.
+    for (const C2FieldSupportedValuesQuery& field : fields) {
+        if (field.status == C2_BAD_INDEX) return C2_BAD_INDEX;
+    }
+    return status;
 }
 
 ::C2ComponentFactory* ComponentStore::getFactory(const C2String& name) {
@@ -204,7 +278,18 @@ ComponentStore::Builder& ComponentStore::Builder::encoder(std::string name, Vide
     return *this;
 }
 
+ComponentStore::Builder& ComponentStore::Builder::resources(uint32_t instances,
+                                                            uint64_t pixelRate) {
+    mInstances = instances;
+    mPixelRate = pixelRate;
+    return *this;
+}
+
 std::shared_ptr<ComponentStore> ComponentStore::Builder::build() && {
+    if (mInstances > 0 || mPixelRate > 0) {
+        mStore->mResources = std::make_shared<ResourceInterface>(mStore->mReflector, mInstances,
+                                                                 mPixelRate);
+    }
     return std::shared_ptr<ComponentStore>(std::move(mStore));
 }
 }  // namespace android
