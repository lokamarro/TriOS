+// static
+C2R EncodeInterface::OperatingRateSetter(bool /*mayBlock*/, C2P<C2OperatingRateTuning>& me) {
+    // A negative rate is invalid; no rate is zero.
+    if (me.v.value < 0) me.set().value = 0;
+    return C2R::Ok();
+}
+
+// static
+C2R EncodeInterface::ResourcesNeededSetter(bool /*mayBlock*/, C2P<C2ResourcesNeededTuning>& me,
+                                           const C2P<C2StreamPictureSizeInfo::input>& size,
+                                           const C2P<C2StreamFrameRateInfo::output>& frameRate,
+                                           const C2P<C2OperatingRateTuning>& operatingRate,
+                                           const C2P<C2RealTimePriorityTuning>& priority) {
+    // The instance takes the session it holds, whatever it codes, and the pixel rate of its stream
+    // if it runs in real time. A priority below 0 asks the device for best effort at the rate the
+    // client hints, so such an instance takes whatever the real-time ones leave, and none of the
+    // capacity. A client that gives an operating rate means to feed the frames at that rate.
+    const bool realTime = priority.v.value >= 0;
+    const float rate = operatingRate.v.value > 0 ? operatingRate.v.value : frameRate.v.value;
+    if (me.v.flexCount() > 1 && me.v.m.values[1].id == kVideoPixelRateResourceId) {
+        me.set().m.values[1].amount =
+                realTime ? videoPixelRateNeeded(size.v.width, size.v.height, rate) : 0;
+    }
+    return C2R::Ok();
+}
+
 // static
 C2R EncodeInterface::ColorAspectsSetter(bool /*mayBlock*/,
                                         C2P<C2StreamColorAspectsInfo::input>& me) {
@@ -451,11 +478,13 @@ EncodeInterface::EncodeInterface(const C2String& name, std::shared_ptr<C2Reflect
     ALOGV("%s(%s)", __func__, name.c_str());
 
     setDerivedInstance(this);
+    mPixelRateCapacity = caps.pixelRateCapacity;
 
-    // The HDR10 metadata is a struct that the reflector does not know yet.
+    // The HDR10 metadata and the system resources are structs that the reflector does not know yet.
     if (caps.supportsHdr10) {
         helper->addStructDescriptors<C2MasteringDisplayColorVolumeStruct, C2ColorXyStruct>();
     }
+    helper->addStructDescriptors<C2SystemResourceStruct>();
 
     Initialize(name, caps);
 }
@@ -808,6 +837,35 @@ void EncodeInterface::Initialize(const C2String& name, const SupportedCapabiliti
                              .build());
     }
 
+    // The system resources of the instance, which the framework adds up with the capacity the store
+    // reports into the globally available resources. The pixel rate is among them only if the
+    // store has a pixel rate capacity to take it from.
+    addParameter(DefineParam(mOperatingRate, C2_PARAMKEY_OPERATING_RATE)
+                         .withDefault(new C2OperatingRateTuning(0.f))
+                         .withFields({C2F(mOperatingRate, value).any()})
+                         .withSetter(OperatingRateSetter)
+                         .build());
+
+    addParameter(DefineParam(mRealTimePriority, C2_PARAMKEY_PRIORITY)
+                         .withDefault(new C2RealTimePriorityTuning(0))
+                         .withFields({C2F(mRealTimePriority, value).any()})
+                         .withSetter(Setter<decltype(*mRealTimePriority)>::NonStrictValueWithNoDeps)
+                         .build());
+
+    {
+        const std::vector<C2SystemResourceStruct> needed =
+                videoResourcesNeeded(320, 240, 0.f, true, caps.pixelRateCapacity > 0);
+        addParameter(DefineParam(mResourcesNeeded, C2_PARAMKEY_RESOURCES_NEEDED)
+                             .withDefault(C2ResourcesNeededTuning::AllocShared(needed.size(),
+                                                                               needed))
+                             .withFields({C2F(mResourcesNeeded, m.values[0].id).any(),
+                                          C2F(mResourcesNeeded, m.values[0].kind).any(),
+                                          C2F(mResourcesNeeded, m.values[0].amount).any()})
+                             .calculatedAs(ResourcesNeededSetter, mInputVisibleSize, mFrameRate,
+                                           mOperatingRate, mRealTimePriority)
+                             .build());
+    }
+
     C2Allocator::id_t inputAllocators[] = {kDefaultInputAllocator};
 
     C2Allocator::id_t outputAllocators[] = {kDefaultOutputAllocator};
@@ -857,6 +915,15 @@ std::optional<std::pair<int32_t, int32_t>> EncodeInterface::getQpBounds() const
     return std::make_pair(std::min(minQp, maxQp), maxQp);
 }
 
+uint64_t EncodeInterface::getPixelRateNeeded() const {
+    Lock lock = this->lock();
+    for (size_t i = 0; i < mResourcesNeeded->flexCount(); ++i) {
+        const C2SystemResourceStruct& resource = mResourcesNeeded->m.values[i];
+        if (resource.id == kVideoPixelRateResourceId) return resource.amount;
+    }
+    return 0;
+}
