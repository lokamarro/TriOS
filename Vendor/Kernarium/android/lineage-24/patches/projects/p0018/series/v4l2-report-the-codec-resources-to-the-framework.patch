@@ -0,0 +1,87 @@
+// Copyright 2026 The Android Open Source Project
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef ANDROID_V4L2_CODEC2_COMPONENTS_VIDEO_RESOURCES_H
+#define ANDROID_V4L2_CODEC2_COMPONENTS_VIDEO_RESOURCES_H
+
+#include <algorithm>
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+#include <C2Config.h>
+
+namespace android {
+
+// The system resources the store reports to the framework (C2ResourcesCapacityTuning) and every
+// codec component reports its use of (C2ResourcesNeededTuning). The framework derives the globally
+// available resources from these, and Android's codec availability tests check that every instance
+// takes what the interface says it takes. The ids are vendor ids, which start at VENDOR_START.
+//
+// Concurrent instances: the codec sessions the device serves. The capacity is the sum of the
+// concurrent instance bounds of the codecs the store offers, so the store reports the same limit as
+// the components enforce, and every instance needs one.
+constexpr uint32_t kVideoInstancesResourceId = C2PlatformConfig::VENDOR_START;
+// Pixel rate: the luma samples per second the device codes, of all instances together. The
+// capacity is the product's measurement of what the device sustains and an instance needs the
+// pixel rate of the stream it codes in real time, so the use of a performance point the codec list
+// publishes is a share of the capacity that grows with the stream. An instance that does not run
+// in real time claims none, as it takes whatever the real-time instances leave.
+constexpr uint32_t kVideoPixelRateResourceId = C2PlatformConfig::VENDOR_START + 1;
+
+// The pixel rate a stream of |width| by |height| luma samples at |frameRate| frames per second
+// needs.
+inline uint64_t videoPixelRateNeeded(uint32_t width, uint32_t height, float frameRate) {
+    return static_cast<uint64_t>(static_cast<double>(width) * height * std::max(frameRate, 0.f));
+}
+
+// The resources one codec instance needs: a session and, if |withPixelRate| (the store has a pixel
+// rate capacity), the pixel rate of the stream when it runs in real time or none when it does not.
+inline std::vector<C2SystemResourceStruct> videoResourcesNeeded(uint32_t width, uint32_t height,
+                                                                float frameRate, bool realTime,
+                                                                bool withPixelRate) {
+    std::vector<C2SystemResourceStruct> needed;
+    needed.emplace_back(kVideoInstancesResourceId, C2Config::CONST, 1);
+    if (withPixelRate) {
+        needed.emplace_back(kVideoPixelRateResourceId, C2Config::CONST,
+                            realTime ? videoPixelRateNeeded(width, height, frameRate) : 0);
+    }
+    return needed;
+}
+
+// The pixel rate the running instances have claimed. A component claims its pixel rate when it
+// starts, keeps the claim up to date as the stream changes and gives it back when it stops, so the
+// device refuses an instance its real-time streams would overload, as the framework expects of a
+// codec that reports its resources. The claims are those of the process, as the capacity is the
+// store's; all components that claim are in one library, which makes this one object.
+class VideoPixelRateBudget {
+public:
+    // Claim |rate| of |capacity| (no bound if 0). The device serves one instance of any size it
+    // supports, so the claim is refused only if others hold some and the sum is over the capacity.
+    static bool claim(uint64_t rate, uint64_t capacity) {
+        std::lock_guard<std::mutex> lock(sMutex);
+        if (capacity > 0 && sClaimed > 0 && sClaimed + rate > capacity) return false;
+        sClaimed += rate;
+        return true;
+    }
+
+    // An instance that holds |from| needs |to| now. It keeps running whatever the others hold.
+    static void change(uint64_t from, uint64_t to) {
+        std::lock_guard<std::mutex> lock(sMutex);
+        sClaimed = sClaimed - std::min(from, sClaimed) + to;
+    }
+
+    static void release(uint64_t rate) {
+        std::lock_guard<std::mutex> lock(sMutex);
+        sClaimed -= std::min(rate, sClaimed);
+    }
+
+private:
+    static inline std::mutex sMutex;
+    static inline uint64_t sClaimed = 0;
+};
+
+}  // namespace android
+
+#endif  // ANDROID_V4L2_CODEC2_COMPONENTS_VIDEO_RESOURCES_H
