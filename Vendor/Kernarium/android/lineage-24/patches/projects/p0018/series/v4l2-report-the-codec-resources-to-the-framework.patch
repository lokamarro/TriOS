+void EncodeComponent::releasePixelRate() {
+    if (!mHoldsPixelRate) return;
+    VideoPixelRateBudget::release(mPixelRateClaimed);
+    mPixelRateClaimed = 0;
+    mHoldsPixelRate = false;
+}
