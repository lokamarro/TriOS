+        // also the format of a YUV 4:4:4 Surface. The 10-bit RGB encoders read it as RGBA.
+        inputFormat = VideoPixelFormat::XB30;
     } else if (static_cast<uint32_t>(inputLayout.type) == 0u) {
         // The above layout() cannot fill layout information and sets it to 0 instead if the input
         // format is IMPLEMENTATION_DEFINED and its backed format is RGB. We fill the layout by
@@ -239,6 +400,10 @@ c2_status_t FormatConverter::convertBlock(uint64_t frameIndex,
     const int dstStrideU = outputLayout.planes[C2PlanarLayout::PLANE_V].rowInc;   // only for I420
     const int dstStrideV = outputLayout.planes[C2PlanarLayout::PLANE_U].rowInc;   // only for I420
     const int dstStrideUV = outputLayout.planes[C2PlanarLayout::PLANE_U].rowInc;  // only for NV12
+    // The planes of P010: Y, and the interleaved Cb and Cr in 16-bit samples.
+    uint8_t* const dstCb = outputView.data()[C2PlanarLayout::PLANE_U];
+    uint8_t* const dstCr = outputView.data()[C2PlanarLayout::PLANE_V];
+    const int dstColIncC = outputLayout.planes[C2PlanarLayout::PLANE_U].colInc;
 
     if (inputLayout.type == C2PlanarLayout::TYPE_YUV) {
         const uint8_t* srcY = inputView.data()[C2PlanarLayout::PLANE_Y];
@@ -269,6 +434,15 @@ c2_status_t FormatConverter::convertBlock(uint64_t frameIndex,
                                dstStrideU, dstV, dstStrideV, mVisibleSize.width,
                                mVisibleSize.height);
             break;
+        case convertMap(VideoPixelFormat::YV12, VideoPixelFormat::P010):
+        case convertMap(VideoPixelFormat::NV12, VideoPixelFormat::P010):
+        case convertMap(VideoPixelFormat::NV21, VideoPixelFormat::P010):
+            widenYuvToP010(srcY, srcStrideY, inputLayout.planes[C2PlanarLayout::PLANE_Y].colInc,
+                           srcU, srcStrideU, inputLayout.planes[C2PlanarLayout::PLANE_U].colInc,
+                           srcV, srcStrideV, inputLayout.planes[C2PlanarLayout::PLANE_V].colInc,
+                           dstY, dstStrideY, dstCb, dstCr, outputLayout.planes[C2PlanarLayout::PLANE_U].rowInc,
+                           dstColIncC, mVisibleSize.width, mVisibleSize.height);
+            break;
         case convertMap(VideoPixelFormat::NV21, VideoPixelFormat::NV12):
             ALOGV("%s(): Converting PIXEL_FORMAT_NV21 -> PIXEL_FORMAT_NV12", __func__);
             libyuv::CopyPlane(srcY, srcStrideY, dstY, dstStrideY, mVisibleSize.width,
@@ -307,6 +481,40 @@ c2_status_t FormatConverter::convertBlock(uint64_t frameIndex,
                                  mVisibleSize.height / 2);
             break;
         }
+        case convertMap(VideoPixelFormat::ABGR, VideoPixelFormat::P010): {
+            // libyuv converts with the BT.601 limited range matrix whatever the stream says, so
+            // the conversion to P010 applies the matrix and range of the colour aspects instead.
+            const uint8_t* srcR = srcRGB;
+            const uint8_t* srcG = srcRGB + 1;
+            const uint8_t* srcB = srcRGB + 2;
+            int srcColInc = 4;
+            if (!idMap) {
+                srcR = inputView.data()[C2PlanarLayout::PLANE_R];
+                srcG = inputView.data()[C2PlanarLayout::PLANE_G];
+                srcB = inputView.data()[C2PlanarLayout::PLANE_B];
+                srcColInc = inputLayout.planes[C2PlanarLayout::PLANE_R].colInc;
+            }
+            convertRgbToP010(Rgb8Source(srcR, srcG, srcB, srcColInc, srcStrideRGB), dstY,
+                             dstStrideY, dstCb, dstCr,
+                             outputLayout.planes[C2PlanarLayout::PLANE_U].rowInc, dstColIncC,
+                             mVisibleSize.width, mVisibleSize.height, mMatrix, mRange);
+            break;
+        }
+        default:
+            ALOGE("Unsupported pixel format conversion from %s to %s",
+                  videoPixelFormatToString(inputFormat).c_str(),
+                  videoPixelFormatToString(mOutFormat).c_str());
+            return C2_CORRUPTED;
+        }
+    } else if (inputLayout.type == C2PlanarLayout::TYPE_YUVA) {
+        switch (convertMap(inputFormat, mOutFormat)) {
+        case convertMap(VideoPixelFormat::XB30, VideoPixelFormat::P010):
+            convertRgbToP010(Rgba1010102Source(inputView.data()[C2PlanarLayout::PLANE_Y],
+                                               inputLayout.planes[C2PlanarLayout::PLANE_Y].rowInc),
+                             dstY, dstStrideY, dstCb, dstCr,
+                             outputLayout.planes[C2PlanarLayout::PLANE_U].rowInc, dstColIncC,
+                             mVisibleSize.width, mVisibleSize.height, mMatrix, mRange);
+            break;
