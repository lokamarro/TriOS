+        } else if (inputLayout.rootPlanes == 3) {
             inputFormat = VideoPixelFormat::YV12;
         } else if (inputLayout.rootPlanes == 2) {
             const uint8_t* const* data = inputView.data();
@@ -196,6 +350,13 @@ c2_status_t FormatConverter::convertBlock(uint64_t frameIndex,
         }
     } else if (inputLayout.type == C2PlanarLayout::TYPE_RGB) {
         inputFormat = VideoPixelFormat::ABGR;
+    } else if (inputLayout.type == C2PlanarLayout::TYPE_YUVA &&
+               inputLayout.rootPlanes == 1 &&
+               inputLayout.planes[C2PlanarLayout::PLANE_Y].allocatedDepth == 32 &&
+               inputLayout.planes[C2PlanarLayout::PLANE_Y].bitDepth == 10) {
