+// The matrix coefficients that turn 10-bit RGB into 10-bit YCbCr, scaled by 1024. The rows give Y,
+// Cb and Cr; the tables are copied from SimpleC2Component (frameworks/av/media/codec2/components),
+// which converts RGBA_1010102 for the AV1 and APV software encoders.
+constexpr int16_t kBt709Matrix10bit[2][3][3] = {
+        {{218, 732, 74}, {-117, -395, 512}, {512, -465, -47}}, /* full range */
+        {{186, 627, 63}, {-103, -345, 448}, {448, -407, -41}}, /* limited range */
+};
+constexpr int16_t kBt2020Matrix10bit[2][3][3] = {
+        {{269, 694, 61}, {-143, -369, 512}, {512, -471, -41}}, /* full range */
+        {{230, 594, 52}, {-125, -323, 448}, {448, -412, -36}}, /* limited range */
+};
+
+// A source of 10-bit RGB for convertRgbToP010(): the pixels of an RGBA_1010102 buffer, which holds
+// red in bits 0 to 9, green in 10 to 19, blue in 20 to 29 and alpha in the rest of a 32-bit word.
+class Rgba1010102Source {
+public:
+    Rgba1010102Source(const uint8_t* base, int rowInc) : mBase(base), mRowInc(rowInc) {}
+
+    void get(int x, int y, int* r, int* g, int* b) const {
+        uint32_t word;
+        memcpy(&word, mBase + static_cast<ptrdiff_t>(y) * mRowInc + static_cast<ptrdiff_t>(x) * 4,
+               sizeof(word));
+        *r = word & 0x3ff;
+        *g = (word >> 10) & 0x3ff;
+        *b = (word >> 20) & 0x3ff;
+    }
+
+private:
+    const uint8_t* const mBase;
+    const int mRowInc;
+};
+
+// A source of 8-bit RGB for convertRgbToP010(), each channel read through its own pointer so that
+// any channel order fits. The samples widen to 10 bits by repeating their top bits, which keeps 0
+// and 255 at 0 and 1023.
+class Rgb8Source {
+public:
+    Rgb8Source(const uint8_t* r, const uint8_t* g, const uint8_t* b, int colInc, int rowInc)
+          : mR(r), mG(g), mB(b), mColInc(colInc), mRowInc(rowInc) {}
+
+    void get(int x, int y, int* r, int* g, int* b) const {
+        const ptrdiff_t offset = static_cast<ptrdiff_t>(y) * mRowInc + static_cast<ptrdiff_t>(x) * mColInc;
+        *r = widen(mR[offset]);
+        *g = widen(mG[offset]);
+        *b = widen(mB[offset]);
+    }
+
+private:
+    static int widen(int sample) { return (sample << 2) | (sample >> 6); }
+
+    const uint8_t* const mR;
+    const uint8_t* const mG;
+    const uint8_t* const mB;
+    const int mColInc;
+    const int mRowInc;
+};
+
+// Converts RGB to P010 with the matrix and range the aspects say: the luma of every pixel, and the
+// chroma of every 2x2 block from the mean of its pixels. Y, Cb and Cr are 10-bit values in the
+// upper bits of 16-bit samples. The destination planes are given as byte pointers and strides.
+template <typename Source>
+void convertRgbToP010(const Source& src, uint8_t* dstY, int dstStrideY, uint8_t* dstU, uint8_t* dstV,
+                      int dstStrideUV, int dstColIncUV, int width, int height,
+                      C2Color::matrix_t matrix, C2Color::range_t range) {
+    const bool full = range == C2Color::RANGE_FULL;
+    const int16_t(*weights)[3] =
+            (matrix == C2Color::MATRIX_BT709 ? kBt709Matrix10bit : kBt2020Matrix10bit)[full ? 0 : 1];
+    const int zeroLevel = full ? 0 : 64;
+    const int maxLuma = full ? 1023 : 940;
+    const int maxChroma = full ? 1023 : 960;
+    const auto sample = [](int value, int low, int high) {
+        return static_cast<uint16_t>((std::clamp(value, low, high) << 6) & 0xffc0);
+    };
+
+    for (int y = 0; y < height; y += 2) {
+        for (int x = 0; x < width; x += 2) {
+            int sumR = 0, sumG = 0, sumB = 0, count = 0;
+            for (int dy = 0; dy < 2 && y + dy < height; dy++) {
+                uint16_t* row =
+                        reinterpret_cast<uint16_t*>(dstY + static_cast<ptrdiff_t>(y + dy) * dstStrideY);
+                for (int dx = 0; dx < 2 && x + dx < width; dx++) {
+                    int r, g, b;
+                    src.get(x + dx, y + dy, &r, &g, &b);
+                    const int luma =
+                            ((r * weights[0][0] + g * weights[0][1] + b * weights[0][2] + 512) >> 10) +
+                            zeroLevel;
+                    row[x + dx] = sample(luma, zeroLevel, maxLuma);
+                    sumR += r;
+                    sumG += g;
+                    sumB += b;
+                    count++;
+                }
+            }
+            const int r = (sumR + count / 2) / count;
+            const int g = (sumG + count / 2) / count;
+            const int b = (sumB + count / 2) / count;
+            const int cb = ((r * weights[1][0] + g * weights[1][1] + b * weights[1][2] + 512) >> 10) + 512;
+            const int cr = ((r * weights[2][0] + g * weights[2][1] + b * weights[2][2] + 512) >> 10) + 512;
+            const ptrdiff_t offset = static_cast<ptrdiff_t>(y / 2) * dstStrideUV +
+                                     static_cast<ptrdiff_t>(x / 2) * dstColIncUV;
+            *reinterpret_cast<uint16_t*>(dstU + offset) = sample(cb, zeroLevel, maxChroma);
+            *reinterpret_cast<uint16_t*>(dstV + offset) = sample(cr, zeroLevel, maxChroma);
+        }
+    }
+}
+
+// Widens 8-bit YUV 4:2:0 to P010 by shifting every sample left by 8, which makes it the same value
+// scaled to the 10 upper bits (limited range black 16 and white 235 become 64 and 940). The source
+// chroma planes are given by pointer and steps, so that planar and both semiplanar orders fit.
+void widenYuvToP010(const uint8_t* srcY, int srcStrideY, int srcColIncY, const uint8_t* srcU,
+                    int srcStrideU, int srcColIncU, const uint8_t* srcV, int srcStrideV,
+                    int srcColIncV, uint8_t* dstY, int dstStrideY, uint8_t* dstU, uint8_t* dstV,
+                    int dstStrideUV, int dstColIncUV, int width, int height) {
+    for (int y = 0; y < height; y++) {
+        const uint8_t* src = srcY + static_cast<ptrdiff_t>(y) * srcStrideY;
+        uint16_t* dst = reinterpret_cast<uint16_t*>(dstY + static_cast<ptrdiff_t>(y) * dstStrideY);
+        for (int x = 0; x < width; x++) {
+            dst[x] = static_cast<uint16_t>(src[static_cast<ptrdiff_t>(x) * srcColIncY] << 8);
+        }
+    }
+    for (int y = 0; y < (height + 1) / 2; y++) {
+        for (int x = 0; x < (width + 1) / 2; x++) {
+            const ptrdiff_t offset = static_cast<ptrdiff_t>(y) * dstStrideUV +
+                                     static_cast<ptrdiff_t>(x) * dstColIncUV;
+            *reinterpret_cast<uint16_t*>(dstU + offset) = static_cast<uint16_t>(
+                    srcU[static_cast<ptrdiff_t>(y) * srcStrideU +
+                         static_cast<ptrdiff_t>(x) * srcColIncU]
+                    << 8);
+            *reinterpret_cast<uint16_t*>(dstV + offset) = static_cast<uint16_t>(
+                    srcV[static_cast<ptrdiff_t>(y) * srcStrideV +
+                         static_cast<ptrdiff_t>(x) * srcColIncV]
+                    << 8);
+        }
+    }
+}
+
 }  // namespace
 
