     c2_status_t status() const { return mInitStatus; }
     C2BlockPool::local_id_t getBlockPoolId() const { return mOutputBlockPoolIds->m.values[0]; }
     std::optional<VideoCodec> getVideoCodec() const { return mVideoCodec; }
-    // The raw format the client asked the decoder to produce.
-    HalPixelFormat getOutputPixelFormat() const {
-        return static_cast<HalPixelFormat>(mPixelFormat->value);
-    }
+    // The raw format the decoder produces for the client: the one it asked for, except that a
+    // Surface which no video encoder reads gets 8-bit YUV 4:2:0, since the host cannot show P010.
+    HalPixelFormat getOutputPixelFormat() const;
 
     static uint32_t getOutputDelay(VideoCodec codec);
 
@@ -86,8 +85,13 @@ private:
     // The output format kind; should be C2FormatVideo.
     std::shared_ptr<C2StreamBufferTypeSetting::output> mOutputFormat;
     // The raw format of the decoded pictures, which the client chooses among the ones the codec
-    // can produce: flexible YUV 4:2:0 at 8 bits, and P010 for a profile with 10-bit samples.
+    // can produce: flexible YUV 4:2:0 at 8 bits, P010 for a profile with 10-bit samples, and
+    // IMPLEMENTATION_DEFINED when it renders to a Surface, which getOutputPixelFormat() turns into
+    // 8-bit YUV unless a video encoder reads the Surface.
     std::shared_ptr<C2StreamPixelFormatInfo::output> mPixelFormat;
+    // The usage of the consumer of the output buffers, which the framework sets from the Surface
+    // the client renders to.
+    std::shared_ptr<C2StreamUsageTuning::output> mOutputMemoryUsage;
     // The MIME type of input port.
     std::shared_ptr<C2PortMediaTypeSetting::input> mInputMediaType;
     // The MIME type of output port; should be MEDIA_MIMETYPE_VIDEO_RAW.
diff --git a/components/include/v4l2_codec2/components/VideoDecoder.h b/components/include/v4l2_codec2/components/VideoDecoder.h
index 3e3fec47588da515d5e2a5038c3de0fe728bfbcb..623a9ada6e81dacb25f7c5826da15f12873e6a4f 100644
--- a/components/include/v4l2_codec2/components/VideoDecoder.h
+++ b/components/include/v4l2_codec2/components/VideoDecoder.h
@@ -28,6 +28,8 @@ public:
 
     using GetPoolCB = ::base::RepeatingCallback<std::unique_ptr<VideoFramePool>(
             const ui::Size& size, HalPixelFormat pixelFormat, size_t numOutputBuffers)>;
+    // Returns the raw format the client wants the decoder to produce, as it is now.
+    using GetOutputFormatCB = ::base::RepeatingCallback<HalPixelFormat()>;
     using DecodeCB = ::base::OnceCallback<void(DecodeStatus)>;
     using OutputCB = ::base::RepeatingCallback<void(std::unique_ptr<VideoFrame>)>;
     using ErrorCB = ::base::RepeatingCallback<void()>;
diff --git a/v4l2/V4L2DecodeComponent.cpp b/v4l2/V4L2DecodeComponent.cpp
index 7107c428fe24882af83c6b2e7d731d206319de13..d6f38114093a185430a5b64389c08c8764193b42 100644
--- a/v4l2/V4L2DecodeComponent.cpp
+++ b/v4l2/V4L2DecodeComponent.cpp
@@ -107,7 +107,8 @@ void V4L2DecodeComponent::startTask(c2_status_t* status, ::base::WaitableEvent*
                                    ::base::BindRepeating(&V4L2DecodeComponent::reportError,
                                                          ::base::Unretained(this), C2_CORRUPTED),
                                    mDecoderTaskRunner, mIsSecure,
-                                   mIntfImpl->getOutputPixelFormat());
+                                   ::base::BindRepeating(&DecodeInterface::getOutputPixelFormat,
+                                                         ::base::Unretained(mIntfImpl.get())));
     if (!mDecoder) {
         ALOGE("Failed to create V4L2Decoder for %s", VideoCodecToString(*codec));
         return;
diff --git a/v4l2/V4L2Decoder.cpp b/v4l2/V4L2Decoder.cpp
index 7ed6e8a383e17b0e010e31b4222a94f9dbfbfb80..83fad685e1cd020046159a7ee54f6605c593c0e4 100644
--- a/v4l2/V4L2Decoder.cpp
+++ b/v4l2/V4L2Decoder.cpp
