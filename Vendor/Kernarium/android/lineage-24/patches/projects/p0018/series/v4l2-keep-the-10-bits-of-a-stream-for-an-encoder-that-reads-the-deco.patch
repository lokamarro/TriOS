--- a/v4l2/V4L2Device.cpp
+++ b/v4l2/V4L2Device.cpp
@@ -774,7 +774,8 @@ std::optional<struct v4l2_format> V4L2Queue::tryFormat(uint32_t fourcc, const ui
                                                        size_t bufferSize) {
     struct v4l2_format format = buildV4L2Format(mType, fourcc, size, bufferSize, 0);
     if (mDevice->ioctl(VIDIOC_TRY_FMT, &format) != 0 || format.fmt.pix_mp.pixelformat != fourcc) {
-        ALOGEQ("Tried format not supported (format_fourcc=0x%" PRIx32 ")", fourcc);
+        // A probe: the callers report what they need from a format the device refuses.
+        ALOGVQ("Tried format not supported (format_fourcc=0x%" PRIx32 ")", fourcc);
         return std::nullopt;
     }
 
