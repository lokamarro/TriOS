     void tryFetchVideoFrame();
     void onVideoFrameReady(std::optional<VideoFramePool::FrameWithBlockId> frameWithBlockId);
@@ -128,8 +129,9 @@ private:
     // for pending DRC).
     bool mIsSecure;
     VideoCodec mCodec;
-    // The raw format the client asked for.
-    HalPixelFormat mOutputFormat = HalPixelFormat::YCBCR_420_888;
+    // The raw format the client wants, which changes as it sets the output surface.
+    GetOutputFormatCB mGetOutputFormatCb;
+    HalPixelFormat outputFormat() const;
 
     // Tracks the last DMA buffer ID which was used for a given V4L2 input
     // buffer ID. Used to try to avoid re-importing buffers.
