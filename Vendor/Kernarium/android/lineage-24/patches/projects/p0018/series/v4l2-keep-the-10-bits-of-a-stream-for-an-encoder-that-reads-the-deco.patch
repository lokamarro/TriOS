 .../include/v4l2_codec2/common/VideoTypes.h   |  2 +
 components/DecodeInterface.cpp                | 22 +++++++++++
 .../v4l2_codec2/components/DecodeInterface.h  | 14 ++++---
 .../v4l2_codec2/components/VideoDecoder.h     |  2 +
 v4l2/V4L2DecodeComponent.cpp                  |  3 +-
 v4l2/V4L2Decoder.cpp                          | 37 ++++++++++++++-----
 v4l2/V4L2Device.cpp                           |  3 +-
 v4l2/include/v4l2_codec2/v4l2/V4L2Decoder.h   | 14 ++++---
 9 files changed, 76 insertions(+), 23 deletions(-)

diff --git a/common/VideoTypes.cpp b/common/VideoTypes.cpp
index d9f40a94afe90c0ad1ee890a8f464eb9f9e1d34f..76b0b9d29aef2be2d7944932d5e4c6cf3aa88e98 100644
--- a/common/VideoTypes.cpp
+++ b/common/VideoTypes.cpp
@@ -91,6 +91,8 @@ const char* HalPixelFormatToString(HalPixelFormat format) {
     switch (format) {
     case HalPixelFormat::UNKNOWN:
         return "Unknown";
+    case HalPixelFormat::IMPLEMENTATION_DEFINED:
+        return "IMPLEMENTATION_DEFINED";
     case HalPixelFormat::YCBCR_420_888:
         return "YCBCR_420_888";
     case HalPixelFormat::YCBCR_P010:
diff --git a/common/include/v4l2_codec2/common/VideoTypes.h b/common/include/v4l2_codec2/common/VideoTypes.h
index 22ea0bc13ada4764010742b6373a9947e0a82de5..3972e216f6d00bc7c81f23b2fe44a347520af5e1 100644
--- a/common/include/v4l2_codec2/common/VideoTypes.h
+++ b/common/include/v4l2_codec2/common/VideoTypes.h
@@ -34,6 +34,8 @@ const char* profileToString(C2Config::profile_t profile);
 using HPixelFormat = ::android::hardware::graphics::common::V1_1::PixelFormat;
 enum class HalPixelFormat : int32_t {
     UNKNOWN = 0x0,
+    // The client renders to a Surface and takes the format the decoder picks for the stream.
+    IMPLEMENTATION_DEFINED = static_cast<int32_t>(HPixelFormat::IMPLEMENTATION_DEFINED),
     YCBCR_420_888 = static_cast<int32_t>(HPixelFormat::YCBCR_420_888),
     YV12 = static_cast<int32_t>(HPixelFormat::YV12),
     YCBCR_P010 = static_cast<int32_t>(HPixelFormat::YCBCR_P010),
diff --git a/components/DecodeInterface.cpp b/components/DecodeInterface.cpp
index 1735a98911d7451468550f9b2839b15c951f7f26..d882db3342bada2a134e20fdb1170942471f3e40 100644
--- a/components/DecodeInterface.cpp
+++ b/components/DecodeInterface.cpp
@@ -359,18 +359,28 @@ DecodeInterface::DecodeInterface(const std::string& name,
 
     // The raw formats the decoder can produce. Codec2InfoBuilder lists the colour formats of a
     // decoder from this parameter, so P010 is what makes a 10-bit decoder offer COLOR_FormatYUVP010.
+    // The framework sets IMPLEMENTATION_DEFINED when the client renders to a Surface; a decoder
+    // that does not list it never learns that, and the setter refuses the value.
     std::vector<uint32_t> pixelFormats = {HAL_PIXEL_FORMAT_YCBCR_420_888};
     if (std::any_of(profiles.begin(), profiles.end(), [](uint32_t profile) {
             return profile == C2Config::PROFILE_HEVC_MAIN_10 || profile == C2Config::PROFILE_VP9_2;
         })) {
         pixelFormats.push_back(HAL_PIXEL_FORMAT_YCBCR_P010);
     }
+    pixelFormats.push_back(HAL_PIXEL_FORMAT_IMPLEMENTATION_DEFINED);
     addParameter(DefineParam(mPixelFormat, C2_PARAMKEY_PIXEL_FORMAT)
                          .withDefault(new C2StreamPixelFormatInfo::output(
                                  0u, HAL_PIXEL_FORMAT_YCBCR_420_888))
                          .withFields({C2F(mPixelFormat, value).oneOf(pixelFormats)})
                          .withSetter(Setter<decltype(*mPixelFormat)>::NonStrictValueWithNoDeps)
                          .build());
+    // The framework sets the usage of the Surface's consumer here, which tells a video encoder's
+    // input from a display: see getOutputPixelFormat().
+    addParameter(DefineParam(mOutputMemoryUsage, C2_PARAMKEY_OUTPUT_STREAM_USAGE)
+                         .withDefault(new C2StreamUsageTuning::output(0u, 0u))
+                         .withFields({C2F(mOutputMemoryUsage, value).any()})
+                         .withSetter(Setter<decltype(*mOutputMemoryUsage)>::NonStrictValueWithNoDeps)
+                         .build());
     addParameter(
             DefineParam(mOutputDelay, C2_PARAMKEY_OUTPUT_DELAY)
                     .withConstValue(new C2PortDelayTuning::output(getOutputDelay(*mVideoCodec)))
@@ -567,6 +577,18 @@ c2_status_t DecodeInterface::updatePictureSize(uint32_t width, uint32_t height)
     return config({&size}, C2_MAY_BLOCK, &failures);
 }
 
+HalPixelFormat DecodeInterface::getOutputPixelFormat() const {
+    Lock lock = this->lock();
+    const HalPixelFormat format = static_cast<HalPixelFormat>(mPixelFormat->value);
+    if (format != HalPixelFormat::IMPLEMENTATION_DEFINED) return format;
+
+    // A Surface keeps the 10 bits of a 10-bit stream only where a video encoder reads them. The
+    // host has no P010 sampler, so a display that is given P010 cannot show it correctly.
+    const uint64_t usage =
+            C2AndroidMemoryUsage(C2MemoryUsage(mOutputMemoryUsage->value)).asGrallocUsage();
+    return (usage & GRALLOC_USAGE_HW_VIDEO_ENCODER) ? format : HalPixelFormat::YCBCR_420_888;
+}
+
 size_t DecodeInterface::getInputBufferSize() const {
     return mMaxInputSize->value;
 }
