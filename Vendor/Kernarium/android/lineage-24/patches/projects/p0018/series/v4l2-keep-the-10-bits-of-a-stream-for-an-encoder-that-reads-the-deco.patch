         uint32_t debugStreamId, const VideoCodec& codec, const size_t inputBufferSize,
         const size_t minNumOutputBuffers, GetPoolCB getPoolCb, OutputCB outputCb, ErrorCB errorCb,
         scoped_refptr<::base::SequencedTaskRunner> taskRunner, bool isSecure,
-        HalPixelFormat outputFormat) {
+        GetOutputFormatCB getOutputFormatCb) {
     std::unique_ptr<V4L2Decoder> decoder =
             ::base::WrapUnique<V4L2Decoder>(new V4L2Decoder(debugStreamId, taskRunner));
     if (!decoder->start(codec, inputBufferSize, minNumOutputBuffers, std::move(getPoolCb),
-                        std::move(outputCb), std::move(errorCb), isSecure, outputFormat)) {
+                        std::move(outputCb), std::move(errorCb), isSecure,
+                        std::move(getOutputFormatCb))) {
         return nullptr;
     }
     return decoder;
@@ -117,7 +118,7 @@ V4L2Decoder::~V4L2Decoder() {
 
 bool V4L2Decoder::start(const VideoCodec& codec, const size_t inputBufferSize,
                         const size_t minNumOutputBuffers, GetPoolCB getPoolCb, OutputCB outputCb,
-                        ErrorCB errorCb, bool isSecure, HalPixelFormat outputFormat) {
+                        ErrorCB errorCb, bool isSecure, GetOutputFormatCB getOutputFormatCb) {
     ATRACE_CALL();
     ALOGV("%s(codec=%s, inputBufferSize=%zu, minNumOutputBuffers=%zu)", __func__,
           VideoCodecToString(codec), inputBufferSize, minNumOutputBuffers);
@@ -129,7 +130,7 @@ bool V4L2Decoder::start(const VideoCodec& codec, const size_t inputBufferSize,
     mErrorCb = std::move(errorCb);
     mCodec = codec;
     mIsSecure = isSecure;
-    mOutputFormat = outputFormat;
+    mGetOutputFormatCb = std::move(getOutputFormatCb);
 
     if (mState == State::Error) {
         ALOGE("Ignore due to error state.");
@@ -312,12 +313,12 @@ bool V4L2Decoder::startOutputQueue(size_t minOutputBuffersCount, enum v4l2_memor
     const ui::Size codedSize(format->fmt.pix_mp.width, format->fmt.pix_mp.height);
     // Before the first picture is parsed there is no stream to ask a layout for: the initial
     // buffers are 8-bit and take the device's own choice.
-    const uint32_t preferred = streamKnown ? preferredOutputFormat(format->fmt.pix_mp.pixelformat)
+    const uint32_t preferred = streamKnown ? preferredOutputFormat(format->fmt.pix_mp.pixelformat,
+                                                                   codedSize)
                                            : format->fmt.pix_mp.pixelformat;
     ALOGI("Output format: the device has %s, the client asked for %s: requesting %s",
           fourccToString(format->fmt.pix_mp.pixelformat).c_str(),
-          mOutputFormat == HalPixelFormat::YCBCR_P010 ? "P010" : "8-bit",
-          fourccToString(preferred).c_str());
+          HalPixelFormatToString(outputFormat()), fourccToString(preferred).c_str());
     if (!setupOutputFormat(codedSize, preferred)) {
         return false;
     }
@@ -787,21 +788,37 @@ bool V4L2Decoder::changeResolution() {
     return true;
 }
 
-uint32_t V4L2Decoder::preferredOutputFormat(uint32_t deviceFormat) {
+HalPixelFormat V4L2Decoder::outputFormat() const {
+    return mGetOutputFormatCb ? mGetOutputFormatCb.Run() : HalPixelFormat::YCBCR_420_888;
+}
+
+uint32_t V4L2Decoder::preferredOutputFormat(uint32_t deviceFormat, const ui::Size& size) {
+    const HalPixelFormat clientFormat = outputFormat();
     const std::vector<uint32_t> offered =
             mDevice->enumerateSupportedPixelformats(V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
     const auto isOffered = [&offered](uint32_t pixfmt) {
         return std::find(offered.begin(), offered.end(), pixfmt) != offered.end();
     };
 
-    if (mOutputFormat == HalPixelFormat::YCBCR_P010) {
+    if (clientFormat == HalPixelFormat::YCBCR_P010) {
         // A client that asked for P010 gets 10-bit samples whatever layout the device kept from
         // an earlier choice. The device refuses P010 for a stream with 8-bit samples, and the
         // caller then falls back to the layout the device offers.
         return isOffered(Fourcc::P010) ? Fourcc::P010 : deviceFormat;
     }
 
-    if (mOutputFormat != HalPixelFormat::YCBCR_420_888 || deviceFormat != Fourcc::P010) {
+    if (clientFormat == HalPixelFormat::IMPLEMENTATION_DEFINED) {
+        // The client renders to the input Surface of a video encoder, which reads the samples
+        // and takes all 10 bits of a 10-bit stream: P010 for such a stream, which the device
+        // refuses to describe as P010 otherwise, and the layout the device chose for any other.
+        if (deviceFormat != Fourcc::P010 && isOffered(Fourcc::P010) &&
+            mOutputQueue->tryFormat(Fourcc::P010, size, 0) != std::nullopt) {
+            return Fourcc::P010;
+        }
+        return deviceFormat;
+    }
+
+    if (clientFormat != HalPixelFormat::YCBCR_420_888 || deviceFormat != Fourcc::P010) {
         return deviceFormat;
     }
 
diff --git a/v4l2/V4L2Device.cpp b/v4l2/V4L2Device.cpp
