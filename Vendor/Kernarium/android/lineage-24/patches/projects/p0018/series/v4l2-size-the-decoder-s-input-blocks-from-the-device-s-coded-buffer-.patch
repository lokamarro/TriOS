-constexpr size_t k1080pArea = 1920 * 1088;
-constexpr size_t k4KArea = 3840 * 2160;
-// Input bitstream buffer size for up to 1080p streams.
-// Set it to 2MB since it is possible for the encoded bitstream to exceed the size of 1MB
-// when using higher bitrates, like 1Mb/s on slower devices. Also, this brings up compability
-// with the Chrome browser as it is using 2MB buffer size for a 1080p stream, ref:
-// https://source.chromium.org/chromium/chromium/src/+/main:media/gpu/gpu_video_encode_accelerator_helpers.cc;l=25
-constexpr size_t kInputBufferSizeFor1080p = 16 * 1024 * 1024;  // 16MB
-// Input bitstream buffer size for up to 4k streams.
-constexpr size_t kInputBufferSizeFor4K = 4 * kInputBufferSizeFor1080p;
+// The range of the input blocks the component asks for by default. The framework allocates every
+// input block at the maximum input size and a stream keeps several of them, so a size beyond what
+// the stream's pictures need is memory that no frame uses: 64 MiB blocks held about 0.9 GB for one
+// 4K stream, while the component copies only the bytes a frame uses. The size follows the picture
+// size and never exceeds what the device takes (see inputBufferSizeFor), within these bounds.
+constexpr size_t kMinInputBufferSize = 1 * 1024 * 1024;
+constexpr size_t kMaxInputBufferSize = 16 * 1024 * 1024;
 
 // The levels of the HEVC Main tier that have a High tier counterpart, and that counterpart.
 struct HevcTierPair {
