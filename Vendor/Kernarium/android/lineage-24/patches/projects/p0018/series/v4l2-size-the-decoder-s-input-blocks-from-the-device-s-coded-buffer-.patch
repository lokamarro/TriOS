+                                     const C2P<C2StreamPictureSizeInfo::output>& size,
+                                     const C2P<C2V4l2InputBlockSizeSetting>& inputBlockSize) {
+    // A client states the largest sample of the clip it starts with, and the stream can carry
+    // larger ones (adaptive playback); the blocks never get smaller than the device's buffers for
+    // the picture size.
+    const size_t blockSize =
+            inputBufferSizeForPicture(inputBlockSize.v.value, size.v.width, size.v.height);
+    if (inputSize.v.value < blockSize) inputSize.set().value = static_cast<uint32_t>(blockSize);
     return inputSize.F(inputSize.v.value).validatePossible(inputSize.v.value);
