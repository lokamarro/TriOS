-size_t calculateInputBufferSize(size_t area) {
-    if (area > k4KArea) {
-        ALOGW("Input buffer size for video size (%zu) larger than 4K (%zu) might be too small.",
-              area, k4KArea);
+// The size of the input blocks for pictures of |width| x |height|, for a device whose coded buffers
+// are at most |ceiling| bytes (see inputBufferSizeFor): 1 MiB up to 1280x720, 2 MiB up to 1920x1088,
+// 4 MiB up to 4096x2304 and the ceiling above. A compressed picture is a fraction of its raw size,
+// and these are the sizes the device itself asks a client that states the picture size for, so a
+// block is never smaller than the device's buffer for the size.
+size_t inputBufferSizeForPicture(size_t ceiling, uint32_t width, uint32_t height) {
+    const uint64_t area = uint64_t(width) * height;
+    size_t size = kMaxInputBufferSize;
+    if (area <= 1280u * 720u) {
+        size = 1 * 1024 * 1024;
+    } else if (area <= 1920u * 1088u) {
+        size = 2 * 1024 * 1024;
+    } else if (area <= 4096u * 2304u) {
+        size = 4 * 1024 * 1024;
     }
+    return std::min(size, ceiling);
+}
 
-    // Enlarge the input buffer for 4k video
-    if (area > k1080pArea) return kInputBufferSizeFor4K;
-    return kInputBufferSizeFor1080p;
+// The size of the input blocks for a device that negotiates coded buffers of |codedBufferSize|
+// bytes: that size, within [kMinInputBufferSize, kMaxInputBufferSize]. A device that states no
+// size (the query failed or the device lists none) gets the largest block, which fits any coded
+// buffer up to that size and does not depend on a size the component could not get.
+size_t inputBufferSizeFor(uint32_t codedBufferSize) {
+    if (codedBufferSize == 0) return kMaxInputBufferSize;
+    return std::clamp<size_t>(codedBufferSize, kMinInputBufferSize, kMaxInputBufferSize);
 }
 }  // namespace
 
@@ -120,7 +133,15 @@ C2R DecodeInterface::SizeSetter(bool /* mayBlock */,
 }
 
 C2R DecodeInterface::InputSizeSetter(bool /* mayBlock */,
-                                     C2P<C2StreamMaxBufferSizeInfo::input>& inputSize) {
