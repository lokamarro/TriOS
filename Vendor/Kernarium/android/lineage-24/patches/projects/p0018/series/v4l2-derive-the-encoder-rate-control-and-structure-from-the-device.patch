@@ -902,6 +913,17 @@ void EncodeComponent::onOutputBufferDone(size_t dataSize, int64_t timestamp, boo
         C2Work* work = mWorkQueue.front().get();
         work->worklets.front()->output.configUpdate.push_back(std::move(csd));
         mExtractCSD = false;
