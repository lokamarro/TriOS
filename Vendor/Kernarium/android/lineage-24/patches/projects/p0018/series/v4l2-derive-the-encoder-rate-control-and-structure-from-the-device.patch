+    // Temporal layers are the layers of a hierarchical P coding structure.
+    const uint32_t layerId = isHEVC ? V4L2_CID_MPEG_VIDEO_HEVC_HIER_CODING_LAYER
+                                    : V4L2_CID_MPEG_VIDEO_H264_HIERARCHICAL_CODING_LAYER;
+    const uint32_t layerTypeId = isHEVC ? V4L2_CID_MPEG_VIDEO_HEVC_HIER_CODING_TYPE
+                                        : V4L2_CID_MPEG_VIDEO_H264_HIERARCHICAL_CODING_TYPE;
+    v4l2_queryctrl layerTypeCtrl;
+    if (queryControl(layerId, &ctrl) && ctrl.maximum > 1 &&
+        queryControl(layerTypeId, &layerTypeCtrl)) {
+        v4l2_querymenu menu;
+        memset(&menu, 0, sizeof(menu));
+        menu.id = layerTypeId;
+        menu.index = isHEVC ? static_cast<uint32_t>(V4L2_MPEG_VIDEO_HEVC_HIERARCHICAL_CODING_P)
+                            : static_cast<uint32_t>(V4L2_MPEG_VIDEO_H264_HIERARCHICAL_CODING_P);
+        if (ioctl(VIDIOC_QUERYMENU, &menu) == 0) {
