--- a/components/EncodeInterface.cpp
+++ b/components/EncodeInterface.cpp
@@ -43,6 +43,31 @@ constexpr uint32_t kDefaultBitrate = 64000;
 // TODO: increase this in the future for supporting higher level/resolution encoding.
 constexpr uint32_t kMaxBitrate = 50000000;
 
+// The default quality of the constant quality bitrate mode, in the middle of the 1 to 100 range.
+constexpr uint32_t kDefaultQuality = 50;
+// The share of the bitrate that the base temporal layer gets when the client gives none.
+constexpr float kDefaultBaseLayerBitrateRatio = 0.6f;
+// The most temporal layers that a client can ask for before the setter reduces the request to what
+// the device supports.
+constexpr uint32_t kMaxRequestedLayerCount = 8;
+// The most B-frames between two reference frames that a client can ask for before the setter
+// reduces the request to what the device supports.
+constexpr uint32_t kMaxRequestedBFrames = 16;
+// The frames, beyond the run of B-frames, after which a client may wait for the next output: a
+// reference frame is coded only once the frames before it have arrived, so the output that follows
+// the first one comes with the frame after the run.
+constexpr uint32_t kReorderHoldBack = 1;
+
+// The H.264 levels offered when the device does not list the ones it supports.
+constexpr C2Config::level_t kDefaultH264Levels[] = {
+        C2Config::LEVEL_AVC_1,   C2Config::LEVEL_AVC_1B,  C2Config::LEVEL_AVC_1_1,
+        C2Config::LEVEL_AVC_1_2, C2Config::LEVEL_AVC_1_3, C2Config::LEVEL_AVC_2,
+        C2Config::LEVEL_AVC_2_1, C2Config::LEVEL_AVC_2_2, C2Config::LEVEL_AVC_3,
+        C2Config::LEVEL_AVC_3_1, C2Config::LEVEL_AVC_3_2, C2Config::LEVEL_AVC_4,
+        C2Config::LEVEL_AVC_4_1, C2Config::LEVEL_AVC_4_2, C2Config::LEVEL_AVC_5,
+        C2Config::LEVEL_AVC_5_1,
+};
+
 // The HEVC levels offered when the device does not list the ones it supports. They stop at the
 // level every tier-aware encoder of this size class meets.
 constexpr C2Config::level_t kDefaultHEVCLevels[] = {
@@ -51,6 +76,35 @@ constexpr C2Config::level_t kDefaultHEVCLevels[] = {
         C2Config::LEVEL_HEVC_MAIN_4_1, C2Config::LEVEL_HEVC_MAIN_5,   C2Config::LEVEL_HEVC_MAIN_5_1,
 };
 
+// Returns the H.264 levels the interface offers: the levels |deviceLevels| lists, or the default
+// levels when the device lists none.
+std::vector<unsigned int> offeredH264Levels(const std::vector<C2Config::level_t>& deviceLevels) {
+    std::vector<unsigned int> levels;
+    for (const H264LevelLimits& limit : kH264Limits) {
+        if (std::find(deviceLevels.begin(), deviceLevels.end(), limit.level) !=
+            deviceLevels.end()) {
+            levels.push_back(static_cast<unsigned int>(limit.level));
+        }
+    }
+    if (levels.empty()) {
+        for (C2Config::level_t level : kDefaultH264Levels) {
+            levels.push_back(static_cast<unsigned int>(level));
+        }
+    }
+    return levels;
+}
+
+// Returns the highest of |levels| that is not above |ceiling|, or the lowest level if all are.
+unsigned int defaultLevelBelow(const std::vector<unsigned int>& levels, C2Config::level_t ceiling) {
+    unsigned int defaultLevel = levels.front();
+    for (unsigned int level : levels) {
+        if (level <= static_cast<unsigned int>(ceiling)) {
+            defaultLevel = level;
+        }
+    }
+    return defaultLevel;
+}
