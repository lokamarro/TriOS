+    // A device that has no level control leaves the levels empty, so the component offers its own.
+    if (isCtrlExposed(isHEVC ? V4L2_CID_MPEG_VIDEO_HEVC_LEVEL : V4L2_CID_MPEG_VIDEO_H264_LEVEL)) {
+        caps->supportedLevels = queryC2Levels(pixFmt);
+    }
+}
