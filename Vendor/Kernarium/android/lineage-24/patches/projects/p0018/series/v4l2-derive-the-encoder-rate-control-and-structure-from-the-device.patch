+        // The device may write a level other than the one it was given, as a device that only
+        // knows to pick the level of a stream does, so tell the framework the level of the stream.
+        const C2Config::level_t streamLevel =
+                extractStreamLevel(isHEVCProfile(mOutputProfile), view.data(), view.capacity());
+        if (streamLevel != C2Config::LEVEL_UNUSED && streamLevel != mOutputLevel) {
