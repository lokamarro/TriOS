+C2Config::level_t extractStreamLevel(bool isHEVC, const uint8_t* data, size_t length) {
+    if (!isHEVC) {
+        // The SPS is the NAL header, profile_idc, the constraint flags and level_idc.
+        std::vector<uint8_t> sps;
+        std::vector<uint8_t> pps;
+        if (!extractSPSPPS(data, length, &sps, &pps) || sps.size() < 4) return C2Config::LEVEL_UNUSED;
+        const uint8_t profileIdc = sps[1];
+        const uint8_t constraintFlags = sps[2];
+        const uint8_t levelIdc = sps[3];
+        // Level 1b is level 1.1 with constraint_set3 in the profiles that have no level 1b code.
+        const bool oneB = levelIdc == 9 || (levelIdc == 11 && (constraintFlags & 0x10) &&
+                                            (profileIdc == 66 || profileIdc == 77 ||
+                                             profileIdc == 88));
+        if (oneB) return C2Config::LEVEL_AVC_1B;
+        switch (levelIdc) {
+        case 10: return C2Config::LEVEL_AVC_1;
+        case 11: return C2Config::LEVEL_AVC_1_1;
+        case 12: return C2Config::LEVEL_AVC_1_2;
+        case 13: return C2Config::LEVEL_AVC_1_3;
+        case 20: return C2Config::LEVEL_AVC_2;
+        case 21: return C2Config::LEVEL_AVC_2_1;
+        case 22: return C2Config::LEVEL_AVC_2_2;
+        case 30: return C2Config::LEVEL_AVC_3;
+        case 31: return C2Config::LEVEL_AVC_3_1;
+        case 32: return C2Config::LEVEL_AVC_3_2;
+        case 40: return C2Config::LEVEL_AVC_4;
+        case 41: return C2Config::LEVEL_AVC_4_1;
+        case 42: return C2Config::LEVEL_AVC_4_2;
+        case 50: return C2Config::LEVEL_AVC_5;
+        case 51: return C2Config::LEVEL_AVC_5_1;
+        case 52: return C2Config::LEVEL_AVC_5_2;
+        case 60: return C2Config::LEVEL_AVC_6;
+        case 61: return C2Config::LEVEL_AVC_6_1;
+        case 62: return C2Config::LEVEL_AVC_6_2;
+        default: return C2Config::LEVEL_UNUSED;
+        }
+    }
+
+    std::vector<uint8_t> vps;
+    std::vector<uint8_t> sps;
+    std::vector<uint8_t> pps;
+    if (!extractVPSSPSPPS(data, length, &vps, &sps, &pps)) return C2Config::LEVEL_UNUSED;
+
+    // The SPS is the two byte NAL header, then the VPS id with the sub-layer count, then the
+    // profile, tier and level of the general profile. Drop the emulation prevention bytes of the
+    // first bytes, which can hold zeros, to read them as they are in the payload.
+    std::vector<uint8_t> payload;
+    for (size_t i = 2; i < sps.size() && payload.size() < 13; ++i) {
+        const size_t n = payload.size();
+        if (n >= 2 && payload[n - 1] == 0 && payload[n - 2] == 0 && sps[i] == 3) continue;
+        payload.push_back(sps[i]);
+    }
+    if (payload.size() < 13) return C2Config::LEVEL_UNUSED;
+    const bool highTier = payload[1] & 0x20;
+    const uint8_t levelIdc = payload[12];
+    // Levels below 4 have no high tier.
+    struct HevcLevel {
+        uint8_t idc;
+        C2Config::level_t main;
+        C2Config::level_t high;
+    };
+    static const HevcLevel kLevels[] = {
+            {30, C2Config::LEVEL_HEVC_MAIN_1, C2Config::LEVEL_HEVC_MAIN_1},
+            {60, C2Config::LEVEL_HEVC_MAIN_2, C2Config::LEVEL_HEVC_MAIN_2},
+            {63, C2Config::LEVEL_HEVC_MAIN_2_1, C2Config::LEVEL_HEVC_MAIN_2_1},
+            {90, C2Config::LEVEL_HEVC_MAIN_3, C2Config::LEVEL_HEVC_MAIN_3},
+            {93, C2Config::LEVEL_HEVC_MAIN_3_1, C2Config::LEVEL_HEVC_MAIN_3_1},
+            {120, C2Config::LEVEL_HEVC_MAIN_4, C2Config::LEVEL_HEVC_HIGH_4},
+            {123, C2Config::LEVEL_HEVC_MAIN_4_1, C2Config::LEVEL_HEVC_HIGH_4_1},
+            {150, C2Config::LEVEL_HEVC_MAIN_5, C2Config::LEVEL_HEVC_HIGH_5},
+            {153, C2Config::LEVEL_HEVC_MAIN_5_1, C2Config::LEVEL_HEVC_HIGH_5_1},
+            {156, C2Config::LEVEL_HEVC_MAIN_5_2, C2Config::LEVEL_HEVC_HIGH_5_2},
+            {180, C2Config::LEVEL_HEVC_MAIN_6, C2Config::LEVEL_HEVC_HIGH_6},
+            {183, C2Config::LEVEL_HEVC_MAIN_6_1, C2Config::LEVEL_HEVC_HIGH_6_1},
+            {186, C2Config::LEVEL_HEVC_MAIN_6_2, C2Config::LEVEL_HEVC_HIGH_6_2},
+    };
+    for (const HevcLevel& level : kLevels) {
+        if (level.idc == levelIdc) return highTier ? level.high : level.main;
+    }
+    return C2Config::LEVEL_UNUSED;
+}
+
 size_t prependSPSPPSToIDR(const uint8_t* src, size_t srcSize, uint8_t* dst, size_t dstSize,
                           std::vector<uint8_t>* sps, std::vector<uint8_t>* pps) {
     bool foundStreamParams = false;
