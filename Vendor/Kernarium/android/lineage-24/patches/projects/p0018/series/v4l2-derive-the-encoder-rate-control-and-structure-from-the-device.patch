+    v4l2_queryctrl maxQp;
+    if (queryControl(isHEVC ? V4L2_CID_MPEG_VIDEO_HEVC_MIN_QP : V4L2_CID_MPEG_VIDEO_H264_MIN_QP,
+                     &minQp) &&
