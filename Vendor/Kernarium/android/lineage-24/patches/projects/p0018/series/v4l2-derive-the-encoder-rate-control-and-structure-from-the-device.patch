+std::optional<std::pair<int32_t, int32_t>> EncodeInterface::getQpBounds() const {
+    if (!mPictureQuantization || !mQpRange) return std::nullopt;
+
+    // The device has one pair of bounds for all picture types, so take the tightest of those the
+    // client set for any type.
+    int32_t minQp = INT32_MIN;
+    int32_t maxQp = INT32_MAX;
+    {
+        Lock lock = this->lock();
+        for (size_t i = 0; i < mPictureQuantization->flexCount(); ++i) {
+            const C2PictureQuantizationStruct& layer = mPictureQuantization->m.values[i];
+            minQp = std::max(minQp, layer.min);
+            maxQp = std::min(maxQp, layer.max);
+        }
+    }
+    if (minQp == INT32_MIN && maxQp == INT32_MAX) return std::nullopt;
+
+    minQp = std::clamp(minQp, mQpRange->first, mQpRange->second);
+    maxQp = std::clamp(maxQp, mQpRange->first, mQpRange->second);
+    return std::make_pair(std::min(minQp, maxQp), maxQp);
+}
+
+uint32_t EncodeInterface::getMaxBFrames() const {
+    if (!mGop) return 0;
+
+    uint32_t bFrames = 0;
+    Lock lock = this->lock();
+    for (size_t i = 0; i < mGop->flexCount(); ++i) {
+        const C2GopLayerStruct& layer = mGop->m.values[i];
+        if (layer.type_ & C2Config::B_FRAME) bFrames = std::max(bFrames, layer.count);
+    }
+    return std::min(bFrames, mMaxBFrames);
+}
+
+uint32_t EncodeInterface::getTemporalLayerCount() const {
+    if (!mLayering) return 1;
+
+    Lock lock = this->lock();
+    return std::clamp(mLayering->m.layerCount, 1u, mMaxTemporalLayers);
+}
+
+float EncodeInterface::getBaseLayerBitrateRatio() const {
+    if (!mLayering) return 1.0f;
+
+    Lock lock = this->lock();
+    if (mLayering->flexCount() == 0) return kDefaultBaseLayerBitrateRatio;
+    // Keep both layers non-empty, as the device takes a bitrate for each.
+    return std::clamp(mLayering->m.bitrateRatios[0], 0.05f, 0.95f);
+}
