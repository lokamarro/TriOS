+bool V4L2Encoder::setOptionalControl(uint32_t id, int32_t value) {
+    const auto range = controlRange(id);
+    if (!range) return false;
+
+    value = std::clamp(value, range->first, range->second);
+    return mDevice->setExtCtrls(V4L2_CTRL_CLASS_MPEG, {V4L2ExtCtrl(id, value)});
