+            switch (menu.index) {
+            case V4L2_MPEG_VIDEO_BITRATE_MODE_VBR:
+                caps->bitrateModes.push_back(C2Config::BITRATE_VARIABLE);
+                break;
+            case V4L2_MPEG_VIDEO_BITRATE_MODE_CBR:
+                caps->bitrateModes.push_back(C2Config::BITRATE_CONST);
+                break;
+            case V4L2_MPEG_VIDEO_BITRATE_MODE_CQ:
+                caps->bitrateModes.push_back(C2Config::BITRATE_IGNORE);
+                break;
+            }
+        }
+    }
