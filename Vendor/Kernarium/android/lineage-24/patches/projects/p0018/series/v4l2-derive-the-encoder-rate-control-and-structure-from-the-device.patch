     }
 
     // Get the work item associated with the timestamp.
@@ -931,10 +953,7 @@ void EncodeComponent::onOutputBufferDone(size_t dataSize, int64_t timestamp, boo
     // We can report the work item as completed if its associated input buffer has also been
     // released. As output buffers are not necessarily returned in order we might be able to return
     // multiple ready work items now.
-    while (!mWorkQueue.empty() && isWorkDone(*mWorkQueue.front())) {
-        reportWork(std::move(mWorkQueue.front()));
-        mWorkQueue.pop_front();
-    }
+    reportFinishedWork();
 }
 
 C2Work* EncodeComponent::getWorkByIndex(uint64_t index) {
@@ -999,6 +1018,25 @@ bool EncodeComponent::isWorkDone(const C2Work& work) const {
     return true;
 }
 
+void EncodeComponent::reportFinishedWork() {
+    ALOG_ASSERT(mEncoderTaskRunner->RunsTasksInCurrentSequence());
+
+    for (auto it = mWorkQueue.begin(); it != mWorkQueue.end();) {
+        const bool endOfStream = (*it)->input.flags & C2FrameData::FLAG_END_OF_STREAM;
+        // The work item that ends the stream finishes last, after all that came before it.
+        if (isWorkDone(**it) && (!endOfStream || it == mWorkQueue.begin())) {
+            reportWork(std::move(*it));
+            it = mWorkQueue.erase(it);
+        } else if (mReordersOutput && !endOfStream) {
+            // A later item can be done before this one, as the encoded stream is not in the order
+            // of the input.
+            ++it;
+        } else {
+            break;
+        }
+    }
+}
+
 void EncodeComponent::reportWork(std::unique_ptr<C2Work> work) {
     ATRACE_CALL();
     ALOG_ASSERT(work);
diff --git a/components/EncodeInterface.cpp b/components/EncodeInterface.cpp
