+std::optional<std::pair<int32_t, int32_t>> V4L2Encoder::controlRange(uint32_t id) {
+    struct v4l2_queryctrl ctrl;
+    memset(&ctrl, 0, sizeof(ctrl));
+    ctrl.id = id;
