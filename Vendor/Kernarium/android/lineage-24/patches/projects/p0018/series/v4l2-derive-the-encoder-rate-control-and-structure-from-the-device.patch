+// static
+C2R EncodeInterface::PictureQuantizationSetter(bool /*mayBlock*/,
+                                               C2P<C2StreamPictureQuantizationTuning::output>& me) {
+    // A lower bound above the upper bound of the same picture type would fail on the device, so
+    // the lower bound gives way. The bounds themselves are clamped to the device's range when the
+    // component reads them.
+    for (size_t i = 0; i < me.v.flexCount(); ++i) {
+        const C2PictureQuantizationStruct& layer = me.v.m.values[i];
+        if (layer.min > layer.max) {
+            me.set().m.values[i].min = layer.max;
+        }
+    }
+    return C2R::Ok();
+}
+
+// static
+C2R EncodeInterface::LayeringSetter(bool /*mayBlock*/,
+                                    C2P<C2StreamTemporalLayeringTuning::output>& me) {
+    // Reduce the layers to the most the device supports, and code them as P frames, so there are no
+    // bidirectional layers.
+    uint32_t layerCount = std::min(me.v.m.layerCount, kMaxRequestedLayerCount);
+    while (layerCount > 0 && !me.F(me.v.m.layerCount).supportsAtAll(layerCount)) {
+        --layerCount;
+    }
+    me.set().m.layerCount = layerCount;
+    me.set().m.bLayerCount = 0;
+    // Make the ratios rise from the base layer to the whole stream and keep them within 0 and 1.
+    for (size_t i = 0; i < me.v.flexCount(); ++i) {
+        me.set().m.bitrateRatios[i] =
+                c2_clamp(i > 0 ? me.v.m.bitrateRatios[i - 1] : 0.f, me.v.m.bitrateRatios[i], 1.f);
+    }
+    return C2R::Ok();
+}
+
+// static
+C2R EncodeInterface::GopSetter(bool /*mayBlock*/, C2P<C2StreamGopTuning::output>& /*me*/) {
+    // The structure is taken as the client gives it. The count of a layer has no range, as the
+    // period of the P frames shares the field with the run of B-frames, so the run is limited to
+    // what the device supports where the component reads it, and by the input delay below.
+    // (Setter<>::NonStrictValuesWithNoDeps would validate each layer through a field helper of the
+    // layer struct, which the interface helper library does not instantiate.)
+    return C2R::Ok();
+}
+
+// static
+C2R EncodeInterface::PipelineDelaySetter(bool /*mayBlock*/, C2P<C2PipelineDelayTuning>& me,
+                                         const C2P<C2StreamGopTuning::output>& gop) {
+    // The latency a client reads as MediaFormat.KEY_LATENCY: the input frames after which it may
+    // wait for the encoder to have an output. An encoder that codes a run of B-frames holds those
+    // frames until the next reference frame arrives, so a client that waits for an output after a
+    // latency of the run alone waits for one that is not yet coded and the stream stalls.
+    uint32_t bFrames = 0;
+    for (size_t i = 0; i < gop.v.flexCount(); ++i) {
+        const C2GopLayerStruct& layer = gop.v.m.values[i];
+        if (layer.type_ & C2Config::B_FRAME) bFrames = std::max(bFrames, layer.count);
+    }
+    bFrames = std::min(bFrames, kMaxRequestedBFrames);
+    while (bFrames > 0 && !me.F(me.v.value).supportsAtAll(bFrames + kReorderHoldBack)) {
+        --bFrames;
+    }
+    me.set().value = bFrames ? bFrames + kReorderHoldBack : 0;
+    return C2R::Ok();
+}
+
+// static
+C2R EncodeInterface::InputDelaySetter(bool /*mayBlock*/, C2P<C2PortActualDelayTuning::input>& me,
+                                      const C2P<C2StreamGopTuning::output>& gop) {
+    // The encoder holds as many frames as there are B-frames between two reference frames before
+    // it can output the first of them, and no more than the device supports.
+    uint32_t bFrames = 0;
+    for (size_t i = 0; i < gop.v.flexCount(); ++i) {
+        const C2GopLayerStruct& layer = gop.v.m.values[i];
+        if (layer.type_ & C2Config::B_FRAME) bFrames = std::max(bFrames, layer.count);
+    }
+    bFrames = std::min(bFrames, kMaxRequestedBFrames);
+    while (bFrames > 0 && !me.F(me.v.value).supportsAtAll(bFrames)) {
+        --bFrames;
+    }
+    me.set().value = bFrames;
+    return C2R::Ok();
