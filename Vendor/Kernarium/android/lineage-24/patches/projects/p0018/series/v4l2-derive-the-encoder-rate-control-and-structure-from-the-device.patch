+void V4L2Encoder::configureStructure(const EncodingParams& params, uint32_t bitrate,
+                                     const StructureControls& controls) {
+    // The device has to bound the quantization parameter for the rate control to work with all
+    // bitrates, so the upper bound is its full range when the client set no bound.
+    if (params.qpBounds) {
+        setOptionalControl(controls.maxQp, params.qpBounds->second);
+        setOptionalControl(controls.minQp, params.qpBounds->first);
+    } else if (auto range = controlRange(controls.maxQp)) {
+        setOptionalControl(controls.maxQp, range->second);
+    }
+
+    // Layers of P frames have no B-frames, as the device encodes a stream with layers at low
+    // latency. Without layers B-frames are off, for the lowest decoding latency, unless the client
+    // allows them.
+    const bool layered = params.temporalLayers > 1;
+    setOptionalControl(V4L2_CID_MPEG_VIDEO_B_FRAMES,
+                       layered ? 0 : static_cast<int32_t>(params.maxBFrames));
+    if (!layered) return;
+
+    if (controls.hierarchicalCoding != 0) {
+        setOptionalControl(controls.hierarchicalCoding, 1);
+    }
+    if (!setOptionalControl(controls.layerType, controls.layerTypeP) ||
+        !setOptionalControl(controls.layerCount, static_cast<int32_t>(params.temporalLayers))) {
+        ALOGW("Setting %u temporal layers failed", params.temporalLayers);
+        return;
+    }
+    // The device takes the bitrate of each layer and shares the stream's bitrate in that ratio.
+    const uint32_t layer0Bitrate = static_cast<uint32_t>(bitrate * params.baseLayerBitrateRatio);
+    setOptionalControl(controls.layer0Bitrate, static_cast<int32_t>(layer0Bitrate));
+    setOptionalControl(controls.layer1Bitrate, static_cast<int32_t>(bitrate - layer0Bitrate));
+}
