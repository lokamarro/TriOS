From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 26 Oct 2026 08:28:40 +0900
Subject: [PATCH] v4l2: offer the HEVC High tier levels a decoder takes

The device reports the HEVC levels of a decoder without a tier, because
the wire has none, and the decoder interface turned each into the Main
tier level. The device decodes a High tier stream wherever it decodes the
level, so a client that looked for a decoder for a High tier configuration
found none: the encoder tests that decode their own High tier output
failed with no decoder for the format.

The interface now also offers the High tier counterpart of every Main
tier level above 3.1 that the device lists.
---
 components/DecodeInterface.cpp | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/components/DecodeInterface.cpp b/components/DecodeInterface.cpp
index e0359f06530d7baf5a63a4aae33228f3db621f6a..0b07c7dc36f43cab498b6c0cf7679e928d70e99f 100644
--- a/components/DecodeInterface.cpp
+++ b/components/DecodeInterface.cpp
@@ -33,6 +33,37 @@ constexpr size_t kInputBufferSizeFor1080p = 16 * 1024 * 1024;  // 16MB
 // Input bitstream buffer size for up to 4k streams.
 constexpr size_t kInputBufferSizeFor4K = 4 * kInputBufferSizeFor1080p;
 
+// The levels of the HEVC Main tier that have a High tier counterpart, and that counterpart.
+struct HevcTierPair {
+    C2Config::level_t main;
+    C2Config::level_t high;
+};
+constexpr HevcTierPair kHevcTierPairs[] = {
+        {C2Config::LEVEL_HEVC_MAIN_4, C2Config::LEVEL_HEVC_HIGH_4},
+        {C2Config::LEVEL_HEVC_MAIN_4_1, C2Config::LEVEL_HEVC_HIGH_4_1},
+        {C2Config::LEVEL_HEVC_MAIN_5, C2Config::LEVEL_HEVC_HIGH_5},
+        {C2Config::LEVEL_HEVC_MAIN_5_1, C2Config::LEVEL_HEVC_HIGH_5_1},
+        {C2Config::LEVEL_HEVC_MAIN_5_2, C2Config::LEVEL_HEVC_HIGH_5_2},
+        {C2Config::LEVEL_HEVC_MAIN_6, C2Config::LEVEL_HEVC_HIGH_6},
+        {C2Config::LEVEL_HEVC_MAIN_6_1, C2Config::LEVEL_HEVC_HIGH_6_1},
+        {C2Config::LEVEL_HEVC_MAIN_6_2, C2Config::LEVEL_HEVC_HIGH_6_2},
+};
+
+// Adds the High tier of every Main tier level in |levels| that has one. The device reports the
+// levels without a tier, so a stream of either tier is accepted wherever the device decodes the
+// level, and the decoder of such a device decodes both.
+void addHevcHighTierLevels(std::vector<unsigned int>* levels) {
+    const std::vector<unsigned int> mainLevels = *levels;
+    for (const HevcTierPair& pair : kHevcTierPairs) {
+        const unsigned int main = static_cast<unsigned int>(pair.main);
+        const unsigned int high = static_cast<unsigned int>(pair.high);
+        if (std::find(mainLevels.begin(), mainLevels.end(), main) != mainLevels.end() &&
+            std::find(levels->begin(), levels->end(), high) == levels->end()) {
+            levels->push_back(high);
+        }
+    }
+}
+
 size_t calculateInputBufferSize(size_t area) {
     if (area > k4KArea) {
         ALOGW("Input buffer size for video size (%zu) larger than 4K (%zu) might be too small.",
@@ -215,6 +246,8 @@ DecodeInterface::DecodeInterface(const std::string& name,
         }
     }
 
+    if (mVideoCodec == VideoCodec::HEVC) addHevcHighTierLevels(&levels);
+
     uint32_t defaultLevel = caps.defaultLevel;
     if (defaultLevel == C2Config::LEVEL_UNUSED)
         defaultLevel = *std::min_element(levels.begin(), levels.end());
