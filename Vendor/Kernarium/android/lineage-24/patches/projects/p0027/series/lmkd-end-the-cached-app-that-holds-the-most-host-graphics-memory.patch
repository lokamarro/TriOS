+TEST(gpu_reclaim, three_kills_in_an_episode) {
+    Policy policy;
+    int64_t now = 1000;
+    for (int i = 0; i < gpu_reclaim::kMaxKillsPerEpisode; i++) {
+        Policy::Decision d = feed(&policy, pressured(1 + i), now, kCachedApp);
+        ASSERT_TRUE(d.action == Action::kKill) << i;
+        int64_t next = policy.on_kill_result(now, 1 + i, true);
+        if (i + 1 < gpu_reclaim::kMaxKillsPerEpisode) {
+            EXPECT_GT(next, 0);
+        } else {
+            EXPECT_EQ(0, next);
+        }
+        now += 3100;
+    }
+    Policy::Decision d = feed(&policy, pressured(10), now, kCachedApp);
+    EXPECT_TRUE(d.action == Action::kNone);
+    EXPECT_EQ(0, d.next_ms);
+    EXPECT_TRUE(policy.in_episode());
+    EXPECT_EQ(gpu_reclaim::kMaxKillsPerEpisode, policy.kills_in_episode());
+}
