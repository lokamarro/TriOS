+
+#ifndef _LMKD_GPU_RECLAIM_H_
+#define _LMKD_GPU_RECLAIM_H_
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/types.h>
+
+/*
+ * GPU-aware reclaim. A virtual device whose graphics memory lives on the host has a budget that
+ * Android's own memory accounting cannot see. When the host reports that the budget is under
+ * pressure, lmkd ends the one cached app that holds the most host graphics memory, and nothing else.
+ *
+ * This is the part without side effects: the report, the choice of the victim and the limits. The
+ * file descriptors and the kill itself are in lmkd.cpp. It does not allocate and does not log.
+ *
+ * The report is /sys/class/drm/card0/gpu_memory_report, a root-only sysfs attribute of the guest's
+ * virtio-gpu driver that holds the last snapshot the host sent:
+ *
+ *   seq=<n> age_ms=<n> state=<n> refused=<n> budget=<n> used=<n> held=<n> armed=<0|1>
+ *   <pid> <bytes> <idle_ms> <contexts> <comm>
+ *   ...
+ *
+ * The first line is key=value pairs. `seq` counts snapshots from 1 (0 is "none yet") and `age_ms` is
+ * the age of this one. `state` has bit 0 set while the host's pool is under pressure and bit 1 set
+ * when an allocation was refused since the previous snapshot. The other numbers are bytes (`refused`
+ * counts refusals). A holder line is one process of the guest that holds host graphics memory, at
+ * most 16, largest first, with the process name as the guest gave it to the host. The driver
+ * notifies the file (poll for POLLPRI) when it stores a new snapshot.
+ *
+ * Writes to the file: "arm <min_bytes> <min_idle_ms>" asks the host to send snapshots, listing only
+ * holders of at least that many bytes that have been idle for at least that long; "refresh" asks for
+ * a new snapshot; "disarm" stops them.
+ */
+namespace gpu_reclaim {
+
+// The limits.
+constexpr uint64_t kMinHolderBytes = 32ull << 20;  // a holder must hold at least this much
+constexpr uint64_t kMinIdleMs = 10000;             // and have been idle for this long
+constexpr int64_t kMinKillIntervalMs = 3000;       // at most one kill in this time
+constexpr int kMaxKillsPerEpisode = 3;             // and this many while the pressure lasts
+constexpr int64_t kRefreshIntervalMs = 3000;       // snapshot refresh period while it lasts
+constexpr int64_t kEmptyPassBackoffMs = 10000;     // wait this long after a pass found no victim
+constexpr uint64_t kMaxSnapshotAgeMs = 6000;       // an older snapshot is not acted on
+constexpr int kMaxUnansweredRefreshes = 3;         // the host is silent: give the episode up
+
+// oom_score_adj bands, from frameworks/base/services/core/java/com/android/server/am/psc.
+constexpr int kCachedAppMinAdj = 900;      // CACHED_APP_MIN_ADJ
+constexpr int kPreviousAppAdj = 700;       // PREVIOUS_APP_ADJ
+constexpr int kPreviousAppMaxAdj = 799;    // PREVIOUS_APP_MAX_ADJ_LADDERED
+
+constexpr int kMaxHolders = 16;
+constexpr size_t kCommLen = 16;  // TASK_COMM_LEN, including the terminating NUL
+
+constexpr uint32_t kStatePressure = 1u << 0;
+constexpr uint32_t kStateRefused = 1u << 1;
+
+struct Holder {
+    int32_t pid;
+    uint64_t bytes;
+    uint64_t idle_ms;
+    uint32_t contexts;
+    char comm[kCommLen];
+};
+
+struct Report {
+    uint64_t seq;
+    uint64_t age_ms;
+    uint32_t state;
+    uint64_t refused;
+    uint64_t budget;
+    uint64_t used;
+    uint64_t held;
+    bool armed;
+    int holder_count;
+    Holder holders[kMaxHolders];
+};
+
+/*
+ * Parses the text of the report into *report. Returns false, leaving *report unspecified, when the
+ * header is missing, malformed or lacks seq or state. A holder line that is malformed, or beyond
+ * kMaxHolders, is skipped; so is a last line the text ends in the middle of.
+ */
+bool parse_report(const char* text, size_t len, Report* report);
+
+/* Whether the name a holder carries is the name the kernel has for the process (up to 15 chars). */
+bool comm_matches(const char* holder_comm, const char* proc_comm);
+
+/*
+ * Tells whether the process is registered with lmkd, and if so its oom_score_adj. The caller checks
+ * that the pid is still the process the holder names.
+ */
+typedef bool (*ProcLookup)(const Holder& holder, int* oomadj, void* cookie);
+
+/*
+ * Chooses the process to end among report.holders: the largest holder of at least kMinHolderBytes
+ * and idle for at least kMinIdleMs whose oom_score_adj is CACHED_APP_MIN_ADJ or more; if there is
+ * none, the largest such holder of the previous app's band. Anything below the previous app
+ * (service B, home, services, perceptible, visible, foreground) and any process lmkd does not know
+ * is never chosen. Returns its index, or -1, and stores the band's lowest adj in *band_adj.
+ */
+int choose_victim(const Report& report, ProcLookup lookup, void* cookie, int* band_adj);
+
+class Policy {
+  public:
+    struct Decision {
+        enum class Action {
+            kNone,     // nothing to do
+            kKill,     // end report.holders[holder]; then call on_kill_result()
+            kRefresh,  // ask the driver for a new snapshot
+        };
+        Action action;
+        int holder;        // kKill: index into the report
+        int band_adj;      // kKill: lowest adj of the band the victim is in
+        int64_t next_ms;   // the episode timer: fire in this long (0: cancel it)
+        const char* note;  // why nothing was done, for the debug log
+    };
+
+    /* Feeds a new snapshot. kill_pending is lmkd's own is_kill_pending(). */
+    Decision on_report(const Report& report, int64_t now_ms, bool kill_pending, ProcLookup lookup,
+                       void* cookie);
+    /* Reports the outcome of a kKill; returns the next timer. seq is the snapshot's. */
+    int64_t on_kill_result(int64_t now_ms, uint64_t seq, bool killed);
+    /* The episode timer fired. */
+    Decision on_timer(int64_t now_ms);
+
+    bool in_episode() const { return episode_; }
+    int kills_in_episode() const { return kills_; }
+
+  private:
+    void end_episode();
+    Decision none(int64_t next_ms, const char* note) const;
+
+    bool episode_ = false;
+    int kills_ = 0;
+    int unanswered_ = 0;
+    bool have_kill_ = false;
+    int64_t last_kill_ms_ = 0;
+    uint64_t last_kill_seq_ = 0;
+    int64_t next_pass_ms_ = 0;
+    bool have_seq_ = false;
+    uint64_t last_seq_ = 0;
+    bool have_refused_ = false;
+    uint64_t refused_seen_ = 0;
+};
+
+}  // namespace gpu_reclaim
