+TEST(gpu_reclaim, timer_gives_up_when_the_host_does_not_answer) {
+    Policy policy;
+    ASSERT_TRUE(feed(&policy, pressured(1), 1000, kCachedApp, true).action == Action::kNone);
+    int64_t now = 4000;
+    for (int i = 0; i < gpu_reclaim::kMaxUnansweredRefreshes; i++) {
+        EXPECT_TRUE(policy.on_timer(now).action == Action::kRefresh) << i;
+        now += 3000;
+    }
+    Policy::Decision d = policy.on_timer(now);
+    EXPECT_TRUE(d.action == Action::kNone);
+    EXPECT_EQ(0, d.next_ms);
+    EXPECT_FALSE(policy.in_episode());
