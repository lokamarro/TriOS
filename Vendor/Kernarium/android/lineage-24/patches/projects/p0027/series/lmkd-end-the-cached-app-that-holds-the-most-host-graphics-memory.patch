+TEST(gpu_reclaim, an_answer_resets_the_count_of_unanswered_refreshes) {
+    Policy policy;
+    ASSERT_TRUE(feed(&policy, pressured(1), 1000, kCachedApp, true).action == Action::kNone);
+    int64_t now = 4000;
+    for (int round = 0; round < 3; round++) {
+        EXPECT_TRUE(policy.on_timer(now).action == Action::kRefresh);
+        now += 3000;
+        EXPECT_TRUE(policy.on_timer(now).action == Action::kRefresh);
+        now += 3000;
+        // A new snapshot arrives (the kill stays pending).
+        EXPECT_TRUE(feed(&policy, pressured(2 + round), now, kCachedApp, true).action ==
+                    Action::kNone);
+    }
+    EXPECT_TRUE(policy.in_episode());
+    EXPECT_TRUE(policy.on_timer(now).action == Action::kRefresh);
+}
