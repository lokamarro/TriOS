+TEST(gpu_reclaim, parse_survives_every_truncation_and_byte_change) {
+    const std::string sample =
+            "seq=7 age_ms=12 state=3 refused=4 budget=536870912 used=500000000 held=450000000 "
+            "armed=1\n"
+            "4242 209715200 65000 3 org.example.app\n"
+            "315 67108864 12000 1 surfaceflinger\n";
+    auto check = [](const std::string& text) {
+        Report report;
+        if (gpu_reclaim::parse_report(text.data(), text.size(), &report)) {
+            EXPECT_LE(report.holder_count, gpu_reclaim::kMaxHolders);
+            for (int i = 0; i < report.holder_count; i++) {
+                EXPECT_GT(report.holders[i].pid, 0);
+                EXPECT_LT(strlen(report.holders[i].comm), gpu_reclaim::kCommLen);
+                EXPECT_GT(strlen(report.holders[i].comm), 0u);
+            }
+        }
+    };
+    for (size_t len = 0; len <= sample.size(); len++) {
+        check(sample.substr(0, len));
+    }
+    for (size_t i = 0; i < sample.size(); i++) {
+        for (int value : {0, 10, 32, 61, 57, 120, 255}) {
+            std::string mutated = sample;
+            mutated[i] = static_cast<char>(value);
+            check(mutated);
+        }
+    }
+}
