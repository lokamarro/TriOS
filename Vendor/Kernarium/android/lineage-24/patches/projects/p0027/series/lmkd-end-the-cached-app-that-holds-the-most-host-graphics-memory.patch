+#include <string.h>
+
+#include <string>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+#include "gpu_reclaim.h"
+
+using gpu_reclaim::Holder;
+using gpu_reclaim::Policy;
+using gpu_reclaim::Report;
+
+namespace {
+
+constexpr uint64_t kMiB = 1ull << 20;
+using Action = Policy::Decision::Action;
+
+struct Proc {
+    int pid;
+    int oomadj;
+    const char* comm;
+};
+
+// The processes lmkd knows, with the adj the framework gave them.
+struct Table {
+    std::vector<Proc> procs;
+};
+
+bool lookup(const Holder& holder, int* oomadj, void* cookie) {
+    const Table* table = static_cast<const Table*>(cookie);
+    for (const Proc& proc : table->procs) {
+        if (proc.pid == holder.pid && gpu_reclaim::comm_matches(holder.comm, proc.comm)) {
+            *oomadj = proc.oomadj;
+            return true;
+        }
+    }
+    return false;
+}
+
+void add_holder(Report* report, int pid, uint64_t mib, uint64_t idle_ms, const char* comm) {
+    ASSERT_LT(report->holder_count, gpu_reclaim::kMaxHolders);
+    Holder& holder = report->holders[report->holder_count++];
+    memset(&holder, 0, sizeof(holder));
+    holder.pid = pid;
+    holder.bytes = mib * kMiB;
+    holder.idle_ms = idle_ms;
+    holder.contexts = 1;
+    strncpy(holder.comm, comm, sizeof(holder.comm) - 1);
+}
+
+Report make_report(uint64_t seq, uint32_t state) {
+    Report report;
+    memset(&report, 0, sizeof(report));
+    report.seq = seq;
+    report.state = state;
+    report.armed = true;
+    return report;
+}
+
+// A pressured snapshot with one cached app that holds 200 MiB.
+Report pressured(uint64_t seq) {
+    Report report = make_report(seq, gpu_reclaim::kStatePressure);
+    add_holder(&report, 100, 200, 60000, "cached.app");
+    return report;
+}
+
+const Table kCachedApp = {{{100, 950, "cached.app"}}};
+
+Policy::Decision feed(Policy* policy, const Report& report, int64_t now_ms, const Table& table,
+                      bool kill_pending = false) {
+    return policy->on_report(report, now_ms, kill_pending, lookup,
+                             const_cast<Table*>(&table));
+}
+
+void parse_text(const std::string& text, Report* report, bool* ok) {
+    *ok = gpu_reclaim::parse_report(text.data(), text.size(), report);
+}
+
+}  // namespace
+
+TEST(gpu_reclaim, the_limits_are_the_decided_ones) {
+    EXPECT_EQ(32u << 20, gpu_reclaim::kMinHolderBytes);
+    EXPECT_EQ(10000u, gpu_reclaim::kMinIdleMs);
+    EXPECT_EQ(3000, gpu_reclaim::kMinKillIntervalMs);
+    EXPECT_EQ(3, gpu_reclaim::kMaxKillsPerEpisode);
+    EXPECT_EQ(900, gpu_reclaim::kCachedAppMinAdj);
+    EXPECT_EQ(700, gpu_reclaim::kPreviousAppAdj);
+    EXPECT_EQ(799, gpu_reclaim::kPreviousAppMaxAdj);
+}
+
+TEST(gpu_reclaim, parse_the_documented_report) {
+    Report report;
+    bool ok;
+    parse_text(
+            "seq=7 age_ms=12 state=3 refused=4 budget=536870912 used=500000000 held=450000000 "
+            "armed=1\n"
+            "4242 209715200 65000 3 org.example.app\n"
+            "315 67108864 12000 1 surfaceflinger\n",
+            &report, &ok);
+    ASSERT_TRUE(ok);
+    EXPECT_EQ(7u, report.seq);
+    EXPECT_EQ(12u, report.age_ms);
+    EXPECT_EQ(3u, report.state);
+    EXPECT_EQ(4u, report.refused);
+    EXPECT_EQ(536870912u, report.budget);
+    EXPECT_EQ(500000000u, report.used);
+    EXPECT_EQ(450000000u, report.held);
+    EXPECT_TRUE(report.armed);
+    ASSERT_EQ(2, report.holder_count);
+    EXPECT_EQ(4242, report.holders[0].pid);
+    EXPECT_EQ(209715200u, report.holders[0].bytes);
+    EXPECT_EQ(65000u, report.holders[0].idle_ms);
+    EXPECT_EQ(3u, report.holders[0].contexts);
+    EXPECT_STREQ("org.example.app", report.holders[0].comm);
+    EXPECT_EQ(315, report.holders[1].pid);
+    EXPECT_STREQ("surfaceflinger", report.holders[1].comm);
+}
+
+TEST(gpu_reclaim, parse_a_report_without_holders) {
+    Report report;
+    bool ok;
+    parse_text("seq=1 state=0\n", &report, &ok);
+    ASSERT_TRUE(ok);
+    EXPECT_EQ(1u, report.seq);
+    EXPECT_EQ(0u, report.state);
+    EXPECT_FALSE(report.armed);
+    EXPECT_EQ(0, report.holder_count);
+}
+
+TEST(gpu_reclaim, parse_ignores_unknown_header_keys) {
+    Report report;
+    bool ok;
+    parse_text("seq=2 future=99 state=1 armed=1\n", &report, &ok);
+    ASSERT_TRUE(ok);
+    EXPECT_EQ(2u, report.seq);
+    EXPECT_EQ(1u, report.state);
+}
+
+TEST(gpu_reclaim, parse_rejects_a_bad_header) {
+    Report report;
+    bool ok;
+    parse_text("", &report, &ok);
+    EXPECT_FALSE(ok);
+    parse_text("\n\n", &report, &ok);
+    EXPECT_FALSE(ok);
+    parse_text("seq=1\n", &report, &ok);  // no state
+    EXPECT_FALSE(ok);
+    parse_text("state=1\n", &report, &ok);  // no seq
+    EXPECT_FALSE(ok);
+    parse_text("seq=x state=1\n", &report, &ok);
+    EXPECT_FALSE(ok);
+    parse_text("seq=1 state=1 armed\n", &report, &ok);  // not key=value
+    EXPECT_FALSE(ok);
+    parse_text("seq=-1 state=1\n", &report, &ok);
+    EXPECT_FALSE(ok);
+    parse_text("seq=99999999999999999999 state=1\n", &report, &ok);  // overflow
+    EXPECT_FALSE(ok);
+    parse_text("seq=1 state=4294967296\n", &report, &ok);  // does not fit
+    EXPECT_FALSE(ok);
+    parse_text("seq=1 state=1", &report, &ok);  // the line is cut: no newline
+    EXPECT_FALSE(ok);
+    parse_text("4242 209715200 65000 3 app\nseq=1 state=1\n", &report, &ok);  // header not first
+    EXPECT_FALSE(ok);
+    parse_text(std::string(300, 'a') + "\nseq=1 state=1\n", &report, &ok);  // header too long
+    EXPECT_FALSE(ok);
+}
+
+TEST(gpu_reclaim, parse_skips_bad_holder_lines) {
+    Report report;
+    bool ok;
+    parse_text(
+            "seq=3 state=1\n"
+            "0 100 100 1 pid-zero\n"
+            "-5 100 100 1 negative\n"
+            "2147483648 100 100 1 pid-too-big\n"
+            "10 100 100 1\n"                  // no name
+            "11 100 100 x name\n"             // not a number
+            "12 100 100 1 name-is-too-long-16\n"  // 16 characters
+            "13 100\n"                        // short
+            "17 100 100 1 bad\tname\n"          // a control character in the name
+            "14 100 100 4294967296 name\n"    // contexts do not fit
+            "15 100 100 1 fine\n"
+            "\n"
+            "16 100 100 1 with space \r\n",
+            &report, &ok);
+    ASSERT_TRUE(ok);
+    ASSERT_EQ(2, report.holder_count);
