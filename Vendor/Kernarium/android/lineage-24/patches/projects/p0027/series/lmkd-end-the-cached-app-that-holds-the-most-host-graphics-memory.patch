+
+#include "gpu_reclaim.h"
+
+#include <string.h>
+
+#include <algorithm>
+
+namespace gpu_reclaim {
+
+namespace {
+
+constexpr size_t kMaxLineLen = 255;
+
+bool is_space(char c) {
+    return c == ' ' || c == '\t' || c == '\r';
+}
+
+/* Parses [begin, end) as an unsigned decimal number: digits only, at least one, no overflow. */
+bool parse_u64(const char* begin, const char* end, uint64_t* out) {
+    if (begin == end) {
+        return false;
+    }
+    uint64_t value = 0;
+    for (const char* p = begin; p < end; p++) {
+        if (*p < '0' || *p > '9') {
+            return false;
+        }
+        const uint64_t digit = static_cast<uint64_t>(*p - '0');
+        if (value > (UINT64_MAX - digit) / 10) {
+            return false;
+        }
+        value = value * 10 + digit;
+    }
+    *out = value;
+    return true;
+}
+
+/* Splits the next space-separated token off [*pos, end). Returns false at the end of the line. */
+bool next_token(const char** pos, const char* end, const char** token_begin,
+                const char** token_end) {
+    const char* p = *pos;
+    while (p < end && is_space(*p)) {
+        p++;
+    }
+    if (p == end) {
+        *pos = p;
+        return false;
+    }
+    *token_begin = p;
+    while (p < end && !is_space(*p)) {
+        p++;
+    }
+    *token_end = p;
+    *pos = p;
+    return true;
+}
+
+bool parse_header(const char* begin, const char* end, Report* report) {
+    bool have_seq = false;
+    bool have_state = false;
+    const char* pos = begin;
+    const char* tb;
+    const char* te;
+
+    while (next_token(&pos, end, &tb, &te)) {
+        const char* eq = static_cast<const char*>(memchr(tb, '=', te - tb));
+        if (eq == nullptr) {
+            return false;
+        }
+        const char* key = tb;
+        const size_t key_len = eq - tb;
+        uint64_t value;
+        if (!parse_u64(eq + 1, te, &value)) {
+            return false;
+        }
+        auto is_key = [&](const char* name) {
+            return strlen(name) == key_len && memcmp(key, name, key_len) == 0;
+        };
+        if (is_key("seq")) {
+            report->seq = value;
+            have_seq = true;
+        } else if (is_key("age_ms")) {
+            report->age_ms = value;
+        } else if (is_key("state")) {
+            if (value > UINT32_MAX) {
+                return false;
+            }
+            report->state = static_cast<uint32_t>(value);
+            have_state = true;
+        } else if (is_key("refused")) {
+            report->refused = value;
+        } else if (is_key("budget")) {
+            report->budget = value;
+        } else if (is_key("used")) {
+            report->used = value;
+        } else if (is_key("held")) {
+            report->held = value;
+        } else if (is_key("armed")) {
+            report->armed = value != 0;
+        }
+        // Other keys belong to a later version of the driver.
+    }
+    return have_seq && have_state;
+}
+
+/* "<pid> <bytes> <idle_ms> <contexts> <comm>"; the name runs to the end of the line. */
+bool parse_holder(const char* begin, const char* end, Holder* holder) {
+    const char* pos = begin;
+    const char* tb;
+    const char* te;
+    uint64_t number[4];
+
+    for (int i = 0; i < 4; i++) {
+        if (!next_token(&pos, end, &tb, &te) || !parse_u64(tb, te, &number[i])) {
+            return false;
+        }
+    }
+    if (number[0] == 0 || number[0] > INT32_MAX || number[3] > UINT32_MAX) {
+        return false;
+    }
+    while (pos < end && is_space(*pos)) {
+        pos++;
+    }
+    const char* comm_end = end;
+    while (comm_end > pos && is_space(comm_end[-1])) {
+        comm_end--;
+    }
+    const size_t comm_len = comm_end - pos;
+    if (comm_len == 0 || comm_len >= kCommLen) {
+        return false;
+    }
+    for (const char* p = pos; p < comm_end; p++) {
+        // A name has no control characters; a NUL would also cut it short.
+        if (static_cast<unsigned char>(*p) < 0x20 || *p == 0x7f) {
+            return false;
+        }
+    }
+    holder->pid = static_cast<int32_t>(number[0]);
+    holder->bytes = number[1];
+    holder->idle_ms = number[2];
+    holder->contexts = static_cast<uint32_t>(number[3]);
+    memcpy(holder->comm, pos, comm_len);
+    holder->comm[comm_len] = '\0';
+    return true;
+}
+
+}  // namespace
+
+bool parse_report(const char* text, size_t len, Report* report) {
+    memset(report, 0, sizeof(*report));
+
+    const char* pos = text;
+    const char* const end = text + len;
+    bool have_header = false;
+
+    while (pos < end) {
+        const char* nl = static_cast<const char*>(memchr(pos, '\n', end - pos));
+        if (nl == nullptr) {
+            // The text ends in the middle of a line (a file cut at the page size): drop it.
+            break;
+        }
+        const char* line_begin = pos;
+        const char* line_end = nl;
+        pos = nl + 1;
+        if (static_cast<size_t>(line_end - line_begin) > kMaxLineLen) {
+            if (!have_header) {
+                return false;
+            }
+            continue;
+        }
+        const char* p = line_begin;
+        while (p < line_end && is_space(*p)) {
+            p++;
+        }
+        if (p == line_end) {
+            continue;  // blank
+        }
+        if (!have_header) {
+            if (!parse_header(line_begin, line_end, report)) {
+                return false;
+            }
+            have_header = true;
+            continue;
+        }
+        if (report->holder_count >= kMaxHolders) {
+            break;
+        }
+        if (parse_holder(line_begin, line_end, &report->holders[report->holder_count])) {
+            report->holder_count++;
+        }
+    }
+    return have_header;
+}
+
+bool comm_matches(const char* holder_comm, const char* proc_comm) {
+    if (holder_comm == nullptr || proc_comm == nullptr || holder_comm[0] == '\0') {
+        return false;
+    }
+    // The kernel keeps 15 characters of a name; compare no more than that of either.
+    return strncmp(holder_comm, proc_comm, kCommLen - 1) == 0;
+}
+
+int choose_victim(const Report& report, ProcLookup lookup, void* cookie, int* band_adj) {
+    int best_cached = -1;
+    int best_previous = -1;
+
+    for (int i = 0; i < report.holder_count && i < kMaxHolders; i++) {
+        const Holder& holder = report.holders[i];
+        if (holder.bytes < kMinHolderBytes || holder.idle_ms < kMinIdleMs) {
+            continue;
+        }
+        int oomadj;
+        if (!lookup(holder, &oomadj, cookie)) {
+            continue;
+        }
+        if (oomadj >= kCachedAppMinAdj) {
+            if (best_cached < 0 || holder.bytes > report.holders[best_cached].bytes) {
+                best_cached = i;
+            }
+        } else if (oomadj >= kPreviousAppAdj && oomadj <= kPreviousAppMaxAdj) {
+            if (best_previous < 0 || holder.bytes > report.holders[best_previous].bytes) {
+                best_previous = i;
+            }
+        }
+    }
+
+    if (best_cached >= 0) {
+        *band_adj = kCachedAppMinAdj;
+        return best_cached;
+    }
+    if (best_previous >= 0) {
+        *band_adj = kPreviousAppAdj;
+        return best_previous;
+    }
+    return -1;
+}
+
+Policy::Decision Policy::none(int64_t next_ms, const char* note) const {
+    return Decision{Decision::Action::kNone, -1, 0, next_ms, note};
+}
+
+void Policy::end_episode() {
+    episode_ = false;
+    kills_ = 0;
+    unanswered_ = 0;
+    next_pass_ms_ = 0;
+}
+
+Policy::Decision Policy::on_report(const Report& report, int64_t now_ms, bool kill_pending,
+                                   ProcLookup lookup, void* cookie) {
+    // Nothing has been sent yet.
+    if (report.seq == 0) {
+        return none(episode_ ? kRefreshIntervalMs : 0, "no snapshot yet");
+    }
+
+    if (!have_seq_ || report.seq != last_seq_) {
+        unanswered_ = 0;
+        last_seq_ = report.seq;
+        have_seq_ = true;
+    }
+
+    // A refusal is an event of its own: the report says so with the state bit, and the counter
+    // moves. The first counter seen is only a baseline.
+    const bool refusal = (report.state & kStateRefused) != 0 ||
+                         (have_refused_ && report.refused > refused_seen_);
+    refused_seen_ = report.refused;
+    have_refused_ = true;
+
+    const bool pressure = (report.state & kStatePressure) != 0 || refusal;
+    if (!pressure) {
+        end_episode();
+        return none(0, "calm");
+    }
+    if (!episode_) {
+        episode_ = true;
+        kills_ = 0;
+        unanswered_ = 0;
+        next_pass_ms_ = 0;
+    }
+
+    if (kills_ >= kMaxKillsPerEpisode) {
+        return none(0, "kill limit of the episode reached");
+    }
+    if (kill_pending) {
+        return none(kRefreshIntervalMs, "a kill is pending");
+    }
+    if (report.age_ms > kMaxSnapshotAgeMs) {
+        return none(kRefreshIntervalMs, "snapshot is stale");
+    }
+    if (have_kill_ && report.seq <= last_kill_seq_) {
+        return none(kRefreshIntervalMs, "snapshot is not newer than the last kill");
+    }
+    if (have_kill_ && now_ms - last_kill_ms_ < kMinKillIntervalMs) {
+        return none(std::max<int64_t>(last_kill_ms_ + kMinKillIntervalMs - now_ms, 1),
+                    "last kill is too recent");
+    }
+    if (now_ms < next_pass_ms_) {
+        return none(next_pass_ms_ - now_ms, "backing off after a pass without a victim");
+    }
+
+    int band_adj = 0;
+    const int index = choose_victim(report, lookup, cookie, &band_adj);
+    if (index < 0) {
+        next_pass_ms_ = now_ms + kEmptyPassBackoffMs;
+        return none(kEmptyPassBackoffMs, "no cached holder qualifies");
+    }
+    return Decision{Decision::Action::kKill, index, band_adj, kMinKillIntervalMs, "kill"};
+}
+
+int64_t Policy::on_kill_result(int64_t now_ms, uint64_t seq, bool killed) {
+    if (!killed) {
+        // The process was gone or could not be ended; its record is dropped, so the next pass
+        // sees the next holder, after the same wait as a kill.
+        next_pass_ms_ = now_ms + kMinKillIntervalMs;
+        return kMinKillIntervalMs;
+    }
+    kills_++;
+    have_kill_ = true;
+    last_kill_ms_ = now_ms;
+    last_kill_seq_ = seq;
+    next_pass_ms_ = 0;
+    // A little past the interval, so the timer does not fire a tick early on a coarse clock.
+    return kills_ >= kMaxKillsPerEpisode ? 0 : kMinKillIntervalMs + 50;
+}
+
+Policy::Decision Policy::on_timer(int64_t now_ms) {
+    if (!episode_ || kills_ >= kMaxKillsPerEpisode) {
+        return none(0, "no episode");
+    }
+    if (have_kill_ && now_ms - last_kill_ms_ < kMinKillIntervalMs) {
+        return none(std::max<int64_t>(last_kill_ms_ + kMinKillIntervalMs - now_ms, 1),
+                    "last kill is too recent");
+    }
+    if (now_ms < next_pass_ms_) {
+        return none(next_pass_ms_ - now_ms, "backing off after a pass without a victim");
+    }
+    if (unanswered_ >= kMaxUnansweredRefreshes) {
+        end_episode();
+        return none(0, "the host does not answer");
+    }
+    unanswered_++;
+    return Decision{Decision::Action::kRefresh, -1, 0, kRefreshIntervalMs, "refresh"};
+}
+
+}  // namespace gpu_reclaim
