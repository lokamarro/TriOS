+/*
+ * GPU-aware reclaim (see gpu_reclaim.h). The guest's virtio-gpu driver keeps the host's last report
+ * of graphics memory pressure in a sysfs file and notifies the file when a new report arrives.
+ * While the host is under pressure, lmkd ends the cached app that holds the most of that memory,
+ * through the same path as every other kill. It is off unless ro.lmk.gpu_reclaim is set, and it
+ * stays off when the file does not exist: a kernel or a host without the report.
+ */
+#define GPU_REPORT_PATH "/sys/class/drm/card0/gpu_memory_report"
+#define GPU_REPORT_BUF_SIZE 4096
+
+static int gpu_report_fd = -1;
+static int gpu_timer_fd = -1;
+static gpu_reclaim::Policy gpu_policy;
+
+static int64_t gpu_now_ms(struct timespec* tm) {
+    clock_gettime(CLOCK_MONOTONIC_COARSE, tm);
+    return (int64_t)tm->tv_sec * 1000 + tm->tv_nsec / 1000000;
+}
+
+/* (Re)starts the episode timer to fire once in ms milliseconds; 0 stops it. */
+static void gpu_set_timer(int64_t ms) {
+    struct itimerspec its = {};
+
+    if (ms > 0) {
+        its.it_value.tv_sec = ms / 1000;
+        its.it_value.tv_nsec = (ms % 1000) * 1000000;
+    }
+    if (timerfd_settime(gpu_timer_fd, 0, &its, NULL) < 0) {
+        ALOGE("timerfd_settime for GPU reclaim failed; errno=%d", errno);
+    }
+}
+
+/* The name the kernel has for a process: /proc/<pid>/comm without its newline. */
+static bool read_proc_comm(int pid, char* buf, size_t buf_sz) {
+    char path[PROCFS_PATH_MAX];
+    ssize_t size;
+    int fd;
+
+    snprintf(path, PROCFS_PATH_MAX, "/proc/%d/comm", pid);
+    fd = TEMP_FAILURE_RETRY(open(path, O_RDONLY | O_CLOEXEC));
+    if (fd < 0) {
+        return false;
+    }
+    size = read_all(fd, buf, buf_sz - 1);
+    close(fd);
+    if (size <= 0) {
+        return false;
+    }
+    buf[size] = '\0';
+    char* newline = strchr(buf, '\n');
+    if (newline) {
+        *newline = '\0';
+    }
+    return buf[0] != '\0';
+}
+
+/*
+ * A holder is a candidate when the activity manager registered its process with lmkd, and the
+ * process under that pid still has the name the host gave for it. The name check keeps a pid that
+ * was reused since the host's report from naming another process.
+ */
+static bool gpu_proc_lookup(const gpu_reclaim::Holder& holder, int* oomadj, void*) {
+    struct proc* procp = pid_lookup(holder.pid);
+    char comm[32];
+
+    if (!procp || !procp->valid) {
+        return false;
+    }
+    if (!read_proc_comm(holder.pid, comm, sizeof(comm)) ||
+        !gpu_reclaim::comm_matches(holder.comm, comm)) {
+        return false;
+    }
+    *oomadj = procp->oomadj;
+    return true;
+}
+
+static bool read_gpu_report(gpu_reclaim::Report* report) {
+    static bool bad_report_logged = false;
+    char buf[GPU_REPORT_BUF_SIZE];
+
+    // One read of the whole file: its text is one snapshot, made when it is read.
+    ssize_t size = TEMP_FAILURE_RETRY(pread(gpu_report_fd, buf, sizeof(buf) - 1, 0));
+    if (size < 0) {
+        if (!bad_report_logged) {
+            bad_report_logged = true;
+            ALOGW("GPU reclaim: reading %s failed; errno=%d", GPU_REPORT_PATH, errno);
+        }
+        return false;
+    }
+    if (size == 0) {
+        // Nothing yet.
+        return false;
+    }
+    if (!gpu_reclaim::parse_report(buf, size, report)) {
+        if (!bad_report_logged) {
+            bad_report_logged = true;
+            ALOGW("GPU reclaim: %s is not a report this lmkd understands", GPU_REPORT_PATH);
+        }
+        return false;
+    }
+    return true;
+}
+
+/* Ends the holder the policy chose. Returns when the episode timer should fire next. */
+static int64_t gpu_kill(const gpu_reclaim::Report& report,
+                        const gpu_reclaim::Policy::Decision& decision, struct timespec* curr_tm,
+                        int64_t now_ms) {
+    const gpu_reclaim::Holder& holder = report.holders[decision.holder];
+    struct proc* procp = pid_lookup(holder.pid);
+    union meminfo mi;
+    struct kill_info ki = {
+            .kill_reason = VENDOR_KILL_REASON_BASE,
+            .kill_desc = "graphics memory pressure",
+            .thrashing = 0,
+            .max_thrashing = 0,
+    };
+
+    if (!procp) {
+        return gpu_policy.on_kill_result(now_ms, report.seq, false);
+    }
+    // kill_one_process reports the free memory; a failed parse leaves the fields zero.
+    meminfo_parse(&mi);
+    ALOGI("GPU reclaim: ending '%s' (%d), oom_score_adj %d: it holds %" PRIu64
+          "kB of host graphics memory and has been idle for %" PRIu64 "ms",
+          holder.comm, holder.pid, procp->oomadj, holder.bytes / 1024, holder.idle_ms);
+    int result = kill_one_process(procp, decision.band_adj, &ki, &mi, NULL, curr_tm, NULL);
+    return gpu_policy.on_kill_result(now_ms, report.seq, result >= 0);
+}
+
+static void gpu_log_episode(bool was_in_episode, const gpu_reclaim::Report* report) {
+    if (!was_in_episode && gpu_policy.in_episode()) {
+        ALOGI("GPU reclaim: the host reports graphics memory pressure (state %u, %" PRIu64
+              " of %" PRIu64 "kB used)",
+              report ? report->state : 0, report ? report->used / 1024 : 0,
+              report ? report->budget / 1024 : 0);
+    } else if (was_in_episode && !gpu_policy.in_episode()) {
+        ALOGI("GPU reclaim: the graphics memory pressure is over");
+    }
+}
+
+/* A new report: decide, and end the cached holder when it is time. */
+static void gpu_report_handler(int data __unused, uint32_t events __unused,
+                               struct polling_params* poll_params __unused) {
+    gpu_reclaim::Report report;
+    struct timespec curr_tm;
+
+    if (!read_gpu_report(&report)) {
+        return;
+    }
+    bool was_in_episode = gpu_policy.in_episode();
+    int64_t now_ms = gpu_now_ms(&curr_tm);
+    gpu_reclaim::Policy::Decision decision =
+            gpu_policy.on_report(report, now_ms, is_kill_pending(), gpu_proc_lookup, NULL);
+    int64_t next_ms = decision.next_ms;
+
+    if (decision.action == gpu_reclaim::Policy::Decision::Action::kKill) {
+        next_ms = gpu_kill(report, decision, &curr_tm, now_ms);
+    } else if (debug_process_killing && decision.note) {
+        ALOGI("GPU reclaim: no kill: %s", decision.note);
+    }
+    gpu_log_episode(was_in_episode, &report);
+    gpu_set_timer(next_ms);
+}
+
+/* The episode timer: while the pressure lasts, ask the driver for a new report. */
+static void gpu_timer_handler(int data __unused, uint32_t events __unused,
+                              struct polling_params* poll_params __unused) {
+    static const char refresh[] = "refresh";
+    static bool refresh_failure_logged = false;
+    struct timespec curr_tm;
+    uint64_t expirations;
+
+    if (TEMP_FAILURE_RETRY(read(gpu_timer_fd, &expirations, sizeof(expirations))) !=
+        (ssize_t)sizeof(expirations)) {
+        return;
+    }
+    bool was_in_episode = gpu_policy.in_episode();
+    gpu_reclaim::Policy::Decision decision = gpu_policy.on_timer(gpu_now_ms(&curr_tm));
+
+    if (decision.action == gpu_reclaim::Policy::Decision::Action::kRefresh) {
+        if (TEMP_FAILURE_RETRY(write(gpu_report_fd, refresh, sizeof(refresh) - 1)) !=
+                    (ssize_t)(sizeof(refresh) - 1) &&
+            !refresh_failure_logged) {
+            // The count of unanswered refreshes ends the episode.
+            refresh_failure_logged = true;
+            ALOGW("GPU reclaim: asking %s for a new report failed; errno=%d", GPU_REPORT_PATH,
+                  errno);
+        }
+    } else if (debug_process_killing && decision.note) {
+        ALOGI("GPU reclaim: %s", decision.note);
+    }
+    gpu_log_episode(was_in_episode, NULL);
+    gpu_set_timer(decision.next_ms);
+}
+
+static void init_gpu_reclaim() {
+    static struct event_handler_info report_hinfo = {0, gpu_report_handler};
+    static struct event_handler_info timer_hinfo = {0, gpu_timer_handler};
+    struct epoll_event epev;
+    char arm[64];
+    int report_fd;
+    int timer_fd;
+
+    if (!gpu_reclaim_enabled) {
+        return;
+    }
+    if (use_inkernel_interface) {
+        // The in-kernel killer keeps no table of processes to choose from.
+        ALOGI("GPU reclaim needs the userspace killer; it stays off");
+        return;
+    }
+
+    report_fd = TEMP_FAILURE_RETRY(open(GPU_REPORT_PATH, O_RDWR | O_CLOEXEC | O_NONBLOCK));
+    if (report_fd < 0) {
+        if (errno == ENOENT) {
+            // A kernel or a host without the report is not an error.
+            ALOGI("GPU reclaim is enabled but %s does not exist; it stays off", GPU_REPORT_PATH);
+        } else {
+            ALOGW("GPU reclaim: cannot open %s; errno=%d; it stays off", GPU_REPORT_PATH, errno);
+        }
+        return;
+    }
+
+    // Ask the host for reports of the holders worth ending.
+    snprintf(arm, sizeof(arm), "arm %" PRIu64 " %" PRIu64, gpu_reclaim::kMinHolderBytes,
+             gpu_reclaim::kMinIdleMs);
+    ssize_t arm_len = strlen(arm);
+    if (TEMP_FAILURE_RETRY(write(report_fd, arm, arm_len)) != arm_len) {
+        ALOGW("GPU reclaim: %s did not take \"%s\"; errno=%d; it stays off", GPU_REPORT_PATH, arm,
+              errno);
+        close(report_fd);
+        return;
+    }
+
+    timer_fd = timerfd_create(CLOCK_MONOTONIC, TFD_CLOEXEC | TFD_NONBLOCK);
+    if (timer_fd < 0) {
+        ALOGE("timerfd_create for GPU reclaim failed; errno=%d; it stays off", errno);
+        close(report_fd);
+        return;
+    }
+    epev.events = EPOLLIN;
+    epev.data.ptr = (void*)&timer_hinfo;
+    if (epoll_ctl(epollfd, EPOLL_CTL_ADD, timer_fd, &epev) != 0) {
+        ALOGE("epoll_ctl for the GPU reclaim timer failed; errno=%d; it stays off", errno);
+        close(timer_fd);
+        close(report_fd);
+        return;
+    }
+
+    gpu_report_fd = report_fd;
+    gpu_timer_fd = timer_fd;
+    // Read what the file holds now. That also clears its pending change, so that the poll below
+    // reports only reports that arrive later.
+    gpu_report_handler(0, 0, NULL);
+
+    epev.events = EPOLLPRI | EPOLLERR;
+    epev.data.ptr = (void*)&report_hinfo;
+    if (epoll_ctl(epollfd, EPOLL_CTL_ADD, report_fd, &epev) != 0) {
+        ALOGE("epoll_ctl for %s failed; errno=%d; GPU reclaim stays off", GPU_REPORT_PATH, errno);
+        epoll_ctl(epollfd, EPOLL_CTL_DEL, timer_fd, &epev);
+        gpu_report_fd = -1;
+        gpu_timer_fd = -1;
+        close(timer_fd);
+        close(report_fd);
+        return;
+    }
+    maxevents += 2;
+    ALOGI("GPU reclaim is on: ending cached apps that hold at least %" PRIu64
+          "kB of host graphics memory under pressure",
+          gpu_reclaim::kMinHolderBytes / 1024);
+}
