+TEST(gpu_reclaim, at_most_one_kill_in_three_seconds) {
+    Policy policy;
+    Table table = {{{100, 950, "cached.app"}, {101, 950, "second.app"}}};
+    Report first = pressured(1);
+    add_holder(&first, 101, 100, 60000, "second.app");
+    ASSERT_TRUE(feed(&policy, first, 10000, table).action == Action::kKill);
+    policy.on_kill_result(10000, 1, true);
+
+    Report next = pressured(2);
+    add_holder(&next, 101, 100, 60000, "second.app");
+    next.holders[0].pid = 101;  // the first holder is gone: only the second remains
+    strncpy(next.holders[0].comm, "second.app", sizeof(next.holders[0].comm) - 1);
+    next.holder_count = 1;
+    Policy::Decision d = feed(&policy, next, 12999, table);
+    EXPECT_TRUE(d.action == Action::kNone);
+    EXPECT_EQ(1, d.next_ms);
+    d = feed(&policy, next, 11000, table);
+    EXPECT_TRUE(d.action == Action::kNone);
+    EXPECT_EQ(2000, d.next_ms);
+    d = feed(&policy, next, 13000, table);
+    EXPECT_TRUE(d.action == Action::kKill);
+}
