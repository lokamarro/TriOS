+    EXPECT_TRUE(gpu_reclaim::comm_matches("123456789012345", "123456789012345678"));
+    EXPECT_FALSE(gpu_reclaim::comm_matches("", ""));
+    EXPECT_FALSE(gpu_reclaim::comm_matches(nullptr, "a"));
