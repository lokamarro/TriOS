From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 25 Oct 2026 13:43:45 +0000
Subject: [PATCH] sepolicy: Drop the SD card grants and the permissive
 backuptool

Android's neverallow tests refuse three things this policy grants:

- vold relabeling a filesystem to sdcard_posix (relabelto), which only an
  ext4 or F2FS external SD card mounted with a context needs;
- fsck_untrusted holding sys_admin, which only checking such a card
  needs;
- a permissive domain on userdebug builds, which backuptool, the addon.d
  step of an OTA, is.

A product without a removable card and without addon.d updates needs
none of them. Remove the grants (and the file that holds only one) and
let backuptool follow the policy.
---
 common/private/backuptool.te     | 4 ----
 common/private/fsck_untrusted.te | 2 --
 common/private/vold.te           | 4 ----
 3 files changed, 10 deletions(-)
 delete mode 100644 common/private/fsck_untrusted.te

diff --git a/common/private/backuptool.te b/common/private/backuptool.te
index b948b613499f45cc82c97a07113046ece3306c0d..6e79e6153637f73b5804d078e2c24643d28387fa 100644
--- a/common/private/backuptool.te
+++ b/common/private/backuptool.te
@@ -5,7 +5,3 @@ neverallow {
     -recovery
     -update_engine
 } backuptool:process transition;
-
-userdebug_or_eng(`
-    permissive backuptool;
-')
diff --git a/common/private/fsck_untrusted.te b/common/private/fsck_untrusted.te
deleted file mode 100644
index 5d12f768b015aee8d8909cfe14e76d445b897a2f..0000000000000000000000000000000000000000
--- a/common/private/fsck_untrusted.te
+++ /dev/null
@@ -1,2 +0,0 @@
-# External storage
-allow fsck_untrusted self:capability sys_admin;
diff --git a/common/private/vold.te b/common/private/vold.te
index 915190b9d61bb68860106405e15452a6d33fe91a..6668157c843ff591251aeee89eb8e2dab779098f 100644
--- a/common/private/vold.te
+++ b/common/private/vold.te
@@ -5,7 +5,3 @@ allow vold self:capability { setgid setuid };
 allow vold mkfs_exec:file rx_file_perms;
 allow vold mnt_media_rw_stub_file:dir r_dir_perms;
 allow vold storage_stub_file:dir rw_dir_perms;
-
-# External EXT4/F2FS storage
-allow vold sdcard_posix:filesystem { relabelto relabelfrom };
-allow vold labeledfs:filesystem relabelfrom;
