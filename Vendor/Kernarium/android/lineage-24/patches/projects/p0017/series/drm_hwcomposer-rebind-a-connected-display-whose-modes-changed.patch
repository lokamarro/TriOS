From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 18 Oct 2026 04:02:57 +0000
Subject: [PATCH] drm_hwcomposer: rebind a connected display whose modes
 changed

A virtual display stays connected when its host window is resized, so the
connector gains a new mode list while its pipeline stays attached.
UpdateFrontendDisplays refreshed the connector but told the frontend only
about connects and disconnects, so SurfaceFlinger kept the modes the
display had when it was bound and never followed the new size.

Compare the connector's raw mode list before and after UpdateModes. When a
display that stays connected and attached has a different list, unbind
and bind its pipeline again. DrmHwc defers hotplug events per display
handle, so the two coalesce into one CONNECTED event: the client reloads
the display's modes with no headless step between.
---
 drm/ResourceManager.cpp | 40 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/drm/ResourceManager.cpp b/drm/ResourceManager.cpp
index defec12b832cc8e0fd9dec070e74d03796912995..a528f576cb6851f212bdcadb4be612678396c1b0 100644
--- a/drm/ResourceManager.cpp
+++ b/drm/ResourceManager.cpp
@@ -27,12 +27,37 @@
 #include "drm/DrmConnector.h"
 #include "drm/DrmDevice.h"
 #include "drm/DrmDisplayPipeline.h"
+#include "drm/DrmMode.h"
 #include "drm/UEventListener.h"
 #include "utils/log.h"
 #include "utils/properties.h"
 
 namespace android::drm_hwcomposer {
 
+namespace {
+
+auto ModeList(const DrmConnector &conn) -> std::vector<drmModeModeInfo> {
+  std::vector<drmModeModeInfo> modes;
+  modes.reserve(conn.GetModes().size());
+  for (const auto &mode : conn.GetModes())
+    modes.emplace_back(mode.GetRawMode());
+  return modes;
+}
+
+auto SameModes(const std::vector<drmModeModeInfo> &modes,
+               const DrmConnector &conn) -> bool {
+  const auto &current = conn.GetModes();
+  if (current.size() != modes.size())
+    return false;
+  for (size_t i = 0; i < modes.size(); i++) {
+    if (!(current[i] == modes[i]))
+      return false;
+  }
+  return true;
+}
+
+}  // namespace
+
 ResourceManager::ResourceManager(
     PipelineToFrontendBindingInterface *p2f_bind_interface)
     : frontend_interface_(p2f_bind_interface) {
@@ -148,10 +173,25 @@ void ResourceManager::UpdateFrontendDisplays() {
   auto ordered_connectors = GetOrderedConnectors();
 
   for (auto *conn : ordered_connectors) {
+    const auto previous_modes = ModeList(*conn);
     conn->UpdateModes();
     auto connected = conn->IsConnected();
     auto attached = attached_pipelines_.count(conn) != 0;
 
+    if (connected && attached && !SameModes(previous_modes, *conn)) {
+      /* The mode list of a connected display changed, as a virtual display's
+       * does when its host window is resized. Rebinding rebuilds the
+       * display's configs under new IDs. The unbind and the bind each
+       * schedule a hotplug event for the same display, which coalesce, so
+       * the client sees one CONNECTED event and reloads the display's modes
+       * without a headless step in between. */
+      ALOGI("Modes changed on connector %s, rebinding its pipeline",
+            conn->GetName().c_str());
+      auto pipeline = attached_pipelines_[conn];
+      frontend_interface_->UnbindDisplay(pipeline);
+      frontend_interface_->BindDisplay(pipeline);
+    }
+
     if (connected != attached) {
       ALOGI("%s connector %s", connected ? "Attaching" : "Detaching",
             conn->GetName().c_str());
