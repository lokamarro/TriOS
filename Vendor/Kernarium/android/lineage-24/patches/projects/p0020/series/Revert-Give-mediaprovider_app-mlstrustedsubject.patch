From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 25 Oct 2026 13:43:08 +0000
Subject: [PATCH] Revert "Give mediaprovider_app mlstrustedsubject"

This reverts commit dee5e6dc2de4729ac685e59294b9332179565cc8.

The change lets mediaprovider_app write an ext4 external SD card and use
its own app data under mlstrustedsubject. Android's neverallow tests
(SELinuxNeverallowRulesTest) refuse a core app domain that is an
mlstrustedsubject: it may not fork, and it may not touch
privapp_data_file beyond reading and writing. A product without an SD
card has no use for the change, and AOSP's MediaProvider module is a
plain app domain that reaches its own privapp_data_file data through
the ordinary app rules.
---
 private/app_neverallows.te   | 2 +-
 private/mediaprovider_app.te | 5 +----
 private/mlstrustedsubject.te | 3 ---
 3 files changed, 2 insertions(+), 8 deletions(-)

diff --git a/private/app_neverallows.te b/private/app_neverallows.te
index f9f2bbef3941091cfd6401d7d3f649a4b1e6aca4..f45c17d8bc0c7dc4b8e1909c207522369f6bebe8 100644
--- a/private/app_neverallows.te
+++ b/private/app_neverallows.te
@@ -104,7 +104,7 @@ neverallow {
 # permission only makes sense within a domain (hence should
 # never be granted to any other domain within mlstrustedsubject)
 # and an untrusted app is allowed fork permission to itself.
-neverallow { all_untrusted_apps -mediaprovider_app } mlstrustedsubject:process fork;
+neverallow all_untrusted_apps mlstrustedsubject:process fork;
 
 # Do not allow untrusted apps to hard link to any files.
 # In particular, if an untrusted app links to other app data
diff --git a/private/mediaprovider_app.te b/private/mediaprovider_app.te
index dbe513ba92ecad37722ec0bacdb77013762ab479..46e0529e35ab9a5d3767de14b24d3fbce0a0bd6b 100644
--- a/private/mediaprovider_app.te
+++ b/private/mediaprovider_app.te
@@ -1,7 +1,7 @@
 ###
 ### A domain for further sandboxing the MediaProvider mainline module.
 ###
-type mediaprovider_app, domain, coredomain, bpfdomain, mlstrustedsubject;
+type mediaprovider_app, domain, coredomain, bpfdomain;
 
 app_domain(mediaprovider_app)
 
@@ -79,6 +79,3 @@ allow mediaprovider_app bootanim_oem_file:file r_file_perms;
 
 # allow mediaprovider to use fds passed by other domains, for FUSE passthrough
 allow mediaprovider_app domain:fd use;
-
-allow mediaprovider_app privapp_data_file:dir create_dir_perms;
-allow mediaprovider_app privapp_data_file:file create_file_perms;
diff --git a/private/mlstrustedsubject.te b/private/mlstrustedsubject.te
index 0a40afd94c9198ab7ff429ac92324fa0020a971f..8fcc1d4038aa59827257b9d161f10c09c5890bd2 100644
--- a/private/mlstrustedsubject.te
+++ b/private/mlstrustedsubject.te
@@ -8,7 +8,6 @@ neverallow {
   mlstrustedsubject
   -artd # compile secondary dex files
   -installd
-  -mediaprovider_app
 } {
   app_data_file
   privapp_data_file
@@ -19,7 +18,6 @@ neverallow {
   mlstrustedsubject
   -artd # compile secondary dex files
   -installd
-  -mediaprovider_app
 } {
   app_data_file
   privapp_data_file
@@ -40,7 +38,6 @@ neverallow {
   mlstrustedsubject
   -artd # compile secondary dex files
   -installd
-  -mediaprovider_app
   -system_server
   -adbd
   -runas
