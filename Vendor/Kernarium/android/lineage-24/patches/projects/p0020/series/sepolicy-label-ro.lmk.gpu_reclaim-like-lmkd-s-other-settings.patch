From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 8 Nov 2026 11:04:41 +0000
Subject: [PATCH] sepolicy: label ro.lmk.gpu_reclaim like lmkd's other settings

lmkd's GPU-aware reclaim reads ro.lmk.gpu_reclaim, which the product
sets. The platform's property_contexts list every ro.lmk.* setting by
name as an lmkd_config_prop, which core domains may read and only init
and vendor_init may set. Listing the new setting gives it that label.
---
 private/property_contexts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/private/property_contexts b/private/property_contexts
index 38f3fea1e83db3634cdb174eb6c5f6339a660b0e..506a9f69860847ff112e7d2e4ee30d878e2d1bbc 100644
--- a/private/property_contexts
+++ b/private/property_contexts
@@ -895,6 +895,7 @@ ro.lmk.debug                    u:object_r:lmkd_config_prop:s0 exact bool
 ro.lmk.delay_monitors_until_boot u:object_r:lmkd_config_prop:s0 exact bool
 ro.lmk.downgrade_pressure       u:object_r:lmkd_config_prop:s0 exact int
 ro.lmk.filecache_min_kb         u:object_r:lmkd_config_prop:s0 exact int
+ro.lmk.gpu_reclaim              u:object_r:lmkd_config_prop:s0 exact bool
 ro.lmk.kill_heaviest_task       u:object_r:lmkd_config_prop:s0 exact bool
 ro.lmk.kill_timeout_ms          u:object_r:lmkd_config_prop:s0 exact int
 ro.lmk.log_stats                u:object_r:lmkd_config_prop:s0 exact bool
