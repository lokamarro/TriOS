From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 21 Aug 2026 03:10:32 +0000
Subject: [PATCH] cuttlefish omit unsupported UML HALs

Let a product leave out Cuttlefish HALs and services that need hardware or
host services a Darwin UML machine does not have: sensors and neural
networks (LOCAL_ENABLE_SENSORS, LOCAL_ENABLE_NEURALNETWORKS), NFC
(LOCAL_ENABLE_NFC), factory reset protection storage (LOCAL_ENABLE_FRP),
identity credential, reboot escrow, the legacy VNDK snapshots and the AVF
virtualization APEX (UML_ANDROID_DISABLE_IDENTITY,
UML_ANDROID_DISABLE_REBOOT_ESCROW, UML_ANDROID_DISABLE_LEGACY_VNDK,
UML_ANDROID_DISABLE_AVF).

Cuttlefish NFC opens /dev/hvc12, which does not exist there, so the service
exits immediately and init restarts it forever. Every restart trips
"process with updatable components ... exited 4 times before boot
completed", which resets server-configurable flags, and the churn starves
the guest.

The fixed UBD partition table has no frp partition. With ro.frp.pst set,
PersistentDataBlockService waits for a block device that never appears and
throws during boot phase 500, killing system_server roughly every 80 seconds.
SystemServer starts that service only when the property is non-empty, so
leaving it unset is the supported description of a device without factory
reset protection.

The audio policy configuration also stops including the Bluetooth LE audio
fragment. Without the Bluetooth HAL that fragment is not installed, and the
failed XInclude invalidates the whole document: the audio HAL parses no
modules, never registers IModule/default, and system_server blocks in
AudioService.<init> until the watchdog kills it.
---
 .../audio/policy/audio_policy_configuration.xml    |  2 --
 shared/desktop/common.mk                           |  4 +++-
 shared/device.mk                                   |  3 +++
 shared/phone/device_vendor.mk                      | 14 +++++++++++++-
 shared/sensors/device_vendor.mk                    |  5 +++++
 vsoc_arm64_pgagnostic/phone/aosp_cf.mk             |  4 +++-
 6 files changed, 27 insertions(+), 5 deletions(-)

diff --git a/shared/config/audio/policy/audio_policy_configuration.xml b/shared/config/audio/policy/audio_policy_configuration.xml
index 3c07e675c8e1264d8b76e505dd3c39d0331a747f..07e3716c418535e4ad04ffc8efabed9ac27bc59c 100644
--- a/shared/config/audio/policy/audio_policy_configuration.xml
+++ b/shared/config/audio/policy/audio_policy_configuration.xml
@@ -27,8 +27,6 @@
         <!-- Remote Submix Audio HAL -->
         <xi:include href="r_submix_audio_policy_configuration.xml"/>
 
-        <!-- Bluetooth Audio HAL -->
-        <xi:include href="bluetooth_with_le_audio_policy_configuration_7_0.xml"/>
     </modules>
     <!-- End of Modules section -->
 
diff --git a/shared/desktop/common.mk b/shared/desktop/common.mk
index 8cb4085e2eb1d07c9641358a7af013f1d209bec1..8d71b13c406fc16d07fbf9709003e4837914fea4 100644
--- a/shared/desktop/common.mk
+++ b/shared/desktop/common.mk
@@ -83,8 +83,10 @@ PRODUCT_PROPERTY_OVERRIDES += \
 # containing uncompressed ext4 payload.
 OVERRIDE_PRODUCT_COMPRESSED_APEX := false
 PRODUCT_DEFAULT_APEX_PAYLOAD_TYPE := erofs
-# Include com.android.virt APEX
+# Include com.android.virt APEX when the product has an AVF-capable host.
+ifneq ($(UML_ANDROID_DISABLE_AVF),true)
 $(call inherit-product, packages/modules/Virtualization/apex/product_packages.mk)
+endif
 
 # Large screen config. e.g. Enables dual-pane Settings UI.
 $(call inherit-product, $(SRC_TARGET_DIR)/product/large_screen_common.mk)
diff --git a/shared/device.mk b/shared/device.mk
index ca818fa3a68a1d0ff8c8df8d437171afd284b234..b173afba75dc3b61e0192970202e083a0c362ca6 100644
--- a/shared/device.mk
+++ b/shared/device.mk
@@ -512,6 +512,8 @@ PRODUCT_PACKAGES += $(LOCAL_THERMAL_HAL_PRODUCT_PACKAGE)
 #
 # NeuralNetworks HAL
 #
+LOCAL_ENABLE_NEURALNETWORKS ?= true
+ifeq ($(LOCAL_ENABLE_NEURALNETWORKS),true)
 PRODUCT_PACKAGES += \
     com.android.hardware.neuralnetworks
 
@@ -526,6 +528,7 @@ ifeq ($(RELEASE_AIDL_USE_UNFROZEN),true)
     PRODUCT_COPY_FILES += \
         frameworks/native/data/etc/android.hardware.npu.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.npu.xml
 endif
+endif
 
 # USB
 PRODUCT_PACKAGES += \
diff --git a/shared/phone/device_vendor.mk b/shared/phone/device_vendor.mk
index 354c49e7de1f7eca559fa77c973a328390d73fec..cb466adf0123255f01cfc627b22fcf565453bd38 100644
--- a/shared/phone/device_vendor.mk
+++ b/shared/phone/device_vendor.mk
@@ -30,8 +30,12 @@ $(call inherit-product, device/google/cuttlefish/shared/bluetooth/device_vendor.
 $(call inherit-product, device/google/cuttlefish/shared/consumerir/device_vendor.mk)
 $(call inherit-product, device/google/cuttlefish/shared/gnss/device_vendor.mk)
 $(call inherit-product, device/google/cuttlefish/shared/graphics/device_vendor.mk)
+ifneq ($(UML_ANDROID_DISABLE_IDENTITY),true)
 $(call inherit-product, device/google/cuttlefish/shared/identity/device_vendor.mk)
+endif
+ifneq ($(UML_ANDROID_DISABLE_REBOOT_ESCROW),true)
 $(call inherit-product, device/google/cuttlefish/shared/reboot_escrow/device_vendor.mk)
+endif
 $(call inherit-product, device/google/cuttlefish/shared/vibrator/device_vendor.mk)
 $(call inherit-product, device/google/cuttlefish/shared/secure_element/device_vendor.mk)
 $(call inherit-product, device/google/cuttlefish/shared/swiftshader/device_vendor.mk)
@@ -44,8 +48,10 @@ $(call inherit-product, device/google/cuttlefish/shared/device.mk)
 $(call inherit-product, device/google/cuttlefish/shared/camera/device_vendor.mk)
 $(call inherit-product, device/google/cuttlefish/shared/camera/config/standard.mk)
 
-# Support mixing CF system onto previous versions of vendor
+# Support mixing CF system onto previous versions of vendor.
+ifneq ($(UML_ANDROID_DISABLE_LEGACY_VNDK),true)
 PRODUCT_EXTRA_VNDK_VERSIONS := 31 32 33 34
+endif
 
 TARGET_PRODUCT_PROP := $(LOCAL_PATH)/product.prop
 TARGET_VENDOR_PROP := $(LOCAL_PATH)/vendor.prop
@@ -69,14 +75,20 @@ PRODUCT_PACKAGES += \
     android.hardware.motioncontext-service.default
 
 # NFC AIDL HAL
+LOCAL_ENABLE_NFC ?= true
+ifeq ($(LOCAL_ENABLE_NFC),true)
 PRODUCT_PACKAGES += \
     com.google.cf.nfc
+endif
 
 TARGET_BOARD_INFO_FILE ?= device/google/cuttlefish/shared/phone/android-info.txt
 
 # Storage: for factory reset protection feature
+LOCAL_ENABLE_FRP ?= true
+ifeq ($(LOCAL_ENABLE_FRP),true)
 PRODUCT_VENDOR_PROPERTIES += \
     ro.frp.pst=/dev/block/by-name/frp
+endif
 
 # Cuttlefish doesn't support protected VMs, run AppSearch in non-protected mode
 PRODUCT_PRODUCT_PROPERTIES += ro.appsearch.feature.enable_isolated_storage=true
diff --git a/shared/sensors/device_vendor.mk b/shared/sensors/device_vendor.mk
index f4e4bf1b35edaf25a929cbf19465c29ec34f7a0f..afaa4cd4eba97be5ca743fd40af7a6f0b08958c9 100644
--- a/shared/sensors/device_vendor.mk
+++ b/shared/sensors/device_vendor.mk
@@ -13,6 +13,9 @@
 # See the License for the specific language governing permissions and
 # limitations under the License.
 #
+LOCAL_ENABLE_SENSORS ?= true
+ifeq ($(LOCAL_ENABLE_SENSORS),true)
+
 
 # set LOCAL_SENSOR_FILE_OVERRIDES := true if a device has a custom list of sensors. Otherwise
 # install the default set like below
@@ -43,3 +46,5 @@ PRODUCT_PACKAGES += \
 
 PRODUCT_PACKAGES += \
     cuttlefish_sensor_injection
+
+endif
diff --git a/vsoc_arm64_pgagnostic/phone/aosp_cf.mk b/vsoc_arm64_pgagnostic/phone/aosp_cf.mk
index 8f7a2774f9318f2cbc677a2fff98292890c13a9c..c6e761ef0c9fc57007c7c35811677e91bc13947f 100644
--- a/vsoc_arm64_pgagnostic/phone/aosp_cf.mk
+++ b/vsoc_arm64_pgagnostic/phone/aosp_cf.mk
@@ -42,8 +42,10 @@ $(call inherit-product, $(SRC_TARGET_DIR)/product/aosp_product.mk)
 #
 $(call inherit-product, device/google/cuttlefish/shared/phone/device_vendor.mk)
 
-# Nested virtualization support
+# Nested virtualization support.
+ifneq ($(UML_ANDROID_DISABLE_AVF),true)
 $(call inherit-product, packages/modules/Virtualization/apex/product_packages.mk)
+endif
 
 #
 # Special settings for the target
