From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 23 Oct 2026 15:40:39 +0000
Subject: [PATCH] cuttlefish: run 32-bit applications on request

Let a product set UML_ANDROID_MULTILIB=true when its board defines a 32-bit
second architecture. The page-size-agnostic phone then inherits
core_64_bit.mk (zygote64_32, 32-bit application support) instead of
core_64_bit_only.mk, and keeps the properties the 64-bit-only product set
itself: dex2oat64 enabled for ART Service and no OMX service.
---
 vsoc_arm64_pgagnostic/phone/aosp_cf.mk | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/vsoc_arm64_pgagnostic/phone/aosp_cf.mk b/vsoc_arm64_pgagnostic/phone/aosp_cf.mk
index c6e761ef0c9fc57007c7c35811677e91bc13947f..2797e24e968caf7391b4c7a74ace301d3f114d07 100644
--- a/vsoc_arm64_pgagnostic/phone/aosp_cf.mk
+++ b/vsoc_arm64_pgagnostic/phone/aosp_cf.mk
@@ -15,13 +15,24 @@
 #
 
 #
-# arm64 (64-bit only) page size agnostic target for Cuttlefish
+# arm64 page size agnostic target for Cuttlefish: 64-bit only, or with a 32-bit
+# second architecture when the product sets UML_ANDROID_MULTILIB=true
 #
 
 #
 # All components inherited here go to system image (same as GSI system)
 #
+ifeq ($(UML_ANDROID_MULTILIB),true)
+# The board defines TARGET_2ND_ARCH. core_64_bit.mk starts the secondary zygote
+# and supports 32-bit applications. dex2oat64 compiles both instruction sets,
+# which core_64_bit_only.mk would otherwise enable itself, and the OMX service
+# stays out as in the 64-bit-only product.
+$(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit.mk)
+PRODUCT_VENDOR_PROPERTIES += dalvik.vm.dex2oat64.enabled=true
+TARGET_SUPPORTS_OMX_SERVICE := false
+else
 $(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit_only.mk)
+endif
 $(call inherit-product, $(SRC_TARGET_DIR)/product/generic_system.mk)
 
 PRODUCT_ENFORCE_ARTIFACT_PATH_REQUIREMENTS := relaxed
