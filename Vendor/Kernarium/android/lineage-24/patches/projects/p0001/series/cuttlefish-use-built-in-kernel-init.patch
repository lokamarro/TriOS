From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 20 Aug 2026 18:43:12 +0000
Subject: [PATCH] cuttlefish: use built-in-kernel init

Let a product set UML_ANDROID_BUILTIN_KERNEL=true when its kernel has no
loadable modules. The shared vendor init, serial-logging and ueventd rules,
the generated fstabs and the DLKM loader then stay out of the image, so the
product can supply its own boot policy.
---
 shared/config/Android.bp | 28 ++++++++++++++++++++++++++++
 shared/device.mk         | 13 ++++++++++---
 2 files changed, 38 insertions(+), 3 deletions(-)

diff --git a/shared/config/Android.bp b/shared/config/Android.bp
index 730495feaab680b5c16ed8f99db9c87172ae75a8..f98204452cfc61aed24fdefbc83e6b14ac251961 100644
--- a/shared/config/Android.bp
+++ b/shared/config/Android.bp
@@ -98,12 +98,14 @@ genrule {
 
 prebuilt_etc {
     name: "fstab.cf.f2fs.hctr2",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     src: ":gen_fstab_cf_f2fs_hctr2",
     vendor: true,
 }
 
 prebuilt_etc {
     name: "fstab.cf.f2fs.hctr2.vendor_ramdisk",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     srcs: [
         ":gen_fstab_cf_f2fs_hctr2",
     ],
@@ -115,12 +117,14 @@ prebuilt_etc {
 
 prebuilt_etc {
     name: "fstab.cf.f2fs.cts",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     src: ":gen_fstab_cf_f2fs_cts",
     vendor: true,
 }
 
 prebuilt_etc {
     name: "fstab.cf.f2fs.cts.vendor_ramdisk",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     srcs: [
         ":gen_fstab_cf_f2fs_cts",
     ],
@@ -132,12 +136,14 @@ prebuilt_etc {
 
 prebuilt_etc {
     name: "fstab.cf.ext4.hctr2",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     src: ":gen_fstab_cf_ext4_hctr2",
     vendor: true,
 }
 
 prebuilt_etc {
     name: "fstab.cf.ext4.hctr2.vendor_ramdisk",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     srcs: [
         ":gen_fstab_cf_ext4_hctr2",
     ],
@@ -149,12 +155,14 @@ prebuilt_etc {
 
 prebuilt_etc {
     name: "fstab.cf.ext4.cts",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     src: ":gen_fstab_cf_ext4_cts",
     vendor: true,
 }
 
 prebuilt_etc {
     name: "fstab.cf.ext4.cts.vendor_ramdisk",
+    defaults: ["cuttlefish_config_not_builtin_kernel_defaults"],
     srcs: [
         ":gen_fstab_cf_ext4_cts",
     ],
@@ -196,6 +204,14 @@ prebuilt_defaults {
     }),
 }
 
+prebuilt_defaults {
+    name: "cuttlefish_config_not_builtin_kernel_defaults",
+    enabled: select(soong_config_variable("cuttlefish_config", "use_builtin_kernel"), {
+        true: false,
+        default: unset,
+    }),
+}
+
 prebuilt_etc {
     name: "device_google_cuttlefish_shared_config_init_vendor_rc",
     defaults: ["cuttlefish_config_general_files_defaults"],
@@ -203,6 +219,10 @@ prebuilt_etc {
     dsts: ["init.cutf_cvm.rc"],
     vendor: true,
     relative_install_path: "init",
+    enabled: select(soong_config_variable("cuttlefish_config", "use_builtin_kernel"), {
+        true: false,
+        default: unset,
+    }),
 }
 
 prebuilt_etc {
@@ -263,6 +283,10 @@ prebuilt_etc {
     ],
     relative_install_path: "init",
     vendor: true,
+    enabled: select(soong_config_variable("cuttlefish_config", "use_builtin_kernel"), {
+        true: false,
+        default: unset,
+    }),
 }
 
 prebuilt_etc {
@@ -272,6 +296,10 @@ prebuilt_etc {
         "ueventd.rc",
     ],
     vendor: true,
+    enabled: select(soong_config_variable("cuttlefish_config", "use_builtin_kernel"), {
+        true: false,
+        default: unset,
+    }),
 }
 
 prebuilt_etc {
diff --git a/shared/device.mk b/shared/device.mk
index 0636cf70dee9f4459e43329581bdb111e71c6bb0..55139c5fc42be04574965a0346e4ba90330bb856 100644
--- a/shared/device.mk
+++ b/shared/device.mk
@@ -227,14 +227,19 @@ PRODUCT_CHECK_PREBUILT_MAX_PAGE_SIZE := true
 #
 
 $(call soong_config_set_bool,cuttlefish_config,use_general_files,true)
+ifeq ($(UML_ANDROID_BUILTIN_KERNEL),true)
+$(call soong_config_set_bool,cuttlefish_config,use_builtin_kernel,true)
+else
 PRODUCT_PACKAGES += \
     device_google_cuttlefish_shared_config_init_vendor_rc \
+    device_google_cuttlefish_shared_config_seriallogging_rc \
+    device_google_cuttlefish_shared_config_ueventd_rc
+endif
+PRODUCT_PACKAGES += \
     device_google_cuttlefish_shared_config_init_product_rc \
     device_google_cuttlefish_shared_config_media_codecs \
     device_google_cuttlefish_shared_config_media_profiles \
     device_google_cuttlefish_shared_config_media_profiles_vendor \
-    device_google_cuttlefish_shared_config_seriallogging_rc \
-    device_google_cuttlefish_shared_config_ueventd_rc \
     device_google_cuttlefish_shared_default_permissions_cuttlefish \
     device_google_cuttlefish_shared_privapp_permissions_cuttlefish
 
@@ -594,9 +599,11 @@ PRODUCT_SYSTEM_EXT_PROPERTIES += \
 # Start fingerprint virtual HAL process
 PRODUCT_VENDOR_PROPERTIES += ro.vendor.fingerprint_virtual_hal_start=true
 
-# Vendor Dlkm Locader
+# Vendor DLKM loader
+ifneq ($(UML_ANDROID_BUILTIN_KERNEL),true)
 PRODUCT_PACKAGES += \
    dlkm_loader
+endif
 
 # CAS AIDL HAL
 PRODUCT_PACKAGES += \
