From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 24 Oct 2026 22:28:08 +0000
Subject: [PATCH] build: forward the userdata ext4 inode count

BOARD_<PARTITION>IMAGE_EXTFS_INODE_COUNT reaches the image builder only for
the read-only partitions. A product with a small userdata image therefore
gets mke2fs's size-based inode ratio (one inode per 4 KiB below 512 MiB),
and resize2fs keeps the inodes per group when it later grows the
filesystem, so the grown /data holds more inodes than blocks.

Emit userdata_extfs_inode_count when the board sets
BOARD_USERDATAIMAGE_EXTFS_INODE_COUNT and let the image properties of a
writable partition carry the count to the image builder. A board that does
not set the variable is unchanged.
---
 core/Makefile                     | 1 +
 tools/releasetools/build_image.py | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/core/Makefile b/core/Makefile
index de2b83bc540f76470d8277d9f6a4658e3f0b7162..0be2f9fc6bfe772a7cc2ff29b3fa8bdd2eb2c664 100644
--- a/core/Makefile
+++ b/core/Makefile
@@ -2223,6 +2223,7 @@ $(if $(filter $(2),system_other),\
 $(if $(filter $(2),userdata),\
     $(if $(BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE),$(hide) echo "userdata_fs_type=$(BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE)" >> $(1))
     $(if $(BOARD_USERDATAIMAGE_PARTITION_SIZE),$(hide) echo "userdata_size=$(BOARD_USERDATAIMAGE_PARTITION_SIZE)" >> $(1))
+    $(if $(BOARD_USERDATAIMAGE_EXTFS_INODE_COUNT),$(hide) echo "userdata_extfs_inode_count=$(BOARD_USERDATAIMAGE_EXTFS_INODE_COUNT)" >> $(1))
     $(if $(PRODUCT_FS_CASEFOLD),$(hide) echo "needs_casefold=$(PRODUCT_FS_CASEFOLD)" >> $(1))
     $(if $(PRODUCT_QUOTA_PROJID),$(hide) echo "needs_projid=$(PRODUCT_QUOTA_PROJID)" >> $(1))
     $(if $(PRODUCT_FS_COMPRESSION),$(hide) echo "needs_compress=$(PRODUCT_FS_COMPRESSION)" >> $(1))
diff --git a/tools/releasetools/build_image.py b/tools/releasetools/build_image.py
index 4d59ceee40adc4258d87d54b7fd63078bae996e9..bb979b635bf5bca3d1708692f359df2f3e1a3129 100755
--- a/tools/releasetools/build_image.py
+++ b/tools/releasetools/build_image.py
@@ -772,7 +772,7 @@ def ImagePropFromGlobalDict(glob_dict, mount_point):
       (True, "{}_erofs_blocksize", "erofs_blocksize"),
       (True, "{}_erofs_share_dup_blocks", "erofs_share_dup_blocks"),
       (True, "{}_erofs_enable_dedupe", "erofs_enable_dedupe"),
-      (True, "{}_extfs_inode_count", "extfs_inode_count"),
+      (False, "{}_extfs_inode_count", "extfs_inode_count"),
       (True, "{}_f2fs_compress", "f2fs_compress"),
       (True, "{}_f2fs_sldc_flags", "f2fs_sldc_flags"),
       (True, "{}_f2fs_blocksize", "f2fs_block_size"),
