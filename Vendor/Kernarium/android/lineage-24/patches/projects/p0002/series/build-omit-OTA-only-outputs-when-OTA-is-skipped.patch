From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 20 Aug 2026 19:19:57 +0000
Subject: [PATCH] build: omit OTA-only outputs when OTA is skipped

A non-A/B product that sets TARGET_SKIP_OTA_PACKAGE builds no OTA package,
so the steps that exist only to feed one have nothing to serve. Leave the
legacy updater out of the target-files OTA tools, and do not reconstruct the
recovery-from-boot patch into target-files.
---
 core/Makefile | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/Makefile b/core/Makefile
index 65c45cb835d01281314fd418cc4f52947e337d92..de2b83bc540f76470d8277d9f6a4658e3f0b7162 100644
--- a/core/Makefile
+++ b/core/Makefile
@@ -6379,10 +6379,13 @@ built_ota_tools :=
 # We can't build static executables when SANITIZE_TARGET=address
 ifeq (,$(filter address, $(SANITIZE_TARGET)))
 ifeq (false,$(AB_OTA_UPDATER))
+# TARGET_SKIP_OTA_PACKAGE also permits target-files without a legacy updater.
+ifneq ($(TARGET_SKIP_OTA_PACKAGE),true)
 built_ota_tools += \
     $(call intermediates-dir-for,EXECUTABLES,updater)/updater
 endif
 endif
+endif
 
 $(BUILT_TARGET_FILES_DIR): PRIVATE_OTA_TOOLS := $(built_ota_tools)
 
@@ -7011,11 +7014,13 @@ ifneq ($(PRODUCT_SYSTEM_DLKM_BASE_FS_PATH),)
 	  $(zip_root)/META/$(notdir $(PRODUCT_SYSTEM_DLKM_BASE_FS_PATH))
 endif
 ifeq ($(TARGET_OTA_ALLOW_NON_AB),true)
+ifneq ($(TARGET_SKIP_OTA_PACKAGE),true)
 ifneq ($(INSTALLED_RECOVERYIMAGE_TARGET),)
 	$(hide) PATH=$(INTERNAL_USERIMAGES_BINARY_PATHS):$$PATH MKBOOTIMG=$(MKBOOTIMG) \
 	    $(MAKE_RECOVERY_PATCH) $(zip_root) $(zip_root)
 endif
 endif
+endif
 ifeq ($(AB_OTA_UPDATER),true)
 	@# When using the A/B updater, include the updater config files in the zip.
 	$(hide) cp $(TOPDIR)system/update_engine/update_engine.conf $(zip_root)/META/update_engine_config.txt
