From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 24 Aug 2026 12:21:08 +0000
Subject: [PATCH] build: allow inherited payload exclusions

---
 core/main.mk           | 2 ++
 core/product.mk        | 2 ++
 core/product_config.mk | 5 +++++
 3 files changed, 9 insertions(+)

diff --git a/core/main.mk b/core/main.mk
index 6461bf2615f8015f7e45fdbad9776e094eb8865f..e4ec9c06834cdc28e32748455cdf73e21483b62f 100644
--- a/core/main.mk
+++ b/core/main.mk
@@ -1008,12 +1008,14 @@ define product-installed-modules
     ) \
     $(call auto-included-modules) \
   ) \
+  $(eval _pif_modules := $(filter-out $(call get-product-var,$(1),PRODUCT_PACKAGES_EXCLUDE),$(_pif_modules))) \
   $(eval ### Filter out the overridden packages and executables before doing expansion) \
   $(eval _pif_overrides := $(call module-overrides,$(_pif_modules))) \
   $(eval _pif_modules := $(filter-out $(_pif_overrides), $(_pif_modules))) \
   $(eval ### Resolve the :32 :64 module name) \
   $(eval _pif_modules := $(sort $(call resolve-bitness-for-modules,TARGET,$(_pif_modules)))) \
   $(call expand-required-modules,_pif_modules,$(_pif_modules),$(_pif_overrides)) \
+  $(eval _pif_modules := $(filter-out $(call get-product-var,$(1),PRODUCT_PACKAGES_EXCLUDE),$(_pif_modules))) \
   $(_pif_modules)
 endef
 
diff --git a/core/product.mk b/core/product.mk
index f62a539bfb0f3487dfad83b8b7b523b0ad9e53ec..fcc12110df2a8cde2c5a1eca8bf7b7c741b47ccd 100644
--- a/core/product.mk
+++ b/core/product.mk
@@ -45,6 +45,7 @@ _product_single_value_vars += PRODUCT_AAPT_PREF_CONFIG
 _product_list_vars += PRODUCT_AAPT_PREBUILT_DPI
 _product_list_vars += PRODUCT_HOST_PACKAGES
 _product_list_vars += PRODUCT_PACKAGES
+_product_list_vars += PRODUCT_PACKAGES_EXCLUDE
 _product_list_vars += PRODUCT_PACKAGES_DEBUG
 _product_list_vars += PRODUCT_PACKAGES_DEBUG_ASAN
 _product_list_vars += PRODUCT_PACKAGES_ARM64
@@ -107,6 +108,7 @@ _product_single_value_vars += PRODUCT_CHARACTERISTICS
 # The rules for these copy steps are defined in build/make/core/Makefile.
 # The optional :<owner> is used to indicate the owner of a vendor file.
 _product_list_vars += PRODUCT_COPY_FILES
+_product_list_vars += PRODUCT_COPY_FILES_EXCLUDE
 
 # The OTA key(s) specified by the product config, if any.  The names
 # of these keys are stored in the target-files zip so that post-build
diff --git a/core/product_config.mk b/core/product_config.mk
index 5883e213b5811794c79e399711f281d650f4315b..2d7980f0132f614256554ec15a30a25d90855693 100644
--- a/core/product_config.mk
+++ b/core/product_config.mk
@@ -268,6 +268,11 @@ INTERNAL_PRODUCT := $(current_product_makefile)
 # Strip and assign the PRODUCT_ variables.
 $(call strip-product-vars)
 
+# A product may intentionally omit inherited copy-file entries without
+# forking the reusable product layer that supplied them.
+PRODUCT_PACKAGES := $(filter-out $(PRODUCT_PACKAGES_EXCLUDE),$(PRODUCT_PACKAGES))
+PRODUCT_COPY_FILES := $(filter-out $(PRODUCT_COPY_FILES_EXCLUDE),$(PRODUCT_COPY_FILES))
+
 # Quick check
 $(check-current-product)
 
