From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 25 Oct 2026 09:33:00 +0000
Subject: [PATCH] adbd: report whether an adb host is connected

A phone stays awake for as long as a USB host is connected. Here the host
reaches adbd over the network, which does not wake a suspended guest, so
Android's autosuspend (screen off with the battery unplugged, a removed
user, light idle) cut the connection for 60 to 600 seconds at a time.

The device-side update_transports() was empty. It now counts the
transports in kCsHost, the state a device gives the end of a transport
that announced itself as an adb host, and sets
sys.kernarium.adb.host_connected to 1 when the count leaves zero and
to 0 when it returns to zero. adbd clears the property at start, so an
adbd that died with a host connected cannot leave it set. Product init
holds a userspace wakelock while the property is 1. The property is
system-owned, as adbd is a core domain and may not set a vendor one.
---
 daemon/main.cpp |  3 +++
 transport.cpp   | 37 ++++++++++++++++++++++++++++++++++++-
 transport.h     |  5 +++++
 3 files changed, 44 insertions(+), 1 deletion(-)

diff --git a/daemon/main.cpp b/daemon/main.cpp
index 3d1d8e7f62bb34cafdc90c6bea303d8332cda16c..757020ac84323c6bf192100e01249d45eaa77c92 100644
--- a/daemon/main.cpp
+++ b/daemon/main.cpp
@@ -237,6 +237,9 @@ int adbd_main() {
     auth_required = android::base::GetBoolProperty(
             "ro.boot.kernarium.adb_auth", true);
 
+    // Tell product init that no adb host is connected yet.
+    adbd_clear_host_connected();
+
     // Our external storage path may be different than apps, since
     // we aren't able to bind mount after dropping root.
     const char* adb_external_storage = getenv("ADB_EXTERNAL_STORAGE");
diff --git a/transport.cpp b/transport.cpp
index 66273fc09c5ccb50e55e276f8a76b893cb9372f2..df41faced40a01f816f27bad9eb8ad59e7326309 100644
--- a/transport.cpp
+++ b/transport.cpp
@@ -42,6 +42,9 @@
 #include <android-base/logging.h>
 #include <android-base/no_destructor.h>
 #include <android-base/parsenetaddress.h>
+#if !ADB_HOST
+#include <android-base/properties.h>
+#endif
 #include <android-base/stringprintf.h>
 #include <android-base/strings.h>
 #include <android-base/thread_annotations.h>
@@ -775,8 +778,40 @@ void update_transports() {
 
 #else
 
+// A phone stays awake while a USB host is connected. This device has no cable: its host reaches
+// adbd over the network, which cannot wake a suspended guest, so the guest must not suspend itself
+// while a host is there. Product init holds a userspace wakelock for as long as this property is 1.
+static constexpr char kHostConnectedProperty[] = "sys.kernarium.adb.host_connected";
+
+static void set_host_connected(bool connected) {
+    if (!android::base::SetProperty(kHostConnectedProperty, connected ? "1" : "0")) {
+        LOG(WARNING) << "failed to set " << kHostConnectedProperty << " to " << connected;
+    }
+}
+
+void adbd_clear_host_connected() {
+    // No transport exists yet. This also clears the value that an adbd which died with a host
+    // connected left behind.
+    set_host_connected(false);
+}
+
 void update_transports() {
-    // Nothing to do on the device side.
+    // Runs on the looper thread, so the last reported value needs no lock.
+    static bool reported = false;
+    bool connected = false;
+    {
+        std::lock_guard<std::recursive_mutex> lock(transport_lock);
+        for (const auto& t : transport_list) {
+            if (t->GetConnectionState() == kCsHost) {
+                connected = true;
+                break;
+            }
+        }
+    }
+    if (connected != reported) {
+        reported = connected;
+        set_host_connected(connected);
+    }
 }
 
 #endif  // ADB_HOST
diff --git a/transport.h b/transport.h
index 365f3c4987bfe91413832678e4d8753dcd0cda23..78b110718baa5c7c5cb12e5a22168eaf649dbe14 100644
--- a/transport.h
+++ b/transport.h
@@ -481,6 +481,11 @@ atransport* acquire_one_transport(TransportType type, const char* transport_name
 void kick_transport(atransport* t, bool reset = false);
 void update_transports();
 
+#if !ADB_HOST
+// Reports that no adb host is connected (see update_transports() in transport.cpp).
+void adbd_clear_host_connected();
+#endif
+
 // Iterates across all of the current and pending transports.
 // Stops iteration and returns false if fn returns false, otherwise returns true.
 bool iterate_transports(std::function<bool(const atransport*)> fn);
