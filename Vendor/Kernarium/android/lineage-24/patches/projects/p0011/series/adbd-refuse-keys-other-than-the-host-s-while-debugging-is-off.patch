From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 3 Nov 2026 11:41:41 +0000
Subject: [PATCH] adbd: refuse keys other than the host's while debugging is
 off

adbd always serves the host application's key. Any other key now
authenticates, and may raise the "Allow USB debugging" prompt, only
while the guest's debugging is on: USB debugging, the "adb" function of
persist.sys.usb.config, or wireless debugging, which is
persist.adb.tls_server.enable. Those are the two settings that keep
stock adbd running, so the predicate is the stock one.

With debugging off, IteratePublicKeys offers the host key alone, and
adbd_auth_confirm_key returns before it calls libadbd_auth: no prompt,
nothing for the user to accept, and nothing queued that would appear
when debugging is turned on. The transport stays unauthorized. The
host's own key is unaffected. A LAN computer's bridged connection also
arrives over vsock from the host, so the rule is by key, not by origin.

The predicate is read at every decision, not cached, because the user
turns debugging on and off at run time.
---
 daemon/auth.cpp | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/daemon/auth.cpp b/daemon/auth.cpp
index 239560670d100a48862ef920cb502a433b006adb..2a1c7d3522ac945cff8f2f90c824decd073cc823 100644
--- a/daemon/auth.cpp
+++ b/daemon/auth.cpp
@@ -33,6 +33,7 @@
 #include <adb/tls/adb_ca_list.h>
 #include <adbd_auth.h>
 #include <android-base/file.h>
+#include <android-base/logging.h>
 #include <android-base/no_destructor.h>
 #include <android-base/properties.h>
 #include <android-base/strings.h>
@@ -123,6 +124,22 @@ static atransport* transport_from_callback_arg(void* id) {
     return t;
 }
 
+// Whether the guest's debugging is on, as the framework records it: USB debugging is the "adb" function
+// of persist.sys.usb.config (AdbService writes it when the setting changes, with no UsbDeviceManager to
+// do it), wireless debugging is persist.adb.tls_server.enable. They are the two settings that keep stock
+// adbd running, and stock adbd is stopped when both are off. Kernarium's adbd keeps running for the host
+// application, so it asks instead. Read at every decision, not cached: the user turns debugging on and
+// off at run time.
+static bool DebuggingEnabled() {
+    for (const std::string& function :
+         android::base::Split(android::base::GetProperty("persist.sys.usb.config", ""), ",")) {
+        if (function == "adb") {
+            return true;
+        }
+    }
+    return android::base::GetBoolProperty("persist.adb.tls_server.enable", false);
+}
+
 static void IteratePublicKeys(std::function<bool(std::string_view public_key)> f) {
     // The host application's own key, read once. Kernarium's host application is the adb host of
     // the guest it runs: it keeps a key of its own per guest and passes the base64 public key as
@@ -137,6 +154,10 @@ static void IteratePublicKeys(std::function<bool(std::string_view public_key)> f
     if (!host_key.empty() && !f(host_key)) {
         return;
     }
+    // Any other key authenticates only while debugging is on.
+    if (!DebuggingEnabled()) {
+        return;
+    }
     adbd_auth_get_public_keys(
             auth_ctx,
             [](void* opaque, const char* public_key, size_t len) {
@@ -350,6 +371,13 @@ static void adb_disconnected(void* unused, atransport* t) {
 }
 
 void adbd_auth_confirm_key(atransport* t) {
+    if (!DebuggingEnabled()) {
+        // No prompt and nothing queued for libadbd_auth: with debugging off the user has nothing to
+        // accept, and a prompt left pending would appear when debugging is turned on. The transport
+        // stays unauthorized.
+        LOG(INFO) << "kernarium: key refused, debugging is off";
+        return;
+    }
     VLOG(AUTH) << "prompting user to authorize key";
     t->AddDisconnect(&adb_disconnect);
     if (adbd_auth_prompt_user_with_id) {
