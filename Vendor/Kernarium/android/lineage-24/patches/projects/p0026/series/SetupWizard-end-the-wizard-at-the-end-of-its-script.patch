From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 8 Nov 2026 04:06:47 +0000
Subject: [PATCH] SetupWizard: end the wizard at the end of its script

The wizard completes in a page of its own, FinishActivity, which a
script reaches through a final action. A product that shows no closing
page cannot just drop that action: the last page would then end the
script, which only disables the wizard manager, and the device would
never be provisioned.

Let the last page of a script end the wizard itself. It reads Finish, as
before, and pressing it runs the completion that the closing page ran
after its reveal. A script that still names the closing page behaves as
it did, and so does a page the wizard did not start, or whose script
cannot be read: it reads Next.
---
 .../base/BaseSetupWizardActivity.kt           | 50 +++++++++++++++----
 1 file changed, 41 insertions(+), 9 deletions(-)

diff --git a/app/src/main/java/org/lineageos/setupwizard/base/BaseSetupWizardActivity.kt b/app/src/main/java/org/lineageos/setupwizard/base/BaseSetupWizardActivity.kt
index 9c3e5ef4e66ee75732dcc0e6a08f4e353315cc7e..fa0cc4bb7942345e3a359772266a0704453b5b47 100644
--- a/app/src/main/java/org/lineageos/setupwizard/base/BaseSetupWizardActivity.kt
+++ b/app/src/main/java/org/lineageos/setupwizard/base/BaseSetupWizardActivity.kt
@@ -124,19 +124,47 @@ abstract class BaseSetupWizardActivity : AppCompatActivity() {
         }
     }
 
-    private fun isLastStep(): Boolean {
-        val wizardBundle = intent.getBundleExtra(EXTRA_WIZARD_BUNDLE) ?: return false
-        val scriptUri = wizardBundle.getString(EXTRA_SCRIPT_URI) ?: return false
-        val actionId = wizardBundle.getString(EXTRA_ACTION_ID) ?: return false
+    /** What the wizard's script has after this page. */
+    private enum class Following {
+        /** The script cannot say: the wizard did not start this page, or its script failed. */
+        UNKNOWN,
 
-        val nextAction =
+        /** Nothing: this page is the end of the script. */
+        NOTHING,
+
+        /** The closing page, which completes the setup. */
+        SETUP_COMPLETE,
+
+        /** Any other page. */
+        PAGE,
+    }
+
+    private fun following(): Following {
+        val wizardBundle = intent.getBundleExtra(EXTRA_WIZARD_BUNDLE) ?: return Following.UNKNOWN
+        val scriptUri = wizardBundle.getString(EXTRA_SCRIPT_URI) ?: return Following.UNKNOWN
+        val actionId = wizardBundle.getString(EXTRA_ACTION_ID) ?: return Following.UNKNOWN
+
+        val lookup =
             runCatching { WizardManager.getNextAction(this, scriptUri, actionId, RESULT_OK) }
                 .onFailure { Log.w(TAG, "No next action found", it) }
-                .getOrNull() ?: return false
-
-        return nextAction.getIntent()?.action == ACTION_SETUP_COMPLETE
+        if (lookup.isFailure) {
+            return Following.UNKNOWN
+        }
+        val nextAction = lookup.getOrNull() ?: return Following.NOTHING
+        return if (nextAction.getIntent()?.action == ACTION_SETUP_COMPLETE) {
+            Following.SETUP_COMPLETE
+        } else {
+            Following.PAGE
+        }
     }
 
+    private fun isLastStep(): Boolean =
+        when (following()) {
+            Following.NOTHING,
+            Following.SETUP_COMPLETE -> true
+            else -> false
+        }
+
     private fun setupFooterBar() {
         val mixin = glifLayout.getMixin(FooterBarMixin::class.java)
         footerBarMixin = mixin
@@ -165,7 +193,11 @@ abstract class BaseSetupWizardActivity : AppCompatActivity() {
     }
 
     protected open fun onNextPressed() {
-        nextAction(RESULT_OK)
+        if (following() == Following.NOTHING) {
+            SetupWizardUtils.finishSetupWizard(this)
+        } else {
+            nextAction(RESULT_OK)
+        }
     }
 
     protected open fun onSkipPressed() {
