diff --git a/minui/graphics.cpp b/minui/graphics.cpp
index 94ebcbc3f846479dff63401face9b58f5f244624..3bb7fce3b6651c26fd22c697684438900a07f6d1 100644
--- a/minui/graphics.cpp
+++ b/minui/graphics.cpp
@@ -387,6 +387,44 @@ unsigned int gr_get_height(const GRSurface* surface) {
   return surface->height;
 }
 
+// Bitmap fonts use an mdpi glyph grid. Scale each glyph independently so
+// fractional densities cannot mix adjacent characters or the two font faces.
+int gr_scale_font(GRFont* font, unsigned int density) {
+  if (font == nullptr || font->texture == nullptr || font->char_width <= 0 ||
+      font->char_height <= 0 || density < 80 || density > 640) {
+    return -1;
+  }
+  if (density == 160) return 0;
+  const auto width = std::max<uint64_t>(1, (uint64_t(font->char_width) * density + 80) / 160);
+  const auto height = std::max<uint64_t>(1, (uint64_t(font->char_height) * density + 80) / 160);
+  if (width > INT32_MAX / 96 || height > INT32_MAX / 2 ||
+      font->texture->pixel_bytes != 1 ||
+      font->texture->width != size_t(font->char_width) * 96 ||
+      font->texture->height != size_t(font->char_height) * 2) {
+    return -1;
+  }
+  auto scaled = GRSurface::Create(width * 96, height * 2, width * 96, 1);
+  if (!scaled) return -1;
+  for (size_t face = 0; face < 2; ++face) {
+    for (size_t y = 0; y < height; ++y) {
+      const auto source_y = face * font->char_height + y * font->char_height / height;
+      auto* output = scaled->data() + (face * height + y) * scaled->row_bytes;
+      for (size_t glyph = 0; glyph < 96; ++glyph) {
+        for (size_t x = 0; x < width; ++x) {
+          const auto source_x = glyph * font->char_width + x * font->char_width / width;
+          output[glyph * width + x] =
+              font->texture->data()[source_y * font->texture->row_bytes + source_x];
+        }
+      }
+    }
+  }
+  delete font->texture;
+  font->texture = scaled.release();
+  font->char_width = width;
+  font->char_height = height;
+  return 0;
+}
+
 int gr_init_font(const char* name, GRFont** dest) {
   GRFont* font = static_cast<GRFont*>(calloc(1, sizeof(*gr_font)));
   if (font == nullptr) {
@@ -405,6 +443,11 @@ int gr_init_font(const char* name, GRFont** dest) {
   font->char_width = font->texture->width / 96;
   font->char_height = font->texture->height / 2;
 
+  // The host supplies density at boot; builds without it keep their original fonts.
+  const auto density = android::base::GetIntProperty<int>("ro.sf.lcd_density", 160, 80, 640);
+  if (gr_scale_font(font, density) != 0) {
+    printf("Failed to scale %s at %d DPI; keeping its original font\n", name, density);
+  }
   *dest = font;
 
   return 0;
