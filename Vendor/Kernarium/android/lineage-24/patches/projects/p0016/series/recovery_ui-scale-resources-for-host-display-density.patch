+std::unique_ptr<GRSurface> GRSurface::Scale(unsigned int density) const {
+  if (density < 80 || density > 640 || width == 0 || height == 0 || pixel_bytes == 0 ||
+      width > INT32_MAX || height > INT32_MAX || width > SIZE_MAX / pixel_bytes ||
+      row_bytes < width * pixel_bytes) {
+    return nullptr;
+  }
+  const auto scaled_width = std::max<uint64_t>(1, (uint64_t(width) * density + 80) / 160);
+  const auto scaled_height = std::max<uint64_t>(1, (uint64_t(height) * density + 80) / 160);
+  if (scaled_width > INT32_MAX || scaled_height > INT32_MAX ||
+      scaled_width > SIZE_MAX / pixel_bytes) {
+    return nullptr;
+  }
+  auto result = Create(scaled_width, scaled_height, scaled_width * pixel_bytes, pixel_bytes);
+  if (!result) return nullptr;
+  for (size_t y = 0; y < scaled_height; ++y) {
+    const auto* source = data() + (uint64_t(y) * height / scaled_height) * row_bytes;
+    auto* target = result->data() + y * result->row_bytes;
+    for (size_t x = 0; x < scaled_width; ++x) {
+      memcpy(target + x * pixel_bytes,
+             source + (uint64_t(x) * width / scaled_width) * pixel_bytes, pixel_bytes);
+    }
+  }
+  return result;
+}
+
 PngHandler::PngHandler(const std::string& name) {
   std::string res_path = g_resource_dir + "/" + name + ".png";
   png_fp_.reset(fopen(res_path.c_str(), "rbe"));
