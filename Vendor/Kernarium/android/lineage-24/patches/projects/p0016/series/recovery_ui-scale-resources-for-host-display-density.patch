diff --git a/tests/unit/minui_test.cpp b/tests/unit/minui_test.cpp
index c7d7f7eefc1b26533c0ad7a9df6644064ea456b4..6ec99a5e2b409414956adbd8bb7e0f8762e08045 100644
--- a/tests/unit/minui_test.cpp
+++ b/tests/unit/minui_test.cpp
@@ -52,3 +52,79 @@ TEST(GRSurfaceTest, Clone) {
   ASSERT_EQ(std::vector(image->data(), image->data() + image->data_size()),
             std::vector(image_copy->data(), image_copy->data() + image->data_size()));
 }
+
+// The source has 96 glyphs and two faces; no scaled pixel may cross either boundary.
+TEST(GRFontScaleTest, PreservesGlyphsAndFaces) {
+  for (unsigned density : {160U, 213U, 240U, 320U, 480U}) {
+    auto surface = GRSurface::Create(192, 4, 192, 1);
+    ASSERT_TRUE(surface);
+    for (size_t face = 0; face < 2; ++face)
+      for (size_t glyph = 0; glyph < 96; ++glyph)
+        for (size_t y = 0; y < 2; ++y)
+          for (size_t x = 0; x < 2; ++x)
+            surface->data()[(face * 2 + y) * 192 + glyph * 2 + x] =
+                (glyph * 3 + face * 17 + y * 5 + x) % 256;
+    GRFont font{surface.release(), 2, 2};
+    ASSERT_EQ(0, gr_scale_font(&font, density));
+    const auto extent = (2 * density + 80) / 160;
+    EXPECT_EQ(extent, font.char_width);
+    EXPECT_EQ(extent, font.char_height);
+    EXPECT_EQ(extent * 96, font.texture->width);
+    EXPECT_EQ(extent * 2, font.texture->height);
+    for (size_t face = 0; face < 2; ++face)
+      for (size_t glyph = 0; glyph < 96; ++glyph)
+        for (size_t y = 0; y < extent; ++y)
+          for (size_t x = 0; x < extent; ++x)
+            EXPECT_EQ((glyph * 3 + face * 17 + (y * 2 / extent) * 5 + x * 2 / extent) % 256,
+                      font.texture->data()[(face * extent + y) * font.texture->row_bytes +
+                                            glyph * extent + x]);
+    delete font.texture;
+  }
+}
+
+TEST(GRFontScaleTest, RejectsInvalidDensityWithoutChangingTheFont) {
+  auto surface = GRSurface::Create(192, 4, 192, 1);
+  GRFont font{surface.get(), 2, 2};
+  EXPECT_EQ(-1, gr_scale_font(&font, 0));
+  EXPECT_EQ(-1, gr_scale_font(&font, 10000));
+  EXPECT_EQ(surface.get(), font.texture);
+  EXPECT_EQ(2, font.char_width);
+  EXPECT_EQ(-1, gr_scale_font(nullptr, 320));
+}
+
+
+TEST(GRSurfaceTest, ScalePreservesPixelsAndRowStride) {
+  for (size_t bytes : {1U, 4U}) {
+    auto image = GRSurface::Create(3, 2, 4 * bytes, bytes);
+    ASSERT_TRUE(image);
+    for (size_t y = 0; y < 2; ++y)
+      for (size_t x = 0; x < 3; ++x)
+        for (size_t c = 0; c < bytes; ++c)
+          image->data()[y * image->row_bytes + x * bytes + c] = y * 40 + x * 10 + c;
+    for (unsigned density : {160U, 213U, 240U, 320U, 480U}) {
+      auto scaled = image->Scale(density);
+      ASSERT_TRUE(scaled);
+      EXPECT_EQ((3 * density + 80) / 160, scaled->width);
+      EXPECT_EQ((2 * density + 80) / 160, scaled->height);
+      EXPECT_EQ(bytes, scaled->pixel_bytes);
+      for (size_t y = 0; y < scaled->height; ++y)
+        for (size_t x = 0; x < scaled->width; ++x)
+          for (size_t c = 0; c < bytes; ++c)
+            EXPECT_EQ((y * 2 / scaled->height) * 40 + (x * 3 / scaled->width) * 10 + c,
+                      scaled->data()[y * scaled->row_bytes + x * bytes + c]);
+    }
+  }
+}
+
+TEST(GRSurfaceTest, ScaleRejectsInvalidInputs) {
+  auto image = GRSurface::Create(3, 2, 12, 4);
+  ASSERT_TRUE(image);
+  EXPECT_FALSE(image->Scale(0));
+  EXPECT_FALSE(image->Scale(10000));
+  auto short_row = GRSurface::Create(3, 2, 3, 4);
+  ASSERT_TRUE(short_row);
+  EXPECT_FALSE(short_row->Scale(320));
+  auto oversized = GRSurface::Create(size_t(INT32_MAX) + 1, 1, 1, 1);
+  ASSERT_TRUE(oversized);
+  EXPECT_FALSE(oversized->Scale(320));
+}
