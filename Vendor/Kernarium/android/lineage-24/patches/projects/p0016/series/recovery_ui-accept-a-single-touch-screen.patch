From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 16 Oct 2026 18:24:04 +0000
Subject: [PATCH] recovery_ui: accept a single-touch screen

The Darwin UML touchscreen is a direct single-touch device: BTN_TOUCH with
ABS_X and ABS_Y and no ABS_MT axes. RecoveryUI read only the multi-touch
position axes, so a tap or swipe on such a screen moved no menu selection.
Read ABS_X and ABS_Y as the one contact's position as well, and calibrate
from them when the screen reports no multi-touch range.

A single-touch screen reports an axis only when its value changes, so a
second tap at the same point carries no coordinates. Treat the last
reported position as the new contact's when BTN_TOUCH goes down.

Change-Id: Idaa4ffda50f5eafadf8e6df96a1318d8ffbcbc55
---
 recovery_ui/ui.cpp | 23 +++++++++++++++++------
 1 file changed, 17 insertions(+), 6 deletions(-)

diff --git a/recovery_ui/ui.cpp b/recovery_ui/ui.cpp
index ead4c51c46e80adce467294617eaf91916a8edb4..5aecfcfb933249d5e36642ba1864e6c9d59ade2d 100644
--- a/recovery_ui/ui.cpp
+++ b/recovery_ui/ui.cpp
@@ -253,16 +253,22 @@ void RecoveryUI::CalibrateTouch(int fd) {
 
   if (calibrated) return;
 
+  // A multi-touch screen reports its range on the ABS_MT_POSITION axes. A single-touch screen
+  // reports none there and its range on ABS_X and ABS_Y instead.
   memset(&info, 0, sizeof(info));
-  if (ioctl(fd, EVIOCGABS(ABS_MT_POSITION_X), &info) == 0) {
-    touch_min_.x(info.minimum);
-    touch_max_.x(info.maximum);
+  if (ioctl(fd, EVIOCGABS(ABS_MT_POSITION_X), &info) != 0 || info.maximum <= info.minimum) {
+    memset(&info, 0, sizeof(info));
+    ioctl(fd, EVIOCGABS(ABS_X), &info);
   }
+  touch_min_.x(info.minimum);
+  touch_max_.x(info.maximum);
   memset(&info, 0, sizeof(info));
-  if (ioctl(fd, EVIOCGABS(ABS_MT_POSITION_Y), &info) == 0) {
-    touch_min_.y(info.minimum);
-    touch_max_.y(info.maximum);
+  if (ioctl(fd, EVIOCGABS(ABS_MT_POSITION_Y), &info) != 0 || info.maximum <= info.minimum) {
+    memset(&info, 0, sizeof(info));
+    ioctl(fd, EVIOCGABS(ABS_Y), &info);
   }
+  touch_min_.y(info.minimum);
+  touch_max_.y(info.maximum);
 
   calibrated = true;
 }
@@ -421,6 +427,7 @@ int RecoveryUI::OnInputEvent(int fd, uint32_t epevents) {
     if (touch_slot_ > 0) return 0;
 
     switch (ev.code) {
+      case ABS_X:  // A single-touch screen reports its one contact here.
       case ABS_MT_POSITION_X:
         touch_finger_down_ = true;
         touch_saw_x_ = true;
@@ -431,6 +438,7 @@ int RecoveryUI::OnInputEvent(int fd, uint32_t epevents) {
         }
         break;
 
+      case ABS_Y:
       case ABS_MT_POSITION_Y:
         touch_finger_down_ = true;
         touch_saw_y_ = true;
@@ -455,6 +463,9 @@ int RecoveryUI::OnInputEvent(int fd, uint32_t epevents) {
         // A BTN_TOUCH with value 1 indicates the start of contact (protocol A), with 0 means
         // lifting the contact.
         touch_finger_down_ = (ev.value == 1);
+        // A single-touch screen reports an axis only when its value changes, so a touch at the
+        // previous position carries no coordinates: that position is still the contact's.
+        if (touch_finger_down_) touch_saw_x_ = touch_saw_y_ = true;
       }
 
       // Intentionally ignore BTN_TOUCH and BTN_TOOL_FINGER, which would otherwise trigger
