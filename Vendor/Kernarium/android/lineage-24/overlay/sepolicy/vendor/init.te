# SPDX-License-Identifier: Apache-2.0
#
# init.rc enables the bootreceiver trace instance's error_report_end event by
# writing its existing "enable" file. tracefs creates event dentries on first
# lookup, and an O_CREAT open checks the right to create before that lookup
# finds the file, so the check is refused although the write succeeds.
# Cuttlefish tracks the same record as b/340399580.
dontaudit init debugfs_bootreceiver_tracing:dir { write add_name };
