# SPDX-License-Identifier: Apache-2.0
# This virtual-device HAL receives host motion on vsock, like Cuttlefish's
# host-backed HALs. The platform requires this explicit domain classification
# for direct vsock access. The sub-HAL accepts only host CID 2. It writes to
# the accepted connection (the sensors applications use, in a small control
# frame) and shuts it down when a frame cannot be sent whole.
typeattribute hal_sensors_default unconstrained_vsock_violators;
allow hal_sensors_default self:vsock_socket { create bind listen accept read write shutdown getattr getopt };
