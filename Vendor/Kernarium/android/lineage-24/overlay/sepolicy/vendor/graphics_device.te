# SPDX-License-Identifier: Apache-2.0
#
# Every process that initialises EGL enumerates /dev/dri through libdrm's
# drmGetDevices2(), which stats each node in the directory, including the
# primary node this product labels graphics_device. A node whose stat fails is
# skipped and the enumeration continues, so a GPU client still finds the render
# node it is entitled to; the failure costs nothing but the audit line.
#
# The access stays denied on purpose: AOSP grants the primary node to the
# display owners alone -- surfaceflinger, the composer HAL, gpuservice,
# recovery and the charger -- and a GPU client has no business holding it.
dontaudit bootanim graphics_device:chr_file getattr;
dontaudit system_app graphics_device:chr_file getattr;
dontaudit system_server graphics_device:chr_file getattr;
