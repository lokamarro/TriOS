# SPDX-License-Identifier: Apache-2.0
#
# init.vendor.rc grows userdata with resize2fs once /data is mounted, and
# resize2fs runs in the fsck domain. The kernel's online resize asks the caller
# for CAP_SYS_RESOURCE and for EXT4_IOC_RESIZE_FS (0x6610, the low 16 bits of
# _IOW('f', 16, __u64)) on the mount point, which resize2fs opens read-only;
# nothing else on /data is touched. resize2fs also reads
# /sys/fs/ext4/features/meta_bg_resize to learn whether the kernel can add the
# group descriptor blocks a larger filesystem needs. AOSP grants the same read
# to the e2fs domain for mke2fs.
allow fsck sysfs_fs_ext4_features:dir search;
allow fsck sysfs_fs_ext4_features:file r_file_perms;
allow fsck self:capability sys_resource;
allow fsck system_data_root_file:dir { open read ioctl };
allowxperm fsck system_data_root_file:dir ioctl 0x6610;
