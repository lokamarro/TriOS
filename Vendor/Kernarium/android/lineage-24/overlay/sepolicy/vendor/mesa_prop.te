# SPDX-License-Identifier: Apache-2.0
# Driver options for the Mesa graphics stack on this product. The values are
# configuration, not device state: vendor_init sets them from the vendor build
# properties and every process that loads the driver reads them.
vendor_public_prop(vendor_mesa_prop)

set_prop(vendor_init, vendor_mesa_prop)
get_prop(appdomain, vendor_mesa_prop)
get_prop(surfaceflinger, vendor_mesa_prop)
get_prop(system_server, vendor_mesa_prop)
get_prop(bootanim, vendor_mesa_prop)
# gpuservice loads the Vulkan driver to answer `cmd gpu vkjson` and its GPU
# statistics queries.
get_prop(gpuservice, vendor_mesa_prop)
