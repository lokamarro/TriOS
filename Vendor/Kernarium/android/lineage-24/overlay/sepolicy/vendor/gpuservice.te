# SPDX-License-Identifier: Apache-2.0
#
# gpuservice loads the Venus Vulkan HAL, which loads the minigbm gralloc
# module in the same process. minigbm reads its optional
# "vendor.minigbm.debug" switch, which falls to vendor_default_prop. A core
# process may not read vendor-defined properties, and an unreadable switch is
# the unset switch minigbm already defaults to. AOSP silences this read for
# the other same-process HAL clients -- applications, bootanim and
# SurfaceFlinger -- for the same reason.
dontaudit gpuservice vendor_default_prop:file read;
