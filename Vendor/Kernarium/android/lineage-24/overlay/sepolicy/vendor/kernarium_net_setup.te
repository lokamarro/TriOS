# SPDX-License-Identifier: Apache-2.0
#
# The product's network setup tool runs once at post-fs-data. It addresses
# eth0, asks the host's DHCP server for the address, adds a source rule and a
# link route, and creates the macvlan and the virt_wifi device the framework
# sees as wlan0. Cuttlefish's setup_wifi and rename_netiface need the same
# netlink rights for the same link operations.
type kernarium_net_setup, domain;
type kernarium_net_setup_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(kernarium_net_setup)
net_domain(kernarium_net_setup)

# CAP_NET_ADMIN changes links, addresses, rules and routes; CAP_NET_BIND_SERVICE
# binds the DHCP client port.
allow kernarium_net_setup self:capability { net_admin net_bind_service };

# RTM_NEWLINK, RTM_SETLINK, RTM_NEWADDR, RTM_NEWROUTE and RTM_NEWRULE. A kernel
# with extended access vectors for netlink messages checks each message type.
allow kernarium_net_setup self:netlink_route_socket { bind create getattr nlmsg nlmsg_write read write };
allowxperm kernarium_net_setup self:netlink_route_socket nlmsg priv_route_socket_nlmsgs;

# SIOCGIFHWADDR reads eth0's MAC, the address the DHCP request is made for.
allow kernarium_net_setup self:udp_socket ioctl;
allowxperm kernarium_net_setup self:udp_socket ioctl SIOCGIFHWADDR;

# The tool logs to the kernel log: logd is not a given this early in boot.
allow kernarium_net_setup kmsg_device:chr_file w_file_perms;
