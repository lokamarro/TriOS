# SPDX-License-Identifier: Apache-2.0
#
# kdevtmpfs mirrors every device node into the kernel's own devtmpfs instance.
# Android never mounts that instance: first-stage init mounts a tmpfs on /dev
# and ueventd creates the nodes Android uses there, with their policy labels.
# Nodes added to the unmounted devtmpfs after the policy loads are refused
# without effect, as AOSP already records for dm-user nodes.
dontaudit kernel device:dir { write add_name };
dontaudit kernel device:chr_file { create setattr };
