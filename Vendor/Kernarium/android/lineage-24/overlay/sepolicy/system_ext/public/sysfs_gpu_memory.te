# SPDX-License-Identifier: Apache-2.0
#
# The file in which the virtio-gpu driver keeps the host's report of graphics
# memory pressure (/sys/class/drm/card0/gpu_memory_report). lmkd reads it, and
# asks the host for new reports by writing to it (route p0027). The type is
# public because the vendor's genfs_contexts labels the file with it; the rules
# that let lmkd use it are in ../private/lmkd_gpu_reclaim.te.
type sysfs_gpu_memory, fs_type, sysfs_type;
