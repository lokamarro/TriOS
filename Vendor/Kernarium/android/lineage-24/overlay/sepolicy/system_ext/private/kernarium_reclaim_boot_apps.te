# SPDX-License-Identifier: Apache-2.0
#
# Once boot has settled the product kills the cached processes of a list of
# apps (tools/kernarium_reclaim_boot_apps.sh): `dumpsys activity lru` reads the
# process list and `cmd activity kill` kills the cached ones. A vendor domain
# may neither execute /system/bin/cmd nor be the framework's client, so the
# script runs in a core domain defined here, as the Wi-Fi network script does.
type kernarium_reclaim_boot_apps, domain;
typeattribute kernarium_reclaim_boot_apps coredomain;
type kernarium_reclaim_boot_apps_exec, exec_type, system_file_type, file_type;

init_daemon_domain(kernarium_reclaim_boot_apps)
binder_use(kernarium_reclaim_boot_apps)

# The shell script, and log, sleep and grep from the toolbox.
allow kernarium_reclaim_boot_apps shell_exec:file rx_file_perms;
allow kernarium_reclaim_boot_apps toolbox_exec:file rx_file_perms;
# cmd and dumpsys run in the script's domain.
allow kernarium_reclaim_boot_apps system_file:file execute_no_trans;

# Both tools find the activity manager and hand it the descriptors they write
# the output to and the binder they receive the result on: the descriptors are
# the script's own. Without the binder transfer the activity manager never gets
# the command, and without the call back to that binder cmd never learns the
# command is done.
allow kernarium_reclaim_boot_apps activity_service:service_manager find;
allow kernarium_reclaim_boot_apps system_server:binder transfer;
allow system_server kernarium_reclaim_boot_apps:binder call;
allow system_server kernarium_reclaim_boot_apps:fd use;
allow system_server kernarium_reclaim_boot_apps:fifo_file { getattr read write };
