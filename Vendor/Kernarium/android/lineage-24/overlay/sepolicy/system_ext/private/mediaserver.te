# SPDX-License-Identifier: Apache-2.0
#
# mediaserver allocates graphics buffers for the video decoders, which loads the
# vendor's gralloc mapper into the process. minigbm reads the option
# vendor.minigbm.debug when it initialises. That name is a vendor_default_prop,
# which a core domain may not read, so the lookup finds no value and the mapper
# carries on without one. Android silences the same denial for applications,
# SurfaceFlinger and the boot animation.
dontaudit mediaserver vendor_default_prop:file read;
