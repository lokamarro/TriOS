# SPDX-License-Identifier: Apache-2.0
#
# After boot completes the product applies the host's time zone
# (tools/kernarium_time_zone.sh): `cmd settings get global auto_time_zone`
# reads whether the user lets the guest follow the host and `cmd alarm
# set-timezone` sets the zone through the platform's own setter. A vendor
# domain may neither execute /system/bin/cmd nor be the framework's client, so
# the script runs in a core domain defined here, as the Wi-Fi network script
# does. The domain sets no time zone property: system_server writes
# persist.sys.timezone, and the only property the domain sets is its own marker.
type kernarium_time_zone, domain;
typeattribute kernarium_time_zone coredomain;
type kernarium_time_zone_exec, exec_type, system_file_type, file_type;

init_daemon_domain(kernarium_time_zone)
binder_use(kernarium_time_zone)

# The shell script, and getprop, log and sleep from the toolbox.
allow kernarium_time_zone shell_exec:file rx_file_perms;
allow kernarium_time_zone toolbox_exec:file rx_file_perms;
# cmd runs in the script's domain.
allow kernarium_time_zone system_file:file execute_no_trans;

# cmd finds the settings and alarm services and hands them the descriptors it
# writes the output to and the binder it receives the result on: the
# descriptors are the script's own. Without the binder transfer the service
# never gets the command, and without the call back to that binder cmd never
# learns the command is done.
allow kernarium_time_zone settings_service:service_manager find;
allow kernarium_time_zone alarm_service:service_manager find;
allow kernarium_time_zone system_server:binder transfer;
allow system_server kernarium_time_zone:binder call;
allow system_server kernarium_time_zone:fd use;
allow system_server kernarium_time_zone:fifo_file { getattr read write };

# The zone the script applied last. A zone that differs from it was chosen by
# the user, which the script never replaces.
system_internal_prop(kernarium_time_zone_prop)
set_prop(kernarium_time_zone, kernarium_time_zone_prop)
