# Saves the virtual Wi-Fi network once the system is up.
/(system_ext|system/system_ext)/bin/kernarium_wifi_network\.sh  u:object_r:kernarium_wifi_network_exec:s0

# Gives back the memory of the cached boot-started apps once boot has settled.
/(system_ext|system/system_ext)/bin/kernarium_reclaim_boot_apps\.sh  u:object_r:kernarium_reclaim_boot_apps_exec:s0

# Applies the host's time zone once the system is up.
/(system_ext|system/system_ext)/bin/kernarium_time_zone\.sh  u:object_r:kernarium_time_zone_exec:s0
