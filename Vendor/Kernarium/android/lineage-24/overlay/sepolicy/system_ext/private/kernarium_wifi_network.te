# SPDX-License-Identifier: Apache-2.0
#
# After boot completes the product saves its virtual Wi-Fi network once
# (tools/kernarium_wifi_network.sh): `cmd wifi add-network` calls the Wi-Fi
# service. A vendor domain may neither execute /system/bin/cmd nor be the
# framework's client, so the script runs in a core domain defined here, the way
# Cuttlefish's automotive Ethernet setup does.
type kernarium_wifi_network, domain;
typeattribute kernarium_wifi_network coredomain;
type kernarium_wifi_network_exec, exec_type, system_file_type, file_type;

init_daemon_domain(kernarium_wifi_network)
binder_use(kernarium_wifi_network)

# The shell script, and getprop, setprop, grep and sleep from the toolbox.
allow kernarium_wifi_network shell_exec:file rx_file_perms;
allow kernarium_wifi_network toolbox_exec:file rx_file_perms;
# cmd runs in the script's domain.
allow kernarium_wifi_network system_file:file execute_no_trans;

# cmd finds the Wi-Fi service and hands it the descriptors it writes the
# command's output to and the binder it receives the command's result on: the
# descriptors are the script's own. Without the binder transfer the Wi-Fi
# service never gets the command, and without the call back to that binder
# cmd never learns the command is done: it waits for ever, so the script never
# sets its marker.
allow kernarium_wifi_network wifi_service:service_manager find;
allow kernarium_wifi_network system_server:binder transfer;
allow system_server kernarium_wifi_network:binder call;
allow system_server kernarium_wifi_network:fd use;
allow system_server kernarium_wifi_network:fifo_file { getattr read write };

# The marker that the network was saved.
system_internal_prop(kernarium_wifi_network_prop)
set_prop(kernarium_wifi_network, kernarium_wifi_network_prop)
get_prop(kernarium_wifi_network, kernarium_wifi_network_prop)
