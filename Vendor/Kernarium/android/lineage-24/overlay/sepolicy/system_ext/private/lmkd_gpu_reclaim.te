# SPDX-License-Identifier: Apache-2.0
#
# lmkd's GPU-aware reclaim (route p0027) opens the host's report of graphics
# memory pressure for reading and writing. The vendor's genfs_contexts labels
# the virtio-gpu device's whole sysfs tree sysfs_gpu, and the platform lets
# every domain search only the default sysfs label, so lmkd needs the search on
# the directories that lead to the file.
allow lmkd sysfs_gpu:dir search;
allow lmkd sysfs_gpu_memory:file rw_file_perms;
