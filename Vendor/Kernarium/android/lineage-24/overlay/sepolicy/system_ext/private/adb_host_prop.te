#
# adbd reports whether an adb host is connected, and product init holds a
# wakelock while one is (sys.kernarium.adb.host_connected). Two Treble rules
# decide the property's type:
#  - adbd is a core domain, which may set only a system-owned property, so the
#    property belongs to the system partitions;
#  - init parses a vendor script's `on property:` triggers as vendor_init, which
#    is a domain of its own and not a core domain, and drops a trigger whose
#    property vendor_init may not read ("unexported property trigger"). A
#    system_internal_prop forbids that read by neverallow.
# A system_public_prop is system-owned and readable by the vendor.
system_public_prop(kernarium_adb_host_prop)

set_prop(adbd, kernarium_adb_host_prop)
get_prop(vendor_init, kernarium_adb_host_prop)
