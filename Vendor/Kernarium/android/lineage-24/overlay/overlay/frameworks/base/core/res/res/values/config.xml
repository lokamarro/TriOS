<resources>
    <!-- The product boots straight to the home screen, but its lock screen can
         be turned on: LockPatternUtils.isLockScreenDisabled ORs this flag with
         the stored lockscreen.disabled value, so a true flag would keep a swipe
         lock screen off whatever `locksettings set-disabled false` or the
         Settings app sets. The default lives in ro.lockscreen.disable.default
         (lineage_andarium.mk), which seeds the stored value when the lock
         settings database is created. -->
    <bool name="config_disableLockscreenByDefault">false</bool>

    <!-- The power manager's FaceDownDetector turns the screen off when the device is laid face
         down. While it is enabled it holds an accelerometer connection (every 200 ms, batched)
         for as long as the screen is on, whatever runs in the guest, so the host keeps reading its
         motion sensor. The guest is a window or a full-screen scene, never a phone on a table.
         FaceDownDetector.isEnabled requires this resource, its DeviceConfig switch
         (attention_manager_service/enable_flip_to_screen_off, default true) and a test override
         to be true, and it registers no sensor listener while any is false. -->
    <bool name="config_flipToScreenOffEnabled">false</bool>
    <integer name="config_audio_notif_vol_default">7</integer>
    <integer name="config_audio_ring_vol_default">7</integer>

    <!-- The guest's clock is the host's, so the platform gets no network time.
         NetworkTimeUpdateService polls NTP whenever a default network exists, whatever
         config_autoTimeSourcesPriority says, and NtpTrustedTime takes its servers from
         config_ntpServers. An entry that is not an ntp:// URI is the one value that leaves
         it without a server: it rejects the list and refreshes nothing before any lookup.
         (An empty list makes NtpConfig throw in system_server.) LineageOS also names servers
         for mcc 460, which overlay-priority/.../values-mcc460 replaces. -->
    <string-array name="config_ntpServers" translatable="false">
        <item>none</item>
    </string-array>
    <!-- The origins drop the network too. An empty list means the platform default, which
         holds the network, and telephony alone would make the platform drop "Set time
         automatically" on a device without telephony; external keeps it supported. -->
    <string-array name="config_autoTimeSourcesPriority" translatable="false">
        <item>telephony</item>
        <item>external</item>
    </string-array>
</resources>
