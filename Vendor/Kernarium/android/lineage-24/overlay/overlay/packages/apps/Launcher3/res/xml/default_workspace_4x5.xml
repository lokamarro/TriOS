     Derived from the Android Open Source Project's default_workspace_4x5.xml.
     The stock layout names Google applications and widgets that the image does
     not ship, so a fresh guest lost most of its items. This layout keeps one
     empty workspace page and puts Files and Settings in the dock, centred in
     its 4 slots. The other applications with a launcher activity (Calendar,
     Gallery, Music and Calculator) stay installed and are in the app drawer. A
     component is named by package and class, and no entry names a string, a
     widget or an application the image does not ship.
-->

<favorites xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher3">

    <!-- Dock, 4 slots: the rank of an item is its screen and its column -->
    <!-- Files (DocumentsUI) -->
    <favorite
        launcher:packageName="com.android.documentsui"
        launcher:className="com.android.documentsui.LauncherActivity"
        launcher:container="-101"
        launcher:screen="1"
        launcher:x="1"
        launcher:y="0" />

    <!-- Settings -->
    <favorite
        launcher:packageName="com.android.settings"
        launcher:className="com.android.settings.Settings"
        launcher:container="-101"
        launcher:screen="2"
        launcher:x="2"
        launcher:y="0" />

</favorites>
