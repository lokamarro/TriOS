<resources>
    <!--
        SimpleDeviceConfig applies configs_base (LineageOS sets it) and then configs_device
        to DeviceConfig at every boot, so a device entry wins over LineageOS's.

        privacy/discrete_history_ops_cslist is the list of app ops that the app-ops service
        records into its discrete history. LineageOS replaces AOSP's default with a list from
        Android 12 that lacks every op added since (the health, sensor and trigger-audio reads,
        the emergency location, OP_RESERVED_FOR_TESTING) and the ops DiscreteOpsRegistry
        records for security (OP_GPS, OP_ACCESS_NOTIFICATIONS, OP_RUN_IN_BACKGROUND, the
        accessibility and device identifier ops, the location monitors). An op that is not
        listed never reaches the history, so the CTS tests of the historical registry never
        see their test op. This list is LineageOS's united with the ops of AOSP's default
        (LEGACY_OPS and IMPORTANT_OPS_FOR_SECURITY in DiscreteOpsRegistry.java), and the
        target-files verifier requires the installed overlay to cover the default.
    -->
    <string-array name="configs_device">
        <item>privacy/discrete_history_ops_cslist=0,1,2,4,5,6,7,8,9,13,14,16,18,19,20,25,26,27,41,42,51,52,53,54,57,59,60,62,63,65,69,73,74,77,79,88,89,90,100,101,102,106,108,109,111,112,113,114,120,136,141,147,149,150,152,170,171,172,173</item>
    </string-array>
</resources>
