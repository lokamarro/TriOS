<!--
     SPDX-FileCopyrightText: 2016 The CyanogenMod Project
     SPDX-FileCopyrightText: The LineageOS Project

     Derived from LineageOS's lineage_wizard_script.xml. The pages this product
     shows are Welcome, Language, Date and time and Theme; every other page of
     LineageOS's flow is left out. The README of the Android release names the
     reason for each. Theme is the last page: its Finish button ends the wizard,
     so the script has no closing page.
-->
<WizardScript xmlns:wizard="http://schemas.android.com/apk/res/com.google.android.setupwizard"
    wizard:firstAction="welcome">

    <WizardAction
        id="welcome"
        wizard:uri="intent:#Intent;action=org.lineageos.setupwizard.LINEAGE_WELCOME;end">
        <result
            wizard:name="skip"
            wizard:resultCode="1" />
        <result wizard:action="locale" />
    </WizardAction>

    <WizardAction
        id="locale"
        wizard:uri="intent:#Intent;action=org.lineageos.setupwizard.LINEAGE_LOCALE;end">
        <result wizard:action="datetime" />
    </WizardAction>

    <WizardAction
        id="datetime"
        wizard:uri="intent:#Intent;action=org.lineageos.setupwizard.LINEAGE_DATETIME;end">
        <result wizard:action="theme_settings" />
    </WizardAction>

    <WizardAction
        id="theme_settings"
        wizard:uri="intent:#Intent;action=org.lineageos.setupwizard.THEME_SETTINGS;end" />

</WizardScript>
