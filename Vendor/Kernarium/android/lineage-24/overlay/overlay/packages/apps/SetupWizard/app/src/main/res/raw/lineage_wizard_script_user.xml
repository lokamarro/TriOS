     SPDX-FileCopyrightText: 2016 The CyanogenMod Project
     SPDX-FileCopyrightText: The LineageOS Project

     Derived from LineageOS's lineage_wizard_script_user.xml, which the wizard
     runs for a secondary user. The pages shown are Welcome and Theme, and the
     Finish button of Theme ends the wizard.
-->
<WizardScript xmlns:wizard="http://schemas.android.com/apk/res/com.google.android.setupwizard"
    wizard:firstAction="welcome">

    <WizardAction
        id="welcome"
        wizard:uri="intent:#Intent;action=org.lineageos.setupwizard.LINEAGE_WELCOME;end">
        <result
            wizard:name="skip"
            wizard:resultCode="1" />
        <result wizard:action="theme_settings" />
    </WizardAction>

    <WizardAction
        id="theme_settings"
        wizard:uri="intent:#Intent;action=org.lineageos.setupwizard.THEME_SETTINGS;end" />

</WizardScript>
