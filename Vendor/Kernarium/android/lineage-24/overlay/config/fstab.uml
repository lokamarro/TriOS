# SPDX-License-Identifier: Apache-2.0
# Fixed GPT partitions exposed by the Darwin UML UBD device. The five read-only
# partitions are compressed EROFS: read-only by nature, so no mount options
# beyond ro.
/dev/block/by-name/system /system erofs ro wait,first_stage_mount
/dev/block/by-name/system_ext /system_ext erofs ro wait,first_stage_mount
/dev/block/by-name/product /product erofs ro wait,first_stage_mount
/dev/block/by-name/vendor /vendor erofs ro wait,first_stage_mount
/dev/block/by-name/odm /odm erofs ro wait,first_stage_mount
/dev/block/by-name/metadata /metadata ext4 nodev,noatime,nosuid,discard wait,check,formattable,first_stage_mount
/dev/block/by-name/metadata /metadata ext4 nodev,noatime,nosuid,discard wait,check,first_stage_mount
# Static non-A/B storage uses neither userdata checkpointing nor BootControl.
# `quota` has fs_mgr turn on ext4 user, group and project quota (tune2fs -Oquota) before
# the check; installd answers StorageStatsManager from it.
/dev/block/by-name/userdata /data ext4 nodev,noatime,nosuid,discard,errors=panic latemount,wait,check,quota,formattable
/dev/block/by-name/userdata /data ext4 nodev,noatime,nosuid,discard,errors=panic latemount,reservedsize=128M,wait,check,quota
/dev/block/by-name/misc /misc emmc defaults defaults
# Compressed swap, half of RAM, turned on by init.kernarium.rc once boot completes
# (swapon_all): the cached apps' anonymous memory compresses about 4:1 there, and
# the guest keeps the pages the launcher workload refaults.
/dev/block/zram0 none swap defaults zramsize=50%
