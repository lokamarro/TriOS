# SPDX-License-Identifier: Apache-2.0
# AOSP recovery sees the same fixed, non-A/B GPT as normal Android.
/dev/block/by-name/system /system erofs ro wait
/dev/block/by-name/system_ext /system_ext erofs ro wait
/dev/block/by-name/product /product erofs ro wait
/dev/block/by-name/vendor /vendor erofs ro wait
/dev/block/by-name/odm /odm erofs ro wait
/dev/block/by-name/metadata /metadata ext4 nodev,noatime,nosuid wait,check,formattable
/dev/block/by-name/userdata /data ext4 nodev,noatime,nosuid,errors=panic wait,check,formattable
/dev/block/by-name/misc /misc emmc defaults defaults
/dev/block/by-name/recovery /recovery emmc defaults defaults
