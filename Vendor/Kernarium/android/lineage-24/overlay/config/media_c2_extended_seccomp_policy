# The Codec2 service of the V4L2 encoders runs under the minijail policy of
# android.hardware.media.c2-default-seccomp_policy, which the service installs
# for the architecture. The service reads this file beside it, and it adds the
# calls the V4L2 device and the threads of the encoder need beyond that
# policy. The product installs it as
# /vendor/etc/seccomp_policy/android.hardware.media.c2-extended-seccomp_policy.

# The device poller wakes its thread through an eventfd and waits on epoll.
eventfd2: 1
epoll_create1: 1
epoll_ctl: 1
epoll_pwait: 1
pselect6: 1

# The device scan reads /dev and its file systems, and libc asks for the system.
statfs: 1
getcwd: 1
sysinfo: 1

# The crash handler of debuggerd runs in the service when it faults, and the
# default policy lacks the calls it makes, so a fault of the service ends in
# SIGSYS with no tombstone to show it.
getppid: 1
recvfrom: 1
setsockopt: 1
uname: 1
