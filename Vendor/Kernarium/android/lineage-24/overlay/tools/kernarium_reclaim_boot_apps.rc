# Gives back the memory of the cached boot-started apps once boot has settled
# (kernarium_reclaim_boot_apps.sh waits before it acts).
service kernarium_reclaim_boot_apps /system_ext/bin/kernarium_reclaim_boot_apps.sh
    user root
    group shell
    oneshot
    disabled

on property:sys.boot_completed=1
    start kernarium_reclaim_boot_apps
