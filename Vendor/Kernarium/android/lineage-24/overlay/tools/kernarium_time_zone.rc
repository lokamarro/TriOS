# SPDX-License-Identifier: Apache-2.0
# Applies the host's time zone once the system is up (kernarium_time_zone.sh).
service kernarium_time_zone /system_ext/bin/kernarium_time_zone.sh
    user root
    group shell
    oneshot
    disabled

on property:sys.boot_completed=1
    start kernarium_time_zone
