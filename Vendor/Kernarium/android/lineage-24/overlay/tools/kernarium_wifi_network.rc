# SPDX-License-Identifier: Apache-2.0
# Saves the virtual Wi-Fi network once the system is up (kernarium_wifi_network.sh).
service kernarium_wifi_network /system_ext/bin/kernarium_wifi_network.sh
    user root
    group shell
    oneshot
    disabled

on property:sys.boot_completed=1
    start kernarium_wifi_network
