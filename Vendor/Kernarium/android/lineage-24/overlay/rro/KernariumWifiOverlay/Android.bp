package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// The Wi-Fi module's resources live in an APEX, so an explicit overlay module
// is the only way to change them; PRODUCT_PACKAGE_OVERLAYS cannot reach them.
runtime_resource_overlay {
    name: "KernariumWifiOverlay",
    resource_dirs: ["res"],
    vendor: true,
    sdk_version: "current",
}
