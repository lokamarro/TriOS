From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 27 Sep 2026 08:31:58 +0900
Subject: [PATCH] convert: pass Meson's C arguments to C sources only

Meson compiles C sources with a target's C arguments and C++ sources
with its C++ arguments. The Soong backend emitted the C arguments as
cflags, which Soong passes to C and C++ sources alike, so every C++
source was also compiled with the C arguments.

Mesa's C arguments include -Werror=missing-prototypes, which its C++
sources do not satisfy, and define macros that its C++ arguments
define differently. Converted, its C++ sources failed with
-Wmissing-prototypes and -Wmacro-redefined. Emit the C arguments as
conlyflags.
---
 mesonbuild/convert/build_systems/soong/emitter.py | 2 +-
 mesonbuild/convert/build_systems/soong/state.py   | 2 +-
 mesonbuild/convert/build_systems/target.py        | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/mesonbuild/convert/build_systems/soong/emitter.py b/mesonbuild/convert/build_systems/soong/emitter.py
index 70aac7983ad0dd73f4c80a225d82bcf4de4cfef0..94723c49d86f424d1d4e0b9c65ddbe7ce6249496 100644
--- a/mesonbuild/convert/build_systems/soong/emitter.py
+++ b/mesonbuild/convert/build_systems/soong/emitter.py
@@ -97,7 +97,7 @@ SOONG_ATTR_MAP: T.Dict[ConvertAttr, str] = {
     # Soong-specific attributes
     ConvertAttr.SOONG_APEX_AVAILABLE: 'apex_available',
     ConvertAttr.SOONG_BINDGEN_FLAGS: 'bindgen_flags',
-    ConvertAttr.SOONG_CFLAGS: 'cflags',
+    ConvertAttr.SOONG_CONLYFLAGS: 'conlyflags',
     ConvertAttr.SOONG_CPPFLAGS: 'cppflags',
     ConvertAttr.SOONG_CPP_STD: 'cpp_std',
     ConvertAttr.SOONG_C_STD: 'c_std',
diff --git a/mesonbuild/convert/build_systems/soong/state.py b/mesonbuild/convert/build_systems/soong/state.py
index ae85fb4471916bea08b908659fb96180b0310c59..cbd413b41ddc6dd01327d6f37c137f75e37e35ac 100644
--- a/mesonbuild/convert/build_systems/soong/state.py
+++ b/mesonbuild/convert/build_systems/soong/state.py
@@ -164,7 +164,7 @@ class SoongBackend(ConvertBackend):
             target.project_native_args = True
 
         if instance.language == 'c':
-            target.get_attribute_node(ConvertAttr.SOONG_CFLAGS).add_conditional_values(
+            target.get_attribute_node(ConvertAttr.SOONG_CONLYFLAGS).add_conditional_values(
                 label, instance.compile_args
             )
         elif instance.language == 'cpp':
diff --git a/mesonbuild/convert/build_systems/target.py b/mesonbuild/convert/build_systems/target.py
index e826f74582418e611fbb5f392e037402101b7345..8fc2e489b3e349f2714fd742ef0bb1c4f58cd91a 100644
--- a/mesonbuild/convert/build_systems/target.py
+++ b/mesonbuild/convert/build_systems/target.py
@@ -31,7 +31,7 @@ class ConvertAttr(Enum):
     # Soong-specific attributes (101-200)
     SOONG_APEX_AVAILABLE = 101
     SOONG_BINDGEN_FLAGS = 102
-    SOONG_CFLAGS = 103
+    SOONG_CONLYFLAGS = 103
     SOONG_CPPFLAGS = 104
     SOONG_CPP_STD = 105
     SOONG_C_STD = 106
