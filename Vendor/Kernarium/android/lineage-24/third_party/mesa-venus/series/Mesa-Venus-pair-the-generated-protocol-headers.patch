+/* struct VkAccelerationStructureCreateInfo2KHR chain */
+
+static inline size_t
+vn_sizeof_VkAccelerationStructureCreateInfo2KHR_pnext(const void *val)
+{
+    /* no known/supported struct */
+    return vn_sizeof_simple_pointer(NULL);
+}
+
+static inline size_t
+vn_sizeof_VkAccelerationStructureCreateInfo2KHR_self(const VkAccelerationStructureCreateInfo2KHR *val)
+{
+    size_t size = 0;
+    /* skip val->{sType,pNext} */
+    size += vn_sizeof_VkFlags(&val->createFlags);
+    size += vn_sizeof_VkDeviceAddressRangeKHR(&val->addressRange);
+    size += vn_sizeof_VkFlags(&val->addressFlags);
+    size += vn_sizeof_VkAccelerationStructureTypeKHR(&val->type);
+    return size;
+}
+
+static inline size_t
+vn_sizeof_VkAccelerationStructureCreateInfo2KHR(const VkAccelerationStructureCreateInfo2KHR *val)
+{
+    size_t size = 0;
+
+    size += vn_sizeof_VkStructureType(&val->sType);
+    size += vn_sizeof_VkAccelerationStructureCreateInfo2KHR_pnext(val->pNext);
+    size += vn_sizeof_VkAccelerationStructureCreateInfo2KHR_self(val);
+
+    return size;
+}
+
+static inline void
+vn_encode_VkAccelerationStructureCreateInfo2KHR_pnext(struct vn_cs_encoder *enc, const void *val)
+{
+    /* no known/supported struct */
+    vn_encode_simple_pointer(enc, NULL);
+}
+
+static inline void
+vn_encode_VkAccelerationStructureCreateInfo2KHR_self(struct vn_cs_encoder *enc, const VkAccelerationStructureCreateInfo2KHR *val)
+{
+    /* skip val->{sType,pNext} */
+    vn_encode_VkFlags(enc, &val->createFlags);
+    vn_encode_VkDeviceAddressRangeKHR(enc, &val->addressRange);
+    vn_encode_VkFlags(enc, &val->addressFlags);
+    vn_encode_VkAccelerationStructureTypeKHR(enc, &val->type);
+}
+
+static inline void
+vn_encode_VkAccelerationStructureCreateInfo2KHR(struct vn_cs_encoder *enc, const VkAccelerationStructureCreateInfo2KHR *val)
+{
+    assert(val->sType == VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_CREATE_INFO_2_KHR);
+    vn_encode_VkStructureType(enc, &(VkStructureType){ VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_CREATE_INFO_2_KHR });
+    vn_encode_VkAccelerationStructureCreateInfo2KHR_pnext(enc, val->pNext);
+    vn_encode_VkAccelerationStructureCreateInfo2KHR_self(enc, val);
+}
+
 static inline size_t vn_sizeof_vkDestroyAccelerationStructureKHR(VkDevice device, VkAccelerationStructureKHR accelerationStructure, const VkAllocationCallbacks* pAllocator)
 {
     const VkCommandTypeEXT cmd_type = VK_COMMAND_TYPE_vkDestroyAccelerationStructureKHR_EXT;
@@ -398,7 +457,7 @@ static inline size_t vn_sizeof_vkCopyAccelerationStructureKHR_reply(VkDevice dev
     const VkCommandTypeEXT cmd_type = VK_COMMAND_TYPE_vkCopyAccelerationStructureKHR_EXT;
     size_t cmd_size = vn_sizeof_VkCommandTypeEXT(&cmd_type);
 
