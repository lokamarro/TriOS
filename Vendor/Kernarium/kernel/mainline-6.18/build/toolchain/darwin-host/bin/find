#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Linux's upstream gen_initramfs.sh uses the two GNU find -printf formats
# below. Darwin's find has no -printf, so translate only those calls and leave
# every other invocation to the system utility. Keeping this adapter outside
# Linux avoids carrying host-package-manager policy in the kernel patch set.
set -eu

SYSTEM_FIND=/usr/bin/find
SYSTEM_STAT=/usr/bin/stat

if [ "$(uname -s)" != Darwin ]; then
	exec "$SYSTEM_FIND" "$@"
fi

if [ "$#" -eq 3 ] && [ "$2" = -printf ]; then
	case "$3" in
	'%T@\n')
		exec "$SYSTEM_FIND" "$1" -exec "$SYSTEM_STAT" -f \
			'%m.0000000000' '{}' +
		;;
	'%p %m %U %G\n')
		exec "$SYSTEM_FIND" "$1" -exec "$SYSTEM_STAT" -f \
			'%N %Lp %u %g' '{}' +
		;;
	esac
fi

exec "$SYSTEM_FIND" "$@"
