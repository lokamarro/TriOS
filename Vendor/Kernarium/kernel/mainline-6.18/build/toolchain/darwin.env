# SPDX-License-Identifier: GPL-2.0-or-later
#
# Portable defaults for the out-of-tree Darwin UML Kbuild invocation.  Set any
# value in the environment before running
# kernel/mainline-6.18/build/build-kernel.sh; no Homebrew installation path is
# baked into the project.
: "${UML_KERNEL_MAKE:=gmake}"
: "${UML_KERNEL_CC:=clang}"
: "${UML_KERNEL_HOST_CC:=$UML_KERNEL_CC}"
: "${UML_KERNEL_LD:=ld.lld}"
# Darwin UML produces a native arm64 Mach-O executable, not a Linux
# cross-target. Leave the prefix empty unless a host toolchain genuinely needs
# one; a nonexistent default prefix would make Kbuild invoke a missing ar.
: "${UML_KERNEL_CROSS_COMPILE:=}"
: "${UML_KERNEL_AR:=}"
: "${UML_KERNEL_NM:=}"
: "${UML_KERNEL_OBJCOPY:=}"
: "${UML_KERNEL_OBJDUMP:=}"
: "${UML_KERNEL_READELF:=}"
: "${UML_KERNEL_STRIP:=}"
# Use every online host processor unless the caller requests a smaller explicit
# limit. getconf is the portable first choice and works on supported Apple
# hosts; sysctl is a Darwin fallback for reduced environments.
if [ -z "${UML_KERNEL_JOBS:-}" ]; then
	UML_KERNEL_JOBS=''
	if command -v getconf >/dev/null 2>&1; then
		UML_KERNEL_JOBS=$(getconf _NPROCESSORS_ONLN 2>/dev/null) ||
			UML_KERNEL_JOBS=''
	fi
	case "$UML_KERNEL_JOBS" in
	*[!0-9]*|'')
		if command -v sysctl >/dev/null 2>&1; then
			UML_KERNEL_JOBS=$(sysctl -n hw.logicalcpu 2>/dev/null) ||
				UML_KERNEL_JOBS=''
		fi
		;;
	esac
	case "$UML_KERNEL_JOBS" in
	*[!0-9]*|''|0) UML_KERNEL_JOBS=1 ;;
	esac
fi
# BTF generation uses pahole and the static libelf built from pinned sources
# by dependencies/build-kernel-host-tools.sh. The build never searches PATH
# for either.
: "${UML_KERNEL_HOST_TOOLS_PREFIX:=$ROOT_DIR/.build/dependencies/kernel-host-tools}"
: "${UML_KERNEL_PAHOLE:=$UML_KERNEL_HOST_TOOLS_PREFIX/bin/pahole}"
: "${UML_KERNEL_EXTRA_HOST_CFLAGS:=}"
: "${UML_KERNEL_EXTRA_HOST_CXXFLAGS:=}"
# Set UML_KERNEL_LLVM to 1 or a tool-prefix only when the installed Kbuild
# toolchain needs LLVM's aggregate selector.  Empty is intentionally valid.
: "${UML_KERNEL_LLVM:=}"
