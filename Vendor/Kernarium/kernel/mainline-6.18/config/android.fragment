# SPDX-License-Identifier: GPL-2.0-or-later
# The Android product's overlay on the shared Darwin UML kernel policy in
# kernel/common/config/darwin-uml.fragment. It replaces config/mainline.fragment
# for that product and lists only the settings in which the Android product
# differs from the Linux desktop one. build/build-kernel.sh --product android
# applies it after the shared policy, then runs `olddefconfig`.

# --- Boot, init, and image identity -----------------------------------------
# Android init consumes bootconfig when one is supplied by the image builder.
CONFIG_BOOT_CONFIG=y

# --- Block devices and the storage stack ------------------------------------
# Android's file-based encryption can use inline encryption. UML's UBD device
# has no hardware inline-encryption capability, so the block-crypto software
# fallback and the fscrypt hooks must be built into the one signed kernel ELF.
# The product's userdata is not encrypted, and the ACK-only dm-default-key
# target that metadata encryption would need is not carried.
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y

# --- Root and general-purpose filesystems -----------------------------------
CONFIG_UNICODE=y
# The CTS requires that no NFS client filesystem is registered.
# CONFIG_NFS_FS is not set
# Android never mounts XFS, Btrfs or an SMB share: its partitions are ext4 and
# erofs, shared storage is FUSE, and vold mounts removable media as vfat or
# exfat. The desktop product keeps all three. Without them the image drops
# their code and the guest starts no cifsiod or smb3decryptd worker.
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_CIFS is not set
# CONFIG_CIFS_XATTR is not set
# MediaProvider serves shared storage through FUSE and names the file under
# each FUSE path, so that an app's FileObserver sees the changes MediaProvider
# and other writers make to the underlying file. The desktop product's FUSE
# servers do not implement the request.
CONFIG_FUSE_CANONICAL_PATH=y

# --- Android memory, IPC, and allocator interfaces -------------------------
# Android 17 shares memory through memfd: the product sets sys.use_memfd, and
# libcutils' ashmem_create_region() then creates a memfd. The ACK-only ashmem
# driver, which is Rust and lives in staging, is not carried, so /dev/ashmem
# does not exist. The SELinux memfd_class capability the policy requires comes
# from the mainline overlay's memfd topic.
CONFIG_MEMFD_CREATE=y
CONFIG_ANON_VMA_NAME=y
# Match the Android 17 GKI policy: seal userspace's system mappings instead of
# enabling checkpoint/restore, whose Kconfig dependency excludes this feature.
# The mainline overlay keeps checkpoint/restore for Linux guests.
CONFIG_MSEAL_SYSTEM_MAPPINGS=y
# Use the established C Binder implementation. Binderfs and the three standard
# contexts are built in; no Binder implementation may be a loadable module.
CONFIG_ANDROID_BINDER_IPC=y
# CONFIG_ANDROID_BINDER_IPC_RUST is not set
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# Android graphics allocates shareable buffers through the system DMA-BUF heap.
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
# CONFIG_DMABUF_HEAPS_CMA is not set
CONFIG_VIRTIO_DMA_SHARED_BUFFER=y

# --- Processes, scheduling, and namespaces ----------------------------------
# CONFIG_CHECKPOINT_RESTORE is not set
# Android implements no SysV IPC: its CTS and Bionic tests expect ENOSYS from
# the msg, sem and shm calls and no /proc/sysvipc.
# CONFIG_SYSVIPC is not set
# system_server moves apps between the cpu, cpuset and blkio groups of its
# scheduling classes without running as root. Without this every move fails
# with EACCES and apps never leave the groups their zygote child gave them.
CONFIG_CGROUP_V1_ATTACH_SYS_NICE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_TASK_DELAY_ACCT=y
# Match the Android 17 GKI policy, which leaves auxiliary POSIX clocks unset.
# With them, clock IDs 16 to 23 name the auxiliary clocks, so timer_create()
# on clock 16 fails EOPNOTSUPP where Bionic's time.timer_create_EINVAL and the
# CTS expect EINVAL.
# CONFIG_POSIX_AUX_CLOCKS is not set
# Utilization clamping is tied to a physical CPU-frequency governor. UML has
# no cpufreq device and schedules fixed virtual CPUs on host carriers, so these
# controls cannot provide their advertised semantics.
# CONFIG_UCLAMP_TASK is not set
# CONFIG_UCLAMP_TASK_GROUP is not set

# --- Core networking --------------------------------------------------------
# Android has no use for SCTP, which the Linux product keeps.
# CONFIG_IP_SCTP is not set
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_ROUTER_PREF=y
# Android's network statistics path calls synchronizeKernelRCU(), which opens
# and immediately closes an AF_KEY socket purely so that pfkey_release() runs
# synchronize_rcu(). Without PF_KEY the socket() call fails EAFNOSUPPORT and
# BatteryStatsImpl.readWifiNetworkStatsLocked throws a fatal exception in the
# system process, restarting the runtime before boot completes.
CONFIG_NET_KEY=y
CONFIG_XFRM_INTERFACE=y
CONFIG_XFRM_STATISTICS=y
# Android's IKE daemon and the CTS reserve one SPI for the local and the remote
# outer address of an IPsec tunnel. Linux 6.17 refuses that (it made an SPI
# unique per protocol, whatever the destination), and the Android common kernel
# reverts the change, so the allocator here is the older one. The Linux product
# keeps the stricter check.
CONFIG_XFRM_SPI_PER_DESTINATION=y
# netd closes a network's sockets through SOCK_DESTROY when the network goes
# away, so apps and adb reconnect on the new one. GKI enables it in
# gki_defconfig.
CONFIG_INET_DIAG_DESTROY=y

# --- Netfilter and container networking -------------------------------------
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_ESP=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y
# netd's data-usage quotas and alerts (-m quota2, with its alert on the
# NETLINK_NFLOG socket).
CONFIG_NETFILTER_XT_MATCH_QUOTA2=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_MATCH_TIME=y
CONFIG_NETFILTER_XT_MATCH_U32=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
# netd passes --send_nl_msg, so its interface idle timers send uevents.
CONFIG_NETFILTER_XT_TARGET_IDLETIMER_NL_MSG=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NETFILTER_XT_TARGET_NOTRACK=y
CONFIG_NETFILTER_XT_TARGET_SECMARK=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_SECURITY=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_TARGET_REJECT=y
# The rest of Android's base configuration for networking
# (kernel/configs/b/android-6.12/android-base.config, the newest list, since
# the android-6.18 one is empty): netd's rules, the platform VPN's IPsec
# transforms and the traffic control the Tethering module and clatd load their
# BPF programs into.
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
CONFIG_NETFILTER_XT_MATCH_HELPER=y
CONFIG_NETFILTER_XT_MATCH_MAC=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=y
CONFIG_NETFILTER_XT_TARGET_CONNSECMARK=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
CONFIG_NF_CONNTRACK_AMANDA=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_H323=y
CONFIG_NF_CONNTRACK_IRC=y
CONFIG_NF_CONNTRACK_NETBIOS_NS=y
CONFIG_NF_CONNTRACK_PPTP=y
CONFIG_NF_CONNTRACK_SANE=y
CONFIG_NF_CONNTRACK_SECMARK=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_IP_NF_ARPTABLES=y
CONFIG_IP_NF_ARPFILTER=y
CONFIG_IP_NF_ARP_MANGLE=y
CONFIG_IP_NF_MATCH_ECN=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_IP_NF_MATCH_TTL=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_INET6_IPCOMP=y
CONFIG_IPV6_MIP6=y
CONFIG_IPV6_VTI=y
CONFIG_NET_IPVTI=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_XFRM_MIGRATE=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_XCBC=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_EMATCH=y
CONFIG_NET_EMATCH_U32=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NET_ACT_POLICE=y
CONFIG_IFB=y
# The base configuration leaves IPv6 NAT out.
# CONFIG_IP6_NF_NAT is not set

# --- Virtual Wi-Fi ----------------------------------------------------------
# Android's Wi-Fi framework (wificond, the supplicant and the Wi-Fi HAL) talks
# to an nl80211 interface. virt_wifi puts a station interface over an Ethernet
# device, with one fake open access point named VirtWifi, so that the guest
# has Wi-Fi without a radio. Only this product has such a framework; the Linux
# product keeps the code out (kernel/mainline-6.18/README.md gives the cost).
CONFIG_CFG80211=y
CONFIG_VIRT_WIFI=y
# A signed regulatory database needs the host's OpenSSL for Kbuild's
# certs/extract-cert, and the product ships none, so cfg80211 stays on the
# world domain. Certification ONUS makes that choice allowed.
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_CFG80211_CRDA_SUPPORT is not set

# --- Android security policy ------------------------------------------------
# Android owns the SELinux policy and requires audit syscall records. Smack is
# mutually exclusive with SELinux and must never survive into this product.
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
# CONFIG_SECURITY_SELINUX_BOOTPARAM is not set
CONFIG_SECURITY_SELINUX_DEVELOP=y
# CONFIG_SECURITY_SMACK is not set
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,ipe,bpf"

# --- Display and input ------------------------------------------------------
# The Android macOS product exposes one standard single-port console as
# VIRTIO_ID_CONSOLE. Keep its hvc infrastructure in the signed ELF; loadable
# modules are unavailable on iOS.
CONFIG_HVC_DRIVER=y
# Android's composer scans out RGBA and RGBX buffers (ABGR8888 and XBGR8888)
# directly, so the Virtio-GPU primary plane must list the standard 32-bit RGB
# orders. The desktop product keeps the two-format plane its compositors
# choose from.
CONFIG_DRM_VIRTIO_GPU_STANDARD_FORMATS=y
# Android and its recovery enter pointer mode for an input device that also
# reports mouse buttons, so the Darwin display is presented as a pure direct
# touchscreen. The desktop product keeps the tablet's buttons and wheel.
CONFIG_UML_VNC_INPUT_TOUCHSCREEN=y
# Android's Bluetooth stack and the CTS input tests create HID devices through
# /dev/uhid, and hidraw gives apps and the HAL the raw reports. Both are in the
# Android base configuration.
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y

# --- Incremental install ----------------------------------------------------
CONFIG_INCREMENTAL_FS=y

# --- Kernel self-protection -------------------------------------------------
# Android runs no usermode helper from the kernel. With an empty path every
# call_usermodehelper() returns without starting anything, so a piped
# core_pattern, a key upcall or an orderly poweroff cannot make the kernel run
# a program as root. The CTS requires it.
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH=""

# The base configuration names the legacy dynticks symbol and the profiling
# hooks. The product already runs NO_HZ_IDLE from the shared policy.
CONFIG_NO_HZ=y
CONFIG_PROFILING=y
# The base configuration leaves out the handle system calls and the firmware
# cache; GKI follows it.
# CONFIG_FHANDLE is not set
# CONFIG_FW_CACHE is not set
# Panic on a corrupted list instead of continuing with it (LIST_HARDENED).
CONFIG_BUG_ON_DATA_CORRUPTION=y

# --- Suspend ----------------------------------------------------------------
# Android suspends itself whenever its wakelock count reaches zero. Its
# SystemSuspend service keeps those wakelocks in userspace, and when one is
# taken while the system is entering a suspend it writes "userspace-abort" to
# /sys/power/wake_lock to end that suspend; the zygote's init script writes
# zygote_kwl there when the zygote restarts. Without this option the file does
# not exist, so a wakelock taken while a suspend is under way cannot stop it.
# GKI builds it.
CONFIG_PM_WAKELOCKS=y

# --- Host battery -----------------------------------------------------------
# The Apple launcher provides a local experimental Virtio device carrying the
# host battery percentage and charging state. The built-in power-supply driver
# exposes it through the standard sysfs ABI consumed by Android's Health HAL.
CONFIG_POWER_SUPPLY=y
# No voltage, current, or temperature sensors exist behind this transport.
# CONFIG_POWER_SUPPLY_HWMON is not set
CONFIG_KERNARIUM_VIRTIO_BATTERY=y

# --- Tracing and diagnostics ------------------------------------------------
# Android's libmeminfo reads the gpu_mem_total BPF map and calls abort() from
# BpfMapRO::abortOnMismatch when the map is missing, so Debug.getGpuTotalUsageKb
# takes down system_server. The map only exists when the gpu_mem tracepoints are
# built, and the upstream help text states plainly that this is required for
# Android.
CONFIG_TRACE_GPU_MEM=y
