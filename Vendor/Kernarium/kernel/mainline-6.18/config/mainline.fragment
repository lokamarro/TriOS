# SPDX-License-Identifier: GPL-2.0-or-later
# The Linux desktop product's overlay on the shared Darwin UML kernel policy in
# kernel/common/config/darwin-uml.fragment. It lists only the settings in
# which that product differs from the Android one, android.fragment;
# build/build-kernel.sh applies it after the shared policy.

# Linux guests keep checkpoint/restore. Its Kconfig dependency excludes
# MSEAL_SYSTEM_MAPPINGS, which the Android product enables instead.
CONFIG_CHECKPOINT_RESTORE=y

# Smack is the validated choice for this port; changing it invalidates the
# recorded LTP results that depend on it.
CONFIG_SECURITY_SMACK=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,smack,ipe,bpf"

# Desktop software uses what Android leaves out. SysV IPC backs PostgreSQL,
# X11's MIT-SHM and most database and legacy IPC code. The NFS client backs
# NFS mounts, which the Android CTS forbids. SCTP carries telephony
# signalling, and creates no listener or service of its own; the SLiRP
# network never forwards it, so it joins endpoints inside the guest.
CONFIG_SYSVIPC=y
CONFIG_NFS_FS=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
CONFIG_IP_SCTP=y

# A desktop guest mounts the other general-purpose filesystems and network
# shares too: XFS and Btrfs on attached disks, SMB shares through the CIFS
# client. The Android product mounts none of them and leaves all three out
# (see android.fragment).
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=y
CONFIG_CIFS=y
CONFIG_CIFS_XATTR=y

# A container runtime with IPv6 enabled translates addresses on the IPv6 path
# as it does on the IPv4 one. Android's base configuration leaves IPv6 NAT out
# (see android.fragment).
CONFIG_IP6_NF_NAT=y

# Linux 6.17's auxiliary POSIX clocks, which LTP's timer_create02 covers. The
# Android product leaves them off, as GKI does (see android.fragment).
CONFIG_POSIX_AUX_CLOCKS=y

# Sxmo, which postmarketOS Linux guests run, suspends the guest on its own
# whenever /sys/power/wake_lock exists, and a desktop guest has no wakelock
# service to hold it awake. The Android product builds the file in (see
# android.fragment).
# CONFIG_PM_WAKELOCKS is not set

# A Linux guest's usermode helpers are its distribution's: systemd-coredump
# receives core dumps through a piped core_pattern, and the keyring, NFS
# idmapper and bridge STP upcalls run /sbin/request-key and /sbin/bridge-stp.
# A static helper path would stop all of them from running. The Android
# product, which has none of these, gives every helper an empty path (see
# android.fragment).
# CONFIG_STATIC_USERMODEHELPER is not set
