# SPDX-License-Identifier: GPL-2.0-or-later
# Opt-in diagnostic probe, applied last by `build-kernel.sh --lockdep`: lock
# dependency and hardirq-state checking, sleeping-in-atomic reports, and VM
# assertions. A kernel built with it is never an accepted artifact.
CONFIG_PROVE_LOCKING=y
CONFIG_TRACE_IRQFLAGS=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_VM=y
