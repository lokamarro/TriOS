From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Wed, 30 Sep 2026 22:53:47 +0900
Subject: [PATCH] arm64: describe the emulated x86 CPU in /proc/cpuinfo

The x86-userspace slice runs an arm64 kernel, so setup_arch asks the host
for its arm64 HWCAP and /proc/cpuinfo names arm64 features: an x86_64
guest reads "fp asimd aes pmull sha3" as its own CPU's feature list.

A great deal of software chooses instructions by reading this file rather
than by executing CPUID. Debian's chromium launcher greps it for sse3 and
refuses to start -- "the hardware on this system lacks support for the
sse3 instruction set" -- on an emulator whose CPUID advertises SSE3
through SSE4.2 and executes every one of them.

Report the CPU the guest actually runs on instead. The capability words
carry exactly what the emulator's CPUID gadget returns, the slice links
the generated x86 capflags so the bits are named the way x86 Linux names
them, and the identification lines gain the family, model, stepping and
brand string a reader of this file expects.

The kernel cannot execute CPUID to discover any of this, so the words
mirror darwin/cpu/x86_64/cpuid.hpp in the host emulator, as the arm64
slices mirror the emulator's MIDR_EL1. The host's x86-64-gadget-bootstrap
test executes the CPUID gadget for every leaf and fails if the emulator's
table and its gadget disagree. The slice builds none of the arm64
slices' /proc/cpuinfo printer.

CPUID leaf 7 subleaf 1 EAX bit 4 is AVX-VNNI, which the host now
reports and both x86 engines execute, so the emulated CPU's capability
word 12 carries it and /proc/cpuinfo lists avx_vnni.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/arm64/um/asm/cpufeatures.h | 11 +++++
 arch/um/kernel/Makefile         |  6 +++
 arch/um/kernel/um_arch.c        | 71 ++++++++++++++++++++++++++++++++-
 3 files changed, 86 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/um/asm/cpufeatures.h b/arch/arm64/um/asm/cpufeatures.h
index c224dfb5c3ac46768c8ac1e0304ee6224193df36..3cb07f3bc42f64756253629f30dd397b743396c6 100644
--- a/arch/arm64/um/asm/cpufeatures.h
+++ b/arch/arm64/um/asm/cpufeatures.h
@@ -2,8 +2,19 @@
 #ifndef _ASM_UM_ARM64_CPUFEATURES_H
 #define _ASM_UM_ARM64_CPUFEATURES_H
 
+#ifdef CONFIG_UML_X86_64_USERSPACE_ONLY
+/*
+ * This slice's userspace is x86, and /proc/cpuinfo describes the CPU that
+ * userspace runs on, so it needs the x86 capability bitmap: the real bit
+ * numbering, so the generated capflags.c can name every bit the way x86 Linux
+ * names it.  The x86 header is a self-contained list of definitions and pulls
+ * in no x86 kernel code.
+ */
+#include "../../../x86/include/asm/cpufeatures.h"
+#else
 /* UML exposes no native-kernel capability bitmap to generic kernel code. */
 #define NCAPINTS 1
 #define NBUGINTS 1
+#endif
 
 #endif
diff --git a/arch/um/kernel/Makefile b/arch/um/kernel/Makefile
index e60afe7d2769b4eff2b235a90018a2a91076a75a..aebeb60d6df01013937cacf77c263fb8ca0fdb2c 100644
--- a/arch/um/kernel/Makefile
+++ b/arch/um/kernel/Makefile
@@ -20,7 +20,13 @@ obj-y = config.o exec.o exitcode.o irq.o ksyms.o mem.o \
 	um_arch.o umid.o kmsg_dump.o skas/
 obj-y += load_file.o page_cache_trim.o
 
+ifdef CONFIG_UML_X86_64_USERSPACE_ONLY
+# The kernel is arm64, but /proc/cpuinfo describes the CPU its userspace runs
+# on, so this slice names features the way x86 Linux does.
+obj-y += capflags.o
+else
 obj-$(CONFIG_UML_ARM64) += hwcaps_arm64.o
+endif
 obj-$(CONFIG_UML_X86) += capflags.o
 
 obj-$(CONFIG_BLK_DEV_INITRD) += initrd.o
diff --git a/arch/um/kernel/um_arch.c b/arch/um/kernel/um_arch.c
index a350b79721d49850c56f2e1f4868323504cf54c7..fa4c6e480ec9a0206c07dbefbc3cb3a7c4eb4950 100644
--- a/arch/um/kernel/um_arch.c
+++ b/arch/um/kernel/um_arch.c
@@ -88,7 +88,7 @@ static const char * __maybe_unused uml_cpu_model_name(void)
 #endif
 }
 
-#ifdef CONFIG_UML_ARM64
+#if defined(CONFIG_UML_ARM64) && !defined(CONFIG_UML_X86_64_USERSPACE_ONLY)
 /*
  * arm64 userspace reads this file in arm64 Linux's format
  * (arch/arm64/kernel/cpuinfo.c), and software chooses its instructions from
@@ -198,6 +198,60 @@ static void show_arm64_cpuinfo(struct seq_file *m, int cpu)
 }
 #endif
 
+#ifdef CONFIG_UML_X86_64_USERSPACE_ONLY
+/*
+ * This kernel is arm64, so it cannot execute CPUID to discover the CPU its own
+ * userspace sees.  Userspace can, and a great deal of software decides which
+ * instructions to issue by reading /proc/cpuinfo rather than by asking the
+ * CPU -- Debian's chromium launcher greps this file for sse3 and refuses to
+ * start without it.  Reporting the arm64 host's feature names to an x86
+ * program makes every one of those decisions wrong, so the words below carry
+ * exactly what the emulator's CPUID gadget returns.  The model name is not
+ * among them: it comes from the emulator directly, so it is the one CPUID
+ * answer this file cannot get out of step with.
+ *
+ * The capability words mirror darwin/cpu/x86_64/cpuid.hpp in the host emulator,
+ * as the arm64 slices mirror the emulator's MIDR_EL1, and the host's
+ * x86-64-gadget-bootstrap test fails if that table and the gadget ever
+ * disagree.  The indices are the x86 capability words that
+ * arch/x86/include/asm/cpufeature.h enumerates; the generated capflags.c this
+ * slice links names its bits by the same numbering.
+ */
+#define UML_X86_CAPABILITY_1_EDX		0
+#define UML_X86_CAPABILITY_8000_0001_EDX	1
+#define UML_X86_CAPABILITY_1_ECX		4
+#define UML_X86_CAPABILITY_8000_0001_ECX	6
+#define UML_X86_CAPABILITY_7_0_EBX		9
+#define UML_X86_CAPABILITY_7_1_EAX		12
+#define UML_X86_CAPABILITY_7_ECX		16
+#define UML_X86_CAPABILITY_7_EDX		18
+
+/* CPUID leaf 1 EAX 0x000306c3: family 6, model 0x3c, stepping 3. */
+static const char emulated_x86_vendor[] = "GenuineIntel";
+static const int emulated_x86_family = 6;
+static const int emulated_x86_model = 0x3c;
+static const int emulated_x86_stepping = 3;
+static const int emulated_x86_cpuid_level = 13;
+
+static void __init init_emulated_x86_cpu(void)
+{
+	__u32 *capability = boot_cpu_data.x86_capability;
+
+	capability[UML_X86_CAPABILITY_1_EDX] = 0x07888111;
+	capability[UML_X86_CAPABILITY_1_ECX] = 0x7ed83203;
+	capability[UML_X86_CAPABILITY_7_0_EBX] = 0x218c0329;
+	/* CPUID leaf 7 subleaf 1 EAX: AVX-VNNI, bit 4. */
+	capability[UML_X86_CAPABILITY_7_1_EAX] = 0x00000010;
+	capability[UML_X86_CAPABILITY_7_ECX] = 0x00400000;
+	capability[UML_X86_CAPABILITY_7_EDX] = 0x00000010;
+	capability[UML_X86_CAPABILITY_8000_0001_ECX] = 0x00000020;
+	capability[UML_X86_CAPABILITY_8000_0001_EDX] = 0x20100800;
+	/* CPUID leaf 1 EBX 0x00000800 reports the CLFLUSH line as eight
+	 * eight-byte units, so the cache line this CPU describes is 64 bytes. */
+	boot_cpu_data.cache_alignment = 64;
+}
+#endif
+
 static int show_cpuinfo(struct seq_file *m, void *v)
 {
 	int i = 0;
@@ -208,12 +262,21 @@ static int show_cpuinfo(struct seq_file *m, void *v)
 		return 0;
 #endif
 
-#ifdef CONFIG_UML_ARM64
+#if defined(CONFIG_UML_ARM64) && !defined(CONFIG_UML_X86_64_USERSPACE_ONLY)
 	show_arm64_cpuinfo(m, i);
 #else
 	seq_printf(m, "processor\t: %d\n", i);
+#ifdef CONFIG_UML_X86_64_USERSPACE_ONLY
+	seq_printf(m, "vendor_id\t: %s\n", emulated_x86_vendor);
+	seq_printf(m, "cpu family\t: %d\n", emulated_x86_family);
+	seq_printf(m, "model\t\t: %d\n", emulated_x86_model);
+	seq_printf(m, "model name\t: %s\n", uml_cpu_model_name());
+	seq_printf(m, "stepping\t: %d\n", emulated_x86_stepping);
+	seq_printf(m, "cpuid level\t: %d\n", emulated_x86_cpuid_level);
+#else
 	seq_printf(m, "vendor_id\t: User Mode Linux\n");
 	seq_printf(m, "model name\t: %s\n", uml_cpu_model_name());
+#endif
 	seq_printf(m, "mode\t\t: skas\n");
 	seq_printf(m, "host\t\t: %s\n", host_info);
 	seq_printf(m, "fpu\t\t: %s\n", str_yes_no(cpu_has(&boot_cpu_data, X86_FEATURE_FPU)));
@@ -564,7 +627,11 @@ int __init __no_stack_protector linux_main(int argc, char **argv, char **envp)
 	/* OS sanity checks that need to happen before the kernel runs */
 	os_early_checks();
 
+#ifdef CONFIG_UML_X86_64_USERSPACE_ONLY
+	init_emulated_x86_cpu();
+#else
 	get_host_cpu_features(parse_host_cpu_flags, parse_cache_line);
+#endif
 
 	brk_start = (unsigned long) sbrk(0);
 #ifdef UML_HOST_DARWIN
