+					     REGSET_FP, 0,
+					     sizeof(struct uml_x86_32_fsave),
+					     datap);
+	case UML_X86_32_PTRACE_GETFPXREGS:
+		return copy_regset_to_user(child, &uml_x86_32_view,
+					   REGSET_XFP, 0,
+					   sizeof(struct uml_x86_64_fpstate),
+					   datap);
+	case UML_X86_32_PTRACE_SETFPXREGS:
+		return copy_regset_from_user(child, &uml_x86_32_view,
+					     REGSET_XFP, 0,
+					     sizeof(struct uml_x86_64_fpstate),
+					     datap);
+	case PTRACE_GET_THREAD_AREA:
+		return ptrace_get_thread_area(child, addr, datap);
+	case PTRACE_SET_THREAD_AREA:
+		return ptrace_set_thread_area(child, addr, datap);
+	}
