diff --git a/arch/arm64/um/ptrace.c b/arch/arm64/um/ptrace.c
index e8d509dab1e4e87fe0d4d9db8e065385d5be54b9..f355df97e151ed1cc8dd53909aad7f4c0fee4696 100644
--- a/arch/arm64/um/ptrace.c
+++ b/arch/arm64/um/ptrace.c
@@ -1,11 +1,44 @@
 // SPDX-License-Identifier: GPL-2.0
 
+#include <linux/compat.h>
 #include <linux/elf.h>
+#include <linux/ptrace.h>
 #include <linux/regset.h>
 #include <linux/sched.h>
 #include <linux/uaccess.h>
 #include <asm/ptrace.h>
+#include <asm/ptrace-abi.h>
 #include <asm/user.h>
+#include "x86_fpstate.h"
+
+/* struct user offsets for x86-64 PTRACE_PEEKUSER and PTRACE_POKEUSER. */
+#define UML_X86_64_USER_DEBUGREG 848
+#define UML_X86_64_USER_SIZE 928
+/* struct user32 offsets for the i386 requests. */
+#define UML_X86_32_USER_DEBUGREG 252
+#define UML_X86_32_USER_SIZE 284
+/* DR6 bits x86 reads as set, which Linux keeps flipped in its copy so
+ * that zero is the idle state, and DR6.BS. */
+#define UML_X86_64_DR6_RESERVED 0xffff0ff0UL
+#define UML_X86_64_DR6_STEP 0x4000UL
+/* DR7's local and global enable bits for DR0 to DR3. */
+#define UML_X86_64_DR7_ENABLE_MASK 0xffUL
+/* TASK_SIZE_MAX of a 4-level x86-64 kernel: a breakpoint reaching it would
+ * watch kernel space. */
+#define UML_X86_64_TASK_SIZE_MAX ((1UL << 47) - 4096)
+/* x86 request numbers, which i386 shares. */
+#define UML_X86_64_PTRACE_GETREGS 12
+#define UML_X86_64_PTRACE_SETREGS 13
+#define UML_X86_64_PTRACE_GETFPREGS 14
+#define UML_X86_64_PTRACE_SETFPREGS 15
+#define UML_X86_32_PTRACE_GETFPXREGS 18
+#define UML_X86_32_PTRACE_SETFPXREGS 19
+
+enum {
+	REGSET_XSTATE = REGSET_FP + 1,
+	/* i386 only: its REGSET_FP is the i387 FSAVE image. */
+	REGSET_XFP,
+};
 
 static int register_index(int regno)
 {
@@ -158,26 +191,158 @@ int putreg(struct task_struct *child, int regno, unsigned long value)
 	return 0;
 }
 
+static bool debugreg_offset(long addr)
+{
+	return addr >= UML_X86_64_USER_DEBUGREG &&
+		addr < UML_X86_64_USER_DEBUGREG + 8 * sizeof(unsigned long);
+}
+
+/* The DR7 length and type field of breakpoint n. */
+static unsigned int dr7_control(unsigned long dr7, unsigned int n)
+{
+	return (dr7 >> (16 + 4 * n)) & 0xf;
+}
+
+/*
+ * Whether a breakpoint of this DR7 length and type at this address is one
+ * x86 Linux accepts, as arch_build_bp_info(), hw_breakpoint_arch_parse()
+ * and arch_check_bp_in_kernelspace() judge it: no I/O type, an execute
+ * breakpoint of length one, an address aligned to its length, and a range
+ * wholly in user space.
+ */
+static bool debugreg_valid(unsigned long address, unsigned int control)
+{
+	static const unsigned char length[] = { 1, 2, 8, 4 };
+	unsigned int type = control & 3;
+	unsigned long bytes = length[control >> 2];
+
+	if (type == 2 || (type == 0 && bytes != 1))
+		return false;
+	if (address & (bytes - 1))
+		return false;
+	return address < UML_X86_64_TASK_SIZE_MAX &&
+		address + bytes - 1 < UML_X86_64_TASK_SIZE_MAX;
+}
+
+/*
+ * Like x86's ptrace_get_debugreg(): DR0 to DR3 read a staged breakpoint's
+ * address, DR6 the last #DB's status with its reserved bits set, and DR7
+ * the last value written.
+ */
+static unsigned long get_debugreg(struct task_struct *child, unsigned long n)
+{
+	const struct uml_x86_64_debugregs *debug = &child->thread.arch.debugregs;
+
+	if (n < 4)
+		return debug->staged & (1U << n) ? debug->address[n] : 0;
+	if (n == 6)
+		return debug->dr6 ^ UML_X86_64_DR6_RESERVED;
+	if (n == 7)
+		return debug->dr7;
+	return 0;
+}
+
+/*
+ * Like x86's ptrace_set_debugreg(), except that UML arms no hardware
+ * breakpoint.  An address in DR0 to DR3 stages a disabled breakpoint, and
+ * DR7 may change a staged one's length and type, both under x86's checks.
+ * A DR7 value that enables a breakpoint fails with EINVAL, as an invalid
+ * one does on x86, so a debugger knows the breakpoint is not armed.
+ */
+static int set_debugreg(struct task_struct *child, unsigned long n,
+			unsigned long value)
+{
+	struct uml_x86_64_debugregs *debug = &child->thread.arch.debugregs;
+	unsigned int i;
+
+	if (n < 4) {
+		/* A new breakpoint starts as x86's one-byte write stub. */
+		unsigned int control = debug->staged & (1U << n) ?
+			debug->control[n] : 1;
+
+		if (!debugreg_valid(value, control))
+			return -EINVAL;
+		debug->address[n] = value;
+		debug->control[n] = control;
+		debug->staged |= 1U << n;
+		return 0;
+	}
+	if (n == 6) {
+		debug->dr6 = value ^ UML_X86_64_DR6_RESERVED;
+		return 0;
+	}
+	if (n != 7)
+		return -EIO;
+	if (value & UML_X86_64_DR7_ENABLE_MASK)
+		return -EINVAL;
+	for (i = 0; i < 4; i++)
+		if ((debug->staged & (1U << i)) &&
+		    !debugreg_valid(debug->address[i], dr7_control(value, i)))
+			return -EINVAL;
+	for (i = 0; i < 4; i++)
+		if (debug->staged & (1U << i))
+			debug->control[i] = dr7_control(value, i);
+	debug->dr7 = value;
+	return 0;
+}
+
 int peek_user(struct task_struct *child, long addr, long data)
 {
-	unsigned long value;
+	unsigned long value = 0;
 
-	if (register_index(addr) < 0)
+	if (addr < 0 || addr >= UML_X86_64_USER_SIZE ||
+	    (addr & (sizeof(unsigned long) - 1)))
 		return -EIO;
-	value = getreg(child, addr);
+	if (register_index(addr) >= 0)
+		value = getreg(child, addr);
+	else if (debugreg_offset(addr))
+		value = get_debugreg(child, (addr - UML_X86_64_USER_DEBUGREG) /
+				     sizeof(unsigned long));
 	return put_user(value, (unsigned long __user *)data);
 }
 
 int poke_user(struct task_struct *child, long addr, long data)
 {
-	if (register_index(addr) < 0)
+	if (addr < 0 || addr >= UML_X86_64_USER_SIZE ||
+	    (addr & (sizeof(unsigned long) - 1)))
 		return -EIO;
-	return putreg(child, addr, data);
+	if (register_index(addr) >= 0)
+		return putreg(child, addr, data);
+	if (debugreg_offset(addr))
+		return set_debugreg(child, (addr - UML_X86_64_USER_DEBUGREG) /
+				    sizeof(unsigned long), data);
+	return -EIO;
 }
 
+static const struct user_regset_view uml_x86_64_view;
+
 long subarch_ptrace(struct task_struct *child, long request,
 		    unsigned long addr, unsigned long data)
 {
+	void __user *datap = (void __user *)data;
+
+	switch (request) {
+	case UML_X86_64_PTRACE_GETREGS:
+		return copy_regset_to_user(child, &uml_x86_64_view,
+					   REGSET_GENERAL, 0,
+					   sizeof(struct user_regs_struct),
+					   datap);
+	case UML_X86_64_PTRACE_SETREGS:
+		return copy_regset_from_user(child, &uml_x86_64_view,
+					     REGSET_GENERAL, 0,
+					     sizeof(struct user_regs_struct),
+					     datap);
+	case UML_X86_64_PTRACE_GETFPREGS:
+		return copy_regset_to_user(child, &uml_x86_64_view,
+					   REGSET_FP, 0,
+					   sizeof(struct uml_x86_64_fpstate),
+					   datap);
+	case UML_X86_64_PTRACE_SETFPREGS:
+		return copy_regset_from_user(child, &uml_x86_64_view,
+					     REGSET_FP, 0,
+					     sizeof(struct uml_x86_64_fpstate),
+					     datap);
+	}
 	return -EIO;
 }
 
@@ -233,11 +398,40 @@ static int genregs32_set(struct task_struct *target,
 	return error;
 }
 
+static int fsave_get(struct task_struct *target,
+		     const struct user_regset *regset, struct membuf to)
+{
+	struct uml_x86_32_fsave fsave;
+
+	uml_x86_32_get_fsave(&target->thread.regs.regs, &fsave);
+	return membuf_write(&to, &fsave, sizeof(fsave));
+}
+
+static int fsave_set(struct task_struct *target,
+		     const struct user_regset *regset,
+		     unsigned int pos, unsigned int count,
+		     const void *kbuf, const void __user *ubuf)
+{
+	struct uml_x86_32_fsave fsave;
+	int error;
+
+	/* As on Linux, only a whole image. */
+	if (pos || count != sizeof(fsave))
+		return -EINVAL;
+	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf,
+				   &fsave, 0, sizeof(fsave));
+	if (!error)
+		uml_x86_32_set_fsave(&target->thread.regs.regs, &fsave);
+	return error;
+}
+
 static int fpregs_get(struct task_struct *target,
 		      const struct user_regset *regset, struct membuf to)
 {
-	membuf_write(&to, target->thread.regs.regs.fp, host_fp_size);
-	return 0;
+	struct uml_x86_64_xstate state;
+
+	uml_x86_64_get_xstate(&target->thread.regs.regs, &state);
+	return membuf_write(&to, &state.fpstate, sizeof(state.fpstate));
 }
 
 static int fpregs_set(struct task_struct *target,
@@ -245,8 +439,55 @@ static int fpregs_set(struct task_struct *target,
 		      unsigned int pos, unsigned int count,
 		      const void *kbuf, const void __user *ubuf)
 {
-	return user_regset_copyin(&pos, &count, &kbuf, &ubuf,
-		target->thread.regs.regs.fp, 0, host_fp_size);
+	struct uml_x86_64_xstate state;
+	int error;
+
+	uml_x86_64_get_xstate(&target->thread.regs.regs, &state);
+	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf,
+				   &state.fpstate, 0, sizeof(state.fpstate));
+	if (error)
+		return error;
+	return uml_x86_64_set_xstate(&target->thread.regs.regs, &state,
+				     UML_X86_64_XFEATURES);
+}
+
+static int xstate_get(struct task_struct *target,
+		      const struct user_regset *regset, struct membuf to)
+{
+	struct uml_x86_64_xstate state;
+	u64 xcr0 = UML_X86_64_XFEATURES;
+
+	uml_x86_64_get_xstate(&target->thread.regs.regs, &state);
+	/* ptrace reports XCR0 in the first software-reserved word. */
+	memset(&state.fpstate.sw_reserved, 0,
+	       sizeof(state.fpstate.sw_reserved));
+	memcpy(&state.fpstate.sw_reserved, &xcr0, sizeof(xcr0));
+	return membuf_write(&to, &state, sizeof(state));
+}
+
+static int xstate_set(struct task_struct *target,
+		      const struct user_regset *regset,
+		      unsigned int pos, unsigned int count,
+		      const void *kbuf, const void __user *ubuf)
+{
+	struct uml_x86_64_xstate state;
+	unsigned int index;
+	int error;
+
+	if (pos || count != sizeof(state))
+		return -EFAULT;
+	uml_x86_64_get_xstate(&target->thread.regs.regs, &state);
+	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf,
+				   &state, 0, sizeof(state));
+	if (error)
+		return error;
+	if (state.header.xfeatures & ~UML_X86_64_XFEATURES)
+		return -EINVAL;
+	for (index = 0; index < ARRAY_SIZE(state.header.reserved); index++)
+		if (state.header.reserved[index])
+			return -EINVAL;
+	return uml_x86_64_set_xstate(&target->thread.regs.regs, &state,
+				     state.header.xfeatures);
 }
 
 static const struct user_regset uml_x86_64_regsets[] = {
@@ -260,12 +501,20 @@ static const struct user_regset uml_x86_64_regsets[] = {
 	},
 	[REGSET_FP] = {
 		USER_REGSET_NOTE_TYPE(PRFPREG),
-		.n = sizeof(elf_fpregset_t) / sizeof(unsigned long),
-		.size = sizeof(unsigned long),
-		.align = sizeof(unsigned long),
+		.n = sizeof(struct uml_x86_64_fpstate) / sizeof(u64),
+		.size = sizeof(u64),
+		.align = sizeof(u64),
 		.regset_get = fpregs_get,
 		.set = fpregs_set,
 	},
+	[REGSET_XSTATE] = {
+		USER_REGSET_NOTE_TYPE(X86_XSTATE),
+		.n = sizeof(struct uml_x86_64_xstate) / sizeof(u64),
+		.size = sizeof(u64),
+		.align = sizeof(u64),
+		.regset_get = xstate_get,
+		.set = xstate_set,
+	},
 };
 
 static const struct user_regset_view uml_x86_64_view = {
@@ -284,6 +533,30 @@ static const struct user_regset uml_x86_32_regsets[] = {
 		.regset_get = genregs32_get,
 		.set = genregs32_set,
 	},
+	[REGSET_FP] = {
+		USER_REGSET_NOTE_TYPE(PRFPREG),
+		.n = sizeof(struct uml_x86_32_fsave) / sizeof(u32),
+		.size = sizeof(u32),
+		.align = sizeof(u32),
+		.regset_get = fsave_get,
+		.set = fsave_set,
+	},
+	[REGSET_XSTATE] = {
+		USER_REGSET_NOTE_TYPE(X86_XSTATE),
+		.n = sizeof(struct uml_x86_64_xstate) / sizeof(u64),
+		.size = sizeof(u64),
+		.align = sizeof(u64),
+		.regset_get = xstate_get,
+		.set = xstate_set,
+	},
+	[REGSET_XFP] = {
+		USER_REGSET_NOTE_TYPE(PRXFPREG),
+		.n = sizeof(struct uml_x86_64_fpstate) / sizeof(u32),
+		.size = sizeof(u32),
+		.align = sizeof(u32),
+		.regset_get = fpregs_get,
+		.set = fpregs_set,
+	},
 };
 
 static const struct user_regset_view uml_x86_32_view = {
@@ -301,3 +574,101 @@ task_user_regset_view(struct task_struct *task)
 		return &uml_x86_32_view;
 	return &uml_x86_64_view;
 }
+
+#ifdef CONFIG_COMPAT
+/* Like Linux's getreg32(): struct user32 holds the general registers and the
+ * debug registers, and its other fields, up to and including the offset
+ * just past it, read as zero.
+ */
+static int peek_user32(struct task_struct *child, compat_ulong_t addr,
+		       u32 *value)
+{
+	struct uml_x86_32_user_regs regs;
+
+	if (addr > UML_X86_32_USER_SIZE || (addr & 3))
+		return -EIO;
+	*value = 0;
+	if (addr < sizeof(regs)) {
+		get_user_regs32(&child->thread.regs.regs, &regs);
+		*value = ((u32 *)&regs)[addr / sizeof(u32)];
+	} else if (addr >= UML_X86_32_USER_DEBUGREG &&
+		   addr < UML_X86_32_USER_SIZE) {
+		*value = get_debugreg(child, (addr - UML_X86_32_USER_DEBUGREG) /
+				      sizeof(u32));
+	}
+	return 0;
+}
+
+/* Like Linux's putreg32(): writes to other fields are ignored. */
+static int poke_user32(struct task_struct *child, compat_ulong_t addr,
+		       u32 value)
+{
+	struct uml_x86_32_user_regs regs;
+
+	if (addr > UML_X86_32_USER_SIZE || (addr & 3))
+		return -EIO;
+	if (addr >= UML_X86_32_USER_DEBUGREG && addr < UML_X86_32_USER_SIZE)
