+/* PTRACE_GET_THREAD_AREA and PTRACE_SET_THREAD_AREA name the entry by
+ * their address argument; Linux reads a descriptor's own entry number only
+ * when that is -1.
+ */
+int ptrace_get_thread_area(struct task_struct *child, int index,
+			   void __user *address)
+{
+	struct uml_x86_32_user_desc info;
+
+	if (index < UML_X86_32_TLS_MIN ||
+	    index >= UML_X86_32_TLS_MIN + UML_X86_32_TLS_ENTRIES)
+		return -EINVAL;
+	info = *uml_x86_32_tls_slot(&child->thread.regs.regs,
+				    index - UML_X86_32_TLS_MIN);
+	info.entry_number = index;
+	return copy_to_user(address, &info, sizeof(info)) ? -EFAULT : 0;
+}
+
+int ptrace_set_thread_area(struct task_struct *child, int index,
+			   void __user *address)
+{
+	struct uml_x86_32_user_desc info;
+
+	if (copy_from_user(&info, address, sizeof(info)))
+		return -EFAULT;
+	if (!uml_x86_32_tls_valid(&info))
+		return -EINVAL;
+	if (index != -1)
+		info.entry_number = index;
+	return uml_x86_32_install_tls(child, &info);
+}
