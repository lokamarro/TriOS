 #define DARWIN_GUEST_ILL_ILLOPN 2
 #define DARWIN_GUEST_X86_TRAP_UD 6
+#define DARWIN_GUEST_X86_TRAP_NP 11
 #define DARWIN_GUEST_X86_TRAP_SS 12
 #define DARWIN_GUEST_X86_TRAP_MF 16
