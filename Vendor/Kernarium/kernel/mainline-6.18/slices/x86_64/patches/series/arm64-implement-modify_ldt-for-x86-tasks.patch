 		WRITE_ONCE(mm->context.darwin_maps_shared, 1);
+#ifdef CONFIG_UML_X86_64_USERSPACE_ONLY
+	return uml_x86_ldt_dup(oldmm, mm);
+#else
 	return 0;
+#endif
 }
 #endif
 
@@ -151,6 +155,10 @@ int init_new_context(struct task_struct *task, struct mm_struct *mm)
 #ifdef CONFIG_UML_DARWIN_MM_SHARED
 	mm->context.darwin_maps_shared = 0;
 	atomic_set(&mm->context.darwin_ring_pins, 0);
+#endif
+#ifdef CONFIG_UML_X86_64_USERSPACE_ONLY
+	mm->context.x86_ldt = NULL;
+	mm->context.x86_ldt_entries = 0;
 #endif
 	id->stack = 0;
 	id->sock = -1;
@@ -170,4 +178,7 @@ void destroy_context(struct mm_struct *mm)
 		      id->darwin_generation);
 	id->darwin_context = NULL;
 	id->pid = -1;
+#ifdef CONFIG_UML_X86_64_USERSPACE_ONLY
+	uml_x86_ldt_free(mm);
+#endif
 }
diff --git a/arch/um/os-Darwin/skas/process.c b/arch/um/os-Darwin/skas/process.c
index 9eb94479273d2bc898a29169a51c6b7ac7e60dd1..c28617c6798bad815dd135c1001c71af4a6b2518 100644
--- a/arch/um/os-Darwin/skas/process.c
