+		UPT_FP(registers) = current_x86_ldt();
 #endif
 		guest_tls = current_tls();
 		/* Snapshot before polling so an IPI racing with the poll remains
@@ -779,17 +782,23 @@ void userspace(struct uml_pt_regs *registers)
 			} else if (registers->faultinfo.trap_no == 4 ||
 				   registers->faultinfo.trap_no == 5 ||
 				   registers->faultinfo.trap_no ==
+				   DARWIN_GUEST_X86_TRAP_NP ||
+				   registers->faultinfo.trap_no ==
 				   DARWIN_GUEST_X86_TRAP_SS ||
 				   registers->faultinfo.trap_no == 13) {
-				/* #OF from INTO or INT 4, #BR from BOUND, #SS from a
-				 * non-canonical stack address, and a #GP such as RDTSC
+				/* #OF from INTO or INT 4, #BR from BOUND, #NP and
+				 * #SS from a segment that is not present or a stack
+				 * access outside its segment, and a #GP such as RDTSC
 				 * under PR_TSC_SIGSEGV reach native userspace with
 				 * Linux SI_KERNEL, a name Darwin's signal.h does not
-				 * define, and no fault address: #SS as SIGBUS and the
-				 * rest as SIGSEGV.  The host's error code stays, as
-				 * the selector index a #GP from INT n names. */
+				 * define, and no fault address: #NP and #SS as
+				 * SIGBUS and the rest as SIGSEGV.  The host's error
+				 * code stays, as the selector a segment fault or a
+				 * #GP from INT n names. */
 				registers->faultinfo.cr2 = 0;
 				signal_info.si_signo =
+					registers->faultinfo.trap_no ==
+					DARWIN_GUEST_X86_TRAP_NP ||
 					registers->faultinfo.trap_no ==
 					DARWIN_GUEST_X86_TRAP_SS ?
 					DARWIN_GUEST_SIGBUS : SIGSEGV;
