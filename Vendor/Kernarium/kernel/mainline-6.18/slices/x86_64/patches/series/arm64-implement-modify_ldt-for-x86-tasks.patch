diff --git a/arch/arm64/um/ldt.c b/arch/arm64/um/ldt.c
new file mode 100644
index 0000000000000000000000000000000000000000..e4eda41e0416698b81be7c6df6d04c537406d019
--- /dev/null
+++ b/arch/arm64/um/ldt.c
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The x86 LDT of an x86-64 userspace slice task's mm, which modify_ldt()
+ * edits as an x86-64 kernel does.  The Darwin host's engines read the table
+ * while the mm's tasks run: the guest registers' fp carries its address at
+ * every entry (bridge ABI 20).  So the table holds all 8192 descriptors from
+ * the first write on, a write changes one descriptor with a single 8-byte
+ * store, and the table goes only with the mm.  An empty slot answers every
+ * lookup as an index beyond Linux's LDT limit does, so the host needs no
+ * entry count; only modify_ldt()'s read keeps one.
+ *
+ * This kernel refuses 16-bit segments, as an x86-64 kernel built without
+ * CONFIG_X86_16BIT does: the host runs no 16-bit code.
+ */
+
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <asm/mm_hooks.h>
+#include <kern_util.h>
+#include "x86_32.h"
+
+enum {
+	UML_X86_LDT_ENTRIES = 8192,
+	UML_X86_LDT_SIZE = UML_X86_LDT_ENTRIES * sizeof(u64),
+	/* What read_default_ldt() gives on x86-64: 128 zero bytes. */
+	UML_X86_LDT_DEFAULT_SIZE = 128,
+};
+
+/* LDT_empty(): the descriptor of no segment, which clears an entry. */
+static bool uml_x86_ldt_empty(const struct uml_x86_32_user_desc *info)
+{
+	return info->base_addr == 0 && info->limit == 0 &&
+		info->contents == 0 && info->read_exec_only == 1 &&
+		info->seg_32bit == 0 && info->limit_in_pages == 0 &&
+		info->seg_not_present == 1 && info->useable == 0;
+}
+
+/* fill_ldt(): accessed, DPL 3, never a long-mode code segment. */
+static u64 uml_x86_ldt_descriptor(const struct uml_x86_32_user_desc *info,
+				  bool oldmode)
+{
+	u64 base = info->base_addr;
+	u64 limit = info->limit;
+	u64 type = ((info->read_exec_only ^ 1ULL) << 1) |
+		((u64)info->contents << 2) | 1;
+
+	return (limit & 0xffff) | ((base & 0xffffff) << 16) |
+		(type << 40) | (1ULL << 44) | (3ULL << 45) |
+		((u64)(info->seg_not_present ^ 1) << 47) |
+		(((limit >> 16) & 0xf) << 48) |
+		((u64)(oldmode ? 0 : info->useable) << 52) |
+		((u64)info->seg_32bit << 54) |
+		((u64)info->limit_in_pages << 55) |
+		((base >> 24) << 56);
+}
+
+static int uml_x86_read_ldt(void __user *ptr, unsigned long bytecount)
+{
+	struct mm_struct *mm = current->mm;
+	unsigned long size;
+	int result;
+
+	mmap_read_lock(mm);
+	if (mm->context.x86_ldt == NULL) {
+		result = 0;
+		goto out;
+	}
+	if (bytecount > UML_X86_LDT_SIZE)
+		bytecount = UML_X86_LDT_SIZE;
+	size = min_t(unsigned long, bytecount,
+		     mm->context.x86_ldt_entries * sizeof(u64));
+	if (copy_to_user(ptr, mm->context.x86_ldt, size) ||
+	    clear_user(ptr + size, bytecount - size)) {
+		result = -EFAULT;
+		goto out;
+	}
+	result = bytecount;
+out:
+	mmap_read_unlock(mm);
+	return result;
+}
+
+static int uml_x86_read_default_ldt(void __user *ptr, unsigned long bytecount)
+{
+	if (bytecount > UML_X86_LDT_DEFAULT_SIZE)
+		bytecount = UML_X86_LDT_DEFAULT_SIZE;
+	if (clear_user(ptr, bytecount))
+		return -EFAULT;
+	return bytecount;
+}
+
+static int uml_x86_write_ldt(void __user *ptr, unsigned long bytecount,
+			     bool oldmode)
+{
+	struct mm_struct *mm = current->mm;
+	struct uml_x86_32_user_desc info;
+	u64 descriptor = 0;
+	u64 *table;
+
+	if (bytecount != sizeof(info))
+		return -EINVAL;
+	if (copy_from_user(&info, ptr, sizeof(info)))
+		return -EFAULT;
+	if (info.entry_number >= UML_X86_LDT_ENTRIES)
+		return -EINVAL;
+	if (info.contents == 3 && (oldmode || !info.seg_not_present))
+		return -EINVAL;
+	if (!(oldmode && !info.base_addr && !info.limit) &&
+	    !uml_x86_ldt_empty(&info)) {
+		if (!info.seg_32bit)
+			return -EINVAL;
+		descriptor = uml_x86_ldt_descriptor(&info, oldmode);
+	}
+
+	if (mmap_write_lock_killable(mm))
+		return -EINTR;
+	table = mm->context.x86_ldt;
+	if (table == NULL) {
+		table = kzalloc(UML_X86_LDT_SIZE, GFP_KERNEL_ACCOUNT);
+		if (table == NULL) {
+			mmap_write_unlock(mm);
+			return -ENOMEM;
+		}
+		/* A task of the mm that enters the guest after this sees the
+		 * zeroed table before its address. */
+		smp_store_release(&mm->context.x86_ldt, table);
+	}
+	WRITE_ONCE(table[info.entry_number], descriptor);
+	mm->context.x86_ldt_entries = max(mm->context.x86_ldt_entries,
+					  info.entry_number + 1);
+	mmap_write_unlock(mm);
+	return 0;
+}
+
+SYSCALL_DEFINE3(modify_ldt, int, func, void __user *, ptr,
+		unsigned long, bytecount)
+{
+	int result = -ENOSYS;
+
+	switch (func) {
+	case 0:
+		result = uml_x86_read_ldt(ptr, bytecount);
+		break;
+	case 1:
+		result = uml_x86_write_ldt(ptr, bytecount, true);
+		break;
+	case 2:
+		result = uml_x86_read_default_ldt(ptr, bytecount);
+		break;
+	case 0x11:
+		result = uml_x86_write_ldt(ptr, bytecount, false);
+		break;
+	}
+	/* modify_ldt() returns an int, which x86-64 Linux hands back
+	 * zero-extended in RAX. */
+	return (unsigned int)result;
+}
+
+unsigned long current_x86_ldt(void)
+{
+	struct mm_struct *mm = current->mm;
+
+	return mm == NULL ? 0 :
+		(unsigned long)smp_load_acquire(&mm->context.x86_ldt);
+}
+
+/* Called with both mms' mmap_lock held for writing. */
+int uml_x86_ldt_dup(struct mm_struct *oldmm, struct mm_struct *mm)
+{
+	u64 *table;
+
+	if (oldmm->context.x86_ldt == NULL)
+		return 0;
+	table = kmemdup(oldmm->context.x86_ldt, UML_X86_LDT_SIZE,
+			GFP_KERNEL_ACCOUNT);
+	if (table == NULL)
+		return -ENOMEM;
+	mm->context.x86_ldt = table;
+	mm->context.x86_ldt_entries = oldmm->context.x86_ldt_entries;
+	return 0;
+}
+
+void uml_x86_ldt_free(struct mm_struct *mm)
+{
+	kfree(mm->context.x86_ldt);
+	mm->context.x86_ldt = NULL;
+	mm->context.x86_ldt_entries = 0;
+}
diff --git a/arch/arm64/um/x86_32.h b/arch/arm64/um/x86_32.h
index 76a56e3ed77af00063dc201bd461565318be63b8..5fd66e09ae77f23741aa5ef124c93e1f9b64026c 100644
--- a/arch/arm64/um/x86_32.h
+++ b/arch/arm64/um/x86_32.h
@@ -2,8 +2,25 @@
 #ifndef __UM_ARM64_X86_32_H
 #define __UM_ARM64_X86_32_H
 
+#include <linux/types.h>
+
 struct task_struct;
 
+/* struct user_desc of set_thread_area() and modify_ldt(); x86-64's has the
+ * lm bit next, which a descriptor from user space never sets. */
+struct uml_x86_32_user_desc {
+	u32 entry_number;
+	u32 base_addr;
+	u32 limit;
+	u32 seg_32bit : 1;
+	u32 contents : 2;
+	u32 read_exec_only : 1;
+	u32 limit_in_pages : 1;
+	u32 seg_not_present : 1;
+	u32 useable : 1;
+	u32 reserved : 25;
+};
+
 int uml_x86_32_set_task_tls(struct task_struct *task, unsigned long descriptor);
 
 #endif
