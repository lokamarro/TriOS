+asmlinkage long
+uml_x86_32_rt_sigreturn(unsigned long unused0, unsigned long unused1,
+			unsigned long unused2, unsigned long unused3,
+			unsigned long unused4, unsigned long unused5)
+{
+	struct pt_regs *regs = current_pt_regs();
+	unsigned long sp = UPT_X86_64(&regs->regs, UML_X86_64_RSP);
+	struct uml_x86_32_rt_sigframe __user *frame;
+	sigset_t set;
+
+	(void)unused0;
+	(void)unused1;
+	(void)unused2;
+	(void)unused3;
+	(void)unused4;
+	(void)unused5;
+	if (sp < sizeof(u32))
+		goto bad_frame;
+	frame = (void __user *)(sp - sizeof(u32));
+	if (!access_ok(frame, sizeof(*frame)) ||
+	    get_compat_sigset(&set, &frame->context.sigmask))
+		goto bad_frame;
+	set_current_blocked(&set);
+	if (restore_x86_32_mcontext(regs, &frame->context.mcontext) ||
+	    compat_restore_altstack(&frame->context.stack))
+		goto bad_frame;
+	return PT_REGS_SYSCALL_RET(regs);
+
+bad_frame:
+	force_sig(SIGSEGV);
+	return 0;
+}
+
+asmlinkage long
+uml_x86_32_sigreturn(unsigned long unused0, unsigned long unused1,
+		     unsigned long unused2, unsigned long unused3,
+		     unsigned long unused4, unsigned long unused5)
+{
+	struct pt_regs *regs = current_pt_regs();
+	unsigned long sp = UPT_X86_64(&regs->regs, UML_X86_64_RSP);
+	struct uml_x86_32_sigframe __user *frame;
+	sigset_t set;
+	u32 low, high;
+
+	(void)unused0;
+	(void)unused1;
+	(void)unused2;
+	(void)unused3;
+	(void)unused4;
+	(void)unused5;
+	if (sp < 2 * sizeof(u32))
+		goto bad_frame;
+	frame = (void __user *)(sp - 2 * sizeof(u32));
+	if (!access_ok(frame, sizeof(*frame)) ||
+	    get_user(low, &frame->context.oldmask) ||
+	    get_user(high, &frame->extra_mask))
+		goto bad_frame;
+	sigemptyset(&set);
+	set.sig[0] = ((u64)high << 32) | low;
+	set_current_blocked(&set);
+	if (restore_x86_32_mcontext(regs, &frame->context))
+		goto bad_frame;
+	return PT_REGS_SYSCALL_RET(regs);
+
+bad_frame:
+	force_sig(SIGSEGV);
+	return 0;
+}
