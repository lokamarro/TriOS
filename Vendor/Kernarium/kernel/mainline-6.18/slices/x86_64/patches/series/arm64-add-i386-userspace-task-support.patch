 #define ELF_ET_DYN_BASE (TASK_SIZE * 2 / 3)
-#ifdef CONFIG_UML_ARM64_AARCH32
-/* 8 MiB of VA for an AArch32 task's stack, 1 GiB for an AArch64 one. */
+#ifdef CONFIG_COMPAT
+/* 8 MiB of VA for a 32-bit task's stack, 1 GiB for a 64-bit one. */
 #define STACK_RND_MASK \
 	(test_thread_flag(TIF_32BIT) ? 0x7ff >> (PAGE_SHIFT - 12) : \
 	 0x3ffff >> (PAGE_SHIFT - 12))
@@ -41,7 +41,10 @@
 #define STACK_RND_MASK (0x3ffff >> (PAGE_SHIFT - 12))
 #endif
 
-#define elf_check_arch(header) ((header)->e_machine == EM_X86_64)
+#define elf_check_arch(header) \
+	((header)->e_machine == EM_X86_64 && \
+	 (header)->e_ident[EI_CLASS] == ELFCLASS64 && \
+	 (header)->e_ident[EI_DATA] == ELFDATA2LSB)
 
 /* x86-64 starts a task with the flat 64-bit code and stack selectors and
  * with RFLAGS IF and bit 1, as Linux's start_thread(); the data selectors
@@ -65,6 +68,77 @@
 } while (0)
 #endif
 
+#ifdef CONFIG_COMPAT
+#define COMPAT_ELF_PLATFORM "i686"
+#define COMPAT_ELF_ET_DYN_BASE 0x00400000UL
+
+extern void start_thread(struct pt_regs *regs, unsigned long entry,
+			 unsigned long stack);
+
+#define compat_elf_check_arch(header) \
+	((header)->e_machine == EM_386 && \
+	 (header)->e_ident[EI_CLASS] == ELFCLASS32 && \
+	 (header)->e_ident[EI_DATA] == ELFDATA2LSB)
+
+static inline void uml_x86_32_elf_init(struct pt_regs *regs)
+{
+	struct uml_pt_regs *guest = &regs->regs;
+	unsigned int index;
+
+	/* An i386 task starts with no TLS descriptors. */
+	for (index = 0; index < sizeof(guest->compat_tls) /
+			sizeof(guest->compat_tls[0]); ++index)
+		guest->compat_tls[index][0] = guest->compat_tls[index][1] = 0;
+	UPT_X86_64(guest, UML_X86_64_RBX) = 0;
+	UPT_X86_64(guest, UML_X86_64_RCX) = 0;
+	UPT_X86_64(guest, UML_X86_64_RDX) = 0;
+	UPT_X86_64(guest, UML_X86_64_RSI) = 0;
+	UPT_X86_64(guest, UML_X86_64_RDI) = 0;
+	UPT_X86_64(guest, UML_X86_64_RBP) = 0;
+	UPT_X86_64(guest, UML_X86_64_R8) = 0;
+	UPT_X86_64(guest, UML_X86_64_R9) = 0;
+	UPT_X86_64(guest, UML_X86_64_R10) = 0;
+	UPT_X86_64(guest, UML_X86_64_R11) = 0;
+	UPT_X86_64(guest, UML_X86_64_R12) = 0;
+	UPT_X86_64(guest, UML_X86_64_R13) = 0;
+	UPT_X86_64(guest, UML_X86_64_R14) = 0;
+	UPT_X86_64(guest, UML_X86_64_R15) = 0;
+	UPT_X86_64_FS_BASE(guest) = 0;
+	UPT_X86_64_GS_BASE(guest) = 0;
+	UPT_X86_64_RFLAGS(guest) = UML_X86_RFLAGS_INITIAL;
+	upt_x86_64_set_segment_selector(guest, 0, 0x2b);
+	upt_x86_64_set_segment_selector(guest, 1, 0x23);
+	upt_x86_64_set_segment_selector(guest, 2, 0x2b);
+	upt_x86_64_set_segment_selector(guest, 3, 0x2b);
+	upt_x86_64_set_segment_selector(guest, 4, 0);
+	upt_x86_64_set_segment_selector(guest, 5, 0);
+}
+
+#define COMPAT_ELF_PLAT_INIT(regs, load_address) \
+	uml_x86_32_elf_init(regs)
+
+static inline void uml_x86_32_start_thread(struct pt_regs *regs,
+					    unsigned long entry,
+					    unsigned long stack)
+{
+	start_thread(regs, (u32)entry, (u32)stack);
+	upt_x86_64_set_segment_selector(&regs->regs, 1, 0x23);
+	upt_x86_64_set_segment_selector(&regs->regs, 2, 0x2b);
+}
+
+#define COMPAT_START_THREAD(executable, regs, entry, stack) \
+	uml_x86_32_start_thread(regs, entry, stack)
+
+#define COMPAT_SET_PERSONALITY(executable) do { \
+	set_thread_flag(TIF_32BIT); \
+	current->personality &= ~READ_IMPLIES_EXEC; \
+} while (0)
+
+#define COMPAT_ELF_NGREG 17
+typedef unsigned int compat_elf_greg_t;
+typedef compat_elf_greg_t compat_elf_gregset_t[COMPAT_ELF_NGREG];
+#endif
+
 typedef unsigned long elf_greg_t;
 #define ELF_NGREG 27
 typedef elf_greg_t elf_gregset_t[ELF_NGREG];
diff --git a/arch/arm64/um/asm/processor.h b/arch/arm64/um/asm/processor.h
index 67a7fc597878391b267036cfcf1de5f97e8d9e4f..d070ff929a9f79d3d086df7ec6ed26180a193c69 100644
