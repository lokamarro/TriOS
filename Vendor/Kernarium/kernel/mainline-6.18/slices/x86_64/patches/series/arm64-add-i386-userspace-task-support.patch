--- /dev/null
+++ b/arch/arm64/um/x86_32_syscalls.c
@@ -0,0 +1,580 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/cache.h>
+#include <linux/compat.h>
+#include <linux/cred.h>
+#include <linux/linkage.h>
+#include <linux/fs.h>
+#include <linux/highuid.h>
+#include <linux/kdev_t.h>
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <linux/sched/task.h>
+#include <linux/stat.h>
+#include <linux/string.h>
+#include <linux/sys.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <asm/syscall.h>
+#include <asm/unistd.h>
+#include "x86_32.h"
+#include "x86_syscall_abi.h"
+
+/*
+ * The i386 TLS entries of an x86-64 kernel's GDT: entries 12 to 14,
+ * selectors 0x63, 0x6b and 0x73, as GDT_ENTRY_TLS_MIN places them.  Each
+ * installed descriptor keeps its entry number, which is how the host finds
+ * the entry a selector names.
+ */
+enum {
+	UML_X86_32_TLS_MIN = 12,
+	UML_X86_32_TLS_ENTRIES = 3,
+};
+
+struct uml_x86_32_user_desc {
+	u32 entry_number;
+	u32 base_addr;
+	u32 limit;
+	u32 seg_32bit : 1;
+	u32 contents : 2;
+	u32 read_exec_only : 1;
+	u32 limit_in_pages : 1;
+	u32 seg_not_present : 1;
+	u32 useable : 1;
+	u32 reserved : 25;
+};
+
+/* The guest registers carry one descriptor per compat_tls pair. */
+static_assert(sizeof(struct uml_x86_32_user_desc) ==
+	sizeof(((struct uml_pt_regs *)0)->compat_tls[0]));
+static_assert(ARRAY_SIZE(((struct uml_pt_regs *)0)->compat_tls) ==
+	UML_X86_32_TLS_ENTRIES);
+
+static struct uml_x86_32_user_desc *
+uml_x86_32_tls_slot(struct uml_pt_regs *guest, unsigned int index)
+{
+	return (void *)&guest->compat_tls[index][0];
+}
+
+static bool uml_x86_32_tls_zero(const struct uml_x86_32_user_desc *info)
+{
+	return info->base_addr == 0 && info->limit == 0 &&
+		info->contents == 0 && info->read_exec_only == 0 &&
+		info->seg_32bit == 0 && info->limit_in_pages == 0 &&
+		info->seg_not_present == 0 && info->useable == 0;
+}
+
+static bool uml_x86_32_tls_empty(const struct uml_x86_32_user_desc *info)
+{
+	return info->base_addr == 0 && info->limit == 0 &&
+		info->contents == 0 && info->read_exec_only == 1 &&
+		info->seg_32bit == 0 && info->limit_in_pages == 0 &&
+		info->seg_not_present == 1 && info->useable == 0;
+}
+
+static bool uml_x86_32_tls_valid(const struct uml_x86_32_user_desc *info)
+{
+	if (uml_x86_32_tls_zero(info) || uml_x86_32_tls_empty(info))
+		return true;
+	return info->seg_32bit && info->contents <= 1 &&
+		!info->seg_not_present;
+}
+
+static int
+uml_x86_32_install_tls(struct task_struct *task,
+		       struct uml_x86_32_user_desc *info)
+{
+	struct uml_pt_regs *guest = &task->thread.regs.regs;
+	unsigned int index = info->entry_number;
+	unsigned int selector;
+	unsigned long base;
+	bool empty;
+
+	if (index < UML_X86_32_TLS_MIN ||
+	    index >= UML_X86_32_TLS_MIN + UML_X86_32_TLS_ENTRIES)
+		return -EINVAL;
+
+	info->reserved = 0;
+	empty = uml_x86_32_tls_zero(info) || uml_x86_32_tls_empty(info);
+	if (empty)
+		memset(uml_x86_32_tls_slot(guest, index - UML_X86_32_TLS_MIN),
+		       0, sizeof(*info));
+	else
+		*uml_x86_32_tls_slot(guest, index - UML_X86_32_TLS_MIN) = *info;
+
+	selector = (index << 3) | 3;
+	base = empty ? 0 : info->base_addr;
+	if (upt_x86_64_segment_selector(guest, 4) == selector)
+		UPT_X86_64_FS_BASE(guest) = base;
+	if (upt_x86_64_segment_selector(guest, 5) == selector)
+		UPT_X86_64_GS_BASE(guest) = base;
+	return 0;
+}
+
+int uml_x86_32_set_task_tls(struct task_struct *task,
+			    unsigned long descriptor_address)
+{
+	struct uml_x86_32_user_desc __user *user_desc =
+		(void __user *)descriptor_address;
+	struct uml_x86_32_user_desc info;
+
+	if (copy_from_user(&info, user_desc, sizeof(info)))
+		return -EFAULT;
+	if (!uml_x86_32_tls_valid(&info))
+		return -EINVAL;
+
+	/* clone(2) must name an existing TLS slot; it never allocates one. */
+	if (info.entry_number == (u32)-1)
+		return -EINVAL;
+	return uml_x86_32_install_tls(task, &info);
+}
