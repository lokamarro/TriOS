 #define PT_REGS_ORIG_SYSCALL(state) ((state)->regs.orig_x0)
 #define PT_REGS_SYSCALL_RET(state) UPT_SYSCALL_RETURN(&(state)->regs)
 
+#ifdef CONFIG_UML_X86_64_USERSPACE_ONLY
+/* restart_syscall is syscall 0 for i386 and 219 for x86-64. */
+#define PT_REGS_RESTART_SYSCALL_NR(state) \
+	(UPT_X86_64_COMPAT_SYSCALL(&(state)->regs) ? 0 : 219)
+#endif
+
 #define PT_REGS_SET_SYSCALL_RETURN(state, result) \
 	(PT_REGS_SYSCALL_RET(state) = (result))
 
