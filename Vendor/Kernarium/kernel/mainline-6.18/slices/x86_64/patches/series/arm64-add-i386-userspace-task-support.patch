+	state = (struct uml_x86_32_sigcontext) {
+		.gs = upt_x86_64_segment_selector(guest, 5),
+		.fs = upt_x86_64_segment_selector(guest, 4),
+		.es = upt_x86_64_segment_selector(guest, 0),
+		.ds = upt_x86_64_segment_selector(guest, 3),
+		.di = UPT_X86_64(guest, UML_X86_64_RDI),
+		.si = UPT_X86_64(guest, UML_X86_64_RSI),
+		.bp = UPT_X86_64(guest, UML_X86_64_RBP),
+		.sp = UPT_X86_64(guest, UML_X86_64_RSP),
+		.bx = UPT_X86_64(guest, UML_X86_64_RBX),
+		.dx = UPT_X86_64(guest, UML_X86_64_RDX),
+		.cx = UPT_X86_64(guest, UML_X86_64_RCX),
+		.ax = UPT_X86_64(guest, UML_X86_64_RAX),
+		.trapno = guest->faultinfo.trap_no,
+		.error_code = guest->faultinfo.error_code,
+		.ip = UPT_X86_64_RIP(guest),
+		.cs = upt_x86_64_segment_selector(guest, 1),
+		.flags = UPT_X86_64_RFLAGS(guest),
+		.sp_at_signal = UPT_X86_64(guest, UML_X86_64_RSP),
+		.ss = upt_x86_64_segment_selector(guest, 2),
+		.fpstate = fpstate,
+		.oldmask = oldmask,
+		.cr2 = guest->faultinfo.cr2,
+	};
+	return copy_to_user(context, &state, sizeof(state));
+}
+
+static unsigned short x86_32_fixup_rpl(unsigned short selector)
+{
+	return selector <= 3 ? selector : selector | 3;
+}
+
+static int restore_x86_32_mcontext(struct pt_regs *regs,
+				   struct uml_x86_32_sigcontext __user *context)
+{
+	struct uml_x86_32_sigcontext state;
+	struct uml_pt_regs *guest = &regs->regs;
+	unsigned long flags = UPT_X86_64_RFLAGS(guest);
+
+	current->restart_block.fn = do_no_restart_syscall;
+	if (copy_from_user(&state, context, sizeof(state)))
+		return 1;
+	if (!(state.cs & ~3U) || !(state.ss & ~3U))
+		return 1;
+	UPT_X86_64(guest, UML_X86_64_RDI) = state.di;
+	UPT_X86_64(guest, UML_X86_64_RSI) = state.si;
+	UPT_X86_64(guest, UML_X86_64_RBP) = state.bp;
+	UPT_X86_64(guest, UML_X86_64_RSP) = state.sp;
+	UPT_X86_64(guest, UML_X86_64_RBX) = state.bx;
+	UPT_X86_64(guest, UML_X86_64_RDX) = state.dx;
+	UPT_X86_64(guest, UML_X86_64_RCX) = state.cx;
+	UPT_X86_64(guest, UML_X86_64_RAX) = state.ax;
+	UPT_X86_64_RIP(guest) = state.ip;
+	UPT_X86_64_RFLAGS(guest) =
+		(flags & ~UML_X86_RFLAGS_RESTORE_MASK) |
+		(state.flags & UML_X86_RFLAGS_RESTORE_MASK) | 2;
+	upt_x86_64_set_segment_selector(guest, 5, x86_32_fixup_rpl(state.gs));
+	upt_x86_64_set_segment_selector(guest, 4, x86_32_fixup_rpl(state.fs));
+	upt_x86_64_set_segment_selector(guest, 0, x86_32_fixup_rpl(state.es));
+	upt_x86_64_set_segment_selector(guest, 3, x86_32_fixup_rpl(state.ds));
+	upt_x86_64_set_segment_selector(guest, 1, state.cs | 3);
+	upt_x86_64_set_segment_selector(guest, 2, state.ss | 3);
+	if (restore_x86_32_fpstate(regs, state.fpstate))
+		return 1;
+	guest->svcr &= ~UML_X86_64_COMPAT_SYSCALL;
+	PT_REGS_SYSCALL_NR(regs) = -1;
+	return 0;
+}
+
+static int allocate_x86_32_signal_frame(unsigned long stack_top,
+					 size_t frame_size,
+					 void __user **frame_out,
+					 struct uml_x86_32_xstate __user **fpstate_out)
+{
+	unsigned long frame_address;
+	unsigned long frame_end;
+	unsigned long fpstate_address;
+	unsigned long fxsave_address;
+
+	if (stack_top < frame_size + UML_X86_32_XSTATE_FRAME_SIZE + 64)
+		return 1;
+	fxsave_address = round_down(stack_top -
+		UML_X86_64_XSTATE_FRAME_SIZE, 64);
+	if (fxsave_address < UML_X86_32_FSAVE_HEADER_SIZE)
+		return 1;
+	fpstate_address = fxsave_address - UML_X86_32_FSAVE_HEADER_SIZE;
+	if (fpstate_address < frame_size + 16)
+		return 1;
+	frame_address = fpstate_address - frame_size;
+	frame_address = ((frame_address + 4) & ~15UL) - 4;
+	frame_end = fxsave_address + UML_X86_64_XSTATE_FRAME_SIZE;
+	if (frame_end < frame_address ||
+	    !access_ok((void __user *)frame_address,
+		       frame_end - frame_address))
+		return 1;
+	*frame_out = (void __user *)frame_address;
+	*fpstate_out = (void __user *)fpstate_address;
+	return 0;
+}
+
+static int x86_32_signal_restorer(struct ksignal *ksig,
+				  unsigned long fallback,
+				  u32 *restorer_out)
+{
+	unsigned long restorer = fallback;
+
+	if (ksig->ka.sa.sa_flags & SA_RESTORER)
+		restorer = (unsigned long)ksig->ka.sa.sa_restorer;
+	if (restorer > U32_MAX)
+		return 1;
+	*restorer_out = restorer;
+	return 0;
+}
+
+static void enter_x86_32_signal_handler(struct ksignal *ksig,
+					struct pt_regs *regs,
+					unsigned long frame,
+					unsigned long info,
+					unsigned long context)
+{
+	struct uml_pt_regs *guest = &regs->regs;
+
+	clear_x86_64_fpstate(guest);
+	upt_x86_32_set_task_mode(guest, 1);
+	upt_x86_64_set_segment_selector(guest, 0, UML_X86_32_USER_DS);
+	upt_x86_64_set_segment_selector(guest, 1, UML_X86_32_USER_CS);
+	upt_x86_64_set_segment_selector(guest, 2, UML_X86_32_USER_DS);
+	upt_x86_64_set_segment_selector(guest, 3, UML_X86_32_USER_DS);
+	guest->svcr &= ~UML_X86_64_COMPAT_SYSCALL;
+	UPT_X86_64(guest, UML_X86_64_RSP) = frame;
+	UPT_X86_64_RIP(guest) = (unsigned long)ksig->ka.sa.sa_handler;
+	UPT_X86_64(guest, UML_X86_64_RAX) = ksig->sig;
+	UPT_X86_64(guest, UML_X86_64_RDX) = info;
+	UPT_X86_64(guest, UML_X86_64_RCX) = context;
+	UPT_X86_64_RFLAGS(guest) &=
+		~(UML_X86_64_RFLAGS_TF | UML_X86_64_RFLAGS_DF |
+		  UML_X86_64_RFLAGS_RF);
+}
+
+static int setup_x86_32_legacy_signal_stack(unsigned long stack_top,
+					    struct ksignal *ksig,
+					    struct pt_regs *regs,
+					    sigset_t *mask)
+{
+	static const u8 retcode[8] = {
+		0x58, 0xb8, UML_X86_32_NR_SIGRETURN, 0, 0, 0, 0xcd, 0x80,
+	};
+	struct uml_x86_32_sigframe __user *frame;
+	struct uml_x86_32_xstate __user *fpstate;
+	void __user *frame_pointer;
+	u32 restorer;
+	int error = 0;
+
+	if (allocate_x86_32_signal_frame(stack_top, sizeof(*frame),
+					 &frame_pointer, &fpstate))
+		return 1;
+	frame = frame_pointer;
+	if ((unsigned long)frame > U32_MAX ||
+	    (unsigned long)ksig->ka.sa.sa_handler > U32_MAX ||
+	    x86_32_signal_restorer(ksig,
+		(unsigned long)&frame->retcode, &restorer))
+		return 1;
+
+	error |= put_user(restorer, &frame->pretcode);
+	error |= put_user(ksig->sig, &frame->signal);
+	error |= save_x86_32_fpstate(fpstate, regs);
+	error |= save_x86_32_mcontext(&frame->context, regs,
+		mask->sig[0], (unsigned long)fpstate);
+	error |= put_user((u32)(mask->sig[0] >> 32), &frame->extra_mask);
+	error |= copy_to_user(frame->retcode, retcode, sizeof(retcode));
+	if (error)
+		return error;
+
+	enter_x86_32_signal_handler(ksig, regs, (unsigned long)frame, 0, 0);
+	return 0;
+}
+
+static int setup_x86_32_rt_signal_stack(unsigned long stack_top,
+					struct ksignal *ksig,
+					struct pt_regs *regs,
+					sigset_t *mask)
+{
+	static const u8 retcode[8] = {
+		0xb8, UML_X86_32_NR_RT_SIGRETURN, 0, 0, 0, 0xcd, 0x80, 0,
+	};
+	struct uml_x86_32_rt_sigframe __user *frame;
+	struct uml_x86_32_xstate __user *fpstate;
+	void __user *frame_pointer;
+	u32 restorer;
+	int error = 0;
+
+	if (allocate_x86_32_signal_frame(stack_top, sizeof(*frame),
+					 &frame_pointer, &fpstate))
+		return 1;
+	frame = frame_pointer;
+	if ((unsigned long)frame > U32_MAX ||
+	    (unsigned long)ksig->ka.sa.sa_handler > U32_MAX ||
+	    x86_32_signal_restorer(ksig,
+		(unsigned long)&frame->retcode, &restorer))
+		return 1;
+
+	error |= put_user(restorer, &frame->pretcode);
+	error |= put_user(ksig->sig, &frame->signal);
+	error |= put_user((u32)(unsigned long)&frame->info,
+			  &frame->siginfo_pointer);
+	error |= put_user((u32)(unsigned long)&frame->context,
+			  &frame->ucontext_pointer);
+	error |= copy_siginfo_to_user32(&frame->info, &ksig->info);
+	error |= put_user(UML_X86_64_UC_FP_XSTATE, &frame->context.flags);
+	error |= put_user(0, &frame->context.link);
+	error |= __compat_save_altstack(&frame->context.stack,
+		UPT_X86_64(&regs->regs, UML_X86_64_RSP));
+	error |= put_compat_sigset(&frame->context.sigmask, mask,
+				   sizeof(frame->context.sigmask));
+	error |= save_x86_32_fpstate(fpstate, regs);
+	error |= save_x86_32_mcontext(&frame->context.mcontext, regs,
+		mask->sig[0], (unsigned long)fpstate);
+	error |= copy_to_user(frame->retcode, retcode, sizeof(retcode));
+	if (error)
+		return error;
+
+	enter_x86_32_signal_handler(ksig, regs, (unsigned long)frame,
+		(unsigned long)&frame->info, (unsigned long)&frame->context);
+	return 0;
+}
+
+static int setup_x86_32_signal_stack(unsigned long stack_top,
+				     struct ksignal *ksig,
+				     struct pt_regs *regs, sigset_t *mask)
+{
+	if (ksig->ka.sa.sa_flags & SA_SIGINFO)
+		return setup_x86_32_rt_signal_stack(stack_top, ksig, regs, mask);
+	return setup_x86_32_legacy_signal_stack(stack_top, ksig, regs, mask);
+}
