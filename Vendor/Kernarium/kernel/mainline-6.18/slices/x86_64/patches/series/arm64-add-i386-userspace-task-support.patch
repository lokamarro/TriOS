@@ -100,6 +100,17 @@ static __always_inline void cpu_relax(void)
 #endif
 
 #ifdef CONFIG_UML_X86_64_USERSPACE_ONLY
+/*
+ * An i386 task's address space, as x86's: the top 8 KiB of 4 GiB belong to
+ * the kernel, the stack ends two pages below that, and the legacy mmap area
+ * starts a third of the way up.
+ */
+#define UML_X86_32_TASK_SIZE		0xffffe000UL
+#define UML_COMPAT_TASK_SIZE		UML_X86_32_TASK_SIZE
+#define UML_COMPAT_STACK_TOP		(UML_X86_32_TASK_SIZE - 2 * PAGE_SIZE)
+#define UML_COMPAT_TASK_UNMAPPED_BASE \
+	PAGE_ALIGN(UML_X86_32_TASK_SIZE / 3)
+
 extern int uml_x86_64_get_tsc_mode(unsigned long address);
 extern int uml_x86_64_set_tsc_mode(unsigned int mode);
 
