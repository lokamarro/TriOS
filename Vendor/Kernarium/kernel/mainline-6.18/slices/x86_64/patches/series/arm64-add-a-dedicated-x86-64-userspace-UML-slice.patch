+static long uml_x86_64_stat_call(struct uml_pt_regs *regs, int syscall)
+{
+	struct kstat stat;
+	long error;
+
+	switch (syscall) {
+	case 4:
+		error = vfs_stat((const char __user *)UPT_SYSCALL_ARG1(regs),
+				 &stat);
+		break;
+	case 5:
+		error = vfs_fstat(UPT_SYSCALL_ARG1(regs), &stat);
+		break;
+	case 6:
+		error = vfs_lstat((const char __user *)UPT_SYSCALL_ARG1(regs),
+				  &stat);
+		break;
+	case 262:
+		error = vfs_fstatat(UPT_SYSCALL_ARG1(regs),
+				    (const char __user *)UPT_SYSCALL_ARG2(regs),
+				    &stat, UPT_SYSCALL_ARG4(regs));
+		break;
+	default:
+		return -ENOSYS;
+	}
+	if (error)
+		return error;
+	return uml_x86_64_copy_stat(&stat,
+		syscall == 262 ? UPT_SYSCALL_ARG3(regs) :
+		UPT_SYSCALL_ARG2(regs));
+}
