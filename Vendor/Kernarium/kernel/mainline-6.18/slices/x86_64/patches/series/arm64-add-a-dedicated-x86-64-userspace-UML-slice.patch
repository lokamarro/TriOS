+struct epoll_event __user *
+uml_x86_64_epoll_put_uevent(__poll_t revents, __u64 data,
+			    struct epoll_event __user *uevent)
+{
+	struct uml_x86_64_epoll_event value = {
+		.events = (__force __u32)revents,
+		.data = data,
+	};
+	struct uml_x86_64_epoll_event __user *x86_event =
+		(void __user *)uevent;
+
+	if (copy_to_user(x86_event, &value, sizeof(value)))
+		return NULL;
+	return (struct epoll_event __user *)(x86_event + 1);
