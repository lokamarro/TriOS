diff --git a/arch/arm64/um/Kconfig b/arch/arm64/um/Kconfig
index b0bdc892ebff790cc6bdd8002886b56566f08794..e379296b3128502aafbe5ac48c589da11fe9f37e 100644
--- a/arch/arm64/um/Kconfig
+++ b/arch/arm64/um/Kconfig
@@ -23,16 +23,28 @@ config UML_ARM64
 	select UML_SUBARCH_SUPPORTS_SMP
 
 # Every arm64 task carries SME registers in its Darwin bridge tail, and gets
-# SME task state when the host implements SME for the run.
+# SME task state when the host implements SME for the run.  x86-64 tasks have
+# none.
 config UML_ARM64_SME
-	def_bool y
+	def_bool !UML_X86_64_USERSPACE_ONLY
+
+config UML_X86_64_USERSPACE_ONLY
+	bool "Run x86-64 userspace exclusively"
+	depends on PAGE_SIZE_4KB
+	select UML_DARWIN_MM_SHARED
+	help
+	  Build the dedicated Darwin UML compatibility slice whose kernel
+	  remains arm64.  Every userspace task uses the Linux x86-64 ABI, and
+	  arm64 userspace executables are rejected.  This slice requires 4 KiB
+	  guest pages and must not be selected by a native arm64 slice.
 
 # Every arm64 task may run AArch32 code (armhf and Android's armeabi-v7a) as
 # arm64 Linux's COMPAT does, once the host's engine implements it.  Until
 # then the compat HWCAPs read zero, a 32-bit executable gets ENOEXEC and
 # personality(PER_LINUX32) fails.
+# The x86-64 slice has no arm64 userspace.
 config UML_ARM64_AARCH32
-	def_bool y
+	def_bool !UML_X86_64_USERSPACE_ONLY
 	select ARCH_WANT_COMPAT_IPC_PARSE_VERSION
 	select AUDIT_ARCH_COMPAT_GENERIC
 	select COMPAT_OLD_SIGACTION
@@ -47,9 +59,10 @@ config COMPAT
 # PR_SET_TAGGED_ADDR_CTRL, NT_ARM_TAGGED_ADDR_CTRL and the
 # abi.tagged_addr_disabled sysctl.  A task may pass a tagged pointer only
 # while the host's engines ignore the top byte of a data address (TBI0), which
-# the kernel asks the host at boot.
+# the kernel asks the host at boot.  x86-64 tasks have no such byte, so the
+# x86-64 slice has no tagged-address ABI.
 config UML_ARM64_TAGGED_ADDR_ABI
-	def_bool y
+	def_bool !UML_X86_64_USERSPACE_ONLY
 
 config KUSER_HELPERS
 	bool "Enable kuser helpers page for 32-bit applications"
diff --git a/arch/arm64/um/Makefile b/arch/arm64/um/Makefile
index c9712aae23d0a57eb3cb47e39e2f718b67cbf40e..8fc740b497d85ddc1e749cb824e826df8e7c227c 100644
--- a/arch/arm64/um/Makefile
+++ b/arch/arm64/um/Makefile
@@ -1,11 +1,28 @@
 # SPDX-License-Identifier: GPL-2.0
 
 obj-y := bugs.o delay.o fault.o mem.o mmap.o ptrace.o registers.o setjmp.o \
-	signal.o subarch.o syscall_table.o syscalls.o sysrq.o tls.o
+	signal.o subarch.o syscall_table.o syscalls.o sysrq.o tls.o \
+	x86_64_syscalls.o
 obj-$(CONFIG_UML_ARM64_SME) += sme.o sme_signal.o
 obj-$(CONFIG_UML_ARM64_TAGGED_ADDR_ABI) += tagged_addr.o
 obj-$(CONFIG_UML_ARM64_AARCH32) += aarch32.o aarch32_pages.o \
 	armv8_deprecated.o ptrace32.o signal32.o sys32.o sys_compat.o
+obj-$(CONFIG_UML_X86_64_USERSPACE_ONLY) += x86_syscall_tables.o
+
+x86-syscalltbl := $(srctree)/scripts/syscalltbl.sh
+x86-syscall-64 := $(srctree)/arch/x86/entry/syscalls/syscall_64.tbl
+
+quiet_cmd_x86_systbl = X86SYSTBL $@
+      cmd_x86_systbl = $(CONFIG_SHELL) $(x86-syscalltbl) \
+		--abis $(abis) $< $@
+
+$(obj)/x86_syscalls_64.h: abis := common,64
+$(obj)/x86_syscalls_64.h: $(x86-syscall-64) $(x86-syscalltbl) FORCE
+	$(call if_changed,x86_systbl)
+
+$(obj)/x86_syscall_tables.o: $(obj)/x86_syscalls_64.h
+
+targets += x86_syscalls_64.h
 
 # The emulation tracepoint is arm64 Linux's own.
 CFLAGS_armv8_deprecated.o := -I$(srctree)/arch/arm64/kernel
diff --git a/arch/arm64/um/asm/elf.h b/arch/arm64/um/asm/elf.h
index 2dc1b1be43dca961e4ce25ff7b2407caa3ccf894..3bfa08cbdb8451ae06f112a645439aa7fccbdbf6 100644
--- a/arch/arm64/um/asm/elf.h
+++ b/arch/arm64/um/asm/elf.h
@@ -4,12 +4,7 @@
 
 #include <asm/user.h>
 #include <asm/ptrace.h>
-/*
- * The native header, which uapi/asm/ptrace.h also includes, defines ELF_HWCAP
- * and friends for the native CPU feature code; including it first lets the
- * definitions below replace those in every file.
- */
-#include <asm/hwcap.h>
+#include <uapi/asm/hwcap.h>
 #include <uapi/linux/elf.h>
 
 #define CORE_DUMP_USE_REGSET
@@ -27,26 +22,14 @@
 
 #define ELF_CLASS ELFCLASS64
 #define ELF_DATA ELFDATA2LSB
-#define ELF_ARCH EM_AARCH64
-#define ELF_PLATFORM "aarch64"
-/*
- * Obtain the virtual CPU profile after the host CLI has selected an execution
- * engine.  The backend deliberately reports only extensions implemented by
- * every path selected for that engine; it never copies an unchecked host mask
- * into the guest auxiliary vector.
+#define ELF_ARCH EM_X86_64
+#define ELF_PLATFORM "x86_64"
+/* CPUID is the authoritative x86 feature interface.  Keep the auxiliary
+ * vector empty until every advertised bit is tied to the gadget feature
+ * matrix.
  */
-#undef ELF_HWCAP
-#undef ELF_HWCAP2
-#undef ELF_HWCAP3
-#ifdef UML_HOST_DARWIN
-extern unsigned long darwin_uml_guest_hwcap(void);
-extern unsigned long darwin_uml_guest_hwcap2(void);
-#define ELF_HWCAP darwin_uml_guest_hwcap()
-#define ELF_HWCAP2 darwin_uml_guest_hwcap2()
-#else
-#define ELF_HWCAP (HWCAP_FP | HWCAP_ASIMD)
+#define ELF_HWCAP 0
 #define ELF_HWCAP2 0
-#endif
 #define ELF_EXEC_PAGESIZE PAGE_SIZE
 #define ELF_ET_DYN_BASE (TASK_SIZE * 2 / 3)
 #ifdef CONFIG_UML_ARM64_AARCH32
@@ -58,10 +41,17 @@ extern unsigned long darwin_uml_guest_hwcap2(void);
 #define STACK_RND_MASK (0x3ffff >> (PAGE_SHIFT - 12))
 #endif
 
-#define elf_check_arch(header) ((header)->e_machine == EM_AARCH64)
+#define elf_check_arch(header) ((header)->e_machine == EM_X86_64)
 
+/* x86-64 starts a task with the flat 64-bit code and stack selectors and
+ * with RFLAGS IF and bit 1, as Linux's start_thread(); the data selectors
+ * stay null as flush_thread() left them.
+ */
 #define ELF_PLAT_INIT(regs, load_address) do { \
-	PT_REGS_X((regs), 0) = 0; \
+	UPT_X86_64(&(regs)->regs, UML_X86_64_RDX) = 0; \
+	UPT_X86_64_RFLAGS(&(regs)->regs) = UML_X86_RFLAGS_INITIAL; \
+	upt_x86_64_set_segment_selector(&(regs)->regs, 1, 0x33); \
+	upt_x86_64_set_segment_selector(&(regs)->regs, 2, 0x2b); \
 } while (0)
 
 #ifdef CONFIG_COMPAT
@@ -76,7 +66,7 @@ extern unsigned long darwin_uml_guest_hwcap2(void);
 #endif
 
 typedef unsigned long elf_greg_t;
-#define ELF_NGREG 34
+#define ELF_NGREG 27
 typedef elf_greg_t elf_gregset_t[ELF_NGREG];
 
 struct uml_arm64_fpsimd_state {
@@ -87,79 +77,37 @@ struct uml_arm64_fpsimd_state {
 typedef struct uml_arm64_fpsimd_state elf_fpregset_t;
 
 #define ELF_CORE_COPY_REGS(destination, source) do { \
-	int register_index; \
-	for (register_index = 0; register_index < 31; register_index++) \
-		(destination)[register_index] = PT_REGS_X((source), register_index); \
-	(destination)[31] = PT_REGS_SP(source); \
-	(destination)[32] = PT_REGS_IP(source); \
-	(destination)[33] = PT_REGS_PSTATE(source); \
+	struct uml_pt_regs *guest = &(source)->regs; \
+	(destination)[0] = UPT_X86_64(guest, UML_X86_64_R15); \
+	(destination)[1] = UPT_X86_64(guest, UML_X86_64_R14); \
+	(destination)[2] = UPT_X86_64(guest, UML_X86_64_R13); \
+	(destination)[3] = UPT_X86_64(guest, UML_X86_64_R12); \
+	(destination)[4] = UPT_X86_64(guest, UML_X86_64_RBP); \
+	(destination)[5] = UPT_X86_64(guest, UML_X86_64_RBX); \
+	(destination)[6] = UPT_X86_64(guest, UML_X86_64_R11); \
+	(destination)[7] = UPT_X86_64(guest, UML_X86_64_R10); \
+	(destination)[8] = UPT_X86_64(guest, UML_X86_64_R9); \
+	(destination)[9] = UPT_X86_64(guest, UML_X86_64_R8); \
+	(destination)[10] = UPT_X86_64(guest, UML_X86_64_RAX); \
+	(destination)[11] = UPT_X86_64(guest, UML_X86_64_RCX); \
+	(destination)[12] = UPT_X86_64(guest, UML_X86_64_RDX); \
+	(destination)[13] = UPT_X86_64(guest, UML_X86_64_RSI); \
+	(destination)[14] = UPT_X86_64(guest, UML_X86_64_RDI); \
+	(destination)[15] = UPT_SYSCALL_NR(guest); \
+	(destination)[16] = UPT_X86_64_RIP(guest); \
+	(destination)[17] = upt_x86_64_segment_selector(guest, 1); \
+	(destination)[18] = UPT_X86_64_RFLAGS(guest); \
+	(destination)[19] = UPT_X86_64(guest, UML_X86_64_RSP); \
+	(destination)[20] = upt_x86_64_segment_selector(guest, 2); \
+	(destination)[21] = UPT_X86_64_FS_BASE(guest); \
+	(destination)[22] = UPT_X86_64_GS_BASE(guest); \
+	(destination)[23] = upt_x86_64_segment_selector(guest, 3); \
+	(destination)[24] = upt_x86_64_segment_selector(guest, 0); \
+	(destination)[25] = upt_x86_64_segment_selector(guest, 4); \
+	(destination)[26] = upt_x86_64_segment_selector(guest, 5); \
 } while (0);
 
 #define FIXADDR_USER_START 0
 #define FIXADDR_USER_END 0
 
-#ifdef CONFIG_UML_ARM64_AARCH32
-/*
- * AArch32 executables, which fs/compat_binfmt_elf.c loads with the compat_*
- * and COMPAT_* names below.  The auxiliary vector carries the compat HWCAPs
- * the run's engine reports (zero without AArch32, which makes compat exec
- * fail with ENOEXEC) and no AT_SYSINFO_EHDR or AT_MINSIGSTKSZ: there is no
- * 32-bit vDSO, and the 64-bit frame size is no 32-bit task's.
- */
-#define COMPAT_ELF_PLATFORM		("v8l")
-#undef COMPAT_ELF_HWCAP
-#undef COMPAT_ELF_HWCAP2
-#undef COMPAT_ELF_HWCAP3
-#define COMPAT_ELF_HWCAP		(uml_arm64_compat_hwcap)
-#define COMPAT_ELF_HWCAP2		(uml_arm64_compat_hwcap2)
-/* PIE load location for compat arm. Must match ARM ELF_ET_DYN_BASE. */
-#define COMPAT_ELF_ET_DYN_BASE		0x000400000UL
-#define COMPAT_ARCH_DLINFO
-#define EF_ARM_EABI_MASK		0xff000000
-
-typedef unsigned int compat_elf_greg_t;
-typedef compat_elf_greg_t compat_elf_gregset_t[COMPAT_ELF_NGREG];
-
-struct elf32_hdr;
-extern int compat_elf_check_arch(const struct elf32_hdr *hdr);
-#define compat_elf_check_arch		compat_elf_check_arch
-
-/*
- * Unlike the native SET_PERSONALITY macro, the compat version maintains
- * READ_IMPLIES_EXEC across an execve() since this is the behaviour on
- * arch/arm.
- */
-#define COMPAT_SET_PERSONALITY(ex) set_thread_flag(TIF_32BIT)
-#define compat_elf_read_implies_exec(ex, stk) ((stk) == EXSTACK_DEFAULT)
-extern void compat_start_thread(struct pt_regs *regs, unsigned long pc,
-				unsigned long sp);
-#define compat_start_thread		compat_start_thread
-
-/* The vectors page with the kuser helpers, and the signal-return page. */
-#define compat_arch_setup_additional_pages aarch32_setup_additional_pages
-struct linux_binprm;
-extern int aarch32_setup_additional_pages(struct linux_binprm *bprm,
-					  int uses_interp);
-#endif
-
-#ifdef CONFIG_UML_ARM64_SME
-/*
- * With SME, AT_MINSIGSTKSZ gives the stack the largest signal frame needs,
- * as on native arm64; without it the vector stays as it was.
- */
-extern unsigned long uml_arm64_minsigstksz;
-#define ARCH_DLINFO do { \
-	if (uml_arm64_minsigstksz) \
-		NEW_AUX_ENT(AT_MINSIGSTKSZ, uml_arm64_minsigstksz); \
-} while (0)
-#endif
-
-#ifdef UML_HOST_DARWIN
-/* Maps the page that holds the sigreturn trampoline (signal.c). */
-#define ARCH_HAS_SETUP_ADDITIONAL_PAGES 1
-struct linux_binprm;
-extern int arch_setup_additional_pages(struct linux_binprm *bprm,
-				       int uses_interp);
-#endif
-
 #endif
