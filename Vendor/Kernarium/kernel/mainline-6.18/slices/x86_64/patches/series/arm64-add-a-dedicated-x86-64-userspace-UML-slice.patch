+#define UML_X86_64_O_DIRECT	00040000ULL
+#define UML_X86_64_O_LARGEFILE	00100000ULL
+#define UML_X86_64_O_DIRECTORY	00200000ULL
+#define UML_X86_64_O_NOFOLLOW	00400000ULL
+#define UML_X86_64_OPEN_ARCH_MASK	00740000ULL
