+static long uml_x86_64_fcntl(struct uml_pt_regs *regs)
+{
+	unsigned int command = UPT_SYSCALL_ARG2(regs);
+	unsigned long argument = UPT_SYSCALL_ARG3(regs);
+	long result;
+
+	if (command == F_SETFL)
+		argument = uml_x86_64_to_native_open_flags((unsigned int)argument);
+	result = sys_fcntl(UPT_SYSCALL_ARG1(regs), command, argument);
+	if (command == F_GETFL && result >= 0)
+		result = uml_native_to_x86_64_open_flags((unsigned int)result);
+	return result;
+}
