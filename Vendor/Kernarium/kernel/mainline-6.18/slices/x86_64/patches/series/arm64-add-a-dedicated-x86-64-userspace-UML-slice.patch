+#define UML_ARCH_SET_GS 0x1001
+#define UML_ARCH_SET_FS 0x1002
+#define UML_ARCH_GET_FS 0x1003
+#define UML_ARCH_GET_GS 0x1004
+#define UML_ARCH_GET_CPUID 0x1011
+#define UML_ARCH_SET_CPUID 0x1012
+
+long uml_x86_64_arch_prctl(struct uml_pt_regs *regs)
+{
+	unsigned long operation = UPT_SYSCALL_ARG1(regs);
+	unsigned long address = UPT_SYSCALL_ARG2(regs);
+
+	switch (operation) {
+	case UML_ARCH_SET_FS:
+		UPT_X86_64_FS_BASE(regs) = address;
+		return 0;
+	case UML_ARCH_SET_GS:
+		UPT_X86_64_GS_BASE(regs) = address;
+		return 0;
+	case UML_ARCH_GET_FS:
+		return put_user(UPT_X86_64_FS_BASE(regs),
+			(unsigned long __user *)address) ? -EFAULT : 0;
+	case UML_ARCH_GET_GS:
+		return put_user(UPT_X86_64_GS_BASE(regs),
+			(unsigned long __user *)address) ? -EFAULT : 0;
+	/* The emulated CPU has no CPUID faulting, so CPUID always executes. */
+	case UML_ARCH_GET_CPUID:
+		return 1;
+	case UML_ARCH_SET_CPUID:
+		return -ENODEV;
+	default:
+		return -EINVAL;
+	}
+}
+
+int uml_x86_64_get_tsc_mode(unsigned long address)
+{
+	int mode = current_pt_regs()->regs.svcr & UML_X86_64_TSC_SIGSEGV ?
+		PR_TSC_SIGSEGV : PR_TSC_ENABLE;
+
+	return put_user(mode, (int __user *)address);
+}
+
+int uml_x86_64_set_tsc_mode(unsigned int mode)
+{
+	struct uml_pt_regs *regs = &current_pt_regs()->regs;
+
+	if (mode == PR_TSC_SIGSEGV)
+		regs->svcr |= UML_X86_64_TSC_SIGSEGV;
+	else if (mode == PR_TSC_ENABLE)
+		regs->svcr &= ~UML_X86_64_TSC_SIGSEGV;
+	else
+		return -EINVAL;
+	return 0;
+}
+
+long uml_x86_64_fixup_uname(struct uml_pt_regs *regs, long result)
+{
+	static const char machine[] = "x86_64";
+	struct new_utsname __user *name;
+
+	if (result)
+		return result;
+	name = (struct new_utsname __user *)UPT_SYSCALL_ARG1(regs);
+	return copy_to_user(name->machine, machine, sizeof(machine)) ?
+		-EFAULT : 0;
+}
