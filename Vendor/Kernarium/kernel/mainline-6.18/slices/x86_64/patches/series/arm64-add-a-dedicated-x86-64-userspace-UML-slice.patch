--- a/arch/arm64/um/asm/ptrace.h
+++ b/arch/arm64/um/asm/ptrace.h
@@ -9,19 +9,6 @@ enum {
 
 #include <linux/errno.h>
 #include <linux/types.h>
-#include <asm/aarch32.h>
-
-/*
- * An AArch32 task's stack pointer is x13 and its restart_syscall number is 0,
- * not the A64 sp and 128; PT_REGS_SP() stays the register image's sp.
