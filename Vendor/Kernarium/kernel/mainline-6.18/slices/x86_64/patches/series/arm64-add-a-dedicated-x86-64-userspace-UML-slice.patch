diff --git a/arch/arm64/um/asm/syscall.h b/arch/arm64/um/asm/syscall.h
index 87c04e32a52fbe1213d88a72d7a7edabdda3a723..4b693f9c17a44cf36913cf91ca080661b5efe504 100644
--- a/arch/arm64/um/asm/syscall.h
+++ b/arch/arm64/um/asm/syscall.h
@@ -10,32 +10,32 @@ typedef asmlinkage long (*sys_call_ptr_t)(unsigned long, unsigned long,
 
 extern const sys_call_ptr_t sys_call_table[];
 
-#ifdef CONFIG_UML_ARM64_AARCH32
-#include <asm/unistd.h>
-#include <asm/unistd_compat_32.h>
-
-/* The AArch32 table, which asm/syscall_table_32.h generates, and ARM's
- * private calls just past it (cacheflush and set_tls). */
-extern const sys_call_ptr_t compat_sys_call_table[];
-extern long compat_arm_syscall(struct uml_pt_regs *regs, int scno);
-
+/*
+ * The x86-64 slice has two ABIs: the x86-64 table and, for long-mode INT 0x80
+ * and compat tasks, the i386 table. handle_syscall() picks them with these.
+ */
 #define UML_SYSCALL_TABLE(r) \
-	(UPT_AARCH32(r) ? compat_sys_call_table : sys_call_table)
+	(UPT_X86_64_COMPAT_SYSCALL(r) ? sys_call_table : \
+	 uml_x86_64_sys_call_table)
