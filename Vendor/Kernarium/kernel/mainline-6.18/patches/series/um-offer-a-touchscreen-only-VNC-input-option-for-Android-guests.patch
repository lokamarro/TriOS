From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 17 Oct 2026 03:14:59 +0900
Subject: [PATCH] um: offer a touchscreen-only VNC input option for Android
 guests

The shared input driver keeps the desktop tablet's mouse buttons and wheel
beside BTN_TOUCH, which libinput guests need. Android and its recovery
must see the Darwin display as a touchscreen, not a hybrid tablet and
mouse: a device that also reports mouse buttons puts them in pointer mode.

CONFIG_UML_VNC_INPUT_TOUCHSCREEN advertises only INPUT_PROP_DIRECT,
BTN_TOUCH and ABS_X/ABS_Y, and discards auxiliary buttons and wheel
events instead of exposing pointer-mode capabilities. Legacy host
BTN_LEFT events still become BTN_TOUCH, so older frontends remain usable;
current frontends send BTN_TOUCH directly. The option is off by default,
so desktop guests keep their tablet.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/um/drivers/Kconfig     | 10 ++++++++++
 arch/um/drivers/vnc_input.c | 33 +++++++++++++++++++++++++--------
 2 files changed, 35 insertions(+), 8 deletions(-)

diff --git a/arch/um/drivers/Kconfig b/arch/um/drivers/Kconfig
index 32721e1b12ab36df3e03e81254bddf46a0e0f6a8..49647d75057b9e4627bda164b35332c5d7aaec61 100644
--- a/arch/um/drivers/Kconfig
+++ b/arch/um/drivers/Kconfig
@@ -177,6 +177,16 @@ config UML_VNC_INPUT
 	  inherited host descriptor. The Darwin VNC frontend uses this to pass
 	  remote client input into the guest Linux input subsystem.
 
+config UML_VNC_INPUT_TOUCHSCREEN
+	bool "Present the VNC pointer as a direct touchscreen only"
+	depends on UML_VNC_INPUT
+	help
+	  Advertise the absolute pointer as a pure direct touchscreen, with
+	  BTN_TOUCH, ABS_X and ABS_Y only, and discard the mouse buttons and
+	  wheel events a desktop guest uses. Android and its recovery must
+	  see a touchscreen rather than a hybrid tablet and mouse, so an
+	  Android guest kernel enables this. Desktop guests leave it off.
+
 config UML_RTC
 	bool "UML RTC driver"
 	depends on RTC_CLASS
diff --git a/arch/um/drivers/vnc_input.c b/arch/um/drivers/vnc_input.c
index 92ba59b6056b1ba7bc1023adca73e01f6242d092..3d95e523e49a8abbe303546235f5592b1705644a 100644
--- a/arch/um/drivers/vnc_input.c
+++ b/arch/um/drivers/vnc_input.c
@@ -46,6 +46,15 @@ static void deliver_event(const struct uml_vnc_input_event *wire)
 	if (type == EV_SYN) {
 		input_sync(keyboard);
 		input_sync(pointer);
+	} else if (IS_ENABLED(CONFIG_UML_VNC_INPUT_TOUCHSCREEN) &&
+		   (type == EV_REL || (type == EV_KEY && code >= BTN_MISC))) {
+		/*
+		 * A touchscreen reports only contacts. Current frontends send
+		 * BTN_TOUCH; a primary click from an older one becomes a
+		 * contact, and other buttons and the wheel are discarded.
+		 */
+		if (type == EV_KEY && (code == BTN_TOUCH || code == BTN_LEFT))
+			input_event(pointer, EV_KEY, BTN_TOUCH, value);
 	} else if (type == EV_ABS || type == EV_REL ||
 		   (type == EV_KEY && code >= BTN_MISC)) {
 		input_event(pointer, type, code, value);
@@ -98,7 +107,8 @@ static void configure_keyboard(struct input_dev *device)
 
 static void configure_pointer(struct input_dev *device)
 {
-	device->name = "Darwin UML VNC Tablet";
+	device->name = IS_ENABLED(CONFIG_UML_VNC_INPUT_TOUCHSCREEN) ?
+		"Darwin UML Touchscreen" : "Darwin UML VNC Tablet";
 	device->phys = "uml/vnc/input1";
 	device->id.bustype = BUS_VIRTUAL;
 	/*
@@ -113,11 +123,17 @@ static void configure_pointer(struct input_dev *device)
 	 */
 	__set_bit(INPUT_PROP_DIRECT, device->propbit);
 	input_set_capability(device, EV_KEY, BTN_TOUCH);
-	input_set_capability(device, EV_KEY, BTN_LEFT);
-	input_set_capability(device, EV_KEY, BTN_MIDDLE);
-	input_set_capability(device, EV_KEY, BTN_RIGHT);
-	input_set_capability(device, EV_REL, REL_WHEEL);
-	input_set_capability(device, EV_REL, REL_HWHEEL);
+	/*
+	 * Android and its recovery enter pointer mode for a device that also
+	 * reports mouse buttons, so a touchscreen-only kernel offers none.
+	 */
+	if (!IS_ENABLED(CONFIG_UML_VNC_INPUT_TOUCHSCREEN)) {
+		input_set_capability(device, EV_KEY, BTN_LEFT);
+		input_set_capability(device, EV_KEY, BTN_MIDDLE);
+		input_set_capability(device, EV_KEY, BTN_RIGHT);
+		input_set_capability(device, EV_REL, REL_WHEEL);
+		input_set_capability(device, EV_REL, REL_HWHEEL);
+	}
 	input_set_abs_params(device, ABS_X, 0, 32767, 0, 0);
 	input_set_abs_params(device, ABS_Y, 0, 32767, 0, 0);
 }
@@ -166,8 +182,9 @@ static int __init vnc_input_init(void)
 	if (error)
 		pr_warn("uml_vnc_input: input cannot wake the guest: %d\n",
 			error);
-	pr_info("uml_vnc_input: registered keyboard and tablet at fd=%d\n",
-		input_fd);
+	pr_info("uml_vnc_input: registered keyboard and %s at fd=%d\n",
+		IS_ENABLED(CONFIG_UML_VNC_INPUT_TOUCHSCREEN) ?
+		"touchscreen" : "tablet", input_fd);
 	return 0;
 
 unregister_pointer:
