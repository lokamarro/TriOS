From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 17 Oct 2026 03:15:50 +0900
Subject: [PATCH] drm/virtio: offer the standard 32-bit RGB formats as a plane
 option

The primary plane offers XRGB8888 and ARGB8888, and framebuffer creation
refuses every other format. Android's composer allocates its RGBA and
RGBX buffers as ABGR8888 and XBGR8888 and scans them out directly, so on
this plane its framebuffers would be refused and nothing would reach the
display.

CONFIG_DRM_VIRTIO_GPU_STANDARD_FORMATS adds BGRX8888, BGRA8888,
RGBX8888, RGBA8888, XBGR8888 and ABGR8888 after the two existing
formats, translates the four new byte orders to the matching Virtio-GPU
formats, and lets framebuffer creation accept exactly the formats the
plane lists. XRGB8888 stays first, so fbdev keeps it. The option is off
by default, so desktop guests see the same plane as before: Linux
compositors choose their scanout format from the plane's list.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/virtio/Kconfig           | 13 ++++++++++
 drivers/gpu/drm/virtio/virtgpu_display.c |  3 +--
 drivers/gpu/drm/virtio/virtgpu_drv.h     |  1 +
 drivers/gpu/drm/virtio/virtgpu_plane.c   | 30 ++++++++++++++++++++++++
 4 files changed, 45 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/virtio/Kconfig b/drivers/gpu/drm/virtio/Kconfig
index fc884fb57b7eaf4217cbdf9277f79b89f5ab9021..f8413ee71ed7a9e2e62275ef7809a08bf42843d9 100644
--- a/drivers/gpu/drm/virtio/Kconfig
+++ b/drivers/gpu/drm/virtio/Kconfig
@@ -23,3 +23,16 @@ config DRM_VIRTIO_GPU_KMS
 	   required.
 
 	   If unsure, say Y.
+
+config DRM_VIRTIO_GPU_STANDARD_FORMATS
+	bool "Offer every 32-bit RGB byte order on the primary plane"
+	depends on DRM_VIRTIO_GPU_KMS && !CPU_BIG_ENDIAN
+	help
+	   The primary plane normally offers XRGB8888 and ARGB8888. Android's
+	   composer scans out its RGBA and RGBX buffers (ABGR8888 and
+	   XBGR8888) directly, and expects the standard 32-bit formats on the
+	   plane. Say Y to also offer BGRX8888, BGRA8888, RGBX8888, RGBA8888,
+	   XBGR8888 and ABGR8888, which the device translates to its own
+	   formats. XRGB8888 stays first.
+
+	   If unsure, say N.
diff --git a/drivers/gpu/drm/virtio/virtgpu_display.c b/drivers/gpu/drm/virtio/virtgpu_display.c
index 7c31ff32787d99f2b4df14bdbe3e9a199ba6f6f3..20e38e1b515c85e68cb048b9e667cc3e9f349969 100644
--- a/drivers/gpu/drm/virtio/virtgpu_display.c
+++ b/drivers/gpu/drm/virtio/virtgpu_display.c
@@ -315,8 +315,7 @@ virtio_gpu_user_framebuffer_create(struct drm_device *dev,
 	struct virtio_gpu_framebuffer *virtio_gpu_fb;
 	int ret;
 
-	if (mode_cmd->pixel_format != DRM_FORMAT_HOST_XRGB8888 &&
-	    mode_cmd->pixel_format != DRM_FORMAT_HOST_ARGB8888)
+	if (!virtio_gpu_is_scanout_format(mode_cmd->pixel_format))
 		return ERR_PTR(-ENOENT);
 
 	/* lookup object associated with res handle */
diff --git a/drivers/gpu/drm/virtio/virtgpu_drv.h b/drivers/gpu/drm/virtio/virtgpu_drv.h
index a5a4646259fc437767bf1e518689af039ebd8300..5ec5807d54c649c976d3704f1def2e6d8fe03dd8 100644
--- a/drivers/gpu/drm/virtio/virtgpu_drv.h
+++ b/drivers/gpu/drm/virtio/virtgpu_drv.h
@@ -570,6 +570,7 @@ void virtio_gpu_modeset_fini(struct virtio_gpu_device *vgdev);
 
 /* virtgpu_plane.c */
 uint32_t virtio_gpu_translate_format(uint32_t drm_fourcc);
+bool virtio_gpu_is_scanout_format(uint32_t drm_fourcc);
 struct drm_plane *virtio_gpu_plane_init(struct virtio_gpu_device *vgdev,
 					enum drm_plane_type type,
 					int index);
diff --git a/drivers/gpu/drm/virtio/virtgpu_plane.c b/drivers/gpu/drm/virtio/virtgpu_plane.c
index a3bab2b277934d74dc78672d11eb93f99d00c39a..95519e405cbf8a446f4c1d607d187b23140da5fc 100644
--- a/drivers/gpu/drm/virtio/virtgpu_plane.c
+++ b/drivers/gpu/drm/virtio/virtgpu_plane.c
@@ -36,6 +36,14 @@
 static const uint32_t virtio_gpu_formats[] = {
 	DRM_FORMAT_HOST_XRGB8888,
 	DRM_FORMAT_HOST_ARGB8888,
+#ifdef CONFIG_DRM_VIRTIO_GPU_STANDARD_FORMATS
+	DRM_FORMAT_BGRX8888,
+	DRM_FORMAT_BGRA8888,
+	DRM_FORMAT_RGBX8888,
+	DRM_FORMAT_RGBA8888,
+	DRM_FORMAT_XBGR8888,
+	DRM_FORMAT_ABGR8888,
+#endif
 };
 
 static const uint32_t virtio_gpu_cursor_formats[] = {
@@ -59,6 +67,18 @@ uint32_t virtio_gpu_translate_format(uint32_t drm_fourcc)
 	case DRM_FORMAT_BGRA8888:
 		format = VIRTIO_GPU_FORMAT_A8R8G8B8_UNORM;
 		break;
+	case DRM_FORMAT_RGBX8888:
+		format = VIRTIO_GPU_FORMAT_X8B8G8R8_UNORM;
+		break;
+	case DRM_FORMAT_RGBA8888:
+		format = VIRTIO_GPU_FORMAT_A8B8G8R8_UNORM;
+		break;
+	case DRM_FORMAT_XBGR8888:
+		format = VIRTIO_GPU_FORMAT_R8G8B8X8_UNORM;
+		break;
+	case DRM_FORMAT_ABGR8888:
+		format = VIRTIO_GPU_FORMAT_R8G8B8A8_UNORM;
+		break;
 	default:
 		/*
 		 * This should not happen, we handle everything listed
@@ -71,6 +91,16 @@ uint32_t virtio_gpu_translate_format(uint32_t drm_fourcc)
 	return format;
 }
 
+bool virtio_gpu_is_scanout_format(uint32_t drm_fourcc)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(virtio_gpu_formats); i++)
+		if (virtio_gpu_formats[i] == drm_fourcc)
+			return true;
+	return false;
+}
+
 static struct
 drm_plane_state *virtio_gpu_plane_duplicate_state(struct drm_plane *plane)
 {
