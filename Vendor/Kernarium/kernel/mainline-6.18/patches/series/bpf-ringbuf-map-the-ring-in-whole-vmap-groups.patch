From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 10 Oct 2026 23:58:06 +0900
Subject: [PATCH] bpf: ringbuf: map the ring in whole vmap groups

Allocate the ring in vmap groups and put lead pages ahead of the
header so the first data copy ends on a group boundary. A data area of
whole groups then repeats whole groups in its second mapping, and every
group is coherent with its user mappings. A smaller ring brackets the
wrapped tail of a record with invalidate_kernel_vmap_range() and
flush_kernel_vmap_range().

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 kernel/bpf/ringbuf.c | 92 +++++++++++++++++++++++++++++++++++---------
 1 file changed, 74 insertions(+), 18 deletions(-)

diff --git a/kernel/bpf/ringbuf.c b/kernel/bpf/ringbuf.c
index bdc524c8ed798a0219b8b251719addcb3df22732..a18854c44903f7776bc63425a995bf8cc093b2f2 100644
--- a/kernel/bpf/ringbuf.c
+++ b/kernel/bpf/ringbuf.c
@@ -9,6 +9,7 @@
 #include <linux/wait.h>
 #include <linux/poll.h>
 #include <linux/kmemleak.h>
+#include <linux/highmem.h>
 #include <uapi/linux/btf.h>
 #include <linux/btf_ids.h>
 #include <asm/rqspinlock.h>
@@ -87,17 +88,32 @@ struct bpf_ringbuf_hdr {
 	u32 pg_off;
 };
 
+/* Pages ahead of struct bpf_ringbuf that end the first data copy on a
+ * vmap group boundary (see arch_vmap_group_order()).
+ */
+static int bpf_ringbuf_nr_lead_pages(size_t data_sz)
+{
+	unsigned int group = 1U << arch_vmap_group_order();
+	unsigned int used = RINGBUF_NR_META_PAGES + (data_sz >> PAGE_SHIFT);
+
+	return (group - used % group) % group;
+}
+
 static struct bpf_ringbuf *bpf_ringbuf_area_alloc(size_t data_sz, int numa_node)
 {
 	const gfp_t flags = GFP_KERNEL_ACCOUNT | __GFP_RETRY_MAYFAIL |
 			    __GFP_NOWARN | __GFP_ZERO;
+	unsigned int order = arch_vmap_group_order();
+	int nr_lead_pages = bpf_ringbuf_nr_lead_pages(data_sz);
 	int nr_meta_pages = RINGBUF_NR_META_PAGES;
 	int nr_data_pages = data_sz >> PAGE_SHIFT;
-	int nr_pages = nr_meta_pages + nr_data_pages;
+	int nr_pages = nr_lead_pages + nr_meta_pages + nr_data_pages;
+	int first_data_page = nr_lead_pages + nr_meta_pages;
 	struct page **pages, *page;
 	struct bpf_ringbuf *rb;
 	size_t array_size;
-	int i;
+	void *area;
+	int i, j;
 
 	/* Each data page is mapped twice to allow "virtual"
 	 * continuous read of samples wrapping around the end of ring
@@ -115,26 +131,37 @@ static struct bpf_ringbuf *bpf_ringbuf_area_alloc(size_t data_sz, int numa_node)
 	 * data due to double-mapped data pages. This works both in kernel and
 	 * when mmap()'ed in user-space, simplifying both kernel and
 	 * user-space implementations significantly.
+	 *
+	 * Where the architecture maps kernel memory in groups of pages, the
+	 * pages are allocated as whole groups and the first copy ends on a
+	 * group boundary, so a data copy that is a whole number of groups
+	 * repeats whole groups and every group is mapped coherently with its
+	 * user mappings. A smaller second copy is synchronized explicitly.
 	 */
-	array_size = (nr_meta_pages + 2 * nr_data_pages) * sizeof(*pages);
+	array_size = (nr_pages + nr_data_pages) * sizeof(*pages);
 	pages = bpf_map_area_alloc(array_size, numa_node);
 	if (!pages)
 		return NULL;
 
-	for (i = 0; i < nr_pages; i++) {
-		page = alloc_pages_node(numa_node, flags, 0);
+	for (i = 0; i < nr_pages; i += 1 << order) {
+		page = alloc_pages_node(numa_node, flags, order);
 		if (!page) {
 			nr_pages = i;
 			goto err_free_pages;
 		}
-		pages[i] = page;
-		if (i >= nr_meta_pages)
-			pages[nr_data_pages + i] = page;
+		if (order)
+			split_page(page, order);
+		for (j = 0; j < 1 << order; j++) {
+			pages[i + j] = page + j;
+			if (i + j >= first_data_page)
+				pages[nr_data_pages + i + j] = page + j;
+		}
 	}
 
-	rb = vmap(pages, nr_meta_pages + 2 * nr_data_pages,
-		  VM_MAP | VM_USERMAP, PAGE_KERNEL);
-	if (rb) {
+	area = vmap(pages, nr_pages + nr_data_pages, VM_MAP | VM_USERMAP,
+		    PAGE_KERNEL);
+	if (area) {
+		rb = area + nr_lead_pages * PAGE_SIZE;
 		kmemleak_not_leak(pages);
 		rb->pages = pages;
 		rb->nr_pages = nr_pages;
@@ -223,8 +250,9 @@ static void bpf_ringbuf_free(struct bpf_ringbuf *rb)
 	 */
 	struct page **pages = rb->pages;
 	int i, nr_pages = rb->nr_pages;
+	int nr_lead_pages = bpf_ringbuf_nr_lead_pages(rb->mask + 1);
 
-	vunmap(rb);
+	vunmap((void *)rb - nr_lead_pages * PAGE_SIZE);
 	for (i = 0; i < nr_pages; i++)
 		__free_page(pages[i]);
 	bpf_map_area_free(pages);
@@ -339,14 +367,12 @@ static u64 ringbuf_map_mem_usage(const struct bpf_map *map)
 {
 	struct bpf_ringbuf *rb;
 	int nr_data_pages;
-	int nr_meta_pages;
 	u64 usage = sizeof(struct bpf_ringbuf_map);
 
 	rb = container_of(map, struct bpf_ringbuf_map, map)->rb;
 	usage += (u64)rb->nr_pages << PAGE_SHIFT;
-	nr_meta_pages = RINGBUF_NR_META_PAGES;
 	nr_data_pages = map->max_entries >> PAGE_SHIFT;
-	usage += (nr_meta_pages + 2 * nr_data_pages) * sizeof(struct page *);
+	usage += (rb->nr_pages + nr_data_pages) * sizeof(struct page *);
 	return usage;
 }
 
@@ -404,11 +430,22 @@ bpf_ringbuf_restore_from_rec(struct bpf_ringbuf_hdr *hdr)
 	return (void*)((addr & PAGE_MASK) - off);
 }
 
+/* A record that wraps past the end of the data area continues in its second
+ * mapping. Return how many of its bytes lie there.
+ */
+static u32 bpf_ringbuf_wrapped_len(struct bpf_ringbuf *rb, unsigned long rec_pos,
+				   u32 len)
+{
+	u32 data_sz = rb->mask + 1;
+
+	return rec_pos + len > data_sz ? rec_pos + len - data_sz : 0;
+}
+
 static void *__bpf_ringbuf_reserve(struct bpf_ringbuf *rb, u64 size)
 {
 	unsigned long cons_pos, prod_pos, new_prod_pos, pend_pos, flags;
 	struct bpf_ringbuf_hdr *hdr;
-	u32 len, pg_off, tmp_size, hdr_len;
+	u32 len, pg_off, tmp_size, hdr_len, wrapped;
 
 	if (unlikely(size > RINGBUF_MAX_RECORD_SZ))
 		return NULL;
@@ -459,6 +496,13 @@ static void *__bpf_ringbuf_reserve(struct bpf_ringbuf *rb, u64 size)
 
 	raw_res_spin_unlock_irqrestore(&rb->spinlock, flags);
 
+	/* The wrapped tail is written through the second mapping; drop any
+	 * stale kernel-alias view of it before the producer writes it.
+	 */
+	wrapped = bpf_ringbuf_wrapped_len(rb, prod_pos & rb->mask, len);
+	if (unlikely(wrapped))
+		invalidate_kernel_vmap_range(rb->data + rb->mask + 1, wrapped);
+
 	return (void *)hdr + BPF_RINGBUF_HDR_SZ;
 }
 
@@ -486,7 +530,7 @@ static void bpf_ringbuf_commit(void *sample, u64 flags, bool discard)
 	unsigned long rec_pos, cons_pos;
 	struct bpf_ringbuf_hdr *hdr;
 	struct bpf_ringbuf *rb;
-	u32 new_len;
+	u32 new_len, wrapped;
 
 	hdr = sample - BPF_RINGBUF_HDR_SZ;
 	rb = bpf_ringbuf_restore_from_rec(hdr);
@@ -494,6 +538,13 @@ static void bpf_ringbuf_commit(void *sample, u64 flags, bool discard)
 	if (discard)
 		new_len |= BPF_RINGBUF_DISCARD_BIT;
 
+	/* Publish a wrapped tail before the header makes it visible. */
+	wrapped = bpf_ringbuf_wrapped_len(rb, (void *)hdr - (void *)rb->data,
+					  round_up((hdr->len & ~BPF_RINGBUF_BUSY_BIT) +
+						   BPF_RINGBUF_HDR_SZ, 8));
+	if (unlikely(wrapped))
+		flush_kernel_vmap_range(rb->data + rb->mask + 1, wrapped);
+
 	/* update record header with correct final size prefix */
 	xchg(&hdr->len, new_len);
 
@@ -671,7 +722,7 @@ const struct bpf_func_proto bpf_ringbuf_discard_dynptr_proto = {
 static int __bpf_user_ringbuf_peek(struct bpf_ringbuf *rb, void **sample, u32 *size)
 {
 	int err;
-	u32 hdr_len, sample_len, total_len, flags, *hdr;
+	u32 hdr_len, sample_len, total_len, flags, wrapped, *hdr;
 	u64 cons_pos, prod_pos;
 
 	/* Synchronizes with smp_store_release() in user-space producer. */
@@ -717,6 +768,11 @@ static int __bpf_user_ringbuf_peek(struct bpf_ringbuf *rb, void **sample, u32 *s
 	if (flags & BPF_RINGBUF_BUSY_BIT)
 		return -ENODATA;
 
+	/* A wrapped sample is read through the second mapping. */
+	wrapped = bpf_ringbuf_wrapped_len(rb, cons_pos & rb->mask, total_len);
+	if (unlikely(wrapped))
+		invalidate_kernel_vmap_range(rb->data + rb->mask + 1, wrapped);
+
 	*sample = (void *)((uintptr_t)rb->data +
 			   (uintptr_t)((cons_pos + BPF_RINGBUF_HDR_SZ) & rb->mask));
 	*size = sample_len;
