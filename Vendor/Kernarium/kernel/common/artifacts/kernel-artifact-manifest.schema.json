{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linux-um-darwin.invalid/kernel/kernel-artifact-manifest.schema.json",
  "title": "Darwin UML prebuilt kernel artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "directory_name",
    "family",
    "slice",
    "published_at_utc",
    "release",
    "page_size",
    "elf_role",
    "source",
    "abi",
    "inventory"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "release_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "directory_name": { "type": "string" },
    "family": { "enum": ["mainline-6.18", "android-6.18"] },
    "slice": { "enum": ["arm64", "x86_64"] },
    "published_at_utc": { "type": "string" },
    "release": { "type": "string" },
    "page_size": { "const": 4096 },
    "elf_role": { "const": "darwin-uml" },
    "source": { "type": "object" },
    "abi": { "type": "object" },
    "inventory": { "type": "array" }
  },
  "oneOf": [
    {
      "properties": {
        "family": { "const": "mainline-6.18" },
        "slice": { "const": "arm64" }
      }
    },
    {
      "properties": {
        "family": { "const": "mainline-6.18" },
        "slice": { "const": "x86_64" }
      }
    },
    {
      "properties": {
        "family": { "const": "android-6.18" },
        "slice": { "const": "arm64" }
      }
    }
  ]
}
