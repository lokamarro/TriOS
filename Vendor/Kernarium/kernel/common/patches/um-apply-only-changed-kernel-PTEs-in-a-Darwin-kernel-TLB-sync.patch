 	return os_unmap_memory((void *)virt, len);
 }
 
+#ifdef UML_HOST_DARWIN
+/*
+ * A kernel PTE whose host mapping has been applied loses _PAGE_NEEDSYNC, and
+ * a kernel-range walk applies only PTEs that carry it.  A vmalloc purge
+ * flushes the whole span between the areas it frees, which mostly holds live
+ * mappings the host already has, and the walk leaves those alone.  The bit is
+ * cleared only while the PTE still holds the applied value: a writer that
+ * changed it meanwhile has set the bit again, as set_pte() and pte_clear()
+ * always do, and the flush that writer publishes applies the new value.  User
+ * PTEs keep the bit; their walk does not read it.
+ */
+static void darwin_init_mm_pte_applied(pte_t *pte, pte_t applied)
+{
+	unsigned long value = pte_val(applied);
+
+	if (value & _PAGE_NEEDSYNC)
+		(void)try_cmpxchg(&pte_val(*pte), &value,
+				  value & ~_PAGE_NEEDSYNC);
+}
+
+/*
+ * The exact repair of a kernel-address fault applies the faulting page even
+ * when its PTE says the host already has it.
+ */
+void um_tlb_force_kernel_page(unsigned long page)
+{
+	unsigned long value;
+	pgd_t *pgd;
+	p4d_t *p4d;
+	pud_t *pud;
+	pmd_t *pmd;
+	pte_t *pte;
+
+	page &= PAGE_MASK;
+	pgd = pgd_offset_k(page);
+	if (pgd_none(*pgd))
+		goto mark;
+	p4d = p4d_offset(pgd, page);
+	if (p4d_none(*p4d))
+		goto mark;
+	pud = pud_offset(p4d, page);
+	if (pud_none(*pud))
+		goto mark;
+	pmd = pmd_offset(pud, page);
+	if (pmd_none(*pmd))
+		goto mark;
+	pte = pte_offset_kernel(pmd, page);
+	value = READ_ONCE(pte_val(*pte));
+	while (!(value & _PAGE_NEEDSYNC) &&
+	       !try_cmpxchg(&pte_val(*pte), &value, value | _PAGE_NEEDSYNC))
+		;
+mark:
+	um_tlb_mark_sync(&init_mm, page, page + PAGE_SIZE);
+}
+#endif
