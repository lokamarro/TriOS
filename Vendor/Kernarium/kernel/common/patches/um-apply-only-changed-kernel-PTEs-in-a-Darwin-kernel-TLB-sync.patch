+static noinline int update_init_mm_pte_slot(pmd_t *pmd,
+					     unsigned long addr,
+					     struct vm_ops *ops)
+{
+	pte_t snapshots[4];
+	pte_t *pte;
+	spinlock_t *ptl;
+	unsigned int index;
+	int ret;
+
+	if (WARN_ON_ONCE(ops->mm != &init_mm ||
+			 (addr & (DARWIN_HOST_PAGE_SIZE - 1))))
+		return -EINVAL;
+
+	/* A 16 KiB-aligned group of four PTEs cannot cross either a PTE page or a
+	 * PMD boundary. Read every PTE before any host operation, then release the
+	 * page-table lock before the potentially sleeping host calls. Generic
+	 * vmalloc writers can update these PTEs without this lock, so the four
+	 * values are not claimed to be one atomic snapshot. Such a writer publishes
+	 * its pending range after updating the PTEs, so the serialized later walk
+	 * reapplies the completed state instead of losing the newer change. The
+	 * exact fault repair separately republishes a page when host access faults.
+	 */
+	pte = pte_offset_kernel(pmd, addr);
+	ptl = darwin_pte_lockptr(&init_mm, pmd);
+	spin_lock(ptl);
+	for (index = 0; index < ARRAY_SIZE(snapshots); ++index)
+		snapshots[index] = ptep_get(pte + index);
+	spin_unlock(ptl);
+
+	/* The host already has a slot none of whose quarters changed. */
+	for (index = 0; index < ARRAY_SIZE(snapshots); ++index)
+		if (pte_needsync(snapshots[index]))
+			break;
+	if (index == ARRAY_SIZE(snapshots))
+		return 0;
+	ret = darwin_apply_init_mm_slot(ops, addr, snapshots);
+	if (!ret)
+		for (index = 0; index < ARRAY_SIZE(snapshots); ++index)
+			darwin_init_mm_pte_applied(pte + index,
+						   snapshots[index]);
+	return ret;
+}
