From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 25 Oct 2026 21:52:16 +0900
Subject: [PATCH] arm64: um: build the kernel with the stack protector

Select HAVE_STACKPROTECTOR for the arm64 port, with the global canary arm64
Linux used before it had a per-task one: boot_init_stack_canary() draws it
once in start_kernel() and __stack_chk_guard, defined in the kernel image
and read-only after init, holds it for every task and CPU. A corrupted frame
ends in __stack_chk_fail()'s panic, which names the function.

Host objects keep -fno-stack-protector: they are the host's code, on the
host's stacks and signal stacks, and their canary reads would add no
protection to anything the kernel owns.

Unlike arm64, UML's start_kernel() is not the end of the boot thread: a
halt or reboot longjmps back to start_idle_thread() and returns through
start_uml() and linux_main() to main(). Both saved the canary before
start_kernel() drew a new one, so they are built without the protector;
otherwise every poweroff ends in a stack-protector panic.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/arm64/um/Kconfig              |  1 +
 arch/arm64/um/asm/stackprotector.h | 31 ++++++++++++++++++++++++++++++
 arch/arm64/um/subarch.c            |  8 ++++++++
 arch/um/Makefile                   |  5 +++++
 arch/um/kernel/skas/process.c      |  2 +-
 arch/um/kernel/um_arch.c           |  7 ++++++-
 6 files changed, 52 insertions(+), 2 deletions(-)
 create mode 100644 arch/arm64/um/asm/stackprotector.h

diff --git a/arch/arm64/um/Kconfig b/arch/arm64/um/Kconfig
index a320c267a45380c0b415b75834266b84de849b93..b0bdc892ebff790cc6bdd8002886b56566f08794 100644
--- a/arch/arm64/um/Kconfig
+++ b/arch/arm64/um/Kconfig
@@ -17,6 +17,7 @@ config UML_ARM64
 	select HAVE_CMPXCHG_DOUBLE
 	select HAVE_EFFICIENT_UNALIGNED_ACCESS
 	select HAVE_PERF_EVENTS
+	select HAVE_STACKPROTECTOR
 	select MODULES_USE_ELF_RELA
 	select ARCH_USE_QUEUED_RWLOCKS
 	select UML_SUBARCH_SUPPORTS_SMP
diff --git a/arch/arm64/um/asm/stackprotector.h b/arch/arm64/um/asm/stackprotector.h
new file mode 100644
index 0000000000000000000000000000000000000000..dd2f936c0a44b3522e05d348cb716c265755318b
--- /dev/null
+++ b/arch/arm64/um/asm/stackprotector.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Stack protector support, with the global canary arm64 Linux used before it
+ * had a per-task one.  The compiler reads the canary from __stack_chk_guard,
+ * so every task and CPU shares one value.  `current` here is a table lookup
+ * by the carrier's CPU number, not a register the compiler could address a
+ * per-task canary through.
+ */
+
+#ifndef __UM_ARM64_STACKPROTECTOR_H
+#define __UM_ARM64_STACKPROTECTOR_H
+
+#include <linux/random.h>
+#include <asm/current.h>
+
+extern unsigned long __stack_chk_guard;
+
+/*
+ * Initialize the stack protector canary.
+ * NOTE: this must only be called from functions that never return, and it
+ * must always be inlined.
+ */
+static __always_inline void boot_init_stack_canary(void)
+{
+	unsigned long canary = get_random_canary();
+
+	current->stack_canary = canary;
+	__stack_chk_guard = canary;
+}
+
+#endif /* __UM_ARM64_STACKPROTECTOR_H */
diff --git a/arch/arm64/um/subarch.c b/arch/arm64/um/subarch.c
index 8982857ba78d6136877d7db0e7897513783342e7..a8981e8639f6dbc397dca49e0b70cd5fe332479c 100644
--- a/arch/arm64/um/subarch.c
+++ b/arch/arm64/um/subarch.c
@@ -1,9 +1,17 @@
 // SPDX-License-Identifier: GPL-2.0
 
+#include <linux/cache.h>
 #include <linux/device.h>
 #include <linux/dma-map-ops.h>
+#include <linux/export.h>
 #include <linux/types.h>
 
+/* The stack protector's canary: set once by boot_init_stack_canary(). */
+#ifdef CONFIG_STACKPROTECTOR
+unsigned long __stack_chk_guard __ro_after_init;
+EXPORT_SYMBOL(__stack_chk_guard);
+#endif
+
 char *kernel_strrchr(const char *string, int character)
 {
 	const char *last = NULL;
diff --git a/arch/um/Makefile b/arch/um/Makefile
index 2aecce6eb3a8893eb84cabf125e48e4ce5c586a5..396a5202e9d59a736ff34a0c3e52c0d218b3a897 100644
--- a/arch/um/Makefile
+++ b/arch/um/Makefile
@@ -78,6 +78,11 @@ USER_CFLAGS = $(patsubst $(KERNEL_DEFINES),,$(patsubst -I%,,$(KBUILD_CFLAGS))) \
 		-include $(srctree)/include/linux/compiler-version.h \
 		-include $(srctree)/include/linux/kconfig.h
 
+# Host objects stay without the stack protector: they are the host's own code
+# on its stacks and signal stacks.  This flag follows the copy of KBUILD_CFLAGS
+# above, so it overrides -fstack-protector-strong.
+USER_CFLAGS += -fno-stack-protector
+
 # Host objects are compiled against the host C library, whose types reuse the
 # kernel's names with host definitions (size_t, pid_t, sigset_t, struct
 # sigaction, ...). pahole would encode that DWARF into the kernel's BTF, so
diff --git a/arch/um/kernel/skas/process.c b/arch/um/kernel/skas/process.c
index 8cb774915731e131352e9f9e3249ac8422faa293..e7a6d0e0fb9c2a6d3632579052ac6e69a98b9475 100644
--- a/arch/um/kernel/skas/process.c
+++ b/arch/um/kernel/skas/process.c
@@ -31,7 +31,7 @@ static int __init start_kernel_proc(void *unused)
 
 char cpu_irqstacks[NR_CPUS][THREAD_SIZE] __aligned(THREAD_SIZE);
 
-int __init start_uml(void)
+int __init __no_stack_protector start_uml(void)
 {
 	stack_protections((unsigned long) &cpu_irqstacks[0]);
 #ifndef UML_HOST_DARWIN
diff --git a/arch/um/kernel/um_arch.c b/arch/um/kernel/um_arch.c
index e426227f327d49d16d618709f21d6943dc58f54e..a350b79721d49850c56f2e1f4868323504cf54c7 100644
--- a/arch/um/kernel/um_arch.c
+++ b/arch/um/kernel/um_arch.c
@@ -510,7 +510,12 @@ static unsigned long __init get_top_address(char **envp)
 #endif
 }
 
-int __init linux_main(int argc, char **argv, char **envp)
+/*
+ * A halt returns through linux_main() and start_uml() to the host's main(),
+ * after start_kernel() has drawn the canary these two frames saved before it,
+ * so neither may check it.
+ */
+int __init __no_stack_protector linux_main(int argc, char **argv, char **envp)
 {
 	unsigned long avail, diff;
 	unsigned long virtmem_size, max_physmem;
