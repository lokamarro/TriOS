 #ifdef UML_HOST_DARWIN
+/*
+ * How many PTEs one host batch of a user mm carries.  The host rejects a batch
+ * when any invalidation of the generation arrives before it ends, and after a
+ * fork or an exec the pending range is the whole address space.  Walked in one
+ * batch, that loses to the first sibling which unmaps, remaps or breaks a
+ * copy-on-write anywhere, and a walk which starts over each time never ends
+ * while they keep at it: binder traffic held a system_server thread here for
+ * 84 seconds, its CPU's timer and the RCU grace-period thread behind it.  A
+ * batch of this size takes tens of microseconds, and a rejected one is walked
+ * again alone.  The walker checkpoints after every batch it fills and after
+ * every sixteenth it loses; a fault's batch is a page or four, and its retry
+ * costs less than the checkpoint would.
+ */
+#define UML_TLB_SYNC_BATCH_PAGES 64U
+#define UML_TLB_SYNC_BATCH_FULL 1
+#define UML_TLB_SYNC_REJECTS_PER_CHECKPOINT 16U
+
