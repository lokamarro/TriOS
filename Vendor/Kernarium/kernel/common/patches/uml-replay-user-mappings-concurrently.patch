+void current_mm_force_sync(unsigned long address)
+{
+	unsigned long start = address & PAGE_MASK;
+	unsigned long end = start + PAGE_SIZE;
+
+	if (current->mm == NULL)
+		return;
+#ifdef UML_HOST_DARWIN
+	/* The caller found mappings which Linux already grants missing from the
+	 * shadow MMU, as they all are after a fork or an mprotect().  Replay
+	 * the neighbours in the same 16 KiB with the addressed page: a 4 KiB
+	 * guest otherwise takes a host fault for each of them in turn.
+	 */
+	start = address & ~(16UL * 1024 - 1);
+	end = start + 16UL * 1024;
+#endif
+	current_mm_sync_range(start, end);
+}
