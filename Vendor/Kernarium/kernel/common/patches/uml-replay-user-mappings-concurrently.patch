 	return ret;
 }
 
+#ifdef UML_HOST_DARWIN
+static void darwin_tlb_sync_checkpoint(void)
+{
+	/* No page-table lock, host batch or walker binding is live here, and the
+	 * mmap_read_lock() the walk runs under may be slept on.  A long or a
+	 * contested replay must not keep this CPU's clock event, its pending IPI
+	 * vectors and its RCU quiescent state waiting for the last batch, and
+	 * cond_resched() services all three (see flush_tlb_mm()).
+	 */
+	if (um_get_signals())
+		cond_resched();
+}
+
+/* Replay the snapshot of a user mm in bounded host batches.  A batch spans
+ * ranges, because every batch_end() takes the generation's mappings lock
+ * exclusively and a fault's snapshot is a handful of single pages.
+ */
+static int darwin_replay_user_ranges(struct mm_struct *mm, struct vm_ops *ops,
+				     const struct uml_tlb_sync_range *ranges,
+				     unsigned int count)
+{
+	unsigned long generation = mm->context.id.darwin_generation;
+	unsigned long addr = count ? ranges[0].from : 0;
+	unsigned int index = 0;
+	unsigned int rejected = 0;
+	int ret = 0;
+
+	while (index < count && !ret) {
+		unsigned long batch_addr = addr;
+		unsigned int batch_index = index;
+		bool full = false;
+
+		/* Bind this carrier to the generation for the batch.  A host which
+		 * still treats the binding as exclusive serializes the walkers
+		 * again, which is slower and no less correct; nothing between here
+		 * and the unlock can schedule.
+		 */
+		if (darwin_uml_vm_walker_lock(generation) < 0)
+			panic("Darwin: unable to bind address-space walker %lu",
+			      generation);
+		ret = darwin_uml_vm_batch_begin(generation);
+		if (!ret) {
+			int batch_ret;
+
+			ops->budget = UML_TLB_SYNC_BATCH_PAGES;
+			while (!ret) {
+				ret = update_mm_range(mm, ops, batch_addr,
+						      ranges[batch_index].to);
+				if (ret || ++batch_index == count)
+					break;
+				batch_addr = ranges[batch_index].from;
+			}
+			/* Commit the collected mappings while no PTE lock is held.
+			 * A concurrent synchronous invalidation changes the host
+			 * epoch; batch_end() then asks for this batch again.
+			 */
+			batch_ret = darwin_uml_vm_batch_end();
+			full = ret == UML_TLB_SYNC_BATCH_FULL;
+			if (full)
+				ret = 0;
+			if (!ret)
+				ret = batch_ret;
+		}
+		if (darwin_uml_vm_walker_unlock(generation) < 0)
+			panic("Darwin: unable to release address-space walker %lu",
+			      generation);
+		if (ret == -EAGAIN) {
+			/* Walk the same batch again.  A fault's batch is a page or
+			 * four and costs less than the checkpoint would.
+			 */
+			ret = 0;
+			if (++rejected % UML_TLB_SYNC_REJECTS_PER_CHECKPOINT == 0)
+				darwin_tlb_sync_checkpoint();
+			continue;
+		}
+		if (ret || !full)
+			break;
+		index = batch_index;
+		addr = ops->resume;
+		if (addr >= ranges[index].to && ++index < count)
+			addr = ranges[index].from;
+		darwin_tlb_sync_checkpoint();
+	}
+	return ret;
+}
