diff --git a/arch/arm64/um/sys_compat.c b/arch/arm64/um/sys_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..86f69c07139896a632c691e0620e4d4e7d68d32d
--- /dev/null
+++ b/arch/arm64/um/sys_compat.c
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The ARM-private system calls of an AArch32 task, from
+ * arch/arm64/kernel/sys_compat.c.
+ *
+ * Based on arch/arm/kernel/sys_arm.c
+ *
+ * Copyright (C) People who wrote linux/arch/i386/kernel/sys_i386.c
+ * Copyright (C) 1995, 1996 Russell King.
+ * Copyright (C) 2012 ARM Ltd.
+ */
+
+#include <linux/compat.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+
+#include <asm/cacheflush.h>
+#include <asm/unistd.h>
+
+/*
+ * Guest code is translated and cached by address, so a program which wrote
+ * instructions and asks for them to be flushed must have the host forget the
+ * range, as an A64 IC IVAU does.  The call splits the range into pages, as
+ * native does, so that a large flush stays interruptible.
+ */
+static long do_compat_cache_op(unsigned long start, unsigned long end,
+			       int flags)
+{
+	if (end < start || flags)
+		return -EINVAL;
+
+	if (!access_ok((const void __user *)start, end - start))
+		return -EFAULT;
+
+	while (start < end) {
+		unsigned long chunk = min(PAGE_SIZE, end - start);
+
+		if (fatal_signal_pending(current))
+			return 0;
+
+		flush_icache_remote_user_range(current->mm, start, chunk);
+		cond_resched();
+		start += chunk;
+	}
+	return 0;
+}
+
+/*
+ * Handle all unrecognised system calls.  The number is past the end of the
+ * table.  As in native compat_arm_syscall(), the arguments are r0-r2 (x0-x2)
+ * as they stand, which are what the task passed unless a tracer rewrote them.
+ */
+long compat_arm_syscall(struct uml_pt_regs *regs, int scno)
+{
+	switch (scno) {
+	/*
+	 * Flush a region from virtual address 'r0' to virtual address 'r1'
+	 * _exclusive_.  There is no alignment requirement on either address;
+	 * user space does not need to know the hardware cache layout.
+	 *
+	 * r2 contains flags.  It should ALWAYS be passed as ZERO until it
+	 * is defined to be something else.
+	 */
+	case __ARM_NR_compat_cacheflush:
+		return do_compat_cache_op(UPT_SYSCALL_ARG1(regs), UPT_X(regs, 1),
+					  UPT_X(regs, 2));
+
+	/* TPIDRURO, which the host reads for the next instruction's MRC. */
+	case __ARM_NR_compat_set_tls:
+		regs->tpidrro = (u32)UPT_SYSCALL_ARG1(regs);
+		return 0;
+
+	default:
+		/*
+		 * Calls 0xf0xxx..0xf07ff are defined to return -ENOSYS
+		 * if not implemented, rather than raising SIGILL. This
+		 * way the calling program can gracefully determine whether
+		 * a feature is supported.
+		 */
+		if (scno < __ARM_NR_COMPAT_END)
+			return -ENOSYS;
+		break;
+	}
+
+	/* The SVC itself, which the program must not have been able to take. */
+	force_sig_fault(SIGILL, ILL_ILLTRP,
+			(void __user *)(UPT_IP(regs) -
+					((UPT_PSTATE(regs) &
+					  UML_ARM64_PSTATE_T) ? 2 : 4)));
+	return 0;
+}
