+		unsigned long, unsigned long, unsigned long, unsigned long);
+#include <asm/syscall_table_32.h>
+#undef __SYSCALL
+
+#define __SYSCALL(number, symbol) [number] = symbol,
+const sys_call_ptr_t compat_sys_call_table[__NR_compat32_syscalls]
+	____cacheline_aligned = {
+	[0 ... __NR_compat32_syscalls - 1] = sys_ni_syscall,
+#include <asm/syscall_table_32.h>
+};
