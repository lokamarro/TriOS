index 8b8b7d797c4dfc841eaa5c8f1b3ddc888fda9e1f..e195e71dc38a3774ed660e4f7b722f6fe50705da 100644
--- a/arch/arm64/um/Kconfig
+++ b/arch/arm64/um/Kconfig
@@ -26,6 +26,31 @@ config UML_ARM64
 config UML_ARM64_SME
 	def_bool y
 
+# Every arm64 task may run AArch32 code (armhf and Android's armeabi-v7a) as
+# arm64 Linux's COMPAT does, once the host's engine implements it.  Until
+# then the compat HWCAPs read zero, a 32-bit executable gets ENOEXEC and
+# personality(PER_LINUX32) fails.
