diff --git a/arch/arm64/um/aarch32.c b/arch/arm64/um/aarch32.c
new file mode 100644
index 0000000000000000000000000000000000000000..7d031807413f4892ede452e9d31a34c4408adccd
--- /dev/null
+++ b/arch/arm64/um/aarch32.c
@@ -0,0 +1,275 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * AArch32 tasks (armhf and Android's armeabi-v7a) on the Darwin guest
+ * engines, as arm64 Linux's COMPAT supports them.
+ *
+ * A task is AArch32 when its ELF file is: COMPAT_SET_PERSONALITY() sets
+ * TIF_32BIT and compat_start_thread() starts it with PSTATE.nRW set, and the
+ * host runs it in AArch32 state until the next execve().  The register,
+ * event and ABI contracts are in asm/aarch32.h and in the Darwin bridge
+ * header (kernel/common/abi/darwin_uml_abi.h).
+ *
+ * The host's engines report which AArch32 features they implement as the
+ * compat HWCAPs.  While those are zero there is no AArch32 anywhere: a
+ * 32-bit ELF file fails with ENOEXEC and personality(PER_LINUX32) with
+ * EINVAL, exactly as on an arm64 CPU without 32-bit EL0.
+ */
+
+#include <linux/binfmts.h>
+#include <linux/elf.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/personality.h>
+#include <linux/sched.h>
+#include <linux/sizes.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <asm/aarch32.h>
+#include <asm/elf.h>
+#include <asm/unistd_compat_32.h>
+#include <darwin-address-space.h>
+
+extern unsigned long darwin_uml_guest_compat_hwcap(void);
+extern unsigned long darwin_uml_guest_compat_hwcap2(void);
+
+unsigned long uml_arm64_compat_hwcap;
+unsigned long uml_arm64_compat_hwcap2;
+
+bool uml_arm64_aarch32_supported(void)
+{
+	return uml_arm64_compat_hwcap != 0;
+}
+
+static int __init uml_arm64_aarch32_init(void)
+{
+	unsigned long hwcap = darwin_uml_guest_compat_hwcap();
+	unsigned long hwcap2 = darwin_uml_guest_compat_hwcap2();
+
+	/*
+	 * Guest addresses below 4 GiB are the 32-bit tasks'.  Every Apple
+	 * arm64 process reserves them (__PAGEZERO), and the native window
+	 * lies above, so the guest range can never overlap it; refuse to
+	 * advertise AArch32 if a host ever breaks that.
+	 */
+	if (hwcap && uml_darwin_native_address_start() < SZ_4G) {
+		pr_warn("AArch32 disabled: the native window starts at %#lx, below 4 GiB\n",
+			uml_darwin_native_address_start());
+		hwcap = hwcap2 = 0;
+	}
+	/* AArch32 and AArch64 tasks share one register image, which the
+	 * kernel keeps in AArch64 form; its restart number is 0. */
+	BUILD_BUG_ON(__NR_compat32_restart_syscall != 0);
+
+	uml_arm64_compat_hwcap = hwcap;
+	uml_arm64_compat_hwcap2 = hwcap2;
+	if (hwcap)
+		pr_info("AArch32 userspace enabled (hwcap %#lx hwcap2 %#lx)\n",
+			hwcap, hwcap2);
+	return 0;
+}
+core_initcall(uml_arm64_aarch32_init);
+
+/* Whether the program is an ARM EABI executable the run can execute. */
+int compat_elf_check_arch(const struct elf32_hdr *hdr)
+{
+	if (!uml_arm64_aarch32_supported())
+		return false;
+
+	if (hdr->e_machine != EM_ARM)
+		return false;
+
+	/* OABI, whose system calls are not the EABI's, is refused. */
+	if (!(hdr->e_flags & EF_ARM_EABI_MASK))
+		return false;
+
+	return true;
+}
+
+/*
+ * The first instruction is at pc with bit 0 clear; bit 0 set selects Thumb.
+ * flush_thread() has already zeroed every register, so R0-R12, R14 and the
+ * A64-only registers start at zero.
+ */
+void compat_start_thread(struct pt_regs *regs, unsigned long pc,
+			 unsigned long sp)
+{
+	unsigned long pstate = PSR_AA32_MODE_USR | PSR_AA32_ENDSTATE;
+
+	if (pc & 1)
+		pstate |= PSR_AA32_T_BIT;
+
+	PT_REGS_IP(regs) = pc & ~1UL;
+	PT_REGS_PSTATE(regs) = pstate;
+	PT_REGS_X(regs, 13) = sp;
+	clear_thread_flag(TIF_SINGLESTEP);
+}
+
+/*
+ * An AArch32 program's pages that the kernel provides: the kuser helpers at
+ * the top of the address space and the signal-return trampolines.  They are
+ * ordinary guest code, which the engines translate like any other.
+ */
+extern char __kuser_helper_start[], __kuser_helper_end[];
+extern char __aarch32_sigret_code_start[], __aarch32_sigret_code_end[];
+
+enum aarch32_map {
+	AA32_MAP_VECTORS,	/* kuser helpers */
+	AA32_MAP_SIGPAGE,
+};
+
+static struct page *aarch32_vectors_page __ro_after_init;
+static struct page *aarch32_sig_page __ro_after_init;
+
+static int aarch32_sigpage_mremap(const struct vm_special_mapping *sm,
+				  struct vm_area_struct *new_vma)
+{
+	current->mm->context.compat_sigpage = new_vma->vm_start;
+	return 0;
+}
+
+static struct vm_special_mapping aarch32_maps[] = {
+	[AA32_MAP_VECTORS] = {
+		.name	= "[vectors]", /* ABI */
+		.pages	= &aarch32_vectors_page,
+	},
+	[AA32_MAP_SIGPAGE] = {
+		.name	= "[sigpage]", /* ABI */
+		.pages	= &aarch32_sig_page,
+		.mremap	= aarch32_sigpage_mremap,
+	},
+};
+
+static int aarch32_alloc_kuser_page(void)
+{
+	int kuser_sz = __kuser_helper_end - __kuser_helper_start;
+	unsigned long page;
+
+	if (!IS_ENABLED(CONFIG_KUSER_HELPERS))
+		return 0;
+
+	page = get_zeroed_page(GFP_KERNEL);
+	if (!page)
+		return -ENOMEM;
+
+	/* The helpers end at the first 4 KiB, whatever the page size. */
+	memcpy((void *)(page + 0x1000 - kuser_sz), __kuser_helper_start,
+	       kuser_sz);
+	aarch32_vectors_page = virt_to_page((void *)page);
+	return 0;
+}
+
+#define COMPAT_SIGPAGE_POISON_WORD	0xe7fddef1
+static int aarch32_alloc_sigpage(void)
+{
+	int sigret_sz = __aarch32_sigret_code_end - __aarch32_sigret_code_start;
+	__le32 poison = cpu_to_le32(COMPAT_SIGPAGE_POISON_WORD);
+	void *sigpage;
+
+	sigpage = (void *)__get_free_page(GFP_KERNEL);
+	if (!sigpage)
+		return -ENOMEM;
+
+	memset32(sigpage, (__force u32)poison, PAGE_SIZE / sizeof(poison));
+	memcpy(sigpage, __aarch32_sigret_code_start, sigret_sz);
+	aarch32_sig_page = virt_to_page(sigpage);
+	return 0;
+}
+
+static int __init aarch32_alloc_pages(void)
+{
+	int ret = aarch32_alloc_sigpage();
+
+	return ret ?: aarch32_alloc_kuser_page();
+}
+arch_initcall(aarch32_alloc_pages);
+
+static int aarch32_kuser_helpers_setup(struct mm_struct *mm)
+{
+	void *ret;
+
+	if (!IS_ENABLED(CONFIG_KUSER_HELPERS))
+		return 0;
+
+	/*
+	 * Avoid VM_MAYWRITE for compatibility with arch/arm, where it's
+	 * not safe to CoW the page containing the CPU exception vectors.
+	 */
+	ret = _install_special_mapping(mm, AARCH32_VECTORS_BASE, PAGE_SIZE,
+				       VM_READ | VM_EXEC |
+				       VM_MAYREAD | VM_MAYEXEC |
+				       VM_SEALED_SYSMAP,
+				       &aarch32_maps[AA32_MAP_VECTORS]);
+
+	return PTR_ERR_OR_ZERO(ret);
+}
+
+static int aarch32_sigreturn_setup(struct mm_struct *mm)
+{
+	unsigned long addr;
+	void *ret;
+
+	addr = get_unmapped_area(NULL, 0, PAGE_SIZE, 0, 0);
+	if (IS_ERR_VALUE(addr))
+		return addr;
+
+	/*
+	 * VM_MAYWRITE is required to allow gdb to Copy-on-Write and
+	 * set breakpoints.
+	 */
+	ret = _install_special_mapping(mm, addr, PAGE_SIZE,
+				       VM_READ | VM_EXEC | VM_MAYREAD |
+				       VM_MAYWRITE | VM_MAYEXEC |
+				       VM_SEALED_SYSMAP,
+				       &aarch32_maps[AA32_MAP_SIGPAGE]);
+	if (IS_ERR(ret))
+		return PTR_ERR(ret);
+
+	mm->context.compat_sigpage = addr;
+	return 0;
+}
+
+int aarch32_setup_additional_pages(struct linux_binprm *bprm, int uses_interp)
+{
+	struct mm_struct *mm = current->mm;
+	int ret;
+
+	if (mmap_write_lock_killable(mm))
+		return -EINTR;
+
+	ret = aarch32_kuser_helpers_setup(mm);
+	if (!ret)
+		ret = aarch32_sigreturn_setup(mm);
+	mmap_write_unlock(mm);
+	return ret;
+}
+
+/*
+ * A program which stops at a breakpoint instruction a debugger planted raises
+ * the undefined-instruction event; arm64 Linux turns these three encodings
+ * into SIGTRAP, as the arm kernel did (try_handle_aarch32_break()).
+ */
+int uml_arm64_aarch32_break(struct uml_pt_regs *regs)
+{
+	unsigned long pc = UPT_IP(regs);
+
+	if (UPT_PSTATE(regs) & PSR_AA32_T_BIT) {
+		u16 first, second;
+
+		if (get_user(first, (u16 __user *)pc))
+			return false;
+		if (first != UML_AARCH32_BREAK_THUMB2_LO)
+			return first == UML_AARCH32_BREAK_THUMB;
+		/* The second half of a 32-bit Thumb-2 instruction. */
+		return !get_user(second, (u16 __user *)(pc + 2)) &&
+		       second == UML_AARCH32_BREAK_THUMB2_HI;
+	}
+
+	{
+		u32 instr;
+
+		if (get_user(instr, (u32 __user *)pc))
+			return false;
+		/* Any condition code. */
+		return (instr & ~0xf0000000) == UML_AARCH32_BREAK_ARM;
+	}
+}
