new file mode 100644
index 0000000000000000000000000000000000000000..7edfd1aacdba48acfaaa4d2d1056ce9ec26c0553
--- /dev/null
+++ b/arch/arm64/um/aarch32_pages.S
@@ -0,0 +1,8 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * The code of the AArch32 pages the kernel maps into every 32-bit task: the
+ * kuser helpers and the signal-return trampolines.  arm64 Linux assembles
+ * them as data with arm64's assembler, since only the A64 kernel is built.
+ */
+#include "../kernel/kuser32.S"
+#include "../kernel/sigreturn32.S"
diff --git a/arch/arm64/um/armv8_deprecated.c b/arch/arm64/um/armv8_deprecated.c
new file mode 100644
index 0000000000000000000000000000000000000000..98fc0f942f67f2c36c6e69a0a3ea6054f6a86688
--- /dev/null
+++ b/arch/arm64/um/armv8_deprecated.c
@@ -0,0 +1,209 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The deprecated AArch32 instructions of arm64 Linux's armv8_deprecated.c
+ * that this port has: the CP15 barrier operations and SWP and SWPB.
+ *
+ * CP15 barriers (mcr p15, 0, Rt, c7, c10, 4 and 5, and c7, c5, 4): arm64
+ * Linux emulates them by default (abi.cp15_barrier is 1), or lets the
+ * hardware execute them (2) when SCTLR_EL1.CP15BEN is set, or makes them
+ * UNDEFINED (0).  The engines execute a barrier, so 1 and 2 behave alike;
+ * the kernel passes whether the value is non-zero as
+ * DARWIN_UML_DISPATCH_A32_CP15BEN, and a task which runs one with the
+ * switch off gets SIGILL.
+ *
+ * SWP and SWPB: the engines raise the undefined-instruction event for the
+ * word whatever its condition.  abi.swp is 0 (SIGILL) by default, as
+ * natively, and 1 makes the kernel emulate them on that event with arm64
+ * Linux's semantics.  The exchange is one atomic operation on the page the
+ * task sees, so it is atomic against load-exclusive/store-exclusive pairs
+ * and atomic instructions on other vCPUs.  An access that fails raises
+ * SIGSEGV with the pc left at the instruction, an unaligned SWP included,
+ * and a failing condition retires the instruction without touching anything.
+ * A word that names the pc as Rt, Rt2 or Rn is UNPREDICTABLE, which this
+ * port makes UNDEFINED: arm64 Linux uses an unrelated host register there.
+ *
+ * SETEND is UNDEFINED, which native arm64 Linux makes it on a CPU without
+ * mixed-endian EL0: there is none.  It has no switch.
+ */
+
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/perf_event.h>
+#include <linux/ratelimit.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/sysctl.h>
+#include <linux/uaccess.h>
+#include <asm/aarch32.h>
+#include <asm/ptrace.h>
+
+#define CREATE_TRACE_POINTS
+#include "trace-events-emulation.h"
+
+static int cp15_barrier = 1;
+static int cp15_barrier_max = 2;
+/* abi.swp: 0 leaves SWP and SWPB UNDEFINED, 1 emulates them. */
+static int swp;
+
+int uml_arm64_cp15_barrier_enabled(void)
+{
+	return READ_ONCE(cp15_barrier) != 0;
+}
+
+static const struct ctl_table abi_table[] = {
+	{
+		.procname	= "cp15_barrier",
+		.data		= &cp15_barrier,
+		.maxlen		= sizeof(int),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= &cp15_barrier_max,
+	},
+	{
+		.procname	= "swp",
+		.data		= &swp,
+		.maxlen		= sizeof(int),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= SYSCTL_ONE,
+	},
+};
+
+static int __init uml_arm64_deprecated_init(void)
+{
+	register_sysctl_init("abi", abi_table);
+	return 0;
+}
+core_initcall(uml_arm64_deprecated_init);
+
+/*
+ * Whether the flags of an AArch32 pstate satisfy a condition field other
+ * than 0xf: arm64 Linux's aarch32_opcode_cond_checks, which lives in
+ * arch/arm64/kernel/traps.c, a file this port does not build.
+ */
+static bool aarch32_condition_passed(u32 cond, unsigned long pstate)
+{
+	bool n = pstate & PSR_AA32_N_BIT;
+	bool z = pstate & PSR_AA32_Z_BIT;
+	bool c = pstate & PSR_AA32_C_BIT;
+	bool v = pstate & PSR_AA32_V_BIT;
+	bool passed;
+
+	switch (cond >> 1) {
+	case 0:				/* EQ, NE */
+		passed = z;
+		break;
+	case 1:				/* CS, CC */
+		passed = c;
+		break;
+	case 2:				/* MI, PL */
+		passed = n;
+		break;
+	case 3:				/* VS, VC */
+		passed = v;
+		break;
+	case 4:				/* HI, LS */
+		passed = c && !z;
+		break;
+	case 5:				/* GE, LT */
+		passed = n == v;
+		break;
+	case 6:				/* GT, LE */
+		passed = !z && n == v;
+		break;
+	default:			/* AL */
+		return true;
+	}
+	return (cond & 1) ? !passed : passed;
+}
+
+/* SWP{<c>} Rt, Rt2, [Rn] and SWPB{<c>} Rt, Rt2, [Rn]; bits 11:8 are zero. */
+#define A32_SWP_MASK		0x0fb00ff0
+#define A32_SWP_VALUE		0x01000090
+/* Bit 22 selects SWPB. */
+#define A32_SWPB		(1U << 22)
+
+/*
+ * SIGSEGV for the access arm64_notify_segfault() refuses, with its code:
+ * SEGV_ACCERR when any mapping lies at or above the address (find_vma() does
+ * not mean "contains"), SEGV_MAPERR when none does.  The frame's fault
+ * address and error code stay zero, as arm64_notify_die() leaves them, and
+ * the pc stays at the instruction.
+ */
+static int swp_segfault(struct uml_pt_regs *regs, unsigned long address)
+{
+	struct mm_struct *mm = current->mm;
+	int code;
+
+	mmap_read_lock(mm);
+	code = find_vma(mm, address) ? SEGV_ACCERR : SEGV_MAPERR;
+	mmap_read_unlock(mm);
+
+	memset(&regs->faultinfo, 0, sizeof(regs->faultinfo));
+	current->thread.arch.faultinfo = regs->faultinfo;
+	force_sig_fault(SIGSEGV, code, (void __user *)address);
+	return UML_ARM64_A32_SIGNALLED;
+}
+
+/*
+ * Exchange Rt2 with the word or byte at [Rn] in one atomic operation and
+ * leave the old contents in Rt, as arm64 Linux's swp_handler() does.  One
+ * atomic exchange cannot fail, so there is no retry loop and no way to retire
+ * an exchange that did not happen.  Rt, Rt2 or Rn as the pc is UNPREDICTABLE
+ * and made UNDEFINED, whatever the condition.  Rn equal to Rt or Rt2 is
+ * UNPREDICTABLE too and runs as arm64 Linux runs it: the address and the data
+ * are read before Rt is written.
+ */
+static int swp_emulate(struct uml_pt_regs *regs, u32 insn)
+{
+	u32 cond = insn >> 28;
+	unsigned int rn = (insn >> 16) & 0xf;
+	unsigned int rt = (insn >> 12) & 0xf;
+	unsigned int rt2 = insn & 0xf;
+	bool byte = insn & A32_SWPB;
+	u32 address, data;
+
+	if (cond == 0xf || rn == 15 || rt == 15 || rt2 == 15)
+		return UML_ARM64_A32_UNDEFINED;
+
+	perf_sw_event(PERF_COUNT_SW_EMULATION_FAULTS, 1,
+		      container_of(regs, struct pt_regs, regs), UPT_IP(regs));
+
+	if (aarch32_condition_passed(cond, UPT_PSTATE(regs))) {
+		address = (u32)UPT_X(regs, rn);
+		data = (u32)UPT_X(regs, rt2);
+
+		/* An unaligned SWP is not permitted; SWPB has no alignment. */
+		if ((!byte && (address & 3)) ||
+		    uml_xchg_user((void __user *)(unsigned long)address,
+				  byte ? 1 : 4, &data))
+			return swp_segfault(regs, address);
+		UPT_X(regs, rt) = data;
+	}
+
+	trace_instruction_emulation(byte ? "swpb" : "swp", UPT_IP(regs));
+	pr_warn_ratelimited("\"%s\" (%ld) uses obsolete SWP{B} instruction at 0x%llx\n",
+			    current->comm, (unsigned long)current->pid,
+			    (unsigned long long)UPT_IP(regs));
+	UPT_IP(regs) += 4;
+	return UML_ARM64_A32_RETIRED;
+}
+
+int uml_arm64_aarch32_emulate(struct uml_pt_regs *regs)
+{
+	u32 insn;
+
+	/* A write of the switch can race with an event; read it once. */
+	if (!READ_ONCE(swp))
+		return UML_ARM64_A32_UNDEFINED;
+	/* SWP and SWPB exist in ARM state only. */
+	if (UPT_PSTATE(regs) & PSR_AA32_T_BIT)
+		return UML_ARM64_A32_UNDEFINED;
+	if (get_user(insn, (u32 __user *)UPT_IP(regs)))
+		return UML_ARM64_A32_UNDEFINED;
+	if ((insn & A32_SWP_MASK) != A32_SWP_VALUE)
+		return UML_ARM64_A32_UNDEFINED;
+	return swp_emulate(regs, insn);
+}
diff --git a/arch/arm64/um/asm/aarch32.h b/arch/arm64/um/asm/aarch32.h
new file mode 100644
index 0000000000000000000000000000000000000000..8dc3743a68da6fddbf17093b58a001cb34fec23b
--- /dev/null
+++ b/arch/arm64/um/asm/aarch32.h
@@ -0,0 +1,122 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_UM_ARM64_AARCH32_H
+#define _ASM_UM_ARM64_AARCH32_H
+
+/*
+ * The state of an AArch32 task, as the Darwin bridge hands it to the kernel.
+ *
+ * pstate holds SPSR_EL1's layout for an exception taken from AArch32 state:
+ * PSTATE.nRW (PSR_MODE32_BIT) set and M[3:0] zero for user mode, T in bit 5,
+ * E in bit 9, GE in 19:16, DIT in 24, IT in 26:25 and 15:10, Q in 27 and
+ * NZCV in 31:28.  R0-R14 are x0-x14 with the upper halves zero: the stack
+ * pointer is x13 and the link register x14.  x15-x28, fp, lr and sp of the
+ * frame are not part of the task.  D0-D31 are V0-V15, and FPSCR is the
+ * fpsr/fpcr pair.  TPIDRURW travels as the guest's tls and TPIDRURO as
+ * tpidrro.  The constants and helpers are arm64 Linux's
+ * (arch/arm64/include/asm/ptrace.h).
+ */
+#include <linux/bits.h>
+#include <linux/types.h>
+
+/* From uapi/asm/ptrace.h, which this early header cannot include. */
+#ifndef PSR_MODE32_BIT
+#define PSR_MODE32_BIT		0x00000010
+#endif
+#ifndef PSR_f
+#define PSR_f			0xff000000
+#endif
+
+#define PSR_AA32_MODE_MASK	0x0000001f
+#define PSR_AA32_MODE_USR	0x00000010
+#define PSR_AA32_T_BIT		0x00000020
+#define PSR_AA32_F_BIT		0x00000040
+#define PSR_AA32_I_BIT		0x00000080
+#define PSR_AA32_A_BIT		0x00000100
+#define PSR_AA32_E_BIT		0x00000200
+#define PSR_AA32_SSBS_BIT	0x00800000
+#define PSR_AA32_DIT_BIT	0x01000000
+#define PSR_AA32_Q_BIT		0x08000000
+#define PSR_AA32_V_BIT		0x10000000
+#define PSR_AA32_C_BIT		0x20000000
+#define PSR_AA32_Z_BIT		0x40000000
+#define PSR_AA32_N_BIT		0x80000000
+#define PSR_AA32_IT_MASK	0x0600fc00
+#define PSR_AA32_GE_MASK	0x000f0000
+/* Little-endian only: SETEND is UNDEFINED. */
+#define PSR_AA32_ENDSTATE	0
+
+/* CPSR keeps DIT where SPSR does not. */
+#define COMPAT_PSR_DIT_BIT	0x00200000
+
+/* The SPSR bits an AArch32 task may not set: 63:32, PAN and IL. */
+#define UML_AARCH32_PSTATE_RES0 \
+	(GENMASK_ULL(63, 32) | BIT_ULL(22) | BIT_ULL(20))
+/* PSTATE.SS is the entry's, not the task's (begin_guest_step()). */
+#define UML_AARCH32_PSTATE_SS	BIT_ULL(21)
+
+/* AArch32 FPSCR is the fpsr bits that are status and the fpcr bits that
+ * are control; Len and Stride read as zero and ignore writes. */
+#define VFP_FPSCR_STAT_MASK	0xf800009f
+#define VFP_FPSCR_CTRL_MASK	0x07f79f00
+
+/* The ptrace requests of arch/arm. */
+#define COMPAT_PTRACE_GETREGS		12
+#define COMPAT_PTRACE_SETREGS		13
+#define COMPAT_PTRACE_GET_THREAD_AREA	22
+#define COMPAT_PTRACE_SET_SYSCALL	23
+#define COMPAT_PTRACE_GETVFPREGS	27
+#define COMPAT_PTRACE_SETVFPREGS	28
+#define COMPAT_PTRACE_GETHBPREGS	29
+#define COMPAT_PTRACE_SETHBPREGS	30
+
+/* Offsets of PTRACE_PEEKUSR and PTRACE_POKEUSR, in bytes. */
+#define COMPAT_PT_TEXT_ADDR		0x10000
+#define COMPAT_PT_DATA_ADDR		0x10004
+#define COMPAT_PT_TEXT_END_ADDR		0x10008
+
+/* r0-r15, CPSR and ORIG_r0, as arch/arm's struct pt_regs. */
+#define COMPAT_ELF_NGREG		18
+
+static inline unsigned long compat_psr_to_pstate(const unsigned long psr)
+{
+	unsigned long pstate = psr & ~COMPAT_PSR_DIT_BIT;
+
+	if (psr & COMPAT_PSR_DIT_BIT)
+		pstate |= PSR_AA32_DIT_BIT;
+	return pstate;
+}
+
+static inline unsigned long pstate_to_compat_psr(const unsigned long pstate)
+{
+	unsigned long psr = pstate & ~PSR_AA32_DIT_BIT;
+
+	if (pstate & PSR_AA32_DIT_BIT)
+		psr |= COMPAT_PSR_DIT_BIT;
+	return psr;
+}
+
+/* The ARM-private syscalls (asm/unistd.h) and the instructions that stand
+ * for a breakpoint to a debugger, which native arm64 reports as SIGTRAP. */
+#define UML_AARCH32_BREAK_ARM		0x07f001f0
+#define UML_AARCH32_BREAK_THUMB		0xde01
+#define UML_AARCH32_BREAK_THUMB2_LO	0xf7f0
+#define UML_AARCH32_BREAK_THUMB2_HI	0xa000
+
+struct task_struct;
+struct uml_pt_regs;
+struct user_regset_view;
+
+/* arch/arm64/um/aarch32.c */
+extern unsigned long uml_arm64_compat_hwcap;
+extern unsigned long uml_arm64_compat_hwcap2;
+extern bool uml_arm64_aarch32_supported(void);
+
+/* arch/um/kernel/skas/uaccess.c */
+extern int uml_xchg_user(void __user *uaddr, unsigned int size, u32 *value);
+
+/* arch/arm64/um/ptrace32.c */
+extern bool uml_arm64_valid_compat_pstate(unsigned long *pstate);
+extern const struct user_regset_view *
+uml_arm64_aarch32_regset_view(struct task_struct *task);
+
+#endif
