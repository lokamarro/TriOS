diff --git a/arch/arm64/um/ptrace32.c b/arch/arm64/um/ptrace32.c
new file mode 100644
index 0000000000000000000000000000000000000000..ae23fd3375c722ddcdb38ee130fbfbea210cceae
--- /dev/null
+++ b/arch/arm64/um/ptrace32.c
@@ -0,0 +1,366 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ptrace and core-dump access to the registers of an AArch32 task, from
+ * arch/arm64/kernel/ptrace.c.
+ *
+ * The regset views are native's: a compat tracer, and a core dump of a
+ * compat task, use user_aarch32_view (NT_PRSTATUS of 18 words and NT_ARM_VFP);
+ * an AArch64 tracer of a compat task uses user_aarch32_ptrace_view, which
+ * adds NT_ARM_TLS.  UML has no hardware debug registers and neither view
+ * has NT_ARM_SYSTEM_CALL, as the AArch64 view has neither.
+ */
+
+#include <linux/compat.h>
+#include <linux/elf.h>
+#include <linux/mm.h>
+#include <linux/ptrace.h>
+#include <linux/regset.h>
+#include <linux/sched.h>
+#include <linux/uaccess.h>
+
+#include <asm/aarch32.h>
+#include <asm/elf.h>
+
+enum compat_regset {
+	REGSET_COMPAT_GPR,
+	REGSET_COMPAT_VFP,
+	REGSET_COMPAT_TLS,
+};
+
+/* struct user_vfp of arch/arm: D0-D31 then FPSCR. */
+#define VFP_STATE_SIZE		((32 * 8) + 4)
+/* The size of struct user of arch/arm, past which PEEKUSR is -EIO. */
+#define COMPAT_USER_SZ		296
+
+/*
+ * A user-supplied CPSR is kept to the bits userspace owns: the flags, Q, GE,
+ * IT, DIT, SSBS and T.  User mode with A, I and F clear is valid; like native
+ * valid_compat_regs() and arch/arm, anything else is forced to user mode with
+ * those bits kept and reported as invalid, so sigreturn raises SIGSEGV and a
+ * tracer's write fails with -EINVAL.
+ */
+bool uml_arm64_valid_compat_pstate(unsigned long *pstate)
+{
+	*pstate &= ~(UML_AARCH32_PSTATE_RES0 | UML_AARCH32_PSTATE_SS);
+
+	/* There is no mixed-endian EL0. */
+	*pstate &= ~PSR_AA32_E_BIT;
+
+	if ((*pstate & PSR_MODE32_BIT) &&
+	    (*pstate & PSR_AA32_MODE_MASK) == PSR_AA32_MODE_USR &&
+	    !(*pstate & (PSR_AA32_A_BIT | PSR_AA32_I_BIT | PSR_AA32_F_BIT)))
+		return true;
+
+	*pstate &= PSR_AA32_N_BIT | PSR_AA32_Z_BIT | PSR_AA32_C_BIT |
+		   PSR_AA32_V_BIT | PSR_AA32_Q_BIT | PSR_AA32_IT_MASK |
+		   PSR_AA32_GE_MASK | PSR_AA32_T_BIT;
+	*pstate |= PSR_MODE32_BIT;
+	return false;
+}
+
+static int compat_gpr_get(struct task_struct *target,
+			  const struct user_regset *regset, struct membuf to)
+{
+	struct uml_pt_regs *r = &task_pt_regs(target)->regs;
+	int i;
+
+	/* r0-r14, pc, cpsr and orig_r0, each in 32 bits. */
+	for (i = 0; i < 15; i++)
+		membuf_store(&to, (compat_ulong_t)UPT_X(r, i));
+	membuf_store(&to, (compat_ulong_t)UPT_IP(r));
+	membuf_store(&to, (compat_ulong_t)
+		     pstate_to_compat_psr((u32)UPT_PSTATE(r)));
+	return membuf_store(&to, (compat_ulong_t)r->orig_x0);
+}
+
+static int compat_gpr_set(struct task_struct *target,
+			  const struct user_regset *regset,
+			  unsigned int pos, unsigned int count,
+			  const void *kbuf, const void __user *ubuf)
+{
+	struct uml_pt_regs *r = &task_pt_regs(target)->regs;
+	compat_ulong_t reg[COMPAT_ELF_NGREG];
+	unsigned long pstate;
+	int i, ret;
+
+	for (i = 0; i < 15; i++)
+		reg[i] = UPT_X(r, i);
+	reg[15] = UPT_IP(r);
+	reg[16] = pstate_to_compat_psr((u32)UPT_PSTATE(r));
+	reg[17] = r->orig_x0;
+
+	ret = user_regset_copyin(&pos, &count, &kbuf, &ubuf, reg, 0,
+				 sizeof(reg));
+	if (ret)
+		return ret;
+
+	pstate = compat_psr_to_pstate(reg[16]);
+	if (!uml_arm64_valid_compat_pstate(&pstate))
+		return -EINVAL;
+
+	for (i = 0; i < 15; i++)
+		UPT_X(r, i) = reg[i];
+	UPT_IP(r) = reg[15] & ~1UL;
+	UPT_PSTATE(r) = pstate;
+	r->orig_x0 = reg[17];
+	return 0;
+}
+
+static int compat_vfp_get(struct task_struct *target,
+			  const struct user_regset *regset, struct membuf to)
+{
+	const elf_fpregset_t *fpsimd = (const void *)task_pt_regs(target)->regs.fp;
+	compat_ulong_t fpscr;
+	int i;
+
+	/* D(2n) and D(2n+1) are the low and high halves of Vn. */
+	for (i = 0; i < 16; i++) {
+		membuf_store(&to, (u64)fpsimd->vregs[i]);
+		membuf_store(&to, (u64)(fpsimd->vregs[i] >> 64));
+	}
+
+	fpscr = (fpsimd->fpsr & VFP_FPSCR_STAT_MASK) |
+		(fpsimd->fpcr & VFP_FPSCR_CTRL_MASK);
+	return membuf_store(&to, fpscr);
+}
+
+static int compat_vfp_set(struct task_struct *target,
+			  const struct user_regset *regset,
+			  unsigned int pos, unsigned int count,
+			  const void *kbuf, const void __user *ubuf)
+{
+	elf_fpregset_t *fpsimd = (void *)task_pt_regs(target)->regs.fp;
+	struct {
+		u64 d[32];
+		compat_ulong_t fpscr;
+	} vfp;
+	int i, ret;
+
+	for (i = 0; i < 16; i++) {
+		vfp.d[2 * i] = (u64)fpsimd->vregs[i];
+		vfp.d[2 * i + 1] = (u64)(fpsimd->vregs[i] >> 64);
+	}
+	vfp.fpscr = (fpsimd->fpsr & VFP_FPSCR_STAT_MASK) |
+		    (fpsimd->fpcr & VFP_FPSCR_CTRL_MASK);
+
+	ret = user_regset_copyin(&pos, &count, &kbuf, &ubuf, &vfp, 0,
+				 VFP_STATE_SIZE);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < 16; i++)
+		fpsimd->vregs[i] = ((unsigned __int128)vfp.d[2 * i + 1] << 64) |
+				   vfp.d[2 * i];
+	fpsimd->fpsr = vfp.fpscr & VFP_FPSCR_STAT_MASK;
+	fpsimd->fpcr = vfp.fpscr & VFP_FPSCR_CTRL_MASK;
+	return 0;
+}
+
+/*
+ * NT_ARM_TLS of an AArch32 task, as native: TPIDRURO, then TPIDR2_EL0 which
+ * reads as zero and ignores writes.
+ */
+static int compat_tls_get(struct task_struct *target,
+			  const struct user_regset *regset, struct membuf to)
+{
+	membuf_store(&to, (u64)task_pt_regs(target)->regs.tpidrro);
+	return membuf_zero(&to, sizeof(u64));
+}
+
+static int compat_tls_set(struct task_struct *target,
+			  const struct user_regset *regset,
+			  unsigned int pos, unsigned int count,
+			  const void *kbuf, const void __user *ubuf)
+{
+	unsigned long tls[2] = { task_pt_regs(target)->regs.tpidrro, 0 };
+	int ret;
+
+	ret = user_regset_copyin(&pos, &count, &kbuf, &ubuf, tls, 0,
+				 sizeof(tls));
+	if (ret)
+		return ret;
+	task_pt_regs(target)->regs.tpidrro = (u32)tls[0];
+	return 0;
+}
+
+static const struct user_regset aarch32_regsets[] = {
+	[REGSET_COMPAT_GPR] = {
+		USER_REGSET_NOTE_TYPE(PRSTATUS),
+		.n = COMPAT_ELF_NGREG,
+		.size = sizeof(compat_elf_greg_t),
+		.align = sizeof(compat_elf_greg_t),
+		.regset_get = compat_gpr_get,
+		.set = compat_gpr_set
+	},
+	[REGSET_COMPAT_VFP] = {
+		USER_REGSET_NOTE_TYPE(ARM_VFP),
+		.n = VFP_STATE_SIZE / sizeof(compat_ulong_t),
+		.size = sizeof(compat_ulong_t),
+		.align = sizeof(compat_ulong_t),
+		.regset_get = compat_vfp_get,
+		.set = compat_vfp_set
+	},
+	[REGSET_COMPAT_TLS] = {
+		USER_REGSET_NOTE_TYPE(ARM_TLS),
+		.n = 2,
+		.size = sizeof(void *),
+		.align = sizeof(void *),
+		.regset_get = compat_tls_get,
+		.set = compat_tls_set,
+	},
+};
+
+static const struct user_regset_view user_aarch32_view = {
+	.name = "aarch32", .e_machine = EM_ARM,
+	.regsets = aarch32_regsets, .n = REGSET_COMPAT_TLS
+};
+
+static const struct user_regset_view user_aarch32_ptrace_view = {
+	.name = "aarch32", .e_machine = EM_ARM,
+	.regsets = aarch32_regsets, .n = ARRAY_SIZE(aarch32_regsets)
+};
+
+const struct user_regset_view *
+uml_arm64_aarch32_regset_view(struct task_struct *task)
+{
+	/*
+	 * Core dumping of 32-bit tasks or compat ptrace requests must use the
+	 * user_aarch32_view compatible with arm32. Native ptrace requests on
+	 * 32-bit children use an extended user_aarch32_ptrace_view to allow
+	 * access to the TLS register.
+	 */
+	if (is_compat_task())
+		return &user_aarch32_view;
+	return &user_aarch32_ptrace_view;
+}
+
+static int compat_ptrace_read_user(struct task_struct *tsk, compat_ulong_t off,
+				   compat_ulong_t __user *ret)
+{
+	compat_ulong_t tmp;
+
+	if (off & 3)
+		return -EIO;
+
+	if (off == COMPAT_PT_TEXT_ADDR)
+		tmp = tsk->mm->start_code;
+	else if (off == COMPAT_PT_DATA_ADDR)
+		tmp = tsk->mm->start_data;
+	else if (off == COMPAT_PT_TEXT_END_ADDR)
+		tmp = tsk->mm->end_code;
+	else if (off < sizeof(compat_elf_gregset_t)) {
+		/*
+		 * copy_regset_to_user() copies from the start of a regset and
+		 * ignores its offset, so fetch the registers and pick one.
+		 */
+		compat_ulong_t *regs;
+		int err;
+
+		err = regset_get_alloc(tsk,
+				       &aarch32_regsets[REGSET_COMPAT_GPR],
+				       sizeof(compat_elf_gregset_t),
+				       (void **)&regs);
+		if (err < 0)
+			return err;
+		tmp = regs[off / sizeof(compat_ulong_t)];
+		kvfree(regs);
+	} else if (off >= COMPAT_USER_SZ)
+		return -EIO;
+	else
+		tmp = 0;
+
+	return put_user(tmp, ret);
+}
+
+static int compat_ptrace_write_user(struct task_struct *tsk, compat_ulong_t off,
+				    compat_ulong_t val)
+{
+	if (off & 3 || off >= COMPAT_USER_SZ)
+		return -EIO;
+
+	if (off >= sizeof(compat_elf_gregset_t))
+		return 0;
+
+	return copy_regset_from_user(tsk, &user_aarch32_view,
+				     REGSET_COMPAT_GPR, off,
+				     sizeof(compat_ulong_t), &val);
+}
+
+/*
+ * UML has no hardware breakpoints or watchpoints: the information word
+ * reports zero of each, and no other register exists.
+ */
+static int compat_ptrace_gethbpregs(compat_long_t num, compat_ulong_t __user *data)
+{
+	if (num != 0)
+		return -EINVAL;
+	return put_user(0, data);
+}
+
+long compat_arch_ptrace(struct task_struct *child, compat_long_t request,
+			compat_ulong_t caddr, compat_ulong_t cdata)
+{
+	unsigned long addr = caddr;
+	unsigned long data = cdata;
+	void __user *datap = compat_ptr(data);
+	int ret;
+
+	switch (request) {
+	case PTRACE_PEEKUSR:
+		ret = compat_ptrace_read_user(child, addr, datap);
+		break;
+
+	case PTRACE_POKEUSR:
+		ret = compat_ptrace_write_user(child, addr, data);
+		break;
+
+	case COMPAT_PTRACE_GETREGS:
+		ret = copy_regset_to_user(child, &user_aarch32_view,
+					  REGSET_COMPAT_GPR, 0,
+					  sizeof(compat_elf_gregset_t), datap);
+		break;
+
+	case COMPAT_PTRACE_SETREGS:
+		ret = copy_regset_from_user(child, &user_aarch32_view,
+					    REGSET_COMPAT_GPR, 0,
+					    sizeof(compat_elf_gregset_t),
+					    datap);
+		break;
+
+	case COMPAT_PTRACE_GET_THREAD_AREA:
+		ret = put_user(task_pt_regs(child)->regs.tpidrro,
+			       (compat_ulong_t __user *)datap);
+		break;
+
+	case COMPAT_PTRACE_SET_SYSCALL:
+		PT_REGS_SYSCALL_NR(task_pt_regs(child)) = data;
+		ret = 0;
+		break;
+
+	case COMPAT_PTRACE_GETVFPREGS:
+		ret = copy_regset_to_user(child, &user_aarch32_view,
+					  REGSET_COMPAT_VFP, 0,
+					  VFP_STATE_SIZE, datap);
+		break;
+
+	case COMPAT_PTRACE_SETVFPREGS:
+		ret = copy_regset_from_user(child, &user_aarch32_view,
+					    REGSET_COMPAT_VFP, 0,
+					    VFP_STATE_SIZE, datap);
+		break;
+
+	case COMPAT_PTRACE_GETHBPREGS:
+		ret = compat_ptrace_gethbpregs((compat_long_t)addr, datap);
+		break;
+
+	case COMPAT_PTRACE_SETHBPREGS:
+		ret = -EINVAL;
+		break;
+
+	default:
+		ret = compat_ptrace_request(child, request, addr, data);
+		break;
+	}
+
+	return ret;
+}
diff --git a/arch/arm64/um/shared/sysdep/ptrace.h b/arch/arm64/um/shared/sysdep/ptrace.h
index 83096ca4112793252c70c677913a0d7ae505aad5..4188e5b95ef1a04deee6b4ce6f2d740b08332d76 100644
--- a/arch/arm64/um/shared/sysdep/ptrace.h
+++ b/arch/arm64/um/shared/sysdep/ptrace.h
@@ -22,6 +22,20 @@
 #define UPT_IP(regs) REGS_IP((regs)->gp)
 #define UPT_PSTATE(regs) REGS_PSTATE((regs)->gp)
 
+/*
+ * PSTATE.nRW: the task runs AArch32 code, whose R0-R14 are x0-x14 and whose
+ * syscall number is r7 rather than x8 (asm/aarch32.h).  The stack pointer
+ * that UPT_SP() names is the A64 one; an AArch32 task's is x13.
+ */
+#define UML_ARM64_PSTATE_NRW 0x10UL
+#define UML_ARM64_PSTATE_T 0x20UL
+#define UPT_AARCH32(regs) ((UPT_PSTATE(regs) & UML_ARM64_PSTATE_NRW) != 0)
+#define UPT_USER_SP(regs) \
+	(UPT_AARCH32(regs) ? UPT_X((regs), 13) : UPT_SP(regs))
+#define UPT_SYSCALL_ARCH_NR(regs) \
+	(UPT_AARCH32(regs) ? (unsigned int)UPT_X((regs), 7) : \
+	 UPT_X((regs), 8))
+
 /*
  * x0 is both the first argument and the return-value register, and, as on
  * native arm64, it is the argument until the call returns: a tracer reads it
@@ -69,6 +83,11 @@ struct uml_pt_regs {
 	 * the flexible floating-point register tail.
 	 */
 	unsigned long compat_tls[3][2];
+	/*
+	 * TPIDRURO of an AArch32 task, in bits 31:0, which the host reads and
+	 * never writes; zero for every other task.
+	 */
+	unsigned long tpidrro;
 	unsigned long fp[];
 };
 
@@ -80,11 +99,31 @@ struct uml_pt_regs {
 	/* AArch64 returns syscall results in x0, which is also argument 1. \
 	 * Restore it before re-executing SVC; unlike x86, rewinding the PC \
 	 * alone would retry with -ERESTART* as the first argument. \
+	 * AArch32 rewinds its 16-bit Thumb SVC by 2 bytes and its ARM SVC \
+	 * by 4 and, like arm64 Linux, leaves ITSTATE as the call left it. \
 	 */ \
 	UPT_X((regs), 0) = (regs)->orig_x0; \
-	UPT_IP(regs) -= 4; \
+	UPT_IP(regs) -= (UPT_AARCH32(regs) && \
+			 (UPT_PSTATE(regs) & UML_ARM64_PSTATE_T)) ? 2 : 4; \
 } while (0)
 
+/* Whether the undefined instruction at an AArch32 task's pc is one of the
+ * encodings which stand for a breakpoint to a debugger (aarch32.c). */
+extern int uml_arm64_aarch32_break(struct uml_pt_regs *regs);
+/* Whether abi.cp15_barrier lets an AArch32 task execute CP15 barriers. */
+extern int uml_arm64_cp15_barrier_enabled(void);
+
+/*
+ * What uml_arm64_aarch32_emulate() made of the undefined instruction at an
+ * AArch32 task's pc (armv8_deprecated.c): it is not one the kernel emulates
+ * here, so the task gets SIGILL; it was emulated and the pc is past it; or
+ * it raised a signal itself and left the pc at the instruction.
+ */
