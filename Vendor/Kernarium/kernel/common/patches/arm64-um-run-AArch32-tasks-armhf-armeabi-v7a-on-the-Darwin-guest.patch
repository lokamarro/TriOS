+	bool "Enable kuser helpers page for 32-bit applications"
+	depends on UML_ARM64_AARCH32
+	default y
+	help
+	  Provide the kuser helpers to AArch32 tasks, read-only at their fixed
+	  addresses below 0xffff1000, as arm64 Linux does.  Disabling this may
+	  break 32-bit programs, which Android's bionic and glibc rely on.
+
 config ARCH_MMAP_RND_BITS_MIN
 	int
 	default 18
@@ -34,6 +59,14 @@ config ARCH_MMAP_RND_BITS_MAX
 	int
 	default 29
 
+config ARCH_MMAP_RND_COMPAT_BITS_MIN
+	int
+	default 11
+
+config ARCH_MMAP_RND_COMPAT_BITS_MAX
+	int
+	default 16
+
