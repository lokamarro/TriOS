+#define UML_ARM64_A32_RETIRED 1
+#define UML_ARM64_A32_SIGNALLED 2
+extern int uml_arm64_aarch32_emulate(struct uml_pt_regs *regs);
+
 extern unsigned long host_fp_size;
 extern int arch_init_registers(int pid);
 
