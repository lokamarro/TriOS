index 7915c1b421f91df67001dbcf97de9b87d2e06e47..a6d32d27031a4ecdc38d8f81873b7e106b4902cd 100644
--- a/arch/um/kernel/skas/uaccess.c
+++ b/arch/um/kernel/skas/uaccess.c
@@ -15,6 +15,9 @@
 #include <asm/page.h>
 #include <kern_util.h>
 #include <asm/futex.h>
+#ifdef CONFIG_UML_ARM64_AARCH32
+#include <asm/aarch32.h>
+#endif
 #include <mem_user.h>
 #include <os.h>
 #include <skas.h>
@@ -649,3 +652,55 @@ int futex_atomic_cmpxchg_inatomic(u32 *uval, u32 __user *uaddr,
 	return ret;
 }
 EXPORT_SYMBOL(futex_atomic_cmpxchg_inatomic);
+
+#ifdef CONFIG_UML_ARM64_AARCH32
+/**
+ * uml_xchg_user() - Atomically exchange a byte or a word of user memory.
+ *
+ * @uaddr:	user address of the byte, or of the word, which must be
+ *		aligned
+ * @size:	1 or 4
+ * @value:	the value to store, replaced by the previous contents of the
+ *		location, zero-extended
+ *
+ * It is SWP and SWPB for an AArch32 task.  The exchange is one host atomic
+ * instruction on the page's kernel alias, which is the memory the engines'
+ * software MMU maps for the task, as for the futex operations above.  It
+ * is therefore atomic against exclusive pairs, atomic instructions and
+ * futex operations on other vCPUs.  Unlike them it may sleep, to
+ * demand-page or copy the page.
+ *
+ * Return:
+ * 0 - On success
+ * -EFAULT - The access is refused: the address is not a user address, it is
+ *	     misaligned, or the page cannot be mapped for writing
+ */
+int uml_xchg_user(void __user *uaddr, unsigned int size, u32 *value)
+{
+	unsigned long addr = (unsigned long)uaddr;
+	struct page *page;
+	void *alias;
+
+	might_sleep();
+	if ((size != 1 && size != 4) || (addr & (size - 1)) ||
+	    !access_ok(uaddr, size))
+		return -EFAULT;
+	page = maybe_map(addr, 1);
+	if (page == NULL)
+		return -EFAULT;
+
+	preempt_disable();
+	pagefault_disable();
+	alias = page_address(page) + (addr & ~PAGE_MASK);
+	if (size == 1)
+		*value = xchg((u8 *)alias, (u8)*value);
+	else
+		*value = xchg((u32 *)alias, *value);
+	pagefault_enable();
+	preempt_enable();
+
+	mark_user_page_dirty(addr, page, true);
+	unpin_user_mapping(page, 1);
+	return 0;
+}
+#endif
