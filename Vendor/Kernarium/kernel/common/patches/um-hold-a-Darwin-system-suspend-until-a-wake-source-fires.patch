 arch/um/include/shared/kern_util.h |   1 +
 arch/um/include/shared/os.h        |   4 +
 arch/um/kernel/um_arch.c           |  30 +++++-
 arch/um/os-Darwin/file.c           |  31 +++---
 arch/um/os-Darwin/irq.c            | 168 +++++++++++++++++++++++------
 6 files changed, 239 insertions(+), 48 deletions(-)

diff --git a/arch/um/drivers/mconsole_kern.c b/arch/um/drivers/mconsole_kern.c
index 5abd0dfd66c7f1da714c1895760ada28ac1b2a74..5a0c3b28f9cfef9e38a5014c87efde6f510b7cc8 100644
--- a/arch/um/drivers/mconsole_kern.c
+++ b/arch/um/drivers/mconsole_kern.c
@@ -6,6 +6,7 @@
 
 #include <linux/console.h>
 #include <linux/ctype.h>
+#include <linux/delay.h>
 #include <linux/string.h>
 #include <linux/interrupt.h>
 #include <linux/list.h>
@@ -229,6 +230,8 @@ void mconsole_go(struct mc_request *req)
 
 #ifdef CONFIG_SUSPEND
 static struct mc_request *suspend_request;
+/* A wake arrived while the host's suspend request was in progress. */
+static bool suspend_woken;
 
 void um_suspend_notify_entered(void)
 {
@@ -238,10 +241,27 @@ void um_suspend_notify_entered(void)
 		mconsole_reply(req, "suspended", 0, 0);
 }
 
+int um_suspend_wake_requested(void)
+{
+	return READ_ONCE(suspend_woken);
+}
+
+/*
+ * The PM core gives a suspend up with -EBUSY when something gets in its way,
+ * typically a wake source of the guest's own, such as an RTC alarm, that
+ * fired while the suspend was being entered.  The host still wants the guest
+ * suspended, and a new suspend discards the wakeups signaled before it
+ * began, so the request enters it again, a few times at most.  The host's
+ * own wake ends the request instead, and so does any other failure.
+ */
+#define MCONSOLE_SUSPEND_RETRIES 3
+#define MCONSOLE_SUSPEND_RETRY_MS 50
+
 void mconsole_suspend(struct mc_request *req)
 {
 	struct mc_request *pending;
 	char response[64];
+	int retries = 0;
 	int error;
 
 	if (cmpxchg(&suspend_request, NULL, req) != NULL) {
@@ -249,27 +269,58 @@ void mconsole_suspend(struct mc_request *req)
 		return;
 	}
 	error = pm_suspend(PM_SUSPEND_MEM);
+	while (error == -EBUSY && retries++ < MCONSOLE_SUSPEND_RETRIES &&
+	       !READ_ONCE(suspend_woken) && READ_ONCE(suspend_request) != NULL) {
+		msleep(MCONSOLE_SUSPEND_RETRY_MS);
+		if (READ_ONCE(suspend_woken))
+			break;
+		error = pm_suspend(PM_SUSPEND_MEM);
+	}
 	pending = xchg(&suspend_request, NULL);
+	WRITE_ONCE(suspend_woken, false);
 	if (pending == NULL)
 		return;
 	snprintf(response, sizeof(response), "Suspend failed: %d", error);
 	mconsole_reply(pending, response, 1, 0);
 }
+
+void mconsole_wake(struct mc_request *req)
+{
+	/*
+	 * Until the suspend has stopped interrupts, this request is answered
+	 * here rather than left on the console to end the sleep.  It ends the
+	 * suspend anyway, whether the host or the guest started it: as a
+	 * wakeup, it aborts a suspend at the PM core's next check from the
+	 * moment that suspend began, file system sync included.  A suspend the
+	 * host asked for might not have begun yet, so it also does not sleep
+	 * after a wake that arrived since the request.  A guest that is not
+	 * suspending only answers: its next suspend discards the wakeup.
+	 */
+	if (READ_ONCE(suspend_request) != NULL)
+		WRITE_ONCE(suspend_woken, true);
+	pm_system_wakeup();
+	mconsole_reply(req, "running", 0, 0);
+}
 #else
 void um_suspend_notify_entered(void)
 {
 }
 
+int um_suspend_wake_requested(void)
+{
+	return 0;
+}
+
 void mconsole_suspend(struct mc_request *req)
 {
 	mconsole_reply(req, "System suspend is not configured", 1, 0);
 }
-#endif
 
 void mconsole_wake(struct mc_request *req)
 {
 	mconsole_reply(req, "running", 0, 0);
 }
+#endif
 
 void mconsole_stop(struct mc_request *req)
 {
