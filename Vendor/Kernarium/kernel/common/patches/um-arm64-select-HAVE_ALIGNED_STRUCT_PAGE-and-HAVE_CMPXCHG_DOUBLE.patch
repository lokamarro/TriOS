From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 27 Sep 2026 02:34:05 +0900
Subject: [PATCH] um: arm64: select HAVE_ALIGNED_STRUCT_PAGE and
 HAVE_CMPXCHG_DOUBLE

SLUB updates a slab's freelist and counters together with a double-word
cmpxchg when the architecture provides one and struct page is aligned
for it. mm/slab.h drops system_has_freelist_aba() unless
HAVE_ALIGNED_STRUCT_PAGE is set, so arm64 UML fell back to the bit-lock
slow path, and kmalloc_nolock() returned NULL for every non-debug cache.
BPF timers allocate through kmalloc_nolock(), so bpf_timer_init()
failed with -ENOMEM.

UML arm64 builds the native arm64 cmpxchg128() and runs kernel code
directly on the host CPU, where it is a CASP instruction, and the x86-64
userspace slice keeps that arm64 kernel. Select the same two symbols
native arm64 does. HAVE_CMPXCHG_DOUBLE has no C users; it records the
capability.

struct page is already 64 bytes, so its size does not change. The FLATMEM
memory map is allocated with SMP_CACHE_BYTES alignment; assert at build
time that this covers struct page.
---
 arch/arm64/um/Kconfig |  2 ++
 arch/um/kernel/mem.c  | 10 ++++++++++
 2 files changed, 12 insertions(+)

diff --git a/arch/arm64/um/Kconfig b/arch/arm64/um/Kconfig
index 55785809fc4eb1e08a19ef647ae91f9236905cd4..0c6de0263b94e36efac04e2a398a6ac50f9c959e 100644
--- a/arch/arm64/um/Kconfig
+++ b/arch/arm64/um/Kconfig
@@ -12,7 +12,9 @@ config UML_ARM64
 	select GENERIC_HWEIGHT
 	select GENERIC_TIME_VSYSCALL
 	select HAVE_GENERIC_VDSO
+	select HAVE_ALIGNED_STRUCT_PAGE
 	select HAVE_ARCH_MMAP_RND_BITS
+	select HAVE_CMPXCHG_DOUBLE
 	select HAVE_EFFICIENT_UNALIGNED_ACCESS
 	select HAVE_PERF_EVENTS
 	select MODULES_USE_ELF_RELA
diff --git a/arch/um/kernel/mem.c b/arch/um/kernel/mem.c
index bbd1872f3c26d629f54198b9309185196cd2f627..7c42ca72464020660034a658d553132b7f8b1f42 100644
--- a/arch/um/kernel/mem.c
+++ b/arch/um/kernel/mem.c
@@ -209,6 +209,16 @@ void __init paging_init(void)
 	max_zone_pfn[ZONE_NORMAL] = end_iomem >> PAGE_SHIFT;
 	free_area_init(max_zone_pfn);
 
+#ifdef CONFIG_FLATMEM
+	/*
+	 * SLUB updates a slab's freelist and counters with one double-word
+	 * cmpxchg on its struct page, which HAVE_ALIGNED_STRUCT_PAGE aligns
+	 * for that.  The memory map is allocated with SMP_CACHE_BYTES
+	 * alignment, so that must cover it.
+	 */
+	BUILD_BUG_ON(SMP_CACHE_BYTES < __alignof__(struct page));
+#endif
+
 #if IS_ENABLED(CONFIG_ARCH_REUSE_HOST_VSYSCALL_AREA)
 	fixaddr_user_init();
 #endif
