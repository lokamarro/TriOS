+pid_t os_reap_child(void)
+{
+	return 0;
+}
+
+void os_alarm_process(int pid)
+{
+	(void)pid;
+	/*
+	 * Linux UML uses SIGALRM here to interrupt the separate ptraced
+	 * userspace process.  Darwin UML enters guest code on the current
+	 * kernel pthread, so timer_handler() is already running in the thread
+	 * that must be interrupted.  Calling deliver_alarm() again would
+	 * recurse through the clock IRQ and account every host deadline twice.
+	 */
+}
+
+void os_kill_process(int pid, int reap_child)
+{
+	/* No helper process exists on Darwin. */
+	(void)pid;
+	(void)reap_child;
+}
+
+void os_kill_ptraced_process(int pid, int reap_child)
+{
+	(void)pid;
+	(void)reap_child;
+}
+
+int os_map_memory(void *address, int fd, unsigned long long offset,
+		  unsigned long length, int read, int write, int execute)
+{
+	int protection = (read ? PROT_READ : 0) |
+		(write ? PROT_WRITE : 0) | ((execute & 1) ? PROT_EXEC : 0);
+	int result = darwin_uml_vm_map(address, fd, offset, length, protection,
+				       !!(execute & 2), !!(execute & 4));
+
+	return result < 0 ? -errno : result;
+}
+
+int os_protect_memory(void *address, unsigned long length,
+		      int read, int write, int execute)
+{
+	int protection = (read ? PROT_READ : 0) |
+		(write ? PROT_WRITE : 0) | (execute ? PROT_EXEC : 0);
+	int result = darwin_uml_vm_protect(address, length, protection);
+
+	return result < 0 ? -errno : result;
+}
+
+int os_unmap_memory(void *address, int length)
+{
+	int result = darwin_uml_vm_unmap(address, (unsigned long)length);
+
+	return result < 0 ? -errno : result;
+}
+
+int os_drop_memory(void *address, int length)
+{
+	int result = darwin_uml_vm_drop(address, (unsigned long)length);
+
+	return result < 0 ? -errno : result;
+}
+
+int can_drop_memory(void)
+{
+	return 1;
+}
+
+void init_new_thread_signals(void)
+{
+	set_handler(SIGSEGV);
+	set_handler(SIGTRAP);
+	set_handler(SIGFPE);
+	set_handler(SIGILL);
+	set_handler(SIGBUS);
+	set_handler(SIGALRM);
+	signal(SIGPIPE, SIG_IGN);
+	signal(SIGWINCH, SIG_IGN);
+}
