diff --git a/arch/um/os-Darwin/irq.c b/arch/um/os-Darwin/irq.c
new file mode 100644
index 0000000000000000000000000000000000000000..45aa9db0b03f72d597a8ee90a3e0b037d1f7fdb3
--- /dev/null
+++ b/arch/um/os-Darwin/irq.c
@@ -0,0 +1,351 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <string.h>
+#include <sys/event.h>
+#include <unistd.h>
+#include <irq_user.h>
+#include <os.h>
+#include "irq.h"
+
+#define DARWIN_MAX_EVENTS 64
+#define DARWIN_NOTIFICATION_BATCH 16
+#define DARWIN_NOTIFICATION_STOP_IDENT 1
+#define DARWIN_EVENT_READ 1
+#define DARWIN_EVENT_WRITE 2
+
+struct watched_fd {
+	int fd;
+	int events;
+	void *data;
+};
+
+static struct watched_fd watched[DARWIN_MAX_EVENTS];
+static struct watched_fd triggered[DARWIN_MAX_EVENTS];
+static int watched_count;
+static int notification_kqueue = -1;
+static int dispatch_kqueue = -1;
+static pthread_mutex_t idle_waiter_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t idle_waiter_ready = PTHREAD_COND_INITIALIZER;
+static pthread_t idle_waiter;
+static pthread_t notification_worker;
+static int idle_waiter_valid;
+static int notification_worker_joinable;
+static int notification_stopping;
+
+static void wake_signal_handler(int signal)
+{
+	(void)signal;
+}
+
+static void *notification_thread(void *unused)
+{
+	struct kevent events[DARWIN_NOTIFICATION_BATCH];
+	sigset_t blocked;
+
+	(void)unused;
+	/* This helper is created before Darwin switches UML to cooperative
+	 * timers.  Never let the process-wide ITIMER_REAL select it as the
+	 * recipient: the guest clock must run on the UML kernel/idle thread.
+	 */
+	sigemptyset(&blocked);
+	sigaddset(&blocked, SIGALRM);
+	(void)pthread_sigmask(SIG_BLOCK, &blocked, NULL);
+	for (;;) {
+		pthread_t target;
+		int have_target;
+		int count;
+		int index;
+
+		count = kevent(notification_kqueue, NULL, 0, events,
+			       DARWIN_NOTIFICATION_BATCH, NULL);
+		if (count < 0) {
+			if (errno == EINTR)
+				continue;
+			return NULL;
+		}
+		for (index = 0; index < count; index++)
+			if (events[index].filter == EVFILT_USER &&
+			    events[index].ident == DARWIN_NOTIFICATION_STOP_IDENT)
+				return NULL;
+		pthread_mutex_lock(&idle_waiter_lock);
+		/* Keep the wake until an idle carrier can dispatch it.  Dispatch has
+		 * its own kqueue, so this helper never consumes the guest IRQ edge.
+		 */
+		while (!idle_waiter_valid && !notification_stopping)
+			pthread_cond_wait(&idle_waiter_ready, &idle_waiter_lock);
+		if (notification_stopping) {
+			pthread_mutex_unlock(&idle_waiter_lock);
+			return NULL;
+		}
+		have_target = idle_waiter_valid;
+		target = idle_waiter;
+		if (have_target)
+			(void)pthread_kill(target, SIGUSR2);
+		pthread_mutex_unlock(&idle_waiter_lock);
+	}
+}
+
+static int update_filter(int queue, int fd, short filter, int add, void *data)
+{
+	struct kevent change;
+	int result;
+
+	if (queue < 0)
+		return 0;
+	/* Delete/add also rearms an unchanged ready descriptor, matching
+	 * EPOLL_CTL_MOD.  EV_CLEAR matches UML's EPOLLET registration: a
+	 * nested IRQ dispatch must not spin on data its outer handler owns.
+	 */
+	EV_SET(&change, (uintptr_t)fd, filter, EV_DELETE, 0, 0, NULL);
+	result = kevent(queue, &change, 1, NULL, 0, NULL);
+	if (result < 0 && errno != ENOENT)
+		return -errno;
+	if (!add)
+		return 0;
+	EV_SET(&change, (uintptr_t)fd, filter,
+	       EV_ADD | EV_ENABLE | EV_CLEAR, 0, 0, data);
+	return kevent(queue, &change, 1, NULL, 0, NULL) < 0 ? -errno : 0;
+}
+
+static int update_registration(int fd, int events, void *data)
+{
+	int queues[] = { dispatch_kqueue, notification_kqueue };
+	unsigned int index;
+	int error;
+
+	for (index = 0; index < sizeof(queues) / sizeof(queues[0]); index++) {
+		error = update_filter(queues[index], fd, EVFILT_READ,
+				      events & DARWIN_EVENT_READ, data);
+		if (error == 0)
+			error = update_filter(queues[index], fd, EVFILT_WRITE,
+					      events & DARWIN_EVENT_WRITE, data);
+		if (error < 0)
+			return error;
+	}
+	return 0;
+}
+
+void darwin_irq_idle_begin(sigset_t *previous_mask)
+{
+	sigset_t block;
+
+	sigemptyset(&block);
+	sigaddset(&block, SIGUSR2);
+	if (pthread_sigmask(SIG_BLOCK, &block, previous_mask) != 0)
+		panic("Darwin: unable to block the IRQ wake signal");
+	pthread_mutex_lock(&idle_waiter_lock);
+	idle_waiter = pthread_self();
+	idle_waiter_valid = 1;
+	pthread_cond_signal(&idle_waiter_ready);
+	pthread_mutex_unlock(&idle_waiter_lock);
+}
+
+void darwin_irq_idle_end(const sigset_t *previous_mask)
+{
+	pthread_mutex_lock(&idle_waiter_lock);
+	idle_waiter_valid = 0;
+	pthread_mutex_unlock(&idle_waiter_lock);
+	if (pthread_sigmask(SIG_SETMASK, previous_mask, NULL) != 0)
+		panic("Darwin: unable to restore the IRQ wake signal mask");
+}
+
+void *os_epoll_get_data_pointer(int index)
+{
+	return triggered[index].data;
+}
+
+int os_epoll_triggered(int index, int events)
+{
+	return triggered[index].events & events;
+}
+
+int os_event_mask(enum um_irq_type type)
+{
+	return type == IRQ_READ ? DARWIN_EVENT_READ : DARWIN_EVENT_WRITE;
+}
+
+int os_setup_epoll(void)
+{
+	struct sigaction action = { };
+	struct kevent stop_event;
+	int index;
+	int error;
+
+	if (notification_kqueue >= 0)
+		return 0;
+	action.sa_handler = wake_signal_handler;
+	sigemptyset(&action.sa_mask);
+	/* SIGUSR2 is a wake edge for the idle pselect(), not work to run from a
+	 * signal frame.  It must interrupt that wait so the idle kernel context
+	 * can poll and deliver descriptor IRQs.
+	 */
+	action.sa_flags = 0;
+	if (sigaction(SIGUSR2, &action, NULL) < 0)
+		return -errno;
+	notification_kqueue = kqueue();
+	if (notification_kqueue < 0)
+		return -errno;
+	EV_SET(&stop_event, DARWIN_NOTIFICATION_STOP_IDENT, EVFILT_USER,
+	       EV_ADD | EV_CLEAR, 0, 0, NULL);
+	if (kevent(notification_kqueue, &stop_event, 1, NULL, 0, NULL) < 0) {
+		error = -errno;
+		close(notification_kqueue);
+		notification_kqueue = -1;
+		return error;
+	}
+	dispatch_kqueue = kqueue();
+	if (dispatch_kqueue < 0) {
+		error = -errno;
+		close(notification_kqueue);
+		notification_kqueue = -1;
+		return error;
+	}
+	/* Preserve registrations made before the common IRQ layer starts. */
+	for (index = 0; index < watched_count; index++) {
+		error = update_registration(watched[index].fd,
+					    watched[index].events, watched[index].data);
+		if (error < 0) {
+			close(dispatch_kqueue);
+			dispatch_kqueue = -1;
+			close(notification_kqueue);
+			notification_kqueue = -1;
+			return error;
+		}
+	}
+	pthread_mutex_lock(&idle_waiter_lock);
+	notification_stopping = 0;
+	pthread_mutex_unlock(&idle_waiter_lock);
+	error = pthread_create(&notification_worker, NULL,
+			       notification_thread, NULL);
+	if (error != 0) {
+		close(dispatch_kqueue);
+		dispatch_kqueue = -1;
+		close(notification_kqueue);
+		notification_kqueue = -1;
+		return -error;
+	}
+	notification_worker_joinable = 1;
+	return 0;
+}
+
+int os_waiting_for_events_epoll(void)
+{
+	struct kevent events[DARWIN_MAX_EVENTS];
+	const struct timespec immediate = { 0, 0 };
+	int count;
+	int index;
+
+	if (dispatch_kqueue < 0)
+		return 0;
+	count = kevent(dispatch_kqueue, NULL, 0, events,
+		       DARWIN_MAX_EVENTS, &immediate);
+	if (count < 0)
+		return errno == EINTR ? 0 : -errno;
+	for (index = 0; index < count; index++) {
+		triggered[index] = (struct watched_fd) {
+			.fd = (int)events[index].ident,
+			.events = events[index].filter == EVFILT_READ ?
+				DARWIN_EVENT_READ : DARWIN_EVENT_WRITE,
+			.data = events[index].udata,
+		};
+	}
+	return count;
+}
+
+int os_add_epoll_fd(int events, int fd, void *data)
+{
+	int result = os_mod_epoll_fd(events, fd, data);
+
+	if (result != -ENOENT)
+		return result;
+	if (watched_count >= DARWIN_MAX_EVENTS)
+		return -ENOSPC;
+	result = update_registration(fd, events, data);
+	if (result < 0) {
+		(void)update_registration(fd, 0, NULL);
+		return result;
+	}
+	watched[watched_count++] = (struct watched_fd) {
+		.fd = fd, .events = events, .data = data,
+	};
+	return 0;
+}
+
+int os_mod_epoll_fd(int events, int fd, void *data)
+{
+	int index;
+
+	for (index = 0; index < watched_count; index++) {
+		if (watched[index].fd == fd) {
+			int result = update_registration(fd, events, data);
+
+			if (result < 0) {
+				(void)update_registration(fd, watched[index].events,
+							  watched[index].data);
+				return result;
+			}
+			watched[index].events = events;
+			watched[index].data = data;
+			return 0;
+		}
+	}
+	return -ENOENT;
+}
+
+int os_del_epoll_fd(int fd)
+{
+	int index;
+
+	for (index = 0; index < watched_count; index++) {
+		if (watched[index].fd == fd) {
+			(void)update_registration(fd, 0, NULL);
+			memmove(&watched[index], &watched[index + 1],
+				(size_t)(watched_count - index - 1) *
+					sizeof(watched[0]));
+			watched_count--;
+			return 0;
+		}
+	}
+	return -ENOENT;
+}
+
+void os_set_ioignore(void)
+{
+	signal(SIGIO, SIG_IGN);
+}
+
+void os_close_epoll_fd(void)
+{
+	struct kevent stop_event;
+	int error;
+
+	watched_count = 0;
+	if (notification_worker_joinable) {
+		pthread_mutex_lock(&idle_waiter_lock);
+		notification_stopping = 1;
+		pthread_cond_broadcast(&idle_waiter_ready);
+		pthread_mutex_unlock(&idle_waiter_lock);
+		EV_SET(&stop_event, DARWIN_NOTIFICATION_STOP_IDENT, EVFILT_USER,
+		       0, NOTE_TRIGGER, 0, NULL);
+		if (notification_kqueue < 0 ||
+		    kevent(notification_kqueue, &stop_event, 1, NULL, 0, NULL) < 0)
+			panic("Darwin: unable to stop IRQ notification thread: %d",
+			      errno);
+		error = pthread_join(notification_worker, NULL);
+		if (error != 0)
+			panic("Darwin: unable to join IRQ notification thread: %d",
+			      error);
+		notification_worker_joinable = 0;
+	}
+	if (dispatch_kqueue >= 0) {
+		close(dispatch_kqueue);
+		dispatch_kqueue = -1;
+	}
+	if (notification_kqueue >= 0) {
+		close(notification_kqueue);
+		notification_kqueue = -1;
+	}
+}
diff --git a/arch/um/os-Darwin/irq.h b/arch/um/os-Darwin/irq.h
new file mode 100644
index 0000000000000000000000000000000000000000..026078d0e86bbcf9502a50d924511f90dfda07e0
--- /dev/null
+++ b/arch/um/os-Darwin/irq.h
@@ -0,0 +1,10 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef UML_DARWIN_IRQ_H
+#define UML_DARWIN_IRQ_H
+
+#include <signal.h>
+
+void darwin_irq_idle_begin(sigset_t *previous_mask);
+void darwin_irq_idle_end(const sigset_t *previous_mask);
+
+#endif
diff --git a/arch/um/os-Darwin/main.c b/arch/um/os-Darwin/main.c
new file mode 100644
index 0000000000000000000000000000000000000000..cbaf450b37873a730a7928f190a819c5c45ac6bc
--- /dev/null
+++ b/arch/um/os-Darwin/main.c
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <signal.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <as-layout.h>
+#include <irq_user.h>
+#include <kern_util.h>
+#include <os.h>
+#include "internal.h"
+
+long elf_aux_hwcap;
+
+static void fatal_exit(int signal)
+{
+	/* This is the second-signal/last-ditch path.  Exit immediately instead of
+	 * running sleepable Linux exitcalls from whichever fixed carrier received a
+	 * process-directed signal (which may be that vCPU's idle task).
+	 */
+	_exit(128 + signal);
+}
+
+static void install_fatal_handler(int signal)
+{
+	struct sigaction action = { };
+
+	sigemptyset(&action.sa_mask);
+	action.sa_handler = fatal_exit;
+	action.sa_flags = SA_RESETHAND | SA_NODEFER;
+	if (sigaction(signal, &action, NULL) < 0)
+		_exit(127);
+}
+
+int main(int argc, char **argv, char **envp)
+{
+	int error;
+	int result;
+
+	install_fatal_handler(SIGINT);
+	install_fatal_handler(SIGTERM);
+	change_sig(SIGPIPE, 0);
+	result = linux_main(argc, argv, envp);
+	error = darwin_wait_for_embedded_threads(10000);
+	if (error == 0)
+		error = darwin_join_cpu_carriers();
+	if (error != 0) {
+		os_warn("Darwin UML: embedded threads did not retire: %d\n", error);
+		/* Returning would let the embedded ELF loader unmap code which a live
+		 * pthread can still execute.  Terminate without unwinding instead.
+		 */
+		_exit(2);
+	}
+	/* A host stop skips Linux exitcalls, including the one which stops the
+	 * RTC alarm helper.  Stop it here, before the loader unmaps its code.
+	 */
+	if (IS_ENABLED(CONFIG_UML_RTC))
+		uml_rtc_stop_alarm_thread();
+	error = deactivate_all_fds();
+	if (error != 0)
+		os_warn("Darwin UML: deactivate_all_fds failed: %d\n", error);
+	os_timer_disable(0);
+	unblock_signals();
+	os_warn("Darwin UML stopped: result=%d exitcode=%d\n",
+		result, uml_exitcode);
+	return result ? 2 : uml_exitcode;
+}
