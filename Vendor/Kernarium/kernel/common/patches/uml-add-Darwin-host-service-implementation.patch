+
+void check_host_supports_tls(int *supports_tls, int *tls_min)
+{
+	*supports_tls = 1;
+	*tls_min = 0;
+}
+
+void get_host_cpu_features(void (*flags_helper)(char *),
+			   void (*cache_helper)(char *))
+{
+	static const struct {
+		unsigned int bit;
+		const char *name;
+	} advertised[] = {
+		{ 0, "fp" },
+		{ 1, "asimd" },
+		{ 3, "aes" },
+		{ 4, "pmull" },
+		{ 5, "sha1" },
+		{ 6, "sha2" },
+		{ 7, "crc32" },
+		{ 8, "atomics" },
+		{ 17, "sha3" },
+		{ 21, "sha512" },
+	};
+	const unsigned long hwcap = darwin_uml_guest_hwcap();
+	char features[128] = "Features\t:";
+	char cache[] = "cache_alignment\t: 64";
+	unsigned int i;
+
+	for (i = 0; i < sizeof(advertised) / sizeof(advertised[0]); ++i) {
+		if (!(hwcap & (1UL << advertised[i].bit)))
+			continue;
+		strcat(features, " ");
+		strcat(features, advertised[i].name);
+	}
+
+	flags_helper(features);
+	cache_helper(cache);
+}
+
+int parse_iomem(char *string, int *add)
+{
+	(void)string;
+	*add = 0;
+	os_warn("iomem= is not supported by the Darwin backend\n");
+	return 1;
+}
diff --git a/arch/um/os-Darwin/time.c b/arch/um/os-Darwin/time.c
new file mode 100644
index 0000000000000000000000000000000000000000..50c8f60d0412c1948fc618a899cc87572e865179
--- /dev/null
+++ b/arch/um/os-Darwin/time.c
@@ -0,0 +1,335 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <string.h>
+#include <sys/event.h>
+#include <sys/select.h>
+#include <sys/time.h>
+#include <time.h>
+#include <unistd.h>
+#include <irq_user.h>
+#include <kern_util.h>
+#include <os.h>
+#include <smp.h>
+#include "bridge.h"
+#include "irq.h"
+#include "internal.h"
+
+struct darwin_cpu_timer {
+	unsigned long long delay_ns;
+	unsigned long long deadline_ns;
+	int active;
+	int periodic;
+	/* Owned by the CPU's carrier; see arm_idle_deadline(). */
+	int deadline_queue;
+};
+
+static struct darwin_cpu_timer cpu_timers[CONFIG_NR_CPUS];
+
+static struct darwin_cpu_timer *timer_for_cpu(int cpu)
+{
+	if (cpu < 0 || cpu >= CONFIG_NR_CPUS)
+		panic("Darwin: invalid timer CPU %d", cpu);
+	return &cpu_timers[cpu];
+}
+
+static long long timespec_to_ns(const struct timespec *time)
+{
+	return (long long)time->tv_sec * UM_NSEC_PER_SEC + time->tv_nsec;
+}
+
+long long os_persistent_clock_emulation(void)
+{
+	struct timespec time;
+
+	clock_gettime(CLOCK_REALTIME, &time);
+	return timespec_to_ns(&time);
+}
+
+long long os_nsecs(void)
+{
+	struct timespec time;
+
+	clock_gettime(CLOCK_MONOTONIC, &time);
+	return timespec_to_ns(&time);
+}
+
+int os_timer_create(void)
+{
+	struct darwin_cpu_timer *state = timer_for_cpu(uml_curr_cpu());
+	int deadline_queue = state->deadline_queue;
+
+	/* A re-onlined CPU keeps the queue its carrier already created. */
+	memset(state, 0, sizeof(*state));
+	state->deadline_queue = deadline_queue;
+	return 0;
+}
+
+static int set_timer(int cpu, unsigned long long nsecs, int periodic)
+{
+	struct darwin_cpu_timer *state = timer_for_cpu(cpu);
+	struct itimerval timer = { };
+	unsigned long long usecs = (nsecs + 999) / 1000;
+
+	state->delay_ns = nsecs;
+	state->deadline_ns = (unsigned long long)os_nsecs() + nsecs;
+	state->active = 1;
+	state->periodic = periodic;
+	if (usecs == 0)
+		usecs = 1;
+	timer.it_value.tv_sec = usecs / 1000000;
+	timer.it_value.tv_usec = usecs % 1000000;
+	if (periodic)
+		timer.it_interval = timer.it_value;
+	if (darwin_timers_cooperative() || cpu != 0)
+		return 0;
+	if (setitimer(ITIMER_REAL, &timer, NULL) < 0)
+		return -errno;
+	return 0;
+}
+
+int os_timer_set_interval(int cpu, unsigned long long nsecs)
+{
+	return set_timer(cpu, nsecs, 1);
+}
+
+int os_timer_one_shot(int cpu, unsigned long long nsecs)
+{
+	return set_timer(cpu, nsecs, 0);
+}
+
+void os_timer_disable(int cpu)
+{
+	struct darwin_cpu_timer *state = timer_for_cpu(cpu);
+	struct itimerval timer = { };
+
+	state->active = 0;
+	state->deadline_ns = 0;
+	if (cpu == 0 && !darwin_timers_cooperative())
+		setitimer(ITIMER_REAL, &timer, NULL);
+}
+
+void darwin_timer_enable_cooperative(void)
+{
+	struct itimerval timer = { };
+	unsigned long long now = (unsigned long long)os_nsecs();
+	int cpu;
+
+	/* ITIMER_REAL is process-directed on Darwin and can remain associated
+	 * with a UML pthread which the guest scheduler has parked.  From this
+	 * point onward the idle path and safe guest/kernel boundaries own the
+	 * monotonic deadline and deliver clock interrupts from a UML kernel
+	 * context.
+	 */
+	setitimer(ITIMER_REAL, &timer, NULL);
+	for (cpu = 0; cpu < CONFIG_NR_CPUS; cpu++)
+		if (cpu_timers[cpu].active)
+			cpu_timers[cpu].deadline_ns = now +
+				cpu_timers[cpu].delay_ns;
+}
+
+static int consume_expired_timer(struct darwin_cpu_timer *state,
+				 unsigned long long now)
+{
+	if (!state->active || now < state->deadline_ns)
+		return 0;
+	if (state->periodic) {
+		do {
+			state->deadline_ns += state->delay_ns;
+		} while (state->deadline_ns <= now);
+	} else {
+		state->active = 0;
+		state->deadline_ns = 0;
+	}
+	return 1;
+}
+
+void darwin_timer_poll(struct uml_pt_regs *registers)
+{
+	struct darwin_cpu_timer *state;
+	unsigned long long now;
+	int cpu;
+
+	darwin_ipi_poll();
+	/* IPI completion may schedule this task on another virtual CPU. */
+	cpu = uml_curr_cpu();
+	state = timer_for_cpu(cpu);
+	if (!darwin_timers_cooperative() || !state->active)
+		return;
+	now = (unsigned long long)os_nsecs();
+	if (consume_expired_timer(state, now)) {
+		int previous = um_set_signals(0);
+
+		/*
+		 * Darwin does not provide Linux-style per-thread SIGIO ownership.
+		 * CPU0 therefore owns host descriptor polling.  Do it at the same
+		 * safe clock boundary while CPU0 is busy as well as from its idle
+		 * path; otherwise a CPU-bound guest can starve console and network
+		 * readiness indefinitely.
+		 */
+		if (cpu == 0)
+			sigio_handler(SIGIO, NULL, registers, NULL);
+		timer_handler(SIGALRM, NULL, registers);
+		um_set_signals(previous);
+	}
+}
+
+/* A pselect() timeout is subject to Darwin timer coalescing, which lets a
+ * one-millisecond wait overrun by about half a millisecond.  A critical
+ * kqueue timer is delivered on time, and the queue is readable once it fires,
+ * so the idle wait keeps pselect() for its atomic signal mask and adds the
+ * queue to its read set.  Returns the descriptor, or -1 to fall back to the
+ * pselect() timeout alone.
+ */
+static int arm_idle_deadline(struct darwin_cpu_timer *state,
+			     unsigned long long remaining)
+{
+	struct kevent timer;
+
+	if (state->deadline_queue < 0)
+		return -1;
+	if (!state->deadline_queue) {
+		int queue = kqueue();
+
+		if (queue < 0 || queue >= FD_SETSIZE) {
+			if (queue >= 0)
+				close(queue);
+			state->deadline_queue = -1;
+			return -1;
+		}
+		(void)os_set_exec_close(queue);
+		state->deadline_queue = queue;
+	}
+	EV_SET(&timer, 0, EVFILT_TIMER, EV_ADD | EV_ONESHOT,
+	       NOTE_NSECONDS | NOTE_CRITICAL, (intptr_t)remaining, NULL);
+	if (kevent(state->deadline_queue, &timer, 1, NULL, 0, NULL) < 0)
+		return -1;
+	return state->deadline_queue;
+}
+
+static void disarm_idle_deadline(struct darwin_cpu_timer *state)
+{
+	static const struct timespec poll_only;
+	struct kevent timer;
+	struct kevent result;
+
+	/* Deleting the knote also discards a delivery nobody collected. */
+	EV_SET(&timer, 0, EVFILT_TIMER, EV_DELETE, 0, 0, NULL);
+	(void)kevent(state->deadline_queue, &timer, 1, &result, 1, &poll_only);
+}
+
+static void add_wake_fd(fd_set *read_fds, int fd)
+{
+	/* Darwin's fortified FD_SET asks libc to validate the backing
+	 * object.  UML kernel stacks are outside a native pthread's
+	 * conventional stack allocation, so that check rejects this valid
+	 * local fd_set and silently leaves it empty.  Callers bound fd by
+	 * FD_SETSIZE, which provides the required safety instead.
+	 */
+	read_fds->fds_bits[(unsigned int)fd /
+		(sizeof(read_fds->fds_bits[0]) * 8)] |=
+		1U << ((unsigned int)fd % (sizeof(read_fds->fds_bits[0]) * 8));
+}
+
+void os_idle_sleep(void)
+{
+	int cpu = uml_curr_cpu();
+	struct darwin_cpu_timer *state = timer_for_cpu(cpu);
+
+	if (!darwin_timers_cooperative()) {
+		pause();
+	} else {
+		sigset_t mask;
+		sigset_t previous_mask;
+		fd_set read_fds;
+		struct uml_pt_regs registers;
+		struct timespec timeout;
+		struct timespec *timeout_pointer = NULL;
+		unsigned long long now;
+		unsigned long long remaining;
+		int ipi_fd;
+		int stop_fd;
+		int deadline_fd = -1;
+		int wake_fd;
+		int fire_timer = 0;
+
+		if (cpu == 0)
+			darwin_irq_idle_begin(&previous_mask);
+		else
+			pthread_sigmask(SIG_SETMASK, NULL, &previous_mask);
+		pthread_sigmask(SIG_SETMASK, NULL, &mask);
+		if (cpu == 0)
+			sigdelset(&mask, SIGUSR2);
+		sigdelset(&mask, DARWIN_IPI_SIGNAL);
+		/* Drain readiness which appeared before the kqueue waiter was
+		 * published.  Any later edge queues SIGUSR2 while it is blocked,
+		 * making the following pselect race-free.
+		 */
+		memset(&registers, 0, sizeof(registers));
+		if (cpu == 0)
+			sigio_handler(SIGIO, NULL, &registers, NULL);
+		if (state->active) {
+			now = (unsigned long long)os_nsecs();
+			remaining = state->deadline_ns > now ?
+				state->deadline_ns - now : 0;
+			timeout.tv_sec = (time_t)(remaining / UM_NSEC_PER_SEC);
+			timeout.tv_nsec = (long)(remaining % UM_NSEC_PER_SEC);
+			timeout_pointer = &timeout;
+			if (remaining)
+				deadline_fd = arm_idle_deadline(state, remaining);
+		}
+		ipi_fd = darwin_ipi_idle_fd();
+		stop_fd = darwin_uml_stop_fd();
+		FD_ZERO(&read_fds);
+		if (ipi_fd >= FD_SETSIZE)
+			panic("Darwin: CPU%d IPI wake fd %d exceeds FD_SETSIZE",
+			      cpu, ipi_fd);
+		if (ipi_fd >= 0)
+			add_wake_fd(&read_fds, ipi_fd);
+		if (stop_fd >= FD_SETSIZE)
+			panic("Darwin: host stop fd %d exceeds FD_SETSIZE", stop_fd);
+		if (stop_fd >= 0)
+			add_wake_fd(&read_fds, stop_fd);
+		if (deadline_fd >= 0)
+			add_wake_fd(&read_fds, deadline_fd);
+		wake_fd = ipi_fd > stop_fd ? ipi_fd : stop_fd;
+		if (deadline_fd > wake_fd)
+			wake_fd = deadline_fd;
+		darwin_ipi_idle_begin();
+		(void)pselect(wake_fd >= 0 ? wake_fd + 1 : 0,
+			      wake_fd >= 0 ? &read_fds : NULL, NULL, NULL,
+			      timeout_pointer, &mask);
+		if (deadline_fd >= 0)
+			disarm_idle_deadline(state);
+		/* Clear before draining.  A sender which observed the idle state has
+		 * already left a pipe byte; a later sender will use the signal wake
+		 * path while this CPU processes the completed wait.
+		 */
+		darwin_ipi_idle_end();
+		now = (unsigned long long)os_nsecs();
+		if (state->active)
+			fire_timer = consume_expired_timer(state, now);
+		if (cpu == 0)
+			darwin_irq_idle_end(&previous_mask);
+		else
+			pthread_sigmask(SIG_SETMASK, &previous_mask, NULL);
+		darwin_host_stop_checkpoint();
+		/* Drain the pipe before the bitmask.  An IPI which races after the
+		 * mask exchange leaves a fresh byte readable for the next idle wait;
+		 * one which races before it is included in this drain.
+		 */
+		darwin_ipi_idle_drain();
+		darwin_ipi_poll();
+		if (fire_timer)
+			timer_handler(SIGALRM, NULL, &registers);
+		/* CPU0 dispatches descriptor IRQs here, from idle kernel context.
+		 * The kqueue notification thread's SIGUSR2 only ends the wait
+		 * above; its handler does no work.
+		 */
+		memset(&registers, 0, sizeof(registers));
+		if (cpu == 0)
+			sigio_handler(SIGIO, NULL, &registers, NULL);
+	}
+}
diff --git a/arch/um/os-Darwin/tty.c b/arch/um/os-Darwin/tty.c
new file mode 100644
index 0000000000000000000000000000000000000000..3c1f9f9b628745ba5efd52112dca7ce899d800a8
--- /dev/null
+++ b/arch/um/os-Darwin/tty.c
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <os.h>
+#include "bridge.h"
+
+int get_pty(void)
+{
+	int fd = darwin_uml_open("/dev/ptmx", O_RDWR, 0);
+
+	if (fd < 0)
+		return -errno;
+	if (grantpt(fd) < 0 || unlockpt(fd) < 0) {
+		int error = -errno;
+		close(fd);
+		return error;
+	}
+	return fd;
+}
diff --git a/arch/um/os-Darwin/umid.c b/arch/um/os-Darwin/umid.c
new file mode 100644
index 0000000000000000000000000000000000000000..ed24b37fa7f66dc49d6245b2d1fad57e1b78d926
--- /dev/null
+++ b/arch/um/os-Darwin/umid.c
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <init.h>
+#include <os.h>
+
+#define UMID_LENGTH 64
+#define UML_DIR_LENGTH 256
+
+static char umid[UMID_LENGTH] = "darwin";
+
+/*
+ * Without uml_dir=, machines share /tmp and each file carries its machine's
+ * umid: /tmp/uml-<umid>-<name>. uml_dir= names a directory that belongs to
+ * this machine alone, and its files go directly into it as <uml_dir>/<name>.
+ * Upstream nests a <umid>/ directory below uml_dir instead, but these files
+ * are Unix sockets, Darwin's sun_path holds 104 bytes, and an iOS
+ * application's own temporary directory already takes 89 of them.
+ */
+static char uml_dir[UML_DIR_LENGTH];
+static int uml_dir_error;
+
+char *get_umid(void)
+{
+	return umid;
+}
+
+int set_umid(char *name)
+{
+	if (name == NULL || name[0] == '\0')
+		return -EINVAL;
+	if (strlcpy(umid, name, sizeof(umid)) >= sizeof(umid))
+		return -ENAMETOOLONG;
+	return 0;
+}
+
+int umid_file_name(char *name, char *buffer, int length)
+{
+	const char *prefix = uml_dir[0] != '\0' ? uml_dir : "/tmp/uml-";
+	const char *separator = uml_dir[0] != '\0' ? "/" : "-";
+	const char *owner = uml_dir[0] != '\0' ? "" : umid;
+	size_t needed = strlen(prefix) + strlen(owner) + strlen(separator) +
+			strlen(name) + 1;
+	size_t used;
+
+	if (uml_dir_error)
+		return uml_dir_error;
+	if (length < 0 || (size_t)length < needed) {
+		printk(UM_KERN_ERR "umid_file_name: %s%s%s%s needs %zu bytes, not %d\n",
+		       prefix, owner, separator, name, needed, length);
+		return -ENAMETOOLONG;
+	}
+	used = strlcpy(buffer, prefix, (size_t)length);
+	used += strlcpy(buffer + used, owner, (size_t)length - used);
+	used += strlcpy(buffer + used, separator, (size_t)length - used);
+	strlcpy(buffer + used, name, (size_t)length - used);
+	return 0;
+}
+
+static int __init set_uml_dir(char *name, int *add)
+{
+	size_t length = strlen(name);
+
+	*add = 0;
+	while (length > 1 && name[length - 1] == '/')
+		length--;
+	if (length == 0) {
+		os_warn("uml_dir can't be an empty string\n");
+		return 0;
+	}
+	if (length >= sizeof(uml_dir)) {
+		/* Falling back to /tmp would put the files where whoever chose
+		 * the directory will not look for them. */
+		os_warn("uml_dir is longer than %zu bytes; this machine gets no management console\n",
+			sizeof(uml_dir) - 1);
+		uml_dir_error = -ENAMETOOLONG;
+		return 0;
+	}
+	memcpy(uml_dir, name, length);
+	uml_dir[length] = '\0';
+	uml_dir_error = 0;
+	return 0;
+}
+
+__uml_setup("uml_dir=", set_uml_dir,
+"uml_dir=<directory>\n"
+"    A directory that belongs to this machine alone. Its files, such as the\n"
+"    management console socket, go directly into it under their own names.\n"
+"    Without it they go to /tmp, named after the umid.\n\n"
+);
diff --git a/arch/um/os-Darwin/util.c b/arch/um/os-Darwin/util.c
new file mode 100644
index 0000000000000000000000000000000000000000..e12528a48f14503a7e36dbaf112ba9c15f0c45b1
--- /dev/null
+++ b/arch/um/os-Darwin/util.c
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/random.h>
+#include <sys/utsname.h>
+#include <termios.h>
+#include <unistd.h>
+#include <init.h>
+#include <os.h>
+#include "bridge.h"
+
+int vscnprintf(char *buffer, size_t size, const char *format, va_list args);
+
+void stack_protections(unsigned long address)
+{
+	if (mprotect((void *)address, UM_THREAD_SIZE,
+		     PROT_READ | PROT_WRITE) < 0)
+		panic("protecting stack failed, errno = %d", errno);
+}
+
+unsigned long os_current_thread_stack_top(void)
+{
+	return (unsigned long)pthread_get_stackaddr_np(pthread_self());
+}
+
+/*
+ * A terminal applies output processing as each byte is written, so the mode
+ * changes at once.  Draining first would hold the open of a line until its
+ * host reader had read everything queued, and a signal without SA_RESTART,
+ * such as an IPI, would end that wait with EINTR and fail the open.
+ */
+int raw(int fd)
+{
+	struct termios terminal;
+	int err;
+
+	CATCH_EINTR(err = tcgetattr(fd, &terminal));
+	if (err < 0)
+		return -errno;
+	cfmakeraw(&terminal);
+	CATCH_EINTR(err = tcsetattr(fd, TCSANOW, &terminal));
+	if (err < 0)
+		return -errno;
+	return 0;
+}
+
+void setup_machinename(char *machine_out)
+{
+	memcpy(machine_out, "aarch64", sizeof("aarch64"));
+}
+
+void setup_hostinfo(char *buffer, int length)
+{
+	struct utsname host;
+	int used;
+
+	if (length <= 0)
+		return;
+	if (uname(&host) < 0) {
+		buffer[0] = '\0';
+		return;
+	}
+	used = strlcpy(buffer, host.sysname, (size_t)length);
+	if (used < length - 1)
+		used += strlcpy(buffer + used, " ", (size_t)(length - used));
+	if (used < length - 1)
+		strlcpy(buffer + used, host.release, (size_t)(length - used));
+}
+
+ssize_t os_getrandom(void *buffer, size_t length, unsigned int flags)
+{
+	(void)flags;
+	if (getentropy(buffer, length) == 0)
+		return (ssize_t)length;
+	return -1;
+}
+
+void os_dump_core(void)
+{
+	darwin_uml_abort();
+}
+
+void um_early_printk(const char *string, unsigned int length)
+{
+	(void)write(STDERR_FILENO, string, length);
+}
+
+static int quiet_info;
+
+static int quiet_cmd_param(char *string, int *add)
+{
+	(void)string;
+	(void)add;
+	quiet_info = 1;
+	return 0;
+}
+
+__uml_setup("quiet", quiet_cmd_param,
+"quiet\n"
+"    Turns off host information messages during boot.\n\n");
+
+static void host_message(int fd, const char *format, va_list args)
+{
+	char buffer[512];
+	int length = vscnprintf(buffer, sizeof(buffer), format, args);
+
+	if (length > 0)
+		(void)write(fd, buffer, (size_t)length);
+}
+
+void os_info(const char *format, ...)
+{
+	va_list args;
+
+	if (quiet_info)
+		return;
+	va_start(args, format);
+	host_message(STDERR_FILENO, format, args);
+	va_end(args);
+}
+
+void os_warn(const char *format, ...)
+{
+	va_list args;
+
+	va_start(args, format);
+	host_message(STDERR_FILENO, format, args);
+	va_end(args);
+}
