+static bool user_walk_begin(struct user_walk *walk, struct mm_struct *mm,
+			    bool may_sleep)
+{
+	walk->mm = mm;
+	/*
+	 * Atomic uaccess callers can already hold a futex hash-bucket lock.  A
+	 * blocking mmap lock acquisition would let UML schedule the Linux task
