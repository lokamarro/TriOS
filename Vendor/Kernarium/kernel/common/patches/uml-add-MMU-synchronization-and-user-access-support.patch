+/**
+ * pin_folio_from_locked_pte() - FOLL_PIN a folio that a locked PTE maps.
+ * @mm:    the mm whose page table maps @folio
+ * @folio: the folio a present PTE of @mm maps
+ *
+ * The caller holds that PTE's lock, so fork(), which copies the PTE under the
+ * same lock, sees the pin and gives the child a copy of an exclusive
+ * anonymous page instead of sharing it.  An architecture whose uaccess writes
+ * a user page through the kernel's alias of it, after the PTE lock is gone,
+ * needs that so its write cannot reach a child forked meanwhile.
+ *
+ * The pin lasts for one access, so unlike a GUP pin it is not counted in
+ * nr_foll_pin_acquired: that node statistic disables interrupts on an
+ * architecture without a local cmpxchg.  Release it with
+ * unpin_folio_from_locked_pte().
+ *
+ * Return: 0, or -ENOMEM if @folio has no reference to add to.
+ */
+int pin_folio_from_locked_pte(struct mm_struct *mm, struct folio *folio)
+{
+	if (WARN_ON_ONCE(folio_ref_count(folio) <= 0))
+		return -ENOMEM;
+	if (is_zero_folio(folio))
+		return 0;
+	mm_set_has_pinned_flag(mm);
+	if (folio_has_pincount(folio)) {
+		folio_ref_inc(folio);
+		atomic_inc(&folio->_pincount);
+	} else {
+		folio_ref_add(folio, GUP_PIN_COUNTING_BIAS);
+	}
+	return 0;
+}
+
+/* Release a pin_folio_from_locked_pte() pin. */
+void unpin_folio_from_locked_pte(struct folio *folio)
+{
+	if (is_zero_folio(folio))
+		return;
+	if (folio_has_pincount(folio)) {
+		atomic_dec(&folio->_pincount);
+		folio_put(folio);
+	} else {
+		folio_put_refs(folio, GUP_PIN_COUNTING_BIAS);
+	}
+}
