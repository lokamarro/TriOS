 {
-	stack_protections((unsigned long) &cpu0_irqstack);
-	set_sigstack(cpu0_irqstack, THREAD_SIZE);
+	stack_protections((unsigned long) &cpu_irqstacks[0]);
+#ifndef UML_HOST_DARWIN
+	set_sigstack(cpu_irqstacks[0], THREAD_SIZE);
+#endif
 
 	init_new_thread_signals();
 
@@ -57,10 +62,87 @@ struct mm_id *current_mm_id(void)
 	return &current->mm->context.id;
 }
 
+unsigned long current_tls(void)
+{
+	return current->thread.arch.tpidr_el0;
+}
+
+void current_set_tls(unsigned long tls)
+{
+	current->thread.arch.tpidr_el0 = tls;
+}
+
+static DEFINE_SPINLOCK(initial_jmpbuf_spinlock);
+
+void initial_jmpbuf_lock(void)
+{
+	spin_lock_irq(&initial_jmpbuf_spinlock);
+}
+
+void initial_jmpbuf_unlock(void)
+{
+	spin_unlock_irq(&initial_jmpbuf_spinlock);
+}
+
 void current_mm_sync(void)
 {
+	struct mm_struct *mm;
+
 	if (current->mm == NULL)
 		return;
+	mm = current->mm;
+#ifdef UML_HOST_DARWIN
+	/* mmap_read_lock() may schedule while a writer owns the VMA tree.  Take it
+	 * before the per-mm turnstile so a scheduled-out UML task never retains
+	 * the mutex needed by the sibling selected to run.  Mapping replay itself
+	 * remains serialized, while guest execution remains fully concurrent.
+	 * Most guest exits do not change any PTE.  Check the protected pending
+	 * range first so those exits do not contend on either shared lock.  A
+	 * range queued after this check belongs to an update still in progress;
+	 * that updating task synchronizes it before returning to userspace.
+	 */
+	if (!um_tlb_sync_pending(mm))
+		return;
+	mmap_read_lock(mm);
+	enter_turnstile(&mm->context.id);
+	um_tlb_sync_locked(mm);
+	exit_turnstile(&mm->context.id);
+	mmap_read_unlock(mm);
+#else
+	um_tlb_sync(mm);
+#endif
+}
 
-	um_tlb_sync(current->mm);
+void current_mm_force_sync(unsigned long address)
+{
+	struct mm_struct *mm;
+	unsigned long page;
+
+	if (current->mm == NULL)
+		return;
+	mm = current->mm;
+	page = address & PAGE_MASK;
+#ifdef UML_HOST_DARWIN
+	mmap_read_lock(mm);
+	enter_turnstile(&mm->context.id);
+	um_tlb_mark_sync(mm, page, page + PAGE_SIZE);
+	um_tlb_sync_locked(mm);
+	exit_turnstile(&mm->context.id);
+	mmap_read_unlock(mm);
+#else
+	um_tlb_mark_sync(mm, page, page + PAGE_SIZE);
+	um_tlb_sync(mm);
+#endif
+}
+
+int current_mm_prefault_host_slot(unsigned long address, int is_write)
+{
+	if (current->mm == NULL)
+		return 0;
+	/* Userspace execution goes through the static MMU at Linux base-page
+	 * granularity. The fault handler has already resolved the addressed page;
+	 * synchronize only it so demand paging and MLOCK_ONFAULT remain observable.
+	 */
+	current_mm_force_sync(address);
+	return 0;
 }
