diff --git a/arch/arm64/um/ptrace.c b/arch/arm64/um/ptrace.c
new file mode 100644
index 0000000000000000000000000000000000000000..52e976dc7f84880c40d4616989f8eea484a7c172
--- /dev/null
+++ b/arch/arm64/um/ptrace.c
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/bits.h>
+#include <linux/elf.h>
+#include <linux/regset.h>
+#include <linux/sched.h>
+#include <linux/uaccess.h>
+#include <asm/ptrace.h>
+#include <asm/user.h>
+
+static int register_index(int regno)
+{
+	if (regno < 0 || regno >= UM_FRAME_SIZE ||
+	    (regno & (sizeof(unsigned long) - 1)))
+		return -EINVAL;
+	return regno / sizeof(unsigned long);
+}
+
+unsigned long getreg(struct task_struct *child, int regno)
+{
+	int index = register_index(regno);
+
+	if (index < 0)
+		return 0;
+	return child->thread.regs.regs.gp[index];
+}
+
+/*
+ * Native arm64 clears these bits from a PSTATE that a signal frame or a tracer
+ * supplies (SPSR_EL1_AARCH64_RES0_BITS).  SS is not the task's either:
+ * begin_guest_step() sets it for the one entry that PTRACE_SINGLESTEP asks
+ * for, and the engine steps on it whenever it is set.
+ */
+#define UML_ARM64_PSTATE_RES0 \
+	(GENMASK_ULL(63, 32) | GENMASK_ULL(27, 26) | GENMASK_ULL(23, 22) | \
+	 GENMASK_ULL(20, 13) | BIT_ULL(5))
+#define UML_ARM64_PSTATE_SS		BIT_ULL(21)
+#define UML_ARM64_PSTATE_NZCV		GENMASK_ULL(31, 28)
+/* EL0t in AArch64 state has M[4:0] zero, and EL0 cannot mask D, A, I or F. */
+#define UML_ARM64_PSTATE_MODE_DAIF	(GENMASK_ULL(9, 6) | GENMASK_ULL(4, 0))
+
+/*
+ * Keep the bits of a user-supplied PSTATE that userspace owns: NZCV, TCO, DIT,
+ * SSBS and BTYPE.  A mode or DAIF bit makes it invalid; like native
+ * valid_user_regs(), reduce it to NZCV and report that, so rt_sigreturn raises
+ * SIGSEGV and a tracer's register write fails with -EINVAL.
+ */
+bool uml_arm64_valid_user_pstate(unsigned long *pstate)
+{
+	*pstate &= ~(UML_ARM64_PSTATE_RES0 | UML_ARM64_PSTATE_SS);
+	if (!(*pstate & UML_ARM64_PSTATE_MODE_DAIF))
+		return true;
+	*pstate &= UML_ARM64_PSTATE_NZCV;
+	return false;
+}
+
+int putreg(struct task_struct *child, int regno, unsigned long value)
+{
+	int index = register_index(regno);
+
+	if (index < 0)
+		return index;
+	if (index == HOST_PSTATE && !uml_arm64_valid_user_pstate(&value))
+		return -EINVAL;
+	child->thread.regs.regs.gp[index] = value;
+	return 0;
+}
+
+int peek_user(struct task_struct *child, long addr, long data)
+{
+	unsigned long value;
+
+	if (register_index(addr) < 0)
+		return -EIO;
+	value = getreg(child, addr);
+	return put_user(value, (unsigned long __user *)data);
+}
+
+int poke_user(struct task_struct *child, long addr, long data)
+{
+	if (register_index(addr) < 0)
+		return -EIO;
+	return putreg(child, addr, data);
+}
+
+long subarch_ptrace(struct task_struct *child, long request,
+		    unsigned long addr, unsigned long data)
+{
+	return -EIO;
+}
+
+static int genregs_get(struct task_struct *target,
+		       const struct user_regset *regset, struct membuf to)
+{
+	membuf_write(&to, target->thread.regs.regs.gp,
+		     sizeof(struct user_regs_struct));
+	return 0;
+}
+
+static int genregs_set(struct task_struct *target,
+		       const struct user_regset *regset,
+		       unsigned int pos, unsigned int count,
+		       const void *kbuf, const void __user *ubuf)
+{
+	unsigned long regs[sizeof(struct user_regs_struct) /
+			   sizeof(unsigned long)];
+	int ret;
+
+	memcpy(regs, target->thread.regs.regs.gp, sizeof(regs));
+	ret = user_regset_copyin(&pos, &count, &kbuf, &ubuf, regs, 0,
+				 sizeof(regs));
+	if (ret)
+		return ret;
+	if (!uml_arm64_valid_user_pstate(&regs[HOST_PSTATE]))
+		return -EINVAL;
+	memcpy(target->thread.regs.regs.gp, regs, sizeof(regs));
+	return 0;
+}
+
+static int fpregs_get(struct task_struct *target,
+		      const struct user_regset *regset, struct membuf to)
+{
+	membuf_write(&to, target->thread.regs.regs.fp, host_fp_size);
+	return 0;
+}
+
+static int fpregs_set(struct task_struct *target,
+		      const struct user_regset *regset,
+		      unsigned int pos, unsigned int count,
+		      const void *kbuf, const void __user *ubuf)
+{
+	return user_regset_copyin(&pos, &count, &kbuf, &ubuf,
+		target->thread.regs.regs.fp, 0, host_fp_size);
+}
+
+static const struct user_regset uml_arm64_regsets[] = {
+	[REGSET_GENERAL] = {
+		USER_REGSET_NOTE_TYPE(PRSTATUS),
+		.n = sizeof(struct user_regs_struct) / sizeof(unsigned long),
+		.size = sizeof(unsigned long),
+		.align = sizeof(unsigned long),
+		.regset_get = genregs_get,
+		.set = genregs_set,
+	},
+	[REGSET_FP] = {
+		USER_REGSET_NOTE_TYPE(PRFPREG),
+		.n = sizeof(elf_fpregset_t) / sizeof(unsigned long),
+		.size = sizeof(unsigned long),
+		.align = sizeof(unsigned long),
+		.regset_get = fpregs_get,
+		.set = fpregs_set,
+	},
+};
+
+static const struct user_regset_view uml_arm64_view = {
+	.name = "aarch64",
+	.e_machine = EM_AARCH64,
+	.regsets = uml_arm64_regsets,
+	.n = ARRAY_SIZE(uml_arm64_regsets),
+};
+
+const struct user_regset_view *
+task_user_regset_view(struct task_struct *task)
+{
+	return &uml_arm64_view;
+}
diff --git a/arch/arm64/um/registers.c b/arch/arm64/um/registers.c
