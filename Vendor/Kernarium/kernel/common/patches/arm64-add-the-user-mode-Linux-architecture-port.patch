@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/elf.h>
+#include <linux/string.h>
+#include <longjmp.h>
+#include <registers.h>
+
+unsigned long host_fp_size = sizeof(elf_fpregset_t);
+
+int arch_init_registers(int pid)
+{
+	host_fp_size = sizeof(elf_fpregset_t);
+	return 0;
+}
+
+int get_fp_registers(int pid, unsigned long *regs)
+{
+	memset(regs, 0, host_fp_size);
+	return 0;
+}
+
+int put_fp_registers(int pid, unsigned long *regs)
+{
+	return 0;
+}
+
+void get_safe_registers(unsigned long *regs, unsigned long *fp_regs)
+{
+	memset(regs, 0, UM_FRAME_SIZE);
+	if (fp_regs)
+		memset(fp_regs, 0, host_fp_size);
+}
+
+int init_pid_registers(int pid)
+{
+	return arch_init_registers(pid);
+}
+
+unsigned long get_thread_reg(int reg, jmp_buf *buf)
+{
+	switch (reg) {
+	case HOST_IP:
+		return (*buf)[0].pc;
+	case HOST_SP:
+		return (*buf)[0].sp;
+	case HOST_FP:
+		return (*buf)[0].fp;
+	default:
+		return 0;
+	}
+}
diff --git a/arch/arm64/um/setjmp.S b/arch/arm64/um/setjmp.S
new file mode 100644
index 0000000000000000000000000000000000000000..62840a35a68e46c0ad075e87ce34416f190f6ffc
--- /dev/null
+++ b/arch/arm64/um/setjmp.S
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * The UML jmp_buf saves AAPCS64 callee-saved registers followed by fp, lr,
+ * sp, and the continuation PC.  Keep this layout in sync with
+ * shared/sysdep/archsetjmp.h; the C declarations are renamed by arch/um's
+ * KBUILD_CFLAGS so these never collide with libc's setjmp/longjmp.
+ */
+#ifdef __APPLE__
+#define UML_C_SYMBOL(name) _ ## name
+#else
+#define UML_C_SYMBOL(name) name
+#endif
+
+	.text
+	.p2align 2
+	.globl UML_C_SYMBOL(kernel_setjmp)
+UML_C_SYMBOL(kernel_setjmp):
+	stp	x19, x20, [x0, #0]
+	stp	x21, x22, [x0, #16]
+	stp	x23, x24, [x0, #32]
+	stp	x25, x26, [x0, #48]
+	stp	x27, x28, [x0, #64]
+	stp	x29, x30, [x0, #80]
+	mov	x1, sp
+	str	x1, [x0, #96]
+	str	x30, [x0, #104]
+	mov	w0, wzr
+	ret
+
+	.p2align 2
+	.globl UML_C_SYMBOL(kernel_longjmp)
+UML_C_SYMBOL(kernel_longjmp):
+	ldp	x19, x20, [x0, #0]
+	ldp	x21, x22, [x0, #16]
+	ldp	x23, x24, [x0, #32]
+	ldp	x25, x26, [x0, #48]
+	ldp	x27, x28, [x0, #64]
+	ldp	x29, x30, [x0, #80]
+	ldr	x16, [x0, #104]
+	ldr	x17, [x0, #96]
+	mov	sp, x17
+	mov	w0, w1
+	br	x16
