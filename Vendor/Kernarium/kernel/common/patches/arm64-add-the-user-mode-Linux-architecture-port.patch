diff --git a/arch/arm64/um/shared/sysdep/faultinfo.h b/arch/arm64/um/shared/sysdep/faultinfo.h
new file mode 100644
index 0000000000000000000000000000000000000000..46a97ca78c94bf3dd7d2658becfb68260512d833
--- /dev/null
+++ b/arch/arm64/um/shared/sysdep/faultinfo.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _SYSDEP_UM_ARM64_FAULTINFO_H
+#define _SYSDEP_UM_ARM64_FAULTINFO_H
+
+struct faultinfo {
+	int error_code;
+	unsigned long cr2;
+	int trap_no;
+};
+
+#define UML_ARM64_FAULT_WRITE 2
+#define UML_ARM64_FAULT_EXECUTE 16
+#define UML_ARM64_FAULT_PAGE 14
+
+#define FAULT_WRITE(fi) ((fi).error_code & UML_ARM64_FAULT_WRITE)
+#define FAULT_EXECUTE(fi) ((fi).error_code & UML_ARM64_FAULT_EXECUTE)
+#define FAULT_ADDRESS(fi) ((fi).cr2)
+#define SEGV_IS_FIXABLE(fi) ((fi)->trap_no == UML_ARM64_FAULT_PAGE)
+#define PTRACE_FULL_FAULTINFO 1
+
+/*
+ * Record where a faulting nofault access resumes, with faulted set.  Only the
+ * fault handler reaches that point, so it is defined in assembly: a C label
+ * whose sole use is its address is dead code to the compiler, which deletes it
+ * and records the constant 1 instead.
+ */
+#define ___backtrack_faulted(faulted) do { \
+	unsigned long __uml_resume; \
+	asm volatile( \
+		"	mov	%w0, #0\n" \
+		"	adr	%1, 1f\n" \
+		"	str	%1, %2\n" \
+		"	b	2f\n" \
+		"1:	mov	%w0, #1\n" \
+		"2:\n" \
+		: "=&r" (faulted), "=&r" (__uml_resume), \
+		  "=m" (current->thread.segv_continue) \
+		: : "memory"); \
+} while (0)
+
+#endif
