+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/sched.h>
+#include <asm/ptrace.h>
+
+void show_regs(struct pt_regs *regs)
+{
+	int index;
+
+	printk(KERN_INFO "PC: %016lx SP: %016lx PSTATE: %08lx\n",
+	       PT_REGS_IP(regs), PT_REGS_SP(regs), PT_REGS_PSTATE(regs));
+	for (index = 0; index < 31; index += 2)
+		printk(KERN_INFO "X%-2d: %016lx X%-2d: %016lx\n",
+		       index, PT_REGS_X(regs, index), index + 1,
+		       index + 1 < 31 ? PT_REGS_X(regs, index + 1) : 0UL);
+}
diff --git a/arch/arm64/um/tls.c b/arch/arm64/um/tls.c
new file mode 100644
index 0000000000000000000000000000000000000000..0bc12342ef6b089a8f3622bc774757f3c2be8970
--- /dev/null
+++ b/arch/arm64/um/tls.c
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/sched.h>
+
+void clear_flushed_tls(struct task_struct *task)
+{
+	/* arm64 has no lazily flushed TLS descriptor table.  The value copied
+	 * by arch_copy_thread() is the child's inherited TPIDR_EL0 and must
+	 * survive clone/vfork when CLONE_SETTLS is not requested.
+	 */
+	(void)task;
+}
+
+int arch_set_tls(struct task_struct *task, unsigned long tls)
+{
+	task->thread.arch.tpidr_el0 = tls;
+	return 0;
+}
+
+void arch_switch_to(struct task_struct *task)
+{
+}
