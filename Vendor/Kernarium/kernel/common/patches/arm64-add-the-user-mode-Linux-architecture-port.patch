diff --git a/arch/arm64/um/asm/elf.h b/arch/arm64/um/asm/elf.h
new file mode 100644
index 0000000000000000000000000000000000000000..baaa7c8c27de70be2f0513cc137f7bf645fa19ab
--- /dev/null
+++ b/arch/arm64/um/asm/elf.h
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_UM_ARM64_ELF_H
+#define _ASM_UM_ARM64_ELF_H
+
+#include <asm/user.h>
+#include <asm/ptrace.h>
+#include <uapi/asm/hwcap.h>
+#include <uapi/linux/elf.h>
+
+#define CORE_DUMP_USE_REGSET
+
+#define R_AARCH64_NONE 0
+#define R_AARCH64_ABS64 257
+#define R_AARCH64_ABS32 258
+#define R_AARCH64_PREL64 260
+#define R_AARCH64_PREL32 261
+#define R_AARCH64_ADR_PREL_PG_HI21 275
+#define R_AARCH64_ADD_ABS_LO12_NC 277
+#define R_AARCH64_JUMP26 282
+#define R_AARCH64_CALL26 283
+#define R_AARCH64_RELATIVE 1027
+
+#define ELF_CLASS ELFCLASS64
+#define ELF_DATA ELFDATA2LSB
+#define ELF_ARCH EM_AARCH64
+#define ELF_PLATFORM "aarch64"
+/*
+ * Obtain the virtual CPU profile after the host CLI has selected an execution
+ * engine.  The backend deliberately reports only extensions implemented by
+ * every path selected for that engine; it never copies an unchecked host mask
+ * into the guest auxiliary vector.
+ */
+#ifdef UML_HOST_DARWIN
+extern unsigned long darwin_uml_guest_hwcap(void);
+extern unsigned long darwin_uml_guest_hwcap2(void);
+#define ELF_HWCAP darwin_uml_guest_hwcap()
+#define ELF_HWCAP2 darwin_uml_guest_hwcap2()
+#else
+#define ELF_HWCAP (HWCAP_FP | HWCAP_ASIMD)
+#define ELF_HWCAP2 0
+#endif
+#define ELF_EXEC_PAGESIZE PAGE_SIZE
+#define ELF_ET_DYN_BASE (TASK_SIZE * 2 / 3)
+#define STACK_RND_MASK (0x3ffff >> (PAGE_SHIFT - 12))
+
+#define elf_check_arch(header) ((header)->e_machine == EM_AARCH64)
+
+#define ELF_PLAT_INIT(regs, load_address) do { \
+	PT_REGS_X((regs), 0) = 0; \
+} while (0)
+
+#define SET_PERSONALITY(executable) do { \
+	current->personality &= ~READ_IMPLIES_EXEC; \
+} while (0)
+
+typedef unsigned long elf_greg_t;
+#define ELF_NGREG 34
+typedef elf_greg_t elf_gregset_t[ELF_NGREG];
+
+struct uml_arm64_fpsimd_state {
+	unsigned __int128 vregs[32];
+	unsigned int fpsr;
+	unsigned int fpcr;
+};
+typedef struct uml_arm64_fpsimd_state elf_fpregset_t;
+
+#define ELF_CORE_COPY_REGS(destination, source) do { \
+	int register_index; \
+	for (register_index = 0; register_index < 31; register_index++) \
+		(destination)[register_index] = PT_REGS_X((source), register_index); \
+	(destination)[31] = PT_REGS_SP(source); \
+	(destination)[32] = PT_REGS_IP(source); \
+	(destination)[33] = PT_REGS_PSTATE(source); \
+} while (0);
+
+#define FIXADDR_USER_START 0
+#define FIXADDR_USER_END 0
+
+#ifdef UML_HOST_DARWIN
+/* Maps the page that holds the sigreturn trampoline (signal.c). */
+#define ARCH_HAS_SETUP_ADDITIONAL_PAGES 1
+struct linux_binprm;
+extern int arch_setup_additional_pages(struct linux_binprm *bprm,
+				       int uses_interp);
+#endif
+
+#endif
diff --git a/arch/arm64/um/asm/lse.h b/arch/arm64/um/asm/lse.h
new file mode 100644
index 0000000000000000000000000000000000000000..5d6357244e7d09b12c64584d348ad40057a4af82
--- /dev/null
+++ b/arch/arm64/um/asm/lse.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_UM_ARM64_LSE_H
+#define __ASM_UM_ARM64_LSE_H
+
+#include <asm/atomic_ll_sc.h>
+
+/*
+ * Darwin arm64 UML runs kernel code directly on the host CPU.  All supported
+ * Apple-silicon hosts provide the Armv8.1 large-system atomic instructions,
+ * and the frontend verifies that capability before launching the kernel.
+ *
+ * Prefer those single-instruction operations here.  LL/SC loops can lose
+ * their reservation whenever a Darwin signal frame runs and can consequently
+ * make no forward progress under highly contended SMP kernel workloads.  The
+ * normal arm64 alternative patching machinery is not initialized by UML, so
+ * select the already-provided LSE implementations at compile time instead.
+ */
+#ifdef UML_HOST_DARWIN
+
+#define __LSE_PREAMBLE	".arch_extension lse\n"
+
+#include <linux/compiler_types.h>
+#include <asm/atomic_lse.h>
+
+#ifndef __nops
+#define __nops(n) ".rept " #n "\nnop\n.endr\n"
+#endif
+
+#define __lse_ll_sc_body(op, ...) __lse_##op(__VA_ARGS__)
+#define ARM64_LSE_ATOMIC_INSN(llsc, lse) __LSE_PREAMBLE lse
+
+#elif defined(CONFIG_ARM64_LSE_ATOMICS)
+
+#define __LSE_PREAMBLE	".arch_extension lse\n"
+
+#include <linux/compiler_types.h>
+#include <linux/export.h>
+#include <linux/stringify.h>
+#include <asm/alternative.h>
+#include <asm/alternative-macros.h>
+#include <asm/atomic_lse.h>
+#include <asm/cpucaps.h>
+
+#define __lse_ll_sc_body(op, ...)					\
+({									\
+	alternative_has_cap_likely(ARM64_HAS_LSE_ATOMICS) ?		\
+		__lse_##op(__VA_ARGS__) :				\
+		__ll_sc_##op(__VA_ARGS__);				\
+})
+
+#define ARM64_LSE_ATOMIC_INSN(llsc, lse)				\
+	ALTERNATIVE(llsc, __LSE_PREAMBLE lse, ARM64_HAS_LSE_ATOMICS)
+
+#else
+
+#define __lse_ll_sc_body(op, ...) __ll_sc_##op(__VA_ARGS__)
+#define ARM64_LSE_ATOMIC_INSN(llsc, lse) llsc
+
+#endif
+
+#endif /* __ASM_UM_ARM64_LSE_H */
