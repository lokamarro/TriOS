diff --git a/arch/arm64/Makefile.um b/arch/arm64/Makefile.um
new file mode 100644
index 0000000000000000000000000000000000000000..ecf8bbeb93d1b784561f0d9457af06be4699f5d9
--- /dev/null
+++ b/arch/arm64/Makefile.um
@@ -0,0 +1,64 @@
+# SPDX-License-Identifier: GPL-2.0
+
+# Keep native kernel mappings disjoint from the software guest task range.
+# iOS processes with Extended Virtual Addressing have a much smaller host VM
+# ceiling than macOS. Their shared device/Simulator embedded kernel is linked
+# at the bottom of a relocatable signed envelope below 62 GiB.
+UML_DARWIN_ADDRESS_SPACE ?= standard
+ifeq ($(UML_DARWIN_ADDRESS_SPACE),standard)
+START := 0x600000000000
+UML_DARWIN_TASK_SIZE := 0x400000000000UL
+UML_DARWIN_GUEST_ADDRESS_LIMIT := 0x600000000000UL
+UML_DARWIN_HOST_TASK_SIZE := 0x700000000000UL
+UML_DARWIN_TASK_UNMAPPED_BASE := 0x100000000000UL
+UML_DARWIN_NATIVE_ADDRESS_START := 0x600000000000UL
+UML_DARWIN_NATIVE_ADDRESS_END := 0x600000000000UL
+UML_DARWIN_NATIVE_AUXILIARY_SIZE := 0x0UL
+UML_DARWIN_DYNAMIC_NATIVE_LAYOUT := 0
+UML_DARWIN_SIGRETURN_TRAMPOLINE := 0x3fffffffff00ULL
+UML_DARWIN_ALIGN_TASK_SIZE_TO_PGDIR := 1
+else ifeq ($(UML_DARWIN_ADDRESS_SPACE),ios-device)
+START := 0xc00000000
+UML_DARWIN_TASK_SIZE := 0x800000000000UL
+UML_DARWIN_GUEST_ADDRESS_LIMIT := 0x800000000000UL
+UML_DARWIN_HOST_TASK_SIZE := 0xf80000000UL
+UML_DARWIN_TASK_UNMAPPED_BASE := 0x1000000000UL
+UML_DARWIN_NATIVE_ADDRESS_START := 0xc00000000UL
+UML_DARWIN_NATIVE_ADDRESS_END := 0xf80000000UL
+UML_DARWIN_NATIVE_AUXILIARY_SIZE := 0x100000000UL
+UML_DARWIN_DYNAMIC_NATIVE_LAYOUT := 1
+UML_DARWIN_SIGRETURN_TRAMPOLINE := 0x7fffffffff00ULL
+UML_DARWIN_ALIGN_TASK_SIZE_TO_PGDIR := 1
+else
+$(error unsupported UML_DARWIN_ADDRESS_SPACE=$(UML_DARWIN_ADDRESS_SPACE))
+endif
+
+KBUILD_CFLAGS += \
+	-DUML_DARWIN_TASK_SIZE=$(UML_DARWIN_TASK_SIZE) \
+	-DUML_DARWIN_GUEST_ADDRESS_LIMIT=$(UML_DARWIN_GUEST_ADDRESS_LIMIT) \
+	-DUML_DARWIN_HOST_TASK_SIZE=$(UML_DARWIN_HOST_TASK_SIZE) \
+	-DUML_DARWIN_TASK_UNMAPPED_BASE=$(UML_DARWIN_TASK_UNMAPPED_BASE) \
+	-DUML_DARWIN_NATIVE_ADDRESS_START=$(UML_DARWIN_NATIVE_ADDRESS_START) \
+	-DUML_DARWIN_NATIVE_ADDRESS_END=$(UML_DARWIN_NATIVE_ADDRESS_END) \
+	-DUML_DARWIN_NATIVE_AUXILIARY_SIZE=$(UML_DARWIN_NATIVE_AUXILIARY_SIZE) \
+	-DUML_DARWIN_DYNAMIC_NATIVE_LAYOUT=$(UML_DARWIN_DYNAMIC_NATIVE_LAYOUT) \
+	-DDARWIN_UML_SIGRETURN_TRAMPOLINE=$(UML_DARWIN_SIGRETURN_TRAMPOLINE) \
+	-DUML_DARWIN_ALIGN_TASK_SIZE_TO_PGDIR=$(UML_DARWIN_ALIGN_TASK_SIZE_TO_PGDIR)
+
+# The embedded ELF must be relocatable so its Darwin imports can be fixed up
+# by the Mach-O launcher.  The image itself is much smaller than the small
+# model's +/- 4 GiB reach; its preferred high VA is reserved by the loader.
+KBUILD_CFLAGS := $(filter-out -mcmodel=large,$(KBUILD_CFLAGS))
+KBUILD_CFLAGS += -fno-builtin -mgeneral-regs-only -fPIC -mcmodel=small
+KBUILD_AFLAGS += -mgeneral-regs-only
+CHECKFLAGS += -D__aarch64__
+
+KBUILD_LDFLAGS += -m aarch64elf
+ELF_ARCH := aarch64
+ELF_FORMAT := elf64-littleaarch64
+
+ifeq ($(UML_HOST_OS),Darwin)
+LINK-y += --target=aarch64-unknown-linux-gnu -nostdlib -shared -fuse-ld=lld \
+	-Wl,-Bsymbolic,-z,notext -Wl,--unresolved-symbols=ignore-all \
+	-Wl,-e,main
+endif
