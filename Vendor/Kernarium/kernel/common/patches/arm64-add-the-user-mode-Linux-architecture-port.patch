diff --git a/arch/arm64/um/asm/processor.h b/arch/arm64/um/asm/processor.h
new file mode 100644
index 0000000000000000000000000000000000000000..6fd6da6c5816a452cec29b2cc4fe7605845236ad
--- /dev/null
+++ b/arch/arm64/um/asm/processor.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_UM_ARM64_PROCESSOR_H
+#define _ASM_UM_ARM64_PROCESSOR_H
+
+#define STACKSLOTS_PER_LINE 4
+
+#include <linux/time-internal.h>
+#include <sysdep/faultinfo.h>
+
+struct arch_thread {
+	unsigned long tpidr_el0;
+	void *darwin_task;
+	struct faultinfo faultinfo;
+};
+
+#define INIT_ARCH_THREAD { .tpidr_el0 = 0, .darwin_task = NULL, \
+	.faultinfo = { 0, 0, 0 } }
+
+static inline void arch_flush_thread(struct arch_thread *thread)
+{
+	thread->tpidr_el0 = 0;
+}
+
+static inline void arch_copy_thread(struct arch_thread *from,
+			    struct arch_thread *to)
+{
+	to->tpidr_el0 = from->tpidr_el0;
+}
+
+#define current_sp() ({ void *sp; asm("mov %0, sp" : "=r"(sp)); sp; })
+#define current_bp() ({ unsigned long fp; asm("mov %0, x29" : "=r"(fp)); fp; })
+
+/* Seccomp exposes KSTK_EIP as si_call_addr, so use the guest user PC. */
+#define KSTK_EIP(task) UPT_IP(&(task)->thread.regs.regs)
+#define KSTK_ESP(task) KSTK_REG(task, HOST_SP)
+#define KSTK_EBP(task) KSTK_REG(task, HOST_FP)
+
+#ifdef UML_HOST_DARWIN
+void darwin_cpu_relax(void);
+#endif
+
+static __always_inline void cpu_relax(void)
+{
+	if (time_travel_mode == TT_MODE_INFCPU ||
+	    time_travel_mode == TT_MODE_EXTERNAL)
+		time_travel_ndelay(1);
+#ifdef UML_HOST_DARWIN
+	else
+		darwin_cpu_relax();
+#else
+	else
+		asm volatile("yield" : : : "memory");
+#endif
+}
+
+#define task_pt_regs(task) (&(task)->thread.regs)
+
+#include <asm/processor-generic.h>
+
+#endif
