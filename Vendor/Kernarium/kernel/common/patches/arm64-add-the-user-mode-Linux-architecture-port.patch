diff --git a/arch/arm64/um/asm/word-at-a-time.h b/arch/arm64/um/asm/word-at-a-time.h
new file mode 100644
index 0000000000000000000000000000000000000000..d7aa132e1d2b8e6360a45c29f0faf7b2191d298e
--- /dev/null
+++ b/arch/arm64/um/asm/word-at-a-time.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_ARM64_WORD_AT_A_TIME_H
+#define __UM_ARM64_WORD_AT_A_TIME_H
+
+#include <asm-generic/word-at-a-time.h>
+#include <asm/page.h>
+
+/*
+ * The native arm64 implementation uses MTE controls and architectural
+ * exception tables.  A UML kernel executes as an unprivileged Darwin task,
+ * so read only up to the current UML page boundary and zero-pad the rest.
+ */
+static inline unsigned long load_unaligned_zeropad(const void *addr)
+{
+	const unsigned char *src = addr;
+	unsigned long value = 0;
+	unsigned long offset = (unsigned long)addr & (PAGE_SIZE - 1);
+	unsigned int count = PAGE_SIZE - offset;
+	unsigned int i;
+
+	if (count > sizeof(value))
+		count = sizeof(value);
+
+#ifdef __AARCH64EB__
+	for (i = 0; i < count; i++)
+		value |= (unsigned long)src[i] <<
+			 ((sizeof(value) - 1 - i) * 8);
+#else
+	for (i = 0; i < count; i++)
+		value |= (unsigned long)src[i] << (i * 8);
+#endif
+	return value;
+}
+
+#endif
