diff --git a/arch/arm64/um/signal.c b/arch/arm64/um/signal.c
new file mode 100644
index 0000000000000000000000000000000000000000..3eae2bc63d71328fdc0a1ba1c5de0832641b1102
--- /dev/null
+++ b/arch/arm64/um/signal.c
@@ -0,0 +1,239 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/binfmts.h>
+#include <linux/errno.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/personality.h>
+#include <linux/sched.h>
+#include <linux/signal.h>
+#include <linux/string.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <asm/elf.h>
+#include <asm/ptrace.h>
+#include <asm/sigcontext.h>
+#include <asm/ucontext.h>
+
+struct uml_arm64_rt_sigframe {
+	struct siginfo info;
+	struct ucontext uc;
+};
+
+/* As on native arm64, a frame record above the signal frame links the
+ * handler's frame chain to the interrupted context.
+ */
+struct uml_arm64_frame_record {
+	u64 fp;
+	u64 lr;
+};
+
+#ifdef UML_HOST_DARWIN
+/* A handler without SA_RESTORER returns here, in the final guest page above
+ * STACK_TOP, and the Darwin host runs the rt_sigreturn syscall itself when a
+ * task reaches this address, so no executable guest stack is needed.
+ */
+#define UML_DARWIN_SIGRETURN_TRAMPOLINE 0x3fffffffff00UL
+
+/*
+ * Unwinders (libgcc, which glibc's backtrace() and thread cancellation use,
+ * GDB and libunwind) recognise a signal frame by reading the instructions at
+ * its return address.  Native arm64 returns to the vDSO's
+ * __kernel_rt_sigreturn, "mov x8, #__NR_rt_sigreturn; svc #0" after a NOP,
+ * and gives it no unwind directives on purpose.  Every task therefore maps
+ * this read-only page, which holds the same instructions at the trampoline.
+ */
+static struct page *uml_darwin_sigpage;
+
+static int __init uml_darwin_sigpage_init(void)
+{
+	static const u32 code[] = {
+		0xd503201f,	/* nop */
+		0xd2801168,	/* mov x8, #__NR_rt_sigreturn */
+		0xd4000001,	/* svc #0 */
+	};
+	unsigned long offset =
+		offset_in_page(UML_DARWIN_SIGRETURN_TRAMPOLINE) - sizeof(code[0]);
+
+	BUILD_BUG_ON(__NR_rt_sigreturn != 139);
+	BUILD_BUG_ON(offset_in_page(UML_DARWIN_SIGRETURN_TRAMPOLINE) <
+		     sizeof(code[0]) ||
+		     offset_in_page(UML_DARWIN_SIGRETURN_TRAMPOLINE) +
+		     sizeof(code) - sizeof(code[0]) > PAGE_SIZE);
+	uml_darwin_sigpage = alloc_page(GFP_KERNEL | __GFP_ZERO);
+	if (!uml_darwin_sigpage)
+		return -ENOMEM;
+	memcpy(page_address(uml_darwin_sigpage) + offset, code, sizeof(code));
+	return 0;
+}
+subsys_initcall(uml_darwin_sigpage_init);
+
+int arch_setup_additional_pages(struct linux_binprm *bprm, int uses_interp)
+{
+	static const struct vm_special_mapping sigpage = {
+		.name = "[sigpage]",
+		.pages = &uml_darwin_sigpage,
+	};
+	struct mm_struct *mm = current->mm;
+	struct vm_area_struct *vma;
+
+	if (!uml_darwin_sigpage)
+		return -ENOMEM;
+	if (mmap_write_lock_killable(mm))
+		return -EINTR;
+	/* As native arm64 maps its sigreturn page: sealed where system
+	 * mappings are, and writable only by a debugger's copy-on-write.
+	 */
+	vma = _install_special_mapping(mm,
+		UML_DARWIN_SIGRETURN_TRAMPOLINE & PAGE_MASK, PAGE_SIZE,
+		VM_READ | VM_EXEC | VM_MAYREAD | VM_MAYWRITE | VM_MAYEXEC |
+		VM_SEALED_SYSMAP, &sigpage);
+	mmap_write_unlock(mm);
+	return PTR_ERR_OR_ZERO(vma);
+}
+#endif
+
+static int save_fpsimd_context(struct sigcontext __user *context,
+			       struct pt_regs *regs)
+{
+	const elf_fpregset_t *state = (const void *)regs->regs.fp;
+	struct fpsimd_context fpsimd = {
+		.head.magic = FPSIMD_MAGIC,
+		.head.size = sizeof(fpsimd),
+		.fpsr = state->fpsr,
+		.fpcr = state->fpcr,
+	};
+
+	memcpy(fpsimd.vregs, state->vregs, sizeof(fpsimd.vregs));
+	if (clear_user(context->__reserved, sizeof(context->__reserved)))
+		return 1;
+	return copy_to_user(context->__reserved, &fpsimd, sizeof(fpsimd));
+}
+
+static int restore_fpsimd_context(struct pt_regs *regs,
+				  struct sigcontext __user *context)
+{
+	elf_fpregset_t *state = (void *)regs->regs.fp;
+	struct fpsimd_context fpsimd;
+
+	if (copy_from_user(&fpsimd, context->__reserved, sizeof(fpsimd)))
+		return 1;
+	if (fpsimd.head.magic != FPSIMD_MAGIC ||
+	    fpsimd.head.size != sizeof(fpsimd))
+		return 1;
+	memcpy(state->vregs, fpsimd.vregs, sizeof(state->vregs));
+	state->fpsr = fpsimd.fpsr;
+	state->fpcr = fpsimd.fpcr;
+	return 0;
+}
+
+static int save_mcontext(struct sigcontext __user *context,
+			 struct pt_regs *regs)
+{
+	int error = 0;
+	int index;
+
+	error |= put_user(UPT_FAULTINFO(&regs->regs)->cr2,
+			  &context->fault_address);
+	for (index = 0; index < 31; index++)
+		error |= put_user(PT_REGS_X(regs, index),
+				  &context->regs[index]);
+	error |= put_user(PT_REGS_SP(regs), &context->sp);
+	error |= put_user(PT_REGS_IP(regs), &context->pc);
+	error |= put_user(PT_REGS_PSTATE(regs), &context->pstate);
+
+	if (!error)
+		error = save_fpsimd_context(context, regs);
+	return error;
+}
+
+static int restore_mcontext(struct pt_regs *regs,
+			    struct sigcontext __user *context)
+{
+	int error = 0;
+	int index;
+
+	for (index = 0; index < 31; index++)
+		error |= get_user(PT_REGS_X(regs, index),
+				  &context->regs[index]);
+	error |= get_user(PT_REGS_SP(regs), &context->sp);
+	error |= get_user(PT_REGS_IP(regs), &context->pc);
+	error |= get_user(PT_REGS_PSTATE(regs), &context->pstate);
+	if (!error && !uml_arm64_valid_user_pstate(&PT_REGS_PSTATE(regs)))
+		error = -EINVAL;
+	if (!error)
+		error = restore_fpsimd_context(regs, context);
+	PT_REGS_SYSCALL_NR(regs) = -1;
+	return error;
+}
+
+int setup_signal_stack_si(unsigned long stack_top, struct ksignal *ksig,
+			  struct pt_regs *regs, sigset_t *mask)
+{
+	struct uml_arm64_frame_record __user *record;
+	struct uml_arm64_rt_sigframe __user *frame;
+	unsigned long restorer;
+	int error = 0;
+
+	record = (void __user *)round_down(stack_top - sizeof(*record), 16);
+	frame = (void __user *)round_down((unsigned long)record - sizeof(*frame),
+					  16);
+	if (!access_ok(frame, (unsigned long)(record + 1) - (unsigned long)frame))
+		return 1;
+
+	error |= put_user(PT_REGS_FP(regs), &record->fp);
+	error |= put_user(PT_REGS_LR(regs), &record->lr);
+	error |= put_user(0, &frame->uc.uc_flags);
+	error |= put_user(NULL, &frame->uc.uc_link);
+	error |= __save_altstack(&frame->uc.uc_stack, PT_REGS_SP(regs));
+	error |= __copy_to_user(&frame->uc.uc_sigmask, mask, sizeof(*mask));
+	error |= save_mcontext(&frame->uc.uc_mcontext, regs);
+	if (ksig->ka.sa.sa_flags & SA_SIGINFO)
+		error |= copy_siginfo_to_user(&frame->info, &ksig->info);
+	if (error)
+		return error;
+
+	if (ksig->ka.sa.sa_flags & SA_RESTORER)
+		restorer = (unsigned long)ksig->ka.sa.sa_restorer;
+#ifdef UML_HOST_DARWIN
+	else
+		restorer = UML_DARWIN_SIGRETURN_TRAMPOLINE;
+#else
+	else
+		return 1;
+#endif
+	PT_REGS_X(regs, 0) = ksig->sig;
+	PT_REGS_X(regs, 1) = (unsigned long)&frame->info;
+	PT_REGS_X(regs, 2) = (unsigned long)&frame->uc;
+	PT_REGS_FP(regs) = (unsigned long)&record->fp;
+	PT_REGS_LR(regs) = restorer;
+	PT_REGS_SP(regs) = (unsigned long)frame;
+	PT_REGS_IP(regs) = (unsigned long)ksig->ka.sa.sa_handler;
+	return 0;
+}
+
+SYSCALL_DEFINE0(rt_sigreturn)
+{
+	struct pt_regs *regs = current_pt_regs();
+	struct uml_arm64_rt_sigframe __user *frame;
+	sigset_t set;
+
+	if (PT_REGS_SP(regs) & 15)
+		goto bad_frame;
+	frame = (void __user *)PT_REGS_SP(regs);
+	if (!access_ok(frame, sizeof(*frame)))
+		goto bad_frame;
+	if (copy_from_user(&set, &frame->uc.uc_sigmask, sizeof(set)))
+		goto bad_frame;
+	set_current_blocked(&set);
+	if (restore_mcontext(regs, &frame->uc.uc_mcontext))
+		goto bad_frame;
+	if (restore_altstack(&frame->uc.uc_stack))
+		goto bad_frame;
+
+	return PT_REGS_SYSCALL_RET(regs);
+
+bad_frame:
+	force_sig(SIGSEGV);
+	return 0;
+}
diff --git a/arch/arm64/um/subarch.c b/arch/arm64/um/subarch.c
new file mode 100644
index 0000000000000000000000000000000000000000..8982857ba78d6136877d7db0e7897513783342e7
--- /dev/null
+++ b/arch/arm64/um/subarch.c
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/device.h>
+#include <linux/dma-map-ops.h>
+#include <linux/types.h>
+
+char *kernel_strrchr(const char *string, int character)
+{
+	const char *last = NULL;
+
+	do {
+		if (*string == (char)character)
+			last = string;
+	} while (*string++);
+
+	return (char *)last;
+}
+
+/*
+ * The no-DMA UML configuration does not compile kernel/dma/mapping.c, but
+ * arm64 still needs the page-protection hook.  When a transport selects UML's
+ * DMA emulation the generic DMA implementation owns this symbol instead.
+ */
+#ifdef CONFIG_NO_DMA
+pgprot_t dma_pgprot(struct device *dev, pgprot_t prot, unsigned long attrs)
+{
+	return prot;
+}
+#endif
diff --git a/arch/arm64/um/syscall_table.c b/arch/arm64/um/syscall_table.c
new file mode 100644
index 0000000000000000000000000000000000000000..a96d226dc48a2c0229065e0bafe3b4cd9767dc47
--- /dev/null
+++ b/arch/arm64/um/syscall_table.c
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/cache.h>
+#include <linux/linkage.h>
+#include <linux/sys.h>
+#include <asm/syscall.h>
+#include <asm/unistd.h>
+
+extern asmlinkage long sys_ni_syscall(unsigned long, unsigned long,
+		unsigned long, unsigned long, unsigned long, unsigned long);
+
+#define __SYSCALL_WITH_COMPAT(number, native, compat) __SYSCALL(number, native)
+#define __SYSCALL(number, symbol) \
+	extern asmlinkage long symbol(unsigned long, unsigned long, \
+		unsigned long, unsigned long, unsigned long, unsigned long);
+#include <asm/syscall_table_64.h>
+#undef __SYSCALL
+
+#define __SYSCALL(number, symbol) [number] = symbol,
+const sys_call_ptr_t sys_call_table[__NR_syscalls] ____cacheline_aligned = {
+	[0 ... __NR_syscalls - 1] = sys_ni_syscall,
+#include <asm/syscall_table_64.h>
+};
+
+int syscall_table_size = sizeof(sys_call_table);
diff --git a/arch/arm64/um/syscalls.c b/arch/arm64/um/syscalls.c
new file mode 100644
index 0000000000000000000000000000000000000000..291b2bbca06c333224bcae84e4ad7fdee9755d30
--- /dev/null
+++ b/arch/arm64/um/syscalls.c
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/mm.h>
+#include <linux/syscalls.h>
+
+SYSCALL_DEFINE6(mmap, unsigned long, addr, unsigned long, len,
+		unsigned long, prot, unsigned long, flags,
+		unsigned long, fd, unsigned long, off)
+{
+	if (off & ~PAGE_MASK)
+		return -EINVAL;
+
+	return ksys_mmap_pgoff(addr, len, prot, flags, fd, off >> PAGE_SHIFT);
+}
diff --git a/arch/arm64/um/sysrq.c b/arch/arm64/um/sysrq.c
new file mode 100644
