diff --git a/arch/arm64/um/shared/sysdep/ptrace.h b/arch/arm64/um/shared/sysdep/ptrace.h
new file mode 100644
index 0000000000000000000000000000000000000000..96411d0ddfcca84189277aae487f91fa7c687787
--- /dev/null
+++ b/arch/arm64/um/shared/sysdep/ptrace.h
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _SYSDEP_UM_ARM64_PTRACE_H
+#define _SYSDEP_UM_ARM64_PTRACE_H
+
+#include <generated/user_constants.h>
+#include <sysdep/faultinfo.h>
+
+#define MAX_REG_OFFSET UM_FRAME_SIZE
+#define MAX_REG_NR (MAX_REG_OFFSET / sizeof(unsigned long))
+
+#define REGS_X(regs, n) ((regs)[HOST_X0 + (n)])
+#define REGS_FP(regs) ((regs)[HOST_FP])
+#define REGS_LR(regs) ((regs)[HOST_LR])
+#define REGS_SP(regs) ((regs)[HOST_SP])
+#define REGS_IP(regs) ((regs)[HOST_IP])
+#define REGS_PSTATE(regs) ((regs)[HOST_PSTATE])
+
+#define UPT_X(regs, n) REGS_X((regs)->gp, n)
+#define UPT_FP(regs) REGS_FP((regs)->gp)
+#define UPT_LR(regs) REGS_LR((regs)->gp)
+#define UPT_SP(regs) REGS_SP((regs)->gp)
+#define UPT_IP(regs) REGS_IP((regs)->gp)
+#define UPT_PSTATE(regs) REGS_PSTATE((regs)->gp)
+
+/*
+ * x0 is both the first argument and the return-value register, and, as on
+ * native arm64, it is the argument until the call returns: a tracer reads it
+ * at the entry stop, and what it writes there is what the call gets.  orig_x0
+ * is the argument as the task passed it, which the Darwin host records at
+ * every entry; the system call reports (syscall_get_arguments, audit) and a
+ * restart use it.
+ */
+#define UPT_SYSCALL_ARG1(regs) UPT_X((regs), 0)
+#define UPT_SYSCALL_ENTRY_ARG1(regs) ((regs)->orig_x0)
+#define UPT_SYSCALL_ARG2(regs) UPT_X((regs), 1)
+#define UPT_SYSCALL_ARG3(regs) UPT_X((regs), 2)
+#define UPT_SYSCALL_ARG4(regs) UPT_X((regs), 3)
+#define UPT_SYSCALL_ARG5(regs) UPT_X((regs), 4)
+#define UPT_SYSCALL_ARG6(regs) UPT_X((regs), 5)
+#define UPT_SYSCALL_ROLLBACK(regs) \
+	(UPT_X((regs), 0) = (regs)->orig_x0)
+/*
+ * As in el0_svc_common(), the system call number is an int and -1
+ * (NO_SYSCALL) is the one number handle_syscall() presets x0 for.  A tracer
+ * or seccomp that sets it skips the call and leaves x0 as it wrote it; any
+ * other number the kernel has no call for returns -ENOSYS.
+ */
+#define UPT_SYSCALL_PRESET_ENOSYS(regs) ((int)UPT_SYSCALL_NR(regs) == -1)
+#define UPT_SYSCALL_REPORT_ENOSYS(regs, nr) ((nr) != -1)
+
+struct uml_pt_regs {
+	unsigned long gp[MAX_REG_NR];
+	unsigned long orig_x0;
+	struct faultinfo faultinfo;
+	long syscall;
+	int is_user;
+	unsigned int padding;
+	/*
+	 * FEAT_FPMR and the user-visible SVCR controls are not part of the
+	 * fixed user_pt_regs/FPSIMD prefixes.  They still belong to the task,
+	 * rather than a host vCPU, and must survive a Darwin backend boundary.
+	 */
+	unsigned long fpmr;
+	unsigned long svcr;
+	/*
+	 * Five guest-owned 128-bit pointer-authentication keys.  Each pair is
+	 * { low, high }.  They are task state rather than host-vCPU state and
+	 * therefore precede the flexible floating-point register tail.
+	 */
+	unsigned long pointer_auth_keys[5][2];
+	unsigned long fp[];
+};
+
+#define EMPTY_UML_PT_REGS { }
+#define UPT_SYSCALL_NR(regs) ((regs)->syscall)
+#define UPT_FAULTINFO(regs) (&(regs)->faultinfo)
+#define UPT_IS_USER(regs) ((regs)->is_user)
+#define UPT_RESTART_SYSCALL(regs) do { \
+	/* AArch64 returns syscall results in x0, which is also argument 1. \
+	 * Restore it before re-executing SVC; unlike x86, rewinding the PC \
+	 * alone would retry with -ERESTART* as the first argument. \
+	 */ \
+	UPT_X((regs), 0) = (regs)->orig_x0; \
+	UPT_IP(regs) -= 4; \
+} while (0)
+
+extern unsigned long host_fp_size;
+extern int arch_init_registers(int pid);
+
+#endif
