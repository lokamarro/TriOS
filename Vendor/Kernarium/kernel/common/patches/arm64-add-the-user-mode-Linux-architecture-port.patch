+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_UM_ARM64_SPINLOCK_H
+#define __ASM_UM_ARM64_SPINLOCK_H
+
+/*
+ * UML tasks retain their kernel stacks in host pthreads, and those pthreads
+ * can resume on a different virtual CPU.  Queued spinlocks encode a waiter's
+ * CPU and nesting level in per-CPU MCS nodes; a suspended and later migrated
+ * host carrier makes that representation needlessly fragile.  Ticket locks
+ * keep all waiter state in the lock word and only require the native arm64
+ * atomic operations that the UML kernel already uses.
+ */
+#include <asm/processor.h>
+#include <asm-generic/ticket_spinlock.h>
+#include <asm/qrwlock.h>
