diff --git a/arch/arm64/um/asm/perf_event.h b/arch/arm64/um/asm/perf_event.h
new file mode 100644
index 0000000000000000000000000000000000000000..26374c04b7f3e50c59c9b870e9c3f4ff69729b90
--- /dev/null
+++ b/arch/arm64/um/asm/perf_event.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_UM_ARM64_PERF_EVENT_H
+#define _ASM_UM_ARM64_PERF_EVENT_H
+
+#include <asm/ptrace.h>
+
+/*
+ * UML has no host PMU interrupt frame.  Software perf events still need a
+ * minimal kernel frame for IP attribution and call-chain collection.  Keep
+ * this in UML's pt_regs representation instead of including arm64's native
+ * perf_event.h, whose pt_regs layout describes an EL1 exception frame.
+ */
+#define perf_arch_fetch_caller_regs(regs, __ip) do {                 \
+	PT_REGS_IP(regs) = (__ip);                                    \
+	PT_REGS_FP(regs) = (unsigned long)__builtin_frame_address(0);  \
+	PT_REGS_SP(regs) = (unsigned long)__builtin_frame_address(0);  \
+} while (0)
+
