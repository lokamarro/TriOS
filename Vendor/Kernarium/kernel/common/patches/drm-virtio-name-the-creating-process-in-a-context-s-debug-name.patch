From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 8 Nov 2026 17:24:47 +0900
Subject: [PATCH] drm/virtio: name the creating process in a context's debug
 name

The host that backs a virtio-gpu device keeps its graphics memory in a
budget and can tell which context holds how much of it, but a context's
debug name was the creating thread's command name, or a name the process
chose. It does not tell which process the context belongs to, so the
host could not end the application that holds the most memory.

Append the creating process to the name sent with the context: the
debug name becomes "<name>|pid=<tgid>|comm=<comm>", the thread group
ID in the initial PID namespace and the command name of the thread group
leader. The name is cut to fit the 64-byte field and the suffix is not,
and a '|' in the command name, which a task may choose, is replaced so
the last "|comm=" always begins the suffix. A host that does not parse
the suffix sees a longer debug name. Guest user space sees nothing.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/virtio/virtgpu_ioctl.c | 45 ++++++++++++++++++++------
 1 file changed, 36 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/virtio/virtgpu_ioctl.c b/drivers/gpu/drm/virtio/virtgpu_ioctl.c
index 54955a5dd287d18b91dd98e11f5a5ab21156d040..efa20d6f698f35db8cad695ba36f1ad9f860b044 100644
--- a/drivers/gpu/drm/virtio/virtgpu_ioctl.c
+++ b/drivers/gpu/drm/virtio/virtgpu_ioctl.c
@@ -38,23 +38,50 @@
 				    VIRTGPU_BLOB_FLAG_USE_SHAREABLE | \
 				    VIRTGPU_BLOB_FLAG_USE_CROSS_DEVICE)
 
+/*
+ * Names the creating process in a context's debug name, so a host that
+ * accounts for graphics memory by context can tell which guest process holds
+ * it: "<name>|pid=<tgid>|comm=<comm>", the thread group ID in the initial PID
+ * namespace and the command name of the thread group leader. The name is cut
+ * to fit and the suffix is not, and a '|' in a command name, which a task may
+ * choose, is replaced so that the last "|comm=" begins the suffix.
+ */
+static void virtio_gpu_name_context_owner(char *buf, size_t size,
+					  const char *name)
+{
+	char comm[TASK_COMM_LEN];
+	char suffix[32 + TASK_COMM_LEN];
+	size_t room;
+	size_t i;
+	int len;
+
+	get_task_comm(comm, current->group_leader);
+	for (i = 0; comm[i]; i++)
+		if (comm[i] == '|')
+			comm[i] = '?';
+	len = scnprintf(suffix, sizeof(suffix), "|pid=%d|comm=%s",
+			task_tgid_nr(current), comm);
+	room = size - 1 - min_t(size_t, len, size - 1);
+	scnprintf(buf, size, "%.*s%s", (int)room, name, suffix);
+}
+
 /* Must be called with &virtio_gpu_fpriv.struct_mutex held. */
 static void virtio_gpu_create_context_locked(struct virtio_gpu_device *vgdev,
 					     struct virtio_gpu_fpriv *vfpriv)
 {
+	char name[sizeof_field(struct virtio_gpu_ctx_create, debug_name)];
+	char thread[TASK_COMM_LEN];
+
 	if (vfpriv->explicit_debug_name) {
-		virtio_gpu_cmd_context_create(vgdev, vfpriv->ctx_id,
-					      vfpriv->context_init,
-					      strlen(vfpriv->debug_name),
+		virtio_gpu_name_context_owner(name, sizeof(name),
 					      vfpriv->debug_name);
 	} else {
-		char dbgname[TASK_COMM_LEN];
-
-		get_task_comm(dbgname, current);
-		virtio_gpu_cmd_context_create(vgdev, vfpriv->ctx_id,
-					      vfpriv->context_init, strlen(dbgname),
-					      dbgname);
+		get_task_comm(thread, current);
+		virtio_gpu_name_context_owner(name, sizeof(name), thread);
 	}
+	virtio_gpu_cmd_context_create(vgdev, vfpriv->ctx_id,
+				      vfpriv->context_init, strlen(name),
+				      name);
 
 	vfpriv->context_created = true;
 }
