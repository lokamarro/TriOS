@@ -18,11 +18,24 @@ SECTIONS
   . = START + SIZEOF_HEADERS;
   .interp         : { *(.interp) }
   __binary_start = .;
+  /* The iOS signed carrier aliases executable bytes at the Darwin host-page
+   * granularity even when the guest uses 4 KiB pages. Keep both sides of the
+   * early executable segment on 16 KiB boundaries so the following dynamic
+   * tables never share a signed executable host page.
+   */
+#ifdef UML_HOST_DARWIN
+  . = ALIGN(0x4000);		/* Init code and data */
+#else
   . = ALIGN(4096);		/* Init code and data */
+#endif
   _text = .;
   INIT_TEXT_SECTION(PAGE_SIZE)
 
+#ifdef UML_HOST_DARWIN
+  . = ALIGN(0x4000);
+#else
   . = ALIGN(PAGE_SIZE);
+#endif
 
   /* Read-only sections, merged into text segment: */
   .hash           : { *(.hash) }
