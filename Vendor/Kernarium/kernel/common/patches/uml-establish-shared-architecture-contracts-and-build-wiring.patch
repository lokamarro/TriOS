+/*
+ * A port whose first argument register is also its return register (arm64's
+ * x0) defines these in sysdep/ptrace.h, so that the register holds the
+ * argument for as long as the task is stopped at the system call's entry:
+ * a tracer reads it there, and what it writes there is what the call gets.
+ *
+ *   UPT_SYSCALL_PRESET_ENOSYS(r)	whether the return register holds
+ *					-ENOSYS until the call sets it, as it
+ *					does on x86 (the default)
+ *   UPT_SYSCALL_REPORT_ENOSYS(r, nr)	whether a number the kernel has no
+ *					call for returns -ENOSYS here, because
+ *					nothing preset it (the default is no)
+ *
+ * The number -1 is the one a tracer or seccomp sets to skip a call and leave
+ * the return register as it is, so such a port presets it for -1 alone.
+ */
+#ifndef UPT_SYSCALL_PRESET_ENOSYS
+#define UPT_SYSCALL_PRESET_ENOSYS(r) 1
+#endif
+#ifndef UPT_SYSCALL_REPORT_ENOSYS
+#define UPT_SYSCALL_REPORT_ENOSYS(r, nr) 0
