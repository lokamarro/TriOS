diff --git a/arch/um/Makefile b/arch/um/Makefile
index 721b652ffb6584f10504121303ea8d2bc2b2fe2f..5066ec876cf7a3321f0780b28ad64017e47e2b7a 100644
--- a/arch/um/Makefile
+++ b/arch/um/Makefile
@@ -18,6 +18,8 @@ else
 endif
 
 ARCH_DIR := arch/um
+UML_HOST_OS ?= $(shell uname -s)
+export UML_HOST_OS
 # We require bash because the vmlinux link and loader script cpp use bash
 # features.
 SHELL := bash
@@ -73,8 +75,10 @@ USER_CFLAGS = $(patsubst $(KERNEL_DEFINES),,$(patsubst -I%,,$(KBUILD_CFLAGS))) \
 		-include $(srctree)/include/linux/compiler-version.h \
 		-include $(srctree)/include/linux/kconfig.h
 
-#This will adjust *FLAGS accordingly to the platform.
-include $(srctree)/$(ARCH_DIR)/Makefile-os-Linux
+# This adjusts flags for the host operating system.  Upstream UML only has a
+# Linux host backend; the Darwin backend deliberately keeps that selection
+# explicit so Linux builds remain unchanged.
+include $(srctree)/$(ARCH_DIR)/Makefile-os-$(UML_HOST_OS)
 
 KBUILD_CPPFLAGS += -I$(srctree)/$(HOST_DIR)/include \
 		   -I$(srctree)/$(HOST_DIR)/include/uapi \
@@ -128,7 +132,13 @@ export LDS_ELF_ARCH   := $(ELF_ARCH)
 export LDS_ELF_FORMAT := $(ELF_FORMAT)
 
 # The wrappers will select whether using "malloc" or the kernel allocator.
+# Darwin host objects live in the embedded ELF and use libSystem allocation;
+# wrapping them would require crossing the ELF/Mach-O ABI with variadic state.
+ifeq ($(UML_HOST_OS),Darwin)
+LINK_WRAPS :=
+else
 LINK_WRAPS = -Wl,--wrap,malloc -Wl,--wrap,free -Wl,--wrap,calloc
+endif
 
 # Avoid binutils 2.39+ warnings by marking the stack non-executable and
 # ignorning warnings for the kallsyms sections.
diff --git a/arch/um/Makefile-os-Darwin b/arch/um/Makefile-os-Darwin
new file mode 100644
index 0000000000000000000000000000000000000000..2f16d66201d8c8913697266e75a0eda1f2c7ebdf
--- /dev/null
+++ b/arch/um/Makefile-os-Darwin
@@ -0,0 +1,24 @@
+# SPDX-License-Identifier: GPL-2.0
+
+# Kernel objects remain normal AArch64 ELF.  Host-facing objects use the
+# Darwin SDK ABI while retaining ELF so the regular Linux linker script and
+# kallsyms passes continue to work.  The project-root Mach-O launcher loads
+# the resulting ET_DYN image and resolves its libSystem imports.
+DARWIN_SDKROOT ?= $(shell xcrun --sdk macosx --show-sdk-path)
+
+DARWIN_ABI_FLAGS := --target=aarch64-unknown-linux-gnu \
+	-ffixed-x18 \
+	-D__APPLE__ -D__MACH__ -D__arm64__ -D__arm64 \
+	-U__linux__ -isysroot $(DARWIN_SDKROOT) \
+	-isystem $(DARWIN_SDKROOT)/usr/include
+
+USER_CFLAGS += $(DARWIN_ABI_FLAGS) -D_DARWIN_C_SOURCE
+USER_CFLAGS += -idirafter $(objtree)/arch/arm64/include/generated/uapi \
+	-idirafter $(srctree)/arch/arm64/include/uapi \
+	-idirafter $(srctree)/include/uapi
+KBUILD_CFLAGS += -ffixed-x18 -DUML_HOST_DARWIN
+KBUILD_CPPFLAGS += -DUML_HOST_DARWIN
+DEV_NULL_PATH = \"/dev/null\"
+UML_LDLIBS :=
+
+export DARWIN_SDKROOT DARWIN_ABI_FLAGS UML_LDLIBS
