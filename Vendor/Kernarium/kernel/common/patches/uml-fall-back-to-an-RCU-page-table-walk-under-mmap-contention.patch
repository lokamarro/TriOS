From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 8 Sep 2026 15:22:03 +0900
Subject: [PATCH] uml: fall back to an RCU page-table walk under mmap
 contention

pin_user_mapping() answered a contended mmap_read_trylock() with a fault
whenever page faults were disabled.  mmap_read_trylock() refuses to barge
past a queued writer, while the ordinary mmap_read_lock() taken by the same
task's faulting retry still steals the lock from under it, so the try kept
failing for as long as that writer stayed queued.  futex_wait_setup()
answers the resulting -EFAULT by dropping its hash-bucket lock and
re-reading the same word with faults enabled, that read succeeds, and the
two halves alternate forever: on a CONFIG_PREEMPT_NONE guest the task never
yields the CPU the queued writer needs to make progress, and whole Vulkan
CTS fractions stalled behind it.

Walk the page tables under RCU when the try fails instead of reporting a
fault.  UML selects MMU_GATHER_RCU_TABLE_FREE, so an RCU read section keeps
every page-table level alive across the walk, and the page-table lock taken
further down still samples the entry itself.  The blocking path is
unchanged.
---
 arch/um/kernel/skas/uaccess.c | 43 +++++++++++++++++++++++------------
 1 file changed, 29 insertions(+), 14 deletions(-)

diff --git a/arch/um/kernel/skas/uaccess.c b/arch/um/kernel/skas/uaccess.c
index 0a79d20d3c871993203998e82fef9496c7a0547e..56db2f7003bc8aa93c7009c9b021aaf0d4e5074f 100644
--- a/arch/um/kernel/skas/uaccess.c
+++ b/arch/um/kernel/skas/uaccess.c
@@ -8,6 +8,7 @@
 #include <linux/mm.h>
 #include <linux/module.h>
 #include <linux/pagemap.h>
+#include <linux/rcupdate.h>
 #include <linux/sched.h>
 #include <linux/uaccess.h>
 #include <asm/current.h>
@@ -20,30 +21,46 @@
 
 struct user_walk {
 	struct mm_struct *mm;
+	bool mmap_locked;
 };
 
-/* Take what keeps the page tables of mm alive for a walk.  Returns false,
- * having taken nothing, when a caller that may not sleep would have to.
- */
-static bool user_walk_begin(struct user_walk *walk, struct mm_struct *mm,
+static void user_walk_begin(struct user_walk *walk, struct mm_struct *mm,
 			    bool may_sleep)
 {
 	walk->mm = mm;
+	walk->mmap_locked = true;
 	/*
 	 * Atomic uaccess callers can already hold a futex hash-bucket lock.  A
 	 * blocking mmap lock acquisition would let UML schedule the Linux task
 	 * while its Darwin carrier still owns that spinlock, stranding the next
-	 * ticket.  Let the caller drop its outer lock and retry instead.
+	 * ticket.  Contention must not be answered with a fault either.
+	 * mmap_read_trylock() refuses to barge past a queued writer, while the
+	 * ordinary mmap_read_lock() of the same task's faulting retry still
+	 * steals the lock from under it, so the try keeps failing for as long as
+	 * that writer stays queued.  futex_wait_setup() answers the resulting
+	 * -EFAULT by dropping its hash-bucket lock and re-reading the same word
+	 * with faults enabled; that read succeeds, so the two alternate forever
+	 * and this CONFIG_PREEMPT_NONE task never yields the CPU the queued
+	 * writer needs to make progress.  Walk the page tables under RCU
+	 * instead: UML selects MMU_GATHER_RCU_TABLE_FREE, so an RCU read section
+	 * keeps every level alive, and the page-table lock taken below still
+	 * samples the entry itself.
 	 */
-	if (!may_sleep)
-		return mmap_read_trylock(mm);
-	mmap_read_lock(mm);
-	return true;
+	if (may_sleep) {
+		mmap_read_lock(mm);
+	} else {
+		walk->mmap_locked = mmap_read_trylock(mm);
+		if (!walk->mmap_locked)
+			rcu_read_lock();
+	}
 }
 
 static void user_walk_end(struct user_walk *walk)
 {
-	mmap_read_unlock(walk->mm);
+	if (walk->mmap_locked)
+		mmap_read_unlock(walk->mm);
+	else
+		rcu_read_unlock();
 }
 
 /* The PTE mapping addr, mapped and locked through *ptlp, or NULL. */
@@ -94,8 +111,7 @@ static struct page *pin_user_mapping(struct mm_struct *mm, unsigned long addr,
 	if (mm == NULL)
 		return NULL;
 
-	if (!user_walk_begin(&walk, mm, !faulthandler_disabled()))
-		return NULL;
+	user_walk_begin(&walk, mm, !faulthandler_disabled());
 	ptep = user_walk_lock_pte(&walk, addr, &ptl);
 	if (ptep != NULL) {
 		pte_t value = ptep_get(ptep);
@@ -167,8 +183,7 @@ static void mark_user_page_dirty(unsigned long addr, struct page *page,
 		return;
 	}
 
-	if (!user_walk_begin(&walk, current->mm, false))
-		return;
+	user_walk_begin(&walk, current->mm, false);
 	ptep = user_walk_lock_pte(&walk, addr, &ptl);
 	if (ptep != NULL) {
 		pte_t value = ptep_get(ptep);
