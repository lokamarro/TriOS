+	}
+#endif
+
 	if (vu_dev->protocol_features &
 			BIT_ULL(VHOST_USER_PROTOCOL_F_MQ)) {
 		rc = vhost_user_get_queue_num(vu_dev, &vu_dev->max_vqs);
@@ -881,6 +1140,9 @@ static void vu_reset(struct virtio_device *vdev)
 {
