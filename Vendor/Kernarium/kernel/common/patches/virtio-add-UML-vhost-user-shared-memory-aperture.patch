+#ifdef UML_HOST_DARWIN
+/*
+ * Wait for the backend to answer on the main socket, serving its requests
+ * meanwhile. Darwin delivers the backend-request socket through an ordinary
+ * SIGIO IRQ, which only CPU 0 polls. A backend may send a request that needs
+ * a reply, such as a config change or a SHMEM_MAP, and wait for that reply
+ * before it reads its next frontend message. A frontend that waited on the
+ * main socket alone, for a GET_CONFIG answer or an acknowledgement, would
+ * then leave both channels blocked, and a CPU 0 blocked in that read could
+ * never take the IRQ that answers. Serving a request here only records its
+ * Virtio interrupt and replies on the request socket; it sends nothing on the
+ * main socket. The recorded interrupts are delivered from interrupt context
+ * once this CPU can take interrupts again.
+ */
+static int vhost_user_wait_resp(struct virtio_uml_device *vu_dev)
+{
+	while (vu_dev->req_fd >= 0) {
+		const int poll_fds[] = { vu_dev->req_fd, vu_dev->sock };
+		int ready;
+
+		do {
+			ready = os_poll(ARRAY_SIZE(poll_fds), poll_fds);
+		} while (ready == -EINTR);
+		if (ready < 0)
+			return ready;
+		if (ready == 1)
+			break;
+
+		vu_req_read_message(vu_dev, NULL);
+		if (vu_dev->recv_rc)
+			return vu_dev->recv_rc;
+		/*
+		 * A descriptor edge is reported only while unread data remains,
+		 * so the request IRQ will not run for what this wait has read.
+		 */
+		if (READ_ONCE(vu_dev->vq_irq_vq_map) ||
+		    READ_ONCE(vu_dev->config_changed_irq))
+			irq_work_queue(&vu_dev->req_irq_work);
+	}
+	return 0;
+}
+#endif
+
 static int vhost_user_recv_resp(struct virtio_uml_device *vu_dev,
 				struct vhost_user_msg *msg,
 				size_t max_payload_size)
 {
-	int rc = vhost_user_recv(vu_dev, vu_dev->sock, msg,
-				 max_payload_size, true);
+	int rc = 0;
 
+#ifdef UML_HOST_DARWIN
+	rc = vhost_user_wait_resp(vu_dev);
+#endif
+	if (!rc)
+		rc = vhost_user_recv(vu_dev, vu_dev->sock, msg,
+				     max_payload_size, true);
 	if (rc) {
 		vhost_user_check_reset(vu_dev, rc);
 		return rc;
@@ -208,19 +270,57 @@ static int vhost_user_recv_u64(struct virtio_uml_device *vu_dev,
 
 static int vhost_user_recv_req(struct virtio_uml_device *vu_dev,
 			       struct vhost_user_msg *msg,
-			       size_t max_payload_size)
+			       size_t max_payload_size, int fds[2])
 {
-	int rc = vhost_user_recv(vu_dev, vu_dev->req_fd, msg,
-				 max_payload_size, false);
+	ssize_t header_size;
+	size_t payload_size;
+	int rc;
+
+	fds[0] = -1;
+	fds[1] = -1;
+	do {
+		header_size = os_rcv_fd_msg(vu_dev->req_fd, fds, 2, msg,
+					    sizeof(msg->header));
+	} while (header_size == -EINTR);
+	if (header_size < 0)
+		return header_size;
+	if (!header_size)
+		return -ECONNRESET;
+	if (header_size < (ssize_t)sizeof(msg->header)) {
+		rc = full_read(vu_dev->req_fd,
+			       (u8 *)msg + header_size,
+			       (int)(sizeof(msg->header) -
+				     (size_t)header_size), false);
+		if (rc)
+			goto error_close_fds;
+	}
+
+	payload_size = msg->header.size;
+	if (payload_size > max_payload_size) {
+		rc = -EPROTO;
+		goto error_close_fds;
+	}
+	rc = full_read(vu_dev->req_fd, &msg->payload, payload_size, false);
 
 	if (rc)
-		return rc;
+		goto error_close_fds;
 
 	if ((msg->header.flags & ~VHOST_USER_FLAG_NEED_REPLY) !=
-			VHOST_USER_VERSION)
-		return -EPROTO;
+			VHOST_USER_VERSION) {
+		rc = -EPROTO;
+		goto error_close_fds;
+	}
 
 	return 0;
+
+error_close_fds:
+	if (fds[0] >= 0)
+		os_close_file(fds[0]);
+	if (fds[1] >= 0)
+		os_close_file(fds[1]);
+	fds[0] = -1;
+	fds[1] = -1;
+	return rc;
 }
 
 static int vhost_user_send(struct virtio_uml_device *vu_dev,
@@ -354,6 +454,45 @@ static int vhost_user_get_queue_num(struct virtio_uml_device *vu_dev,
 	return vhost_user_recv_u64(vu_dev, queue_num);
 }
 
+#ifdef UML_HOST_DARWIN
+static int vhost_user_get_shmem_config(struct virtio_uml_device *vu_dev)
+{
+	struct vhost_user_msg msg;
+	unsigned long long phys;
+	unsigned long long size;
+	int rc;
+	int i;
+
+	rc = vhost_user_send_no_payload(vu_dev, true,
+					 VHOST_USER_GET_SHMEM_CONFIG);
+	if (rc)
+		return rc;
+	rc = vhost_user_recv_resp(vu_dev, &msg,
+				  sizeof(msg.payload.shmem_config));
+	if (rc)
+		return rc;
+	if (msg.header.request != VHOST_USER_GET_SHMEM_CONFIG ||
+	    msg.header.size != sizeof(msg.payload.shmem_config) ||
+	    msg.payload.shmem_config.num_regions != 1 ||
+	    msg.payload.shmem_config.padding != 0 ||
+	    msg.payload.shmem_config.region_sizes[0] != 0)
+		return -EPROTO;
+	for (i = 2; i < VHOST_USER_MAX_SHMEM_REGIONS; i++) {
+		if (msg.payload.shmem_config.region_sizes[i])
+			return -EPROTO;
+	}
+
+	rc = uml_vhost_user_shmem_claim(
+		vu_dev, msg.payload.shmem_config.region_sizes[1], &phys, &size);
+	if (rc)
+		return rc;
+	vu_dev->shmem_region.addr = phys;
+	vu_dev->shmem_region.len = size;
+	vu_dev->has_shmem_region = true;
+	return 0;
+}
+#endif
