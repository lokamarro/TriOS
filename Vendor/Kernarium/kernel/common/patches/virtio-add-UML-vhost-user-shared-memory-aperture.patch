+	if (uml_vhost_user_shmem_owner != owner) {
+		raw_spin_unlock_irqrestore(&uml_vhost_user_shmem_lock, flags);
+		return;
+	}
+	if (release)
+		uml_vhost_user_shmem_owner = NULL;
+	if (uml_vhost_user_shmem_revoking) {
+		raw_spin_unlock_irqrestore(&uml_vhost_user_shmem_lock, flags);
+		return;
