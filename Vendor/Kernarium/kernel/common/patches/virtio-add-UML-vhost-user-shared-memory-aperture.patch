 	os_close_file(req_fds[1]);
@@ -530,6 +771,15 @@ static int vhost_user_init(struct virtio_uml_device *vu_dev)
 		if (rc)
 			return rc;
 		vu_dev->protocol_features &= VHOST_USER_SUPPORTED_PROTOCOL_F;
+		if ((vu_dev->protocol_features &
+		     BIT_ULL(VHOST_USER_PROTOCOL_F_SHMEM_MAP)) &&
+		    (vu_dev->protocol_features &
+		     (BIT_ULL(VHOST_USER_PROTOCOL_F_SLAVE_REQ) |
+		      BIT_ULL(VHOST_USER_PROTOCOL_F_REPLY_ACK))) !=
+			(BIT_ULL(VHOST_USER_PROTOCOL_F_SLAVE_REQ) |
+			 BIT_ULL(VHOST_USER_PROTOCOL_F_REPLY_ACK)))
