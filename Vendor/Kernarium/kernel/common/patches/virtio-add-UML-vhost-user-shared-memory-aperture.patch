+				~BIT_ULL(VHOST_USER_PROTOCOL_F_SHMEM_MAP);
 		rc = vhost_user_set_protocol_features(vu_dev,
 				vu_dev->protocol_features);
 		if (rc)
@@ -543,6 +793,15 @@ static int vhost_user_init(struct virtio_uml_device *vu_dev)
 			return rc;
 	}
 
+#ifdef UML_HOST_DARWIN
+	if (vu_dev->protocol_features &
+			BIT_ULL(VHOST_USER_PROTOCOL_F_SHMEM_MAP)) {
+		rc = vhost_user_get_shmem_config(vu_dev);
+		if (rc)
