+static irqreturn_t vu_req_read_message(struct virtio_uml_device *vu_dev,
+				       struct time_travel_event *ev)
+{
+	unsigned long flags;
+	irqreturn_t result;
+
+	/*
+	 * Darwin can drain this stream synchronously from the main-socket
+	 * reply wait while another vCPU receives its ordinary request-fd IRQ.
+	 * Serialize the complete framed read and reply so the two consumers
+	 * cannot split a header and payload or consume one another's reply.
+	 */
+	raw_spin_lock_irqsave(&vu_dev->req_lock, flags);
+	result = __vu_req_read_message(vu_dev, ev);
+	raw_spin_unlock_irqrestore(&vu_dev->req_lock, flags);
+	return result;
+}
+
 static irqreturn_t vu_req_interrupt(int irq, void *data)
 {
 	struct virtio_uml_device *vu_dev = data;
 	irqreturn_t ret = IRQ_HANDLED;
+	bool config_changed;
+	unsigned long flags;
+	uint64_t vq_map;
 
 #ifdef UML_HOST_DARWIN
 	/*
@@ -448,22 +663,47 @@ static irqreturn_t vu_req_interrupt(int irq, void *data)
 
 	if (vu_dev->recv_rc) {
 		vhost_user_check_reset(vu_dev, vu_dev->recv_rc);
-	} else if (vu_dev->vq_irq_vq_map) {
+		return ret;
+	}
+	/*
+	 * Deliver everything recorded. A request another reader drained leaves
+	 * no descriptor edge behind, so nothing would deliver a remainder.
+	 * That reader records under req_lock on another CPU, so take and clear
+	 * the records under it too; a record made afterwards stays for the
+	 * next delivery. Deliver unlocked: a callback may send a request,
+	 * whose reply wait takes req_lock.
+	 */
+	raw_spin_lock_irqsave(&vu_dev->req_lock, flags);
+	vq_map = vu_dev->vq_irq_vq_map;
+	vu_dev->vq_irq_vq_map = 0;
+	config_changed = vu_dev->config_changed_irq;
+	vu_dev->config_changed_irq = false;
+	raw_spin_unlock_irqrestore(&vu_dev->req_lock, flags);
+
+	if (vq_map) {
 		struct virtqueue *vq;
 
 		virtio_device_for_each_vq((&vu_dev->vdev), vq) {
-			if (vu_dev->vq_irq_vq_map & BIT_ULL(vq->index))
+			if (vq_map & BIT_ULL(vq->index))
 				vring_interrupt(0 /* ignored */, vq);
 		}
-		vu_dev->vq_irq_vq_map = 0;
-	} else if (vu_dev->config_changed_irq) {
-		virtio_config_changed(&vu_dev->vdev);
-		vu_dev->config_changed_irq = false;
 	}
+	if (config_changed)
+		virtio_config_changed(&vu_dev->vdev);
 
 	return ret;
 }
 
+#ifdef UML_HOST_DARWIN
+static void vu_req_irq_work(struct irq_work *work)
+{
+	struct virtio_uml_device *vu_dev =
+		container_of(work, struct virtio_uml_device, req_irq_work);
+
+	vu_req_interrupt(vu_dev->irq, vu_dev);
+}
+#endif
