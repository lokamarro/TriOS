+		case VHOST_USER_SLAVE_SHMEM_UNMAP:
+			if (!(vu_dev->protocol_features &
+			      BIT_ULL(VHOST_USER_PROTOCOL_F_SHMEM_MAP)) ||
+			    msg.msg.header.size != sizeof(msg.msg.payload.mmap) ||
+			    msg.msg.payload.mmap.shmid !=
+				VHOST_USER_SHMEM_REGION_HOST_VISIBLE ||
+			    memchr_inv(msg.msg.payload.mmap.padding, 0,
+				       sizeof(msg.msg.payload.mmap.padding)) ||
+			    msg.msg.payload.mmap.fd_offset != 0 ||
+			    msg.msg.payload.mmap.flags != VHOST_USER_SHMEM_MAP_RO ||
+			    fds[0] >= 0 || fds[1] >= 0)
