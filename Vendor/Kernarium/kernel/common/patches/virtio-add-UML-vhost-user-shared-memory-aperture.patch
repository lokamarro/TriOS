+	    shm_offset > U64_MAX - length ||
+	    shm_offset + length > UML_VHOST_USER_SHMEM_SIZE)
+		return -EINVAL;
+	first = shm_offset / UML_VHOST_USER_SHMEM_ALIGNMENT;
+	count = length / UML_VHOST_USER_SHMEM_ALIGNMENT;
