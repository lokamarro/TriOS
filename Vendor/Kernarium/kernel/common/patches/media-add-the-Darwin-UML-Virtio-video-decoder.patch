+
+	idr_preload(GFP_KERNEL);
+	spin_lock(&vvd->stream_idr_lock);
+	handle = idr_alloc(&vvd->stream_idr, stream, 1, 0, 0);
+	spin_unlock(&vvd->stream_idr_lock);
