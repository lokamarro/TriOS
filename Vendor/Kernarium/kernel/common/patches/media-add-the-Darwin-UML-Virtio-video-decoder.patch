+#define MAX_INLINE_CMD_SIZE   298
+#define MAX_INLINE_RESP_SIZE  298
+#define VBUFFER_SIZE          (sizeof(struct virtio_video_vbuffer) \
+			       + MAX_INLINE_CMD_SIZE		   \
+			       + MAX_INLINE_RESP_SIZE)
+
+static int virtio_video_queue_event_buffer(struct virtio_video_device *vvd,
+					   struct virtio_video_event *evt);
+static void virtio_video_handle_event(struct virtio_video_device *vvd,
+				      struct virtio_video_event *evt);
+
+/*
+ * A payload is allocated in chunks of a page, never as one piece: a scatter
+ * list grows with the buffer it describes, and one in scattered pages is
+ * hundreds of kilobytes, more than a guest with fragmented memory can always
+ * find contiguous. The last chunk takes only what is left.
+ */
+struct virtio_video_payload *virtio_video_payload_alloc(size_t size)
+{
+	struct virtio_video_payload *payload;
+	unsigned int nr_chunks, i;
+
+	if (!size || size > VIRTIO_VIDEO_PAYLOAD_MAX)
+		return ERR_PTR(-EINVAL);
+
+	nr_chunks = DIV_ROUND_UP(size, VIRTIO_VIDEO_PAYLOAD_CHUNK);
+	payload = kzalloc(struct_size(payload, sg, nr_chunks), GFP_KERNEL);
+	if (!payload)
+		return ERR_PTR(-ENOMEM);
+
+	payload->size = size;
+	payload->nr_chunks = nr_chunks;
+	sg_init_table(payload->sg, nr_chunks);
+	for (i = 0; i < nr_chunks; i++) {
+		size_t len = min_t(size_t, size, VIRTIO_VIDEO_PAYLOAD_CHUNK);
+		void *chunk = kzalloc(len, GFP_KERNEL);
+
+		if (!chunk) {
+			payload->nr_chunks = i;
+			virtio_video_payload_free(payload);
+			return ERR_PTR(-ENOMEM);
+		}
+		sg_set_buf(&payload->sg[i], chunk, len);
+		size -= len;
+	}
+
+	return payload;
+}
+
+void virtio_video_payload_free(struct virtio_video_payload *payload)
+{
+	unsigned int i;
+
+	if (!payload)
+		return;
+
+	for (i = 0; i < payload->nr_chunks; i++)
+		kfree(sg_virt(&payload->sg[i]));
+	kfree(payload);
+}
+
+/* Writes `len` bytes at `offset`, across the chunks they lie in. */
+void virtio_video_payload_write(struct virtio_video_payload *payload,
+				size_t offset, const void *data, size_t len)
+{
+	const u8 *src = data;
+
+	if (WARN_ON_ONCE(offset > payload->size ||
+			 len > payload->size - offset))
+		return;
+
+	while (len) {
+		struct scatterlist *chunk =
+			&payload->sg[offset / VIRTIO_VIDEO_PAYLOAD_CHUNK];
+		size_t at = offset % VIRTIO_VIDEO_PAYLOAD_CHUNK;
+		size_t n = min_t(size_t, len,
+				 VIRTIO_VIDEO_PAYLOAD_CHUNK - at);
+
+		memcpy(sg_virt(chunk) + at, src, n);
+		offset += n;
+		src += n;
+		len -= n;
+	}
+}
+
+/* Keeps the first `size` bytes, which were all that could be written. */
+void virtio_video_payload_trim(struct virtio_video_payload *payload,
+			       size_t size)
+{
+	unsigned int keep, i;
+
+	if (WARN_ON_ONCE(!size || size > payload->size))
+		return;
+
+	keep = DIV_ROUND_UP(size, VIRTIO_VIDEO_PAYLOAD_CHUNK);
+	for (i = keep; i < payload->nr_chunks; i++)
+		kfree(sg_virt(&payload->sg[i]));
+	payload->nr_chunks = keep;
+	payload->size = size;
+	payload->sg[keep - 1].length =
+		size - (size_t)(keep - 1) * VIRTIO_VIDEO_PAYLOAD_CHUNK;
+	sg_mark_end(&payload->sg[keep - 1]);
+}
+
+void virtio_video_resource_id_get(struct virtio_video_device *vvd, uint32_t *id)
+{
+	int handle;
+
+	idr_preload(GFP_KERNEL);
+	spin_lock(&vvd->resource_idr_lock);
+	handle = idr_alloc(&vvd->resource_idr, NULL, 1, 0, GFP_NOWAIT);
+	spin_unlock(&vvd->resource_idr_lock);
+	idr_preload_end();
+	*id = handle;
+}
+
+void virtio_video_resource_id_put(struct virtio_video_device *vvd, uint32_t id)
+{
+	spin_lock(&vvd->resource_idr_lock);
+	idr_remove(&vvd->resource_idr, id);
+	spin_unlock(&vvd->resource_idr_lock);
+}
+
+void virtio_video_stream_id_get(struct virtio_video_device *vvd,
+				struct virtio_video_stream *stream,
+				uint32_t *id)
+{
