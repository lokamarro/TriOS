+	idr_remove(&vvd->stream_idr, id);
+	spin_unlock(&vvd->stream_idr_lock);
+}
+
+static bool vbuf_is_pending(struct virtio_video_device *vvd,
+			    struct virtio_video_vbuffer *vbuf)
+{
+	struct virtio_video_vbuffer *entry;
+
+	list_for_each_entry(entry, &vvd->pending_vbuf_list, pending_list_entry)
+	{
+		if (entry == vbuf && entry->id == vbuf->id)
+			return true;
+	}
+
+	return false;
+}
+
+/* Frees a command on no list, apart from the data it was given. */
+static void put_vbuf(struct virtio_video_device *vvd,
+		     struct virtio_video_vbuffer *vbuf)
+{
+	if (vbuf->resp_buf != vbuf->buf + vbuf->size)
+		kfree(vbuf->resp_buf);
+	kmem_cache_free(vvd->vbufs, vbuf);
+}
+
+static void free_vbuf(struct virtio_video_device *vvd,
+		      struct virtio_video_vbuffer *vbuf)
+{
+	list_del(&vbuf->pending_list_entry);
+	virtio_video_payload_free(vbuf->payload);
+	put_vbuf(vvd, vbuf);
+}
+
+void virtio_video_cmd_cb(struct virtqueue *vq)
+{
+	struct virtio_video_device *vvd = vq->vdev->priv;
+	struct virtio_video_vbuffer *vbuf;
+	unsigned long flags;
+	unsigned int len;
+
+	spin_lock_irqsave(&vvd->commandq.qlock, flags);
+	while (vvd->commandq.ready) {
+		virtqueue_disable_cb(vq);
+
+		while ((vbuf = virtqueue_get_buf(vq, &len))) {
+			if (!vbuf_is_pending(vvd, vbuf))
+				continue;
+
+			/* Nothing waits for an answer its waiter gave up on. */
+			if (vbuf->abandoned) {
+				free_vbuf(vvd, vbuf);
+				continue;
+			}
+
+			vbuf->resp_len = len;
+			if (vbuf->resp_cb)
+				vbuf->resp_cb(vvd, vbuf);
+
+			if (vbuf->is_sync) {
+				vbuf->answered = true;
+				complete(&vbuf->reclaimed);
+			} else {
+				free_vbuf(vvd, vbuf);
+			}
+		}
+
+		if (unlikely(virtqueue_is_broken(vq)))
+			break;
+
+		if (virtqueue_enable_cb(vq))
+			break;
+	}
+	spin_unlock_irqrestore(&vvd->commandq.qlock, flags);
+
+	wake_up(&vvd->commandq.reclaim_queue);
+}
+
+/*
+ * Handling an event sends commands and waits for their answers, so it runs
+ * without the queue lock; the queue is touched only under it, while it is
+ * still ready.
+ */
+void virtio_video_process_events(struct work_struct *work)
+{
+	struct virtio_video_device *vvd = container_of(work,
+			struct virtio_video_device, eventq.work);
+	struct virtqueue *vq;
+	struct virtio_video_event *evt;
+	unsigned int len;
+
+	mutex_lock(&vvd->eventq.lock);
+	while (vvd->eventq.ready) {
+		vq = vvd->eventq.vq;
+		virtqueue_disable_cb(vq);
+
+		while ((evt = virtqueue_get_buf(vq, &len))) {
+			mutex_unlock(&vvd->eventq.lock);
+			if (len == sizeof(*evt))
+				virtio_video_handle_event(vvd, evt);
+			mutex_lock(&vvd->eventq.lock);
+			if (!vvd->eventq.ready)
+				goto out;
+			virtio_video_queue_event_buffer(vvd, evt);
+		}
+
+		if (unlikely(virtqueue_is_broken(vq)))
+			break;
+
+		if (virtqueue_enable_cb(vq))
+			break;
+	}
+out:
+	mutex_unlock(&vvd->eventq.lock);
+}
+
+void virtio_video_event_cb(struct virtqueue *vq)
+{
+	struct virtio_video_device *vvd = vq->vdev->priv;
+
+	schedule_work(&vvd->eventq.work);
+}
+
+static struct virtio_video_vbuffer *
+virtio_video_get_vbuf(struct virtio_video_device *vvd, int size, int resp_size,
+		      void *resp_buf, virtio_video_resp_cb resp_cb)
+{
+	struct virtio_video_vbuffer *vbuf;
+
+	vbuf = kmem_cache_alloc(vvd->vbufs, GFP_KERNEL);
+	if (!vbuf)
+		return ERR_PTR(-ENOMEM);
+	memset(vbuf, 0, VBUFFER_SIZE);
+
+	BUG_ON(size > MAX_INLINE_CMD_SIZE);
+	vbuf->buf = (void *)vbuf + sizeof(*vbuf);
+	vbuf->size = size;
+
+	vbuf->resp_cb = resp_cb;
+	vbuf->resp_size = resp_size;
+	/* Only a synchronous command may name a buffer of its caller. */
+	vbuf->caller_resp = resp_buf;
+	if (resp_size <= MAX_INLINE_RESP_SIZE) {
+		vbuf->resp_buf = vbuf->buf + size;
+	} else {
+		vbuf->resp_buf = kzalloc(resp_size, GFP_KERNEL);
+		if (!vbuf->resp_buf) {
+			kmem_cache_free(vvd->vbufs, vbuf);
+			return ERR_PTR(-ENOMEM);
+		}
+	}
+
+	return vbuf;
+}
+
+int virtio_video_alloc_vbufs(struct virtio_video_device *vvd)
+{
+	vvd->vbufs =
+		kmem_cache_create("virtio-video-vbufs", VBUFFER_SIZE,
+				  __alignof__(struct virtio_video_vbuffer), 0,
+				  NULL);
+	if (!vvd->vbufs)
+		return -ENOMEM;
+
+	return 0;
+}
+
+/*
+ * Stop both queues and delete them, once the device can no longer use a
+ * buffer it was given. A transport's reset need not reach the device
+ * itself: vhost-user's does not, and only disabling the rings in del_vqs()
+ * makes the backend drop what it holds. Nothing the device may still write is
+ * freed before that; virtio_video_cancel_cmds() then returns the commands.
+ */
+void virtio_video_stop_queues(struct virtio_video_device *vvd)
+{
+	struct virtio_device *vdev = vvd->vdev;
+	unsigned long flags;
+
+	spin_lock_irqsave(&vvd->commandq.qlock, flags);
+	vvd->commandq.ready = false;
+	spin_unlock_irqrestore(&vvd->commandq.qlock, flags);
+	wake_up_all(&vvd->commandq.reclaim_queue);
+
+	mutex_lock(&vvd->eventq.lock);
+	vvd->eventq.ready = false;
+	mutex_unlock(&vvd->eventq.lock);
+
+	virtio_reset_device(vdev);
+	vdev->config->del_vqs(vdev);
+	vvd->commandq.vq = NULL;
+	vvd->eventq.vq = NULL;
+}
+
+/*
+ * Answer every command still pending as the device would answer one it could
+ * not complete: with an empty response. A response callback sees a failed
+ * command, so a queued buffer returns to vb2 in error; a synchronous command
+ * wakes its waiter, which frees it, and any other is freed here, as is one
+ * whose waiter gave up on it.
+ */
+void virtio_video_cancel_cmds(struct virtio_video_device *vvd)
+{
+	struct virtio_video_vbuffer *vbuf, *next;
+	unsigned long flags;
+
+	spin_lock_irqsave(&vvd->commandq.qlock, flags);
+	list_for_each_entry_safe(vbuf, next, &vvd->pending_vbuf_list,
+				 pending_list_entry) {
+		/* Its waiter already has its answer, and frees it. */
+		if (vbuf->answered)
+			continue;
+		if (vbuf->abandoned) {
+			free_vbuf(vvd, vbuf);
+			continue;
+		}
+
+		vbuf->resp_len = 0;
+		if (vbuf->resp_cb)
+			vbuf->resp_cb(vvd, vbuf);
+
+		if (vbuf->is_sync) {
+			vbuf->answered = true;
+			complete(&vbuf->reclaimed);
+		} else {
+			free_vbuf(vvd, vbuf);
+		}
+	}
+	spin_unlock_irqrestore(&vvd->commandq.qlock, flags);
+}
+
+/* Every command buffer has been freed, and the queues are gone. */
+void virtio_video_free_vbufs(struct virtio_video_device *vvd)
+{
+	kmem_cache_destroy(vvd->vbufs);
+	vvd->vbufs = NULL;
+
+	kfree(vvd->evts);
+	vvd->evts = NULL;
+}
+
+static void *virtio_video_alloc_req(struct virtio_video_device *vvd,
+				    struct virtio_video_vbuffer **vbuffer_p,
+				    int size)
+{
+	struct virtio_video_vbuffer *vbuf;
+
+	vbuf = virtio_video_get_vbuf(vvd, size,
+				     sizeof(struct virtio_video_cmd_hdr),
+				     NULL, NULL);
+	if (IS_ERR(vbuf)) {
+		*vbuffer_p = NULL;
+		return ERR_CAST(vbuf);
+	}
+	*vbuffer_p = vbuf;
+
+	return vbuf->buf;
+}
+
+static void *
+virtio_video_alloc_req_resp(struct virtio_video_device *vvd,
+			    virtio_video_resp_cb cb,
+			    struct virtio_video_vbuffer **vbuffer_p,
+			    int req_size, int resp_size,
+			    void *resp_buf)
+{
+	struct virtio_video_vbuffer *vbuf;
+
+	vbuf = virtio_video_get_vbuf(vvd, req_size, resp_size, resp_buf, cb);
+	if (IS_ERR(vbuf)) {
+		*vbuffer_p = NULL;
+		return ERR_CAST(vbuf);
+	}
+	*vbuffer_p = vbuf;
+
+	return vbuf->buf;
+}
+
+/*
+ * Whether a command of `descriptors` ring entries can be added, or never will
+ * be because the queue is gone.
+ */
+static bool virtio_video_cmd_room(struct virtio_video_device *vvd,
+				  unsigned int descriptors)
+{
+	unsigned long flags;
+	bool room;
+
+	spin_lock_irqsave(&vvd->commandq.qlock, flags);
+	room = !vvd->commandq.ready ||
+	       vvd->commandq.vq->num_free >= descriptors;
+	spin_unlock_irqrestore(&vvd->commandq.qlock, flags);
+
+	return room;
+}
+
+/*
+ * A command that cannot be queued, because the device is gone or the ring
+ * refused it, is freed here; its payload stays the caller's.
+ */
+static int
+virtio_video_queue_cmd_buffer(struct virtio_video_device *vvd,
+			      struct virtio_video_vbuffer *vbuf)
+{
+	unsigned long flags;
+	struct scatterlist *sgs[3], vreq, vresp;
+	int outcnt = 0, incnt = 0;
+	unsigned int descriptors = 1;
+	int ret;
+
+	sg_init_one(&vreq, vbuf->buf, vbuf->size);
+	sgs[outcnt + incnt] = &vreq;
+	outcnt++;
+
+	/* Every chunk of the payload is a descriptor of its own. */
+	if (vbuf->payload) {
+		sgs[outcnt + incnt] = vbuf->payload->sg;
+		outcnt++;
+		descriptors += vbuf->payload->nr_chunks;
+	}
+
+	if (vbuf->resp_size) {
+		sg_init_one(&vresp, vbuf->resp_buf, vbuf->resp_size);
+		sgs[outcnt + incnt] = &vresp;
+		incnt++;
+		descriptors++;
+	}
+
+	spin_lock_irqsave(&vvd->commandq.qlock, flags);
+	for (;;) {
+		if (!vvd->commandq.ready) {
+			ret = -ENODEV;
+			break;
+		}
+		/*
+		 * A command longer than the ring would wait for room that never
+		 * comes. The ring is only there while the queue is ready.
+		 */
+		if (descriptors > virtqueue_get_vring_size(vvd->commandq.vq)) {
+			ret = -EINVAL;
+			break;
+		}
+		ret = virtqueue_add_sgs(vvd->commandq.vq, sgs, outcnt, incnt,
+					vbuf, GFP_ATOMIC);
+		if (ret != -ENOSPC)
+			break;
+		spin_unlock_irqrestore(&vvd->commandq.qlock, flags);
+		wait_event(vvd->commandq.reclaim_queue,
+			   virtio_video_cmd_room(vvd, descriptors));
+		spin_lock_irqsave(&vvd->commandq.qlock, flags);
+	}
+	if (!ret) {
+		/* Under the lock, so the answer cannot arrive before this. */
+		vbuf->id = vvd->vbufs_sent++;
+		list_add_tail(&vbuf->pending_list_entry,
+			      &vvd->pending_vbuf_list);
+		virtqueue_kick(vvd->commandq.vq);
+	}
+	spin_unlock_irqrestore(&vvd->commandq.qlock, flags);
+
+	if (ret)
+		put_vbuf(vvd, vbuf);
+
+	return ret;
+}
+
+static int
+virtio_video_queue_cmd_buffer_sync(struct virtio_video_device *vvd,
+				   struct virtio_video_vbuffer *vbuf)
+{
+	unsigned long flags;
+	bool answered, gone;
+	int ret;
+
+	vbuf->is_sync = true;
+	init_completion(&vbuf->reclaimed);
+
+	ret = virtio_video_queue_cmd_buffer(vvd, vbuf);
+	if (ret)
+		return ret;
+
+	wait_for_completion_timeout(&vbuf->reclaimed, 5 * HZ);
+
+	spin_lock_irqsave(&vvd->commandq.qlock, flags);
+	answered = vbuf->answered;
+	if (answered)
+		list_del(&vbuf->pending_list_entry);
+	else
+		/*
+		 * The device still has it and may yet answer, into memory the
+		 * command owns: whoever takes it back frees it.
+		 */
+		vbuf->abandoned = true;
+	/* A command the removal cancelled has no answer. */
+	gone = !vvd->commandq.ready;
+	spin_unlock_irqrestore(&vvd->commandq.qlock, flags);
+
+	if (!answered)
+		return gone ? -ENODEV : -ETIMEDOUT;
+
+	ret = gone ? -ENODEV : 0;
+	if (!ret && vbuf->caller_resp)
+		memcpy(vbuf->caller_resp, vbuf->resp_buf, vbuf->resp_size);
+	virtio_video_payload_free(vbuf->payload);
+	put_vbuf(vvd, vbuf);
+
+	return ret;
+}
+
+static int virtio_video_queue_event_buffer(struct virtio_video_device *vvd,
+					   struct virtio_video_event *evt)
+{
+	int ret;
+	struct scatterlist sg;
+	struct virtqueue *vq = vvd->eventq.vq;
+
+	memset(evt, 0, sizeof(struct virtio_video_event));
+	sg_init_one(&sg, evt, sizeof(struct virtio_video_event));
+
+	ret = virtqueue_add_inbuf(vq, &sg, 1, evt, GFP_KERNEL);
+	if (ret) {
+		v4l2_err(&vvd->v4l2_dev, "failed to queue event buffer\n");
+		return ret;
+	}
+
+	virtqueue_kick(vq);
+
+	return 0;
+}
+
+static void virtio_video_handle_event(struct virtio_video_device *vvd,
+				      struct virtio_video_event *evt)
+{
+	struct virtio_video_stream *stream;
+	uint32_t stream_id = evt->stream_id;
+	struct video_device *vd = &vvd->video_dev;
+
+	mutex_lock(vd->lock);
+
+	stream = idr_find(&vvd->stream_idr, stream_id);
+	if (!stream) {
+		v4l2_warn(&vvd->v4l2_dev, "stream_id=%u not found for event\n",
+			  stream_id);
+		mutex_unlock(vd->lock);
+		return;
+	}
+
+	switch (le32_to_cpu(evt->event_type)) {
+	case VIRTIO_VIDEO_EVENT_DECODER_RESOLUTION_CHANGED:
+		v4l2_dbg(1, vvd->debug, &vvd->v4l2_dev,
+			 "stream_id=%u: resolution change event\n", stream_id);
+		virtio_video_cmd_get_params(vvd, stream,
+					   VIRTIO_VIDEO_QUEUE_TYPE_OUTPUT);
+		virtio_video_queue_res_chg_event(stream);
+		if (virtio_video_state(stream) == STREAM_STATE_INIT) {
+			virtio_video_state_update(stream,
+						  STREAM_STATE_DYNAMIC_RES_CHANGE);
+			wake_up(&vvd->wq);
+		}
+		break;
+	case VIRTIO_VIDEO_EVENT_ERROR:
+		v4l2_err(&vvd->v4l2_dev, "stream_id=%i: error event\n",
+			 stream_id);
+		virtio_video_state_update(stream, STREAM_STATE_ERROR);
+		virtio_video_handle_error(stream);
+		break;
+	default:
+		v4l2_warn(&vvd->v4l2_dev, "stream_id=%i: unknown event\n",
+			  stream_id);
+		break;
+	}
+
+	mutex_unlock(vd->lock);
+}
+
+int virtio_video_alloc_events(struct virtio_video_device *vvd)
+{
+	int ret;
+	size_t i;
+	struct virtio_video_event *evts;
+	size_t num =  vvd->eventq.vq->num_free;
+
+	evts = kzalloc(num * sizeof(struct virtio_video_event), GFP_KERNEL);
+	if (!evts) {
+		v4l2_err(&vvd->v4l2_dev, "failed to alloc event buffers!!!\n");
+		return -ENOMEM;
+	}
+	vvd->evts = evts;
+
+	for (i = 0; i < num; i++) {
+		ret = virtio_video_queue_event_buffer(vvd, &evts[i]);
+		if (ret) {
+			v4l2_err(&vvd->v4l2_dev,
+				 "failed to queue event buffer\n");
+			return ret;
+		}
+	}
+
+	return 0;
+}
