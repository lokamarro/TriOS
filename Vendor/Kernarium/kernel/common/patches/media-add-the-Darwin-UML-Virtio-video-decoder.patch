+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <linux/dma-buf.h>
+#include <linux/virtio_dma_buf.h>
+#include <media/v4l2-common.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-ioctl.h>
+#include <media/videobuf2-dma-sg.h>
+
+#include "virtio_video.h"
+
+enum video_stream_state virtio_video_state(struct virtio_video_stream *stream)
+{
+	return atomic_read(&stream->state);
+}
+
+void virtio_video_state_reset(struct virtio_video_stream *stream)
+{
+	atomic_set(&stream->state, STREAM_STATE_IDLE);
+}
+
+void virtio_video_state_update(struct virtio_video_stream *stream,
+			       enum video_stream_state new_state)
+{
+	enum video_stream_state prev_state;
+
+	do {
+	    prev_state = atomic_read(&stream->state);
+	    if (prev_state == STREAM_STATE_ERROR)
+		    return;
+	} while (atomic_cmpxchg(&stream->state, prev_state, new_state) !=
+		 prev_state);
+}
+
+int virtio_video_queue_setup(struct vb2_queue *vq, unsigned int *num_buffers,
+			     unsigned int *num_planes, unsigned int sizes[],
+			     struct device *alloc_devs[])
+{
+	int i;
+	struct virtio_video_stream *stream = vb2_get_drv_priv(vq);
+	struct video_format_info *p_info;
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	if (*num_planes)
+		return 0;
+
+	if (V4L2_TYPE_IS_OUTPUT(vq->type))
+		p_info = &stream->in_info;
+	else
+		p_info = &stream->out_info;
+
+	*num_planes = p_info->num_planes;
+
+	for (i = 0; i < p_info->num_planes; i++)
+		sizes[i] = p_info->plane_format[i].plane_size;
+
+	return 0;
+}
+
+/*
+ * A plane's scatter list is written into the command's payload at `base`: a
+ * header with the number of entries, then the entries. Each builder returns
+ * through `size` how many bytes the list takes.
+ */
+static void sglist_header(struct virtio_video_payload *payload, size_t base,
+			  unsigned int num_entries)
+{
+	__le32 num = cpu_to_le32(num_entries);
+
+	virtio_video_payload_write(payload,
+		base + offsetof(struct virtio_video_resource_sg_list,
+				num_entries),
+		&num, sizeof(num));
+}
+
+static void sglist_entry(struct virtio_video_payload *payload, size_t base,
+			 unsigned int index, u64 addr, u32 length, u32 flags)
+{
+	struct virtio_video_resource_sg_entry entry = {
+		.addr = cpu_to_le64(addr),
+		.length = cpu_to_le32(length),
+		.flags = cpu_to_le32(flags),
+	};
+
+	virtio_video_payload_write(payload,
+				   base + VIRTIO_VIDEO_RESOURCE_SG_SIZE(index),
+				   &entry, sizeof(entry));
+}
+
+static unsigned int
+build_virtio_video_sglist_contig(struct virtio_video_payload *payload,
+				 size_t base, struct vb2_buffer *vb,
+				 unsigned int plane)
+{
+	sglist_entry(payload, base, 0,
+		     vb2_dma_contig_plane_dma_addr(vb, plane),
+		     vb->planes[plane].length, 0);
+	sglist_header(payload, base, 1);
+
+	return VIRTIO_VIDEO_RESOURCE_SG_SIZE(1);
+}
+
+static unsigned int
+build_virtio_video_sglist(struct virtio_video_payload *payload, size_t base,
+			  struct vb2_buffer *vb, unsigned int plane,
+			  bool has_iommu)
+{
+	int i;
+	struct scatterlist *sg;
+	struct sg_table *sgt = vb2_dma_sg_plane_desc(vb, plane);
+
+	for_each_sg(sgt->sgl, sg, sgt->nents, i)
+		sglist_entry(payload, base, i,
+			     has_iommu ? sg_dma_address(sg) : sg_phys(sg),
+			     sg->length, 0);
+	sglist_header(payload, base, sgt->nents);
+
+	return VIRTIO_VIDEO_RESOURCE_SG_SIZE(sgt->nents);
+}
+
+/*
+ * An imported buffer starts where the planes before it that share its dma-buf
+ * end: V4L2 carries no per-plane offset on a capture buffer, so planes packed
+ * into one dma-buf follow the negotiated plane sizes.
+ */
+static u64 virtio_video_plane_dmabuf_offset(struct vb2_buffer *vb,
+					    unsigned int plane)
+{
+	u64 offset = 0;
+	unsigned int i;
+
+	for (i = 0; i < plane; i++)
+		if (vb->planes[i].dbuf == vb->planes[plane].dbuf)
+			offset += vb->planes[i].min_length;
+
+	return offset;
+}
+
+/*
+ * A host-visible dma-buf has no guest-physical address at all: it lives in a
+ * virtio shared-memory region, which the host resolves to the same memory its
+ * exporting device published. The importing device is told the region and the
+ * offset instead.
+ */
+static int build_virtio_video_sglist_shm(struct virtio_video_device *vvd,
+					 struct virtio_video_payload *payload,
+					 size_t base, struct vb2_buffer *vb,
+					 unsigned int plane, unsigned int *size)
+{
+	struct dma_buf *dbuf = vb->planes[plane].dbuf;
+	u64 offset, region_offset, region_size;
+	u64 length = vb->planes[plane].min_length;
+	u8 region_id;
+
+	if (!dbuf)
+		return -ENODEV;
+
+	/* Anything that does not name a region is described by addresses. */
+	if (virtio_dma_buf_get_shm_region(dbuf, &region_id, &region_offset,
+					  &region_size))
+		return -ENODEV;
+
+	if (!vvd->supp_shm_region) {
+		v4l2_err(&vvd->v4l2_dev,
+			 "host-visible buffers need VIRTIO_VIDEO_F_RESOURCE_SHM_REGION\n");
+		return -ENOTTY;
+	}
+
+	offset = virtio_video_plane_dmabuf_offset(vb, plane);
+	if (!length || offset > region_size || length > region_size - offset ||
+	    region_offset > U64_MAX - region_size ||
+	    length > U32_MAX)
+		return -EINVAL;
+
+	sglist_entry(payload, base, 0, region_offset + offset, length,
+		     VIRTIO_VIDEO_RESOURCE_SG_FLAG_SHM_REGION |
+		     ((u32)region_id << VIRTIO_VIDEO_RESOURCE_SG_SHM_ID_SHIFT));
+	sglist_header(payload, base, 1);
+	*size = VIRTIO_VIDEO_RESOURCE_SG_SIZE(1);
+
+	return 0;
+}
+
+/*
+ * A buffer this driver allocated as a host-visible blob is named the same way
+ * an imported one is: by its shared-memory region and its offset in it. The
+ * blob is one allocation per plane, so the plane starts where the blob does.
+ */
+static int build_virtio_video_sglist_blob(struct virtio_video_device *vvd,
+					  struct virtio_video_payload *payload,
+					  size_t base, struct vb2_buffer *vb,
+					  unsigned int plane, unsigned int *size)
+{
+	u64 region_offset, region_size;
+	u64 length = vb->planes[plane].min_length;
+	u8 region_id;
+	int ret;
+
+	if (!vvd->supp_shm_region)
+		return -ENOTTY;
+
+	ret = virtio_video_blob_region(vb, plane, &region_id, &region_offset,
+				       &region_size);
+	if (ret)
+		return ret;
+
+	if (!length || length > region_size || length > U32_MAX ||
+	    region_offset > U64_MAX - region_size)
+		return -EINVAL;
+
+	sglist_entry(payload, base, 0, region_offset, length,
+		     VIRTIO_VIDEO_RESOURCE_SG_FLAG_SHM_REGION |
+		     ((u32)region_id << VIRTIO_VIDEO_RESOURCE_SG_SHM_ID_SHIFT));
+	sglist_header(payload, base, 1);
+	*size = VIRTIO_VIDEO_RESOURCE_SG_SIZE(1);
+
+	return 0;
+}
+
+/*
+ * An imported dma-buf's scatter list belongs to its exporter, which may
+ * describe memory that has no struct page. Only the mapped DMA addresses are
+ * meaningful there, and the plane covers exactly its negotiated extent from
+ * its offset in the dma-buf.
+ */
+static int build_virtio_video_sglist_dmabuf(struct virtio_video_device *vvd,
+					    struct virtio_video_payload *payload,
+					    size_t base, struct vb2_buffer *vb,
+					    unsigned int plane, unsigned int *size)
+{
+	struct sg_table *sgt;
+	struct scatterlist *sg;
+	u64 skip, limit, want = vb->planes[plane].min_length;
+	unsigned int i, used = 0;
+	int ret;
+
+	ret = build_virtio_video_sglist_shm(vvd, payload, base, vb, plane,
+					    size);
+	if (ret != -ENODEV)
+		return ret;
+
+	if (!vvd->supp_non_contig) {
+		*size = build_virtio_video_sglist_contig(payload, base, vb,
+							 plane);
+		return 0;
+	}
+
+	sgt = vb2_dma_sg_plane_desc(vb, plane);
+	if (!sgt || !sgt->nents || !want)
+		return -EINVAL;
+
+	/*
+	 * Planes that share a dma-buf follow one another in it, so a plane's
+	 * extent is bounded by the dma-buf and not by the plane's own length,
+	 * which a client may state as that plane's size alone.
+	 */
+	skip = virtio_video_plane_dmabuf_offset(vb, plane);
+	limit = vb->planes[plane].dbuf ? vb->planes[plane].dbuf->size :
+					 vb->planes[plane].length;
+	if (skip > limit || want > limit - skip)
+		return -EINVAL;
+
+	for_each_sgtable_dma_sg(sgt, sg, i) {
+		u64 addr = sg_dma_address(sg);
+		u64 length = sg_dma_len(sg);
+
+		if (skip >= length) {
+			skip -= length;
+			continue;
+		}
+		addr += skip;
+		length -= skip;
+		skip = 0;
+		if (length > want)
+			length = want;
+		if (used == sgt->nents || length > U32_MAX)
+			return -EINVAL;
+		sglist_entry(payload, base, used, addr, length, 0);
+		used++;
+		want -= length;
+		if (!want)
+			break;
+	}
+
+	if (want)
+		return -EINVAL;
+
+	sglist_header(payload, base, used);
+	*size = VIRTIO_VIDEO_RESOURCE_SG_SIZE(used);
+
+	return 0;
+}
+
+static size_t virtio_video_sglist_capacity(struct vb2_buffer *vb,
+					   struct virtio_video_device *vvd)
+{
+	size_t capacity = 0;
+	unsigned int i, nents;
+
+	for (i = 0; i < vb->num_planes; i++) {
+		if (!vvd->supp_non_contig) {
+			nents = 1;
+		} else {
+			struct sg_table *sgt = vb2_dma_sg_plane_desc(vb, i);
+
+			nents = sgt ? sgt->nents : 1;
+			if (!nents)
+				nents = 1;
+		}
+		capacity += VIRTIO_VIDEO_RESOURCE_SG_SIZE(nents);
+	}
+
+	return capacity;
+}
+
+/*
+ * Attaches a buffer to the device by sending the scatter list of each plane,
+ * one after another, as the payload of a RESOURCE_ATTACH command. The list is
+ * proportional to the buffer's runs of pages, so it is built in chunks and
+ * sent as a descriptor each; no allocation here is larger than one chunk.
+ */
+int virtio_video_buf_init(struct vb2_buffer *vb)
+{
+	int ret = 0;
+	struct virtio_video_payload *payload;
+	size_t buf_size = 0, offset = 0;
+	unsigned int i, used, resource_id, nents;
+	struct vb2_queue *vq = vb->vb2_queue;
+	enum v4l2_buf_type queue_type = vq->type;
+	struct virtio_video_stream *stream = vb2_get_drv_priv(vq);
+	struct virtio_video_buffer *virtio_vb = to_virtio_vb(vb);
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	bool blob = vb->memory != VB2_MEMORY_DMABUF &&
+		    vq->mem_ops == &virtio_video_blob_memops;
+
+	if (blob) {
+		buf_size = vb->num_planes * VIRTIO_VIDEO_RESOURCE_SG_SIZE(1);
+	} else if (vb->memory == VB2_MEMORY_DMABUF) {
+		buf_size = virtio_video_sglist_capacity(vb, vvd);
+	} else if (vvd->supp_non_contig) {
+		for (i = 0; i < vb->num_planes; i++) {
+			nents = vb2_dma_sg_plane_desc(vb, i)->nents;
+			buf_size += VIRTIO_VIDEO_RESOURCE_SG_SIZE(nents);
+		}
+	} else {
+		buf_size = vb->num_planes * VIRTIO_VIDEO_RESOURCE_SG_SIZE(1);
+	}
+
+	payload = virtio_video_payload_alloc(buf_size);
+	if (IS_ERR(payload)) {
+		ret = PTR_ERR(payload);
+		if (ret == -EINVAL)
+			v4l2_err(&vvd->v4l2_dev,
+				 "the scatter list of a buffer is %zu bytes\n",
+				 buf_size);
+		return ret;
+	}
+
+	for (i = 0; i < vb->num_planes; i++) {
+		if (blob) {
+			ret = build_virtio_video_sglist_blob(vvd, payload,
+							     offset, vb, i,
+							     &used);
+		} else if (vb->memory == VB2_MEMORY_DMABUF) {
+			ret = build_virtio_video_sglist_dmabuf(vvd, payload,
+							       offset, vb, i,
+							       &used);
+		} else if (vvd->supp_non_contig) {
+			used = build_virtio_video_sglist(payload, offset, vb, i,
+							 vvd->has_iommu);
+		} else {
+			used = build_virtio_video_sglist_contig(payload,
+								offset, vb, i);
+		}
+		if (ret) {
+			virtio_video_payload_free(payload);
+			return ret;
+		}
+		offset += used;
+	}
+	/* A plane may need fewer entries than its buffer has runs of pages. */
+	if (offset < buf_size)
+		virtio_video_payload_trim(payload, offset);
+
+	virtio_video_resource_id_get(vvd, &resource_id);
+
+	ret = virtio_video_cmd_resource_attach(vvd, stream->stream_id,
+					       resource_id,
+					       to_virtio_queue_type(queue_type),
+					       payload);
+	if (ret) {
+		virtio_video_resource_id_put(vvd, resource_id);
+		virtio_video_payload_free(payload);
+		return ret;
+	}
+
+	virtio_vb->queued = false;
+	virtio_vb->resource_id = resource_id;
+
+	return 0;
+}
+
+void virtio_video_buf_cleanup(struct vb2_buffer *vb)
+{
+	struct virtio_video_stream *stream = vb2_get_drv_priv(vb->vb2_queue);
+	struct virtio_video_buffer *virtio_vb = to_virtio_vb(vb);
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+
+	virtio_video_resource_id_put(vvd, virtio_vb->resource_id);
+}
+
+void virtio_video_buf_queue(struct vb2_buffer *vb)
+{
+	int i, ret;
+	struct virtio_video_buffer *virtio_vb;
+	uint32_t data_size[VB2_MAX_PLANES] = {0};
+	struct virtio_video_stream *stream = vb2_get_drv_priv(vb->vb2_queue);
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+
+	for (i = 0; i < vb->num_planes; ++i)
+		data_size[i] = vb->planes[i].bytesused;
+
+	virtio_vb = to_virtio_vb(vb);
+
+	ret = virtio_video_cmd_resource_queue(vvd, stream->stream_id,
+					      virtio_vb, data_size,
+					      vb->num_planes,
+					      to_virtio_queue_type(vb->type));
+	if (ret) {
+		/* Nothing else would ever return it, so its queue never stops. */
+		if (ret != -ENODEV)
+			v4l2_err(&vvd->v4l2_dev, "failed to queue buffer\n");
+		virtio_video_buf_done(virtio_vb, VIRTIO_VIDEO_DEQUEUE_FLAG_ERR, 0);
+		return;
+	}
+
+	virtio_vb->queued = true;
+}
+
+int virtio_video_qbuf(struct file *file, void *priv,
+		      struct v4l2_buffer *buf)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	return v4l2_m2m_ioctl_qbuf(file, priv, buf);
+}
+
+int virtio_video_dqbuf(struct file *file, void *priv,
+		       struct v4l2_buffer *buf)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	return v4l2_m2m_ioctl_dqbuf(file, priv, buf);
+}
+
+int virtio_video_querycap(struct file *file, void *fh,
+			  struct v4l2_capability *cap)
+{
+	struct video_device *video_dev = video_devdata(file);
+	struct virtio_video_device *vvd = video_drvdata(file);
+
+	if (strscpy(cap->driver, DRIVER_NAME, sizeof(cap->driver)) < 0)
+		v4l2_err(&vvd->v4l2_dev, "failed to copy driver name\n");
+	if (strscpy(cap->card, video_dev->name, sizeof(cap->card)) < 0)
+		v4l2_err(&vvd->v4l2_dev, "failed to copy card name\n");
+
+	snprintf(cap->bus_info, sizeof(cap->bus_info), "virtio:%s",
+		 video_dev->name);
+
+	cap->device_caps = video_dev->device_caps;
+	return 0;
+}
+
+int virtio_video_enum_framesizes(struct file *file, void *fh,
+				 struct v4l2_frmsizeenum *f)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct video_format *fmt;
+	struct video_format_frame *frm;
+	struct virtio_video_format_frame *frame;
+	int idx = f->index;
+
+	fmt = virtio_video_find_video_format(&vvd->input_fmt_list,
+					     f->pixel_format);
+	if (fmt == NULL)
+		fmt = virtio_video_find_video_format(&vvd->output_fmt_list,
+						     f->pixel_format);
+	if (fmt == NULL)
+		return -EINVAL;
+
+	if (idx >= fmt->desc.num_frames)
+		return -EINVAL;
+
+	frm = &fmt->frames[idx];
+	frame = &frm->frame;
+
+	if (frame->width.min == frame->width.max &&
+	    frame->height.min == frame->height.max) {
+		f->type = V4L2_FRMSIZE_TYPE_DISCRETE;
+		f->discrete.width = frame->width.min;
+		f->discrete.height = frame->height.min;
+		return 0;
+	}
+
+	/* A continuous range is a stepwise range whose step is one, and the
+	 * two carry the same information. Report the stepwise form: a client
+	 * that reads only that one, as Chromium's V4L2 decoder does, otherwise
+	 * keeps a built-in maximum coded size and refuses a larger stream
+	 * before it ever opens a decoder.
+	 */
+	f->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	f->stepwise.min_width = frame->width.min;
+	f->stepwise.max_width = frame->width.max;
+	f->stepwise.min_height = frame->height.min;
+	f->stepwise.max_height = frame->height.max;
+	f->stepwise.step_width = frame->width.step ? frame->width.step : 1;
+	f->stepwise.step_height = frame->height.step ? frame->height.step : 1;
+	return 0;
+}
+
+static bool in_stepped_interval(struct virtio_video_format_range range,
+				uint32_t point)
+{
+	if (point < range.min || point > range.max)
+		return false;
+
+	if (range.step == 0 && range.min == range.max && range.min == point)
+		return true;
+
+	if (range.step != 0 && (point - range.min) % range.step == 0)
+		return true;
+
+	return false;
+}
+
+int virtio_video_enum_framemintervals(struct file *file, void *fh,
+				      struct v4l2_frmivalenum *f)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct video_format *fmt;
+	struct video_format_frame *frm;
+	struct virtio_video_format_frame *frame;
+	struct virtio_video_format_range *frate;
+	int idx = f->index;
+	int f_idx;
+
+	fmt = virtio_video_find_video_format(&vvd->input_fmt_list,
+					     f->pixel_format);
+	if (fmt == NULL)
+		fmt = virtio_video_find_video_format(&vvd->output_fmt_list,
+						     f->pixel_format);
+	if (fmt == NULL)
+		return -EINVAL;
+
+	frm = NULL;
+	for (f_idx = 0; f_idx < fmt->desc.num_frames; f_idx++) {
+		frame = &fmt->frames[f_idx].frame;
+		if (in_stepped_interval(frame->width, f->width) &&
+		    in_stepped_interval(frame->height, f->height)) {
+			frm = &fmt->frames[f_idx];
+			break;
+		}
+	}
+
+	if (!frm || f->index >= frm->frame.num_rates)
+		return -EINVAL;
+
+	frate = &frm->frame_rates[idx];
+	if (frate->max == frate->min) {
+		f->type = V4L2_FRMIVAL_TYPE_DISCRETE;
+		f->discrete.numerator = 1;
+		f->discrete.denominator = frate->max;
+	} else {
+		f->stepwise.min.numerator = 1;
+		f->stepwise.min.denominator = frate->max;
+		f->stepwise.max.numerator = 1;
+		f->stepwise.max.denominator = frate->min;
+		f->stepwise.step.numerator = 1;
+		f->stepwise.step.denominator = frate->step;
+		if (frate->step == 1)
+			f->type = V4L2_FRMIVAL_TYPE_CONTINUOUS;
+		else
+			f->type = V4L2_FRMIVAL_TYPE_STEPWISE;
+	}
+	return 0;
+}
+
+int virtio_video_stream_get_params(struct virtio_video_device *vvd,
+				   struct virtio_video_stream *stream)
+{
+	int ret;
+
+	ret = virtio_video_cmd_get_params(vvd, stream,
+					  VIRTIO_VIDEO_QUEUE_TYPE_INPUT);
+	if (ret) {
+		v4l2_err(&vvd->v4l2_dev, "failed to get stream in params\n");
+		return ret;
+	}
+
+	ret = virtio_video_cmd_get_params(vvd, stream,
+					  VIRTIO_VIDEO_QUEUE_TYPE_OUTPUT);
+	if (ret)
+		v4l2_err(&vvd->v4l2_dev, "failed to get stream out params\n");
+
+	return ret;
+}
+
+int virtio_video_stream_get_controls(struct virtio_video_device *vvd,
+				     struct virtio_video_stream *stream)
+{
+	int ret;
+
+	ret = virtio_video_cmd_get_control(vvd, stream,
+					   VIRTIO_VIDEO_CONTROL_PROFILE);
+	if (ret) {
+		v4l2_err(&vvd->v4l2_dev, "failed to get stream profile\n");
+		goto err_get_ctrl;
+	}
+
+	ret = virtio_video_cmd_get_control(vvd, stream,
+					   VIRTIO_VIDEO_CONTROL_LEVEL);
+	if (ret) {
+		v4l2_err(&vvd->v4l2_dev, "failed to get stream level\n");
+		goto err_get_ctrl;
+	}
+
+	ret = virtio_video_cmd_get_control(vvd, stream,
+					   VIRTIO_VIDEO_CONTROL_BITRATE);
+	if (ret)
+		v4l2_err(&vvd->v4l2_dev, "failed to get stream bitrate\n");
+
+err_get_ctrl:
+	return ret;
+}
+
+int virtio_video_g_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct video_format_info *info;
+	struct v4l2_pix_format_mplane *pix_mp = &f->fmt.pix_mp;
+	struct virtio_video_stream *stream = file2stream(file);
+
+	if (!V4L2_TYPE_IS_OUTPUT(f->type))
+		info = &stream->out_info;
+	else
+		info = &stream->in_info;
+
+	virtio_video_format_from_info(info, pix_mp);
+
+	return 0;
+}
+
+int virtio_video_s_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	int i, ret;
+	struct virtio_video_stream *stream = file2stream(file);
+	struct v4l2_pix_format_mplane *pix_mp = &f->fmt.pix_mp;
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct video_format_info info;
+	struct video_format_info *p_info;
+	uint32_t queue;
+
+	ret = virtio_video_try_fmt(stream, f);
+	if (ret)
+		return ret;
+
+	if (V4L2_TYPE_IS_OUTPUT(f->type)) {
+		virtio_video_format_fill_default_info(&info, &stream->in_info);
+		queue = VIRTIO_VIDEO_QUEUE_TYPE_INPUT;
+	} else {
+		virtio_video_format_fill_default_info(&info, &stream->out_info);
+		queue = VIRTIO_VIDEO_QUEUE_TYPE_OUTPUT;
+	}
+
+	info.frame_width = pix_mp->width;
+	info.frame_height = pix_mp->height;
+	info.num_planes = pix_mp->num_planes;
+	info.fourcc_format = pix_mp->pixelformat;
+
+	for (i = 0; i < info.num_planes; i++) {
+		info.plane_format[i].stride =
+					 pix_mp->plane_fmt[i].bytesperline;
+		info.plane_format[i].plane_size =
+					 pix_mp->plane_fmt[i].sizeimage;
+	}
+
+	virtio_video_cmd_set_params(vvd, stream, &info, queue);
+	virtio_video_stream_get_params(vvd, stream);
+
+	if (V4L2_TYPE_IS_OUTPUT(f->type))
+		p_info = &stream->in_info;
+	else
+		p_info = &stream->out_info;
+
+	virtio_video_format_from_info(p_info, pix_mp);
+
+	return 0;
+}
+
+int virtio_video_g_selection(struct file *file, void *fh,
+			 struct v4l2_selection *sel)
+{
+	struct video_format_info *info;
+	struct virtio_video_stream *stream = file2stream(file);
+	struct virtio_video_device *vvd = video_drvdata(file);
+
+	if (V4L2_TYPE_IS_OUTPUT(sel->type))
+		return -EINVAL;
+	info = &stream->out_info;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_COMPOSE:
+	case V4L2_SEL_TGT_COMPOSE_BOUNDS:
+	case V4L2_SEL_TGT_COMPOSE_PADDED:
+	case V4L2_SEL_TGT_COMPOSE_DEFAULT:
+		sel->r.width = info->frame_width;
+		sel->r.height = info->frame_height;
+		break;
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP:
+		sel->r.top = info->crop.top;
+		sel->r.left = info->crop.left;
+		sel->r.width = info->frame_width;
+		sel->r.height = info->frame_height;
+		break;
+	default:
+		v4l2_dbg(1, vvd->debug, &vvd->v4l2_dev,
+			 "unsupported/invalid selection target: %d\n",
+			 sel->target);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+int virtio_video_try_fmt(struct virtio_video_stream *stream,
+			 struct v4l2_format *f)
+{
+	int i, idx = 0;
+	struct v4l2_pix_format_mplane *pix_mp = &f->fmt.pix_mp;
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct video_format *fmt;
+	bool found = false;
+	struct video_format_frame *frm;
+	struct virtio_video_format_frame *frame;
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	if (V4L2_TYPE_IS_OUTPUT(f->type))
+		fmt = virtio_video_find_video_format(&vvd->input_fmt_list,
+						     pix_mp->pixelformat);
+	else
+		fmt = virtio_video_find_video_format(&vvd->output_fmt_list,
+						     pix_mp->pixelformat);
+
+	if (!fmt) {
+		if (f->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE)
+			virtio_video_format_from_info(&stream->out_info,
+						      pix_mp);
+		else if (f->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE)
+			virtio_video_format_from_info(&stream->in_info,
+						      pix_mp);
+		else
+			return -EINVAL;
+		return 0;
+	}
+
+	for (i = 0; i < fmt->desc.num_frames && !found; i++) {
+		frm = &fmt->frames[i];
+		frame = &frm->frame;
+		if (!within_range(frame->width.min, pix_mp->width,
+				  frame->width.max))
+			continue;
+
+		if (!within_range(frame->height.min, pix_mp->height,
+				  frame->height.max))
+			continue;
+		idx = i;
+		/*
+		 * Try to find a more suitable frame size. Go with the current
+		 * one otherwise.
+		 */
+		if (needs_alignment(pix_mp->width, frame->width.step))
+			continue;
+
+		if (needs_alignment(pix_mp->height, frame->height.step))
+			continue;
+
+		stream->current_frame = frm;
+		found = true;
+	}
+
+	if (!found) {
+		frm = &fmt->frames[idx];
+		if (!frm)
+			return -EINVAL;
+
+		frame = &frm->frame;
+		pix_mp->width = clamp(pix_mp->width, frame->width.min,
+				      frame->width.max);
+		if (frame->width.step != 0)
+			pix_mp->width = ALIGN(pix_mp->width, frame->width.step);
+
+		pix_mp->height = clamp(pix_mp->height, frame->height.min,
+				       frame->height.max);
+		if (frame->height.step != 0)
+			pix_mp->height = ALIGN(pix_mp->height,
+					       frame->height.step);
+		stream->current_frame = frm;
+	}
+
+	/*
+	 * A resolved format has to come back with the plane layout S_FMT would
+	 * produce. A client that filters its candidates with TRY_FMT, as
+	 * Chromium's V4L2 decoder does, drops a capture format whose plane
+	 * count or strides disagree with the ones G_FMT reports for it. The
+	 * device lays a raw picture out at the pitch a guest allocator gives
+	 * its buffers (virtio_video_fill_raw_layout()), so that rule answers
+	 * without a round trip to it. A format the rule does not describe takes
+	 * the V4L2 core's table, and failing that keeps the plane count the
+	 * stream carries. A coded format has no plane layout and stays the
+	 * single buffer the input queue accepts.
+	 */
+	if (V4L2_TYPE_IS_OUTPUT(f->type)) {
+		u32 packet = stream->in_info.plane_format[0].plane_size;
+
+		pix_mp->num_planes = 1;
+		pix_mp->plane_fmt[0].bytesperline = 0;
+		if (pix_mp->plane_fmt[0].sizeimage < packet)
+			pix_mp->plane_fmt[0].sizeimage = packet;
+	} else if (virtio_video_fill_raw_layout(pix_mp, pix_mp->pixelformat,
+						pix_mp->width,
+						pix_mp->height) &&
+		   v4l2_fill_pixfmt_mp(pix_mp, pix_mp->pixelformat,
+				       pix_mp->width, pix_mp->height) < 0) {
+		pix_mp->num_planes = stream->out_info.num_planes;
+	}
+
+	return 0;
+}
+
+static int virtio_video_queue_free(struct virtio_video_device *vvd,
+				   struct virtio_video_stream *stream,
+				   enum v4l2_buf_type type)
+{
+	int ret;
+	enum virtio_video_queue_type queue_type = to_virtio_queue_type(type);
+
+	ret = virtio_video_cmd_queue_detach_resources(vvd, stream, queue_type);
+	if (ret) {
+		v4l2_warn(&vvd->v4l2_dev,
+			  "failed to destroy resources\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+int virtio_video_reqbufs(struct file *file, void *priv,
+			 struct v4l2_requestbuffers *rb)
+{
+	int ret;
+	struct virtio_video_stream *stream = file2stream(file);
+	struct v4l2_m2m_ctx *m2m_ctx = stream->fh.m2m_ctx;
+	struct virtio_video_device *vvd = video_drvdata(file);
+	struct vb2_queue *vq = v4l2_m2m_get_vq(m2m_ctx, rb->type);
+
+	if (rb->count == 0) {
+		ret = virtio_video_queue_free(vvd, stream, vq->type);
+		if (ret < 0)
+			return ret;
+	}
+
+	return v4l2_m2m_reqbufs(file, m2m_ctx, rb);
+}
