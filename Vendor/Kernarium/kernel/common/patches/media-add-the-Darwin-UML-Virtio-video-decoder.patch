+
+/*
+ * The layout the device gives a raw picture in a guest buffer. Its rows lie at
+ * the pitch a guest allocator gives a buffer the host GPU samples, a multiple
+ * of 16 bytes (of 32 for planar luma, with half of that for each chroma
+ * plane), and the plane heights stay tight, so a plane starts where the rows
+ * of the earlier planes end. The device states this layout in the plane
+ * formats it negotiates, so S_FMT and G_FMT report it and TRY_FMT has to
+ * predict it: a client that compares the two rejects a format whose strides
+ * appear only once it is set. The rule is the device's (raw_pitch.hpp in the
+ * host), the strides are what the device answers once the format is set, and
+ * a format the device does not lay out like this returns -ENOENT for the
+ * caller to describe.
+ */
+int virtio_video_fill_raw_layout(struct v4l2_pix_format_mplane *pix_mp,
+				 u32 fourcc, u32 width, u32 height)
+{
+	const struct v4l2_format_info *info = v4l2_format_info(fourcc);
+	struct {
+		u64 stride;
+		u64 rows;
+	} comp[3];
+	u32 chroma_rows = DIV_ROUND_UP(height, 2);
+	unsigned int comps, i;
+	u64 size;
+
+	if (!info)
+		return -ENOENT;
+
+	switch (fourcc) {
+	case V4L2_PIX_FMT_NV12:
+	case V4L2_PIX_FMT_NV12M:
+	case V4L2_PIX_FMT_NV21:
+	case V4L2_PIX_FMT_NV21M:
+		comps = 2;
+		comp[0].stride = ALIGN(width, 16);
+		comp[0].rows = height;
+		comp[1].stride = comp[0].stride;
+		comp[1].rows = chroma_rows;
+		break;
+	case V4L2_PIX_FMT_YUV420:
+	case V4L2_PIX_FMT_YUV420M:
+	case V4L2_PIX_FMT_YVU420:
+	case V4L2_PIX_FMT_YVU420M:
+		comps = 3;
+		comp[0].stride = ALIGN(width, 32);
+		comp[0].rows = height;
+		comp[1].stride = comp[0].stride / 2;
+		comp[1].rows = chroma_rows;
+		comp[2] = comp[1];
+		break;
+	case V4L2_PIX_FMT_P010:
+		comps = 2;
+		comp[0].stride = ALIGN((u64)width * 2, 16);
+		comp[0].rows = height;
+		comp[1].stride = comp[0].stride;
+		comp[1].rows = chroma_rows;
+		break;
+	case V4L2_PIX_FMT_NV16:
+	case V4L2_PIX_FMT_NV16M:
+		comps = 2;
+		comp[0].stride = ALIGN(width, 16);
+		comp[0].rows = height;
+		comp[1].stride = comp[0].stride;
+		comp[1].rows = height;
+		break;
+	case V4L2_PIX_FMT_NV24:
+		comps = 2;
+		comp[0].stride = ALIGN(width, 16);
+		comp[0].rows = height;
+		comp[1].stride = ALIGN((u64)width * 2, 16);
+		comp[1].rows = height;
+		break;
+	case V4L2_PIX_FMT_ABGR32:
+	case V4L2_PIX_FMT_ARGB32:
+	case V4L2_PIX_FMT_RGB32:
+	case V4L2_PIX_FMT_RGBA32:
+		comps = 1;
+		comp[0].stride = ALIGN((u64)width * 4, 16);
+		comp[0].rows = height;
+		break;
+	default:
+		return -ENOENT;
+	}
+
+	/* One buffer for all the planes, or one for each. */
+	if (info->mem_planes != 1 && info->mem_planes != comps)
+		return -ENOENT;
+
+	for (i = 0; i < comps; i++)
+		if (comp[i].stride * comp[i].rows > U32_MAX || comp[i].stride > U32_MAX)
+			return -EINVAL;
+
+	memset(pix_mp->plane_fmt, 0, sizeof(pix_mp->plane_fmt));
+	pix_mp->width = width;
+	pix_mp->height = height;
+	pix_mp->pixelformat = fourcc;
+	pix_mp->num_planes = info->mem_planes;
+	if (info->mem_planes == 1) {
+		for (size = 0, i = 0; i < comps; i++)
+			size += comp[i].stride * comp[i].rows;
+		if (size > U32_MAX)
+			return -EINVAL;
+		pix_mp->plane_fmt[0].bytesperline = comp[0].stride;
+		pix_mp->plane_fmt[0].sizeimage = size;
+	} else {
+		for (i = 0; i < comps; i++) {
+			pix_mp->plane_fmt[i].bytesperline = comp[i].stride;
+			pix_mp->plane_fmt[i].sizeimage = comp[i].stride * comp[i].rows;
+		}
+	}
+
+	return 0;
+}
