From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 19 Oct 2026 10:42:31 +0900
Subject: [PATCH] PM: sleep: keep a wakeup signaled while a suspend syncs file
 systems

pm_system_wakeup() aborts a suspend at the PM core's next wakeup check,
but freeze_processes() discards every wakeup signaled before it runs.
A system suspend syncs file systems and runs its PM_SUSPEND_PREPARE
notifiers before it freezes tasks, so a wakeup signaled meanwhile was
lost and the system went to sleep anyway.  A sync of much dirty data
holds that window open for seconds.

Discard earlier wakeups when the suspend begins instead, as
enter_state() takes system_transition_mutex, and let the suspend's
freezing keep the ones signaled since then.  Check for one right after
the sync, so that the suspend ends before it notifies or freezes
anything.  Hibernation and the other callers of freeze_processes()
still discard wakeups as they freeze.
---
 include/linux/freezer.h |  2 ++
 kernel/power/power.h    |  5 +++--
 kernel/power/process.c  | 23 +++++++++++++++++++----
 kernel/power/suspend.c  | 14 ++++++++++++++
 4 files changed, 38 insertions(+), 6 deletions(-)

diff --git a/include/linux/freezer.h b/include/linux/freezer.h
index 32884c9721e5646fc1dcb9bfea54f382aef0b801..d84d167c8dd1c391067edec693b14b75167d7578 100644
--- a/include/linux/freezer.h
+++ b/include/linux/freezer.h
@@ -43,6 +43,7 @@ static inline bool freezing(struct task_struct *p)
 extern void __thaw_task(struct task_struct *t);
 
 extern bool __refrigerator(bool check_kthr_stop);
+extern int __freeze_processes(bool discard_wakeups);
 extern int freeze_processes(void);
 extern int freeze_kernel_threads(void);
 extern void thaw_processes(void);
@@ -77,6 +78,7 @@ static inline bool freezing(struct task_struct *p) { return false; }
 static inline void __thaw_task(struct task_struct *t) {}
 
 static inline bool __refrigerator(bool check_kthr_stop) { return false; }
+static inline int __freeze_processes(bool discard_wakeups) { return -ENOSYS; }
 static inline int freeze_processes(void) { return -ENOSYS; }
 static inline int freeze_kernel_threads(void) { return -ENOSYS; }
 static inline void thaw_processes(void) {}
diff --git a/kernel/power/power.h b/kernel/power/power.h
index 7ccd709af93f5fe123bc8c18e022c2900e991ae1..04b347662a1db26d32644553536060c681dbaa54 100644
--- a/kernel/power/power.h
+++ b/kernel/power/power.h
@@ -277,9 +277,10 @@ static inline int suspend_freeze_processes(void)
 {
 	int error;
 
-	error = freeze_processes();
+	/* enter_state() discarded earlier wakeups when the suspend began. */
+	error = __freeze_processes(false);
 	/*
-	 * freeze_processes() automatically thaws every task if freezing
+	 * __freeze_processes() automatically thaws every task if freezing
 	 * fails. So we need not do anything extra upon error.
 	 */
 	if (error)
diff --git a/kernel/power/process.c b/kernel/power/process.c
index dc0dfc349f22b4505980cfd5d3bd9cff21475987..73648a2cf4af9d37a62e6e0e6f291d29aac5be5d 100644
--- a/kernel/power/process.c
+++ b/kernel/power/process.c
@@ -112,13 +112,17 @@ static int try_to_freeze_tasks(bool user_only)
 }
 
 /**
- * freeze_processes - Signal user space processes to enter the refrigerator.
+ * __freeze_processes - Signal user space processes to enter the refrigerator.
+ * @discard_wakeups: Whether wakeups signaled so far are discarded.
+ *
  * The current thread will not be frozen.  The same process that calls
- * freeze_processes must later call thaw_processes.
+ * __freeze_processes must later call thaw_processes.  A system suspend
+ * discards earlier wakeups when it begins instead, so that one signaled
+ * since then still aborts it.
  *
  * On success, returns 0.  On failure, -errno and system is fully thawed.
  */
-int freeze_processes(void)
+int __freeze_processes(bool discard_wakeups)
 {
 	int error;
 
@@ -132,7 +136,8 @@ int freeze_processes(void)
 	if (!pm_freezing)
 		static_branch_inc(&freezer_active);
 
-	pm_wakeup_clear(0);
+	if (discard_wakeups)
+		pm_wakeup_clear(0);
 	pm_freezing = true;
 	error = try_to_freeze_tasks(true);
 	if (!error)
@@ -154,6 +159,16 @@ int freeze_processes(void)
 	return error;
 }
 
+/**
+ * freeze_processes - Signal user space processes to enter the refrigerator.
+ *
+ * Wakeups signaled before this point are discarded.  See __freeze_processes().
+ */
+int freeze_processes(void)
+{
+	return __freeze_processes(true);
+}
+
 /**
  * freeze_kernel_threads - Make freezable kernel threads go to the refrigerator.
  *
diff --git a/kernel/power/suspend.c b/kernel/power/suspend.c
index 3d4ebedad69f6a0a3c411b7eb1d2b42dada20a81..9040fa0eae3df663e7da6c9d10a623efd3203781 100644
--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -584,6 +584,14 @@ static int enter_state(suspend_state_t state)
 	if (!mutex_trylock(&system_transition_mutex))
 		return -EBUSY;
 
+	/*
+	 * Wakeups signaled before the suspend began do not concern it.  One
+	 * signaled from here on aborts it, including one signaled while file
+	 * systems are synced or notifiers prepare for it: freezing tasks for
+	 * the suspend keeps it.
+	 */
+	pm_wakeup_clear(0);
+
 	if (state == PM_SUSPEND_TO_IDLE)
 		s2idle_begin();
 
@@ -593,6 +601,12 @@ static int enter_state(suspend_state_t state)
 		trace_suspend_resume(TPS("sync_filesystems"), 0, false);
 	}
 
+	/* A wakeup signaled while file systems were synced ends the suspend. */
+	if (pm_wakeup_pending()) {
+		error = -EBUSY;
+		goto Unlock;
+	}
+
 	pm_pr_dbg("Preparing system for sleep (%s)\n", mem_sleep_labels[state]);
 	pm_suspend_clear_flags();
 	error = suspend_prepare(state);
