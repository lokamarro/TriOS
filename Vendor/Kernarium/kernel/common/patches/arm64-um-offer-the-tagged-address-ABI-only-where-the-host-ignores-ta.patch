From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 25 Oct 2026 16:52:39 +0900
Subject: [PATCH] arm64: um: offer the tagged-address ABI only where the host
 ignores tags

The tagged-address ABI promises that a task can pass a pointer with a
tag in its top byte. That holds only while the host ignores the top byte
of a data address, as EL0 does with TBI0. The Android product always
runs the engines that way; an arm64 Linux guest does only when its
launcher passes --guest-top-byte-ignore. Without it every tagged access
faults, so offering the ABI would let HWASan, or any task that enabled
it, crash instead of finding out that it is unavailable.

Bridge ABI 25 adds darwin_uml_guest_top_byte_ignore(), 1 when the run's
engines ignore the top byte and 0 when they do not, fixed for the run.
The arm64 slices import it; the x86_64 slice does not. The kernel reads
it at boot and refuses PR_SET_TAGGED_ADDR_CTRL(PR_TAGGED_ADDR_ENABLE),
and NT_ARM_TAGGED_ADDR_CTRL, with EINVAL while it is 0, as it does while
abi.tagged_addr_disabled is 1. Disabling the ABI is always allowed.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/arm64/um/Kconfig                       |  5 +++--
 arch/arm64/um/tagged_addr.c                 | 18 ++++++++++++++++--
 arch/um/os-Darwin/uml_darwin_abi_identity.h |  4 ++--
 arch/um/os-Darwin/uml_darwin_cpu.h          |  6 ++++++
 4 files changed, 27 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/um/Kconfig b/arch/arm64/um/Kconfig
index b9f9aa50995d24949cf14cfa5e3096f55f20414f..a320c267a45380c0b415b75834266b84de849b93 100644
--- a/arch/arm64/um/Kconfig
+++ b/arch/arm64/um/Kconfig
@@ -44,8 +44,9 @@ config COMPAT
 
 # The AArch64 tagged-address ABI of arm64 Linux's ARM64_TAGGED_ADDR_ABI:
 # PR_SET_TAGGED_ADDR_CTRL, NT_ARM_TAGGED_ADDR_CTRL and the
-# abi.tagged_addr_disabled sysctl.  The host's engines ignore the top byte
-# of a data address (TBI0) for the task.
+# abi.tagged_addr_disabled sysctl.  A task may pass a tagged pointer only
+# while the host's engines ignore the top byte of a data address (TBI0), which
+# the kernel asks the host at boot.
 config UML_ARM64_TAGGED_ADDR_ABI
 	def_bool y
 
diff --git a/arch/arm64/um/tagged_addr.c b/arch/arm64/um/tagged_addr.c
index 6d42af5947de03ff9deebc8d4dabe973c72d838c..29bdb0dbcaa71a204997f259b7df889a222b0748 100644
--- a/arch/arm64/um/tagged_addr.c
+++ b/arch/arm64/um/tagged_addr.c
@@ -8,11 +8,20 @@
 #include <linux/errno.h>
 #include <linux/init.h>
 #include <linux/prctl.h>
+#include <linux/printk.h>
 #include <linux/sched.h>
 #include <linux/sysctl.h>
 #include <linux/thread_info.h>
 
+extern unsigned long darwin_uml_guest_top_byte_ignore(void);
+
 static unsigned int tagged_addr_disabled;
+/*
+ * Whether the host's engines ignore the top byte of a data address, as EL0
+ * does with TBI0.  Without it a tagged pointer faults, so the ABI that lets a
+ * task pass one must not be offered.  Fixed for the life of the run.
+ */
+static bool host_top_byte_ignore;
 
 long set_tagged_addr_ctrl(struct task_struct *task, unsigned long arg)
 {
@@ -22,8 +31,10 @@ long set_tagged_addr_ctrl(struct task_struct *task, unsigned long arg)
 		return -EINVAL;
 	if (arg & ~PR_TAGGED_ADDR_ENABLE)
 		return -EINVAL;
-	/* Not while abi.tagged_addr_disabled forbids it. */
-	if ((arg & PR_TAGGED_ADDR_ENABLE) && tagged_addr_disabled)
+	/* Not while abi.tagged_addr_disabled forbids it, nor on a host that
+	 * does not ignore a tag. */
+	if ((arg & PR_TAGGED_ADDR_ENABLE) &&
+	    (tagged_addr_disabled || !host_top_byte_ignore))
 		return -EINVAL;
 	update_ti_thread_flag(ti, TIF_TAGGED_ADDR, arg & PR_TAGGED_ADDR_ENABLE);
 	return 0;
@@ -58,6 +69,9 @@ static const struct ctl_table tagged_addr_sysctl_table[] = {
 
 static int __init tagged_addr_init(void)
 {
+	host_top_byte_ignore = darwin_uml_guest_top_byte_ignore() != 0;
+	if (!host_top_byte_ignore)
+		pr_info("tagged-address ABI unavailable: the host keeps the top byte of an address\n");
 	if (!register_sysctl("abi", tagged_addr_sysctl_table))
 		return -EINVAL;
 	return 0;
diff --git a/arch/um/os-Darwin/uml_darwin_abi_identity.h b/arch/um/os-Darwin/uml_darwin_abi_identity.h
index dca8e59e73bf4c0a4be1b9dcb8d02a42fa44902d..397d5e7467868f6911a82afc578d452ab43a68c6 100644
--- a/arch/um/os-Darwin/uml_darwin_abi_identity.h
+++ b/arch/um/os-Darwin/uml_darwin_abi_identity.h
@@ -3,7 +3,7 @@
 #ifndef UML_DARWIN_ABI_IDENTITY_H
 #define UML_DARWIN_ABI_IDENTITY_H
 
-#define DARWIN_UML_ABI_VERSION 24U
-#define DARWIN_UML_ABI_FINGERPRINT 0x1e8fdf51f0a2080dULL
+#define DARWIN_UML_ABI_VERSION 25U
+#define DARWIN_UML_ABI_FINGERPRINT 0x52dddc0658948841ULL
 
 #endif
diff --git a/arch/um/os-Darwin/uml_darwin_cpu.h b/arch/um/os-Darwin/uml_darwin_cpu.h
index efd4114d4ef23eb5e6e499fc96b2c6cda2bc9271..8cc3b241887569d8863ce2af1b0a9896e24fde6d 100644
--- a/arch/um/os-Darwin/uml_darwin_cpu.h
+++ b/arch/um/os-Darwin/uml_darwin_cpu.h
@@ -23,6 +23,12 @@ unsigned long darwin_uml_guest_hwcap2(void);
  * exists. Fixed for the life of the process. */
 unsigned long darwin_uml_guest_compat_hwcap(void);
 unsigned long darwin_uml_guest_compat_hwcap2(void);
+/* Whether the run's engines ignore the top byte of a data address, as EL0
+ * does with TCR_EL1.TBI0, from bridge ABI 25: 1 when they do, 0 when they
+ * do not. Fixed for the life of the process. An arm64 kernel offers the
+ * tagged-address ABI (PR_SET_TAGGED_ADDR_CTRL) only while it is 1, because a
+ * tagged pointer faults on a host that keeps the tag. */
+unsigned long darwin_uml_guest_top_byte_ignore(void);
 /* The streaming vector length in bytes when the virtual CPU implements SME
  * for this run, else 0. Fixed for the life of the process. */
 unsigned long darwin_uml_guest_sme_vector_length(void);
