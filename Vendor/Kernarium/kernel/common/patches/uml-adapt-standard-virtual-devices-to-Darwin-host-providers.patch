diff --git a/arch/um/drivers/vnc_input.c b/arch/um/drivers/vnc_input.c
new file mode 100644
index 0000000000000000000000000000000000000000..5bc59c8a4381cb99d2297700b5e572a390b7387b
--- /dev/null
+++ b/arch/um/drivers/vnc_input.c
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * VNC keyboard and absolute-pointer input passed directly from the Darwin
+ * host frontend over an inherited datagram socket.
+ */
+
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/kernel.h>
+#include <linux/types.h>
+#include <linux/byteorder/generic.h>
+
+#include <init.h>
+#include <irq_kern.h>
+#include <os.h>
+
+struct uml_vnc_input_event {
+	__le16 type;
+	__le16 code;
+	__le32 value;
+} __packed;
+
+static int input_fd = -1;
+static int input_irq = -1;
+static struct input_dev *keyboard;
+static struct input_dev *pointer;
+
+static int __init vnc_input_setup(char *value)
+{
+	if (kstrtoint(value, 10, &input_fd) || input_fd < 0) {
+		pr_err("uml_vnc_input: invalid descriptor '%s'\n", value);
+		input_fd = -1;
+	}
+	return 1;
+}
+__setup("uml_vnc_input.fd=", vnc_input_setup);
+
+static void deliver_event(const struct uml_vnc_input_event *wire)
+{
+	const unsigned int type = le16_to_cpu(wire->type);
+	const unsigned int code = le16_to_cpu(wire->code);
+	const int value = (s32)le32_to_cpu(wire->value);
+
+	if (type == EV_SYN) {
+		input_sync(keyboard);
+		input_sync(pointer);
+	} else if (type == EV_ABS || type == EV_REL ||
+		   (type == EV_KEY && code >= BTN_MISC)) {
+		input_event(pointer, type, code, value);
+	} else {
+		input_event(keyboard, type, code, value);
+	}
+}
+
+static irqreturn_t vnc_input_interrupt(int irq, void *data)
+{
+	struct uml_vnc_input_event events[16];
+	bool handled = false;
+	int bytes;
+	int index;
+
+	(void)irq;
+	(void)data;
+	for (;;) {
+		bytes = os_read_file(input_fd, events, sizeof(events));
+		if (bytes <= 0)
+			break;
+		handled = true;
+		if (bytes % sizeof(events[0])) {
+			pr_warn_ratelimited(
+				"uml_vnc_input: malformed event datagram (%d bytes)\n",
+				bytes);
+			continue;
+		}
+		for (index = 0; index < bytes / sizeof(events[0]); ++index)
+			deliver_event(&events[index]);
+	}
+	return handled ? IRQ_HANDLED : IRQ_NONE;
+}
+
+static void configure_keyboard(struct input_dev *device)
+{
+	unsigned int code;
+
+	device->name = "Darwin UML VNC Keyboard";
+	device->phys = "uml/vnc/input0";
+	device->id.bustype = BUS_VIRTUAL;
+	for (code = KEY_ESC; code < BTN_MISC; ++code)
+		input_set_capability(device, EV_KEY, code);
+}
+
+static void configure_pointer(struct input_dev *device)
+{
+	device->name = "Darwin UML VNC Tablet";
+	device->phys = "uml/vnc/input1";
+	device->id.bustype = BUS_VIRTUAL;
+	__set_bit(INPUT_PROP_POINTER, device->propbit);
+	input_set_capability(device, EV_KEY, BTN_LEFT);
+	input_set_capability(device, EV_KEY, BTN_MIDDLE);
+	input_set_capability(device, EV_KEY, BTN_RIGHT);
+	input_set_capability(device, EV_REL, REL_WHEEL);
+	input_set_capability(device, EV_REL, REL_HWHEEL);
+	input_set_abs_params(device, ABS_X, 0, 32767, 0, 0);
+	input_set_abs_params(device, ABS_Y, 0, 32767, 0, 0);
+}
+
+static int __init vnc_input_init(void)
+{
+	int error;
+
+	if (input_fd < 0)
+		return 0;
+	error = os_set_fd_block(input_fd, 0);
+	if (error)
+		return error;
+
+	keyboard = input_allocate_device();
+	pointer = input_allocate_device();
+	if (!keyboard || !pointer) {
+		error = -ENOMEM;
+		goto free_devices;
+	}
+	configure_keyboard(keyboard);
+	configure_pointer(pointer);
+
+	error = input_register_device(keyboard);
+	if (error)
+		goto free_devices;
+	error = input_register_device(pointer);
+	if (error) {
+		input_free_device(pointer);
+		pointer = NULL;
+		goto unregister_keyboard;
+	}
+
+	input_irq = um_request_irq(UM_IRQ_ALLOC, input_fd, IRQ_READ,
+				   vnc_input_interrupt, 0,
+				   "uml-vnc-input", keyboard);
+	if (input_irq < 0) {
+		error = input_irq;
+		goto unregister_pointer;
+	}
+	pr_info("uml_vnc_input: registered keyboard and tablet at fd=%d\n",
+		input_fd);
+	return 0;
+
+unregister_pointer:
+	input_unregister_device(pointer);
+	pointer = NULL;
+unregister_keyboard:
+	input_unregister_device(keyboard);
+	keyboard = NULL;
+	return error;
+free_devices:
+	input_free_device(pointer);
+	input_free_device(keyboard);
+	pointer = NULL;
+	keyboard = NULL;
+	return error;
+}
+device_initcall(vnc_input_init);
+
+static void vnc_input_cleanup(void)
+{
+	if (input_irq >= 0) {
+		um_free_irq(input_irq, keyboard);
+		input_irq = -1;
+	}
+	if (pointer) {
+		input_unregister_device(pointer);
+		pointer = NULL;
+	}
+	if (keyboard) {
+		input_unregister_device(keyboard);
+		keyboard = NULL;
+	}
+	if (input_fd >= 0) {
+		os_close_file(input_fd);
+		input_fd = -1;
+	}
+}
+__uml_exitcall(vnc_input_cleanup);
