diff --git a/arch/um/drivers/darwin_net_kern.c b/arch/um/drivers/darwin_net_kern.c
new file mode 100644
index 0000000000000000000000000000000000000000..4291170b64845b5d4fd37616c2665c46ddbe42d9
--- /dev/null
+++ b/arch/um/drivers/darwin_net_kern.c
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/etherdevice.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+#include <darwin_net.h>
+#include <irq_kern.h>
+
+#define DARWIN_NET_FRAME_SIZE 2048
+#define DARWIN_NET_RX_BUDGET 64
+
+struct darwin_net_private {
+	struct net_device *device;
+	int backend_ready;
+	int receive_irq;
+	unsigned char receive_frame[DARWIN_NET_FRAME_SIZE];
+};
+
+static void darwin_net_receive(struct net_device *device)
+{
+	struct darwin_net_private *private = netdev_priv(device);
+	int budget;
+
+	if (!private->backend_ready || !netif_running(device))
+		return;
+	for (budget = 0; budget < DARWIN_NET_RX_BUDGET; budget++) {
+		struct sk_buff *buffer;
+		int length = darwin_uml_net_read(private->receive_frame,
+						 sizeof(private->receive_frame));
+
+		if (length <= 0)
+			break;
+		buffer = netdev_alloc_skb_ip_align(device, length);
+		if (buffer == NULL) {
+			device->stats.rx_dropped++;
+			continue;
+		}
+		skb_put_data(buffer, private->receive_frame, length);
+		buffer->protocol = eth_type_trans(buffer, device);
+		device->stats.rx_packets++;
+		device->stats.rx_bytes += length;
+		netif_rx(buffer);
+	}
+}
+
+static irqreturn_t darwin_net_interrupt(int irq, void *data)
+{
+	struct net_device *device = data;
+
+	(void)irq;
+	if (!netif_running(device))
+		return IRQ_NONE;
+	darwin_net_receive(device);
+	return IRQ_HANDLED;
+}
+
+static netdev_tx_t darwin_net_transmit(struct sk_buff *buffer,
+				       struct net_device *device)
+{
+	struct darwin_net_private *private = netdev_priv(device);
+	int result;
+
+	if (!private->backend_ready) {
+		device->stats.tx_dropped++;
+		dev_kfree_skb(buffer);
+		return NETDEV_TX_OK;
+	}
+	result = darwin_uml_net_write(buffer->data, buffer->len);
+	if (result == 0) {
+		device->stats.tx_packets++;
+		device->stats.tx_bytes += buffer->len;
+	} else {
+		device->stats.tx_dropped++;
+		device->stats.tx_errors++;
+	}
+	dev_kfree_skb(buffer);
+	return NETDEV_TX_OK;
+}
+
+static int darwin_net_open_device(struct net_device *device)
+{
+	struct darwin_net_private *private = netdev_priv(device);
+	int descriptor;
+	int irq;
+
+	if (!private->backend_ready)
+		return -ENETDOWN;
+	descriptor = darwin_uml_net_irq_fd();
+	if (descriptor < 0)
+		return -ENODEV;
+	irq = um_request_irq(UM_IRQ_ALLOC, descriptor, IRQ_READ,
+			     darwin_net_interrupt, 0, device->name, device);
+	if (irq < 0)
+		return irq;
+	private->receive_irq = irq;
+	device->irq = irq;
+	netif_carrier_on(device);
+	netif_start_queue(device);
+	return 0;
+}
+
+static int darwin_net_close_device(struct net_device *device)
+{
+	struct darwin_net_private *private = netdev_priv(device);
+
+	netif_stop_queue(device);
+	if (private->receive_irq >= 0) {
+		um_free_irq(private->receive_irq, device);
+		private->receive_irq = -1;
+	}
+	return 0;
+}
+
+static const struct net_device_ops darwin_net_device_ops = {
+	.ndo_open = darwin_net_open_device,
+	.ndo_stop = darwin_net_close_device,
+	.ndo_start_xmit = darwin_net_transmit,
+	.ndo_set_mac_address = eth_mac_addr,
+	.ndo_validate_addr = eth_validate_addr,
+};
+
+static int __init darwin_net_init(void)
+{
+	struct darwin_net_private *private;
+	struct net_device *device;
+	unsigned char mac[ETH_ALEN] = { };
+	unsigned int mtu = ETH_DATA_LEN;
+	int backend_result;
+	int result;
+
+	device = alloc_etherdev(sizeof(*private));
+	if (device == NULL)
+		return -ENOMEM;
+	private = netdev_priv(device);
+	private->device = device;
+	private->receive_irq = -1;
+	backend_result = darwin_uml_net_open(mac, &mtu);
+	private->backend_ready = backend_result == 0;
+	device->netdev_ops = &darwin_net_device_ops;
+	device->min_mtu = ETH_MIN_MTU;
+	device->max_mtu = DARWIN_NET_FRAME_SIZE - ETH_HLEN;
+	if (mtu >= device->min_mtu && mtu <= device->max_mtu)
+		device->mtu = mtu;
+	if (private->backend_ready && is_valid_ether_addr(mac))
+		eth_hw_addr_set(device, mac);
+	else
+		eth_hw_addr_random(device);
+	if (!private->backend_ready)
+		netif_carrier_off(device);
+	result = register_netdev(device);
+	if (result != 0) {
+		free_netdev(device);
+		return result;
+	}
+	if (private->backend_ready)
+		pr_info("Darwin user network: registered %s with user-mode NAT\n",
+			device->name);
+	else
+		pr_warn("Darwin user network: %s registered without host carrier "
+			"(%d)\n",
+			device->name, backend_result);
+	return 0;
+}
+late_initcall(darwin_net_init);
diff --git a/arch/um/drivers/rtc_kern.c b/arch/um/drivers/rtc_kern.c
index 9158c936c1281441a4e5880e0fc9a22fc9e85212..77295f0444d1a859aa8b64143e9144101f87e5b1 100644
--- a/arch/um/drivers/rtc_kern.c
+++ b/arch/um/drivers/rtc_kern.c
@@ -8,15 +8,18 @@
 #include <linux/suspend.h>
 #include <linux/err.h>
 #include <linux/rtc.h>
+#include <init.h>
 #include <kern_util.h>
 #include <irq_kern.h>
 #include <os.h>
 #include "rtc.h"
 
 static time64_t uml_rtc_alarm_time;
+static time64_t uml_rtc_offset;
 static bool uml_rtc_alarm_enabled;
 static struct rtc_device *uml_rtc;
-static int uml_rtc_irq_fd, uml_rtc_irq;
+static int uml_rtc_irq_fd = -1, uml_rtc_irq = -1;
+static bool uml_rtc_started;
 
 #ifdef CONFIG_UML_TIME_TRAVEL_SUPPORT
 
@@ -36,7 +39,18 @@ static int uml_rtc_read_time(struct device *dev, struct rtc_time *tm)
 
 	/* Use this to get correct time in time-travel mode */
 	read_persistent_clock64(&ts);
-	rtc_time64_to_tm(timespec64_to_ktime(ts) / NSEC_PER_SEC, tm);
+	rtc_time64_to_tm(timespec64_to_ktime(ts) / NSEC_PER_SEC +
+			 READ_ONCE(uml_rtc_offset), tm);
+
+	return 0;
+}
+
+static int uml_rtc_set_time(struct device *dev, struct rtc_time *tm)
+{
+	struct timespec64 ts;
+
+	read_persistent_clock64(&ts);
+	WRITE_ONCE(uml_rtc_offset, rtc_tm_to_time64(tm) - ts.tv_sec);
 
 	return 0;
 }
@@ -60,7 +74,8 @@ static int uml_rtc_alarm_irq_enable(struct device *dev, unsigned int enable)
 	uml_rtc_alarm_enabled = enable;
 
 	read_persistent_clock64(&ts);
-	secs = uml_rtc_alarm_time - ts.tv_sec;
+	secs = uml_rtc_alarm_time -
+		(ts.tv_sec + READ_ONCE(uml_rtc_offset));
 
 	if (time_travel_mode == TT_MODE_OFF) {
 		if (!enable) {
@@ -93,6 +108,7 @@ static int uml_rtc_set_alarm(struct device *dev, struct rtc_wkalrm *alrm)
 
 static const struct rtc_class_ops uml_rtc_ops = {
 	.read_time = uml_rtc_read_time,
+	.set_time = uml_rtc_set_time,
 	.read_alarm = uml_rtc_read_alarm,
 	.alarm_irq_enable = uml_rtc_alarm_irq_enable,
 	.set_alarm = uml_rtc_set_alarm,
@@ -134,15 +150,23 @@ static int uml_rtc_setup(void)
 	irq_set_irq_wake(err, 1);
 
 	uml_rtc_irq = err;
+	uml_rtc_started = true;
 	return 0;
 }
 
 static void uml_rtc_cleanup(void)
 {
+	if (!uml_rtc_started)
+		return;
+	uml_rtc_started = false;
 	um_free_irq(uml_rtc_irq, NULL);
+	uml_rtc_irq = -1;
+	uml_rtc_irq_fd = -1;
 	uml_rtc_stop(time_travel_mode != TT_MODE_OFF);
 }
 
+__uml_exitcall(uml_rtc_cleanup);
+
 static int uml_rtc_probe(struct platform_device *pdev)
 {
 	int err;
diff --git a/arch/um/drivers/rtc_user.c b/arch/um/drivers/rtc_user.c
index 67912fcf7b2864daa6539eaeaaa61f14dd08b4b7..dfc7cafc52123d05064f41ce5b4eb9ce9fd254e9 100644
--- a/arch/um/drivers/rtc_user.c
+++ b/arch/um/drivers/rtc_user.c
@@ -11,10 +11,57 @@
 #include <kern_util.h>
 #include <sys/select.h>
 #include <stdio.h>
+#ifdef UML_HOST_DARWIN
+#include <limits.h>
+#include <pthread.h>
+#include <signal.h>
+#include <time.h>
+#else
 #include <sys/timerfd.h>
+#endif
 #include "rtc.h"
 
-static int uml_rtc_irq_fds[2];
+static int uml_rtc_irq_fds[2] = { -1, -1 };
+
+#ifdef UML_HOST_DARWIN
+static pthread_mutex_t uml_rtc_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t uml_rtc_condition = PTHREAD_COND_INITIALIZER;
+static pthread_t uml_rtc_thread;
+static struct timespec uml_rtc_deadline;
+static bool uml_rtc_thread_running;
+static bool uml_rtc_alarm_armed;
+
+static void *uml_rtc_alarm_thread(void *unused)
+{
+	sigset_t blocked;
+
+	(void)unused;
+	/* The process-wide UML tick must never be delivered to this helper. */
+	sigemptyset(&blocked);
+	sigaddset(&blocked, SIGALRM);
+	(void)pthread_sigmask(SIG_BLOCK, &blocked, NULL);
+
+	pthread_mutex_lock(&uml_rtc_lock);
+	while (uml_rtc_thread_running) {
+		int error;
+
+		while (uml_rtc_thread_running && !uml_rtc_alarm_armed)
+			pthread_cond_wait(&uml_rtc_condition, &uml_rtc_lock);
+		if (!uml_rtc_thread_running)
+			break;
+		error = pthread_cond_timedwait(&uml_rtc_condition,
+			&uml_rtc_lock, &uml_rtc_deadline);
+		if (error != ETIMEDOUT || !uml_rtc_alarm_armed)
+			continue;
+		uml_rtc_alarm_armed = false;
+		pthread_mutex_unlock(&uml_rtc_lock);
+		uml_rtc_send_timetravel_alarm();
+		pthread_mutex_lock(&uml_rtc_lock);
+	}
+	pthread_mutex_unlock(&uml_rtc_lock);
+	return NULL;
+}
+#endif
 
 void uml_rtc_send_timetravel_alarm(void)
 {
@@ -27,6 +74,26 @@ int uml_rtc_start(bool timetravel)
 {
 	int err;
 
+#ifdef UML_HOST_DARWIN
+	err = os_pipe(uml_rtc_irq_fds, 1, 1);
+	if (err)
+		goto fail;
+	if (!timetravel) {
+		pthread_mutex_lock(&uml_rtc_lock);
+		uml_rtc_alarm_armed = false;
+		uml_rtc_thread_running = true;
+		pthread_mutex_unlock(&uml_rtc_lock);
+		err = pthread_create(&uml_rtc_thread, NULL,
