diff --git a/arch/um/drivers/chan_user.c b/arch/um/drivers/chan_user.c
index 35f9beeb19b3fe6761dcd4735690600403ce3e53..e017e2804e3f992c1f4539d90f648d5161563eca 100644
--- a/arch/um/drivers/chan_user.c
+++ b/arch/um/drivers/chan_user.c
@@ -14,6 +14,21 @@
 #include <os.h>
 #include <um_malloc.h>
 
+#ifdef UML_HOST_DARWIN
+#include <pthread.h>
+
+/*
+ * Darwin's sigprocmask() sets the mask of every thread in the process, so a
+ * console write blocking its own signals would also block every vCPU
+ * carrier's, and a carrier's synchronous SIGSEGV would then retry its
+ * faulting instruction forever.  pthread_sigmask() changes only the calling
+ * thread.
+ */
+#define uml_thread_sigmask pthread_sigmask
+#else
+#define uml_thread_sigmask sigprocmask
+#endif
+
 void generic_close(int fd, void *unused)
 {
 	close(fd);
@@ -92,7 +107,7 @@ int generic_console_write(int fd, const char *buf, int n)
 	if (isatty(fd)) {
 		sigemptyset(&no_sigio);
 		sigaddset(&no_sigio, SIGIO);
-		if (sigprocmask(SIG_BLOCK, &no_sigio, &old))
+		if (uml_thread_sigmask(SIG_BLOCK, &no_sigio, &old))
 			goto error;
 
 		CATCH_EINTR(err = tcgetattr(fd, &save));
@@ -103,9 +118,11 @@ int generic_console_write(int fd, const char *buf, int n)
 		 * The terminal becomes a bit less raw, to handle \n also as
 		 * "Carriage Return", not only as "New Line". Otherwise, the new
 		 * line won't start at the first column.
+		 * Preserve unread input: console output may share its host tty
+		 * with the input channel. Only the output mode changes here.
 		 */
 		new.c_oflag |= OPOST;
-		CATCH_EINTR(err = tcsetattr(fd, TCSAFLUSH, &new));
+		CATCH_EINTR(err = tcsetattr(fd, TCSADRAIN, &new));
 		if (err)
 			goto error;
 	}
@@ -115,8 +132,8 @@ int generic_console_write(int fd, const char *buf, int n)
 	 * EINTR, except for debug.
 	 */
 	if (isatty(fd)) {
-		CATCH_EINTR(tcsetattr(fd, TCSAFLUSH, &save));
-		sigprocmask(SIG_SETMASK, &old, NULL);
+		CATCH_EINTR(tcsetattr(fd, TCSADRAIN, &save));
+		uml_thread_sigmask(SIG_SETMASK, &old, NULL);
 	}
 
 	return err;
@@ -124,6 +141,23 @@ int generic_console_write(int fd, const char *buf, int n)
 	return -errno;
 }
 
+#ifdef UML_HOST_DARWIN
+/*
+ * Only a controlling terminal reports a change of its size, by SIGWINCH to
+ * its foreground process group, so the helper below takes the console's
+ * terminal as its own controlling terminal with setsid(), TIOCSCTTY and
+ * tcsetpgrp().  A Linux host runs the helper as a process of its own.  A
+ * Darwin helper would be a thread, and those calls would move the whole
+ * emulator into a new session and process group led by itself, out of reach
+ * of every signal sent to the group that started it.  A Darwin console
+ * therefore keeps the size its input terminal had when the line opened.
+ */
+void register_winch(int fd, struct tty_port *port)
+{
+	(void)fd;
+	(void)port;
+}
+#else
 /*
  * UML SIGWINCH handling
  *
@@ -321,3 +355,4 @@ void register_winch(int fd, struct tty_port *port)
 			       "synchronization byte, err = %d\n", errno);
 	}
 }
+#endif
