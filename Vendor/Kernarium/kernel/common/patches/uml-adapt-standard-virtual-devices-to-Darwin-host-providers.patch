diff --git a/arch/um/drivers/Kconfig b/arch/um/drivers/Kconfig
index 6a0354ca032fb013fff3ee487062f3f8c49eccb2..32721e1b12ab36df3e03e81254bddf46a0e0f6a8 100644
--- a/arch/um/drivers/Kconfig
+++ b/arch/um/drivers/Kconfig
@@ -2,6 +2,15 @@
 
 menu "UML Character Devices"
 
+config UML_STDIO_CONSOLE
+	bool "UML stdio console"
+	default y
+	help
+	  Build the traditional UML console driver which exposes tty0 through
+	  tty15 as host stdio, terminal, or pseudo-terminal channels. Disable
+	  this when the standard Linux virtual-terminal and framebuffer-console
+	  stack owns the tty major instead.
+
 config STDERR_CONSOLE
 	bool "stderr console"
 	default y
@@ -20,6 +29,16 @@ config SSL
 
 	  Unless you have a specific reason for disabling this, say Y.
 
+config SSL_PORTS
+	int "Number of virtual serial lines"
+	depends on SSL
+	range 1 64
+	default 64
+	help
+	  Set the number of UML serial devices exposed as /dev/ttyS*. Most
+	  desktop guests need only a few serial ports; retain 64 for the
+	  historical UML default.
+
 config NULL_CHAN
 	bool "null channel support"
 	help
@@ -77,6 +96,7 @@ config NOCONFIG_CHAN
 
 config CON_ZERO_CHAN
 	string "Default main console channel initialization"
+	depends on UML_STDIO_CONSOLE
 	default "fd:0,fd:1"
 	help
 	  This is the string describing the channel to which the main console
@@ -87,6 +107,7 @@ config CON_ZERO_CHAN
 
 config CON_CHAN
 	string "Default console channel initialization"
+	depends on UML_STDIO_CONSOLE
 	default "xterm"
 	help
 	  This is the string describing the channel to which all consoles
@@ -142,20 +163,28 @@ endmenu
 config VIRTIO_UML
 	bool "UML driver for virtio devices"
 	select VIRTIO
+	select UML_DMA_EMULATION
+	select UML_IOMEM_EMULATION
 	help
 	  This driver provides support for virtio based paravirtual device
 	  drivers over vhost-user sockets.
 
+config UML_VNC_INPUT
+	bool "UML VNC keyboard and tablet input"
+	depends on INPUT
+	help
+	  Register keyboard and absolute-pointer input devices backed by an
+	  inherited host descriptor. The Darwin VNC frontend uses this to pass
+	  remote client input into the guest Linux input subsystem.
+
 config UML_RTC
 	bool "UML RTC driver"
 	depends on RTC_CLASS
-	# there's no use in this if PM_SLEEP isn't enabled ...
-	depends on PM_SLEEP
 	help
-	  When PM_SLEEP is configured, it may be desirable to wake up using
-	  rtcwake, especially in time-travel mode. This driver enables that
-	  by providing a fake RTC clock that causes a wakeup at the right
-	  time.
+	  This driver provides a fake RTC clock with alarm support. It enables
+	  the CLOCK_REALTIME_ALARM and CLOCK_BOOTTIME_ALARM POSIX clocks and,
+	  when PM_SLEEP is configured, can also wake UML from suspend using
+	  rtcwake, especially in time-travel mode.
 
 config UML_PCI
 	bool
