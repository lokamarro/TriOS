+++ b/arch/um/kernel/Makefile
@@ -20,7 +20,7 @@ obj-y = config.o exec.o exitcode.o irq.o ksyms.o mem.o \
 	um_arch.o umid.o kmsg_dump.o skas/
 obj-y += load_file.o page_cache_trim.o
 
-obj-$(CONFIG_UML_ARM64) += capflags_arm64.o
+obj-$(CONFIG_UML_ARM64) += hwcaps_arm64.o
 obj-$(CONFIG_UML_X86) += capflags.o
 
 obj-$(CONFIG_BLK_DEV_INITRD) += initrd.o
@@ -34,7 +34,7 @@ USER_OBJS := config.o
 
 include $(srctree)/arch/um/scripts/Makefile.rules
 
-targets := config.c config.tmp capflags.c
+targets := config.c config.tmp capflags.c hwcap_str.h
 
 # Keep this transformation in POSIX awk.  GNU and BSD sed disagree on the
 # syntax of an appended line, which otherwise prevents UML from being built on
@@ -59,6 +59,21 @@ vmxfeature = $(src)/../../x86/include/asm/vmxfeatures.h
 $(obj)/capflags.c: $(cpufeature) $(vmxfeature) $(src)/../../x86/kernel/cpu/mkcapflags.sh FORCE
 	$(call if_changed,mkcapflags)
 
+# arm64 Linux names its hwcaps in arch/arm64/kernel/cpuinfo.c.  Take that
+# table itself rather than a copy, so /proc/cpuinfo spells each feature the
+# way arm64 Linux does; a table this cannot find fails here, not in the
+# compiler.
+quiet_cmd_hwcap_str = GEN     $@
+      cmd_hwcap_str = awk 'index($$0, "static const char *const hwcap_str[] = {") == 1 { p = 1 } \
+		  p { print } p && $$0 == "};" { exit }' $< > $@ && \
+		  grep -q '\[KERNEL_HWCAP_FP]' $@ || \
+		  { rm -f $@; echo "$<: no hwcap_str table" >&2; exit 1; }
+
+$(obj)/hwcap_str.h: $(srctree)/arch/arm64/kernel/cpuinfo.c FORCE
+	$(call if_changed,hwcap_str)
+
+$(obj)/hwcaps_arm64.o: $(obj)/hwcap_str.h
+
 quiet_cmd_quote2 = QUOTE   $@
       cmd_quote2 = awk -v config='$(obj)/config.tmp' \
 		  '/"CONFIG"/ { while ((getline line < config) > 0) \
