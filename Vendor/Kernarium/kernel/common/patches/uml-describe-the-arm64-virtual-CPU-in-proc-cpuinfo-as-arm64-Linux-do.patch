diff --git a/arch/um/kernel/hwcaps_arm64.c b/arch/um/kernel/hwcaps_arm64.c
new file mode 100644
index 0000000000000000000000000000000000000000..ae6b892773f3d92d13b839acb0a08ff33469371a
--- /dev/null
+++ b/arch/um/kernel/hwcaps_arm64.c
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * arm64 Linux's names for its hwcaps: the hwcap_str table of
+ * arch/arm64/kernel/cpuinfo.c, which the build extracts into hwcap_str.h.
+ * /proc/cpuinfo therefore spells and orders every AT_HWCAP and AT_HWCAP2
+ * feature exactly as arm64 Linux does, and a name arm64 Linux adds arrives
+ * with the kernel that defines it.
+ */
+
+#include <linux/kernel.h>
+#include <asm/hwcap.h>
+
+#include "um_arch.h"
+#include "hwcap_str.h"
+
+const char *uml_arm64_hwcap_name(unsigned int feature)
+{
+	return feature < ARRAY_SIZE(hwcap_str) ? hwcap_str[feature] : NULL;
+}
diff --git a/arch/um/kernel/um_arch.c b/arch/um/kernel/um_arch.c
index 175767459fda9ac776b9395ff5fc3a29b0d86226..335dbab37bb2c88b5e020181fc2b37352a385bd7 100644
--- a/arch/um/kernel/um_arch.c
+++ b/arch/um/kernel/um_arch.c
@@ -74,9 +74,11 @@ static char host_info[(__NEW_UTS_LEN + 1) * 5];
  * What this virtual CPU calls itself.  The emulator decides that, because it
  * is the component that decides what the CPU is; the kernel reports the
  * decision rather than making one of its own.  A UML kernel on a host with no
- * emulator behind it keeps upstream's name.
+ * emulator behind it keeps upstream's name.  arm64 Linux prints a model name
+ * only to a 32-bit task, which UML never runs, so the arm64 printer has no use
+ * for it.
  */
-static const char *uml_cpu_model_name(void)
+static const char * __maybe_unused uml_cpu_model_name(void)
 {
 #ifdef UML_HOST_DARWIN
 	return os_guest_cpu_model_name();
@@ -85,6 +87,81 @@ static const char *uml_cpu_model_name(void)
 #endif
 }
 
+#ifdef CONFIG_UML_ARM64
+/*
+ * arm64 userspace reads this file in arm64 Linux's format
+ * (arch/arm64/kernel/cpuinfo.c), and software chooses its instructions from
+ * it: LLVM's sys::getHostCPUFeatures() and GCC's -mcpu=native parse the
+ * "Features" line, and so does every JIT that asks LLVM, such as Mesa's
+ * llvmpipe.  Each block therefore names exactly the AT_HWCAP and AT_HWCAP2
+ * bits every task receives, in arm64 Linux's order and spelling, and
+ * identifies the CPU by the MIDR_EL1 value a task reads with MRS.  The file is
+ * the one c_show() prints for a 64-bit task, byte for byte.
+ *
+ * The emulator answers MRS MIDR_EL1 with emulated_midr_el1 in
+ * darwin/cpu/arm64/id_registers.hpp: no JEP106 implementer, variant, part or
+ * revision, and architecture 0xf, "described by the identification
+ * registers".  This kernel runs natively on the host, where it cannot read
+ * the emulated register, so the value is mirrored here, as the x86 slice
+ * mirrors the emulator's CPUID.  The host's engine smoke tests compare these
+ * lines with the register a guest task reads.
+ */
+#define UML_ARM64_MIDR 0x000f0000U
+
+/*
+ * arm64 Linux takes loops_per_jiffy from the architected timer:
+ * arm_arch_timer.c sets lpj_fine to DIV_ROUND_CLOSEST(arch_timer_rate, HZ), so
+ * calibrate_delay() skips its loop and BogoMIPS is twice the counter frequency
+ * in MHz.  UML keeps its calibrated loop for udelay(), and that loop's speed
+ * varies between boots, so the file prints what arm64 Linux would from the
+ * counter a task sees.  The engines answer MRS CNTFRQ_EL0 with the host's
+ * register, and this kernel runs natively on that host, so it reads the same
+ * register itself.
+ */
+static unsigned long uml_arm64_timer_lpj(void)
+{
+	unsigned long rate;
+
+	asm volatile("mrs %0, cntfrq_el0" : "=r" (rate));
+	return DIV_ROUND_CLOSEST(rate, HZ);
+}
+
+static void show_arm64_cpuinfo(struct seq_file *m, int cpu)
+{
+	/* UML provides no AT_HWCAP3, so no feature beyond these two words is
+	 * ever named. */
+	const unsigned long hwcaps[] = { ELF_HWCAP, ELF_HWCAP2 };
+	const unsigned long lpj = uml_arm64_timer_lpj();
+	unsigned int feature;
+
+	seq_printf(m, "processor\t: %d\n", cpu);
+	seq_printf(m, "BogoMIPS\t: %lu.%02lu\n",
+		   lpj / (500000UL / HZ),
+		   lpj / (5000UL / HZ) % 100);
+	seq_puts(m, "Features\t:");
+	for (feature = 0; feature < ARRAY_SIZE(hwcaps) * BITS_PER_LONG;
+	     feature++) {
+		const char *name;
+
+		if (!(hwcaps[feature / BITS_PER_LONG] &
+		      BIT(feature % BITS_PER_LONG)))
+			continue;
+		name = uml_arm64_hwcap_name(feature);
+		/* arm64 Linux never sets a bit it has no name for. */
+		if (WARN_ON_ONCE(!name))
+			continue;
+		seq_printf(m, " %s", name);
+	}
+	seq_puts(m, "\n");
+	seq_printf(m, "CPU implementer\t: 0x%02x\n",
+		   (UML_ARM64_MIDR >> 24) & 0xff);
+	seq_puts(m, "CPU architecture: 8\n");
+	seq_printf(m, "CPU variant\t: 0x%x\n", (UML_ARM64_MIDR >> 20) & 0xf);
+	seq_printf(m, "CPU part\t: 0x%03x\n", (UML_ARM64_MIDR >> 4) & 0xfff);
+	seq_printf(m, "CPU revision\t: %d\n\n", UML_ARM64_MIDR & 0xf);
+}
+#endif
+
 static int show_cpuinfo(struct seq_file *m, void *v)
 {
 	int i = 0;
@@ -95,6 +172,9 @@ static int show_cpuinfo(struct seq_file *m, void *v)
 		return 0;
 #endif
 
+#ifdef CONFIG_UML_ARM64
+	show_arm64_cpuinfo(m, i);
+#else
 	seq_printf(m, "processor\t: %d\n", i);
 	seq_printf(m, "vendor_id\t: User Mode Linux\n");
 	seq_printf(m, "model name\t: %s\n", uml_cpu_model_name());
@@ -110,6 +190,7 @@ static int show_cpuinfo(struct seq_file *m, void *v)
 	seq_printf(m, "bogomips\t: %lu.%02lu\n",
 		   loops_per_jiffy/(500000/HZ),
 		   (loops_per_jiffy/(5000/HZ)) % 100);
+#endif
 
 	return 0;
 }
@@ -292,6 +373,13 @@ EXPORT_SYMBOL(end_iomem);
 
 #define MIN_VMALLOC (32 * 1024 * 1024)
 
+#ifdef CONFIG_UML_ARM64
+/* arm64 /proc/cpuinfo names the AT_HWCAP and AT_HWCAP2 bits themselves
+ * (show_arm64_cpuinfo()), so a host feature line sets nothing. */
+static void __init parse_host_cpu_flags(char *line)
+{
+}
+#else
 static void __init parse_host_cpu_flags(char *line)
 {
 	int i;
@@ -300,6 +388,7 @@ static void __init parse_host_cpu_flags(char *line)
 			set_cpu_cap(&boot_cpu_data, i);
 	}
 }
+#endif
 
 static void __init parse_cache_line(char *line)
 {
diff --git a/arch/um/kernel/um_arch.h b/arch/um/kernel/um_arch.h
index 23ed4c90bb6dd26cc7c5205de694abce676f13ea..feb6c2eb55b5db90284304c3402d4d06c7d475fb 100644
--- a/arch/um/kernel/um_arch.h
+++ b/arch/um/kernel/um_arch.h
@@ -15,4 +15,11 @@ static inline void uml_dtb_init(void) { }
 
 extern int __init read_initrd(void);
 
+#ifdef CONFIG_UML_ARM64
+/* arm64 Linux's name for the hwcap numbered as its KERNEL_HWCAP_* constants
+ * number them: AT_HWCAP bit n is feature n, AT_HWCAP2 bit n is feature
+ * 64 + n.  NULL where arm64 Linux names no feature. */
+extern const char *uml_arm64_hwcap_name(unsigned int feature);
+#endif
+
 #endif
diff --git a/arch/um/os-Darwin/start_up.c b/arch/um/os-Darwin/start_up.c
index 69eda27a60dcd9cca8beff08cc7bced71e9ca7ab..63f19f530dd7738e25d4266bc8dd9f3a00f425aa 100644
--- a/arch/um/os-Darwin/start_up.c
+++ b/arch/um/os-Darwin/start_up.c
@@ -3,7 +3,6 @@
 #include <init.h>
 #include <kern_util.h>
 #include <os.h>
-#include <string.h>
 #include <unistd.h>
 
 #include "bridge.h"
@@ -32,34 +31,11 @@ void check_host_supports_tls(int *supports_tls, int *tls_min)
 void get_host_cpu_features(void (*flags_helper)(char *),
 			   void (*cache_helper)(char *))
 {
-	static const struct {
-		unsigned int bit;
-		const char *name;
-	} advertised[] = {
-		{ 0, "fp" },
-		{ 1, "asimd" },
-		{ 3, "aes" },
-		{ 4, "pmull" },
-		{ 5, "sha1" },
-		{ 6, "sha2" },
-		{ 7, "crc32" },
-		{ 8, "atomics" },
-		{ 17, "sha3" },
-		{ 21, "sha512" },
-	};
-	const unsigned long hwcap = darwin_uml_guest_hwcap();
-	char features[128] = "Features\t:";
+	/* arm64 /proc/cpuinfo names the AT_HWCAP and AT_HWCAP2 bits itself, so
+	 * this host reports no feature line, only its cache line. */
 	char cache[] = "cache_alignment\t: 64";
-	unsigned int i;
 
-	for (i = 0; i < sizeof(advertised) / sizeof(advertised[0]); ++i) {
-		if (!(hwcap & (1UL << advertised[i].bit)))
-			continue;
-		strcat(features, " ");
-		strcat(features, advertised[i].name);
-	}
-
-	flags_helper(features);
+	(void)flags_helper;
 	cache_helper(cache);
 }
 
