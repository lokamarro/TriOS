+
+/*
+ * The encoder's commands. Each synchronous one copies its answer to a buffer
+ * of its caller's and reports how many bytes the device wrote, which the
+ * copy alone does not say, through this callback, run for an answer its
+ * waiter still waits for.
+ */
+struct virtio_video_answer {
+	unsigned int len;
+};
+
+static void virtio_video_answer_cb(struct virtio_video_device *vvd,
+				   struct virtio_video_vbuffer *vbuf)
+{
+	struct virtio_video_answer *answer = vbuf->priv;
+
+	answer->len = vbuf->resp_len;
+}
+
+/* The errno of a response to a command that sets or gets V4L2 controls. */
+static int virtio_video_controls_status(const void *resp, unsigned int len,
+					unsigned int num_controls)
+{
+	const struct virtio_video_v4l2_controls_resp *controls = resp;
+
+	if (len < sizeof(controls->hdr))
+		return -EIO;
+
+	switch (le32_to_cpu(controls->hdr.type)) {
+	case VIRTIO_VIDEO_RESP_OK_NODATA:
+		return 0;
+	case VIRTIO_VIDEO_RESP_OK_V4L2_CONTROLS:
+		if (len < sizeof(*controls))
+			return -EIO;
+		/* Short of every control means one of them failed. */
+		if (le32_to_cpu(controls->error_index) < num_controls)
+			return -EINVAL;
+		return 0;
+	case VIRTIO_VIDEO_RESP_ERR_UNSUPPORTED_CONTROL:
+		return -EINVAL;
+	case VIRTIO_VIDEO_RESP_ERR_INVALID_PARAMETER:
+		return -ERANGE;
+	case VIRTIO_VIDEO_RESP_ERR_BUSY:
+		return -EBUSY;
+	default:
+		return -EIO;
+	}
+}
+
+int virtio_video_cmd_query_v4l2_controls(struct virtio_video_device *vvd,
+					 uint32_t start_index, void *resp_buf,
+					 size_t resp_size, size_t *resp_len)
+{
+	int ret;
+	struct virtio_video_query_v4l2_controls *req_p;
+	struct virtio_video_vbuffer *vbuf;
+	struct virtio_video_answer answer = {};
+
+	req_p = virtio_video_alloc_req_resp(vvd, virtio_video_answer_cb, &vbuf,
+					    sizeof(*req_p), resp_size,
+					    resp_buf);
+	if (IS_ERR(req_p))
+		return PTR_ERR(req_p);
+
+	req_p->hdr.type = cpu_to_le32(VIRTIO_VIDEO_CMD_QUERY_V4L2_CONTROLS);
+	req_p->start_index = cpu_to_le32(start_index);
+	vbuf->priv = &answer;
+
+	ret = virtio_video_queue_cmd_buffer_sync(vvd, vbuf);
+	if (ret == -ETIMEDOUT)
+		v4l2_err(&vvd->v4l2_dev,
+			 "timed out waiting for the control query\n");
+	if (!ret)
+		*resp_len = answer.len;
+
+	return ret;
+}
+
+int virtio_video_cmd_set_v4l2_control(struct virtio_video_device *vvd,
+				      struct virtio_video_stream *stream,
+				      uint32_t id, int64_t value,
+				      const void *payload, uint32_t size)
+{
+	int ret;
+	struct virtio_video_v4l2_controls *req_p;
+	struct virtio_video_v4l2_control_value *entry;
+	struct virtio_video_v4l2_controls_resp resp = {};
+	struct virtio_video_vbuffer *vbuf;
+	struct virtio_video_answer answer = {};
+	size_t req_size = sizeof(*req_p) + sizeof(*entry) + ALIGN(size, 8);
+
+	/* A compound control is a few dozen bytes. */
+	if (req_size > MAX_INLINE_CMD_SIZE)
+		return -EINVAL;
+
+	req_p = virtio_video_alloc_req_resp(vvd, virtio_video_answer_cb, &vbuf,
+					    req_size, sizeof(resp), &resp);
+	if (IS_ERR(req_p))
+		return PTR_ERR(req_p);
+
+	req_p->hdr.type = cpu_to_le32(VIRTIO_VIDEO_CMD_SET_V4L2_CONTROLS);
+	req_p->hdr.stream_id = cpu_to_le32(stream->stream_id);
+	req_p->num_controls = cpu_to_le32(1);
+	entry = (void *)(req_p + 1);
+	entry->id = cpu_to_le32(id);
+	entry->size = cpu_to_le32(size);
+	if (size)
+		memcpy(entry + 1, payload, size);
+	else
+		entry->value = cpu_to_le64(value);
+	vbuf->priv = &answer;
+
+	ret = virtio_video_queue_cmd_buffer_sync(vvd, vbuf);
+	if (ret == -ETIMEDOUT)
+		v4l2_err(&vvd->v4l2_dev,
+			 "timed out waiting for control %#x to be set\n", id);
+	if (ret)
+		return ret;
+
+	return virtio_video_controls_status(&resp, answer.len, 1);
+}
+
+int virtio_video_cmd_get_v4l2_control(struct virtio_video_device *vvd,
+				      struct virtio_video_stream *stream,
+				      uint32_t id, int64_t *value,
+				      void *payload, uint32_t size)
+{
+	int ret;
+	struct virtio_video_v4l2_controls *req_p;
+	struct virtio_video_v4l2_control_value *entry;
+	struct virtio_video_vbuffer *vbuf;
+	struct virtio_video_answer answer = {};
+	struct virtio_video_v4l2_controls_resp *resp;
+	size_t resp_size = sizeof(*resp) + sizeof(*entry) + ALIGN(size, 8);
+	u64 offset;
+
+	resp = kzalloc(resp_size, GFP_KERNEL);
+	if (!resp)
+		return -ENOMEM;
+
+	req_p = virtio_video_alloc_req_resp(vvd, virtio_video_answer_cb, &vbuf,
+					    sizeof(*req_p) + sizeof(*entry),
+					    resp_size, resp);
+	if (IS_ERR(req_p)) {
+		ret = PTR_ERR(req_p);
+		goto out;
+	}
+
+	req_p->hdr.type = cpu_to_le32(VIRTIO_VIDEO_CMD_GET_V4L2_CONTROLS);
+	req_p->hdr.stream_id = cpu_to_le32(stream->stream_id);
+	req_p->num_controls = cpu_to_le32(1);
+	entry = (void *)(req_p + 1);
+	entry->id = cpu_to_le32(id);
+	vbuf->priv = &answer;
+
+	ret = virtio_video_queue_cmd_buffer_sync(vvd, vbuf);
+	if (ret == -ETIMEDOUT)
+		v4l2_err(&vvd->v4l2_dev,
+			 "timed out waiting for control %#x\n", id);
+	if (ret)
+		goto out;
+
+	ret = virtio_video_controls_status(resp, answer.len, 1);
+	if (ret)
+		goto out;
+
+	/* The values follow the header, then the payload area. */
+	if (answer.len < resp_size - ALIGN(size, 8) ||
+	    le32_to_cpu(resp->num_controls) != 1) {
+		ret = -EIO;
+		goto out;
+	}
+	entry = (void *)(resp + 1);
+	if (le32_to_cpu(entry->id) != id ||
+	    le32_to_cpu(entry->size) != size) {
+		ret = -EIO;
+		goto out;
+	}
+	if (!size) {
+		*value = le64_to_cpu(entry->value);
+		goto out;
+	}
+	offset = le64_to_cpu(entry->value);
+	if (offset > ALIGN(size, 8) - size ||
+	    answer.len < sizeof(*resp) + sizeof(*entry) + offset + size) {
+		ret = -EIO;
+		goto out;
+	}
+	memcpy(payload, (u8 *)(entry + 1) + offset, size);
+out:
+	kfree(resp);
+	return ret;
+}
+
+int virtio_video_cmd_set_stream_info(struct virtio_video_device *vvd,
+				     struct virtio_video_stream *stream,
+				     enum virtio_video_queue_type queue_type,
+				     const struct video_stream_info *info)
+{
+	struct virtio_video_set_stream_info *req_p;
+	struct virtio_video_vbuffer *vbuf;
+
+	req_p = virtio_video_alloc_req(vvd, &vbuf, sizeof(*req_p));
+	if (IS_ERR(req_p))
+		return PTR_ERR(req_p);
+
+	req_p->hdr.type = cpu_to_le32(VIRTIO_VIDEO_CMD_SET_STREAM_INFO);
+	req_p->hdr.stream_id = cpu_to_le32(stream->stream_id);
+	req_p->info.queue_type = cpu_to_le32(queue_type);
+	req_p->info.frame_interval_numerator =
+		cpu_to_le32(info->interval_numerator);
+	req_p->info.frame_interval_denominator =
+		cpu_to_le32(info->interval_denominator);
+	req_p->info.colorspace = cpu_to_le32(info->colorspace);
+	req_p->info.xfer_func = cpu_to_le32(info->xfer_func);
+	req_p->info.ycbcr_enc = cpu_to_le32(info->ycbcr_enc);
+	req_p->info.quantization = cpu_to_le32(info->quantization);
+
+	return virtio_video_queue_cmd_buffer(vvd, vbuf);
+}
+
+int virtio_video_cmd_get_stream_info(struct virtio_video_device *vvd,
+				     struct virtio_video_stream *stream,
+				     enum virtio_video_queue_type queue_type,
+				     struct video_stream_info *info)
+{
+	int ret;
+	struct virtio_video_get_stream_info *req_p;
+	struct virtio_video_get_stream_info_resp resp = {};
+	struct virtio_video_vbuffer *vbuf;
+	struct virtio_video_answer answer = {};
+
+	req_p = virtio_video_alloc_req_resp(vvd, virtio_video_answer_cb, &vbuf,
+					    sizeof(*req_p), sizeof(resp),
+					    &resp);
+	if (IS_ERR(req_p))
+		return PTR_ERR(req_p);
+
+	req_p->hdr.type = cpu_to_le32(VIRTIO_VIDEO_CMD_GET_STREAM_INFO);
+	req_p->hdr.stream_id = cpu_to_le32(stream->stream_id);
+	req_p->queue_type = cpu_to_le32(queue_type);
+	vbuf->priv = &answer;
+
+	ret = virtio_video_queue_cmd_buffer_sync(vvd, vbuf);
+	if (ret == -ETIMEDOUT)
+		v4l2_err(&vvd->v4l2_dev,
+			 "timed out waiting for the stream information\n");
+	if (ret)
+		return ret;
+
+	/* An answer of the wrong kind leaves what the caller already has. */
+	if (answer.len < sizeof(resp) ||
+	    le32_to_cpu(resp.hdr.type) != VIRTIO_VIDEO_RESP_OK_STREAM_INFO)
+		return -EIO;
+
+	info->interval_numerator =
+		le32_to_cpu(resp.info.frame_interval_numerator);
+	info->interval_denominator =
+		le32_to_cpu(resp.info.frame_interval_denominator);
+	info->colorspace = le32_to_cpu(resp.info.colorspace);
+	info->xfer_func = le32_to_cpu(resp.info.xfer_func);
+	info->ycbcr_enc = le32_to_cpu(resp.info.ycbcr_enc);
+	info->quantization = le32_to_cpu(resp.info.quantization);
+
+	return 0;
+}
