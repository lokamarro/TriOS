diff --git a/drivers/media/virtio/virtio_video_ctrls.c b/drivers/media/virtio/virtio_video_ctrls.c
new file mode 100644
index 0000000000000000000000000000000000000000..d3f6fbd6c3accb83412ab9d13bbefd9477d5cc0b
--- /dev/null
+++ b/drivers/media/virtio/virtio_video_ctrls.c
@@ -0,0 +1,414 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * V4L2 controls of the Virtio video encoder.
+ *
+ * The encoder device lists the controls it supports, with their type, range,
+ * default, menu skip mask and flags, as V4L2 control IDs and V4L2 menu
+ * indices, and this driver registers exactly that list for every stream and
+ * forwards a value unchanged. A capability the host learns therefore needs no
+ * change here. A control this kernel does not define, or whose type or menu
+ * the device describes differently from what this kernel defines for it, is
+ * left out, so a newer device never makes an older driver refuse to open.
+ * The framework's table types a few booleans and buttons as integers because
+ * it has no entry for them; the device's boolean or button is registered as the
+ * device describes it.
+ *
+ * Controls that cannot change while the stream encodes are grabbed from the
+ * moment the coded queue streams until it stops, so they fail with EBUSY as the
+ * stateful encoder interface requires.
+ */
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-event.h>
+
+#include "virtio_video.h"
+
+/* A device that lists more than this many controls is not one of ours. */
+#define VIRTIO_VIDEO_MAX_V4L2_CTRLS 1024
+
+/*
+ * Whether the device's description of a control can be registered. The
+ * checks are the ones the control framework would turn into a failed open.
+ */
+static bool virtio_video_ctrl_usable(struct virtio_video_device *vvd,
+				     const struct video_v4l2_control *c)
+{
+	const char * const *menu;
+	enum v4l2_ctrl_type type;
+	const char *name;
+	unsigned int items;
+	u32 flags;
+	s64 min = 0, max = 0, def = 0;
+	u64 step = 0;
+
+	if (!v4l2_ctrl_get_name(c->id))
+		return false;
+
+	v4l2_ctrl_fill(c->id, &name, &type, &min, &max, &step, &def, &flags);
+	/*
+	 * The table reports an integer for an ID it has no entry for, such as
+	 * PREPEND_SPSPPS_TO_IDR and H264_HIERARCHICAL_CODING, which are
+	 * booleans. Those are registered as the device describes them.
+	 */
+	if (type != c->type &&
+	    !(type == V4L2_CTRL_TYPE_INTEGER &&
+	      (c->type == V4L2_CTRL_TYPE_BOOLEAN ||
+	       c->type == V4L2_CTRL_TYPE_BUTTON)))
+		return false;
+
+	switch (c->type) {
+	case V4L2_CTRL_TYPE_INTEGER:
+		return c->minimum <= c->maximum &&
+		       c->default_value >= c->minimum &&
+		       c->default_value <= c->maximum;
+	case V4L2_CTRL_TYPE_BOOLEAN:
+		return c->default_value == 0 || c->default_value == 1;
+	case V4L2_CTRL_TYPE_BUTTON:
+		return true;
+	case V4L2_CTRL_TYPE_MENU:
+		menu = v4l2_ctrl_get_menu(c->id);
+		if (!menu || c->minimum != 0 || c->maximum < 0 ||
+		    c->maximum >= BITS_PER_LONG_LONG ||
+		    c->default_value < 0 || c->default_value > c->maximum ||
+		    (c->menu_skip_mask & BIT_ULL(c->default_value)))
+			return false;
+		/* Every index the device offers needs a name. */
+		for (items = 0; menu[items]; items++)
+			;
+		return c->maximum < items;
+	case V4L2_CTRL_TYPE_HDR10_CLL_INFO:
+		return c->elem_size == sizeof(struct v4l2_ctrl_hdr10_cll_info);
+	case V4L2_CTRL_TYPE_HDR10_MASTERING_DISPLAY:
+		return c->elem_size ==
+		       sizeof(struct v4l2_ctrl_hdr10_mastering_display);
+	default:
+		return false;
+	}
+}
+
+static void virtio_video_add_ctrl(struct virtio_video_device *vvd,
+				  const struct virtio_video_v4l2_control_desc *desc)
+{
+	struct video_v4l2_control *c;
+
+	c = kzalloc(sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return;
+
+	c->id = le32_to_cpu(desc->id);
+	c->type = le32_to_cpu(desc->type);
+	c->minimum = le64_to_cpu(desc->minimum);
+	c->maximum = le64_to_cpu(desc->maximum);
+	c->step = le64_to_cpu(desc->step);
+	c->default_value = le64_to_cpu(desc->default_value);
+	c->menu_skip_mask = le64_to_cpu(desc->menu_skip_mask);
+	c->flags = le32_to_cpu(desc->flags);
+	c->elem_size = le32_to_cpu(desc->elem_size);
+	c->coded_formats = le64_to_cpu(desc->coded_formats);
+
+	if (!virtio_video_ctrl_usable(vvd, c)) {
+		v4l2_dbg(1, vvd->debug, &vvd->v4l2_dev,
+			 "control %#x (type %u) is not one this kernel can register\n",
+			 c->id, c->type);
+		kfree(c);
+		return;
+	}
+
+	list_add_tail(&c->list_entry, &vvd->v4l2_ctrl_list);
+	vvd->num_v4l2_ctrls++;
+}
+
+void virtio_video_clean_v4l2_controls(struct virtio_video_device *vvd)
+{
+	struct video_v4l2_control *c, *tmp;
+
+	list_for_each_entry_safe(c, tmp, &vvd->v4l2_ctrl_list, list_entry) {
+		list_del(&c->list_entry);
+		kfree(c);
+	}
+	vvd->num_v4l2_ctrls = 0;
+}
+
+/*
+ * Fetch the device's control list, a page of descriptors at a time. The
+ * reply says where the next page starts, and zero once the list is complete.
+ */
+int virtio_video_query_v4l2_controls(struct virtio_video_device *vvd)
+{
+	struct virtio_video_query_v4l2_controls_resp *resp;
+	size_t size = vvd->max_resp_len;
+	uint32_t start = 0, total = 0;
+	int ret = 0;
+
+	if (size < sizeof(*resp) + sizeof(struct virtio_video_v4l2_control_desc)) {
+		v4l2_err(&vvd->v4l2_dev, "no room for a control descriptor\n");
+		return -EINVAL;
+	}
+
+	resp = kzalloc(size, GFP_KERNEL);
+	if (!resp)
+		return -ENOMEM;
+
+	for (;;) {
+		const struct virtio_video_v4l2_control_desc *descs = (void *)(resp + 1);
+		uint32_t num, next, i;
+		size_t len;
+
+		ret = virtio_video_cmd_query_v4l2_controls(vvd, start, resp, size,
+							   &len);
+		if (ret)
+			break;
+
+		if (len < sizeof(*resp) ||
+		    le32_to_cpu(resp->hdr.type) !=
+		    VIRTIO_VIDEO_RESP_OK_QUERY_V4L2_CONTROLS) {
+			v4l2_err(&vvd->v4l2_dev, "invalid control reply\n");
+			ret = -EIO;
+			break;
+		}
+
+		num = le32_to_cpu(resp->num_descs);
+		if (num > (len - sizeof(*resp)) / sizeof(*descs)) {
+			v4l2_err(&vvd->v4l2_dev,
+				 "control count exceeds the reply\n");
+			ret = -EIO;
+			break;
+		}
+
+		total += num;
+		if (total > VIRTIO_VIDEO_MAX_V4L2_CTRLS) {
+			v4l2_err(&vvd->v4l2_dev, "too many controls\n");
+			ret = -EIO;
+			break;
+		}
+		for (i = 0; i < num; i++)
+			virtio_video_add_ctrl(vvd, &descs[i]);
+
+		next = le32_to_cpu(resp->next_index);
+		if (!next)
+			break;
+		/* Every page moves forward, or the list never ends. */
+		if (!num || next <= start) {
+			v4l2_err(&vvd->v4l2_dev,
+				 "control list does not advance\n");
+			ret = -EIO;
+			break;
+		}
+		start = next;
+	}
+
+	kfree(resp);
+	if (ret)
+		virtio_video_clean_v4l2_controls(vvd);
+
+	return ret;
+}
+
+static int virtio_video_ctrl_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct virtio_video_stream *stream = ctrl2stream(ctrl);
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	if (ctrl->type >= V4L2_CTRL_COMPOUND_TYPES)
+		return virtio_video_cmd_set_v4l2_control(vvd, stream, ctrl->id,
+							 0, ctrl->p_new.p,
+							 ctrl->elem_size);
+
+	/* A button has no value; the device runs it when it is set. */
+	return virtio_video_cmd_set_v4l2_control(vvd, stream, ctrl->id,
+						 ctrl->type == V4L2_CTRL_TYPE_BUTTON ?
+						 1 : ctrl->val, NULL, 0);
+}
+
+static int virtio_video_ctrl_g_volatile_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct virtio_video_stream *stream = ctrl2stream(ctrl);
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	int64_t value = 0;
+	int ret;
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	if (ctrl->type >= V4L2_CTRL_COMPOUND_TYPES)
+		return virtio_video_cmd_get_v4l2_control(vvd, stream, ctrl->id,
+							 &value,
+							 ctrl->p_new.p,
+							 ctrl->elem_size);
+
+	ret = virtio_video_cmd_get_v4l2_control(vvd, stream, ctrl->id, &value,
+						NULL, 0);
+	if (ret)
+		return ret;
+
+	ctrl->val = clamp_t(s64, value, ctrl->minimum, ctrl->maximum);
+
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops virtio_video_ctrl_ops = {
+	.s_ctrl = virtio_video_ctrl_s_ctrl,
+	.g_volatile_ctrl = virtio_video_ctrl_g_volatile_ctrl,
+};
+
+/*
+ * A boolean or a button as the device describes it. v4l2_ctrl_new_std() takes
+ * the type from the framework's table, which gives some booleans no entry.
+ */
+static struct v4l2_ctrl *
+virtio_video_ctrl_register_flag(struct v4l2_ctrl_handler *hdl,
+				const struct video_v4l2_control *c)
+{
+	bool boolean = c->type == V4L2_CTRL_TYPE_BOOLEAN;
+	struct v4l2_ctrl_config cfg = {
+		.ops = &virtio_video_ctrl_ops,
+		.id = c->id,
+		.name = v4l2_ctrl_get_name(c->id),
+		.type = c->type,
+		.max = boolean,
+		.step = boolean,
+		.def = boolean ? c->default_value : 0,
+	};
+
+	return v4l2_ctrl_new_custom(hdl, &cfg, NULL);
+}
+
+static struct v4l2_ctrl *
+virtio_video_ctrl_register(struct virtio_video_stream *stream,
+			   const struct video_v4l2_control *c)
+{
+	struct v4l2_ctrl_handler *hdl = &stream->ctrl_handler;
+	/* The framework keeps integer controls in 32 bits. */
+	s64 min = max_t(s64, c->minimum, S32_MIN);
+	s64 max = min_t(s64, c->maximum, S32_MAX);
+	s64 def = clamp_t(s64, c->default_value, min, max);
+	u64 step = c->step ? c->step : 1;
+
+	switch (c->type) {
+	case V4L2_CTRL_TYPE_INTEGER:
+		return v4l2_ctrl_new_std(hdl, &virtio_video_ctrl_ops, c->id,
+					 min, max, step, def);
+	case V4L2_CTRL_TYPE_BOOLEAN:
+	case V4L2_CTRL_TYPE_BUTTON:
+		return virtio_video_ctrl_register_flag(hdl, c);
+	case V4L2_CTRL_TYPE_MENU:
+		return v4l2_ctrl_new_std_menu(hdl, &virtio_video_ctrl_ops,
+					      c->id, c->maximum,
+					      c->menu_skip_mask,
+					      c->default_value);
+	default:
+		return v4l2_ctrl_new_std_compound(hdl, &virtio_video_ctrl_ops,
+						  c->id,
+						  v4l2_ctrl_ptr_create(NULL),
+						  v4l2_ctrl_ptr_create(NULL),
+						  v4l2_ctrl_ptr_create(NULL));
+	}
+}
+
+int virtio_video_ctrls_init(struct virtio_video_stream *stream)
+{
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct v4l2_ctrl_handler *hdl = &stream->ctrl_handler;
+	struct video_v4l2_control *c;
+	struct virtio_video_ctrl_ref *refs;
+	unsigned int n = 0;
+	bool min_buffers = false;
+
+	v4l2_ctrl_handler_init(hdl, vvd->num_v4l2_ctrls + 1);
+	if (hdl->error)
+		return hdl->error;
+
+	refs = kcalloc(vvd->num_v4l2_ctrls + 1, sizeof(*refs), GFP_KERNEL);
+	if (!refs)
+		return -ENOMEM;
+	stream->ctrl_refs = refs;
+
+	list_for_each_entry(c, &vvd->v4l2_ctrl_list, list_entry) {
+		struct v4l2_ctrl *ctrl = virtio_video_ctrl_register(stream, c);
+
+		if (!ctrl) {
+			if (hdl->error)
+				return hdl->error;
+			continue;
+		}
+
+		if (c->flags & VIRTIO_VIDEO_V4L2_CTRL_F_READ_ONLY)
+			ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+		if (c->flags & VIRTIO_VIDEO_V4L2_CTRL_F_VOLATILE)
+			ctrl->flags |= V4L2_CTRL_FLAG_VOLATILE;
+
+		if (c->id == V4L2_CID_MIN_BUFFERS_FOR_OUTPUT)
+			min_buffers = true;
+
+		refs[n].ctrl = ctrl;
+		refs[n].desc = c;
+		n++;
+	}
+	stream->num_ctrl_refs = n;
+
+	/*
+	 * How many raw frames a client has to hold is a property of the
+	 * stream even for a device that does not list it.
+	 */
+	if (!min_buffers && stream->in_info.min_buffers) {
+		struct v4l2_ctrl *ctrl;
+
+		ctrl = v4l2_ctrl_new_std(hdl, NULL,
+					 V4L2_CID_MIN_BUFFERS_FOR_OUTPUT,
+					 MIN_BUFS_MIN, MIN_BUFS_MAX,
+					 MIN_BUFS_STEP,
+					 min_t(u32, stream->in_info.min_buffers,
+					       MIN_BUFS_MAX));
+		if (ctrl)
+			ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	}
+
+	return hdl->error;
+}
+
+/*
+ * Controls the device refuses to change while the stream encodes are grabbed
+ * when the coded queue starts and released when it stops, which is what the
+ * stateful encoder interface asks a driver to do: stopping the coded queue is
+ * how a client reaches a state where they can change.
+ */
+void virtio_video_ctrls_grab(struct virtio_video_stream *stream, bool grab)
+{
+	unsigned int i;
+
+	for (i = 0; i < stream->num_ctrl_refs; i++) {
+		struct virtio_video_ctrl_ref *ref = &stream->ctrl_refs[i];
+
+		if (ref->desc->flags & (VIRTIO_VIDEO_V4L2_CTRL_F_DYNAMIC |
+					VIRTIO_VIDEO_V4L2_CTRL_F_READ_ONLY))
+			continue;
+		if (ref->ctrl->type == V4L2_CTRL_TYPE_BUTTON)
+			continue;
+		v4l2_ctrl_grab(ref->ctrl, grab);
+	}
+}
+
+/*
+ * The device says which coded formats a control applies to, and a client sees
+ * the others as inactive. The mask is only a hint: an inactive control can
+ * still be set, and one that names no coded format applies to all of them.
+ */
+void virtio_video_ctrls_set_coded_format(struct virtio_video_stream *stream,
+					 uint32_t wire_format)
+{
+	unsigned int i;
+	u64 bit = 0;
+
+	if (wire_format >= VIRTIO_VIDEO_FORMAT_CODED_MIN &&
+	    wire_format - VIRTIO_VIDEO_FORMAT_CODED_MIN < BITS_PER_LONG_LONG)
+		bit = BIT_ULL(wire_format - VIRTIO_VIDEO_FORMAT_CODED_MIN);
+
+	for (i = 0; i < stream->num_ctrl_refs; i++) {
+		struct virtio_video_ctrl_ref *ref = &stream->ctrl_refs[i];
+		u64 formats = ref->desc->coded_formats;
+
+		v4l2_ctrl_activate(ref->ctrl, !formats || !bit || (formats & bit));
+	}
+}
