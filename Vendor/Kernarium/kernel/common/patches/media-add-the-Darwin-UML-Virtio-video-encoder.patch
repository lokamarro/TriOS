+
+/*
+ * A V4L2 stateful encoder (Documentation/userspace-api/media/v4l/dev-encoder.rst)
+ * on a virtio video device with device ID 30. The queue roles follow the wire:
+ * the device's input queue holds raw frames and is V4L2's OUTPUT queue, and its
+ * output queue holds coded buffers and is V4L2's CAPTURE queue.
+ *
+ * The device encodes only while both queues stream, and it creates its session
+ * at the first raw frame it sees, from the controls and formats it holds at that
+ * moment. A raw frame therefore reaches the device only once the coded queue
+ * streams, which is also when the controls that cannot change while encoding
+ * are grabbed, and not while a drain holds the stream.
+ */
+
+#include <linux/math64.h>
+#include <linux/sizes.h>
+#include <media/v4l2-common.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-ioctl.h>
+
+#include "virtio_video.h"
+
+/* A coded buffer a client asks for beyond this is capped. */
+#define VIRTIO_VIDEO_ENC_MAX_CODED_SIZE SZ_64M
+
+/*
+ * Formats
+ */
+
+u32 virtio_video_enc_coded_to_v4l2(u32 wire_format)
+{
+	/* The decoder lists motion JPEG as a video; the encoder makes pictures. */
+	if (wire_format == VIRTIO_VIDEO_FORMAT_MJPEG)
+		return V4L2_PIX_FMT_JPEG;
+
+	return virtio_video_format_to_v4l2(wire_format);
+}
+
+/*
+ * The V4L2 names of a raw wire format: one buffer holding every plane, and
+ * one buffer for each plane, which is zero where V4L2 has no such name.
+ */
+static void enc_raw_names(u32 wire_format, u32 *single, u32 *planar)
+{
+	*planar = 0;
+
+	switch (wire_format) {
+	case VIRTIO_VIDEO_FORMAT_NV12:
+		*single = V4L2_PIX_FMT_NV12;
+		*planar = V4L2_PIX_FMT_NV12M;
+		break;
+	case VIRTIO_VIDEO_FORMAT_YUV420:
+		*single = V4L2_PIX_FMT_YUV420;
+		*planar = V4L2_PIX_FMT_YUV420M;
+		break;
+	case VIRTIO_VIDEO_FORMAT_NV16:
+		*single = V4L2_PIX_FMT_NV16;
+		*planar = V4L2_PIX_FMT_NV16M;
+		break;
+	case VIRTIO_VIDEO_FORMAT_NV24:
+		*single = V4L2_PIX_FMT_NV24;
+		break;
+	case VIRTIO_VIDEO_FORMAT_RGBA8888:
+		/* R, G, B, A in memory. The decoder's older name for it is RGB32. */
+		*single = V4L2_PIX_FMT_RGBA32;
+		break;
+	default:
+		*single = virtio_video_format_to_v4l2(wire_format);
+		break;
+	}
+}
+
+/*
+ * The names a raw format is listed under: the primary one, and a second one
+ * when the device takes both layouts of its planes.
+ */
+void virtio_video_enc_raw_names(u32 wire_format, u32 planes_layout,
+				u32 *primary, u32 *alternative)
+{
+	u32 single, planar;
+	bool use_single, use_planar;
+
+	enc_raw_names(wire_format, &single, &planar);
+
+	use_single = !planes_layout ||
+		     (planes_layout & VIRTIO_VIDEO_PLANES_LAYOUT_SINGLE_BUFFER) ||
+		     !planar;
+	use_planar = planar &&
+		     (planes_layout & VIRTIO_VIDEO_PLANES_LAYOUT_PER_PLANE);
+
+	*alternative = 0;
+	if (use_single) {
+		*primary = single;
+		if (use_planar)
+			*alternative = planar;
+	} else {
+		*primary = planar;
+	}
+}
+
+/* The name of the layout a device reports by its plane count. */
+u32 virtio_video_enc_raw_to_v4l2(u32 wire_format, u32 num_planes)
+{
+	u32 single, planar;
+
+	enc_raw_names(wire_format, &single, &planar);
+
+	return num_planes > 1 && planar ? planar : single;
+}
+
+static struct video_format *enc_find_fmt(struct list_head *list, u32 fourcc,
+					 unsigned int *index)
+{
+	struct video_format *fmt;
+	unsigned int i = 0;
+
+	if (!fourcc)
+		return NULL;
+
+	list_for_each_entry(fmt, list, formats_list_entry) {
+		if (fmt->desc.format == fourcc ||
+		    (fmt->alt_format && fmt->alt_format == fourcc)) {
+			if (index)
+				*index = i;
+			return fmt;
+		}
+		i++;
+	}
+
+	return NULL;
+}
+
+static struct video_format *enc_current_coded(struct virtio_video_stream *stream,
+					      unsigned int *index)
+{
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+
+	return enc_find_fmt(&vvd->output_fmt_list,
+			    stream->out_info.fourcc_format, index);
+}
+
+/*
+ * A raw format and a coded one go together when either one's mask names the
+ * other, and a device that fills no mask puts no limit.
+ */
+static bool enc_raw_allowed(const struct video_format *raw,
+			    unsigned int raw_index,
+			    const struct video_format *coded,
+			    unsigned int coded_index)
+{
+	if (!coded)
+		return true;
+	if (!raw->desc.mask && !coded->desc.mask)
+		return true;
+
+	return (raw_index < 64 && (coded->desc.mask & BIT_ULL(raw_index))) ||
+	       (coded_index < 64 && (raw->desc.mask & BIT_ULL(coded_index)));
+}
+
+static u32 enc_constrain_dim(const struct virtio_video_format_range *range,
+			     u32 value)
+{
+	u32 lo = range->min, hi = range->max;
+
+	if (hi < lo)
+		hi = lo;
+	value = clamp(value, lo, hi);
+
+	if (range->step > 1) {
+		/* Sizes are in steps from the smallest one. */
+		u64 steps = DIV_ROUND_UP_ULL(value - lo, range->step);
+		u64 aligned = lo + steps * range->step;
+
+		if (aligned <= hi)
+			value = aligned;
+		else
+			value = lo + (hi - lo) / range->step * range->step;
+	}
+
+	return value;
+}
+
+static void enc_constrain_size(const struct video_format *fmt, u32 *width,
+			       u32 *height)
+{
+	const struct virtio_video_format_frame *frame;
+	unsigned int i;
+
+	if (!fmt || !fmt->desc.num_frames)
+		return;
+
+	/* The first range that holds the size; otherwise the first range. */
+	frame = &fmt->frames[0].frame;
+	for (i = 0; i < fmt->desc.num_frames; i++) {
+		const struct virtio_video_format_frame *f = &fmt->frames[i].frame;
+
+		if (within_range(f->width.min, *width, f->width.max) &&
+		    within_range(f->height.min, *height, f->height.max)) {
+			frame = f;
+			break;
+		}
+	}
+
+	*width = enc_constrain_dim(&frame->width, *width);
+	*height = enc_constrain_dim(&frame->height, *height);
+}
+
+/*
+ * Colorimetry
+ */
+
+static void enc_set_colorimetry(struct v4l2_pix_format_mplane *pix_mp,
+				const struct video_stream_info *info)
+{
+	pix_mp->colorspace = info->colorspace;
+	pix_mp->xfer_func = info->xfer_func;
+	pix_mp->ycbcr_enc = info->ycbcr_enc;
+	pix_mp->quantization = info->quantization;
+}
+
+static void enc_get_colorimetry(const struct v4l2_pix_format_mplane *pix_mp,
+				struct video_stream_info *info)
+{
+	memset(info, 0, sizeof(*info));
+	info->colorspace = pix_mp->colorspace;
+	info->xfer_func = pix_mp->xfer_func;
+	info->ycbcr_enc = pix_mp->ycbcr_enc;
+	info->quantization = pix_mp->quantization;
+}
+
+static bool enc_same_colorimetry(const struct video_stream_info *a,
+				 const struct video_stream_info *b)
+{
+	return a->colorspace == b->colorspace && a->xfer_func == b->xfer_func &&
+	       a->ycbcr_enc == b->ycbcr_enc &&
+	       a->quantization == b->quantization;
+}
+
+/*
+ * Read the device's stream information back: the coded queue's frame interval
+ * and colorimetry, which are what the stream carries, and, for a new stream,
+ * the colorimetry the raw queue starts with. After that the raw colorimetry
+ * is the client's to state, so the driver keeps the values it was given and
+ * never replaces them with the device's answer, which reduces what it does not
+ * understand to a default: a client that states the same colors again would
+ * otherwise find them changed.
+ */
+static int enc_read_stream_info(struct virtio_video_stream *stream,
+				bool raw_colors)
+{
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct video_stream_info raw = {}, coded = {};
+	int ret;
+
+	if (raw_colors) {
+		ret = virtio_video_cmd_get_stream_info(vvd, stream,
+						       VIRTIO_VIDEO_QUEUE_TYPE_INPUT,
+						       &raw);
+		if (ret)
+			return ret;
+	}
+
+	ret = virtio_video_cmd_get_stream_info(vvd, stream,
+					       VIRTIO_VIDEO_QUEUE_TYPE_OUTPUT,
+					       &coded);
+	if (ret)
+		return ret;
+
+	if (raw_colors) {
+		stream->raw_info.colorspace = raw.colorspace;
+		stream->raw_info.xfer_func = raw.xfer_func;
+		stream->raw_info.ycbcr_enc = raw.ycbcr_enc;
+		stream->raw_info.quantization = raw.quantization;
+	}
+	stream->coded_info = coded;
+
+	return 0;
+}
+
+/*
+ * Format negotiation
+ */
+
+static void enc_clear_pix_reserved(struct v4l2_pix_format_mplane *pix_mp)
+{
+	unsigned int i;
+
+	pix_mp->field = V4L2_FIELD_NONE;
+	pix_mp->flags = 0;
+	memset(pix_mp->reserved, 0, sizeof(pix_mp->reserved));
+	for (i = 0; i < VIDEO_MAX_PLANES; i++)
+		memset(pix_mp->plane_fmt[i].reserved, 0,
+		       sizeof(pix_mp->plane_fmt[i].reserved));
+}
+
+/* A coded buffer is the device's size, or the client's when that is larger. */
+static void enc_fix_coded_size(struct virtio_video_stream *stream)
+{
+	struct video_format_info *info = &stream->out_info;
+
+	if (info->num_planes == 1)
+		info->plane_format[0].plane_size =
+			max(stream->coded_size_dev, stream->coded_size_min);
+}
+
+/* Read both queues' parameters back from the device. */
+static int enc_get_params(struct virtio_video_stream *stream)
+{
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	int ret;
+
+	ret = virtio_video_stream_get_params(vvd, stream);
+	if (ret)
+		return ret;
+
+	stream->coded_size_dev = stream->out_info.plane_format[0].plane_size;
+	enc_fix_coded_size(stream);
+
+	return 0;
+}
+
+static void enc_info_from_pix(struct video_format_info *info,
+			      const struct v4l2_pix_format_mplane *pix_mp)
+{
+	unsigned int i;
+
+	info->fourcc_format = pix_mp->pixelformat;
+	info->frame_width = pix_mp->width;
+	info->frame_height = pix_mp->height;
+	info->num_planes = pix_mp->num_planes;
+	for (i = 0; i < pix_mp->num_planes; i++) {
+		info->plane_format[i].stride = pix_mp->plane_fmt[i].bytesperline;
+		info->plane_format[i].plane_size = pix_mp->plane_fmt[i].sizeimage;
+	}
+}
+
+static void enc_g_fmt_raw(struct virtio_video_stream *stream,
+			  struct v4l2_pix_format_mplane *pix_mp)
+{
+	virtio_video_format_from_info(&stream->in_info, pix_mp);
+	enc_set_colorimetry(pix_mp, &stream->raw_info);
+}
+
+static void enc_g_fmt_coded(struct virtio_video_stream *stream,
+			    struct v4l2_pix_format_mplane *pix_mp)
+{
+	virtio_video_format_from_info(&stream->out_info, pix_mp);
+	enc_set_colorimetry(pix_mp, &stream->coded_info);
+}
+
+static int virtio_video_enc_g_fmt(struct file *file, void *fh,
+				  struct v4l2_format *f)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	if (V4L2_TYPE_IS_OUTPUT(f->type))
+		enc_g_fmt_raw(stream, &f->fmt.pix_mp);
+	else
+		enc_g_fmt_coded(stream, &f->fmt.pix_mp);
+
+	return 0;
+}
+
+/*
+ * The coded format a CAPTURE format resolves to. Its size is the visible
+ * rectangle of the raw queue and its buffer size is the device's, or the
+ * client's when that is larger.
+ */
+static int enc_try_coded(struct virtio_video_stream *stream,
+			 struct v4l2_pix_format_mplane *pix_mp)
+{
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct video_format *fmt;
+	u32 sizeimage = pix_mp->plane_fmt[0].sizeimage;
+	u32 fourcc = pix_mp->pixelformat;
+
+	fmt = enc_find_fmt(&vvd->output_fmt_list, fourcc, NULL);
+	if (!fmt)
+		fmt = enc_current_coded(stream, NULL);
+	if (!fmt)
+		return -EINVAL;
+
+	sizeimage = max(sizeimage, stream->coded_size_dev);
+	sizeimage = min_t(u32, sizeimage, VIRTIO_VIDEO_ENC_MAX_CODED_SIZE);
+
+	memset(pix_mp->plane_fmt, 0, sizeof(pix_mp->plane_fmt));
+	enc_clear_pix_reserved(pix_mp);
+	pix_mp->pixelformat = fmt->desc.format;
+	pix_mp->width = stream->out_info.frame_width;
+	pix_mp->height = stream->out_info.frame_height;
+	pix_mp->num_planes = 1;
+	pix_mp->plane_fmt[0].bytesperline = 0;
+	pix_mp->plane_fmt[0].sizeimage = sizeimage;
+	enc_set_colorimetry(pix_mp, &stream->coded_info);
+
+	return 0;
+}
+
+/*
+ * The raw format a OUTPUT format resolves to: one the device takes with the
+ * current coded format, at a size it supports, in the layout the device reads,
+ * whose rows lie at the pitch a guest allocator gives a buffer
+ * (virtio_video_fill_raw_layout()). A client's line length is a request the
+ * device does not honor, so it is answered with the device's.
+ */
+static int enc_try_raw(struct virtio_video_stream *stream,
+		       struct v4l2_pix_format_mplane *pix_mp)
+{
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct video_format *coded, *raw, *candidate;
+	unsigned int coded_index = 0, raw_index = 0, i = 0;
+	u32 fourcc = pix_mp->pixelformat;
+	u32 width = pix_mp->width, height = pix_mp->height;
+	struct video_stream_info colors;
+	int ret;
+
+	coded = enc_current_coded(stream, &coded_index);
+
+	raw = enc_find_fmt(&vvd->input_fmt_list, fourcc, &raw_index);
+	if (!raw || !enc_raw_allowed(raw, raw_index, coded, coded_index)) {
+		fourcc = stream->in_info.fourcc_format;
+		raw = enc_find_fmt(&vvd->input_fmt_list, fourcc, &raw_index);
+		if (!raw || !enc_raw_allowed(raw, raw_index, coded, coded_index)) {
+			raw = NULL;
+			list_for_each_entry(candidate, &vvd->input_fmt_list,
+					    formats_list_entry) {
+				if (candidate->desc.format &&
+				    enc_raw_allowed(candidate, i, coded,
+						    coded_index)) {
+					raw = candidate;
+					fourcc = candidate->desc.format;
+					break;
+				}
+				i++;
+			}
+		}
+		if (!raw)
+			return -EINVAL;
+	}
+
+	if (!width)
+		width = stream->in_info.frame_width;
+	if (!height)
+		height = stream->in_info.frame_height;
+	enc_constrain_size(raw, &width, &height);
+	enc_constrain_size(coded, &width, &height);
+
+	enc_get_colorimetry(pix_mp, &colors);
+
+	ret = virtio_video_fill_raw_layout(pix_mp, fourcc, width, height);
+	if (ret == -ENOENT) {
+		memset(pix_mp->plane_fmt, 0, sizeof(pix_mp->plane_fmt));
+		ret = v4l2_fill_pixfmt_mp(pix_mp, fourcc, width, height);
+	}
+	if (ret)
+		return ret;
+
+	enc_clear_pix_reserved(pix_mp);
+	enc_set_colorimetry(pix_mp, &colors);
+
+	return 0;
+}
+
+static int virtio_video_enc_try_fmt(struct file *file, void *fh,
+				    struct v4l2_format *f)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	if (V4L2_TYPE_IS_OUTPUT(f->type))
+		return enc_try_raw(stream, &f->fmt.pix_mp);
+
+	return enc_try_coded(stream, &f->fmt.pix_mp);
+}
+
+static bool enc_crop_is_full(const struct video_format_info *info)
+{
+	return !info->crop.left && !info->crop.top &&
+	       info->crop.width == info->frame_width &&
+	       info->crop.height == info->frame_height;
+}
+
+static int enc_s_fmt_raw(struct virtio_video_stream *stream,
+			 struct v4l2_pix_format_mplane *pix_mp)
+{
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct vb2_queue *src_vq = v4l2_m2m_get_vq(stream->fh.m2m_ctx,
+					V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+	struct video_format_info info;
+	struct video_stream_info colors;
+	bool layout_changed, colors_changed;
+	int ret;
+
+	ret = enc_try_raw(stream, pix_mp);
+	if (ret)
+		return ret;
+
+	enc_get_colorimetry(pix_mp, &colors);
+	layout_changed = pix_mp->pixelformat != stream->in_info.fourcc_format ||
+			 pix_mp->width != stream->in_info.frame_width ||
+			 pix_mp->height != stream->in_info.frame_height ||
+			 pix_mp->num_planes != stream->in_info.num_planes;
+	colors_changed = !enc_same_colorimetry(&colors, &stream->raw_info);
+
+	/* Setting the format also resets the visible rectangle. */
+	if (!layout_changed && !enc_crop_is_full(&stream->in_info))
+		layout_changed = true;
+
+	/* A format cannot change under buffers, nor under an encoding stream. */
+	if ((layout_changed || colors_changed) &&
+	    (vb2_is_busy(src_vq) || stream->capture_started))
+		return -EBUSY;
+
+	if (layout_changed) {
+		info = stream->in_info;
+		enc_info_from_pix(&info, pix_mp);
+		info.crop.left = 0;
+		info.crop.top = 0;
+		info.crop.width = pix_mp->width;
+		info.crop.height = pix_mp->height;
+
+		ret = virtio_video_cmd_set_params(vvd, stream, &info,
+						  VIRTIO_VIDEO_QUEUE_TYPE_INPUT);
+		if (ret)
+			return ret;
+		ret = enc_get_params(stream);
+		if (ret)
+			return ret;
+	}
+
+	if (colors_changed) {
+		/* A zero interval leaves the device's frame interval alone. */
+		colors.interval_numerator = 0;
+		colors.interval_denominator = 0;
+		ret = virtio_video_cmd_set_stream_info(vvd, stream,
+						       VIRTIO_VIDEO_QUEUE_TYPE_INPUT,
+						       &colors);
+		if (ret)
+			return ret;
+		/* The coded queue reports the colors the stream carries. */
+		ret = enc_read_stream_info(stream, false);
+		if (ret)
+			return ret;
+		stream->raw_info.colorspace = colors.colorspace;
+		stream->raw_info.xfer_func = colors.xfer_func;
+		stream->raw_info.ycbcr_enc = colors.ycbcr_enc;
+		stream->raw_info.quantization = colors.quantization;
+	}
+
+	enc_g_fmt_raw(stream, pix_mp);
+
+	return 0;
+}
+
+static int enc_s_fmt_coded(struct virtio_video_stream *stream,
+			   struct v4l2_pix_format_mplane *pix_mp)
+{
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct vb2_queue *src_vq = v4l2_m2m_get_vq(stream->fh.m2m_ctx,
+					V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+	struct vb2_queue *dst_vq = v4l2_m2m_get_vq(stream->fh.m2m_ctx,
+					V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+	u32 requested = min_t(u32, pix_mp->plane_fmt[0].sizeimage,
+			      VIRTIO_VIDEO_ENC_MAX_CODED_SIZE);
+	struct video_format_info info;
+	bool codec_changed, size_changed;
+	int ret;
+
+	ret = enc_try_coded(stream, pix_mp);
+	if (ret)
+		return ret;
+
+	codec_changed = pix_mp->pixelformat != stream->out_info.fourcc_format;
+	size_changed = max(requested, stream->coded_size_dev) !=
+		       stream->out_info.plane_format[0].plane_size;
+
+	/*
+	 * A new coded format may take the raw format with it, so neither queue
+	 * may have buffers, and the buffer size cannot change under buffers.
+	 */
+	if (codec_changed && (vb2_is_busy(src_vq) || vb2_is_busy(dst_vq) ||
+			      stream->capture_started))
+		return -EBUSY;
+	if (size_changed && vb2_is_busy(dst_vq))
+		return -EBUSY;
+
+	if (codec_changed) {
+		info = stream->out_info;
+		info.fourcc_format = pix_mp->pixelformat;
+		ret = virtio_video_cmd_set_params(vvd, stream, &info,
+						  VIRTIO_VIDEO_QUEUE_TYPE_OUTPUT);
+		if (ret)
+			return ret;
+		ret = enc_get_params(stream);
+		if (ret)
+			return ret;
+		ret = enc_read_stream_info(stream, false);
+		if (ret)
+			return ret;
+		virtio_video_ctrls_set_coded_format(stream,
+			virtio_video_v4l2_format_to_virtio(stream->out_info.fourcc_format));
+	}
+
+	stream->coded_size_min = requested;
+	enc_fix_coded_size(stream);
+	enc_g_fmt_coded(stream, pix_mp);
+
+	return 0;
+}
+
+static int virtio_video_enc_s_fmt(struct file *file, void *fh,
+				  struct v4l2_format *f)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+	int ret;
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	mutex_lock(&stream->vq_mutex);
+	if (V4L2_TYPE_IS_OUTPUT(f->type))
+		ret = enc_s_fmt_raw(stream, &f->fmt.pix_mp);
+	else
+		ret = enc_s_fmt_coded(stream, &f->fmt.pix_mp);
+	mutex_unlock(&stream->vq_mutex);
+
+	return ret;
+}
+
+static int virtio_video_enc_enum_fmt_vid_cap(struct file *file, void *fh,
+					     struct v4l2_fmtdesc *f)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct video_format *fmt;
+	unsigned int idx = 0;
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	if (f->type != V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE)
+		return -EINVAL;
+
+	list_for_each_entry(fmt, &vvd->output_fmt_list, formats_list_entry) {
+		if (!fmt->desc.format)
+			continue;
+		if (idx++ == f->index) {
+			f->pixelformat = fmt->desc.format;
+			/* The coded frame interval is the device's own. */
+			f->flags = V4L2_FMT_FLAG_ENC_CAP_FRAME_INTERVAL;
+			return 0;
+		}
+	}
+
+	return -EINVAL;
+}
+
+/* The raw formats the current coded format accepts. */
+static int virtio_video_enc_enum_fmt_vid_out(struct file *file, void *fh,
+					     struct v4l2_fmtdesc *f)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct video_format *fmt, *coded;
+	unsigned int coded_index = 0, i = 0, idx = 0;
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	if (f->type != V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE)
+		return -EINVAL;
+
+	coded = enc_current_coded(stream, &coded_index);
+
+	list_for_each_entry(fmt, &vvd->input_fmt_list, formats_list_entry) {
+		if (fmt->desc.format &&
+		    enc_raw_allowed(fmt, i, coded, coded_index)) {
+			if (idx++ == f->index) {
+				f->pixelformat = fmt->desc.format;
+				return 0;
+			}
+			if (fmt->alt_format && idx++ == f->index) {
+				f->pixelformat = fmt->alt_format;
+				return 0;
+			}
+		}
+		i++;
+	}
+
+	return -EINVAL;
+}
+
+/*
+ * Visible rectangle
+ */
+
+static int virtio_video_enc_g_selection(struct file *file, void *fh,
+					struct v4l2_selection *sel)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+	const struct video_format_info *info = &stream->in_info;
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	/* The core hands selection ioctls the single-plane type. */
+	if (sel->type != V4L2_BUF_TYPE_VIDEO_OUTPUT)
+		return -EINVAL;
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = info->frame_width;
+		sel->r.height = info->frame_height;
+		break;
+	case V4L2_SEL_TGT_CROP:
+		if (!info->crop.width || !info->crop.height) {
+			sel->r.left = 0;
+			sel->r.top = 0;
+			sel->r.width = info->frame_width;
+			sel->r.height = info->frame_height;
+			break;
+		}
+		sel->r.left = info->crop.left;
+		sel->r.top = info->crop.top;
+		sel->r.width = info->crop.width;
+		sel->r.height = info->crop.height;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static u32 enc_align_down(u32 value, u32 alignment)
+{
+	return alignment > 1 ? value - value % alignment : value;
+}
+
+static int enc_s_selection(struct virtio_video_stream *stream,
+			   struct v4l2_selection *sel)
+{
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct vb2_queue *src_vq = v4l2_m2m_get_vq(stream->fh.m2m_ctx,
+					V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+	const struct video_format_info *cur = &stream->in_info;
+	const struct video_format *coded = enc_current_coded(stream, NULL);
+	u32 frame_width = cur->frame_width, frame_height = cur->frame_height;
+	u32 alignment = 1, min_width = 1, min_height = 1;
+	struct v4l2_rect r = sel->r;
+	struct video_format_info info;
+	bool changed;
+	int ret;
+
+	if (coded && coded->desc.num_frames) {
+		const struct virtio_video_format_frame *frame =
+			&coded->frames[0].frame;
+
+		alignment = max(frame->width.step, frame->height.step);
+		min_width = frame->width.min;
+		min_height = frame->height.min;
+	}
+
+	if (!frame_width || !frame_height || r.width == 0 || r.height == 0)
+		return -EINVAL;
+
+	/* Move the rectangle into the frame and onto the encoder's grid. */
+	r.left = enc_align_down(clamp_t(s32, r.left, 0, frame_width - 1),
+				alignment);
+	r.top = enc_align_down(clamp_t(s32, r.top, 0, frame_height - 1),
+			       alignment);
+	r.width = enc_align_down(min(r.width, frame_width - r.left), alignment);
+	r.height = enc_align_down(min(r.height, frame_height - r.top),
+				  alignment);
+	if (r.width < min_width || r.height < min_height)
+		return -ERANGE;
+
+	{
+		/* The rectangle that was asked for, and the one that fits. */
+		s64 want_l = sel->r.left, want_t = sel->r.top;
+		s64 want_r = want_l + sel->r.width, want_b = want_t + sel->r.height;
+		s64 got_l = r.left, got_t = r.top;
+		s64 got_r = got_l + r.width, got_b = got_t + r.height;
+
+		if (((sel->flags & V4L2_SEL_FLAG_GE) &&
+		     (got_l > want_l || got_t > want_t ||
+		      got_r < want_r || got_b < want_b)) ||
+		    ((sel->flags & V4L2_SEL_FLAG_LE) &&
+		     (got_l < want_l || got_t < want_t ||
+		      got_r > want_r || got_b > want_b)))
+			return -ERANGE;
+	}
+
+	changed = r.left != cur->crop.left || r.top != cur->crop.top ||
+		  r.width != cur->crop.width || r.height != cur->crop.height;
+	if (changed && (vb2_is_busy(src_vq) || stream->capture_started))
+		return -EBUSY;
+
+	if (changed) {
+		info = *cur;
+		info.crop.left = r.left;
+		info.crop.top = r.top;
+		info.crop.width = r.width;
+		info.crop.height = r.height;
+
+		ret = virtio_video_cmd_set_params(vvd, stream, &info,
+						  VIRTIO_VIDEO_QUEUE_TYPE_INPUT);
+		if (ret)
+			return ret;
+		/* The coded size follows the rectangle the device kept. */
+		ret = enc_get_params(stream);
+		if (ret)
+			return ret;
+	}
+
+	sel->r.left = stream->in_info.crop.left;
+	sel->r.top = stream->in_info.crop.top;
+	sel->r.width = stream->in_info.crop.width;
+	sel->r.height = stream->in_info.crop.height;
+
+	return 0;
+}
+
+static int virtio_video_enc_s_selection(struct file *file, void *fh,
+					struct v4l2_selection *sel)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+	int ret;
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	if (sel->type != V4L2_BUF_TYPE_VIDEO_OUTPUT ||
+	    sel->target != V4L2_SEL_TGT_CROP)
+		return -EINVAL;
+
+	mutex_lock(&stream->vq_mutex);
+	ret = enc_s_selection(stream, sel);
+	mutex_unlock(&stream->vq_mutex);
+
+	return ret;
+}
+
+/*
+ * Frame interval
+ */
+
+static void enc_fill_parm(struct v4l2_streamparm *a,
+			  const struct video_stream_info *info)
+{
+	struct v4l2_fract *fract;
+
+	if (a->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE) {
+		memset(&a->parm.output, 0, sizeof(a->parm.output));
+		a->parm.output.capability = V4L2_CAP_TIMEPERFRAME;
+		fract = &a->parm.output.timeperframe;
+	} else {
+		memset(&a->parm.capture, 0, sizeof(a->parm.capture));
+		a->parm.capture.capability = V4L2_CAP_TIMEPERFRAME;
+		fract = &a->parm.capture.timeperframe;
+	}
+
+	fract->numerator = info->interval_numerator;
+	fract->denominator = info->interval_denominator;
+}
+
+static bool enc_parm_type_ok(u32 type)
+{
+	return type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE ||
+	       type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+}
+
+static int virtio_video_enc_g_parm(struct file *file, void *fh,
+				   struct v4l2_streamparm *a)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+
+	if (!enc_parm_type_ok(a->type))
+		return -EINVAL;
+
+	enc_fill_parm(a, a->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE ?
+			 &stream->raw_info : &stream->coded_info);
+
+	return 0;
+}
+
+/* Bring a frame interval to the frame rates the coded format lists. */
+static void enc_clamp_interval(struct virtio_video_stream *stream, u32 *num,
+			       u32 *den)
+{
+	const struct video_format *coded = enc_current_coded(stream, NULL);
+	const struct video_format_frame *frame;
+	const struct virtio_video_format_range *rate;
+	u32 min_rate, max_rate;
+
+	if (!coded || !coded->desc.num_frames)
+		return;
+	frame = &coded->frames[0];
+	if (!frame->frame.num_rates || !frame->frame_rates)
+		return;
+
+	rate = &frame->frame_rates[0];
+	min_rate = rate->min;
+	max_rate = rate->max;
+	if (!min_rate || !max_rate || max_rate < min_rate)
+		return;
+
+	/* The rate is den / num frames per second. */
+	if ((u64)*den < (u64)min_rate * *num) {
+		*num = 1;
+		*den = min_rate;
+	} else if ((u64)*den > (u64)max_rate * *num) {
+		*num = 1;
+		*den = max_rate;
+	}
+}
+
+static int virtio_video_enc_s_parm(struct file *file, void *fh,
+				   struct v4l2_streamparm *a)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	const struct v4l2_fract *fract;
+	struct video_stream_info info;
+	enum virtio_video_queue_type queue;
+	bool raw = a->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+	u32 num, den;
+	int ret;
+
+	if (!enc_parm_type_ok(a->type))
+		return -EINVAL;
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	fract = raw ? &a->parm.output.timeperframe :
+		      &a->parm.capture.timeperframe;
+	num = fract->numerator;
+	den = fract->denominator;
+	/* An empty request asks for the default, which is the current one. */
+	if (!num || !den) {
+		num = stream->coded_info.interval_numerator;
+		den = stream->coded_info.interval_denominator;
+	}
+	enc_clamp_interval(stream, &num, &den);
+
+	mutex_lock(&stream->vq_mutex);
+
+	/* The raw colorimetry rides along with the raw queue's interval. */
+	info = stream->raw_info;
+	info.interval_numerator = num;
+	info.interval_denominator = den;
+	queue = raw ? VIRTIO_VIDEO_QUEUE_TYPE_INPUT : VIRTIO_VIDEO_QUEUE_TYPE_OUTPUT;
+
+	ret = virtio_video_cmd_set_stream_info(vvd, stream, queue, &info);
+	if (!ret)
+		ret = enc_read_stream_info(stream, false);
+	if (!ret && raw) {
+		/* The device keeps one interval, the coded stream's. */
+		stream->raw_info.interval_numerator =
+			stream->coded_info.interval_numerator;
+		stream->raw_info.interval_denominator =
+			stream->coded_info.interval_denominator;
+	}
+
+	mutex_unlock(&stream->vq_mutex);
+	if (ret)
+		return ret;
+
+	enc_fill_parm(a, raw ? &stream->raw_info : &stream->coded_info);
+
+	return 0;
+}
+
+static bool enc_in_stepped_range(const struct virtio_video_format_range *range,
+				 u32 point)
+{
+	if (point < range->min || point > range->max)
+		return false;
+
+	return !range->step || (point - range->min) % range->step == 0;
+}
+
+static int virtio_video_enc_enum_frameintervals(struct file *file, void *fh,
+						struct v4l2_frmivalenum *f)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	const struct video_format_frame *frm = NULL;
+	const struct virtio_video_format_range *rate;
+	struct video_format *fmt;
+	unsigned int i;
+
+	fmt = enc_find_fmt(&vvd->input_fmt_list, f->pixel_format, NULL);
+	if (!fmt)
+		fmt = enc_find_fmt(&vvd->output_fmt_list, f->pixel_format,
+				   NULL);
+	if (!fmt)
+		return -EINVAL;
+
+	for (i = 0; i < fmt->desc.num_frames; i++) {
+		const struct virtio_video_format_frame *frame =
+			&fmt->frames[i].frame;
+
+		if (enc_in_stepped_range(&frame->width, f->width) &&
+		    enc_in_stepped_range(&frame->height, f->height)) {
+			frm = &fmt->frames[i];
+			break;
+		}
+	}
+	if (!frm || f->index >= frm->frame.num_rates)
+		return -EINVAL;
+
+	rate = &frm->frame_rates[f->index];
+	if (!rate->min || !rate->max)
+		return -EINVAL;
+
+	if (rate->min == rate->max) {
+		f->type = V4L2_FRMIVAL_TYPE_DISCRETE;
+		f->discrete.numerator = 1;
+		f->discrete.denominator = rate->max;
+		return 0;
+	}
+
+	/* The interval is the inverse of the rate, so the ends swap. */
+	f->stepwise.min.numerator = 1;
+	f->stepwise.min.denominator = rate->max;
+	f->stepwise.max.numerator = 1;
+	f->stepwise.max.denominator = rate->min;
+	if (rate->step <= 1) {
+		f->type = V4L2_FRMIVAL_TYPE_CONTINUOUS;
+		f->stepwise.step.numerator = 1;
+		f->stepwise.step.denominator = 1;
+	} else {
+		f->type = V4L2_FRMIVAL_TYPE_STEPWISE;
+		f->stepwise.step.numerator = 1;
+		f->stepwise.step.denominator = rate->step;
+	}
+
+	return 0;
+}
+
+/*
+ * Held raw frames
+ */
+
+/* Send the held frames in the order they were queued. Under hold_lock. */
+static void enc_send_held_locked(struct virtio_video_stream *stream)
+{
+	struct virtio_video_buffer *virtio_vb, *tmp;
+
+	list_for_each_entry_safe(virtio_vb, tmp, &stream->held, held_entry) {
+		list_del_init(&virtio_vb->held_entry);
+		virtio_video_buf_queue(&virtio_vb->v4l2_m2m_vb.vb.vb2_buf);
+	}
+}
+
+static void enc_flush_held(struct virtio_video_stream *stream,
+			   enum vb2_buffer_state state)
+{
+	struct virtio_video_buffer *virtio_vb, *tmp;
+	LIST_HEAD(flush);
+
+	mutex_lock(&stream->hold_lock);
+	list_splice_init(&stream->held, &flush);
+	mutex_unlock(&stream->hold_lock);
+
+	list_for_each_entry_safe(virtio_vb, tmp, &flush, held_entry) {
+		list_del_init(&virtio_vb->held_entry);
+		vb2_buffer_done(&virtio_vb->v4l2_m2m_vb.vb.vb2_buf, state);
+	}
+}
+
+/* The frames the device never saw go back with the others on an error. */
+void virtio_video_enc_return_held(struct virtio_video_stream *stream)
+{
+	enc_flush_held(stream, VB2_BUF_STATE_ERROR);
+}
+
+/*
+ * Queues
+ */
+
+static int enc_queue_setup(struct vb2_queue *vq, unsigned int *num_buffers,
+			   unsigned int *num_planes, unsigned int sizes[],
+			   struct device *alloc_devs[])
+{
+	struct virtio_video_stream *stream = vb2_get_drv_priv(vq);
+	const struct video_format_info *info;
+	unsigned int i;
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	/* A buffer a client describes must hold the format it will carry. */
+	if (*num_planes) {
+		info = V4L2_TYPE_IS_OUTPUT(vq->type) ? &stream->in_info :
+						       &stream->out_info;
+		if (*num_planes != info->num_planes)
+			return -EINVAL;
+		for (i = 0; i < info->num_planes; i++)
+			if (sizes[i] < info->plane_format[i].plane_size)
+				return -EINVAL;
+		return 0;
+	}
+
+	return virtio_video_queue_setup(vq, num_buffers, num_planes, sizes,
+					alloc_devs);
+}
+
+static int enc_buf_init(struct vb2_buffer *vb)
+{
+	INIT_LIST_HEAD(&to_virtio_vb(vb)->held_entry);
+
+	return virtio_video_buf_init(vb);
+}
+
+static void enc_buf_queue(struct vb2_buffer *vb)
+{
+	struct virtio_video_stream *stream = vb2_get_drv_priv(vb->vb2_queue);
+
+	/* A coded buffer is a place for the device to write to. */
+	if (!V4L2_TYPE_IS_OUTPUT(vb->vb2_queue->type)) {
+		virtio_video_buf_queue(vb);
+		return;
+	}
+
+	mutex_lock(&stream->hold_lock);
+	if (!stream->capture_started || stream->paused)
+		list_add_tail(&to_virtio_vb(vb)->held_entry, &stream->held);
+	else
+		virtio_video_buf_queue(vb);
+	mutex_unlock(&stream->hold_lock);
+}
+
+static int enc_start_streaming(struct vb2_queue *vq, unsigned int count)
+{
+	struct virtio_video_stream *stream = vb2_get_drv_priv(vq);
+	bool output = V4L2_TYPE_IS_OUTPUT(vq->type);
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR) {
+		/* Frames not yet sent go back to vb2 as they came. */
+		if (output)
+			enc_flush_held(stream, VB2_BUF_STATE_QUEUED);
+		return -EIO;
+	}
+
+	/*
+	 * Starting either queue leaves the stopped state, and the coded queue
+	 * starts a new sequence.
+	 */
+	mutex_lock(&stream->hold_lock);
+	if (!output)
+		stream->capture_started = true;
+	stream->paused = false;
+	if (stream->capture_started)
+		enc_send_held_locked(stream);
+	mutex_unlock(&stream->hold_lock);
+
+	if (!output) {
+		virtio_video_ctrls_grab(stream, true);
+		virtio_video_state_update(stream, STREAM_STATE_RUNNING);
+	}
+
+	return 0;
+}
+
+static void enc_stop_streaming(struct vb2_queue *vq)
+{
+	struct virtio_video_stream *stream = vb2_get_drv_priv(vq);
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	bool output = V4L2_TYPE_IS_OUTPUT(vq->type);
+	bool draining = output &&
+			virtio_video_state(stream) == STREAM_STATE_DRAIN;
+	int ret;
+
+	if (output) {
+		enc_flush_held(stream, VB2_BUF_STATE_ERROR);
+	} else {
+		mutex_lock(&stream->hold_lock);
+		stream->capture_started = false;
+		mutex_unlock(&stream->hold_lock);
+		virtio_video_ctrls_grab(stream, false);
+	}
+
+	ret = virtio_video_queue_release_buffers(stream,
+		output ? VIRTIO_VIDEO_QUEUE_TYPE_INPUT :
+			 VIRTIO_VIDEO_QUEUE_TYPE_OUTPUT);
+	vb2_wait_for_all_buffers(vq);
+
+	if (!output) {
+		/* A drain in progress ends with the coded queue. */
+		virtio_video_state_update(stream, STREAM_STATE_INIT);
+	} else if (draining && !ret) {
+		/*
+		 * Stopping the raw queue in a drain completes it at once: the
+		 * next coded buffer comes back empty and last. The device
+		 * dropped the drain with the raw queue, so ask for it again.
+		 */
+		if (virtio_video_cmd_stream_drain(vvd, stream->stream_id))
+			v4l2_err(&vvd->v4l2_dev, "failed to drain stream\n");
+	}
+}
+
+static const struct vb2_ops virtio_video_enc_qops = {
+	.queue_setup	 = enc_queue_setup,
+	.buf_init	 = enc_buf_init,
+	.buf_cleanup	 = virtio_video_buf_cleanup,
+	.buf_queue	 = enc_buf_queue,
+	.start_streaming = enc_start_streaming,
+	.stop_streaming  = enc_stop_streaming,
+	.wait_prepare	 = vb2_ops_wait_prepare,
+	.wait_finish	 = vb2_ops_wait_finish,
+};
+
+static int virtio_video_enc_init_queues(void *priv, struct vb2_queue *src_vq,
+					struct vb2_queue *dst_vq)
+{
+	int ret;
+	struct virtio_video_stream *stream = priv;
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct device *dev = vvd->v4l2_dev.dev;
+
+	/*
+	 * Raw frames: the device copies each one when it arrives, so the
+	 * queue starts streaming with no buffer queued.
+	 */
+	src_vq->type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+	src_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	src_vq->drv_priv = stream;
+	src_vq->buf_struct_size = sizeof(struct virtio_video_buffer);
+	src_vq->ops = &virtio_video_enc_qops;
+	src_vq->mem_ops = virtio_video_mem_ops(vvd);
+	src_vq->min_queued_buffers = 0;
+	src_vq->min_reqbufs_allocation = 2;
+	src_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	src_vq->lock = &stream->vq_mutex;
+	src_vq->gfp_flags = virtio_video_gfp_flags(vvd);
+	src_vq->dev = dev;
+
+	ret = vb2_queue_init(src_vq);
+	if (ret)
+		return ret;
+
+	/* Coded buffers are guest memory the device writes into. */
+	dst_vq->type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	dst_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	dst_vq->drv_priv = stream;
+	dst_vq->buf_struct_size = sizeof(struct virtio_video_buffer);
+	dst_vq->ops = &virtio_video_enc_qops;
+	dst_vq->mem_ops = virtio_video_mem_ops(vvd);
+	dst_vq->min_queued_buffers = 0;
+	dst_vq->min_reqbufs_allocation = 2;
+	dst_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	dst_vq->lock = &stream->vq_mutex;
+	dst_vq->gfp_flags = virtio_video_gfp_flags(vvd);
+	dst_vq->dev = dev;
+
+	return vb2_queue_init(dst_vq);
+}
+
+/*
+ * Stream setup
+ */
+
+static int virtio_video_enc_init_ctrls(struct virtio_video_stream *stream)
+{
+	int ret;
+
+	ret = virtio_video_ctrls_init(stream);
+	if (ret)
+		return ret;
+
+	virtio_video_ctrls_set_coded_format(stream,
+		virtio_video_v4l2_format_to_virtio(stream->out_info.fourcc_format));
+
+	return 0;
+}
+
+static int virtio_video_enc_init_stream(struct virtio_video_stream *stream)
+{
+	struct virtio_video_device *vvd = to_virtio_vd(stream->video_dev);
+	struct video_format_info *raw = &stream->in_info;
+	const struct v4l2_format_info *layout;
+	int ret;
+
+	mutex_init(&stream->hold_lock);
+	INIT_LIST_HEAD(&stream->held);
+
+	ret = enc_read_stream_info(stream, true);
+	if (ret) {
+		v4l2_err(&vvd->v4l2_dev, "failed to get stream info\n");
+		return ret;
+	}
+	stream->raw_info.interval_numerator =
+		stream->coded_info.interval_numerator;
+	stream->raw_info.interval_denominator =
+		stream->coded_info.interval_denominator;
+
+	/*
+	 * The V4L2 name of the raw format has to mean the layout the device
+	 * holds, and a format V4L2 only knows as one buffer cannot be the
+	 * device's one buffer per plane.
+	 */
+	layout = v4l2_format_info(raw->fourcc_format);
+	if (layout && layout->mem_planes != raw->num_planes) {
+		struct v4l2_pix_format_mplane pix_mp = {};
+		struct video_format_info info = *raw;
+
+		ret = v4l2_fill_pixfmt_mp(&pix_mp, raw->fourcc_format,
+					  raw->frame_width, raw->frame_height);
+		if (ret)
+			return ret;
+		enc_info_from_pix(&info, &pix_mp);
+		ret = virtio_video_cmd_set_params(vvd, stream, &info,
+						  VIRTIO_VIDEO_QUEUE_TYPE_INPUT);
+		if (ret)
+			return ret;
+		return enc_get_params(stream);
+	}
+
+	stream->coded_size_dev = stream->out_info.plane_format[0].plane_size;
+
+	return 0;
+}
+
+/*
+ * Encoder commands
+ */
+
+static int virtio_video_enc_try_encoder_cmd(struct file *file, void *fh,
+					    struct v4l2_encoder_cmd *cmd)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+	struct virtio_video_device *vvd = video_drvdata(file);
+
+	if (virtio_video_state(stream) == STREAM_STATE_ERROR)
+		return -EIO;
+
+	if (virtio_video_state(stream) == STREAM_STATE_DRAIN)
+		return -EBUSY;
+
+	switch (cmd->cmd) {
+	case V4L2_ENC_CMD_STOP:
+	case V4L2_ENC_CMD_START:
+		if (cmd->flags != 0) {
+			v4l2_err(&vvd->v4l2_dev, "flags=%u are not supported",
+				 cmd->flags);
+			return -EINVAL;
+		}
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int virtio_video_enc_encoder_cmd(struct file *file, void *fh,
+					struct v4l2_encoder_cmd *cmd)
+{
+	struct virtio_video_stream *stream = file2stream(file);
+	struct virtio_video_device *vvd = video_drvdata(file);
+	struct vb2_queue *src_vq, *dst_vq;
+	int ret;
+
+	ret = virtio_video_enc_try_encoder_cmd(file, fh, cmd);
+	if (ret < 0)
+		return ret;
+
+	src_vq = v4l2_m2m_get_vq(stream->fh.m2m_ctx,
+				 V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+	dst_vq = v4l2_m2m_get_vq(stream->fh.m2m_ctx,
+				 V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+
+	/* Frame queueing and streaming run under this lock. */
+	mutex_lock(&stream->vq_mutex);
+
+	switch (cmd->cmd) {
+	case V4L2_ENC_CMD_START:
+		vb2_clear_last_buffer_dequeued(dst_vq);
+
+		mutex_lock(&stream->hold_lock);
+		stream->paused = false;
+		if (stream->capture_started)
+			enc_send_held_locked(stream);
+		mutex_unlock(&stream->hold_lock);
+
+		if (virtio_video_state(stream) == STREAM_STATE_STOPPED)
+			virtio_video_state_update(stream, STREAM_STATE_RUNNING);
+		break;
+	case V4L2_ENC_CMD_STOP:
+		if (!vb2_is_streaming(src_vq)) {
+			v4l2_dbg(1, vvd->debug, &vvd->v4l2_dev,
+				 "output is not streaming\n");
+			break;
+		}
+
+		if (!vb2_is_streaming(dst_vq)) {
+			v4l2_dbg(1, vvd->debug, &vvd->v4l2_dev,
+				 "capture is not streaming\n");
+			break;
+		}
+
+		/*
+		 * Every frame queued before this command has reached the
+		 * device; the ones queued from now on wait for the stream to
+		 * start again.
+		 */
+		mutex_lock(&stream->hold_lock);
+		stream->paused = true;
+		mutex_unlock(&stream->hold_lock);
+
+		ret = virtio_video_cmd_stream_drain(vvd, stream->stream_id);
+		if (ret) {
+			v4l2_err(&vvd->v4l2_dev, "failed to drain stream\n");
+			mutex_lock(&stream->hold_lock);
+			stream->paused = false;
+			mutex_unlock(&stream->hold_lock);
+			break;
+		}
+
+		virtio_video_state_update(stream, STREAM_STATE_DRAIN);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	mutex_unlock(&stream->vq_mutex);
+
+	return ret;
+}
+
+static int virtio_video_enc_subscribe_event(struct v4l2_fh *fh,
+					    const struct v4l2_event_subscription *sub)
+{
+	switch (sub->type) {
+	case V4L2_EVENT_EOS:
+		return v4l2_event_subscribe(fh, sub, 2, NULL);
+	default:
+		return v4l2_ctrl_subscribe_event(fh, sub);
+	}
+}
+
+static const struct v4l2_ioctl_ops virtio_video_enc_ioctl_ops = {
+	.vidioc_querycap	= virtio_video_querycap,
+
+	.vidioc_enum_fmt_vid_cap	= virtio_video_enc_enum_fmt_vid_cap,
+	.vidioc_enum_fmt_vid_out	= virtio_video_enc_enum_fmt_vid_out,
+	.vidioc_g_fmt_vid_cap_mplane	= virtio_video_enc_g_fmt,
+	.vidioc_s_fmt_vid_cap_mplane	= virtio_video_enc_s_fmt,
+	.vidioc_try_fmt_vid_cap_mplane	= virtio_video_enc_try_fmt,
+
+	.vidioc_g_fmt_vid_out_mplane	= virtio_video_enc_g_fmt,
+	.vidioc_s_fmt_vid_out_mplane	= virtio_video_enc_s_fmt,
+	.vidioc_try_fmt_vid_out_mplane	= virtio_video_enc_try_fmt,
+
+	.vidioc_g_selection	= virtio_video_enc_g_selection,
+	.vidioc_s_selection	= virtio_video_enc_s_selection,
+
+	.vidioc_g_parm		= virtio_video_enc_g_parm,
+	.vidioc_s_parm		= virtio_video_enc_s_parm,
+
+	.vidioc_try_encoder_cmd	= virtio_video_enc_try_encoder_cmd,
+	.vidioc_encoder_cmd	= virtio_video_enc_encoder_cmd,
+	.vidioc_enum_frameintervals = virtio_video_enc_enum_frameintervals,
+	.vidioc_enum_framesizes = virtio_video_enum_framesizes,
+
+	.vidioc_reqbufs		= virtio_video_reqbufs,
+	.vidioc_querybuf	= v4l2_m2m_ioctl_querybuf,
+	.vidioc_qbuf		= virtio_video_qbuf,
+	.vidioc_dqbuf		= virtio_video_dqbuf,
+	.vidioc_prepare_buf	= v4l2_m2m_ioctl_prepare_buf,
+	.vidioc_create_bufs	= v4l2_m2m_ioctl_create_bufs,
+	.vidioc_expbuf		= v4l2_m2m_ioctl_expbuf,
+
+	.vidioc_streamon	= v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff	= v4l2_m2m_ioctl_streamoff,
+
+	.vidioc_subscribe_event	= virtio_video_enc_subscribe_event,
+	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
+};
+
+/* The coded formats, the first of which a new stream is created with. */
+static void *virtio_video_enc_get_fmt_list(struct virtio_video_device *vvd)
+{
+	return &vvd->output_fmt_list;
+}
+
+static struct virtio_video_device_ops virtio_video_enc_ops = {
+	.init_ctrls = virtio_video_enc_init_ctrls,
+	.init_queues = virtio_video_enc_init_queues,
+	.get_fmt_list = virtio_video_enc_get_fmt_list,
+	.init_stream = virtio_video_enc_init_stream,
+};
+
+int virtio_video_enc_init(struct virtio_video_device *vvd)
+{
+	ssize_t num;
+	struct video_device *vd = &vvd->video_dev;
+
+	vd->ioctl_ops = &virtio_video_enc_ioctl_ops;
+	vvd->ops = &virtio_video_enc_ops;
+
+	num = strscpy(vd->name, "stateful-encoder", sizeof(vd->name));
+	if (num < 0)
+		return num;
+
+	return 0;
+}
