From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 15 Sep 2026 13:27:07 +0900
Subject: [PATCH] deliver data-alignment faults to guest signal handlers

---
 arch/um/os-Darwin/skas/process.c            | 28 ++++++++++++++++++---
 arch/um/os-Darwin/uml_darwin_abi.h          |  6 +++--
 arch/um/os-Darwin/uml_darwin_abi_identity.h |  4 +--
 3 files changed, 30 insertions(+), 8 deletions(-)

diff --git a/arch/um/os-Darwin/skas/process.c b/arch/um/os-Darwin/skas/process.c
index 6afff7419224aeea55b36a62d15803f1099959fc..d0b15a1c077737bfc9c88b7bbadd8fe7132f07b1 100644
--- a/arch/um/os-Darwin/skas/process.c
+++ b/arch/um/os-Darwin/skas/process.c
@@ -23,8 +23,8 @@
  * These checks make an ABI drift fail at the kernel compiler rather than at a
  * guest boundary after register state has been reinterpreted. */
 _Static_assert(sizeof(unsigned long) == 8, "Darwin UML ABI requires LP64");
-_Static_assert(DARWIN_UML_ABI_VERSION == 9U, "unexpected ABI version");
-_Static_assert(DARWIN_UML_ABI_FINGERPRINT == 0xd17ab76bfc9adf0cULL,
+_Static_assert(DARWIN_UML_ABI_VERSION == 10U, "unexpected ABI version");
+_Static_assert(DARWIN_UML_ABI_FINGERPRINT == 0x81bfcab1377c7e09ULL,
 	       "unexpected ABI fingerprint");
 _Static_assert(offsetof(struct uml_pt_regs, orig_x0) ==
 	      DARWIN_UML_ABI_GUEST_REGISTERS_ORIGINAL_X0_OFFSET,
@@ -54,6 +54,8 @@ _Static_assert(UML_ARM64_FAULT_PAGE == DARWIN_UML_FAULT_PAGE,
 	       "fault page trap drift");
 
 #define DARWIN_CLONE_VM 0x00000100UL
+/* relay_signal consumes Linux signal numbers, not Darwin SIGBUS (10). */
+#define DARWIN_GUEST_SIGBUS 7
 /* Linux asm-generic/siginfo.h ABI value.  This host-side file includes
  * Darwin's signal.h, where the guest-only SEGV_CPERR name is unavailable. */
 #define DARWIN_GUEST_SEGV_CPERR 10
@@ -553,6 +555,24 @@ void userspace(struct uml_pt_regs *registers)
 			registers->is_user = 0;
 			break;
 		}
+		case DARWIN_UML_EVENT_DATA_ALIGNMENT:
+		{
+			siginfo_t signal_info = { 0 };
+
+			/* An alignment exception cannot be repaired by mapping a page.
+			 * Preserve the faulting PC and effective data address so a guest
+			 * handler can repair or emulate the access before sigreturn. */
+			signal_info.si_signo = DARWIN_GUEST_SIGBUS;
+			signal_info.si_code = BUS_ADRALN;
+			signal_info.si_addr = (void *)FAULT_ADDRESS(registers->faultinfo);
+			registers->is_user = 1;
+			block_signals_trace();
+			relay_signal(DARWIN_GUEST_SIGBUS, (struct siginfo *)&signal_info,
+				     registers, NULL);
+			unblock_signals_trace();
+			registers->is_user = 0;
+			break;
+		}
 		case DARWIN_UML_EVENT_PC_ALIGNMENT:
 		{
 			siginfo_t signal_info = { 0 };
@@ -564,13 +584,13 @@ void userspace(struct uml_pt_regs *registers)
 			registers->faultinfo.error_code = 0;
 			registers->faultinfo.cr2 = UPT_IP(registers);
 			registers->faultinfo.trap_no = 0;
-			signal_info.si_signo = SIGBUS;
+			signal_info.si_signo = DARWIN_GUEST_SIGBUS;
 			signal_info.si_errno = 0;
 			signal_info.si_code = BUS_ADRALN;
 			signal_info.si_addr = (void *)UPT_IP(registers);
 			registers->is_user = 1;
 			block_signals_trace();
-			relay_signal(SIGBUS, (struct siginfo *)&signal_info,
+			relay_signal(DARWIN_GUEST_SIGBUS, (struct siginfo *)&signal_info,
 				     registers, NULL);
 			unblock_signals_trace();
 			registers->is_user = 0;
diff --git a/arch/um/os-Darwin/uml_darwin_abi.h b/arch/um/os-Darwin/uml_darwin_abi.h
index 2c0d02d2ec7a5020d9df1e3c551c2a7cb4c56ca6..c3994581ffe8e5838e4f4fc5611a0159fbdfdf8b 100644
--- a/arch/um/os-Darwin/uml_darwin_abi.h
+++ b/arch/um/os-Darwin/uml_darwin_abi.h
@@ -46,6 +46,7 @@ enum darwin_uml_guest_event {
 	DARWIN_UML_EVENT_FLOATING_POINT_TRAP = 7,
 	DARWIN_UML_EVENT_PC_ALIGNMENT = 8,
 	DARWIN_UML_EVENT_STOP = 9,
+	DARWIN_UML_EVENT_DATA_ALIGNMENT = 10,
 	DARWIN_UML_EVENT_FATAL = -1,
 };
 
@@ -120,11 +121,12 @@ struct darwin_uml_guest_fp_registers {
 
 #if defined(__cplusplus)
 #include <stddef.h>
-static_assert(DARWIN_UML_ABI_VERSION == 9U);
-static_assert(DARWIN_UML_ABI_FINGERPRINT == 0xd17ab76bfc9adf0cULL);
+static_assert(DARWIN_UML_ABI_VERSION == 10U);
+static_assert(DARWIN_UML_ABI_FINGERPRINT == 0x81bfcab1377c7e09ULL);
 static_assert(DARWIN_UML_EVENT_FLOATING_POINT_TRAP == 7);
 static_assert(DARWIN_UML_EVENT_PC_ALIGNMENT == 8);
 static_assert(DARWIN_UML_EVENT_STOP == 9);
+static_assert(DARWIN_UML_EVENT_DATA_ALIGNMENT == 10);
 static_assert(DARWIN_UML_FLOATING_POINT_SYNDROME_BASE == 0xb2800000U);
 static_assert(DARWIN_UML_GUEST_PAGE_SIZE ==
 		(1ULL << DARWIN_UML_GUEST_PAGE_SHIFT));
diff --git a/arch/um/os-Darwin/uml_darwin_abi_identity.h b/arch/um/os-Darwin/uml_darwin_abi_identity.h
index bbcdba4a468fa0749fabc6f8b183a89c5d75780c..3aafae44c9a8a2ab42d29df06400d2f6e4fb715c 100644
--- a/arch/um/os-Darwin/uml_darwin_abi_identity.h
+++ b/arch/um/os-Darwin/uml_darwin_abi_identity.h
@@ -3,7 +3,7 @@
 #ifndef UML_DARWIN_ABI_IDENTITY_H
 #define UML_DARWIN_ABI_IDENTITY_H
 
-#define DARWIN_UML_ABI_VERSION 9U
-#define DARWIN_UML_ABI_FINGERPRINT 0xd17ab76bfc9adf0cULL
+#define DARWIN_UML_ABI_VERSION 10U
+#define DARWIN_UML_ABI_FINGERPRINT 0x81bfcab1377c7e09ULL
 
 #endif
