From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:50:23 +0900
Subject: [PATCH] virt_wifi: pass the multicast groups on to the lower device

A virt_wifi interface receives through its lower device, whose rx handler
hands every frame the lower device accepted to it. Android puts the
interface on a macvlan, and a macvlan delivers a multicast frame only if
its own filter lists the group. virt_wifi had no ndo_set_rx_mode, so
nothing the interface joined reached that filter: the macvlan saw only
the groups it joined itself (all nodes), and a frame for any other group
was dropped before wlan0 could receive it. An IPv6 neighbour
solicitation for wlan0's address goes to its solicited-node group, so a
router that resolves wlan0's global address that way would never get an
answer.

Synchronize the interface's unicast and multicast lists with the lower
device, pass IFF_ALLMULTI and IFF_PROMISC on, as VLAN and macvlan do, and
take them back when the interface stops. Nothing changes for an interface
that joins no group.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/net/wireless/virtual/virt_wifi.c | 54 ++++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/drivers/net/wireless/virtual/virt_wifi.c b/drivers/net/wireless/virtual/virt_wifi.c
index d5497a551659a4f4dd4e4631115d577682d048c2..ff578d507527ef778a63d476593cdb1d16a1994f 100644
--- a/drivers/net/wireless/virtual/virt_wifi.c
+++ b/drivers/net/wireless/virtual/virt_wifi.c
@@ -738,9 +738,27 @@ static netdev_tx_t virt_wifi_start_xmit(struct sk_buff *skb,
 static int virt_wifi_net_device_open(struct net_device *dev)
 {
 	struct virt_wifi_netdev_priv *priv = netdev_priv(dev);
+	int err;
+
+	/* The stack passes a change of these flags on only while we are up. */
+	if (dev->flags & IFF_ALLMULTI) {
+		err = dev_set_allmulti(priv->lowerdev, 1);
+		if (err < 0)
+			return err;
+	}
+	if (dev->flags & IFF_PROMISC) {
+		err = dev_set_promiscuity(priv->lowerdev, 1);
+		if (err < 0)
+			goto clear_allmulti;
+	}
 
 	priv->is_up = true;
 	return 0;
+
+clear_allmulti:
+	if (dev->flags & IFF_ALLMULTI)
+		dev_set_allmulti(priv->lowerdev, -1);
+	return err;
 }
 
 /* Called with rtnl lock held. */
@@ -750,6 +768,14 @@ static int virt_wifi_net_device_stop(struct net_device *dev)
 
 	n_priv->is_up = false;
 
+	/* Leave the lower device's filters as they were before we opened. */
+	dev_uc_unsync(n_priv->lowerdev, dev);
+	dev_mc_unsync(n_priv->lowerdev, dev);
+	if (dev->flags & IFF_ALLMULTI)
+		dev_set_allmulti(n_priv->lowerdev, -1);
+	if (dev->flags & IFF_PROMISC)
+		dev_set_promiscuity(n_priv->lowerdev, -1);
+
 	if (!dev->ieee80211_ptr)
 		return 0;
 
@@ -768,11 +794,39 @@ static int virt_wifi_net_device_get_iflink(const struct net_device *dev)
 	return READ_ONCE(priv->lowerdev->ifindex);
 }
 
+/*
+ * The lower device receives for this one, and a macvlan delivers a multicast
+ * frame only to the groups its own filter lists, so the groups and addresses
+ * this interface listens for have to reach it. Called with the address list
+ * lock held.
+ */
+static void virt_wifi_set_rx_mode(struct net_device *dev)
+{
+	struct virt_wifi_netdev_priv *priv = netdev_priv(dev);
+
+	dev_uc_sync(priv->lowerdev, dev);
+	dev_mc_sync(priv->lowerdev, dev);
+}
+
+static void virt_wifi_change_rx_flags(struct net_device *dev, int change)
+{
+	struct virt_wifi_netdev_priv *priv = netdev_priv(dev);
+
+	if (change & IFF_ALLMULTI)
+		dev_set_allmulti(priv->lowerdev,
+				 dev->flags & IFF_ALLMULTI ? 1 : -1);
+	if (change & IFF_PROMISC)
+		dev_set_promiscuity(priv->lowerdev,
+				    dev->flags & IFF_PROMISC ? 1 : -1);
+}
+
 static const struct net_device_ops virt_wifi_ops = {
 	.ndo_start_xmit = virt_wifi_start_xmit,
 	.ndo_open	= virt_wifi_net_device_open,
 	.ndo_stop	= virt_wifi_net_device_stop,
 	.ndo_get_iflink = virt_wifi_net_device_get_iflink,
+	.ndo_set_rx_mode = virt_wifi_set_rx_mode,
+	.ndo_change_rx_flags = virt_wifi_change_rx_flags,
 };
 
 /* Invoked as part of rtnl lock release. */
