From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 3 Aug 2026 17:24:12 +0900
Subject: [PATCH] mm: handle zero-length cachestat ranges

Apply the reviewed final-state topic without intermediate churn.
---
 mm/filemap.c | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/mm/filemap.c b/mm/filemap.c
index 1a035881060906d46ff279e8c55944d97742aa64..1c47783bda99b2d6cad06a78e291f70ffa3f799b 100644
--- a/mm/filemap.c
+++ b/mm/filemap.c
@@ -4692,13 +4692,24 @@ SYSCALL_DEFINE4(cachestat, unsigned int, fd,
 	if (flags != 0)
 		return -EINVAL;
 
-	first_index = csr.off >> PAGE_SHIFT;
-	last_index =
-		csr.len == 0 ? ULONG_MAX : (csr.off + csr.len - 1) >> PAGE_SHIFT;
 	memset(&cs, 0, sizeof(struct cachestat));
+	first_index = csr.off >> PAGE_SHIFT;
+	if (csr.len == 0) {
+		loff_t size = i_size_read(file_inode(fd_file(f)));
+
+		/* A zero length means from csr.off to the current end of file. */
+		if (csr.off >= size)
+			goto copy_stat;
+
+		last_index = (size - 1) >> PAGE_SHIFT;
+	} else {
+		last_index = (csr.off + csr.len - 1) >> PAGE_SHIFT;
+	}
+
 	mapping = fd_file(f)->f_mapping;
 	filemap_cachestat(mapping, first_index, last_index, &cs);
 
+copy_stat:
 	if (copy_to_user(cstat, &cs, sizeof(struct cachestat)))
 		return -EFAULT;
 
