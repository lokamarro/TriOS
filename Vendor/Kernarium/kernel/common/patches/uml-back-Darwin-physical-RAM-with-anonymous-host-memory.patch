From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 27 Aug 2026 08:24:30 +0900
Subject: [PATCH] uml: back Darwin physical RAM with anonymous host memory

Open the physical-memory backing through the Darwin bridge's anonymous
shared-memory path instead of creating and unlinking a temporary file.
---
 arch/um/os-Darwin/mem.c | 31 +++++++------------------------
 1 file changed, 7 insertions(+), 24 deletions(-)

diff --git a/arch/um/os-Darwin/mem.c b/arch/um/os-Darwin/mem.c
index 968c0de1b7ac9079e5379fd796fb81cf360a226a..182e71b7517618d359bdb9a25526d18c5dc7951c 100644
--- a/arch/um/os-Darwin/mem.c
+++ b/arch/um/os-Darwin/mem.c
@@ -2,36 +2,19 @@
 
 #include <errno.h>
 #include <fcntl.h>
-#include <stdlib.h>
-#include <string.h>
 #include <unistd.h>
 #include <os.h>
+#include "bridge.h"
+
+#define UML_ANONYMOUS_PHYSICAL_MEMORY_PATH "uml:anonymous-physical-memory"
 
 int create_mem_file(unsigned long long length)
 {
-	const char *tmpdir = getenv("TMPDIR");
-	char *name;
-	size_t length_needed;
-	int fd;
-
-	if (tmpdir == NULL || tmpdir[0] == '\0')
-		tmpdir = "/tmp";
-	length_needed = strlen(tmpdir) + sizeof("/uml-phys-XXXXXX");
-	name = malloc(length_needed);
-	if (name == NULL)
-		return -ENOMEM;
+	int fd = darwin_uml_open(UML_ANONYMOUS_PHYSICAL_MEMORY_PATH,
+				 O_RDWR, 0600);
 
-	memcpy(name, tmpdir, strlen(tmpdir));
-	memcpy(name + strlen(tmpdir), "/uml-phys-XXXXXX",
-	       sizeof("/uml-phys-XXXXXX"));
-	fd = mkstemp(name);
-	if (fd < 0) {
-		fd = -errno;
-		free(name);
-		return fd;
-	}
-	unlink(name);
-	free(name);
+	if (fd < 0)
+		return -errno;
 	if (ftruncate(fd, (off_t)length) < 0) {
 		int error = -errno;
 		close(fd);
