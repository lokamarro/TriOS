From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Wed, 7 Oct 2026 14:11:23 +0900
Subject: [PATCH] uml: hand x86 tasks' LDT and TLS to the Darwin host (bridge
 ABI 20)

Bridge ABI 20 widens two promises for a kernel of the x86-64 userspace
slice, without changing any declaration's form:

- fp of a task's guest registers holds the address of its mm's LDT,
  8192 descriptors in x86 format with zero where no entry is
  installed, or 0 when the mm has none. The kernel changes a
  descriptor only with one aligned 8-byte store and frees the table
  only with the mm, so the host may read it while the task runs.
- compat_tls carries the i386 TLS descriptors of a task of either
  ABI: a 64-bit task installs them with INT 0x80 set_thread_area, as
  Wine's WoW64 does for its 32-bit TEB selector.

The arm64 kernels set neither, and the arm64 host reads neither.
---
 arch/um/os-Darwin/uml_darwin_abi.h          | 10 ++++++++--
 arch/um/os-Darwin/uml_darwin_abi_identity.h |  2 +-
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/arch/um/os-Darwin/uml_darwin_abi.h b/arch/um/os-Darwin/uml_darwin_abi.h
index b2404aba46536a37f38fa9626b3ebce398da7a93..d67f5521509afaf512a0a114ba01e6ffa90a484a 100644
--- a/arch/um/os-Darwin/uml_darwin_abi.h
+++ b/arch/um/os-Darwin/uml_darwin_abi.h
@@ -109,6 +109,11 @@ struct darwin_uml_faultinfo {
 /* Prefix passed unchanged between a UML task and the native host runtime. */
 struct darwin_uml_guest_registers {
 	darwin_uml_abi_u64 x[29];
+	/* For a task of an x86-64 userspace kernel, the address of its mm's
+	 * LDT, or 0 when the mm has none: 8192 descriptors in x86 format,
+	 * zero where no entry is installed. The kernel changes a descriptor
+	 * only with one aligned 8-byte store and frees the table only with
+	 * the mm. A host may rely on this from bridge ABI 20. */
 	darwin_uml_abi_u64 fp;
 	darwin_uml_abi_u64 lr;
 	darwin_uml_abi_u64 sp;
@@ -124,8 +129,9 @@ struct darwin_uml_guest_registers {
 	/* An arm64 task's PSTATE.SM in bit 0 and PSTATE.ZA in bit 1; the other
 	 * bits stay zero. */
 	darwin_uml_abi_u64 svcr;
-	/* The i386 TLS descriptors of an x86_64-userspace kernel's compat
-	 * task, one struct user_desc each; zero for every other task. */
+	/* The i386 TLS descriptors of a task of an x86_64-userspace kernel,
+	 * whichever ABI installed them, one struct user_desc each; zero for
+	 * every other task. */
 	darwin_uml_abi_u64 compat_tls[DARWIN_UML_COMPAT_TLS_COUNT][2];
 };
 
diff --git a/arch/um/os-Darwin/uml_darwin_abi_identity.h b/arch/um/os-Darwin/uml_darwin_abi_identity.h
index da7d5a81db003f8572aafbaccc580c29f24ce2a8..13776d9b286b5d4d36f642134a1eb65ba758622b 100644
--- a/arch/um/os-Darwin/uml_darwin_abi_identity.h
+++ b/arch/um/os-Darwin/uml_darwin_abi_identity.h
@@ -3,7 +3,7 @@
 #ifndef UML_DARWIN_ABI_IDENTITY_H
 #define UML_DARWIN_ABI_IDENTITY_H
 
-#define DARWIN_UML_ABI_VERSION 19U
+#define DARWIN_UML_ABI_VERSION 20U
 #define DARWIN_UML_ABI_FINGERPRINT 0x75b16149a5953494ULL
 
 #endif
