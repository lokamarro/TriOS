From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Thu, 20 Aug 2026 15:04:02 +0000
Subject: [PATCH] um: target arm64 Rust kernel code

---
 arch/um/Makefile | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/um/Makefile b/arch/um/Makefile
index 93abe7c0c9d22fe412d24d8bfa2856e15d6aa594..f52bebee8c4bd12f2a52dca08a5f51dbe7bb6808 100644
--- a/arch/um/Makefile
+++ b/arch/um/Makefile
@@ -65,6 +65,9 @@ KBUILD_CFLAGS += $(CFLAGS) $(CFLAGS-y) -D__arch_um__ \
 	-D__close_range=kernel__close_range
 
 KBUILD_RUSTFLAGS += -Crelocation-model=pie
+ifeq ($(HEADER_ARCH),arm64)
+KBUILD_RUSTFLAGS += --target=aarch64-unknown-none-softfloat -Zfixed-x18
+endif
 
 KBUILD_AFLAGS += $(ARCH_INCLUDE)
 
