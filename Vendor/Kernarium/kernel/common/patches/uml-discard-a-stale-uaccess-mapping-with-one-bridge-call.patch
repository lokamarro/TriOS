From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 29 Sep 2026 13:15:35 +0900
Subject: [PATCH] uml: discard a stale uaccess mapping with one bridge call

Bridge ABI 14 gives the uaccess stale-mapping repair a single entry
point. Every uaccess page asked darwin_uml_vm_mapping_matches() and,
for an absent or mismatched mapping, called darwin_uml_vm_rebind(),
which despite its name only discarded a mapping that names other
backing. darwin_uml_vm_discard_if_stale() does the whole repair in one
call: it discards such a mapping and leaves an absent or equal one as
it is.

The rebind also published the page's 4 KiB native shadows first, a step
from when it installed the pinned page. The uaccess never reads or
writes those shadows: it reaches the page through the kernel's own
alias, which it refreshes before the copy and writes back after it, and
the walker that installs the page later publishes it as every software
map does. The single call publishes nothing.

The generated identity header now names kernel/common/abi/identity.env,
where the identity has lived since the ABI directory moved, and the
bridge header names the sync.sh that copies it.
---
 arch/um/include/shared/os.h                 |  6 ++----
 arch/um/kernel/skas/uaccess.c               | 20 +++++++-------------
 arch/um/os-Darwin/uml_darwin_abi.h          |  8 ++++----
 arch/um/os-Darwin/uml_darwin_abi_identity.h |  6 +++---
 arch/um/os-Darwin/uml_darwin_memory.h       | 10 ++++++----
 5 files changed, 22 insertions(+), 28 deletions(-)

diff --git a/arch/um/include/shared/os.h b/arch/um/include/shared/os.h
index 2b1a007cd64b3197b25b8d994240e0bc28379237..7d8ca4414554983e5ebeb6ad61d6e3dfad8dfd10 100644
--- a/arch/um/include/shared/os.h
+++ b/arch/um/include/shared/os.h
@@ -297,10 +297,8 @@ extern int darwin_uml_vm_sync_from_backing(unsigned long address);
 extern int darwin_uml_vm_sync_from_buffer(unsigned long address,
 					  const void *buffer,
 					  unsigned long length);
-extern int darwin_uml_vm_mapping_matches(unsigned long address, int fd,
-					 unsigned long long offset);
-extern int darwin_uml_vm_rebind(unsigned long address, int fd,
-					unsigned long long offset);
+extern int darwin_uml_vm_discard_if_stale(unsigned long address, int fd,
+					  unsigned long long offset);
 #endif
 extern int raw(int fd);
 extern void setup_machinename(char *machine_out);
diff --git a/arch/um/kernel/skas/uaccess.c b/arch/um/kernel/skas/uaccess.c
index f52741ef46b8a45b2367f44e536fafbb036a8909..7915c1b421f91df67001dbcf97de9b87d2e06e47 100644
--- a/arch/um/kernel/skas/uaccess.c
+++ b/arch/um/kernel/skas/uaccess.c
@@ -269,26 +269,20 @@ static struct page *maybe_map(unsigned long virt, int is_write)
 		unsigned long long offset;
 		unsigned long phys = page_to_phys(page);
 		int fd = phys_mapping(phys, &offset);
-		int mapping_state;
 
 		if (fd < 0 || darwin_uml_vm_activate(generation) < 0)
 			goto fail;
 		/* The software MMU can still map virt to a page this PTE no
 		 * longer names, for example after a sibling's copy-on-write.
-		 * matches() reports 1 for an equal mapping, 0 for one that
-		 * names other backing, and -1 for none.  Despite its bridge
-		 * name, darwin_uml_vm_rebind() never installs the pinned
-		 * page, because either side may be the stale one: it discards
-		 * a mapping that names other backing and leaves an absent one
-		 * absent.  This access goes through the kernel's alias of the
-		 * page; the guest's next access to virt then faults, and a
+		 * Either side may be the stale one, so the pinned page is
+		 * never installed: the host discards a mapping that names
+		 * other backing and leaves an absent or equal one as it is.
+		 * This access goes through the kernel's alias of the page;
+		 * the guest's next access to a discarded virt faults, and a
 		 * walker replays the current PTE.
 		 */
-		else if ((mapping_state = darwin_uml_vm_mapping_matches(
-				  virt, fd, offset)) <= 0) {
-			if (darwin_uml_vm_rebind(virt, fd, offset) < 0)
-				goto fail;
-		}
+		if (darwin_uml_vm_discard_if_stale(virt, fd, offset) < 0)
+			goto fail;
 	}
 #endif
 
diff --git a/arch/um/os-Darwin/uml_darwin_abi.h b/arch/um/os-Darwin/uml_darwin_abi.h
index ab48ecac887eca776291a8f864ef6c1ff9c823db..f6e861ad286af192f6f360a13dc97122c934a980 100644
--- a/arch/um/os-Darwin/uml_darwin_abi.h
+++ b/arch/um/os-Darwin/uml_darwin_abi.h
@@ -2,10 +2,10 @@
 /*
  * Canonical Darwin UML host/kernel data ABI.
  *
- * This file is copied verbatim to the host and replayed Linux source by
- * kernel/abi/sync.sh.  Change it rather than either generated destination;
- * bump both ABI_VERSION and ABI_FINGERPRINT whenever a binary boundary, enum,
- * or layout changes.
+ * kernel/common/abi/sync.sh copies this file verbatim to the host and to a
+ * replayed Linux source.  Change it rather than either copy, and advance
+ * kernel/common/abi/identity.env whenever a binary boundary, enum, or layout
+ * changes.
  */
 #ifndef UML_DARWIN_ABI_H
 #define UML_DARWIN_ABI_H
diff --git a/arch/um/os-Darwin/uml_darwin_abi_identity.h b/arch/um/os-Darwin/uml_darwin_abi_identity.h
index 7623c5473a06d2deca72a79040f513f9a46b54b4..d15a17bed197fbdf354ca06108e425d5dd9c0911 100644
--- a/arch/um/os-Darwin/uml_darwin_abi_identity.h
+++ b/arch/um/os-Darwin/uml_darwin_abi_identity.h
@@ -1,9 +1,9 @@
 /* SPDX-License-Identifier: GPL-2.0-or-later */
-/* Generated values are owned by kernel/abi/identity.env. */
+/* Generated values are owned by kernel/common/abi/identity.env. */
 #ifndef UML_DARWIN_ABI_IDENTITY_H
 #define UML_DARWIN_ABI_IDENTITY_H
 
-#define DARWIN_UML_ABI_VERSION 13U
-#define DARWIN_UML_ABI_FINGERPRINT 0x4936b61fe3c10ef8ULL
+#define DARWIN_UML_ABI_VERSION 14U
+#define DARWIN_UML_ABI_FINGERPRINT 0x2d9c2e7a4f3ee428ULL
 
 #endif
diff --git a/arch/um/os-Darwin/uml_darwin_memory.h b/arch/um/os-Darwin/uml_darwin_memory.h
index 8a4edd1e63c89da9726cdd75c14104038ea97f04..3630e0c2aa95ba7c63c111e28f94b54b44f676fa 100644
--- a/arch/um/os-Darwin/uml_darwin_memory.h
+++ b/arch/um/os-Darwin/uml_darwin_memory.h
@@ -35,10 +35,12 @@ int darwin_uml_vm_invalidate_code(unsigned long generation,
 int darwin_uml_vm_sync_from_backing(unsigned long address);
 int darwin_uml_vm_sync_from_buffer(unsigned long address,
 				   const void *buffer, unsigned long length);
-int darwin_uml_vm_mapping_matches(unsigned long address, int fd,
-				  unsigned long long offset);
-int darwin_uml_vm_rebind(unsigned long address, int fd,
-			 unsigned long long offset);
+/* A uaccess pinned the page at fd and offset for address: discard the
+ * software mapping of address when it names other backing, because either
+ * sample may be the stale one. An absent or equal mapping is left as it is,
+ * and nothing is installed. Returns 0, or a negative value on failure. */
+int darwin_uml_vm_discard_if_stale(unsigned long address, int fd,
+				   unsigned long long offset);
 int darwin_uml_vm_stage_stack(unsigned long address);
 int darwin_uml_vm_finish_stack(unsigned long address);
 /* Returns 1 when the access can be retried, 0 when Linux must resolve the
