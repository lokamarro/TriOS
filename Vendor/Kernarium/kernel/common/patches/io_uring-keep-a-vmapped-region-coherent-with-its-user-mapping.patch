From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 11 Oct 2026 00:54:08 +0900
Subject: [PATCH] io_uring: keep a vmapped region coherent with its user
 mapping

On an architecture that maps vmalloc space in groups of pages (see
arch_vmap_group_order()), a vmap of a region is shared with the user's
mapping of it only while it maps whole aligned groups of contiguous
pages. Anything else is a private copy that the user mapping never
sees, and the ring would stall.

The pages of a kernel-allocated region that cannot be one compound page
are now allocated in whole groups, and the array and the vmap cover the
extra pages, which are zeroed and unused. Accounting and the mmap bound
still count the region's own pages.

A region in the user's memory cannot be regrouped. When it is neither
one folio, reached through the linear map, nor whole aligned groups, it
is refused with -EINVAL: for IORING_SETUP_NO_MMAP rings, registered
memory regions and provided-buffer rings. This is what
io_register_pbuf_ring() already does where the user and kernel mappings
must be coloured alike. Applications use a huge page or let the kernel
allocate the region, as liburing's IOU_PBUF_RING_MMAP does.

An architecture without groups sees no change.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 io_uring/memmap.c | 93 +++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 90 insertions(+), 3 deletions(-)

diff --git a/io_uring/memmap.c b/io_uring/memmap.c
index 4cc1529fd0b88f36654d460f6b6e77fe2649f878..1fd77b8d3d4246db22affd0619de060118daddd0 100644
--- a/io_uring/memmap.c
+++ b/io_uring/memmap.c
@@ -88,12 +88,35 @@ enum {
 	IO_REGION_F_USER_PROVIDED		= 2,
 	/* only the first page in the array is ref'ed */
 	IO_REGION_F_SINGLE_REF			= 4,
+	/* the array holds whole vmap groups, see io_region_nr_backing() */
+	IO_REGION_F_GROUPED			= 8,
 };
 
+/*
+ * An architecture that maps vmalloc space in groups of pages shares a vmap
+ * of a region with the user's mapping of it only while it maps whole aligned
+ * groups of contiguous pages (see arch_vmap_group_order()). The pages the
+ * kernel allocates for a region it vmaps are therefore allocated in whole
+ * groups, and a region the user provides must already be such groups, or
+ * one folio that the kernel reaches through the linear map.
+ */
+static unsigned int io_region_group(void)
+{
+	return 1U << arch_vmap_group_order();
+}
+
+/* Pages the array of @mr holds: its size, rounded up to whole groups. */
+static unsigned long io_region_nr_backing(const struct io_mapped_region *mr)
+{
+	if (mr->flags & IO_REGION_F_GROUPED)
+		return ALIGN(mr->nr_pages, io_region_group());
+	return mr->nr_pages;
+}
+
 void io_free_region(struct user_struct *user, struct io_mapped_region *mr)
 {
 	if (mr->pages) {
-		long nr_refs = mr->nr_pages;
+		long nr_refs = io_region_nr_backing(mr);
 
 		if (mr->flags & IO_REGION_F_SINGLE_REF)
 			nr_refs = 1;
@@ -120,6 +143,24 @@ void io_free_region(struct user_struct *user, struct io_mapped_region *mr)
 	memset(mr, 0, sizeof(*mr));
 }
 
+static bool io_region_pages_grouped(struct page **pages, int nr_pages)
+{
+	const unsigned int group = io_region_group();
+	int i, j;
+
+	if (nr_pages % group)
+		return false;
+	for (i = 0; i < nr_pages; i += group) {
+		if (page_to_pfn(pages[i]) & (group - 1))
+			return false;
+		for (j = 1; j < group; j++)
+			if (page_to_pfn(pages[i + j]) !=
+			    page_to_pfn(pages[i]) + j)
+				return false;
+	}
+	return true;
+}
+
 static int io_region_init_ptr(struct io_mapped_region *mr)
 {
 	struct io_imu_folio_data ifd;
@@ -131,7 +172,18 @@ static int io_region_init_ptr(struct io_mapped_region *mr)
 			return 0;
 		}
 	}
-	ptr = vmap(mr->pages, mr->nr_pages, VM_MAP, PAGE_KERNEL);
+	/*
+	 * The user's pages cannot be moved. Where the kernel's alias of them
+	 * would be a private copy, refuse them, as io_register_pbuf_ring()
+	 * does where the user and kernel mappings must be coloured alike: the
+	 * application can provide a huge page or use IORING_SETUP_NO_MMAP,
+	 * IOU_PBUF_RING_MMAP and a kernel-allocated region instead.
+	 */
+	if (arch_vmap_group_order() &&
+	    (mr->flags & IO_REGION_F_USER_PROVIDED) &&
+	    !io_region_pages_grouped(mr->pages, mr->nr_pages))
+		return -EINVAL;
+	ptr = vmap(mr->pages, io_region_nr_backing(mr), VM_MAP, PAGE_KERNEL);
 	if (!ptr)
 		return -ENOMEM;
 
@@ -167,6 +219,26 @@ static int io_region_pin_pages(struct io_mapped_region *mr,
 	return 0;
 }
 
+/* Allocate @nr_pages, a multiple of the group, in whole groups. */
+static unsigned long io_region_alloc_groups(gfp_t gfp, struct page **pages,
+					    unsigned long nr_pages)
+{
+	const unsigned int order = arch_vmap_group_order();
+	unsigned long i;
+	int j;
+
+	for (i = 0; i < nr_pages; i += 1UL << order) {
+		struct page *page = alloc_pages(gfp, order);
+
+		if (!page)
+			break;
+		split_page(page, order);
+		for (j = 0; j < 1 << order; j++)
+			pages[i + j] = page + j;
+	}
+	return i;
+}
+
 static int io_region_allocate_pages(struct io_mapped_region *mr,
 				    struct io_uring_region_desc *reg,
 				    unsigned long mmap_offset)
@@ -174,10 +246,12 @@ static int io_region_allocate_pages(struct io_mapped_region *mr,
 	gfp_t gfp = GFP_KERNEL_ACCOUNT | __GFP_ZERO | __GFP_NOWARN;
 	size_t size = (size_t) mr->nr_pages << PAGE_SHIFT;
 	unsigned long nr_allocated;
+	unsigned long nr_backing;
 	struct page **pages;
 	void *p;
 
-	pages = kvmalloc_array(mr->nr_pages, sizeof(*pages), gfp);
+	nr_backing = ALIGN(mr->nr_pages, io_region_group());
+	pages = kvmalloc_array(nr_backing, sizeof(*pages), gfp);
 	if (!pages)
 		return -ENOMEM;
 
@@ -187,6 +261,19 @@ static int io_region_allocate_pages(struct io_mapped_region *mr,
 		goto done;
 	}
 
+	if (arch_vmap_group_order()) {
+		/* The region is vmapped: give it whole groups to map. */
+		nr_allocated = io_region_alloc_groups(gfp, pages, nr_backing);
+		if (nr_allocated != nr_backing) {
+			if (nr_allocated)
+				release_pages(pages, nr_allocated);
+			kvfree(pages);
+			return -ENOMEM;
+		}
+		mr->flags |= IO_REGION_F_GROUPED;
+		goto done;
+	}
+
 	nr_allocated = alloc_pages_bulk_node(gfp, NUMA_NO_NODE,
 					     mr->nr_pages, pages);
 	if (nr_allocated != mr->nr_pages) {
