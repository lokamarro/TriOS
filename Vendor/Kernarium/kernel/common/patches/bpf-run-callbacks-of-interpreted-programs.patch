 }
 
+#ifndef CONFIG_BPF_JIT_ALWAYS_ON
+/* Load a native entry point into the interpreter for a callback. */
+static int bind_interp_callback(struct bpf_verifier_env *env,
+				struct bpf_insn *insn, int idx)
+{
+	int start = idx + insn->imm + 1;
+	int subprog = find_subprog(env, start);
+	bpf_callback_t entry;
+	int err;
+
+	if (verifier_bug_if(subprog < 0, env, "no callback at insn %d", start))
+		return -EFAULT;
+	err = bpf_interp_callback_bind(env->prog, start, subprog,
+				       env->subprog_info[subprog].stack_depth,
+				       &entry);
+	if (err) {
+		verbose(env, "no free interpreter callback slot for subprog %d\n",
+			subprog);
+		return err;
+	}
+	insn[0].imm = (u32)(unsigned long)entry;
+	insn[1].imm = (u64)(unsigned long)entry >> 32;
+	return 0;
+}
+#endif
+
 static int fixup_call_args(struct bpf_verifier_env *env)
 {
 #ifndef CONFIG_BPF_JIT_ALWAYS_ON
@@ -22447,11 +22479,14 @@ static int fixup_call_args(struct bpf_verifier_env *env)
 	}
 	for (i = 0; i < prog->len; i++, insn++) {
 		if (bpf_pseudo_func(insn)) {
-			/* When JIT fails the progs with callback calls
-			 * have to be rejected, since interpreter doesn't support them yet.
-			 */
-			verbose(env, "callbacks are not allowed in non-JITed programs\n");
-			return -EINVAL;
+			if (bpf_prog_is_offloaded(prog->aux)) {
+				verbose(env, "callbacks are not allowed in non-JITed programs\n");
+				return -EINVAL;
+			}
+			err = bind_interp_callback(env, insn, i);
+			if (err)
+				return err;
+			continue;
 		}
 
 		if (!bpf_pseudo_call(insn))
