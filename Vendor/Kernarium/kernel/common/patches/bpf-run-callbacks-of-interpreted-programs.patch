+
+/*
+ * Helpers such as bpf_loop(), bpf_for_each_map_elem() and the BPF timers call
+ * a program's callback as a native bpf_callback_t. A JIT passes them its
+ * compiled subprogram. An interpreted subprogram has no code of its own, and
+ * this kernel must not generate any at run time, so it carries a fixed pool
+ * of native entry points instead. Each entry point enters the interpreter at
+ * the callback bound to its slot, as BPF_CALL_ARGS does for a bpf-to-bpf call.
+ * The verifier binds one slot to each callback subprogram of a program, and
+ * freeing the program releases them. A load that finds every slot bound
+ * fails with -ENOSPC.
+ */
+#define BPF_INTERP_CALLBACK_SLOTS 1024
+
+struct bpf_interp_callback {
+	struct bpf_prog_aux *owner;
+	u64 (*run)(u64 r1, u64 r2, u64 r3, u64 r4, u64 r5,
+		   const struct bpf_insn *insn);
+	u32 start;
+	u32 subprog;
+};
+
+static struct bpf_interp_callback bpf_interp_callbacks[BPF_INTERP_CALLBACK_SLOTS];
+static DEFINE_MUTEX(bpf_interp_callback_lock);
+
+static noinline u64 bpf_interp_callback_run(u64 r1, u64 r2, u64 r3, u64 r4,
+					    u64 r5,
+					    const struct bpf_interp_callback *cb)
+{
+	return cb->run(r1, r2, r3, r4, r5, cb->owner->prog->insnsi + cb->start);
+}
+
+#define BPF_INTERP_CALLBACKS_16(n)					\
+	BPF_INTERP_CALLBACK(n##0) BPF_INTERP_CALLBACK(n##1)		\
+	BPF_INTERP_CALLBACK(n##2) BPF_INTERP_CALLBACK(n##3)		\
+	BPF_INTERP_CALLBACK(n##4) BPF_INTERP_CALLBACK(n##5)		\
+	BPF_INTERP_CALLBACK(n##6) BPF_INTERP_CALLBACK(n##7)		\
+	BPF_INTERP_CALLBACK(n##8) BPF_INTERP_CALLBACK(n##9)		\
+	BPF_INTERP_CALLBACK(n##a) BPF_INTERP_CALLBACK(n##b)		\
+	BPF_INTERP_CALLBACK(n##c) BPF_INTERP_CALLBACK(n##d)		\
+	BPF_INTERP_CALLBACK(n##e) BPF_INTERP_CALLBACK(n##f)
+#define BPF_INTERP_CALLBACKS_256(n)					\
+	BPF_INTERP_CALLBACKS_16(n##0) BPF_INTERP_CALLBACKS_16(n##1)	\
+	BPF_INTERP_CALLBACKS_16(n##2) BPF_INTERP_CALLBACKS_16(n##3)	\
+	BPF_INTERP_CALLBACKS_16(n##4) BPF_INTERP_CALLBACKS_16(n##5)	\
+	BPF_INTERP_CALLBACKS_16(n##6) BPF_INTERP_CALLBACKS_16(n##7)	\
+	BPF_INTERP_CALLBACKS_16(n##8) BPF_INTERP_CALLBACKS_16(n##9)	\
+	BPF_INTERP_CALLBACKS_16(n##a) BPF_INTERP_CALLBACKS_16(n##b)	\
+	BPF_INTERP_CALLBACKS_16(n##c) BPF_INTERP_CALLBACKS_16(n##d)	\
+	BPF_INTERP_CALLBACKS_16(n##e) BPF_INTERP_CALLBACKS_16(n##f)
+#define BPF_INTERP_CALLBACKS						\
+	BPF_INTERP_CALLBACKS_256(0) BPF_INTERP_CALLBACKS_256(1)		\
+	BPF_INTERP_CALLBACKS_256(2) BPF_INTERP_CALLBACKS_256(3)
+
+#define BPF_INTERP_CALLBACK(n)						\
+static u64 bpf_interp_callback_##n(u64 r1, u64 r2, u64 r3, u64 r4, u64 r5) \
+{									\
+	return bpf_interp_callback_run(r1, r2, r3, r4, r5,		\
+				       &bpf_interp_callbacks[0x##n]);	\
+}
+BPF_INTERP_CALLBACKS
+#undef BPF_INTERP_CALLBACK
+
+#define BPF_INTERP_CALLBACK(n) bpf_interp_callback_##n,
+static const bpf_callback_t bpf_interp_callback_entries[] = {
+	BPF_INTERP_CALLBACKS
+};
+#undef BPF_INTERP_CALLBACK
+static_assert(ARRAY_SIZE(bpf_interp_callback_entries) ==
+	      BPF_INTERP_CALLBACK_SLOTS);
+
+/**
+ * bpf_interp_callback_bind - bind a native entry point to a callback
+ * @prog: the program being verified
+ * @start: index of the callback subprogram's first instruction
+ * @subprog: the callback's subprogram number
+ * @stack_depth: stack depth of the callback subprogram
+ *
+ * @entry: receives the native entry point
+ *
+ * A program that refers to one callback more than once shares its slot.
+ *
+ * Return: 0, or -ENOSPC when every slot is bound.
+ */
+int bpf_interp_callback_bind(struct bpf_prog *prog, u32 start, u32 subprog,
+			     u32 stack_depth, bpf_callback_t *entry)
+{
+	struct bpf_interp_callback *cb;
+	int i, slot = -1;
+
+	stack_depth = max_t(u32, stack_depth, 1);
+	mutex_lock(&bpf_interp_callback_lock);
+	for (i = 0; i < BPF_INTERP_CALLBACK_SLOTS; i++) {
+		cb = &bpf_interp_callbacks[i];
+		if (cb->owner == prog->aux && cb->start == start) {
+			slot = i;
+			goto out;
+		}
+		if (!cb->owner && slot < 0)
+			slot = i;
+	}
+	if (slot < 0) {
+		mutex_unlock(&bpf_interp_callback_lock);
+		return -ENOSPC;
+	}
+	cb = &bpf_interp_callbacks[slot];
+	cb->run = interpreters_args[(round_up(stack_depth, 32) / 32) - 1];
+	cb->start = start;
+	cb->subprog = subprog;
+	cb->owner = prog->aux;
+	prog->aux->interp_callbacks++;
+out:
+	mutex_unlock(&bpf_interp_callback_lock);
+	*entry = bpf_interp_callback_entries[slot];
+	return 0;
+}
+
+/* Release the slots of a program that can no longer run. */
+void bpf_interp_callbacks_release(struct bpf_prog_aux *aux)
+{
+	int i;
+
+	if (!aux->interp_callbacks)
+		return;
+	mutex_lock(&bpf_interp_callback_lock);
+	for (i = 0; i < BPF_INTERP_CALLBACK_SLOTS; i++)
+		if (bpf_interp_callbacks[i].owner == aux)
+			bpf_interp_callbacks[i] = (struct bpf_interp_callback){};
+	mutex_unlock(&bpf_interp_callback_lock);
+	aux->interp_callbacks = 0;
+}
+
+/*
+ * Rewrite a callback load in an instruction dump the way jit_subprogs()
+ * leaves it: the relative offset of the subprogram and its number, never an
+ * entry point address.
+ */
+void bpf_interp_callback_dump(const struct bpf_prog *prog,
+			      struct bpf_insn *insn, u32 idx)
+{
+	u64 entry = (u64)(u32)insn[1].imm << 32 | (u32)insn[0].imm;
+	const struct bpf_interp_callback *cb;
+	int i;
+
+	insn[0].imm = 0;
+	insn[1].imm = 0;
+	for (i = 0; i < BPF_INTERP_CALLBACK_SLOTS; i++) {
+		if ((u64)(unsigned long)bpf_interp_callback_entries[i] != entry)
+			continue;
+		/* The program holds its slots until it is freed. */
+		cb = &bpf_interp_callbacks[i];
+		if (cb->owner == prog->aux) {
+			insn[0].imm = cb->start - idx - 1;
+			insn[1].imm = cb->subprog;
+		}
+		return;
+	}
+}
 #endif
 #endif
 
@@ -2953,6 +3111,7 @@ static void bpf_prog_free_deferred(struct work_struct *work)
 #ifdef CONFIG_BPF_SYSCALL
 	bpf_free_kfunc_btf_tab(aux->kfunc_btf_tab);
 	bpf_prog_stream_free(aux->prog);
+	bpf_interp_callbacks_release(aux);
 #endif
 #ifdef CONFIG_CGROUP_BPF
 	if (aux->cgroup_atype != CGROUP_BPF_ATTACH_TYPE_INVALID)
