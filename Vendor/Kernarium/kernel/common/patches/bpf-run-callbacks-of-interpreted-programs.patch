diff --git a/kernel/bpf/core.c b/kernel/bpf/core.c
index c99d3f396fdc0cdaae18bd1cd1bbd127d95b9bf7..c1e64a00ab470ebbb27ff17e93e3a80f08cfd77d 100644
--- a/kernel/bpf/core.c
+++ b/kernel/bpf/core.c
@@ -2412,6 +2412,164 @@ void bpf_patch_call_args(struct bpf_insn *insn, u32 stack_depth)
 		__bpf_call_base_args;
