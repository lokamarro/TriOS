 kernel/bpf/core.c     | 159 ++++++++++++++++++++++++++++++++++++++++++
 kernel/bpf/syscall.c  |   6 ++
 kernel/bpf/verifier.c |  45 ++++++++++--
 4 files changed, 220 insertions(+), 5 deletions(-)

