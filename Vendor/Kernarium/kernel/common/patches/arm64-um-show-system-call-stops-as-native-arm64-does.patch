From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sun, 25 Oct 2026 07:59:45 +0900
Subject: [PATCH] arm64: um: show system call stops as native arm64 does

A tracer of an arm64 task finds two more things at a system call stop
than UML gave it.

NT_ARM_SYSTEM_CALL is the system call number of the task, which a
tracer changes at an entry stop to run another call or sets to -1 to
skip the call and leave x0 as it wrote it. Tools that rewrite a task's
calls, such as proot, rely on it. It is the fourth regset of the
AArch64 view and the fourth of the AArch32 view an AArch64 tracer
gets, after NT_ARM_TLS, as natively.

A call that is restarted after a signal runs again as the number
register says, which a regset write does not change, so the next entry
stop shows the call the task made and not the one the tracer put in its
place. The generic restart asks the port through
PT_REGS_RESTORE_SYSCALL_NR(), which arm64 makes a no-op.

A stop also clobbers x7, r12 of an AArch32 task, with 0 at an entry
stop and 1 at an exit stop, and puts the task's value back when the
stop ends, so tracers that predate PTRACE_GET_SYSCALL_INFO tell the
stops apart. Writes to it are lost, as natively. The generic code asks
the port for this through UPT_SYSCALL_STOP_BEGIN() and
UPT_SYSCALL_STOP_END(), which default to nothing, so x86 is untouched.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/arm64/um/asm/ptrace.h           | 18 +++++++++++++
 arch/arm64/um/ptrace.c               | 40 ++++++++++++++++++++++++++--
 arch/arm64/um/ptrace32.c             | 13 +++++++--
 arch/arm64/um/shared/sysdep/ptrace.h | 26 ++++++++++++++++++
 arch/um/kernel/ptrace.c              | 28 ++++++++++++++++++-
 arch/um/kernel/signal.c              | 16 +++++++++--
 6 files changed, 134 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/um/asm/ptrace.h b/arch/arm64/um/asm/ptrace.h
index f1090b3d5472b6e7913ffc556e1fcf25a725affd..68f9293d262b686cf11b2d4a006c2f894f541773 100644
--- a/arch/arm64/um/asm/ptrace.h
+++ b/arch/arm64/um/asm/ptrace.h
@@ -34,6 +34,12 @@ enum {
 #define PT_REGS_PSTATE(state) UPT_PSTATE(&(state)->regs)
 #define PT_REGS_ORIG_SYSCALL(state) \
 	PT_REGS_X(state, UPT_AARCH32(&(state)->regs) ? 7 : 8)
+/*
+ * A restarted call runs again as the register says, as on native arm64, so
+ * a tracer that changed the number with NT_ARM_SYSTEM_CALL sees the original
+ * call at the next entry stop.
+ */
+#define PT_REGS_RESTORE_SYSCALL_NR(state) ((void)0)
 #define PT_REGS_SYSCALL_RET(state) PT_REGS_X(state, 0)
 
 #define PT_REGS_SET_SYSCALL_RETURN(state, result) \
@@ -64,4 +70,16 @@ extern void arch_switch_to(struct task_struct *to);
 extern bool uml_arm64_valid_user_pstate(struct task_struct *task,
 					unsigned long *pstate);
 
+struct user_regset;
+struct membuf;
+/* NT_ARM_SYSTEM_CALL of the AArch64 and AArch32 views (ptrace.c). */
+extern int uml_arm64_system_call_get(struct task_struct *target,
+				     const struct user_regset *regset,
+				     struct membuf to);
+extern int uml_arm64_system_call_set(struct task_struct *target,
+				     const struct user_regset *regset,
+				     unsigned int pos, unsigned int count,
+				     const void *kbuf,
+				     const void __user *ubuf);
+
 #endif
diff --git a/arch/arm64/um/ptrace.c b/arch/arm64/um/ptrace.c
index e4c01527abe73ff1a238096db6bc3f60ba7819eb..82097e4b037feec13f154fc8be15f9c516958feb 100644
--- a/arch/arm64/um/ptrace.c
+++ b/arch/arm64/um/ptrace.c
@@ -14,9 +14,11 @@
 #endif
 #include "sme.h"
 
-/* Native arm64's third regset, after the two asm/ptrace.h names. */
+/* Native arm64's third and, here, fourth regsets, after the two
+ * asm/ptrace.h names. */
 enum {
 	REGSET_TLS = REGSET_FP + 1,
+	REGSET_SYSTEM_CALL,
 };
 
 static int register_index(int regno)
@@ -185,6 +187,32 @@ static int tls_set(struct task_struct *target,
 	return 0;
 }
 
+/* NT_ARM_SYSTEM_CALL, as native: the number of the system call the task is
+ * in, which a tracer changes at an entry stop to run another call, or to -1
+ * to skip it and leave x0 as it stands. */
+int uml_arm64_system_call_get(struct task_struct *target,
+			      const struct user_regset *regset,
+			      struct membuf to)
+{
+	return membuf_store(&to, (int)PT_REGS_SYSCALL_NR(task_pt_regs(target)));
+}
+
+int uml_arm64_system_call_set(struct task_struct *target,
+			      const struct user_regset *regset,
+			      unsigned int pos, unsigned int count,
+			      const void *kbuf, const void __user *ubuf)
+{
+	int syscallno = PT_REGS_SYSCALL_NR(task_pt_regs(target));
+	int error;
+
+	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf, &syscallno, 0,
+				   -1);
+	if (error)
+		return error;
+	PT_REGS_SYSCALL_NR(task_pt_regs(target)) = syscallno;
+	return 0;
+}
+
 static const struct user_regset uml_arm64_regsets[] = {
 	[REGSET_GENERAL] = {
 		USER_REGSET_NOTE_TYPE(PRSTATUS),
@@ -210,6 +238,14 @@ static const struct user_regset uml_arm64_regsets[] = {
 		.regset_get = tls_get,
 		.set = tls_set,
 	},
+	[REGSET_SYSTEM_CALL] = {
+		USER_REGSET_NOTE_TYPE(ARM_SYSTEM_CALL),
+		.n = 1,
+		.size = sizeof(int),
+		.align = sizeof(int),
+		.regset_get = uml_arm64_system_call_get,
+		.set = uml_arm64_system_call_set,
+	},
 #ifdef CONFIG_UML_ARM64_SME
 	/* Only the SME view below has these, as native arm64 with SME. */
 	{
@@ -247,7 +283,7 @@ static const struct user_regset_view uml_arm64_view = {
 	.name = "aarch64",
 	.e_machine = EM_AARCH64,
 	.regsets = uml_arm64_regsets,
-	.n = REGSET_TLS + 1,
+	.n = REGSET_SYSTEM_CALL + 1,
 };
 
 #ifdef CONFIG_UML_ARM64_SME
diff --git a/arch/arm64/um/ptrace32.c b/arch/arm64/um/ptrace32.c
index ae23fd3375c722ddcdb38ee130fbfbea210cceae..2ecaf91777f23845af7c6da57dec83d4fc77d8f5 100644
--- a/arch/arm64/um/ptrace32.c
+++ b/arch/arm64/um/ptrace32.c
@@ -6,8 +6,8 @@
  * The regset views are native's: a compat tracer, and a core dump of a
  * compat task, use user_aarch32_view (NT_PRSTATUS of 18 words and NT_ARM_VFP);
  * an AArch64 tracer of a compat task uses user_aarch32_ptrace_view, which
- * adds NT_ARM_TLS.  UML has no hardware debug registers and neither view
- * has NT_ARM_SYSTEM_CALL, as the AArch64 view has neither.
+ * adds NT_ARM_TLS and NT_ARM_SYSTEM_CALL.  UML has no hardware debug
+ * registers, so neither this view nor the AArch64 one has their regsets.
  */
 
 #include <linux/compat.h>
@@ -25,6 +25,7 @@ enum compat_regset {
 	REGSET_COMPAT_GPR,
 	REGSET_COMPAT_VFP,
 	REGSET_COMPAT_TLS,
+	REGSET_COMPAT_SYSTEM_CALL,
 };
 
 /* struct user_vfp of arch/arm: D0-D31 then FPSCR. */
@@ -208,6 +209,14 @@ static const struct user_regset aarch32_regsets[] = {
 		.regset_get = compat_tls_get,
 		.set = compat_tls_set,
 	},
+	[REGSET_COMPAT_SYSTEM_CALL] = {
+		USER_REGSET_NOTE_TYPE(ARM_SYSTEM_CALL),
+		.n = 1,
+		.size = sizeof(int),
+		.align = sizeof(int),
+		.regset_get = uml_arm64_system_call_get,
+		.set = uml_arm64_system_call_set,
+	},
 };
 
 static const struct user_regset_view user_aarch32_view = {
diff --git a/arch/arm64/um/shared/sysdep/ptrace.h b/arch/arm64/um/shared/sysdep/ptrace.h
index 4188e5b95ef1a04deee6b4ce6f2d740b08332d76..977ed7b1df90a8da0b90cfef6a2aae70bd61019e 100644
--- a/arch/arm64/um/shared/sysdep/ptrace.h
+++ b/arch/arm64/um/shared/sysdep/ptrace.h
@@ -107,6 +107,32 @@ struct uml_pt_regs {
 			 (UPT_PSTATE(regs) & UML_ARM64_PSTATE_T)) ? 2 : 4; \
 } while (0)
 
+/*
+ * A system call stop holds 0 (entry) or 1 (exit) in x7, in r12 of an AArch32
+ * task, for as long as the tracer looks, as native arm64 does, so that a
+ * tracer can tell the stops apart.  The task's own value comes back when the
+ * stop ends, whatever the tracer wrote.
+ */
+static inline unsigned long upt_syscall_stop_begin(struct uml_pt_regs *regs,
+						   unsigned long marker)
+{
+	unsigned long saved = UPT_X(regs, UPT_AARCH32(regs) ? 12 : 7);
+
+	UPT_X(regs, UPT_AARCH32(regs) ? 12 : 7) = marker;
+	return saved;
+}
+
+static inline void upt_syscall_stop_end(struct uml_pt_regs *regs,
+					unsigned long saved)
+{
+	UPT_X(regs, UPT_AARCH32(regs) ? 12 : 7) = saved;
+}
+
+#define UPT_SYSCALL_STOP_BEGIN(regs, exit) \
+	upt_syscall_stop_begin((regs), (exit))
+#define UPT_SYSCALL_STOP_END(regs, saved) \
+	upt_syscall_stop_end((regs), (saved))
+
 /* Whether the undefined instruction at an AArch32 task's pc is one of the
  * encodings which stand for a breakpoint to a debugger (aarch32.c). */
 extern int uml_arm64_aarch32_break(struct uml_pt_regs *regs);
diff --git a/arch/um/kernel/ptrace.c b/arch/um/kernel/ptrace.c
index 3507bf10ecd8dbaf7b7cd4f0391537943c219f0f..79a25e436086aed18bd760f68efb87a77e18586e 100644
--- a/arch/um/kernel/ptrace.c
+++ b/arch/um/kernel/ptrace.c
@@ -118,12 +118,32 @@ static void send_sigtrap(struct uml_pt_regs *regs, int error_code)
 			UPT_IS_USER(regs) ? (void __user *) UPT_IP(regs) : NULL);
 }
 
+/*
+ * A port whose tracers tell a system call's entry stop from its exit stop by a
+ * register the stop clobbers (arm64 holds 0 or 1 in x7, and in r12 of an
+ * AArch32 task) defines these in sysdep/ptrace.h:
+ *
+ *   UPT_SYSCALL_STOP_BEGIN(r, exit)	puts the marker of an entry or exit
+ *					stop in the register and returns the
+ *					value it held
+ *   UPT_SYSCALL_STOP_END(r, saved)	puts that value back
+ *
+ * The tracer cannot keep a write to the register.
+ */
+#ifndef UPT_SYSCALL_STOP_BEGIN
+#define UPT_SYSCALL_STOP_BEGIN(r, exit) 0UL
+#define UPT_SYSCALL_STOP_END(r, saved) ((void)(saved))
+#endif
+
 /*
  * XXX Check TIF_SINGLESTEP for singlestepping check and
  * PT_PTRACED vs TIF_SYSCALL_TRACE for syscall tracing check
  */
 int syscall_trace_enter(struct pt_regs *regs)
 {
+	unsigned long saved;
+	int ret;
+
 	audit_syscall_entry(UPT_SYSCALL_NR(&regs->regs),
 			    UPT_SYSCALL_ENTRY_ARG1(&regs->regs),
 			    UPT_SYSCALL_ARG2(&regs->regs),
@@ -136,12 +156,16 @@ int syscall_trace_enter(struct pt_regs *regs)
 	if (!test_thread_flag(TIF_SYSCALL_TRACE))
 		return 0;
 
-	return ptrace_report_syscall_entry(regs);
+	saved = UPT_SYSCALL_STOP_BEGIN(&regs->regs, 0);
+	ret = ptrace_report_syscall_entry(regs);
+	UPT_SYSCALL_STOP_END(&regs->regs, saved);
+	return ret;
 }
 
 void syscall_trace_leave(struct pt_regs *regs)
 {
 	int ptraced = current->ptrace;
+	unsigned long saved;
 
 	audit_syscall_exit(regs);
 
@@ -155,7 +179,9 @@ void syscall_trace_leave(struct pt_regs *regs)
 	if (!test_thread_flag(TIF_SYSCALL_TRACE))
 		return;
 
+	saved = UPT_SYSCALL_STOP_BEGIN(&regs->regs, 1);
 	ptrace_report_syscall_exit(regs, 0);
+	UPT_SYSCALL_STOP_END(&regs->regs, saved);
 	/* force do_signal() --> is_syscall() */
 	if (ptraced & PT_PTRACED)
 		set_thread_flag(TIF_SIGPENDING);
diff --git a/arch/um/kernel/signal.c b/arch/um/kernel/signal.c
index b1bda9aa701f912895b8d4eb8bfefa29008e77da..9d1318d20ff616ceeb019e5d3b03541c54854fa0 100644
--- a/arch/um/kernel/signal.c
+++ b/arch/um/kernel/signal.c
@@ -22,6 +22,18 @@
 #define PT_REGS_RESTART_SYSCALL_NR(regs) __NR_restart_syscall
 #endif
 
+/*
+ * What the syscall-number register holds when an interrupted call starts
+ * again: the number the call ran as.  A port whose tracers change a call's
+ * number without writing the register (arm64's NT_ARM_SYSTEM_CALL) defines the
+ * macro to leave the register as the task wrote it, which is what the task
+ * restarts with natively.
+ */
+#ifndef PT_REGS_RESTORE_SYSCALL_NR
+#define PT_REGS_RESTORE_SYSCALL_NR(regs) \
+	(PT_REGS_ORIG_SYSCALL(regs) = PT_REGS_SYSCALL_NR(regs))
+#endif
+
 EXPORT_SYMBOL(block_signals);
 EXPORT_SYMBOL(unblock_signals);
 
@@ -81,7 +93,7 @@ static void handle_signal(struct ksignal *ksig, struct pt_regs *regs)
 			fallthrough;
 		case -ERESTARTNOINTR:
 			PT_REGS_RESTART_SYSCALL(regs);
-			PT_REGS_ORIG_SYSCALL(regs) = PT_REGS_SYSCALL_NR(regs);
+			PT_REGS_RESTORE_SYSCALL_NR(regs);
 			break;
 		}
 	}
@@ -118,7 +130,7 @@ void do_signal(struct pt_regs *regs)
 		case -ERESTARTNOHAND:
 		case -ERESTARTSYS:
 		case -ERESTARTNOINTR:
-			PT_REGS_ORIG_SYSCALL(regs) = PT_REGS_SYSCALL_NR(regs);
+			PT_REGS_RESTORE_SYSCALL_NR(regs);
 			PT_REGS_RESTART_SYSCALL(regs);
 			break;
 		case -ERESTART_RESTARTBLOCK:
