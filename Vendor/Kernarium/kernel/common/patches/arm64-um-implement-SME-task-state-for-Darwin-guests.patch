- */
-struct uml_arm64_frame_record {
-	u64 fp;
-	u64 lr;
-};
+#include "signal_frame.h"
+#include "sme.h"
 
 #ifdef UML_HOST_DARWIN
 /* A handler without SA_RESTORER returns here, in the final guest page above
@@ -162,7 +151,11 @@ static int restore_mcontext(struct pt_regs *regs,
 	error |= get_user(PT_REGS_PSTATE(regs), &context->pstate);
 	if (!error && !uml_arm64_valid_user_pstate(&PT_REGS_PSTATE(regs)))
 		error = -EINVAL;
-	if (!error)
+	if (!error && uml_arm64_sme_vl)
+		error = uml_arm64_sme_restore_sigframe(regs, (void __user *)
+			((char __user *)context -
+			 offsetof(struct uml_arm64_rt_sigframe, uc.uc_mcontext)));
+	else if (!error)
 		error = restore_fpsimd_context(regs, context);
 	PT_REGS_SYSCALL_NR(regs) = -1;
 	return error;
@@ -173,11 +166,20 @@ int setup_signal_stack_si(unsigned long stack_top, struct ksignal *ksig,
 {
 	struct uml_arm64_frame_record __user *record;
 	struct uml_arm64_rt_sigframe __user *frame;
+	unsigned long frame_size = sizeof(*frame);
 	unsigned long restorer;
 	int error = 0;
 
+	if (uml_arm64_sme_vl) {
+		long size = uml_arm64_sme_sigframe_size();
+
+		if (size < 0)
+			return 1;
+		frame_size = size;
+	}
+
 	record = (void __user *)round_down(stack_top - sizeof(*record), 16);
-	frame = (void __user *)round_down((unsigned long)record - sizeof(*frame),
+	frame = (void __user *)round_down((unsigned long)record - frame_size,
 					  16);
 	if (!access_ok(frame, (unsigned long)(record + 1) - (unsigned long)frame))
 		return 1;
@@ -191,6 +193,8 @@ int setup_signal_stack_si(unsigned long stack_top, struct ksignal *ksig,
 	error |= save_mcontext(&frame->uc.uc_mcontext, regs);
 	if (ksig->ka.sa.sa_flags & SA_SIGINFO)
 		error |= copy_siginfo_to_user(&frame->info, &ksig->info);
+	if (!error && uml_arm64_sme_vl)
+		error = uml_arm64_sme_save_sigframe(frame, regs);
 	if (error)
 		return error;
 
@@ -210,6 +214,8 @@ int setup_signal_stack_si(unsigned long stack_top, struct ksignal *ksig,
 	PT_REGS_LR(regs) = restorer;
 	PT_REGS_SP(regs) = (unsigned long)frame;
 	PT_REGS_IP(regs) = (unsigned long)ksig->ka.sa.sa_handler;
+	if (uml_arm64_sme_vl)
+		uml_arm64_sme_enter_handler();
 	return 0;
 }
 
