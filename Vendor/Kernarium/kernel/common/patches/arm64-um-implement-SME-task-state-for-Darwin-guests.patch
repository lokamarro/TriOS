+#define SME_GET_VL() uml_arm64_sme_get_current_vl()
+#endif
+
 #define current_sp() ({ void *sp; asm("mov %0, sp" : "=r"(sp)); sp; })
 #define current_bp() ({ unsigned long fp; asm("mov %0, x29" : "=r"(fp)); fp; })
 
