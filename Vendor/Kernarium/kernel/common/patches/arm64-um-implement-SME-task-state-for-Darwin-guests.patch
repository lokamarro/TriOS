+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _UM_ARM64_SIGNAL_FRAME_H
+#define _UM_ARM64_SIGNAL_FRAME_H
+
+#include <linux/signal.h>
+#include <linux/types.h>
+#include <asm/ucontext.h>
+
+/* Native arm64's struct rt_sigframe. */
+struct uml_arm64_rt_sigframe {
+	struct siginfo info;
+	struct ucontext uc;
+};
