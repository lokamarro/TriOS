 static int register_index(int regno)
 {
@@ -117,10 +122,12 @@ static int genregs_set(struct task_struct *target,
 	return 0;
 }
 
+/* The FPSIMD registers only: the SME registers after them in the task's
+ * tail are not the tracer's to read or write. */
 static int fpregs_get(struct task_struct *target,
 		      const struct user_regset *regset, struct membuf to)
 {
-	membuf_write(&to, target->thread.regs.regs.fp, host_fp_size);
+	membuf_write(&to, target->thread.regs.regs.fp, sizeof(elf_fpregset_t));
 	return 0;
 }
 
@@ -130,7 +137,7 @@ static int fpregs_set(struct task_struct *target,
 		      const void *kbuf, const void __user *ubuf)
 {
 	return user_regset_copyin(&pos, &count, &kbuf, &ubuf,
-		target->thread.regs.regs.fp, 0, host_fp_size);
+		target->thread.regs.regs.fp, 0, sizeof(elf_fpregset_t));
 }
 
 static const struct user_regset uml_arm64_regsets[] = {
@@ -150,17 +157,69 @@ static const struct user_regset uml_arm64_regsets[] = {
 		.regset_get = fpregs_get,
 		.set = fpregs_set,
 	},
+#ifdef CONFIG_UML_ARM64_SME
+	/* Only the SME view below has these, as native arm64 with SME. */
+	{
+		USER_REGSET_NOTE_TYPE(ARM_TLS),
+		.n = 2,
+		.size = sizeof(void *),
+		.align = sizeof(void *),
+		.regset_get = uml_arm64_tls_get,
+		.set = uml_arm64_tls_set,
+	},
+	{
+		USER_REGSET_NOTE_TYPE(ARM_SSVE),
+		.n = DIV_ROUND_UP(SVE_PT_SIZE(UML_ARM64_SME_VQ_MAX,
+					      SVE_PT_REGS_SVE), SVE_VQ_BYTES),
+		.size = SVE_VQ_BYTES,
+		.align = SVE_VQ_BYTES,
+		.regset_get = uml_arm64_ssve_get,
+		.set = uml_arm64_ssve_set,
+	},
+	{
+		USER_REGSET_NOTE_TYPE(ARM_ZA),
+		/* ZA is one variably sized register, reported in SVE_VQ_BYTES
+		 * units as the regset core requires. */
+		.n = DIV_ROUND_UP(ZA_PT_SIZE(UML_ARM64_SME_VQ_MAX),
+				  SVE_VQ_BYTES),
+		.size = SVE_VQ_BYTES,
+		.align = SVE_VQ_BYTES,
+		.regset_get = uml_arm64_za_get,
+		.set = uml_arm64_za_set,
+	},
+	{
+		USER_REGSET_NOTE_TYPE(ARM_ZT),
+		.n = 1,
+		.size = ZT_SIG_REG_BYTES,
+		.align = sizeof(u64),
+		.regset_get = uml_arm64_zt_get,
+		.set = uml_arm64_zt_set,
+	},
+#endif
 };
 
 static const struct user_regset_view uml_arm64_view = {
+	.name = "aarch64",
+	.e_machine = EM_AARCH64,
+	.regsets = uml_arm64_regsets,
+	.n = REGSET_FP + 1,
+};
+
+#ifdef CONFIG_UML_ARM64_SME
+static const struct user_regset_view uml_arm64_sme_view = {
 	.name = "aarch64",
 	.e_machine = EM_AARCH64,
 	.regsets = uml_arm64_regsets,
 	.n = ARRAY_SIZE(uml_arm64_regsets),
 };
+#endif
 
