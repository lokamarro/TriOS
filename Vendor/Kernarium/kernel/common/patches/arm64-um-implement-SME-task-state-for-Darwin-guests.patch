 #define INIT_ARCH_THREAD { .tpidr_el0 = 0, .darwin_task = NULL, \
@@ -25,8 +29,25 @@ static inline void arch_copy_thread(struct arch_thread *from,
 			    struct arch_thread *to)
 {
