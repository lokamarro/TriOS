 extern unsigned long darwin_uml_guest_hwcap2(void);
@@ -76,6 +84,18 @@ typedef struct uml_arm64_fpsimd_state elf_fpregset_t;
 #define FIXADDR_USER_START 0
 #define FIXADDR_USER_END 0
 
+#ifdef CONFIG_UML_ARM64_SME
+/*
+ * With SME, AT_MINSIGSTKSZ gives the stack the largest signal frame needs,
+ * as on native arm64; without it the vector stays as it was.
+ */
+extern unsigned long uml_arm64_minsigstksz;
+#define ARCH_DLINFO do { \
+	if (uml_arm64_minsigstksz) \
+		NEW_AUX_ENT(AT_MINSIGSTKSZ, uml_arm64_minsigstksz); \
+} while (0)
