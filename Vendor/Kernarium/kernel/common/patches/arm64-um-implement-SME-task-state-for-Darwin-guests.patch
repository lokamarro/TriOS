index 1b8d3a726ec4b17e88bbecb795b980a3bdb446d9..134007a2cbb6bf0b2c6c035d67d0f17681fb97d2 100644
--- a/arch/arm64/um/signal.c
+++ b/arch/arm64/um/signal.c
@@ -14,19 +14,8 @@
 #include <asm/ptrace.h>
 #include <asm/sigcontext.h>
 #include <asm/ucontext.h>
-
-struct uml_arm64_rt_sigframe {
-	struct siginfo info;
-	struct ucontext uc;
-};
-
-/* As on native arm64, a frame record above the signal frame links the
