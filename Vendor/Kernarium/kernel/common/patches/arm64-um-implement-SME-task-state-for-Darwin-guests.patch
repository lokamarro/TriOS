diff --git a/arch/arm64/um/sme.c b/arch/arm64/um/sme.c
new file mode 100644
index 0000000000000000000000000000000000000000..797ee012bf04d02fa63a8700f47d4f888a99f5ad
--- /dev/null
+++ b/arch/arm64/um/sme.c
@@ -0,0 +1,520 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SME task state for Darwin guests.
+ *
+ * When the Darwin host implements SME for the run,
+ * darwin_uml_guest_sme_vector_length() reports its streaming vector length
+ * (SVL), the only one a task can have, and the kernel gives each task what
+ * arch/arm64/kernel/fpsimd.c gives it on a CPU whose only supported SME
+ * vector length is that SVL.  Otherwise every function here leaves the task
+ * alone and the kernel behaves as one without SME.
+ *
+ * A task's PSTATE.SM and PSTATE.ZA are uml_pt_regs.svcr.  TPIDR2_EL0 and the
+ * task's SME storage live in the SME registers of its bridge tail.  The
+ * storage is allocated, zeroed, the first time an instruction or the kernel
+ * needs it, and an SVCR with either bit set implies that it exists.  The
+ * host loads and stores it around each entry, so the kernel may touch it
+ * only while the task is out of the guest.
+ */
+
+#include <linux/init.h>
+#include <linux/log2.h>
+#include <linux/prctl.h>
+#include <linux/regset.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/sysctl.h>
+#include <asm/elf.h>
+#include <asm/processor.h>
+#include <asm/sigcontext.h>
+#include <uapi/asm/ptrace.h>
+#include "sme.h"
+
+unsigned int uml_arm64_sme_vl __ro_after_init;
+bool uml_arm64_sme2 __ro_after_init;
+
+#ifdef UML_HOST_DARWIN
+extern unsigned long darwin_uml_guest_sme_vector_length(void);
+#define sme_host_vector_length() darwin_uml_guest_sme_vector_length()
+#define sme_host_hwcap2() darwin_uml_guest_hwcap2()
+#else
+#define sme_host_vector_length() 0UL
+#define sme_host_hwcap2() 0UL
+#endif
+
+static int __init uml_arm64_sme_init(void)
+{
+	unsigned long vl = sme_host_vector_length();
+
+	BUILD_BUG_ON(sizeof(elf_fpregset_t) != UML_ARM64_FP_REGISTERS_SIZE);
+	BUILD_BUG_ON(sizeof(struct uml_arm64_sme_registers) != 24);
+	if (!vl)
+		return 0;
+	/* An SME implementation's vector length is a power of two from 16 to
+	 * 256 bytes. */
+	if (WARN(!is_power_of_2(vl) || vl < 16 || vl > 256,
+		 "Darwin: invalid SME vector length %lu\n", vl))
+		return 0;
+	uml_arm64_sme_vl = vl;
+	uml_arm64_sme2 = sme_host_hwcap2() & HWCAP2_SME2;
+	return 0;
+}
+early_initcall(uml_arm64_sme_init);
+
+int uml_arm64_sme_alloc(struct task_struct *task)
+{
+	struct uml_arm64_sme_registers *sme = uml_arm64_sme_registers(task);
+	void *state;
+
+	if (sme->state)
+		return 0;
+	state = kzalloc(UML_ARM64_SME_STATE_SIZE(uml_arm64_sme_vl), GFP_KERNEL);
+	if (!state)
+		return -ENOMEM;
+	sme->state = (unsigned long)state;
+	sme->svl = uml_arm64_sme_vl;
+	return 0;
+}
+
+static void sme_free(struct task_struct *task)
+{
+	struct uml_arm64_sme_registers *sme = uml_arm64_sme_registers(task);
+
+	kfree(uml_arm64_sme_state(task));
+	sme->state = 0;
+	sme->svl = 0;
+}
+
+/*
+ * Native task_smstop_sm(): leaving streaming mode zeroes every vector
+ * register and sets FPSR as ResetSVEState() does.  Z and P become dead, so
+ * the storage keeps whatever it held.
+ */
+void uml_arm64_task_smstop_sm(struct task_struct *task)
+{
+	elf_fpregset_t *fp = uml_arm64_fp_registers(task);
+
+	if (!(*uml_arm64_svcr(task) & UML_ARM64_SVCR_SM))
+		return;
+	memset(fp->vregs, 0, sizeof(fp->vregs));
+	fp->fpsr = 0x0800009f;
+	*uml_arm64_svcr(task) &= ~UML_ARM64_SVCR_SM;
+}
+
+/*
+ * A system call leaves streaming mode and keeps ZA, as native
+ * fpsimd_syscall_enter() does, before a tracer's syscall-entry stop can
+ * look at the task.
+ */
+void uml_arm64_sme_syscall_enter(void)
+{
+	uml_arm64_task_smstop_sm(current);
+}
+
+/*
+ * DARWIN_UML_EVENT_SME_ACCESS: an instruction needs SME storage the task
+ * does not have yet; native do_sme_acc() allocates it, or kills the task.
+ * The host re-enters at the same instruction.
+ */
+int uml_arm64_sme_access(void)
+{
+	if (WARN_ON_ONCE(!uml_arm64_sme_vl))
+		return -EINVAL;
+	if (uml_arm64_sme_alloc(current)) {
+		force_sig(SIGKILL);
+		return -ENOMEM;
+	}
+	return 0;
+}
+
+/*
+ * arch_dup_task_struct() copied the parent's tail; drop its storage pointer
+ * before anything can fail and free the child.
+ */
+void uml_arm64_sme_dup_task(struct task_struct *dst)
+{
+	struct uml_arm64_sme_registers *sme = uml_arm64_sme_registers(dst);
+
+	sme->state = 0;
+	sme->svl = 0;
+}
+
+/*
+ * copy_thread() for a user task, after it copied the parent's registers:
+ * the child starts outside streaming mode with ZA off, as native
+ * arch_dup_task_struct() leaves it.  A child with its own mm then inherits
+ * TPIDR2 and a copy of live ZA and ZT0, as copy_thread_za() gives it,
+ * because a lazily saved ZA may be dormant behind TPIDR2.  A child sharing
+ * the mm must not inherit TPIDR2, whose save block is on another task's
+ * stack.
+ */
+int uml_arm64_sme_copy_thread(struct task_struct *p, unsigned long clone_flags)
+{
+	struct uml_arm64_sme_registers *sme = uml_arm64_sme_registers(p);
+	void *state;
+
+	uml_arm64_sme_dup_task(p);
+	if (!uml_arm64_sme_vl)
+		return 0;
+	uml_arm64_task_smstop_sm(p);
+	*uml_arm64_svcr(p) &= ~UML_ARM64_SVCR_ZA;
+	if (clone_flags & CLONE_VM) {
+		sme->tpidr2 = 0;
+		return 0;
+	}
+	if (!(*uml_arm64_svcr(current) & UML_ARM64_SVCR_ZA) ||
+	    WARN_ON_ONCE(!uml_arm64_sme_state(current)))
+		return 0;
+	state = kmemdup(uml_arm64_sme_state(current),
+			UML_ARM64_SME_STATE_SIZE(uml_arm64_sme_vl), GFP_KERNEL);
+	if (!state)
+		return -ENOMEM;
+	sme->state = (unsigned long)state;
+	sme->svl = uml_arm64_sme_vl;
+	*uml_arm64_svcr(p) |= UML_ARM64_SVCR_ZA;
+	return 0;
+}
+
+/*
+ * exec, before flush_thread() clears the registers: native
+ * fpsimd_flush_thread() frees the storage and resets the vector length,
+ * which here is always the SVL; only the inherit flag survives.
+ */
+void uml_arm64_sme_flush_thread(void)
+{
+	if (uml_arm64_sme_vl)
+		sme_free(current);
+}
+
+void arch_release_task_struct(struct task_struct *task)
+{
+	if (uml_arm64_sme_vl)
+		sme_free(task);
+}
+
+/*
+ * vec_set_vector_length() for a CPU with one supported length: every valid
+ * length resolves to the SVL, as find_supported_vector_length() resolves
+ * it, so the live length never changes and an exec-time length always
+ * equals it.  What remains is the inherit flag.
+ */
+int uml_arm64_sme_set_vector_length(struct task_struct *task, unsigned long vl,
+				    unsigned long flags)
+{
+	if (flags & ~(unsigned long)(PR_SME_VL_INHERIT | PR_SME_SET_VL_ONEXEC))
+		return -EINVAL;
+	if (!sve_vl_valid(vl))
+		return -EINVAL;
+	task->thread.arch.sme_vl_inherit = !!(flags & PR_SME_VL_INHERIT);
+	return 0;
+}
+
+static int sme_prctl_status(void)
+{
+	int status = uml_arm64_sme_vl;
+
+	if (current->thread.arch.sme_vl_inherit)
+		status |= PR_SME_VL_INHERIT;
+	return status;
+}
+
+/* PR_SME_SET_VL */
+int uml_arm64_sme_set_current_vl(unsigned long arg)
+{
+	unsigned long vl = arg & PR_SME_VL_LEN_MASK;
+	int error;
+
+	if (!uml_arm64_sme_vl)
+		return -EINVAL;
+	error = uml_arm64_sme_set_vector_length(current, vl, arg & ~vl);
+	return error ?: sme_prctl_status();
+}
+
+/* PR_SME_GET_VL */
+int uml_arm64_sme_get_current_vl(void)
+{
+	return uml_arm64_sme_vl ? sme_prctl_status() : -EINVAL;
+}
+
+#ifdef CONFIG_SYSCTL
+/* /proc/sys/abi/sme_default_vector_length reads the SVL and accepts, with
+ * no effect, any valid length or -1, which natively select the SVL too. */
+static int sme_proc_do_default_vl(const struct ctl_table *table, int write,
+				  void *buffer, size_t *lenp, loff_t *ppos)
+{
+	int vl = uml_arm64_sme_vl;
+	struct ctl_table value = {
+		.data = &vl,
+		.maxlen = sizeof(vl),
+	};
+	int error = proc_dointvec(&value, write, buffer, lenp, ppos);
+
+	if (error || !write || vl == -1)
+		return error;
+	return sve_vl_valid(vl) ? 0 : -EINVAL;
+}
+
+static const struct ctl_table sme_default_vl_table[] = {
+	{
+		.procname = "sme_default_vector_length",
+		.mode = 0644,
+		.proc_handler = sme_proc_do_default_vl,
+	},
+};
+
+static int __init sme_sysctl_init(void)
+{
+	if (uml_arm64_sme_vl && !register_sysctl("abi", sme_default_vl_table))
+		return -EINVAL;
+	return 0;
+}
+core_initcall(sme_sysctl_init);
+#endif
+
+/*
+ * Regsets (native ptrace.c).  There is no NT_ARM_SVE: without non-streaming
+ * SVE the streaming registers are NT_ARM_SSVE, present while SM is set.
+ */
+
+/* NT_ARM_TLS: TPIDR_EL0, then TPIDR2_EL0. */
+int uml_arm64_tls_get(struct task_struct *target,
+		      const struct user_regset *regset, struct membuf to)
+{
+	membuf_store(&to, target->thread.arch.tpidr_el0);
+	return membuf_store(&to, uml_arm64_sme_registers(target)->tpidr2);
+}
+
+int uml_arm64_tls_set(struct task_struct *target,
+		      const struct user_regset *regset, unsigned int pos,
+		      unsigned int count, const void *kbuf,
+		      const void __user *ubuf)
+{
+	unsigned long tls[2] = {
+		target->thread.arch.tpidr_el0,
+		uml_arm64_sme_registers(target)->tpidr2,
+	};
+	int error;
+
+	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf, tls, 0,
+				   sizeof(tls));
+	if (error)
+		return error;
+	target->thread.arch.tpidr_el0 = tls[0];
+	uml_arm64_sme_registers(target)->tpidr2 = tls[1];
+	return 0;
+}
+
+static unsigned int sme_vq(void)
+{
+	return sve_vq_from_vl(uml_arm64_sme_vl);
+}
+
+/* NT_ARM_SSVE (native sve_get_common() for ARM64_VEC_SME). */
+int uml_arm64_ssve_get(struct task_struct *target,
+		       const struct user_regset *regset, struct membuf to)
+{
+	const elf_fpregset_t *fp = uml_arm64_fp_registers(target);
+	const u8 *state = uml_arm64_sme_state(target);
+	unsigned int vl = uml_arm64_sme_vl;
+	unsigned int vq = sme_vq();
+	bool active = *uml_arm64_svcr(target) & UML_ARM64_SVCR_SM;
+	struct user_sve_header header = {
+		.vl = vl,
+		.max_vl = vl,
+		.flags = active ? SVE_PT_REGS_SVE : SVE_PT_REGS_FPSIMD,
+		.max_size = SVE_PT_SIZE(vq, SVE_PT_REGS_SVE),
+	};
+	int index;
+
+	if (target->thread.arch.sme_vl_inherit)
+		header.flags |= SVE_PT_VL_INHERIT;
+	header.size = active ? SVE_PT_SIZE(vq, header.flags) : sizeof(header);
+	membuf_write(&to, &header, sizeof(header));
+	if (!active)
+		return to.left;
+	/* Z with the FP registers' low 16 bytes, P, and a zero FFR. */
+	for (index = 0; index < 32; index++) {
+		membuf_write(&to, &fp->vregs[index], sizeof(fp->vregs[index]));
+		membuf_write(&to, state + UML_ARM64_SME_Z_OFFSET(vl, index) +
+			     sizeof(fp->vregs[index]),
+			     vl - sizeof(fp->vregs[index]));
+	}
+	membuf_write(&to, state + UML_ARM64_SME_P_OFFSET(vl, 0), 2 * vl);
+	membuf_zero(&to, SVE_PT_SVE_FPSR_OFFSET(vq) -
+		    SVE_PT_SVE_FFR_OFFSET(vq));
+	membuf_write(&to, &fp->fpsr, sizeof(fp->fpsr));
+	membuf_write(&to, &fp->fpcr, sizeof(fp->fpcr));
+	return membuf_zero(&to, ALIGN(header.size, SVE_VQ_BYTES) -
+			   (SVE_PT_SVE_FPCR_OFFSET(vq) + SVE_PT_SVE_FPCR_SIZE));
+}
+
+/*
+ * Native sve_set_common() for ARM64_VEC_SME: the task enters streaming mode
+ * with zeroed Z, P, V, FPSR and FPCR, then takes what the tracer supplies;
+ * ZA is kept.
+ */
+int uml_arm64_ssve_set(struct task_struct *target,
+		       const struct user_regset *regset, unsigned int pos,
+		       unsigned int count, const void *kbuf,
+		       const void __user *ubuf)
+{
+	elf_fpregset_t *fp = uml_arm64_fp_registers(target);
+	unsigned int vl = uml_arm64_sme_vl;
+	unsigned int vq = sme_vq();
+	struct user_sve_header header;
+	u8 *state;
+	int index;
+	int error;
+
+	if (count < sizeof(header))
+		return -EINVAL;
+	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf, &header, 0,
+				   sizeof(header));
+	if (error)
+		return error;
+	/* Streaming registers exist only in SVE format. */
+	if ((header.flags & SVE_PT_REGS_MASK) == SVE_PT_REGS_FPSIMD)
+		return -EINVAL;
+	error = uml_arm64_sme_set_vector_length(target, header.vl,
+		((unsigned long)header.flags & ~SVE_PT_REGS_MASK) << 16);
+	if (error)
+		return error;
+	error = uml_arm64_sme_alloc(target);
+	if (error)
+		return error;
+	state = uml_arm64_sme_state(target);
+	memset(state, 0, UML_ARM64_SME_ZA_OFFSET(vl, 0));
+	*uml_arm64_svcr(target) |= UML_ARM64_SVCR_SM;
+	memset(fp, 0, sizeof(*fp));
+	if (count && vq != sve_vq_from_vl(header.vl))
+		return -EIO;
+	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf, state,
+				   SVE_PT_SVE_OFFSET, SVE_PT_SVE_FFR_OFFSET(vq));
+	if (!error) {
+		user_regset_copyin_ignore(&pos, &count, &kbuf, &ubuf,
+					  SVE_PT_SVE_FFR_OFFSET(vq),
+					  SVE_PT_SVE_FPSR_OFFSET(vq));
+		error = user_regset_copyin(&pos, &count, &kbuf, &ubuf,
+					   &fp->fpsr, SVE_PT_SVE_FPSR_OFFSET(vq),
+					   SVE_PT_SVE_FPCR_OFFSET(vq) +
+					   SVE_PT_SVE_FPCR_SIZE);
+	}
+	/* The FP registers own V, the low 16 bytes of each Z. */
+	for (index = 0; index < 32; index++)
+		memcpy(&fp->vregs[index],
+		       state + UML_ARM64_SME_Z_OFFSET(vl, index),
+		       sizeof(fp->vregs[index]));
+	return error;
+}
+
+/* NT_ARM_ZA (native za_get()). */
+int uml_arm64_za_get(struct task_struct *target,
+		     const struct user_regset *regset, struct membuf to)
+{
+	unsigned int vl = uml_arm64_sme_vl;
+	unsigned int vq = sme_vq();
+	bool active = *uml_arm64_svcr(target) & UML_ARM64_SVCR_ZA;
+	struct user_za_header header = {
+		.vl = vl,
+		.max_vl = vl,
+		.max_size = ZA_PT_SIZE(vq),
+		.size = active ? ZA_PT_SIZE(vq) : ZA_PT_ZA_OFFSET,
+	};
+
+	if (target->thread.arch.sme_vl_inherit)
+		header.flags |= ZA_PT_VL_INHERIT;
+	membuf_write(&to, &header, sizeof(header));
+	if (active)
+		membuf_write(&to, uml_arm64_sme_state(target) +
+			     UML_ARM64_SME_ZA_OFFSET(vl, 0), ZA_PT_ZA_SIZE(vq));
+	return membuf_zero(&to, ALIGN(header.size, SVE_VQ_BYTES) - header.size);
+}
+
+/* ZA and ZT0 become zero whenever PSTATE.ZA turns on. */
+static void sme_zero_za(u8 *state)
+{
+	unsigned int vl = uml_arm64_sme_vl;
+
+	memset(state + UML_ARM64_SME_ZA_OFFSET(vl, 0), 0,
+	       UML_ARM64_SME_STATE_SIZE(vl) - UML_ARM64_SME_ZA_OFFSET(vl, 0));
+}
+
+/* NT_ARM_ZA (native za_set()): no data turns ZA off. */
+int uml_arm64_za_set(struct task_struct *target,
+		     const struct user_regset *regset, unsigned int pos,
+		     unsigned int count, const void *kbuf,
+		     const void __user *ubuf)
+{
+	unsigned int vl = uml_arm64_sme_vl;
+	unsigned int vq = sme_vq();
+	struct user_za_header header;
+	int error;
+
+	if (count < sizeof(header))
+		return -EINVAL;
+	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf, &header, 0,
+				   sizeof(header));
+	if (error)
+		return error;
+	error = uml_arm64_sme_set_vector_length(target, header.vl,
+		(unsigned long)header.flags << 16);
+	if (error)
+		return error;
+	error = uml_arm64_sme_alloc(target);
+	if (error)
+		return error;
+	if (!(*uml_arm64_svcr(target) & UML_ARM64_SVCR_ZA))
+		sme_zero_za(uml_arm64_sme_state(target));
+	if (!count) {
+		*uml_arm64_svcr(target) &= ~UML_ARM64_SVCR_ZA;
+		return 0;
+	}
+	if (vq != sve_vq_from_vl(header.vl))
+		return -EIO;
+	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf,
+				   uml_arm64_sme_state(target) +
+				   UML_ARM64_SME_ZA_OFFSET(vl, 0),
+				   ZA_PT_ZA_OFFSET, ZA_PT_SIZE(vq));
+	if (!error)
+		*uml_arm64_svcr(target) |= UML_ARM64_SVCR_ZA;
+	return error;
+}
+
+/* NT_ARM_ZT, with SME2: ZT0, which reads as zero while ZA is off. */
+int uml_arm64_zt_get(struct task_struct *target,
+		     const struct user_regset *regset, struct membuf to)
+{
+	if (!uml_arm64_sme2)
+		return -EINVAL;
+	if (*uml_arm64_svcr(target) & UML_ARM64_SVCR_ZA)
+		return membuf_write(&to, uml_arm64_sme_state(target) +
+				    UML_ARM64_SME_ZT0_OFFSET(uml_arm64_sme_vl),
+				    ZT_SIG_REG_BYTES);
+	return membuf_zero(&to, ZT_SIG_REG_BYTES);
+}
+
+/* Writing ZT0 turns ZA on, zeroing ZA if it was off. */
+int uml_arm64_zt_set(struct task_struct *target,
+		     const struct user_regset *regset, unsigned int pos,
+		     unsigned int count, const void *kbuf,
+		     const void __user *ubuf)
+{
+	int error;
+
+	if (!uml_arm64_sme2)
+		return -EINVAL;
+	error = uml_arm64_sme_alloc(target);
+	if (error)
+		return error;
+	if (!(*uml_arm64_svcr(target) & UML_ARM64_SVCR_ZA))
+		sme_zero_za(uml_arm64_sme_state(target));
+	error = user_regset_copyin(&pos, &count, &kbuf, &ubuf,
+				   uml_arm64_sme_state(target) +
+				   UML_ARM64_SME_ZT0_OFFSET(uml_arm64_sme_vl),
+				   0, ZT_SIG_REG_BYTES);
+	if (!error)
+		*uml_arm64_svcr(target) |= UML_ARM64_SVCR_ZA;
+	return error;
+}
diff --git a/arch/arm64/um/sme.h b/arch/arm64/um/sme.h
new file mode 100644
index 0000000000000000000000000000000000000000..4afc2a47cac963ca6cffe77bdac399708c3a5dc4
--- /dev/null
+++ b/arch/arm64/um/sme.h
@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _UM_ARM64_SME_H
+#define _UM_ARM64_SME_H
+
+#include <linux/elf.h>
+#include <linux/sched.h>
+#include <sysdep/sme.h>
+
+/* The largest streaming vector length an SME CPU can have, in quadwords. */
+#define UML_ARM64_SME_VQ_MAX 16
+
+#ifdef CONFIG_UML_ARM64_SME
+/*
+ * The streaming vector length in bytes when the Darwin host implements SME
+ * for this run, the only one a task can have, else 0.  Every SME duty of the
+ * kernel is active only while it is non-zero.
+ */
+extern unsigned int uml_arm64_sme_vl;
+/* Whether the virtual CPU implements SME2, and with it ZT0. */
+extern bool uml_arm64_sme2;
+#else
+#define uml_arm64_sme_vl 0U
+#define uml_arm64_sme2 false
+#endif
+
+static inline elf_fpregset_t *uml_arm64_fp_registers(struct task_struct *task)
+{
+	return (elf_fpregset_t *)task->thread.regs.regs.fp;
+}
+
+static inline struct uml_arm64_sme_registers *
+uml_arm64_sme_registers(struct task_struct *task)
+{
+	return UML_ARM64_SME_REGISTERS(task->thread.regs.regs.fp);
+}
+
+/* The task's SME storage, or NULL while it has none. */
+static inline u8 *uml_arm64_sme_state(struct task_struct *task)
+{
+	return (u8 *)(unsigned long)uml_arm64_sme_registers(task)->state;
+}
+
+static inline unsigned long *uml_arm64_svcr(struct task_struct *task)
+{
+	return &task->thread.regs.regs.svcr;
+}
+
+struct membuf;
+struct pt_regs;
+struct uml_arm64_rt_sigframe;
+struct user_regset;
+
+int uml_arm64_sme_alloc(struct task_struct *task);
+void uml_arm64_task_smstop_sm(struct task_struct *task);
+int uml_arm64_sme_set_vector_length(struct task_struct *task, unsigned long vl,
+				    unsigned long flags);
+
+#define UML_ARM64_SME_REGSET_OPS(name) \
+int uml_arm64_##name##_get(struct task_struct *target, \
+			   const struct user_regset *regset, \
+			   struct membuf to); \
+int uml_arm64_##name##_set(struct task_struct *target, \
+			   const struct user_regset *regset, \
+			   unsigned int pos, unsigned int count, \
+			   const void *kbuf, const void __user *ubuf)
+UML_ARM64_SME_REGSET_OPS(tls);
+UML_ARM64_SME_REGSET_OPS(ssve);
+UML_ARM64_SME_REGSET_OPS(za);
+UML_ARM64_SME_REGSET_OPS(zt);
+#undef UML_ARM64_SME_REGSET_OPS
+
+/*
+ * Signal frames with SME records (sme_signal.c), for signal.c to call while
+ * uml_arm64_sme_vl is non-zero: the size of the current task's frame or a
+ * negative error, writing its SME records, sigreturn's parse and restore of
+ * every record, and the state a handler starts in.
+ */
+long uml_arm64_sme_sigframe_size(void);
+int uml_arm64_sme_save_sigframe(struct uml_arm64_rt_sigframe __user *frame,
+				struct pt_regs *regs);
+int uml_arm64_sme_restore_sigframe(struct pt_regs *regs,
+				   struct uml_arm64_rt_sigframe __user *frame);
+void uml_arm64_sme_enter_handler(void);
+
+#endif
diff --git a/arch/arm64/um/sme_signal.c b/arch/arm64/um/sme_signal.c
new file mode 100644
index 0000000000000000000000000000000000000000..885da55b1b255355e796e535529460093bb01ef3
--- /dev/null
+++ b/arch/arm64/um/sme_signal.c
@@ -0,0 +1,563 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SME records of Darwin guest signal frames (see sme.c).
+ */
+
+#include <linux/errno.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/signal.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <asm/elf.h>
+#include <asm/ptrace.h>
+#include <asm/sigcontext.h>
+#include "signal_frame.h"
+#include "sme.h"
+
+/*
+ * When the host implements SME, a signal frame takes native arm64's layout
+ * (arch/arm64/kernel/signal.c): records after fpsimd_context, which fill
+ * __reserved and continue behind an extra_context, then a terminator.  An
+ * SME frame holds sve_context, with the streaming registers while SM is set
+ * (there is no non-streaming SVE, so its VL is 0 otherwise), tpidr2_context,
+ * za_context, with ZA while it is live, and, with SME2, zt_context while ZA
+ * is live.  Like the FPSIMD-only frame it carries no esr_context.
+ */
+struct sme_sigframe_layout {
+	unsigned long size;
+	unsigned long limit;
+	unsigned long sve_offset;
+	unsigned long tpidr2_offset;
+	unsigned long za_offset;
+	unsigned long zt_offset;
+	unsigned long extra_offset;
+	unsigned long end_offset;
+};
+
+#define SME_TERMINATOR_SIZE round_up(sizeof(struct _aarch64_ctx), 16)
+#define SME_EXTRA_CONTEXT_SIZE round_up(sizeof(struct extra_context), 16)
+/* Native SIGFRAME_MAXSZ, the parser's bound on a frame. */
+#define SME_SIGFRAME_MAXSZ SZ_256K
+
+static void sme_init_layout(struct sme_sigframe_layout *user)
+{
+	memset(user, 0, sizeof(*user));
+	user->size = offsetof(struct uml_arm64_rt_sigframe,
+			      uc.uc_mcontext.__reserved);
+	user->limit = user->size +
+		sizeof(((struct sigcontext *)NULL)->__reserved) -
+		SME_TERMINATOR_SIZE - SME_EXTRA_CONTEXT_SIZE;
+}
+
+static unsigned long sme_sigframe_size(const struct sme_sigframe_layout *user)
+{
+	return round_up(max_t(unsigned long, user->size,
+			      sizeof(struct uml_arm64_rt_sigframe)), 16);
+}
+
+static int __sme_sigframe_alloc(struct sme_sigframe_layout *user,
+				unsigned long *offset, size_t size, bool extend)
+{
+	size_t padded_size = round_up(size, 16);
+
+	if (padded_size > user->limit - user->size && !user->extra_offset &&
+	    extend) {
+		int error;
+
+		user->limit += SME_EXTRA_CONTEXT_SIZE;
+		error = __sme_sigframe_alloc(user, &user->extra_offset,
+					     sizeof(struct extra_context), false);
+		if (error) {
+			user->limit -= SME_EXTRA_CONTEXT_SIZE;
+			return error;
+		}
+		/* The terminator of __reserved, then the extra space. */
+		user->size += SME_TERMINATOR_SIZE;
+		user->limit = SME_SIGFRAME_MAXSZ - SME_TERMINATOR_SIZE;
+	}
+	if (padded_size > user->limit - user->size)
+		return -ENOMEM;
+	*offset = user->size;
+	user->size += padded_size;
+	return 0;
+}
+
+static int sme_sigframe_alloc(struct sme_sigframe_layout *user,
+			      unsigned long *offset, size_t size)
+{
+	return __sme_sigframe_alloc(user, offset, size, true);
+}
+
+/*
+ * The layout of a frame for the current task, or with add_all the largest
+ * one any task can need (native setup_sigframe_layout(); unlike native,
+ * add_all includes ZA's data, so AT_MINSIGSTKSZ covers a frame with ZA
+ * live).
+ */
+static int sme_setup_layout(struct sme_sigframe_layout *user, bool add_all)
+{
+	unsigned long svcr = add_all ? 0 : *uml_arm64_svcr(current);
+	unsigned int vq = sve_vq_from_vl(uml_arm64_sme_vl);
+	unsigned long fpsimd_offset;
+	int error;
+
+	error = sme_sigframe_alloc(user, &fpsimd_offset,
+				   sizeof(struct fpsimd_context));
+	if (!error)
+		error = sme_sigframe_alloc(user, &user->sve_offset,
+			SVE_SIG_CONTEXT_SIZE(add_all ||
+				(svcr & UML_ARM64_SVCR_SM) ? vq : 0));
+	if (!error)
+		error = sme_sigframe_alloc(user, &user->tpidr2_offset,
+					   sizeof(struct tpidr2_context));
+	if (!error)
+		error = sme_sigframe_alloc(user, &user->za_offset,
+			ZA_SIG_CONTEXT_SIZE(add_all ||
+				(svcr & UML_ARM64_SVCR_ZA) ? vq : 0));
+	if (!error && uml_arm64_sme2 &&
+	    (add_all || (svcr & UML_ARM64_SVCR_ZA)))
+		error = sme_sigframe_alloc(user, &user->zt_offset,
+					   ZT_SIG_CONTEXT_SIZE(1));
+	if (error)
+		return error;
+	/* The terminator, and no allocation after it. */
+	user->limit += SME_TERMINATOR_SIZE;
+	error = sme_sigframe_alloc(user, &user->end_offset,
+				   sizeof(struct _aarch64_ctx));
+	user->limit = user->size;
+	return error;
+}
+
+/* Native signal_minsigstksz, the auxiliary vector's AT_MINSIGSTKSZ. */
+unsigned long uml_arm64_minsigstksz __ro_after_init;
+
+static int __init uml_arm64_minsigstksz_setup(void)
+{
+	struct sme_sigframe_layout user;
+
+	if (!uml_arm64_sme_vl)
+		return 0;
+	sme_init_layout(&user);
+	if (WARN_ON(sme_setup_layout(&user, true)))
+		return 0;
+	uml_arm64_minsigstksz = sme_sigframe_size(&user) +
+		round_up(sizeof(struct uml_arm64_frame_record), 16) +
+		16; /* the frame record's alignment */
+	return 0;
+}
+arch_initcall(uml_arm64_minsigstksz_setup);
+
+/* A record's head; its size is padded to 16 bytes, as native's is. */
+static int sme_put_head(struct _aarch64_ctx __user *head, u32 magic, u32 size)
+{
+	return put_user(magic, &head->magic) |
+		put_user(round_up(size, 16), &head->size);
+}
+
+/*
+ * The streaming Z and P registers in native sve_context layout, which is the
+ * storage's.  The FP registers own the low 16 bytes of each Z.  FFR does not
+ * exist in streaming mode without FA64 and reads as zero, as native
+ * sve_save_state() stores it.
+ */
+static int sme_save_streaming(char __user *data, const elf_fpregset_t *fp,
+			      const u8 *state)
+{
+	unsigned int vl = uml_arm64_sme_vl;
+	int index;
+
+	if (copy_to_user(data, state, UML_ARM64_SME_ZA_OFFSET(vl, 0)))
+		return -EFAULT;
+	for (index = 0; index < 32; index++)
+		if (copy_to_user(data + UML_ARM64_SME_Z_OFFSET(vl, index),
+				 &fp->vregs[index], sizeof(fp->vregs[index])))
+			return -EFAULT;
+	return clear_user(data + UML_ARM64_SME_ZA_OFFSET(vl, 0), vl / 8) ?
+		-EFAULT : 0;
+}
+
+static int sme_save_records(const struct sme_sigframe_layout *user,
+			    struct uml_arm64_rt_sigframe __user *frame,
+			    struct pt_regs *regs)
+{
+	char __user *base = (char __user *)frame;
+	const elf_fpregset_t *fp = (const void *)regs->regs.fp;
+	const u8 *state = uml_arm64_sme_state(current);
+	unsigned long svcr = *uml_arm64_svcr(current);
+	unsigned int vl = uml_arm64_sme_vl;
+	unsigned int vq = sve_vq_from_vl(vl);
+	struct sve_context __user *sve = (void __user *)(base + user->sve_offset);
+	struct tpidr2_context __user *tpidr2 =
+		(void __user *)(base + user->tpidr2_offset);
+	struct za_context __user *za = (void __user *)(base + user->za_offset);
+	struct _aarch64_ctx __user *end =
+		(void __user *)(base + user->end_offset);
+	bool streaming = svcr & UML_ARM64_SVCR_SM;
+	bool za_live = svcr & UML_ARM64_SVCR_ZA;
+	int error;
+
+	error = sme_put_head(&sve->head, SVE_MAGIC,
+			     SVE_SIG_CONTEXT_SIZE(streaming ? vq : 0));
+	error |= put_user(streaming ? vl : 0, &sve->vl);
+	error |= put_user(streaming ? SVE_SIG_FLAG_SM : 0, &sve->flags);
+	error |= clear_user(sve->__reserved, sizeof(sve->__reserved)) ?
+		-EFAULT : 0;
+	if (!error && streaming)
+		error = sme_save_streaming((char __user *)sve +
+					   SVE_SIG_REGS_OFFSET, fp, state);
+
+	error |= sme_put_head(&tpidr2->head, TPIDR2_MAGIC, sizeof(*tpidr2));
+	error |= put_user(uml_arm64_sme_registers(current)->tpidr2,
+			  &tpidr2->tpidr2);
+
+	error |= sme_put_head(&za->head, ZA_MAGIC,
+			      ZA_SIG_CONTEXT_SIZE(za_live ? vq : 0));
+	error |= put_user(vl, &za->vl);
+	error |= clear_user(za->__reserved, sizeof(za->__reserved)) ?
+		-EFAULT : 0;
+	if (!error && za_live &&
+	    copy_to_user((char __user *)za + ZA_SIG_REGS_OFFSET,
+			 state + UML_ARM64_SME_ZA_OFFSET(vl, 0),
+			 ZA_SIG_REGS_SIZE(vq)))
+		error = -EFAULT;
+
+	if (!error && user->zt_offset) {
+		struct zt_context __user *zt =
+			(void __user *)(base + user->zt_offset);
+
+		error = sme_put_head(&zt->head, ZT_MAGIC,
+				     ZT_SIG_CONTEXT_SIZE(1));
+		error |= put_user(1, &zt->nregs);
+		error |= clear_user(zt->__reserved, sizeof(zt->__reserved)) ?
+			-EFAULT : 0;
+		if (!error && copy_to_user((char __user *)zt +
+					   ZT_SIG_REGS_OFFSET,
+					   state + UML_ARM64_SME_ZT0_OFFSET(vl),
+					   ZT_SIG_REGS_SIZE(1)))
+			error = -EFAULT;
+	}
+
+	if (!error && user->extra_offset) {
+		struct extra_context __user *extra =
+			(void __user *)(base + user->extra_offset);
+		struct _aarch64_ctx __user *terminator =
+			(void __user *)(base + user->extra_offset +
+					SME_EXTRA_CONTEXT_SIZE);
+		char __user *data = (char __user *)terminator +
+			SME_TERMINATOR_SIZE;
+
+		error = sme_put_head(&extra->head, EXTRA_MAGIC,
+				     SME_EXTRA_CONTEXT_SIZE);
+		error |= put_user((u64)(unsigned long)data, &extra->datap);
+		error |= put_user((u32)(base + round_up(user->size, 16) - data),
+				  &extra->size);
+		error |= sme_put_head(terminator, 0, 0);
+	}
+	if (!error)
+		error = sme_put_head(end, 0, 0);
+	return error;
+}
+
+/*
+ * Native setup_return(): a handler starts outside streaming mode, with ZA
+ * off and TPIDR2 zero.
+ */
+void uml_arm64_sme_enter_handler(void)
+{
+	uml_arm64_task_smstop_sm(current);
+	*uml_arm64_svcr(current) &= ~UML_ARM64_SVCR_ZA;
+	uml_arm64_sme_registers(current)->tpidr2 = 0;
+}
+
+struct sme_user_contexts {
+	struct fpsimd_context __user *fpsimd;
+	u32 fpsimd_size;
+	struct sve_context __user *sve;
+	u32 sve_size;
+	struct tpidr2_context __user *tpidr2;
+	u32 tpidr2_size;
+	struct za_context __user *za;
+	u32 za_size;
+	struct zt_context __user *zt;
+	u32 zt_size;
+};
+
+/* Native parse_user_sigframe(), for the records this kernel writes. */
+static int sme_parse_sigframe(struct sme_user_contexts *user,
+			      struct uml_arm64_rt_sigframe __user *frame)
+{
+	struct sigcontext __user *const context = &frame->uc.uc_mcontext;
+	char __user *base = (char __user *)&context->__reserved;
+	const char __user *const frame_base = (const char __user *)frame;
+	size_t limit = sizeof(context->__reserved);
+	bool have_extra_context = false;
+	size_t offset = 0;
+
+	memset(user, 0, sizeof(*user));
+	if (!IS_ALIGNED((unsigned long)base, 16))
+		return -EINVAL;
+
+	for (;;) {
+		struct _aarch64_ctx __user *head;
+		const char __user *userp;
+		struct extra_context __user *extra;
+		struct _aarch64_ctx __user *end;
+		u32 magic, size, end_magic, end_size, extra_size;
+		u64 extra_datap;
+
+		if (limit - offset < sizeof(*head) || !IS_ALIGNED(offset, 16))
+			return -EINVAL;
+		head = (struct _aarch64_ctx __user *)(base + offset);
+		if (get_user(magic, &head->magic) || get_user(size, &head->size))
+			return -EFAULT;
+		if (limit - offset < size)
+			return -EINVAL;
+
+		switch (magic) {
+		case 0:
+			return size ? -EINVAL : 0;
+		case FPSIMD_MAGIC:
+			if (user->fpsimd)
+				return -EINVAL;
+			user->fpsimd = (struct fpsimd_context __user *)head;
+			user->fpsimd_size = size;
+			break;
+		case ESR_MAGIC:
+			break;
+		case SVE_MAGIC:
+			if (user->sve)
+				return -EINVAL;
+			user->sve = (struct sve_context __user *)head;
+			user->sve_size = size;
+			break;
+		case TPIDR2_MAGIC:
+			if (user->tpidr2)
+				return -EINVAL;
+			user->tpidr2 = (struct tpidr2_context __user *)head;
+			user->tpidr2_size = size;
+			break;
+		case ZA_MAGIC:
+			if (user->za)
+				return -EINVAL;
+			user->za = (struct za_context __user *)head;
+			user->za_size = size;
+			break;
+		case ZT_MAGIC:
+			if (!uml_arm64_sme2 || user->zt)
+				return -EINVAL;
+			user->zt = (struct zt_context __user *)head;
+			user->zt_size = size;
+			break;
+		case EXTRA_MAGIC:
+			if (have_extra_context || size < sizeof(*extra))
+				return -EINVAL;
+			userp = (const char __user *)head;
+			extra = (struct extra_context __user *)head;
+			userp += size;
+			if (get_user(extra_datap, &extra->datap) ||
+			    get_user(extra_size, &extra->size))
+				return -EFAULT;
+			/* The terminator of __reserved follows it. */
+			if (limit - offset - size < SME_TERMINATOR_SIZE)
+				return -EINVAL;
+			end = (struct _aarch64_ctx __user *)userp;
+			userp += SME_TERMINATOR_SIZE;
+			if (get_user(end_magic, &end->magic) ||
+			    get_user(end_size, &end->size))
+				return -EFAULT;
+			if (end_magic || end_size)
+				return -EINVAL;
+			have_extra_context = true;
+			base = (char __user *)(unsigned long)extra_datap;
+			if (!IS_ALIGNED((unsigned long)base, 16) ||
+			    !IS_ALIGNED(extra_size, 16) || base != userp ||
+			    extra_size > frame_base + SME_SIGFRAME_MAXSZ - userp)
+				return -EINVAL;
+			offset = 0;
+			limit = extra_size;
+			if (!access_ok(base, limit))
+				return -EINVAL;
+			continue;
+		default:
+			/* POE, FPMR and GCS records, which this CPU has none
+			 * of, and anything unknown. */
+			return -EINVAL;
+		}
+		if (size < sizeof(*head) || limit - offset < size)
+			return -EINVAL;
+		offset += size;
+	}
+}
+
+static int sme_restore_fpsimd(struct pt_regs *regs,
+			      const struct sme_user_contexts *user)
+{
+	elf_fpregset_t *state = (void *)regs->regs.fp;
+	struct fpsimd_context fpsimd;
+
+	if (user->fpsimd_size != sizeof(fpsimd) ||
+	    copy_from_user(&fpsimd, user->fpsimd, sizeof(fpsimd)))
+		return -EINVAL;
+	memcpy(state->vregs, fpsimd.vregs, sizeof(state->vregs));
+	state->fpsr = fpsimd.fpsr;
+	state->fpcr = fpsimd.fpcr;
+	return 0;
+}
+
+/*
+ * Native restore_sve_fpsimd_context(): streaming registers, after which the
+ * FPSIMD record supplies V (the low 16 bytes of each Z), FPSR and FPCR.
+ */
+static int sme_restore_sve(struct pt_regs *regs,
+			   const struct sme_user_contexts *user)
+{
+	unsigned int vl = uml_arm64_sme_vl;
+	unsigned int vq = sve_vq_from_vl(vl);
+	elf_fpregset_t *fp = (void *)regs->regs.fp;
+	u16 user_vl, flags;
+	u8 *state;
+	int index;
+	int error;
+
+	if (user->sve_size < sizeof(*user->sve))
+		return -EINVAL;
+	if (get_user(user_vl, &user->sve->vl) ||
+	    get_user(flags, &user->sve->flags))
+		return -EFAULT;
+	if (!(flags & SVE_SIG_FLAG_SM)) {
+		/* Without non-streaming SVE, only a bare header with VL 0. */
+		if (user_vl || user->sve_size != sizeof(*user->sve))
+			return -EINVAL;
+		*uml_arm64_svcr(current) &= ~UML_ARM64_SVCR_SM;
+		return sme_restore_fpsimd(regs, user);
+	}
+	if (user_vl != vl || user->sve_size < SVE_SIG_CONTEXT_SIZE(vq))
+		return -EINVAL;
+	error = uml_arm64_sme_alloc(current);
+	if (error)
+		return error;
+	state = uml_arm64_sme_state(current);
+	if (copy_from_user(state, (const char __user *)user->sve +
+			   SVE_SIG_REGS_OFFSET, UML_ARM64_SME_ZA_OFFSET(vl, 0)))
+		return -EFAULT;
+	*uml_arm64_svcr(current) |= UML_ARM64_SVCR_SM;
+	error = sme_restore_fpsimd(regs, user);
+	if (error)
+		return error;
+	for (index = 0; index < 32; index++)
+		memcpy(state + UML_ARM64_SME_Z_OFFSET(vl, index),
+		       &fp->vregs[index], sizeof(fp->vregs[index]));
+	return 0;
+}
+
+static int sme_restore_za(const struct sme_user_contexts *user)
+{
+	unsigned int vl = uml_arm64_sme_vl;
+	unsigned int vq = sve_vq_from_vl(vl);
+	u16 user_vl;
+	int error;
+
+	if (user->za_size < sizeof(*user->za))
+		return -EINVAL;
+	if (get_user(user_vl, &user->za->vl))
+		return -EFAULT;
+	if (user_vl != vl)
+		return -EINVAL;
+	if (user->za_size == sizeof(*user->za)) {
+		*uml_arm64_svcr(current) &= ~UML_ARM64_SVCR_ZA;
+		return 0;
+	}
+	if (user->za_size < ZA_SIG_CONTEXT_SIZE(vq))
+		return -EINVAL;
+	error = uml_arm64_sme_alloc(current);
+	if (error) {
+		*uml_arm64_svcr(current) &= ~UML_ARM64_SVCR_ZA;
+		return error;
+	}
+	if (copy_from_user(uml_arm64_sme_state(current) +
+			   UML_ARM64_SME_ZA_OFFSET(vl, 0),
+			   (const char __user *)user->za + ZA_SIG_REGS_OFFSET,
+			   ZA_SIG_REGS_SIZE(vq)))
+		return -EFAULT;
+	*uml_arm64_svcr(current) |= UML_ARM64_SVCR_ZA;
+	return 0;
+}
+
+static int sme_restore_zt(const struct sme_user_contexts *user)
+{
+	u16 nregs;
+
+	/* ZA is restored first, so this sees the frame's ZA. */
+	if (!(*uml_arm64_svcr(current) & UML_ARM64_SVCR_ZA) ||
+	    user->zt_size != ZT_SIG_CONTEXT_SIZE(1))
+		return -EINVAL;
+	if (get_user(nregs, &user->zt->nregs))
+		return -EFAULT;
+	if (nregs != 1)
+		return -EINVAL;
+	if (copy_from_user(uml_arm64_sme_state(current) +
+			   UML_ARM64_SME_ZT0_OFFSET(uml_arm64_sme_vl),
+			   (const char __user *)user->zt + ZT_SIG_REGS_OFFSET,
+			   ZT_SIG_REGS_SIZE(1)))
+		return -EFAULT;
+	return 0;
+}
+
+/* Native restore_sigframe()'s records, in its order. */
+int uml_arm64_sme_restore_sigframe(struct pt_regs *regs,
+				   struct uml_arm64_rt_sigframe __user *frame)
+{
+	struct sme_user_contexts user;
+	u64 tpidr2;
+	int error;
+
+	error = sme_parse_sigframe(&user, frame);
+	if (error)
+		return error;
+	if (!user.fpsimd)
+		return -EINVAL;
+	if (user.sve) {
+		error = sme_restore_sve(regs, &user);
+	} else {
+		*uml_arm64_svcr(current) &= ~UML_ARM64_SVCR_SM;
+		error = sme_restore_fpsimd(regs, &user);
+	}
+	if (!error && user.tpidr2) {
+		if (user.tpidr2_size != sizeof(*user.tpidr2))
+			return -EINVAL;
+		if (get_user(tpidr2, &user.tpidr2->tpidr2))
+			return -EFAULT;
+		uml_arm64_sme_registers(current)->tpidr2 = tpidr2;
+	}
+	if (!error && user.za)
+		error = sme_restore_za(&user);
+	if (!error && user.zt)
+		error = sme_restore_zt(&user);
+	return error;
+}
+
+long uml_arm64_sme_sigframe_size(void)
+{
+	struct sme_sigframe_layout user;
+
+	sme_init_layout(&user);
+	if (sme_setup_layout(&user, false))
+		return -ENOMEM;
+	return sme_sigframe_size(&user);
+}
+
+/* The records after the FPSIMD one, which save_mcontext() wrote, in the
+ * frame uml_arm64_sme_sigframe_size() sized. */
+int uml_arm64_sme_save_sigframe(struct uml_arm64_rt_sigframe __user *frame,
+				struct pt_regs *regs)
+{
+	struct sme_sigframe_layout user;
+
+	sme_init_layout(&user);
+	if (sme_setup_layout(&user, false))
+		return -ENOMEM;
+	return sme_save_records(&user, frame, regs);
+}
