From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 19 Oct 2026 18:37:14 +0900
Subject: [PATCH] um: describe the virtual machine in SMBIOS tables

Firmware hands Linux an SMBIOS table on every other machine, and
userspace reads the machine's identity from it: /sys/class/dmi/id, the
raw tables under /sys/firmware/dmi, and dmidecode. A UML guest has no
firmware, so all of them came up empty, and programs that want the
identity fell back to scanning /dev/mem's legacy BIOS window. In UML
that window is the kernel image. x86-64 Geekbench 6 is one such
program: its chassis probe found no anchor there, read past its
mapping, and in about one run in five leaked a shared /dev/mem mapping
for the rest of the run.

Write the table firmware would have written, once, before the DMI core
scans for it: BIOS, system, baseboard, chassis, processor, memory and
boot structures behind an SMBIOS 3.0 entry point. The table lives in
guest RAM, and uml_dmi_remap() answers the core's legacy scan with a
window that holds the entry point. The core copies through those
mappings as memory: UML's memcpy_fromio() is logic_iomem's, which
accepts only what ioremap() returned. The vendor is the emulator, the
processor is the virtual CPU the host names for /proc/cpuinfo, memory
is the RAM the guest was given, and the BIOS characteristics mark a
virtual machine. No serial number, UUID, speed or firmware date is
claimed.
---
 arch/um/Kconfig           |  11 +
 arch/um/include/asm/dmi.h |  32 +++
 arch/um/kernel/Makefile   |   1 +
 arch/um/kernel/dmi.c      | 496 ++++++++++++++++++++++++++++++++++++++
 4 files changed, 540 insertions(+)
 create mode 100644 arch/um/include/asm/dmi.h
 create mode 100644 arch/um/kernel/dmi.c

diff --git a/arch/um/Kconfig b/arch/um/Kconfig
index 8818e790d811f0446137a780ab0f04c238522bfa..119ac6fb2f2fc68e5f1bbd3256b6d6ae997bd116 100644
--- a/arch/um/Kconfig
+++ b/arch/um/Kconfig
@@ -51,6 +51,17 @@ config MMU
 	bool
 	default y
 
+config DMI
+	bool "SMBIOS tables that describe the virtual machine"
+	default y
+	select DMI_SCAN_MACHINE_NON_EFI_FALLBACK
+	help
+	  Write the SMBIOS (DMI) tables firmware writes on other machines,
+	  describing this virtual machine, so that /sys/class/dmi/id,
+	  /sys/firmware/dmi and dmidecode report its identity. Without them,
+	  programs that want it scan /dev/mem's legacy BIOS window, which in
+	  User-Mode Linux holds the kernel image.
+
 config UML_DMA_EMULATION
 	bool
 
diff --git a/arch/um/include/asm/dmi.h b/arch/um/include/asm/dmi.h
new file mode 100644
index 0000000000000000000000000000000000000000..31c53d300ef28e4eac748fd85b0696a5c05a2747
--- /dev/null
+++ b/arch/um/include/asm/dmi.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_UM_DMI_H
+#define _ASM_UM_DMI_H
+
+#include <linux/io.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+/*
+ * The kernel writes its own SMBIOS tables (arch/um/kernel/dmi.c), so a
+ * mapping is a pointer into guest RAM, apart from the legacy scan window,
+ * which is where the entry point is published.
+ */
+void *uml_dmi_remap(phys_addr_t phys, unsigned long size);
+
+#define dmi_early_remap(x, l)	uml_dmi_remap(x, l)
+#define dmi_early_unmap(x, l)	do { } while (0)
+#define dmi_remap(x, l)		uml_dmi_remap(x, l)
+#define dmi_unmap(x)		do { } while (0)
+#define dmi_alloc(l)		kzalloc(l, GFP_KERNEL)
+
+/*
+ * Those mappings are memory. UML's memcpy_fromio() is logic_iomem's, which
+ * accepts only what ioremap() returned, so the DMI core, the one includer
+ * that copies through them, copies as from memory.
+ */
+#undef memcpy_fromio
+#define memcpy_fromio(to, from, count) \
+	memcpy((to), (const void __force *)(from), (count))
+
+#endif
diff --git a/arch/um/kernel/Makefile b/arch/um/kernel/Makefile
index 91ca504ee7c0373209921d732188d8de2d662b68..e60afe7d2769b4eff2b235a90018a2a91076a75a 100644
--- a/arch/um/kernel/Makefile
+++ b/arch/um/kernel/Makefile
@@ -24,6 +24,7 @@ obj-$(CONFIG_UML_ARM64) += hwcaps_arm64.o
 obj-$(CONFIG_UML_X86) += capflags.o
 
 obj-$(CONFIG_BLK_DEV_INITRD) += initrd.o
+obj-$(CONFIG_DMI) += dmi.o
 obj-$(CONFIG_GPROF)	+= gprof_syms.o
 obj-$(CONFIG_OF) += dtb.o
 obj-$(CONFIG_EARLY_PRINTK) += early_printk.o
diff --git a/arch/um/kernel/dmi.c b/arch/um/kernel/dmi.c
new file mode 100644
index 0000000000000000000000000000000000000000..a000447907bdda32b6828648f09d4abcfa4bfb73
--- /dev/null
+++ b/arch/um/kernel/dmi.c
@@ -0,0 +1,496 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SMBIOS tables that describe the User-Mode Linux machine.
+ *
+ * Firmware hands Linux an SMBIOS table on every other machine, and userspace
+ * reads the machine's identity from it: /sys/class/dmi/id, the raw tables in
+ * /sys/firmware/dmi and the dmidecode family. A UML guest has no firmware, so
+ * without these tables every such reader finds nothing. Programs then fall
+ * back to scanning /dev/mem's legacy BIOS window, 0xE0000 to 0xFFFFF, which
+ * in UML is the kernel image: what they find there is the kernel's text, not
+ * a table, and some act on it.
+ *
+ * The kernel therefore writes the table firmware would have written, once,
+ * before the DMI core scans for it. The structure table lives in guest RAM,
+ * and the 64-bit entry point names its physical address, as firmware's does.
+ * The entry point is published where the core's legacy scan looks for it:
+ * uml_dmi_remap() answers that scan with a window holding only the entry
+ * point, and every other mapping with the RAM it names.
+ *
+ * The table describes what the guest is and reports no hardware it lacks:
+ * the vendor names the emulator, the processor is the virtual CPU the
+ * emulator names for /proc/cpuinfo, and memory is the RAM the guest was
+ * given. It claims no serial number, UUID, speed or firmware date.
+ */
+#include <linux/cpumask.h>
+#include <linux/dmi.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/sizes.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/utsname.h>
+#include <asm/dmi.h>
+#include <asm/page.h>
+#include <as-layout.h>
+#include <os.h>
+
+/* The address and size of the window the DMI core's legacy scan maps. */
+#define UML_DMI_SCAN_START	0xF0000
+#define UML_DMI_SCAN_SIZE	0x10000
+
+#define UML_DMI_VENDOR		"Kernarium"
+#define UML_DMI_PRODUCT		"Virtual Machine"
+#define UML_DMI_FAMILY		"Virtual Machine"
+
+/* Fixed handles, one per structure, so references need no bookkeeping. */
+enum {
+	UML_DMI_BIOS = 0x0000,
+	UML_DMI_SYSTEM = 0x0100,
+	UML_DMI_BOARD = 0x0200,
+	UML_DMI_CHASSIS = 0x0300,
+	UML_DMI_PROCESSOR = 0x0400,
+	UML_DMI_MEMORY_ARRAY = 0x1000,
+	UML_DMI_MEMORY_DEVICE = 0x1100,
+	UML_DMI_MEMORY_MAPPING = 0x1300,
+	UML_DMI_BOOT = 0x2000,
+	UML_DMI_END = 0x7f00,
+};
+
+#define UML_DMI_NO_HANDLE	0xffff
+#define UML_DMI_NO_ERROR_INFO	0xfffe
+
+struct uml_dmi_header {
+	u8 type;
+	u8 length;
+	__le16 handle;
+} __packed;
+
+/* Type 0, BIOS Information, in its SMBIOS 2.4 form. */
+struct uml_dmi_bios {
+	struct uml_dmi_header h;
+	u8 vendor;
+	u8 version;
+	__le16 start_segment;
+	u8 release_date;
+	u8 rom_size;
+	__le64 characteristics;
+	u8 characteristics_ext1;
+	u8 characteristics_ext2;
+	u8 major_release;
+	u8 minor_release;
+	u8 ec_major_release;
+	u8 ec_minor_release;
+} __packed;
+
+/* Type 1, System Information. */
+struct uml_dmi_system {
+	struct uml_dmi_header h;
+	u8 manufacturer;
+	u8 product;
+	u8 version;
+	u8 serial;
+	u8 uuid[16];
+	u8 wakeup_type;
+	u8 sku;
+	u8 family;
+} __packed;
+
+/* Type 2, Baseboard Information, with no contained objects. */
+struct uml_dmi_board {
+	struct uml_dmi_header h;
+	u8 manufacturer;
+	u8 product;
+	u8 version;
+	u8 serial;
+	u8 asset_tag;
+	u8 features;
+	u8 location;
+	__le16 chassis;
+	u8 board_type;
+	u8 objects;
+} __packed;
+
+/* Type 3, System Enclosure, with no contained elements. */
+struct uml_dmi_chassis {
+	struct uml_dmi_header h;
+	u8 manufacturer;
+	u8 type;
+	u8 version;
+	u8 serial;
+	u8 asset_tag;
+	u8 boot_state;
+	u8 power_state;
+	u8 thermal_state;
+	u8 security;
+	__le32 oem;
+	u8 height;
+	u8 power_cords;
+	u8 elements;
+	u8 element_length;
+	u8 sku;
+} __packed;
+
+/* Type 4, Processor Information, in its SMBIOS 3.0 form. */
+struct uml_dmi_processor {
+	struct uml_dmi_header h;
+	u8 socket;
+	u8 type;
+	u8 family;
+	u8 manufacturer;
+	__le64 id;
+	u8 version;
+	u8 voltage;
+	__le16 external_clock;
+	__le16 max_speed;
+	__le16 current_speed;
+	u8 status;
+	u8 upgrade;
+	__le16 l1_cache;
+	__le16 l2_cache;
+	__le16 l3_cache;
+	u8 serial;
+	u8 asset_tag;
+	u8 part;
+	u8 cores;
+	u8 enabled_cores;
+	u8 threads;
+	__le16 characteristics;
+	__le16 family2;
+	__le16 cores2;
+	__le16 enabled_cores2;
+	__le16 threads2;
+} __packed;
+
+/* Type 16, Physical Memory Array. */
+struct uml_dmi_memory_array {
+	struct uml_dmi_header h;
+	u8 location;
+	u8 use;
+	u8 error_correction;
+	__le32 max_capacity_kib;
+	__le16 error_info;
+	__le16 devices;
+	__le64 max_capacity_bytes;
+} __packed;
+
+/* Type 17, Memory Device, in its SMBIOS 2.8 form. */
+struct uml_dmi_memory_device {
+	struct uml_dmi_header h;
+	__le16 array;
+	__le16 error_info;
+	__le16 total_width;
+	__le16 data_width;
+	__le16 size;
+	u8 form_factor;
+	u8 device_set;
+	u8 locator;
+	u8 bank_locator;
+	u8 type;
+	__le16 type_detail;
+	__le16 speed;
+	u8 manufacturer;
+	u8 serial;
+	u8 asset_tag;
+	u8 part;
+	u8 attributes;
+	__le32 extended_size_mib;
+	__le16 configured_speed;
+	__le16 min_voltage;
+	__le16 max_voltage;
+	__le16 configured_voltage;
+} __packed;
+
+/* Type 19, Memory Array Mapped Address. */
+struct uml_dmi_memory_mapping {
+	struct uml_dmi_header h;
+	__le32 start_kib;
+	__le32 end_kib;
+	__le16 array;
+	u8 partition_width;
+	__le64 start_bytes;
+	__le64 end_bytes;
+} __packed;
+
+/* Type 32, System Boot Information. */
+struct uml_dmi_boot {
+	struct uml_dmi_header h;
+	u8 reserved[6];
+	u8 status;
+} __packed;
+
+/* The SMBIOS 3.0 (64-bit) entry point. */
+struct uml_dmi_entry_point {
+	char anchor[5];
+	u8 checksum;
+	u8 length;
+	u8 major;
+	u8 minor;
+	u8 docrev;
+	u8 revision;
+	u8 reserved;
+	__le32 table_max_size;
+	__le64 table_address;
+} __packed;
+
+static_assert(sizeof(struct uml_dmi_bios) == 0x18);
+static_assert(sizeof(struct uml_dmi_system) == 0x1b);
+static_assert(sizeof(struct uml_dmi_board) == 0x0f);
+static_assert(sizeof(struct uml_dmi_chassis) == 0x16);
+static_assert(sizeof(struct uml_dmi_processor) == 0x30);
+static_assert(sizeof(struct uml_dmi_memory_array) == 0x17);
+static_assert(sizeof(struct uml_dmi_memory_device) == 0x28);
+static_assert(sizeof(struct uml_dmi_memory_mapping) == 0x1f);
+static_assert(sizeof(struct uml_dmi_boot) == 0x0b);
+static_assert(sizeof(struct uml_dmi_entry_point) == 0x18);
+
+struct uml_dmi_table {
+	u8 *data;
+	size_t length;
+	size_t capacity;
+};
+
+static void *uml_dmi_window;
+
+/*
+ * Append one structure: its formatted area, whose header the caller has
+ * filled, then its strings in order, which the formatted area numbers from 1.
+ * An empty string has no number; the caller gives it 0 and leaves it out.
+ */
+static bool __init uml_dmi_add(struct uml_dmi_table *table, const void *area,
+			       const char *const *strings, unsigned int count)
+{
+	const struct uml_dmi_header *header = area;
+	size_t need = header->length + 2;
+	unsigned int index;
+	u8 *out;
+
+	for (index = 0; index < count; index++)
+		need += strlen(strings[index]) + 1;
+	if (table->length + need > table->capacity)
+		return false;
+	out = table->data + table->length;
+	memcpy(out, area, header->length);
+	out += header->length;
+	for (index = 0; index < count; index++) {
+		size_t size = strlen(strings[index]) + 1;
+
+		memcpy(out, strings[index], size);
+		out += size;
+	}
+	/* The string set ends with a second NUL, or is two NULs when empty. */
+	if (!count)
+		*out++ = 0;
+	*out++ = 0;
+	table->length = out - table->data;
+	return true;
+}
+
+#define UML_DMI_HEADER(kind, structure, number) \
+	{ .type = (kind), .length = sizeof(structure), \
+	  .handle = cpu_to_le16(number) }
+
+static const char *__init uml_dmi_cpu_model_name(void)
+{
+#ifdef UML_HOST_DARWIN
+	return os_guest_cpu_model_name();
+#else
+	return "UML";
+#endif
+}
+
+static bool __init uml_dmi_build(struct uml_dmi_table *table)
+{
+	u64 memory = physmem_size & ~((u64)SZ_1M - 1);
+	u64 memory_kib = memory >> 10;
+	u64 memory_mib = memory >> 20;
+	unsigned int cpus = num_possible_cpus();
+	const char *bios_strings[] = { UML_DMI_VENDOR, init_utsname()->release };
+	const char *system_strings[] = {
+		UML_DMI_VENDOR, UML_DMI_PRODUCT, UML_DMI_FAMILY
+	};
+	const char *board_strings[] = { UML_DMI_VENDOR, UML_DMI_PRODUCT };
+	const char *chassis_strings[] = { UML_DMI_VENDOR };
+	const char *processor_strings[] = {
+		"CPU 0", UML_DMI_VENDOR, uml_dmi_cpu_model_name()
+	};
+	const char *memory_strings[] = { "RAM", UML_DMI_VENDOR };
+	struct uml_dmi_bios bios = {
+		.h = UML_DMI_HEADER(0, bios, UML_DMI_BIOS),
+		.vendor = 1,
+		.version = 2,
+		/* Bit 3: BIOS characteristics are not supported. */
+		.characteristics = cpu_to_le64(BIT(3)),
+		/* Bit 4 of extension byte 2: this is a virtual machine. */
+		.characteristics_ext2 = BIT(4),
+		.major_release = 0xff,
+		.minor_release = 0xff,
+		.ec_major_release = 0xff,
+		.ec_minor_release = 0xff,
+	};
+	struct uml_dmi_system system = {
+		.h = UML_DMI_HEADER(1, system, UML_DMI_SYSTEM),
+		.manufacturer = 1,
+		.product = 2,
+		/* An all-zero UUID is one the machine does not have. */
+		.wakeup_type = 0x06,	/* power switch */
+		.family = 3,
+	};
+	struct uml_dmi_board board = {
+		.h = UML_DMI_HEADER(2, board, UML_DMI_BOARD),
+		.manufacturer = 1,
+		.product = 2,
+		.features = BIT(0),	/* a hosting board */
+		.chassis = cpu_to_le16(UML_DMI_CHASSIS),
+		.board_type = 0x0a,	/* motherboard */
+	};
+	struct uml_dmi_chassis chassis = {
+		.h = UML_DMI_HEADER(3, chassis, UML_DMI_CHASSIS),
+		.manufacturer = 1,
+		.type = 0x01,		/* other */
+		.boot_state = 0x03,	/* safe */
+		.power_state = 0x03,
+		.thermal_state = 0x03,
+		.security = 0x02,	/* unknown */
+	};
+	struct uml_dmi_processor processor = {
+		.h = UML_DMI_HEADER(4, processor, UML_DMI_PROCESSOR),
+		.socket = 1,
+		.type = 0x03,		/* central processor */
+		.family = 0xfe,		/* see family2 */
+		.manufacturer = 2,
+		.version = 3,
+		.status = 0x41,		/* socket populated, CPU enabled */
+		.upgrade = 0x02,	/* unknown */
+		.l1_cache = cpu_to_le16(UML_DMI_NO_HANDLE),
+		.l2_cache = cpu_to_le16(UML_DMI_NO_HANDLE),
+		.l3_cache = cpu_to_le16(UML_DMI_NO_HANDLE),
+		.cores = min(cpus, 0xffU),
+		.enabled_cores = min(cpus, 0xffU),
+		.threads = min(cpus, 0xffU),
+		/* 64-bit capable, and multi-core when it has several. */
+		.characteristics = cpu_to_le16(BIT(2) | (cpus > 1 ? BIT(3) : 0)),
+		.family2 = cpu_to_le16(0x01),	/* other */
+		.cores2 = cpu_to_le16(cpus),
+		.enabled_cores2 = cpu_to_le16(cpus),
+		.threads2 = cpu_to_le16(cpus),
+	};
+	struct uml_dmi_memory_array array = {
+		.h = UML_DMI_HEADER(16, array, UML_DMI_MEMORY_ARRAY),
+		.location = 0x01,	/* other */
+		.use = 0x03,		/* system memory */
+		.error_correction = 0x03,	/* none */
+		.error_info = cpu_to_le16(UML_DMI_NO_ERROR_INFO),
+		.devices = cpu_to_le16(1),
+	};
+	struct uml_dmi_memory_device device = {
+		.h = UML_DMI_HEADER(17, device, UML_DMI_MEMORY_DEVICE),
+		.array = cpu_to_le16(UML_DMI_MEMORY_ARRAY),
+		.error_info = cpu_to_le16(UML_DMI_NO_ERROR_INFO),
+		.total_width = cpu_to_le16(0xffff),	/* unknown */
+		.data_width = cpu_to_le16(0xffff),
+		.form_factor = 0x01,	/* other */
+		.locator = 1,
+		.type = 0x07,		/* RAM */
+		.type_detail = cpu_to_le16(BIT(1)),	/* other */
+		.manufacturer = 2,
+	};
+	struct uml_dmi_memory_mapping mapping = {
+		.h = UML_DMI_HEADER(19, mapping, UML_DMI_MEMORY_MAPPING),
+		.array = cpu_to_le16(UML_DMI_MEMORY_ARRAY),
+		.partition_width = 1,
+	};
+	struct uml_dmi_boot boot = {
+		.h = UML_DMI_HEADER(32, boot, UML_DMI_BOOT),
+	};
+	struct uml_dmi_header end = UML_DMI_HEADER(127, end, UML_DMI_END);
+
+	if (memory_kib < 0x80000000ULL) {
+		array.max_capacity_kib = cpu_to_le32(memory_kib);
+	} else {
+		array.max_capacity_kib = cpu_to_le32(0x80000000U);
+		array.max_capacity_bytes = cpu_to_le64(memory);
+	}
+	/* Bit 15 clear: the size counts MiB; 0x7fff defers to the extension. */
+	if (memory_mib < 0x7fff) {
+		device.size = cpu_to_le16(memory_mib);
+	} else {
+		device.size = cpu_to_le16(0x7fff);
+		device.extended_size_mib = cpu_to_le32(memory_mib);
+	}
+	if (memory_kib && memory_kib <= 0xffffffffULL) {
+		mapping.start_kib = 0;
+		mapping.end_kib = cpu_to_le32(memory_kib - 1);
+	} else if (memory) {
+		mapping.start_kib = cpu_to_le32(0xffffffffU);
+		mapping.end_kib = cpu_to_le32(0xffffffffU);
+		mapping.end_bytes = cpu_to_le64(memory - 1);
+	}
+
+	return uml_dmi_add(table, &bios, bios_strings,
+			   ARRAY_SIZE(bios_strings)) &&
+	       uml_dmi_add(table, &system, system_strings,
+			   ARRAY_SIZE(system_strings)) &&
+	       uml_dmi_add(table, &board, board_strings,
+			   ARRAY_SIZE(board_strings)) &&
+	       uml_dmi_add(table, &chassis, chassis_strings,
+			   ARRAY_SIZE(chassis_strings)) &&
+	       uml_dmi_add(table, &processor, processor_strings,
+			   ARRAY_SIZE(processor_strings)) &&
+	       uml_dmi_add(table, &array, NULL, 0) &&
+	       uml_dmi_add(table, &device, memory_strings,
+			   ARRAY_SIZE(memory_strings)) &&
+	       uml_dmi_add(table, &mapping, NULL, 0) &&
+	       uml_dmi_add(table, &boot, NULL, 0) &&
+	       uml_dmi_add(table, &end, NULL, 0);
+}
+
+void *uml_dmi_remap(phys_addr_t phys, unsigned long size)
+{
+	if (uml_dmi_window && phys == UML_DMI_SCAN_START &&
+	    size == UML_DMI_SCAN_SIZE)
+		return uml_dmi_window;
+	if (phys + size < phys || phys + size > physmem_size)
+		return NULL;
+	return __va(phys);
+}
+
+static int __init uml_dmi_init(void)
+{
+	struct uml_dmi_table table = { .capacity = PAGE_SIZE };
+	struct uml_dmi_entry_point *entry;
+	u8 sum = 0;
+	unsigned int index;
+
+	/* The table stays for the life of the kernel: sysfs serves it. */
+	table.data = kzalloc(table.capacity, GFP_KERNEL);
+	uml_dmi_window = kzalloc(UML_DMI_SCAN_SIZE, GFP_KERNEL);
+	if (!table.data || !uml_dmi_window || !uml_dmi_build(&table)) {
+		pr_warn("DMI: could not write the SMBIOS tables\n");
+		kfree(table.data);
+		kfree(uml_dmi_window);
+		uml_dmi_window = NULL;
+		return 0;
+	}
+
+	entry = uml_dmi_window;
+	memcpy(entry->anchor, "_SM3_", sizeof(entry->anchor));
+	entry->length = sizeof(*entry);
+	entry->major = 3;
+	entry->minor = 0;
+	entry->docrev = 0;
+	entry->revision = 1;
+	entry->table_max_size = cpu_to_le32(table.length);
+	entry->table_address = cpu_to_le64(__pa(table.data));
+	for (index = 0; index < sizeof(*entry); index++)
+		sum += ((u8 *)entry)[index];
+	entry->checksum = -sum;
+
+	dmi_setup();
+
+	/* The core keeps its own copy of the entry point. */
+	kfree(uml_dmi_window);
+	uml_dmi_window = NULL;
+	return 0;
+}
+early_initcall(uml_dmi_init);
