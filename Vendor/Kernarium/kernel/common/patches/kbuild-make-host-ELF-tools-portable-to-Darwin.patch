From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 3 Aug 2026 17:24:12 +0900
Subject: [PATCH] kbuild: make host ELF tools portable to Darwin

Apply the reviewed final-state topic without intermediate churn.
---
 scripts/Makefile.vmlinux  |  7 ++++++-
 scripts/link-vmlinux.sh   |  6 +++++-
 scripts/mod/file2alias.c  |  6 ++++++
 tools/lib/bpf/btf.c       | 17 ++++++++++++-----
 tools/lib/bpf/libbpf.c    | 18 ++++++++++++------
 tools/lib/subcmd/Makefile |  2 +-
 6 files changed, 42 insertions(+), 14 deletions(-)

diff --git a/scripts/Makefile.vmlinux b/scripts/Makefile.vmlinux
index 276c3134a563ade4933fab4df17e7eafc6a39fe2..fbe545bd4c386f3ad3e563677b2a1fde0c5406f1 100644
--- a/scripts/Makefile.vmlinux
+++ b/scripts/Makefile.vmlinux
@@ -112,8 +112,13 @@ vmlinux: vmlinux.unstripped FORCE
 # Strip the trailing padding bytes after extracting .modinfo to comply with
 # what kmod expects to parse.
 quiet_cmd_modules_builtin_modinfo = GEN     $@
+ifeq ($(UML_HOST_OS),Darwin)
+      cmd_trim_modinfo_padding = perl -0777 -pi -e 's/\x00+\z/\x00/' $@
+else
+      cmd_trim_modinfo_padding = sed -i 's/\x00\+$$/\x00/g' $@
+endif
       cmd_modules_builtin_modinfo = $(cmd_objcopy); \
-                                    sed -i 's/\x00\+$$/\x00/g' $@; \
+				    $(cmd_trim_modinfo_padding); \
                                     chmod -x $@
 
 OBJCOPYFLAGS_modules.builtin.modinfo := -j .modinfo -O binary
diff --git a/scripts/link-vmlinux.sh b/scripts/link-vmlinux.sh
index 433849ff7529e1fb8bb24e01163455844c8a4c88..73b21ea8477be5fef3224c344b0352139182eeca 100755
--- a/scripts/link-vmlinux.sh
+++ b/scripts/link-vmlinux.sh
@@ -80,7 +80,11 @@ vmlinux_link()
 		wl=-Wl,
 		ld="${CC}"
 		ldflags="${CFLAGS_vmlinux}"
-		ldlibs="-lutil -lrt -lpthread"
+		if [ "${UML_HOST_OS}" = "Darwin" ]; then
+			ldlibs=""
+		else
+			ldlibs="-lutil -lrt -lpthread"
+		fi
 	else
 		wl=
 		ld="${LD}"
diff --git a/scripts/mod/file2alias.c b/scripts/mod/file2alias.c
index 4e99393a35f152d7b95a6c1d2a2368dcb58875b1..5820eb1b881a89fedc691ecfdffb0d751c53169c 100644
--- a/scripts/mod/file2alias.c
+++ b/scripts/mod/file2alias.c
@@ -107,6 +107,9 @@ typedef struct {
 	__u8 b[16];
 } guid_t;
 
+#ifdef __APPLE__
+#define uuid_t linux_uuid_t
+#endif
 typedef struct {
 	__u8 b[16];
 } uuid_t;
@@ -122,6 +125,9 @@ typedef struct {
  * even potentially has different endianness and word sizes, since
  * we handle those differences explicitly below */
 #include "../../include/linux/mod_devicetable.h"
+#ifdef __APPLE__
+#undef uuid_t
+#endif
 
 struct devtable {
 	const char *device_id;
diff --git a/tools/lib/bpf/btf.c b/tools/lib/bpf/btf.c
index 9f141395c074e33d60c3da6a6d2d0c594c2c2f18..841f3b0fa81647dd1547cd8cc3dbb706bdfc8ff9 100644
--- a/tools/lib/bpf/btf.c
+++ b/tools/lib/bpf/btf.c
@@ -1604,8 +1604,10 @@ const void *btf__raw_data(const struct btf *btf_ro, __u32 *size)
 	return data;
 }
 
-__attribute__((alias("btf__raw_data")))
-const void *btf__get_raw_data(const struct btf *btf, __u32 *size);
+const void *btf__get_raw_data(const struct btf *btf, __u32 *size)
+{
+	return btf__raw_data(btf, size);
+}
 
 const char *btf__str_by_offset(const struct btf *btf, __u32 offset)
 {
@@ -3375,8 +3377,10 @@ const void *btf_ext__raw_data(const struct btf_ext *btf_ext, __u32 *size)
 	return data;
 }
 
-__attribute__((alias("btf_ext__raw_data")))
-const void *btf_ext__get_raw_data(const struct btf_ext *btf_ext, __u32 *size);
+const void *btf_ext__get_raw_data(const struct btf_ext *btf_ext, __u32 *size)
+{
+	return btf_ext__raw_data(btf_ext, size);
+}
 
 enum btf_endianness btf_ext__endianness(const struct btf_ext *btf_ext)
 {
@@ -5415,7 +5419,10 @@ struct btf *btf__load_vmlinux_btf(void)
 	return libbpf_err_ptr(-ESRCH);
 }
 
-struct btf *libbpf_find_kernel_btf(void) __attribute__((alias("btf__load_vmlinux_btf")));
+struct btf *libbpf_find_kernel_btf(void)
+{
+	return btf__load_vmlinux_btf();
+}
 
 struct btf *btf__load_module_btf(const char *module_name, struct btf *vmlinux_btf)
 {
diff --git a/tools/lib/bpf/libbpf.c b/tools/lib/bpf/libbpf.c
index b21d2f842579f9814a6f565b3df5bdbf09e30926..21e93a61da63ffe475f7fe1b6dcd01cd7ab241c5 100644
--- a/tools/lib/bpf/libbpf.c
+++ b/tools/lib/bpf/libbpf.c
@@ -8960,8 +8960,10 @@ int bpf_map__set_pin_path(struct bpf_map *map, const char *path)
 	return 0;
 }
 
-__alias(bpf_map__pin_path)
-const char *bpf_map__get_pin_path(const struct bpf_map *map);
+const char *bpf_map__get_pin_path(const struct bpf_map *map)
+{
+	return bpf_map__pin_path(map);
+}
 
 const char *bpf_map__pin_path(const struct bpf_map *map)
 {
@@ -9422,8 +9424,10 @@ int bpf_program__fd(const struct bpf_program *prog)
 	return prog->fd;
 }
 
-__alias(bpf_program__type)
-enum bpf_prog_type bpf_program__get_type(const struct bpf_program *prog);
+enum bpf_prog_type bpf_program__get_type(const struct bpf_program *prog)
+{
+	return bpf_program__type(prog);
+}
 
 enum bpf_prog_type bpf_program__type(const struct bpf_program *prog)
 {
@@ -9458,8 +9462,10 @@ int bpf_program__set_type(struct bpf_program *prog, enum bpf_prog_type type)
 	return 0;
 }
 
-__alias(bpf_program__expected_attach_type)
-enum bpf_attach_type bpf_program__get_expected_attach_type(const struct bpf_program *prog);
+enum bpf_attach_type bpf_program__get_expected_attach_type(const struct bpf_program *prog)
+{
+	return bpf_program__expected_attach_type(prog);
+}
 
 enum bpf_attach_type bpf_program__expected_attach_type(const struct bpf_program *prog)
 {
diff --git a/tools/lib/subcmd/Makefile b/tools/lib/subcmd/Makefile
index 8703ab487b68c89406fed575217b57f58e71fb01..aee619cc0cbc55c7487b898e45f213f2510ccd2c 100644
--- a/tools/lib/subcmd/Makefile
+++ b/tools/lib/subcmd/Makefile
@@ -90,7 +90,7 @@ define do_install
 	if [ ! -d '$2' ]; then             \
 		$(INSTALL) -d -m 755 '$2'; \
 	fi;                                             \
-	$(INSTALL) $1 $(if $3,-m $3,) '$2'
+	$(INSTALL) $(if $3,-m $3,) $1 '$2'
 endef
 
 install_lib: $(LIBFILE)
