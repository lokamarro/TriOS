From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Sat, 26 Sep 2026 21:56:51 +0900
Subject: [PATCH] kbuild: bpf: encode pahole 1.27 BTF in a fixed order

pahole 1.27 emits duplicate types in vmlinux BTF when it encodes in
parallel. An arm64 build at -j16 produced four copies of task_struct and 294
duplicated struct names, and resolve_btfids then reported several IDs for
task_struct, file and sock. The same pahole with its reproducible_build
feature, or at -j1, produced correct output identical to single-threaded
encoding.

The flag corrects the type information rather than normalizing build
metadata. Request it from pahole 1.27 and 1.28, the releases that provide it
without using it by default. pahole 1.29 and later always encode in that
order, and earlier releases do not provide the feature.
---
 scripts/Makefile.btf | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/scripts/Makefile.btf b/scripts/Makefile.btf
index db76335dd9176a895d2fa368a9b4636106ce805a..abd75a75bee8f0925756de32ffc7524c61d4d9e6 100644
--- a/scripts/Makefile.btf
+++ b/scripts/Makefile.btf
@@ -25,6 +25,14 @@ pahole-flags-$(call test-ge, $(pahole-ver), 126)  = -j$(JOBS) --btf_features=enc
 
 pahole-flags-$(call test-ge, $(pahole-ver), 130) += --btf_features=attributes
 
+# The default parallel encoder of pahole 1.27 can emit duplicate types, so
+# resolve_btfids finds several IDs for one name. Its reproducible_build mode
+# encodes in a fixed order and matches single-threaded output. pahole 1.29
+# and later always encode that way.
+ifeq ($(call test-le, $(pahole-ver), 128),y)
+pahole-flags-$(call test-ge, $(pahole-ver), 127) += --btf_features=reproducible_build
+endif
+
 ifneq ($(KBUILD_EXTMOD),)
 module-pahole-flags-$(call test-ge, $(pahole-ver), 128) += --btf_features=distilled_base
 endif
