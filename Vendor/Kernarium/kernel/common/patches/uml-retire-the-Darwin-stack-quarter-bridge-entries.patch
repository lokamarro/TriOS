From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Mon, 5 Oct 2026 22:00:48 +0900
Subject: [PATCH] uml: retire the Darwin stack-quarter bridge entries

After every guest event a 4 KiB kernel handed the task's stack pointer
to darwin_uml_vm_stage_stack() and, only when that returned more than
0, resolved a write fault there and called darwin_uml_vm_finish_stack().
That merged a 4 KiB user stack page a 16 KiB host page had exposed. The
host translates guest memory at 4 KiB, so it never stages one, and the
path did no work; a host that kept state for the pointer instead killed
tasks whose stack pointer was 0 or outside guest memory.

Retire both entries and the path, as bridge ABI 17.
---
 arch/um/os-Darwin/skas/process.c            | 28 ---------------------
 arch/um/os-Darwin/uml_darwin_abi_identity.h |  4 +--
 arch/um/os-Darwin/uml_darwin_memory.h       |  2 --
 3 files changed, 2 insertions(+), 32 deletions(-)

diff --git a/arch/um/os-Darwin/skas/process.c b/arch/um/os-Darwin/skas/process.c
index e7937d6b99c6068a258b8c1c1a33e9a6a83aed65..6927080a90261b5201163b0c728830728855a01f 100644
--- a/arch/um/os-Darwin/skas/process.c
+++ b/arch/um/os-Darwin/skas/process.c
@@ -271,30 +271,6 @@ void __attribute__((noreturn)) darwin_host_stop(void)
 	__builtin_unreachable();
 }
 
-static int reconcile_implicit_stack_quarter(struct uml_pt_regs *registers)
-{
-	unsigned long stack_pointer = UPT_SP(registers);
-	int signal_code;
-	int staged;
-
-	staged = darwin_uml_vm_stage_stack(stack_pointer);
-	if (staged <= 0)
-		return staged;
-	/*
-	 * The 16 KiB host slot made this otherwise-unmapped 4 KiB stack page
-	 * temporarily accessible.  Resolve the Linux write fault now, then let
-	 * the runtime merge the bytes staged from the anonymous host quarter
-	 * into the newly allocated Linux physical page.
-	 */
-	if (handle_page_fault(stack_pointer, UPT_IP(registers), 1, 1,
-			      &signal_code) < 0) {
-		(void)darwin_uml_vm_finish_stack(stack_pointer);
-		return -1;
-	}
-	current_mm_force_sync(stack_pointer);
-	return darwin_uml_vm_finish_stack(stack_pointer);
-}
-
 void halt_skas(void)
 {
 	shutdown_kernel(0);
@@ -424,10 +400,6 @@ void userspace(struct uml_pt_regs *registers)
 		 */
 		darwin_timer_poll(registers);
 		registers->is_user = 0;
-		result = reconcile_implicit_stack_quarter(registers);
-		if (result < 0)
-			fatal_userspace(registers, "stack-quarter reconciliation",
-					result);
 		/* Only a syscall event runs a system call.  Signal delivery fails or
 		 * restarts an interrupted call by this number, so a fault or an
 		 * interrupt must not leave the previous call's number here for it
diff --git a/arch/um/os-Darwin/uml_darwin_abi_identity.h b/arch/um/os-Darwin/uml_darwin_abi_identity.h
index 1a6c06c5487bd02096727a82626324a924994cef..fc13ce83dcf8fbd119e4915d4a904089cd677c8e 100644
--- a/arch/um/os-Darwin/uml_darwin_abi_identity.h
+++ b/arch/um/os-Darwin/uml_darwin_abi_identity.h
@@ -3,7 +3,7 @@
 #ifndef UML_DARWIN_ABI_IDENTITY_H
 #define UML_DARWIN_ABI_IDENTITY_H
 
-#define DARWIN_UML_ABI_VERSION 16U
-#define DARWIN_UML_ABI_FINGERPRINT 0x63aeb83b60564512ULL
+#define DARWIN_UML_ABI_VERSION 17U
+#define DARWIN_UML_ABI_FINGERPRINT 0x75b16149a5953494ULL
 
 #endif
diff --git a/arch/um/os-Darwin/uml_darwin_memory.h b/arch/um/os-Darwin/uml_darwin_memory.h
index 3630e0c2aa95ba7c63c111e28f94b54b44f676fa..0a955f3eb4b7ce9f02b7c6f32ad22a54b6f3e46e 100644
--- a/arch/um/os-Darwin/uml_darwin_memory.h
+++ b/arch/um/os-Darwin/uml_darwin_memory.h
@@ -41,8 +41,6 @@ int darwin_uml_vm_sync_from_buffer(unsigned long address,
  * and nothing is installed. Returns 0, or a negative value on failure. */
 int darwin_uml_vm_discard_if_stale(unsigned long address, int fd,
 				   unsigned long long offset);
-int darwin_uml_vm_stage_stack(unsigned long address);
-int darwin_uml_vm_finish_stack(unsigned long address);
 /* Returns 1 when the access can be retried, 0 when Linux must resolve the
  * fault, or a negative value on failure. */
 int darwin_uml_vm_retry_fault(unsigned long address, int execute, int write);
