 drivers/gpu/drm/virtio/virtgpu_drv.c          |   8 +
 drivers/gpu/drm/virtio/virtgpu_drv.h          |  59 ++++
 drivers/gpu/drm/virtio/virtgpu_kms.c          |  16 +-
 .../gpu/drm/virtio/virtgpu_memory_report.c    | 301 ++++++++++++++++++
 drivers/gpu/drm/virtio/virtgpu_uml.h          | 118 +++++++
 drivers/gpu/drm/virtio/virtgpu_vq.c           |  28 ++
 7 files changed, 530 insertions(+), 3 deletions(-)
 create mode 100644 drivers/gpu/drm/virtio/virtgpu_memory_report.c
 create mode 100644 drivers/gpu/drm/virtio/virtgpu_uml.h

