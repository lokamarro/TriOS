--- a/drivers/gpu/drm/virtio/virtgpu_kms.c
+++ b/drivers/gpu/drm/virtio/virtgpu_kms.c
@@ -42,6 +42,12 @@ static void virtio_gpu_config_changed_work_func(struct work_struct *work)
 	/* read the config space */
 	virtio_cread_le(vgdev->vdev, struct virtio_gpu_config,
 			events_read, &events_read);
+	/* First: it only queues a work item, and the display waits for the host. */
+	if (vgdev->has_uml_memory_report &&
