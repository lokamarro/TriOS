diff --git a/drivers/gpu/drm/virtio/virtgpu_drv.c b/drivers/gpu/drm/virtio/virtgpu_drv.c
index 7fcf4b6d85fca96f7d624c68a8a426230c9a9569..5c406874ea73ac63a7788254169a6cdb1d24de12 100644
--- a/drivers/gpu/drm/virtio/virtgpu_drv.c
+++ b/drivers/gpu/drm/virtio/virtgpu_drv.c
@@ -107,6 +107,9 @@ static int virtio_gpu_probe(struct virtio_device *vdev)
 	if (ret)
 		goto err_deinit;
 
+	/* The report is an aid: a driver that cannot create its file still works. */
+	virtio_gpu_memory_report_register(dev->dev_private);
+
 	drm_client_setup(vdev->priv, NULL);
 
 	return 0;
@@ -122,6 +125,7 @@ static void virtio_gpu_remove(struct virtio_device *vdev)
 {
 	struct drm_device *dev = vdev->priv;
 
+	virtio_gpu_memory_report_stop(dev->dev_private);
 	drm_dev_unplug(dev);
 
 	if (drm_core_check_feature(dev, DRIVER_ATOMIC))
@@ -135,6 +139,9 @@ static void virtio_gpu_shutdown(struct virtio_device *vdev)
 {
 	struct drm_device *dev = vdev->priv;
 
+	/* The unplug below deletes the minor's directory with the report file. */
+	virtio_gpu_memory_report_stop(dev->dev_private);
+
 	if (drm_core_check_feature(dev, DRIVER_ATOMIC))
 		drm_atomic_helper_shutdown(dev);
 
@@ -168,6 +175,7 @@ static unsigned int features[] = {
 	VIRTIO_GPU_F_RESOURCE_UUID,
 	VIRTIO_GPU_F_RESOURCE_BLOB,
 	VIRTIO_GPU_F_CONTEXT_INIT,
+	VIRTIO_GPU_F_UML_MEMORY_REPORT,
 };
 static struct virtio_driver virtio_gpu_driver = {
 	.feature_table = features,
diff --git a/drivers/gpu/drm/virtio/virtgpu_drv.h b/drivers/gpu/drm/virtio/virtgpu_drv.h
index 81cfae58b4f7b7dfc1031457e645f58c68112761..a5a4646259fc437767bf1e518689af039ebd8300 100644
--- a/drivers/gpu/drm/virtio/virtgpu_drv.h
+++ b/drivers/gpu/drm/virtio/virtgpu_drv.h
@@ -45,6 +45,8 @@
 
 #include <xen/xen.h>
 
+#include "virtgpu_uml.h"
+
 #define DRIVER_NAME "virtio_gpu"
 #define DRIVER_DESC "virtio GPU"
 
@@ -292,6 +294,50 @@ struct virtio_gpu_drv_cap_cache {
 	atomic_t is_valid;
 };
 
+/*
+ * The host's last report of its graphics memory (VIRTIO_GPU_F_UML_MEMORY_REPORT),
+ * which gpu_memory_report on the primary DRM minor serves and lmkd reads.
+ */
+struct virtio_gpu_memory_holder {
+	u64 bytes;
+	u32 pid;
+	u32 contexts;
+	u32 idle_ms;
+	char comm[VIRTIO_GPU_UML_COMM_LEN];
+};
+
+struct virtio_gpu_memory_report {
+	struct work_struct work;
+	/*
+	 * Serializes sysfs_notify() with virtio_gpu_memory_report_stop(); never
+	 * held with lock.
+	 */
+	struct mutex notify_lock;
+	/* The primary minor's device from the file's creation to the stop. */
+	struct device *kdev;
+	/* Protects everything below, and is never held across a wait. */
+	spinlock_t lock;
+	/* What the last reply said: seq counts the replies stored. */
+	u64 seq;
+	u64 stored_ns;
+	u64 budget_bytes;
+	u64 used_bytes;
+	u64 context_bytes;
+	u64 refusals;
+	u32 state;
+	u32 generation;
+	u32 holder_count;
+	struct virtio_gpu_memory_holder holders[VIRTIO_GPU_UML_MAX_HOLDERS];
+	/* What the guest asked for. */
+	bool armed;
+	u32 min_idle_ms;
+	u64 min_bytes;
+	/* A query is wanted, one is on the control queue, the report is stopped. */
+	bool wanted;
+	bool in_flight;
+	bool stopping;
+};
+
 struct virtio_gpu_device {
 	struct drm_device *ddev;
 
@@ -324,10 +370,12 @@ struct virtio_gpu_device {
 	bool has_resource_blob;
 	bool has_host_visible;
 	bool has_context_init;
+	bool has_uml_memory_report;
 	struct virtio_shm_region host_visible_region;
 	struct drm_mm host_visible_mm;
 
 	struct work_struct config_changed_work;
+	struct virtio_gpu_memory_report memory_report;
 
 	struct work_struct obj_free_work;
 	spinlock_t obj_free_lock;
@@ -440,6 +488,8 @@ void virtio_gpu_cursor_ping(struct virtio_gpu_device *vgdev,
 			    struct virtio_gpu_output *output);
 int virtio_gpu_cmd_get_display_info(struct virtio_gpu_device *vgdev);
 int virtio_gpu_cmd_get_capset_info(struct virtio_gpu_device *vgdev, int idx);
+int virtio_gpu_cmd_uml_get_memory(struct virtio_gpu_device *vgdev, u32 flags,
+				  u32 min_idle_ms, u64 min_bytes);
 int virtio_gpu_cmd_get_capset(struct virtio_gpu_device *vgdev,
 			      int idx, int version,
 			      struct virtio_gpu_drv_cap_cache **cache_p);
@@ -588,4 +638,13 @@ void virtio_gpu_vram_unmap_dma_buf(struct device *dev,
 int virtio_gpu_execbuffer_ioctl(struct drm_device *dev, void *data,
 				struct drm_file *file);
 
+/* virtgpu_memory_report.c */
+void virtio_gpu_memory_report_init(struct virtio_gpu_device *vgdev);
+int virtio_gpu_memory_report_register(struct virtio_gpu_device *vgdev);
+void virtio_gpu_memory_report_stop(struct virtio_gpu_device *vgdev);
+void virtio_gpu_memory_report_flush(struct virtio_gpu_device *vgdev);
+void virtio_gpu_memory_report_event(struct virtio_gpu_device *vgdev);
+void virtio_gpu_memory_report_reply(struct virtio_gpu_device *vgdev,
+				    struct virtio_gpu_vbuffer *vbuf);
+
 #endif
