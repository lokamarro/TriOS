+void mconsole_trim(struct mc_request *req)
+{
+	char *ptr = skip_spaces(req->request.data + strlen("trim"));
+	struct page_cache_trim_pass pass;
+	char reply[128];
+
+	if (sysfs_streq(ptr, "on") || sysfs_streq(ptr, "off")) {
+		page_cache_trim_enable(sysfs_streq(ptr, "on"));
+		mconsole_reply(req, ptr, 0, 0);
+	} else if (sysfs_streq(ptr, "once")) {
+		page_cache_trim_now(&pass);
+		snprintf(reply, sizeof(reply),
+			 "trimmed %lu KiB in %u ms, compacted in %u ms, released %lu KiB in %u ms",
+			 pass.trimmed_kib, pass.reclaim_ms, pass.compact_ms,
+			 pass.released_kib, pass.release_ms);
+		mconsole_reply(req, reply, 0, 0);
+	} else {
+		mconsole_reply(req, "Usage: trim on|off|once", 1, 0);
+	}
+}
