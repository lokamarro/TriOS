new file mode 100644
index 0000000000000000000000000000000000000000..2e0618fb00e792a2fc9a06c1cfc0cff44b292d48
--- /dev/null
+++ b/arch/um/kernel/page_cache_trim.c
@@ -0,0 +1,239 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Trim page cache that the host already caches.
+ *
+ * Every guest disk is a host file, and the host keeps a page cache of its
+ * own for it. A guest page-cache page therefore duplicates data the host
+ * already holds, but only the guest's copy is charged to the emulator: on iOS
+ * the host file cache does not count against the application's memory limit
+ * at all. Linux keeps page cache until memory runs out, so a file the guest
+ * read once stayed resident at the application's expense for the rest of the
+ * boot.
+ *
+ * Hand cold page cache back instead. While trimming is on, the inactive file
+ * pages above a floor shrink by a quarter every interval through the
+ * kernel's proactive reclaim, the mechanism behind memory.reclaim, restricted
+ * to file pages. Freed pages reach the host through free-page reporting, and
+ * reading one back costs a copy from the host's cache. Proactive reclaim
+ * never swaps here and leaves writeback to the flusher, and it takes the
+ * coldest pages first.
+ *
+ * A program that is starting reads files faster than it touches their pages
+ * a second time, so a pass can take pages it is about to use. Each one read
+ * back costs a host read, on a compressed filesystem a decompression, and for
+ * code a new translation, and is resident again anyway. When more than a
+ * quarter of what a pass reclaimed has been read back by the next pass, the
+ * interval doubles, up to 1 << PAGE_CACHE_TRIM_MAX_BACKOFF times; a pass
+ * whose evictions stay out restores it.
+ *
+ * Trimming is off until the host asks for it, because a guest in front of
+ * its user pays for every page it reads back. The management console's
+ * "trim on" and "trim off" start and stop it, as page_cache_trim.enabled does
+ * on the command line and in sysfs. "trim once" takes the inactive file cache
+ * above the floor for at most a second, compacts memory for at most another,
+ * hands the guest's free memory to the host at once, and then replies: a host
+ * about to stop scheduling the guest sends it first.
+ * page_cache_trim.interval_ms sets the interval; page_cache_trim.floor_mb sets
+ * the inactive file cache kept, which defaults to 1/32 of RAM.
+ */
+
+#include <linux/init.h>
+#include <linux/kstrtox.h>
+#include <linux/memcontrol.h>
+#include <linux/jiffies.h>
+#include <linux/ktime.h>
+#include <linux/minmax.h>
+#include <linux/mm.h>
+#include <linux/moduleparam.h>
+#include <linux/mutex.h>
+#include <linux/sched.h>
+#include <linux/swap.h>
+#include <linux/vmstat.h>
+#include <linux/workqueue.h>
+#include <linux/compaction.h>
+#include <asm/page.h>
+#include <kern_util.h>
+
+#undef MODULE_PARAM_PREFIX
+#define MODULE_PARAM_PREFIX "page_cache_trim."
+
+static void page_cache_trim_set(bool on);
+
+static bool enabled;
+
+static int enabled_set(const char *val, const struct kernel_param *kp)
+{
+	bool on;
+	int err = kstrtobool(val, &on);
+
+	if (err)
+		return err;
+	page_cache_trim_set(on);
+	return 0;
+}
+
+static const struct kernel_param_ops enabled_ops = {
+	.set = enabled_set,
+	.get = param_get_bool,
+};
+module_param_cb(enabled, &enabled_ops, &enabled, 0644);
+MODULE_PARM_DESC(enabled, "Trim page cache periodically (default off)");
+
+static unsigned int interval_ms = 2000;
+
+static int interval_set(const char *val, const struct kernel_param *kp)
+{
+	return param_set_uint_minmax(val, kp, 1, UINT_MAX);
+}
+
+static const struct kernel_param_ops interval_ops = {
+	.set = interval_set,
+	.get = param_get_uint,
+};
+module_param_cb(interval_ms, &interval_ops, &interval_ms, 0644);
+MODULE_PARM_DESC(interval_ms, "Milliseconds between page-cache trims while trimming is on");
+
+static unsigned int floor_mb;
+module_param(floor_mb, uint, 0644);
+MODULE_PARM_DESC(floor_mb, "Inactive file cache kept, in MiB (0 selects 1/32 of RAM)");
+
+/* Bounds one periodic pass to a few milliseconds of reclaim work. */
+#define PAGE_CACHE_TRIM_MAX_BYTES (32UL << 20)
+/* A working set read back keeps a pass up to 32 intervals away. */
+#define PAGE_CACHE_TRIM_MAX_BACKOFF 5
+/* Reclaim calls that free nothing before "trim once" settles for less. */
+#define PAGE_CACHE_TRIM_RETRIES 4
+/*
+ * "trim once" reclaims for at most this long and then compacts for at most
+ * as long again, so that a host waiting a few seconds before it suspends the
+ * guest also sees the release and the reply.
+ */
+#define PAGE_CACHE_TRIM_ONCE_JIFFIES HZ
+
+static void page_cache_trim(struct work_struct *work);
+static DECLARE_DEFERRABLE_WORK(page_cache_trim_work, page_cache_trim);
+
+/* Serializes starting and stopping the periodic work. */
+static DEFINE_MUTEX(page_cache_trim_lock);
+/* Workqueues exist; before this, turning trimming on only records it. */
+static bool page_cache_trim_ready;
+
+/* Only the periodic work, or a start while it is stopped, uses these. */
+static unsigned int backoff;
+static unsigned long last_refaults;
+static unsigned long last_reclaimed;
+
+static unsigned long page_cache_trim_floor(void)
+{
+	unsigned int floor = READ_ONCE(floor_mb);
+
+	if (floor)
+		return (unsigned long)floor << (20 - PAGE_SHIFT);
+	return totalram_pages() / 32;
+}
+
+static void page_cache_trim_queue(void)
+{
+	queue_delayed_work(system_unbound_wq, &page_cache_trim_work,
+			   msecs_to_jiffies(READ_ONCE(interval_ms)) << backoff);
+}
+
+static void page_cache_trim(struct work_struct *work)
+{
+	unsigned long refaults = global_node_page_state(WORKINGSET_REFAULT_FILE);
+	unsigned long inactive = global_node_page_state(NR_INACTIVE_FILE);
+	unsigned long floor = page_cache_trim_floor();
+
+	if (last_reclaimed && refaults - last_refaults > last_reclaimed / 4)
+		backoff = min(backoff + 1, PAGE_CACHE_TRIM_MAX_BACKOFF);
+	else
+		backoff = 0;
+	last_refaults = refaults;
+	last_reclaimed = 0;
+	/* Without MEMCG_RECLAIM_MAY_SWAP, reclaim takes file pages only. */
+	if (inactive > floor && !mem_cgroup_disabled())
+		last_reclaimed = try_to_free_mem_cgroup_pages(root_mem_cgroup,
+			min((inactive - floor + 3) / 4,
+			    PAGE_CACHE_TRIM_MAX_BYTES >> PAGE_SHIFT),
+			GFP_KERNEL, MEMCG_RECLAIM_PROACTIVE, NULL);
+	/* Turning trimming off cancels this work, a requeue included. */
+	if (READ_ONCE(enabled))
+		page_cache_trim_queue();
+}
+
+static void page_cache_trim_set(bool on)
+{
+	mutex_lock(&page_cache_trim_lock);
+	if (on != enabled) {
+		WRITE_ONCE(enabled, on);
+		if (page_cache_trim_ready && on) {
+			backoff = 0;
+			last_reclaimed = 0;
+			page_cache_trim_queue();
+		} else if (page_cache_trim_ready) {
+			cancel_delayed_work_sync(&page_cache_trim_work);
+		}
+	}
+	mutex_unlock(&page_cache_trim_lock);
+}
+
+/* The management console's "trim on" and "trim off". */
+void page_cache_trim_enable(int on)
+{
+	page_cache_trim_set(on);
+}
+
+/*
+ * The management console's "trim once": the inactive file cache above the
+ * floor, a quarter of what is left at a time as memory.reclaim takes it, for
+ * up to PAGE_CACHE_TRIM_ONCE_JIFFIES. The pages that frees lie between pages
+ * still in use, and the host takes memory back only in whole chunks, so
+ * compaction then gathers the pages in use, for as long again at most, and
+ * the guest's free memory goes to the host now rather than over the next half
+ * minute.
+ */
+void page_cache_trim_now(struct page_cache_trim_pass *pass)
+{
+	unsigned long deadline = jiffies + PAGE_CACHE_TRIM_ONCE_JIFFIES;
+	unsigned int retries = PAGE_CACHE_TRIM_RETRIES;
+	unsigned long inactive, floor, target, reclaimed = 0;
+	ktime_t started = ktime_get(), reclaimed_at, compacted_at;
+	unsigned long released;
+
+	if (!mem_cgroup_disabled()) {
+		/* Pages still in per-CPU batches have not reached the LRU lists. */
+		lru_add_drain_all();
+		inactive = global_node_page_state(NR_INACTIVE_FILE);
+		floor = page_cache_trim_floor();
+		target = inactive > floor ? inactive - floor : 0;
+		while (reclaimed < target && time_before(jiffies, deadline)) {
+			unsigned long batch = try_to_free_mem_cgroup_pages(
+				root_mem_cgroup, (target - reclaimed) / 4,
+				GFP_KERNEL, MEMCG_RECLAIM_PROACTIVE, NULL);
+
+			if (!batch && !retries--)
+				break;
+			reclaimed += batch;
+		}
+	}
+	reclaimed_at = ktime_get();
+	compact_nodes_until(jiffies + PAGE_CACHE_TRIM_ONCE_JIFFIES);
+	compacted_at = ktime_get();
+	released = uml_physmem_release_free();
+	pass->trimmed_kib = reclaimed << (PAGE_SHIFT - 10);
+	pass->released_kib = released >> 10;
+	pass->reclaim_ms = ktime_ms_delta(reclaimed_at, started);
+	pass->compact_ms = ktime_ms_delta(compacted_at, reclaimed_at);
+	pass->release_ms = ktime_ms_delta(ktime_get(), compacted_at);
+}
+
+static int __init page_cache_trim_init(void)
+{
+	mutex_lock(&page_cache_trim_lock);
+	page_cache_trim_ready = true;
+	if (enabled)
+		page_cache_trim_queue();
+	mutex_unlock(&page_cache_trim_lock);
+	return 0;
+}
+late_initcall(page_cache_trim_init);
