# Mail patches contain required unified-diff markers which resemble whitespace errors.
kernel/*/patches/series/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
kernel/common/patches/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
kernel/*/slices/*/patches/series/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
android/*/patches/projects/*/series/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
android/*/third_party/*/patches/projects/*/series/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
android/*/third_party/*/series/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
dependencies/patches/*/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
tools/rootfs/vulkan/patches/*/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# Exact resolved Repo manifests may preserve upstream whitespace verbatim.
android/*/third_party/*/base-manifest.xml whitespace=-blank-at-eol,-blank-at-eof
